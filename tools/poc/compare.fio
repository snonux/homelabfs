[global]
ioengine=sync
thread=1
numjobs=1
iodepth=1
direct=0
size=256m
bs=1m
refill_buffers=1
randrepeat=1
group_reporting=1

[sequential-write]
filename=sequential.bin
rw=write
verify=crc32c
do_verify=0
end_fsync=1

[sequential-read-verify]
stonewall
filename=sequential.bin
rw=read
verify=crc32c

[random-write-sync]
stonewall
filename=random.bin
size=64m
bs=4k
rw=randwrite
time_based=1
runtime=10
fsync=1
end_fsync=1
