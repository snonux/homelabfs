+++ R2/fs/9p/hfs_cursor.c
@@ -0,0 +1,88 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Bounded immutable directory resume cookies, owned by one open description. */
+#include "hfs_cursor.h"
+
+#ifndef HFS_CODEC_USERSPACE
+#include <linux/errno.h>
+#include <linux/kernel.h>
+#include <linux/string.h>
+#endif
+
+void hfs_cursor_init(struct hfs_dir_cursor *cursor)
+{
+	cursor->next = 3;
+	cursor->count = 0;
+}
+
+static bool hfs_cursor_component(const u8 *name, u32 len)
+{
+	u32 i;
+
+	if (!name || !len || len > HFS_DIR_NAME_MAX ||
+	    (len == 1 && name[0] == '.') ||
+	    (len == 2 && name[0] == '.' && name[1] == '.'))
+		return false;
+	for (i = 0; i < len; i++)
+		if (!name[i] || name[i] == '/')
+			return false;
+	return true;
+}
+
+int hfs_cursor_record(struct hfs_dir_cursor *cursor, const void *after,
+		      u32 len, u64 revision, u64 *position)
+{
+	struct hfs_dir_cookie *cookie;
+	u32 i;
+
+	if (!cursor || !position || !revision ||
+	    !hfs_cursor_component(after, len) ||
+	    cursor->count > HFS_DIR_COOKIES_MAX || cursor->next < 3)
+		return -EINVAL;
+	for (i = 0; i < cursor->count; i++) {
+		cookie = &cursor->cookies[i];
+		if (cookie->revision == revision && cookie->after_len == len &&
+		    !memcmp(cookie->after, after, len)) {
+			*position = cookie->position;
+			return 0;
+		}
+	}
+	if (cursor->count == HFS_DIR_COOKIES_MAX || cursor->next > S64_MAX)
+		return -ENOSPC;
+	cookie = &cursor->cookies[cursor->count++];
+	cookie->position = cursor->next++;
+	cookie->revision = revision;
+	cookie->after_len = len;
+	memcpy(cookie->after, after, len);
+	*position = cookie->position;
+	return 0;
+}
+
+int hfs_cursor_seek(const struct hfs_dir_cursor *cursor, u64 position,
+		    void *after, u32 *len, u64 *revision)
+{
+	const struct hfs_dir_cookie *cookie;
+	u32 i;
+
+	if (!cursor || !len || !revision ||
+	    cursor->count > HFS_DIR_COOKIES_MAX)
+		return -EINVAL;
+	if (position < 3) {
+		*len = 0;
+		*revision = 0;
+		return 0;
+	}
+	for (i = 0; i < cursor->count; i++) {
+		cookie = &cursor->cookies[i];
+		if (cookie->position != position)
+			continue;
+		if (*len < cookie->after_len)
+			return -ENOSPC;
+		if (!after)
+			return -EINVAL;
+		memcpy(after, cookie->after, cookie->after_len);
+		*len = cookie->after_len;
+		*revision = cookie->revision;
+		return 0;
+	}
+	return -EINVAL;
+}
