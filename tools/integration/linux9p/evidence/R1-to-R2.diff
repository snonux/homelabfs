+static loff_t hfs_dir_llseek(struct file *file, loff_t offset, int whence)
+{
+	struct hfs_description *description = file->private_data;
+	u8 after[255];
+	u32 len = sizeof(after);
+	u64 revision;
+	loff_t result;
+	int err;
+
+	if (!description || !description->cursor)
+		return -ESTALE;
+	mutex_lock(&description->lock);
+	if (whence == SEEK_CUR && !offset) {
+		result = file->f_pos;
+		goto out;
+	}
+	if (whence != SEEK_SET || offset < 0) {
+		result = -EINVAL;
+		goto out;
+	}
+	err = hfs_cursor_seek(description->cursor, offset, after, &len, &revision);
+	if (err) {
+		result = err;
+		goto out;
+	}
+	result = vfs_setpos(file, offset, MAX_LFS_FILESIZE);
+	if (result >= 0) {
+		memcpy(description->after, after, len);
+		description->after_len = len;
+		description->revision = revision;
+	}
+out:
+	mutex_unlock(&description->lock);
+	return result;
+}
