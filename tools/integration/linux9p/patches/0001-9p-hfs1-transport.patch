+static struct p9_req_t *
+p9_client_rpc_tag(struct p9_client *c, int8_t type, int tag,
+		  const char *fmt, ...)
+{
+	struct p9_req_t *req;
+	va_list ap;
+
+	va_start(ap, fmt);
+	req = p9_client_rpc_v(c, type, tag, fmt, ap);
+	va_end(ap);
+	return req;
+}
+
+static struct p9_req_t *
+p9_client_rpc(struct p9_client *c, int8_t type, const char *fmt, ...)
+{
+	struct p9_req_t *req;
+	va_list ap;
+
+	va_start(ap, fmt);
+	req = p9_client_rpc_v(c, type, -1, fmt, ap);
+	va_end(ap);
+	return req;
+}
+
+int p9_client_hfs_exchange(struct p9_client *c, u16 tag, u8 method,
+			   u8 channel, u64 cell, u32 chunk,
+			   const void *frame, u32 frame_len,
+			   void *reply, u32 *reply_len)
+{
+	struct p9_req_t *req;
+	u32 len;
+	int err = 0;
+
+	if (!p9_client_is_hfs(c) || c->msize != 65536 ||
+	    (tag != 65533 && tag != 65534 && tag != P9_NOTAG) ||
+	    !cell || cell > 2147483647 || chunk >= 32 ||
+	    !reply || !reply_len ||
+	    !((method == 1 && channel == 1 && frame &&
+	       frame_len >= 89 && frame_len <= 32856) ||
+	      (method == 2 && (channel == 2 || channel == 3) && !frame_len)))
+		return -EINVAL;
+	if (tag != P9_NOTAG)
+		mutex_lock(tag == 65533 ? &c->hfs_control_tag : &c->hfs_wait_tag);
+	req = p9_client_rpc_tag(c, (s8)P9_TBRIDGE,
+			      tag == P9_NOTAG ? -1 : tag, "bbqdB",
+			      method, channel, cell, chunk, frame_len, frame);
+	if (tag != P9_NOTAG)
+		mutex_unlock(tag == 65533 ? &c->hfs_control_tag : &c->hfs_wait_tag);
+	if (IS_ERR(req))
+		return PTR_ERR(req);
+	len = req->rc.size - req->rc.offset;
+	if (req->rc.id != P9_RBRIDGE || req->rc.tag != req->tc.tag ||
+	    len > *reply_len || !len) {
+		err = -EPROTO;
+	} else {
+		memcpy(reply, req->rc.sdata + req->rc.offset, len);
+		*reply_len = len;
+	}
+	p9_req_put(c, req);
+	return err;
+}
+EXPORT_SYMBOL_GPL(p9_client_hfs_exchange);
 
