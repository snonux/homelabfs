+/* Fixed hfs tags (65533 control, 65534 VIEW_WAIT) are serialized by their
+ * per-tag mutex, but a completed request can outlive its exchange: the
+ * transport receive path (p9_client_cb) wakes the waiter first and drops its
+ * own reference afterwards, possibly on another CPU or a preempted vCPU. Until
+ * that last p9_req_put the old request still owns the idr slot, and a new
+ * allocation of the same tag would fail. Wait, bounded and under the per-tag
+ * mutex, until the previous request is fully released, so a fixed tag is
+ * reused only after its response is fully released. Dynamic tags never fall
+ * in this range, so once the slot is empty only the mutex holder can take it.
+ * Nothing is sent while waiting; -EBUSY after the bound is a local no-send
+ * that hfs_transport retries on the same cell and chunk. A disconnecting
+ * client reports -EIO first, as p9_client_prepare_req would.
+ */
+static int p9_client_hfs_tag_idle(struct p9_client *c, u16 tag)
+{
+	unsigned long deadline = jiffies + HZ;
+	bool busy;
+
+	for (;;) {
+		if (READ_ONCE(c->status) == Disconnected ||
+		    READ_ONCE(c->status) == BeginDisconnect)
+			return -EIO;
+		spin_lock_irq(&c->lock);
+		busy = idr_find(&c->reqs, tag) != NULL;
+		spin_unlock_irq(&c->lock);
+		if (!busy)
+			return 0;
+		if (time_after_eq(jiffies, deadline))
+			return -EBUSY;
+		usleep_range(50, 100);
+	}
+}
+
+int p9_client_hfs_exchange(struct p9_client *c, u16 tag, u8 method,
+			   u8 channel, u64 cell, u32 chunk,
+			   const void *frame, u32 frame_len,
+			   void *reply, u32 *reply_len)
+{
+	struct mutex *owner = NULL;
+	struct p9_req_t *req;
+	u32 len;
+	int err = 0;
+
+	if (!p9_client_is_hfs(c) || c->msize != 65536 ||
+	    (tag != 65533 && tag != 65534 && tag != P9_NOTAG) ||
+	    !cell || cell > 2147483647 || chunk >= 32 ||
+	    !reply || !reply_len ||
+	    !((method == 1 && channel == 1 && frame &&
+	       frame_len >= 89 && frame_len <= 32856) ||
+	      (method == 2 && (channel == 2 || channel == 3) && !frame_len)))
+		return -EINVAL;
+	if (tag != P9_NOTAG) {
+		owner = tag == 65533 ? &c->hfs_control_tag : &c->hfs_wait_tag;
+		mutex_lock(owner);
+		err = p9_client_hfs_tag_idle(c, tag);
+		if (err) {
+			mutex_unlock(owner);
+			return err;
+		}
+	}
+	req = p9_client_rpc_tag(c, (s8)P9_TBRIDGE,
+			      tag == P9_NOTAG ? -1 : tag, "bbqdB",
+			      method, channel, cell, chunk, frame_len, frame);
+	if (IS_ERR(req)) {
+		/* -EBUSY from this exchange must mean "nothing sent": only the idle
+		 * wait above returns it. With the tag idle under its mutex,
+		 * p9_tag_alloc cannot find it busy, so any -EBUSY here would come
+		 * from after the request reached the transport. Report it as an
+		 * I/O error so that callers never retry a possibly sent packet.
+		 */
+		err = PTR_ERR(req) == -EBUSY ? -EIO : PTR_ERR(req);
+		goto unlock;
+	}
+	len = req->rc.size - req->rc.offset;
+	if (req->rc.id != P9_RBRIDGE || req->rc.tag != req->tc.tag ||
+	    len > *reply_len || !len) {
+		err = -EPROTO;
+	} else {
+		memcpy(reply, req->rc.sdata + req->rc.offset, len);
+		*reply_len = len;
+	}
+	/* Drop this waiter's reference while still owning the fixed tag. The
+	 * receive callback's reference is covered by the next owner's idle wait.
+	 */
+	p9_req_put(c, req);
+unlock:
+	if (owner)
+		mutex_unlock(owner);
+	return err;
+}
+EXPORT_SYMBOL_GPL(p9_client_hfs_exchange);
 
