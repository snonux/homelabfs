+static int hfs_controlled_view_retirement(struct hfs_session *session,
+		const struct hfs_buf *credentials, u64 through, const u8 hash[32],
+		const struct hfs_json *response)
+{
+	struct hfs_view_family *family;
+	struct hfs_view_ticket *ticket;
+	struct hfs_buf expected = {};
+	void *scratch_credit;
+	u64 number;
+	u32 count;
+	u8 result[32];
+	int err = -ESTALE;
+
+	if (!credentials || !response)
+		return -EINVAL;
+	err = hfs_controlled_progress_reserve(session, HFS_VIEW_BODY_MAX, &scratch_credit);
+	if (err)
+		return err;
+	err = hfs_buf_init(&expected, HFS_VIEW_BODY_MAX);
+	if (err)
+		goto unreserve;
+	err = -ESTALE;
+	mutex_lock(&session->lock);
+	list_for_each_entry(family, &session->view_families, list) {
+		if (family->credentials.len != credentials->len ||
+		    memcmp(family->credentials.data, credentials->data, credentials->len) ||
+		    through <= family->floor)
+			continue;
+		expected.len = 0;
+		expected.error = 0;
+		hfs_buf_printf(&expected, "{\"anchor\":\"%pUb\",\"credentials\":", &family->anchor);
+		hfs_buf_add(&expected, credentials->data, credentials->len);
+		hfs_buf_printf(&expected, ",\"nonce\":\"%pUb\",\"result_hashes\":[", &family->nonce);
+		number = family->floor;
+		count = 0;
+		list_for_each_entry(ticket, &session->view_tickets, list) {
+			u32 length = 32;
+
+			if (ticket->family != family || !ticket->number)
+				continue;
+			if (ticket->number > through)
+				break;
+			if (ticket->number != number + 1 || ticket->users || !ticket->terminal ||
+			    !ticket->response || count == 1024 ||
+			    hfs_json_hex(ticket->response, hfs_json_field(ticket->response, 0, "id"), result, &length) || length != 32)
+				break;
+			if (count++)
+				hfs_buf_literal(&expected, ",");
+			hfs_buf_hex(&expected, result, 32);
+			number = ticket->number;
+		}
+		if (!count || number != through)
+			continue;
+		hfs_buf_printf(&expected, "],\"through\":%llu}", through);
+		/* Borrowed response remains owned by hfs_view_retire throughout. */
+		mutex_unlock(&session->lock);
+		err = hfs_received_retirement(session, response, true, &expected, through, hash);
+		mutex_lock(&session->lock);
+		if (!err)
+			break;
+	}
+	mutex_unlock(&session->lock);
+	hfs_buf_free(&expected);
+unreserve:
+	hfs_controlled_unreserve(session, scratch_credit);
+	return err;
+}
