+static int hfs_controlled_resolve_gap(struct hfs_session *session, struct hfs_request *request)
+{
+	struct hfs_buf expected = {};
+	void *scratch_credit;
+	struct hfs_json *query = NULL;
+	int body, claim, err;
+	u8 proof[32];
+	u32 length = 32;
+
+	if (request->session != session || request->earmarked || request->held || request->users ||
+	    !request->allocated || request->terminal)
+		return -EBUSY;
+	/* The expected original and nested hfs_request_resolve_gap payload
+   * coexist; fund both before either allocation, including direct retries. */
+	err = hfs_completion_reserve(request->completion, 2ULL * HFS_BODY_MAX, false,
+				     &scratch_credit);
+	if (err)
+		return err;
+	err = hfs_buf_init(&expected, HFS_BODY_MAX);
+	if (err)
+		goto unreserve;
+	if (!request->gap_response)
+		err = hfs_request_resolve_gap(session, request);
+	if (err)
+		goto out;
+	hfs_buf_literal(&expected, "{\"claim\":");
+	hfs_buf_add(&expected, request->claim.data, request->claim.len);
+	hfs_buf_literal(&expected, ",\"credentials\":");
+	hfs_buf_add(&expected, request->credentials.data, request->credentials.len);
+	hfs_buf_literal(&expected, ",\"intent\":");
+	hfs_buf_add(&expected, request->intent.data, request->intent.len);
+	hfs_buf_literal(&expected, "}");
+	err = hfs_received_original(session, request->gap_response, "GAP_RESOLVE", &expected);
+	body = hfs_json_field(request->gap_response, 0, "payload");
+	if (!err &&
+	    (hfs_json_exact(request->gap_response, body, "claim,proof_hash,status") ||
+	     !hfs_json_is(request->gap_response,
+			  hfs_json_field(request->gap_response, body, "status"), "\"GAP\"") ||
+	     hfs_json_hex(request->gap_response,
+			  hfs_json_field(request->gap_response, body, "proof_hash"), proof,
+			  &length) ||
+	     length != 32))
+		err = -EPROTO;
+	if (err)
+		goto out;
+	expected.len = 0;
+	expected.error = 0;
+	hfs_buf_literal(&expected, "{\"claim\":");
+	hfs_buf_add(&expected, request->claim.data, request->claim.len);
+	hfs_buf_literal(&expected, "}");
+	err = hfs_control(session, "QUERY", &expected, true, &query);
+	if (err)
+		goto out;
+	err = hfs_received_original(session, query, "QUERY", &expected);
+	body = hfs_json_field(query, 0, "payload");
+	claim = hfs_json_field(query, body, "claim");
+	if (!err && (hfs_json_exact(query, body, "claim,result,status") || claim < 0 ||
+		     !hfs_json_is(query, hfs_json_field(query, body, "status"), "\"DECLINED\"") ||
+		     !hfs_json_is(query, hfs_json_field(query, body, "result"), "null") ||
+		     query->tokens[claim].end - query->tokens[claim].start != request->claim.len ||
+		     memcmp(query->data + query->tokens[claim].start, request->claim.data,
+			    request->claim.len)))
+		err = -EPROTO;
+	if (!err) {
+		mutex_lock(&session->lock);
+		if (request->held || request->users || request->terminal)
+			err = -EBUSY;
+		else {
+			hfs_json_free(request->response);
+			request->response = query;
+			query = NULL;
+			request->terminal = request->adopted = request->gap = true;
+		}
+		mutex_unlock(&session->lock);
+	}
+out:
+	hfs_json_free(query);
+	hfs_buf_free(&expected);
+unreserve:
+	hfs_controlled_unreserve(session, scratch_credit);
+	return err;
+}
