@@ -0,0 +1,16 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#include "hfs_crypto.h"
+#include "hfs_crypto/namespace.h"
+#include "hfs_crypto/vendor/src/optional/monocypher-ed25519.c"
+
+int hfs_ed25519_point_validate(const unsigned char bytes[32], int key);
+
+int hfs_ed25519_verify(const unsigned char key[32], const void *message,
+		       unsigned int length, const unsigned char signature[64])
+{
+	if (length > 128U * 1024U || (!message && length) ||
+	    hfs_ed25519_key_validate(key) ||
+	    hfs_ed25519_point_validate(signature, 0))
+		return -1;
+	return crypto_ed25519_check(signature, key, message, length);
+}
