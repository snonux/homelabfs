+/* The caller has joined physical/control work and owns session retirement.
+ * Stable process/family caches hold identity bytes only. Every progress parent,
+ * child credit and Received association is accounted by its actual identity. */
+static int hfs_controlled_terminal_inventory(struct hfs_session *session,
+					     const struct hfs_json *allowed)
+{
+	struct hfs_controlled_mount *mount;
+	struct hfs_controlled_credit *credit;
+	struct hfs_process *process;
+	struct hfs_view_family *family;
+	struct hfs_candidate *candidate;
+	struct hfs_completion *terminal = session->terminal_completion;
+	void *received;
+	u64 used = 0;
+	u32 children = 0, received_children = 0, i, cells = 0;
+	u32 ordinary = 0, control = 0, ordinary_received = 0, control_received = 0;
+	bool known;
+	int err;
+
+	err = hfs_received_terminal_empty(session, allowed);
+	if (err)
+		return err;
+	received = hfs_received_terminal_credit(session, allowed);
+	mutex_lock(&session->lock);
+	if (session->view || !list_empty(&session->requests) ||
+	    !list_empty(&session->descriptions) || !list_empty(&session->forgets) ||
+	    !list_empty(&session->view_tickets) || session->allocation_pending ||
+	    session->retirement_cut)
+		goto busy;
+	list_for_each_entry(family, &session->view_families, list)
+		if (family->retirement_cut || family->initial || family->prepared ||
+		    !family->next || family->floor != family->next - 1)
+			goto busy;
+	for (i = 0; i < ARRAY_SIZE(session->cells); i++) {
+		struct hfs_cell *cell = &session->cells[i];
+		if (!session->terminal_pending) {
+			if (cell->reserved || (cell->active && !cell->ack_ready))
+				goto busy;
+			if (cell->active) {
+				struct hfs_terminal_ack ack = { .cell = cell->number,
+								.slot = i,
+								.control = i >= 64 };
+				u32 j = cells++;
+				if (!ack.cell || ack.cell >= session->next_cell)
+					goto busy;
+				memcpy(ack.hash, cell->hash, 32);
+				/* Capture all actual slots and sort the immutable old-cell set. */
+				while (j && session->terminal_cells[j - 1].cell > ack.cell) {
+					session->terminal_cells[j] = session->terminal_cells[j - 1];
+					j--;
+				}
+				if ((j && session->terminal_cells[j - 1].cell == ack.cell) ||
+				    (j < cells - 1 &&
+				     session->terminal_cells[j + 1].cell == ack.cell))
+					goto busy;
+				session->terminal_cells[j] = ack;
+			}
+		} else if (cell->active || cell->reserved) {
+			u32 j;
+			bool found = false;
+			for (j = 0; j < session->nr_terminal_cells; j++) {
+				struct hfs_terminal_ack *ack = &session->terminal_cells[j];
+				if (ack->slot != i)
+					continue;
+				if (ack->control != (i >= 64))
+					goto busy;
+				if (j == 0 && i == session->terminal_slot &&
+				    cell->number == session->terminal_cell && allowed &&
+				    cell->active && cell->ack_ready && !cell->reserved)
+					found = true;
+				else if (cell->number == ack->cell &&
+					 !memcmp(cell->hash, ack->hash, 32) && cell->active &&
+					 cell->ack_ready &&
+					 (!cell->reserved ||
+					  (j == 0 && !list_empty(&session->uncertain))))
+					found = true;
+				break;
+			}
+			if (!session->nr_terminal_cells && i == session->terminal_slot &&
+			    ((allowed && cell->number == session->terminal_cell &&
+			      cell->ack_ready && !cell->reserved) ||
+			     (!allowed && cell->reserved && !list_empty(&session->uncertain))))
+				found = true;
+			if (!found)
+				goto busy;
+			cells++;
+		}
+	}
+	if (!session->terminal_pending) {
+		session->nr_terminal_cells = cells;
+		session->terminal_donor = cells ? session->terminal_cells[0].cell : 0;
+		if (cells)
+			memcpy(session->terminal_donor_hash, session->terminal_cells[0].hash, 32);
+	} else if (cells != session->nr_terminal_cells &&
+		   !(session->terminal_cell && !session->nr_terminal_cells && cells == 1))
+		goto busy;
+	if (!session->terminal_pending && !list_empty(&session->uncertain))
+		goto busy;
+	/* Pending candidates retain the known original donor slot. hfs_control's
+   * private typed retry independently validates the entire immutable command.
+   */
+	if (session->terminal_pending) {
+		u32 count = 0;
+		list_for_each_entry(candidate, &session->uncertain, list)
+			if (++count > 1 || !candidate->slot || !candidate->slot->reserved ||
+			    candidate->donor != session->terminal_donor ||
+			    candidate->completion != terminal)
+				goto busy;
+	}
+	mutex_lock(&hfs_controlled_lock);
+	mount = hfs_controlled_mount(session);
+	err = hfs_controlled_cleanup_live(mount);
+	if (err || !mount->retained || !mount->stopping || !session->retained ||
+	    !session->closing || mount->cookies || !terminal ||
+	    !hfs_completion_idle(session->control_completion) ||
+	    !hfs_completion_idle(session->retirement_completion))
+		goto provider_busy;
+	list_for_each_entry(credit, &hfs_controlled_credits, list) {
+		if (credit->session != session)
+			continue;
+		known = hfs_completion_owns_credit(session->control_completion, credit) ||
+			hfs_completion_owns_credit(session->retirement_completion, credit) ||
+			hfs_completion_owns_credit(terminal, credit) ||
+			credit == session->terminal_storage || credit == received;
+		list_for_each_entry(process, &session->processes, list)
+			if (credit == process->reservation)
+				known = true;
+		list_for_each_entry(family, &session->view_families, list)
+			if (credit == family->reservation)
+				known = true;
+		list_for_each_entry(candidate, &session->uncertain, list)
+			if (credit == candidate->reservation)
+				known = true;
+		if (!known)
+			goto provider_busy;
+		/* Completed acquisition-family identity caches can retain ordinary
+		 * class credits. They are enumerated above after exact family floors,
+		 * not erased or treated as live physical rights. Suballocations spend
+		 * their already counted parent rather than another global slot.
+		 */
+		if (!credit->completion) {
+			if (credit->control) {
+				control++;
+				control_received += credit->received;
+			} else {
+				ordinary++;
+				ordinary_received += credit->received;
+			}
+		}
+		if (credit->completion == terminal) {
+			used += credit->bytes;
+			children++;
+			if (credit->completion_received)
+				received_children++;
+		}
+	}
+	if (ordinary != mount->ordinary_credits || control != mount->control_credits ||
+	    ordinary_received != mount->ordinary_received ||
+	    control_received != mount->control_received)
+		goto provider_busy;
+	if (terminal->used != used || terminal->nr_slots != children ||
+	    terminal->nr_received != received_children ||
+	    refcount_read(&terminal->refs.refcount) != children + 1)
+		goto provider_busy;
+	mutex_unlock(&hfs_controlled_lock);
+	mutex_unlock(&session->lock);
+	return 0;
+provider_busy:
+	mutex_unlock(&hfs_controlled_lock);
+busy:
+	mutex_unlock(&session->lock);
+	return -EBUSY;
+}
+
+static int hfs_controlled_terminal_publish(struct hfs_session *session)
+{
+	struct hfs_controlled_mount *mount;
+	struct hfs_buf object;
+	struct hfs_buf *payload = &session->terminal_payload;
+	int err;
+
+	if (session->terminal_pending)
+		return 0;
+	if (!session->terminal_credentials.data || session->terminal_credentials.error ||
+	    !session->terminal_payload.data)
+		return -EACCES;
+	mutex_lock(&session->writer);
+	err = hfs_controlled_terminal_inventory(session, NULL);
+	if (err)
+		goto out;
+	mutex_lock(&hfs_controlled_lock);
+	mount = hfs_controlled_mount(session);
+	if (!mount || mount->revision == U64_MAX || !session->next_cell ||
+	    session->next_cell > HFS_CELL_MAX) {
+		err = -ESTALE;
+		goto unlock;
+	}
+	session->terminal_settled.len = 0;
+	session->terminal_settled.error = 0;
+	hfs_buf_literal(&session->terminal_settled, "[");
+	for (u32 i = 1; i < session->nr_terminal_cells; i++) {
+		struct hfs_terminal_ack *ack = &session->terminal_cells[i];
+		if (i > 1)
+			hfs_buf_literal(&session->terminal_settled, ",");
+		hfs_buf_printf(&session->terminal_settled,
+			       "{\"cell\":%llu,\"response_hash\":", ack->cell);
+		hfs_buf_hex(&session->terminal_settled, ack->hash, 32);
+		hfs_buf_literal(&session->terminal_settled, "}");
+	}
+	hfs_buf_literal(&session->terminal_settled, "]");
+	if (session->terminal_settled.error) {
+		err = session->terminal_settled.error;
+		goto unlock;
+	}
+	uuid_gen(&mount->terminal_id);
+	mount->terminal_through = session->next_cell - 1;
+	mount->revision++;
+	object = (struct hfs_buf){ .data = mount->terminal_object,
+				   .cap = sizeof(mount->terminal_object) };
+	hfs_buf_printf(&object, "{\"claims\":0,\"controller\":\"%pUb\",\"credentials\":",
+		       &mount->group->controller);
+	hfs_buf_add(&object, session->terminal_credentials.data, session->terminal_credentials.len);
+	hfs_buf_literal(&object, ",\"descriptions\":0,\"dirty_pins\":0,\"donor\":");
+	if (session->terminal_donor) {
+		hfs_buf_printf(&object,
+			       "{\"cell\":%llu,\"response_hash\":", session->terminal_donor);
+		hfs_buf_hex(&object, session->terminal_donor_hash, 32);
+		hfs_buf_literal(&object, "}");
+	} else
+		hfs_buf_literal(&object, "null");
+	hfs_buf_printf(&object,
+		       ",\"entrants\":0,\"guest_through\":%llu,\"held_results\":0,"
+		       "\"leases\":0,\"mapped_"
+		       "pages\":0,\"phase\":\"TERMINAL_PENDING\",\"polls\":0,"
+		       "\"received_external\":0,"
+		       "\"reservations\":0,\"retirement_id\":\"%pUb\",\"revision\":%"
+		       "llu,\"scope\":",
+		       mount->terminal_through, &mount->terminal_id, mount->revision);
+	hfs_buf_add(&object, session->enrollment.context, session->enrollment.context_len);
+	hfs_buf_literal(&object, ",\"settled_cells\":");
+	hfs_buf_add(&object, session->terminal_settled.data, session->terminal_settled.len);
+	hfs_buf_literal(&object, ",\"source_pins\":0,\"unknown\":0,\"version\":"
+				 "\"homelabfs-guest-terminal/1\"}");
+	err = object.error;
+	if (err)
+		goto unlock;
+	mount->terminal_length = object.len;
+	hfs_hash(object.data, object.len, mount->terminal_hash);
+	hfs_buf_literal(payload, "{\"closure_hash\":");
+	hfs_buf_hex(payload, mount->terminal_hash, 32);
+	hfs_buf_literal(payload, ",\"credentials\":");
+	hfs_buf_add(payload, session->terminal_credentials.data, session->terminal_credentials.len);
+	hfs_buf_printf(payload,
+		       ",\"guest_through\":%llu,\"observer_revision\":%llu,"
+		       "\"retirement_id\":\"%pUb\",\"settled_cells\":",
+		       mount->terminal_through, mount->revision, &mount->terminal_id);
+	hfs_buf_add(payload, session->terminal_settled.data, session->terminal_settled.len);
+	hfs_buf_literal(payload, "}");
+	err = payload->error;
+	if (!err) {
+		session->terminal_pending = true;
+		strscpy(mount->phase, "TERMINAL_PENDING", sizeof(mount->phase));
+	}
+unlock:
+	mutex_unlock(&hfs_controlled_lock);
+out:
+	mutex_unlock(&session->writer);
+	return err;
+}
+
+static int hfs_controlled_terminal_retire(struct hfs_session *session)
+{
+	struct hfs_controlled_mount *mount;
+	struct hfs_json *reply;
+	u32 i;
+	int err;
+
+	if (session->terminal_verified)
+		return 0;
+	err = hfs_controlled_terminal_publish(session);
+	if (err)
+		return err;
+	reply = session->terminal_response;
+	if (!reply) {
+		err = hfs_control(session, "SESSION_RETIRE", &session->terminal_payload, true,
+				  &reply);
+		if (err)
+			return err;
+		session->terminal_response = reply;
+	}
+	err = hfs_received_terminal(session, reply, &session->terminal_payload);
+	if (!err)
+		err = hfs_controlled_terminal_inventory(session, reply);
+	if (err)
+		return err;
+	mutex_lock(&hfs_controlled_lock);
+	mount = hfs_controlled_mount(session);
+	if (!mount || !mount->terminal_length) {
+		mutex_unlock(&hfs_controlled_lock);
+		return -ESTALE;
+	}
+	mount->terminal_retired = true;
+	strscpy(mount->phase, "TERMINAL_RETIRED", sizeof(mount->phase));
+	session->terminal_mount = mount;
+	session->terminal_verified = true;
+	mutex_unlock(&hfs_controlled_lock);
+	/* Positive private handoff transfers only the guest transport bookkeeping.
+   * The native final cell/exporter row and permanent registry stay charged. */
+	hfs_json_free(session->terminal_response);
+	session->terminal_response = NULL;
+	mutex_lock(&session->lock);
+	for (i = 0; i < ARRAY_SIZE(session->cells); i++)
+		memset(&session->cells[i], 0, sizeof(session->cells[i]));
+	mutex_unlock(&session->lock);
+	hfs_completion_close(session->control_completion);
+	session->control_completion = NULL;
+	hfs_completion_close(session->retirement_completion);
+	session->retirement_completion = NULL;
+	hfs_buf_free(&session->terminal_credentials);
+	hfs_buf_free(&session->terminal_payload);
+	hfs_buf_free(&session->terminal_settled);
+	hfs_controlled_unreserve(session, session->terminal_storage);
+	session->terminal_storage = NULL;
+	hfs_completion_close(session->terminal_completion);
+	session->terminal_completion = NULL;
+	return 0;
+}
+
+static int hfs_controlled_retire_session(struct hfs_session *session)
+{
+	if (session->enrollment.protocol_features == HFS_TERMINAL_FEATURES)
+		return hfs_controlled_terminal_retire(session);
+	struct hfs_controlled_mount *mount;
+	struct hfs_view *view;
+	unsigned long flags;
+	u32 i;
+	int err = -EBUSY;
+
+	mutex_lock(&hfs_controlled_lock);
+	mount = hfs_controlled_mount(session);
+	if (!mount) {
+		mutex_unlock(&hfs_controlled_lock);
+		return -ESTALE;
+	}
+	if (!mount->retained || !mount->stopping || !session->retained ||
+	    !READ_ONCE(session->closing) || mount->cookies || mount->ordinary_credits ||
+	    mount->control_credits || mount->ordinary_received || mount->control_received) {
+		mutex_unlock(&hfs_controlled_lock);
+		return -EBUSY;
+	}
+	mutex_unlock(&hfs_controlled_lock);
+	mutex_lock(&session->lock);
+	if (!list_empty(&session->requests) || !list_empty(&session->uncertain) ||
+	    !list_empty(&session->descriptions) || session->allocation_pending ||
+	    session->retirement_cut)
+		goto unlock;
+	for (i = 0; i < ARRAY_SIZE(session->cells); i++)
+		if (session->cells[i].active || session->cells[i].reserved)
+			goto unlock;
+	err = -EOPNOTSUPP;
+unlock:
+	mutex_unlock(&session->lock);
+	view = hfs_view_get(session);
+	if (view) {
+		spin_lock_irqsave(&view->lock, flags);
+		if (view->active || view->nr_cached || view->nr_dirty || view->nr_observations ||
+		    view->nr_mappings)
+			err = -EBUSY;
+		spin_unlock_irqrestore(&view->lock, flags);
+		hfs_view_put(view);
+	}
+	/* Even the never-issued case has no supported protected terminal handoff.
+   * All registry/session/device/module ownership remains intact for 614.
+   */
+	return err;
+}
diff --git a/fs/9p/hfs_completion.inc b/fs/9p/hfs_completion.inc
new file mode 100644
--- /dev/null
+++ b/fs/9p/hfs_completion.inc
@@ -0,0 +1,465 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Preowned completion capacity, independently retained by actual descendants. */
+#define HFS_COMPLETION_SLOTS 16U
+#define HFS_COMPLETION_RECEIVED 3U
+#define HFS_EVENT_BODY_MAX 65536U
+#define HFS_FLOOR_BODY_MAX 32768U
+#define HFS_COMMAND_FIXED_MAX 1024U
+/* The provisioned slot floor (hfs_controlled_internal.h) counts these exact
+ * packages; keep both in step.
+ */
+_Static_assert(HFS_FLOOR_PACKAGE == 1U + HFS_COMPLETION_SLOTS, "floor package");
+_Static_assert(HFS_FLOOR_PACKAGE_RECEIVED == HFS_COMPLETION_RECEIVED, "floor received");
+_Static_assert(HFS_FLOOR_EVENT_RECEIVED == HFS_MMAP_EVENTS_MAX + 3U, "floor event lane");
+struct hfs_completion {
+ struct kref refs;
+ struct hfs_session *session;
+ void *reservation;
+ void *slots[HFS_COMPLETION_SLOTS];
+ u64 capacity, used;
+ u32 nr_slots, nr_received, body, received_limit, lane;
+ bool control, closed, uncertain;
+};
+
+static void hfs_completion_destroy(struct kref *refs)
+{
+ struct hfs_completion *completion = container_of(refs, struct hfs_completion, refs);
+ struct hfs_session *session = completion->session;
+ void *reservation = completion->reservation;
+ u32 i;
+
+ WARN_ON_ONCE(completion->used || completion->nr_slots || completion->nr_received);
+ for (i = 0; i < HFS_COMPLETION_SLOTS; i++)
+  if (i < completion->received_limit)
+   hfs_controlled_received_release(session, completion->slots[i]);
+  else
+   hfs_controlled_unreserve(session, completion->slots[i]);
+ kfree(completion);
+ hfs_controlled_unreserve(session, reservation);
+}
+
+struct hfs_completion *hfs_completion_get(struct hfs_completion *completion)
+{
+ if (completion)
+  kref_get(&completion->refs);
+ return completion;
+}
+
+void hfs_completion_put(struct hfs_completion *completion)
+{
+ if (completion)
+  kref_put(&completion->refs, hfs_completion_destroy);
+}
+
+/* A definite parent reap releases only unused capacity. Still-held child
+ * packages and their slot reservations remain independently referenced. An
+ * uncertain carrier keeps its complete reserved retry headroom conservatively.
+ */
+void hfs_completion_close(struct hfs_completion *completion)
+{
+ struct hfs_controlled_credit *credit;
+ u64 unused;
+
+ if (!completion)
+  return;
+ mutex_lock(&hfs_controlled_lock);
+ if (!completion->closed && !completion->uncertain) {
+  unused = completion->capacity - completion->used;
+  credit = completion->reservation;
+  credit->bytes -= unused;
+  completion->capacity -= unused;
+  if (completion->control)
+   hfs_controlled_control_used -= unused;
+  else
+   hfs_controlled_ordinary_used -= unused;
+ }
+ completion->closed = true;
+ mutex_unlock(&hfs_controlled_lock);
+ hfs_completion_put(completion);
+}
+
+void hfs_completion_uncertain(struct hfs_completion *completion)
+{
+ if (completion) {
+  mutex_lock(&hfs_controlled_lock);
+  completion->uncertain = true;
+  mutex_unlock(&hfs_controlled_lock);
+ }
+}
+
+int hfs_controlled_trim_credit(struct hfs_session *session, void *reservation, u64 bytes)
+{
+ struct hfs_controlled_credit *credit;
+ u64 total, unused;
+ int err = -ESTALE;
+
+ if (check_add_overflow(bytes, (u64)sizeof(*credit), &total))
+  return -EOVERFLOW;
+ mutex_lock(&hfs_controlled_lock);
+ list_for_each_entry(credit, &hfs_controlled_credits, list)
+  if (credit == reservation && credit->session == session) {
+   if (total > credit->bytes) { err = -ENOSPC; break; }
+   unused = credit->bytes - total;
+   credit->bytes = total;
+   if (credit->completion)
+    credit->completion->used -= unused;
+   else if (credit->control)
+    hfs_controlled_control_used -= unused;
+   else
+    hfs_controlled_ordinary_used -= unused;
+   err = 0;
+   break;
+  }
+ mutex_unlock(&hfs_controlled_lock);
+ return err;
+}
+
+static u64 hfs_completion_carrier(u32 command, u32 response)
+{
+ return sizeof(struct hfs_candidate) + command + 2ULL * response + 2ULL +
+  sizeof(struct hfs_json) + 2ULL * min_t(u32, response / 2 + 1, 131072U) *
+  sizeof(struct hfs_token) + 6ULL * (HFS_HEADER_SIZE + HFS_CHUNK_MAX + 1ULL);
+}
+
+/* Bound simultaneous phases rather than add mutually exclusive peaks.
+ * Ordinary: retained ALLOCATE+terminal QUERY+snapshot+caller and an uncertain
+ * QUERY carrier; or ALLOCATE+GAP+QUERY with two uncertain small CALL/GAP
+ * carriers and one current carrier. CALL/ALLOCATE/GAP closed replies contain
+ * only claim/code/proof, bounded by context+claim+1024 before transport.
+ * View: initial/current/new-query owners, four copies, and one carrier (also
+ * covers one uncertain carrier after current transport completes). Repeated
+ * additional uncertainty is retained but may exhaust this finite package.
+ */
+static u64 hfs_completion_capacity(bool view, u32 body)
+{
+ u32 command = view ? HFS_VIEW_BODY_MAX : HFS_BODY_MAX;
+ u32 small = HFS_CONTEXT_MAX + 4096 + 1024;
+ u64 carrier = hfs_completion_carrier(command, body);
+ u32 query_command = HFS_CONTEXT_MAX + (view ? 32768U : 4096U) + HFS_COMMAND_FIXED_MAX;
+ u64 owner = hfs_received_capacity(query_command, body);
+ u64 copy = hfs_received_copy_capacity(body);
+ u64 bytes, gap;
+
+ if (!view && body < HFS_BODY_MAX) {
+  u64 direct = hfs_received_capacity(4096U + 16384U + 32768U + HFS_CONTEXT_MAX + HFS_COMMAND_FIXED_MAX, body);
+
+  bytes = owner + 2ULL * copy + 2ULL * carrier; /* earmarked drain: no ALLOCATE/GAP */
+  if (direct + carrier > bytes)
+   bytes = direct + carrier;
+ }
+ else if (view)
+  bytes = hfs_received_capacity(command, body) + 2ULL * owner + 4ULL * copy + carrier;
+ else {
+  u64 allocation = hfs_received_capacity(command, small);
+
+  bytes = allocation + owner + 2ULL * copy + carrier;
+  gap = 2ULL * allocation + owner + carrier +
+   2ULL * hfs_completion_carrier(command, small) + 2ULL * HFS_BODY_MAX;
+  if (gap > bytes)
+   bytes = gap;
+ }
+ /* Actual child reservation records are included in every suballocation. */
+ return bytes + HFS_COMPLETION_SLOTS * sizeof(struct hfs_controlled_credit);
+}
+
+static int hfs_completion_create(struct hfs_session *session, bool control,
+ u64 capacity, u32 body, u32 received_limit, u32 lane, struct hfs_completion **out)
+{
+ struct hfs_completion *completion;
+ void *reservation;
+ u32 i;
+ int err;
+
+ *out = NULL;
+ if (!hfs_controlled_owns(session))
+  return 0;
+ err = hfs_controlled_reserve(session, capacity + sizeof(*completion), control, &reservation);
+ if (err)
+  return err;
+ completion = kzalloc(sizeof(*completion), GFP_KERNEL);
+ if (!completion) {
+  hfs_controlled_unreserve(session, reservation);
+  return -ENOMEM;
+ }
+ completion->session = session;
+ completion->reservation = reservation;
+ completion->capacity = capacity;
+ completion->body = body;
+ completion->received_limit = received_limit;
+ completion->lane = lane;
+ completion->control = control;
+ kref_init(&completion->refs);
+ for (i = 0; i < HFS_COMPLETION_SLOTS; i++) {
+  if (i < completion->received_limit)
+   err = hfs_controlled_received_reserve(session, 1, control, &completion->slots[i]);
+  else
+   err = hfs_controlled_reserve(session, 1, control, &completion->slots[i]);
+  if (err) {
+   hfs_completion_put(completion);
+   return err;
+  }
+ }
+ *out = completion;
+ return 0;
+}
+
+int hfs_completion_new(struct hfs_session *session, bool control, bool view, u32 body,
+ struct hfs_completion **out)
+{
+ return hfs_completion_create(session, control, hfs_completion_capacity(view, body),
+  body, HFS_COMPLETION_RECEIVED, 0, out);
+}
+
+/* Source bounds: mmap.pending[3]+last_event survive until process/ACK returns;
+ * mmap.poll reposts WAIT before ACK. Event actors therefore own four retained
+ * events, one WAIT prefetch and one ACK prefetch. Ordinary/view retirement can
+ * retain two independent cuts; they have a separate lane and cannot borrow
+ * any event Received slots or capacity.
+ * Full mapped unsigned receipts are bounded by the actual16384-byte verifier
+ * arena. EVENT adds domain<=8192, target<=8192, context<=4096, fixed<=4096:
+ * 40960<65536. FLOOR adds context and fixed fields to that receipt: <32768.
+ * ACK/RELEASE_CELL carry status only, without an EVENT/source receipt.
+ */
+int hfs_completion_progress_new(struct hfs_session *session, bool retirement,
+ struct hfs_completion **out)
+{
+ u64 carrier = hfs_completion_carrier(HFS_BODY_MAX, HFS_BODY_MAX);
+ u64 bytes, owner;
+ u32 limit;
+
+ if (HFS_CONTEXT_MAX + HFS_CAP_MAX + HFS_TARGET_MAX + HFS_RECEIPT_UNSIGNED_MAX + 4096U > HFS_EVENT_BODY_MAX ||
+     HFS_CONTEXT_MAX + HFS_RECEIPT_UNSIGNED_MAX + 4096U > HFS_FLOOR_BODY_MAX)
+  return -EOVERFLOW;
+ if (retirement) {
+  owner = hfs_received_capacity(HFS_BODY_MAX, HFS_FLOOR_BODY_MAX);
+  bytes = 2ULL * owner + 2ULL * carrier + 4ULL * HFS_BODY_MAX;
+  limit = 2;
+ } else {
+  u32 event_command = HFS_CONTEXT_MAX + HFS_CAP_MAX + HFS_COMMAND_FIXED_MAX;
+
+  owner = hfs_received_capacity(event_command, HFS_EVENT_BODY_MAX);
+  bytes = (HFS_MMAP_EVENTS_MAX + 2ULL) * owner + 2ULL * carrier +
+   hfs_received_capacity(HFS_BODY_MAX, HFS_CONTEXT_MAX + 4096 + 1024) +
+   2ULL * hfs_received_copy_capacity(HFS_EVENT_BODY_MAX) + 2ULL * HFS_BODY_MAX;
+  limit = HFS_MMAP_EVENTS_MAX + 3;
+ }
+ bytes += HFS_COMPLETION_SLOTS * sizeof(struct hfs_controlled_credit);
+ return hfs_completion_create(session, true, bytes, HFS_BODY_MAX, limit,
+  retirement ? 2 : 1, out);
+}
+
+int hfs_completion_terminal_new(struct hfs_session *session,
+ struct hfs_completion **out)
+{
+ u64 bytes = hfs_completion_carrier(HFS_BODY_MAX, HFS_BODY_MAX) +
+  hfs_received_capacity(HFS_BODY_MAX, HFS_FLOOR_BODY_MAX) +
+  4ULL * HFS_TERMINAL_OBJECT_MAX + sizeof(struct hfs_process) +
+  2ULL * sizeof(struct hfs_cred) + sizeof(struct cred) +
+  sizeof(struct group_info) + HFS_GROUPS_MAX * sizeof(kgid_t) +
+  sizeof(struct pid) + sizeof(struct user_namespace) +
+  HFS_COMPLETION_SLOTS * sizeof(struct hfs_controlled_credit);
+
+ return hfs_completion_create(session, true, bytes, HFS_BODY_MAX, 1, 3, out);
+}
+
+/* Actual preowned parents retain independent references until terminal proof.
+ * Caller owns the provider mutex; no external borrower may be hidden here. */
+static bool hfs_completion_idle(struct hfs_completion *completion)
+{
+ return completion && !completion->closed && !completion->uncertain &&
+  !completion->used && !completion->nr_slots && !completion->nr_received &&
+  refcount_read(&completion->refs.refcount) == 1;
+}
+
+static bool hfs_completion_owns_credit(struct hfs_completion *completion,
+ struct hfs_controlled_credit *credit)
+{
+ u32 i;
+
+ if (!completion)
+  return false;
+ if (credit == completion->reservation)
+  return true;
+ for (i = 0; i < HFS_COMPLETION_SLOTS; i++)
+  if (credit == completion->slots[i])
+   return true;
+ return false;
+}
+
+u32 hfs_completion_retained_body(struct hfs_completion *completion,
+ const char *operation, u32 wire_cap)
+{
+ u32 cap = wire_cap;
+
+ if (completion && (completion->lane == 2 || completion->lane == 3))
+  cap = HFS_FLOOR_BODY_MAX;
+ else if (completion && completion->lane == 1)
+  cap = (!strcmp(operation, "VIEW_WAIT") || !strcmp(operation, "VIEW_POLL")) ?
+   HFS_EVENT_BODY_MAX : HFS_CONTEXT_MAX + 4096 + 1024;
+ return cap < wire_cap ? cap : wire_cap;
+}
+
+static void hfs_completion_release_credit(struct hfs_controlled_credit *credit)
+{
+ struct hfs_completion *completion = credit->completion;
+
+ mutex_lock(&hfs_controlled_lock);
+ completion->used -= credit->bytes;
+ completion->nr_slots--;
+ if (credit->completion_received)
+  completion->nr_received--;
+ mutex_unlock(&hfs_controlled_lock);
+ kfree(credit);
+ hfs_completion_put(completion);
+}
+
+int hfs_completion_reserve(struct hfs_completion *completion, u64 bytes,
+ bool received, void **out)
+{
+ struct hfs_controlled_credit *credit;
+ u64 total;
+ int err;
+
+ *out = NULL;
+ /* An absent lane (failed bind_super, or one already closed and cleared)
+  * owns no capacity; never dereference it.
+  */
+ if (!completion)
+  return -ESTALE;
+ if (check_add_overflow(bytes, (u64)sizeof(*credit), &total))
+  return -EOVERFLOW;
+ mutex_lock(&hfs_controlled_lock);
+ err = completion->closed ? -ESTALE :
+  hfs_controlled_cleanup_live(hfs_controlled_mount(completion->session));
+ if (!err && (completion->nr_slots == HFS_COMPLETION_SLOTS ||
+     (received && completion->nr_received == completion->received_limit) ||
+     total > completion->capacity - completion->used))
+  err = -ENOSPC;
+ if (!err) {
+  completion->used += total;
+  completion->nr_slots++;
+  if (received)
+   completion->nr_received++;
+  kref_get(&completion->refs);
+ }
+ mutex_unlock(&hfs_controlled_lock);
+ if (err)
+  return err;
+ credit = kzalloc(sizeof(*credit), GFP_KERNEL);
+ if (!credit) {
+  mutex_lock(&hfs_controlled_lock);
+  completion->used -= total;
+  completion->nr_slots--;
+  if (received)
+   completion->nr_received--;
+  mutex_unlock(&hfs_controlled_lock);
+  hfs_completion_put(completion);
+  return -ENOMEM;
+ }
+ credit->completion = completion;
+ credit->session = completion->session;
+ credit->control = completion->control;
+ credit->bytes = total;
+ credit->received = credit->completion_received = received;
+ mutex_lock(&hfs_controlled_lock);
+ err = completion->closed ? -ESTALE :
+  hfs_controlled_cleanup_live(hfs_controlled_mount(completion->session));
+ if (!err)
+  list_add_tail(&credit->list, &hfs_controlled_credits);
+ mutex_unlock(&hfs_controlled_lock);
+ if (err) {
+  hfs_completion_release_credit(credit);
+  return err;
+ }
+ *out = credit;
+ return 0;
+}
+
+bool hfs_completion_control(struct hfs_completion *completion)
+{
+ return completion->control;
+}
+
+u32 hfs_completion_body(struct hfs_completion *completion)
+{
+ return completion->body;
+}
+
+int hfs_controlled_progress_reserve(struct hfs_session *session, u64 bytes, void **credit)
+{
+ if (!session->retirement_completion)
+  return -ESTALE;
+ return hfs_completion_reserve(session->retirement_completion, bytes, false, credit);
+}
+
+/* Only exact still-owned original request/ticket buffers select a package.
+ * No parser, resource/provider/view lock nests under the session lifetime lock.
+ */
+struct hfs_completion *hfs_completion_find(struct hfs_session *session,
+ const char *operation, const struct hfs_buf *payload)
+{
+ struct hfs_request *request;
+ struct hfs_view_ticket *ticket;
+ struct hfs_completion *found = NULL;
+ u32 offset;
+ bool query = !strcmp(operation, "QUERY") || !strcmp(operation, "CANCEL");
+
+ mutex_lock(&session->lock);
+ list_for_each_entry(request, &session->requests, list) {
+  if (!request->completion || request->session != session || !request->reservation)
+   continue;
+  offset = 0;
+  if (!strcmp(operation, "READDIR_CLEANUP")) {
+   if (request->terminal && request->users && request->result && !request->readdir_cleanup.error &&
+       request->readdir_cleanup.len == payload->len &&
+       !memcmp(request->readdir_cleanup.data, payload->data, payload->len)) {
+    found = request->completion;
+    break;
+   }
+   continue;
+  }
+  if (query) {
+   if (!hfs_controlled_segment(payload, &offset, "{\"claim\":", 9) ||
+       !hfs_controlled_segment(payload, &offset, request->claim.data, request->claim.len) ||
+       !hfs_controlled_segment(payload, &offset, "}", 1))
+    continue;
+  } else if (!strcmp(operation, "CALL") || !strcmp(operation, "ALLOCATE") || !strcmp(operation, "GAP_RESOLVE")) {
+   if (!hfs_controlled_segment(payload, &offset, "{\"claim\":", 9) ||
+       !hfs_controlled_segment(payload, &offset, request->claim.data, request->claim.len) ||
+       !hfs_controlled_segment(payload, &offset, ",\"credentials\":", 15) ||
+       !hfs_controlled_segment(payload, &offset, request->credentials.data, request->credentials.len) ||
+       !hfs_controlled_segment(payload, &offset, ",\"intent\":", 10) ||
+       !hfs_controlled_segment(payload, &offset, request->intent.data, request->intent.len) ||
+       !hfs_controlled_segment(payload, &offset, "}", 1))
+    continue;
+  } else
+   continue;
+  if (offset == payload->len) { found = request->completion; break; }
+ }
+ if (!found)
+  list_for_each_entry(ticket, &session->view_tickets, list) {
+   const struct hfs_buf *expected;
+
+   if (!ticket->completion || ticket->session != session || !ticket->reservation || !ticket->bound)
+    continue;
+   if (!strcmp(operation, "VIEW_QUERY") || !strcmp(operation, "VIEW_CANCEL"))
+    expected = &ticket->query;
+   else if (!strcmp(operation, ticket->operation))
+    expected = &ticket->payload;
+   else
+    continue;
+   if (!expected->error && expected->len == payload->len &&
+       !memcmp(expected->data, payload->data, payload->len)) { found = ticket->completion; break; }
+  }
+ if (!found && (!strcmp(operation, "VIEW_WAIT") || !strcmp(operation, "VIEW_POLL") ||
+     !strcmp(operation, "VIEW_ACK") || !strcmp(operation, "RELEASE_CELL")))
+  found = session->control_completion;
+ if (!found && !strcmp(operation, "SESSION_RETIRE"))
+  found = session->terminal_completion;
+ if (!found && (!strcmp(operation, "RETIRE") || !strcmp(operation, "VIEW_RETIRE")))
+  found = session->retirement_completion;
+ if (found)
+  kref_get(&found->refs);
+ mutex_unlock(&session->lock);
+ return found;
+}
diff --git a/fs/9p/hfs_controlled_artifacts.c b/fs/9p/hfs_controlled_artifacts.c
new file mode 100644
--- /dev/null
+++ b/fs/9p/hfs_controlled_artifacts.c
@@ -0,0 +1,686 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Transactional signed local provisioning and complete boot-owned inventory. */
+#include "hfs_controlled_internal.h"
+#include "hfs_crypto.h"
+#ifndef HFS_PROVIDER_USERSPACE
+#include <linux/atomic.h>
+#include <linux/build_bug.h>
+#include <linux/capability.h>
+#include <linux/kernfs.h>
+#include <linux/kobject.h>
+#include <linux/overflow.h>
+#include <linux/random.h>
+#include <linux/slab.h>
+#include <linux/seq_file.h>
+#include <linux/user_namespace.h>
+#endif
+
+DEFINE_MUTEX(hfs_controlled_lock);
+struct hfs_controlled_registry *hfs_controlled_registry;
+uuid_t hfs_controlled_boot;
+uuid_t hfs_controlled_nonce;
+static u8 hfs_controlled_operator[32];
+static atomic_t hfs_artifact_opens = ATOMIC_INIT(0);
+
+static int hfs_artifact_signature(const struct hfs_json *json, int token,
+				 const u8 key[32], const void *bytes, u32 length)
+{
+	u8 signature[64];
+	u32 size = sizeof(signature);
+
+	if (hfs_json_hex(json, token, signature, &size) || size != sizeof(signature) ||
+	    hfs_ed25519_verify(key, bytes, length, signature))
+		return -EKEYREJECTED;
+	return 0;
+}
+
+static int hfs_artifact_uuid(const struct hfs_json *json, int object,
+			    const char *name, uuid_t *uuid)
+{
+	return hfs_uuid(json, hfs_json_field(json, object, name), uuid) ||
+		uuid_is_null(uuid) ? -EPROTO : 0;
+}
+
+static int hfs_artifact_hash(const struct hfs_json *json, int object,
+			    const char *name, u8 hash[32])
+{
+	u32 length = 32;
+
+	return hfs_json_hex(json, hfs_json_field(json, object, name), hash, &length) ||
+		length != 32 ? -EPROTO : 0;
+}
+
+static int hfs_artifact_signatures(const struct hfs_json *json, int signatures,
+		const struct hfs_signed_enrollment *enrollment,
+		const void *bytes, u32 length)
+{
+	u32 count, child, i;
+
+	if (hfs_enrollment_array(json, signatures, enrollment->count, &count) ||
+	    count != enrollment->count)
+		return -EPROTO;
+	child = signatures + 1;
+	for (i = 0; i < count; i++) {
+		if (hfs_json_exact(json, child, "guest,host") ||
+		    hfs_artifact_signature(json, hfs_json_field(json, child, "host"),
+				enrollment->domains[i].host, bytes, length) ||
+		    hfs_artifact_signature(json, hfs_json_field(json, child, "guest"),
+				enrollment->domains[i].guest, bytes, length))
+			return -EKEYREJECTED;
+		child = hfs_enrollment_next(json, child);
+	}
+	return 0;
+}
+
+int hfs_controlled_idmap(u8 hash[32])
+{
+	static const char canonical[] =
+		"{\"gid\":[[0,0,4294967295]],\"uid\":[[0,0,4294967295]]}";
+	const struct uid_gid_map *uid = &init_user_ns.uid_map;
+	const struct uid_gid_map *gid = &init_user_ns.gid_map;
+
+	/* Initial namespace only; compare real numeric maps before deriving the
+	 * stable protocol hash. A signed namespace UUID cannot replace this.
+	 */
+	if (uid->nr_extents != 1 || gid->nr_extents != 1 ||
+	    uid->extent[0].first || uid->extent[0].lower_first ||
+	    gid->extent[0].first || gid->extent[0].lower_first ||
+	    uid->extent[0].count != U32_MAX || gid->extent[0].count != U32_MAX)
+		return -EOPNOTSUPP;
+	hfs_hash(canonical, sizeof(canonical) - 1, hash);
+	return 0;
+}
+
+static int hfs_mount_text(const struct hfs_json *json, int object,
+			  const char *name, char text[256])
+{
+	int length = hfs_json_string(json, hfs_json_field(json, object, name), text, 256);
+	int i;
+
+	if (length <= 0 || length > 255)
+		return -EPROTO;
+	for (i = 0; i < length; i++)
+		if (text[i] < 0x20 || text[i] > 0x7e || text[i] == '/')
+			return -EPROTO;
+	return 0;
+}
+
+static int hfs_artifact_mount(const struct hfs_json *json, int object,
+		struct hfs_controlled_group *group, u32 domain_index,
+		struct hfs_controlled_mount **out)
+{
+	struct hfs_controlled_mount *mount;
+	struct hfs_enrolled_domain *domain = &group->enrollment->domains[domain_index];
+	const struct hfs_json *original = group->enrollment->json;
+	u8 actual_idmap[32];
+	u64 index;
+	u32 subject_length = 1024;
+	int err = -EPROTO;
+
+	*out = NULL;
+	mount = kzalloc(sizeof(*mount), GFP_KERNEL);
+	if (!mount)
+		return -ENOMEM;
+	mount->group = group;
+	mount->domain_index = domain_index;
+	if (hfs_json_exact(json, object,
+		"anchor,device_name,device_tag,domain_index,idmap_hash,nonce,realm,session,subject,user_namespace,view_control_nonce") ||
+	    hfs_json_u64(json, hfs_json_field(json, object, "domain_index"), &index) ||
+	    index != domain_index ||
+	    hfs_artifact_uuid(json, object, "session", &mount->enrollment.session) ||
+	    !uuid_equal(&mount->enrollment.session, &domain->session) ||
+	    hfs_mount_text(json, object, "device_name", mount->device_name) ||
+	    hfs_mount_text(json, object, "device_tag", mount->device_tag) ||
+	    hfs_artifact_uuid(json, object, "user_namespace", &mount->user_namespace) ||
+	    hfs_artifact_hash(json, object, "idmap_hash", mount->idmap_hash) ||
+	    hfs_controlled_idmap(actual_idmap) || memcmp(actual_idmap, mount->idmap_hash, 32) ||
+	    hfs_artifact_uuid(json, object, "realm", &mount->enrollment.realm) ||
+	    hfs_artifact_uuid(json, object, "anchor", &mount->enrollment.anchor) ||
+	    hfs_artifact_uuid(json, object, "nonce", &mount->enrollment.nonce) ||
+	    hfs_artifact_uuid(json, object, "view_control_nonce", &mount->enrollment.view_control_nonce) ||
+	    !uuid_equal(&mount->enrollment.view_control_nonce, &domain->control_nonce) ||
+	    hfs_json_hex(json, hfs_json_field(json, object, "subject"),
+			 mount->enrollment.subject, &subject_length) || !subject_length)
+		goto fail;
+	/* Full family pairs must differ; individual anchors may coincide. */
+	if ((uuid_equal(&mount->enrollment.anchor, &domain->acquisition_anchor) &&
+	     uuid_equal(&mount->enrollment.nonce, &domain->acquisition_nonce)) ||
+	    (uuid_equal(&mount->enrollment.anchor, &domain->control_anchor) &&
+	     uuid_equal(&mount->enrollment.nonce, &domain->control_nonce)))
+		goto fail;
+	mount->enrollment.subject_len = subject_length;
+	mount->enrollment.view_scope = HFS_SCOPE_CONTROLLED_LOCAL;
+	mount->enrollment.protocol_features = domain->features;
+	mount->enrollment.acquisition_anchor = domain->acquisition_anchor;
+	mount->enrollment.acquisition_nonce = domain->acquisition_nonce;
+	mount->enrollment.control_anchor = domain->control_anchor;
+	mount->enrollment.context_len = original->tokens[domain->scope].end -
+		original->tokens[domain->scope].start;
+	if (mount->enrollment.context_len >= HFS_CONTEXT_MAX)
+		goto fail;
+	memcpy(mount->enrollment.context,
+	       original->data + original->tokens[domain->scope].start,
+	       mount->enrollment.context_len);
+	mount->current_fence = mount->observation_fence = mount->revision = 1;
+	strscpy(mount->phase, "LIVE", sizeof(mount->phase));
+	*out = mount;
+	return 0;
+fail:
+	kfree(mount);
+	return err;
+}
+
+static int hfs_artifact_budget(const struct hfs_json *json, int object,
+			       struct hfs_controlled_budget *budget)
+{
+	u64 ordinary, control, reservations, cookies, received;
+
+	if (hfs_json_exact(json, object,
+			    "control_bytes,cookies,ordinary_bytes,received,reservations") ||
+	    hfs_json_u64(json, hfs_json_field(json, object, "ordinary_bytes"), &ordinary) ||
+	    hfs_json_u64(json, hfs_json_field(json, object, "control_bytes"), &control) ||
+	    hfs_json_u64(json, hfs_json_field(json, object, "reservations"), &reservations) ||
+	    hfs_json_u64(json, hfs_json_field(json, object, "cookies"), &cookies) ||
+	    hfs_json_u64(json, hfs_json_field(json, object, "received"), &received) ||
+	    !ordinary || ordinary > (1ULL << 30) || !control ||
+	    control > (1ULL << 30) || ordinary + control > (1ULL << 30) ||
+	    !reservations || reservations > 8192 ||
+	    !cookies || cookies > 4096 || !received || received > 4096)
+		return -EPROTO;
+	budget->ordinary_bytes = ordinary;
+	budget->control_bytes = control;
+	budget->reservations = reservations;
+	budget->cookies = cookies;
+	budget->received = received;
+	return 0;
+}
+
+static int hfs_artifact_group(const struct hfs_json *json, int object,
+		int group_signatures, int payload,
+		struct hfs_controlled_registry *registry, u32 index)
+{
+	struct hfs_controlled_group *group = &registry->groups[index];
+	struct hfs_signed_enrollment *enrollment;
+	struct hfs_controlled_mount *mount;
+	void *bytes = NULL;
+	u32 length, count, child, domain_index, local_count = 0, i;
+	int encoded, local, err = -EPROTO;
+
+	if (hfs_json_exact(json, object,
+		"enrollment_bytes,enrollment_domain_signatures,enrollment_operator_signature,local_mounts"))
+		return -EPROTO;
+	encoded = hfs_json_field(json, object, "enrollment_bytes");
+	if (encoded < 0 || json->tokens[encoded].kind != HFS_STRING)
+		return -EPROTO;
+	length = (json->tokens[encoded].end - json->tokens[encoded].start - 2) / 2;
+	if (!length || length > HFS_ADMISSION_MAX)
+		return -E2BIG;
+	bytes = kvmalloc(length, GFP_KERNEL);
+	if (!bytes)
+		return -ENOMEM;
+	err = hfs_json_hex(json, encoded, bytes, &length);
+	if (!err)
+		err = hfs_signed_enrollment_decode(bytes, length, &group->enrollment);
+	if (err)
+		goto out;
+	enrollment = group->enrollment;
+	if (hfs_artifact_signature(json,
+			hfs_json_field(json, object, "enrollment_operator_signature"),
+			hfs_controlled_operator, bytes, length) ||
+	    hfs_artifact_signatures(json,
+			hfs_json_field(json, object, "enrollment_domain_signatures"),
+			enrollment, bytes, length) ||
+	    hfs_artifact_signatures(json, group_signatures, enrollment,
+		json->data + json->tokens[payload].start,
+		json->tokens[payload].end - json->tokens[payload].start)) {
+		err = -EKEYREJECTED;
+		goto out;
+	}
+	for (i = 0; i < index; i++)
+		if (uuid_equal(&registry->groups[i].enrollment->id, &enrollment->id)) {
+			err = -EPROTO;
+			goto out;
+		}
+	local = hfs_json_field(json, object, "local_mounts");
+	err = hfs_enrollment_array(json, local, 64, &count);
+	if (err || !count) {
+		err = -EPROTO;
+		goto out;
+	}
+	child = local + 1;
+	for (domain_index = 0; domain_index < enrollment->count; domain_index++) {
+		if (!uuid_equal(&enrollment->domains[domain_index].boot, &hfs_controlled_boot))
+			continue;
+		if (local_count == count || registry->nr_mounts == 64) {
+			err = -EPROTO;
+			goto out;
+		}
+		err = hfs_artifact_mount(json, child, group, domain_index, &mount);
+		if (err)
+			goto out;
+		for (i = 0; i < registry->nr_mounts; i++) {
+			struct hfs_controlled_mount *prior = registry->mounts[i];
+			struct hfs_enrolled_domain *prior_domain =
+				&prior->group->enrollment->domains[prior->domain_index];
+
+			if (uuid_equal(&prior->enrollment.session, &mount->enrollment.session) ||
+			    !strcmp(prior->device_tag, mount->device_tag) ||
+			    !strcmp(prior->device_name, mount->device_name) ||
+			    !uuid_equal(&prior_domain->vm, &enrollment->domains[domain_index].vm)) {
+				kfree(mount);
+				err = -EPROTO;
+				goto out;
+			}
+		}
+		registry->mounts[registry->nr_mounts++] = mount;
+		local_count++;
+		child = hfs_enrollment_next(json, child);
+	}
+	err = local_count == count ? 0 : -EPROTO;
+out:
+	kvfree(bytes);
+	return err;
+}
+
+static void hfs_registry_free_uninstalled(struct hfs_controlled_registry *registry)
+{
+	u32 i;
+
+	if (!registry)
+		return;
+	for (i = 0; i < registry->nr_mounts; i++)
+		kfree(registry->mounts[i]);
+	for (i = 0; i < registry->nr_groups; i++)
+		hfs_signed_enrollment_free(registry->groups[i].enrollment);
+	hfs_json_free(registry->provision);
+	kfree(registry);
+}
+
+static void hfs_registry_snapshot(const struct hfs_controlled_registry *registry,
+				 struct hfs_buf *snapshot, bool worst_case)
+{
+	u32 sorted[64], i, j, index, count = registry ? registry->nr_mounts : 0;
+	const struct hfs_controlled_mount *mount;
+	u64 revision, fence;
+
+	for (i = 0; i < count; i++) {
+		sorted[i] = i;
+		for (j = i; j && memcmp(registry->mounts[sorted[j - 1]]->enrollment.session.b,
+			registry->mounts[sorted[j]]->enrollment.session.b, 16) > 0; j--) {
+			index = sorted[j]; sorted[j] = sorted[j - 1]; sorted[j - 1] = index;
+		}
+	}
+	hfs_buf_printf(snapshot, "{\"boot_id\":\"%pUb\",\"domain_protocols\":{", &hfs_controlled_boot);
+	for (i = 0; i < count; i++) {
+		mount = registry->mounts[sorted[i]];
+		hfs_buf_printf(snapshot, "%s\"%pUb\":", i ? "," : "", &mount->enrollment.session);
+		hfs_buf_literal(snapshot, hfs_protocol_selected_text(4, mount->enrollment.protocol_features));
+	}
+	hfs_buf_literal(snapshot, "},\"domains\":[");
+	for (i = 0; i < count; i++) {
+		mount = registry->mounts[i];
+		if (i) hfs_buf_literal(snapshot, ",");
+		hfs_buf_add(snapshot, mount->enrollment.context, mount->enrollment.context_len);
+	}
+	hfs_buf_literal(snapshot, "],\"observations\":[");
+	for (i = 0; i < count; i++) {
+		mount = registry->mounts[i];
+		revision = worst_case ? U64_MAX : mount->revision;
+		fence = worst_case ? U64_MAX : mount->observation_fence;
+		hfs_buf_printf(snapshot, "%s{\"acknowledgement_hash\":", i ? "," : "");
+		if (worst_case || strcmp(mount->phase, "LIVE"))
+			hfs_buf_hex(snapshot, mount->acknowledgement_hash, 32);
+		else hfs_buf_literal(snapshot, "\"\"");
+		hfs_buf_literal(snapshot, ",\"event_hash\":");
+		if (worst_case || strcmp(mount->phase, "LIVE"))
+			hfs_buf_hex(snapshot, mount->event_hash, 32);
+		else hfs_buf_literal(snapshot, "\"\"");
+		hfs_buf_printf(snapshot, ",\"fence\":%llu,\"phase\":\"%s\",\"revision\":%llu,\"scope\":",
+			fence, worst_case ? (mount->enrollment.protocol_features == HFS_TERMINAL_FEATURES ? "TERMINAL_RETIRED" : "INSTALLED_FINAL") : mount->phase, revision);
+		hfs_buf_add(snapshot, mount->enrollment.context, mount->enrollment.context_len);
+  if (mount->terminal_length) {
+   hfs_buf_literal(snapshot, ",\"terminal\":");
+   hfs_buf_add(snapshot, mount->terminal_object, mount->terminal_length);
+  } else if (worst_case && mount->enrollment.protocol_features == HFS_TERMINAL_FEATURES) {
+   /* Reserve the actual maximal fixed terminal object for EVERY selected
+    * local row before provisioning. Never truncate a later observer. */
+   hfs_buf_literal(snapshot, ",\"terminal\":");
+   for (j = 0; j < HFS_TERMINAL_OBJECT_MAX; j++)
+    hfs_buf_literal(snapshot, " ");
+  }
+		hfs_buf_literal(snapshot, "}");
+	}
+	hfs_buf_printf(snapshot,
+		"],\"physical_contract\":\"homelabfs-stop-adoption/1\",\"provider_nonce\":\"%pUb\","
+		"\"version\":\"homelabfs-kernel-admission/1\"}", &hfs_controlled_nonce);
+}
+
+int hfs_controlled_snapshot(struct hfs_buf *snapshot)
+{
+	mutex_lock(&hfs_controlled_lock);
+	hfs_registry_snapshot(hfs_controlled_registry, snapshot, false);
+	mutex_unlock(&hfs_controlled_lock);
+	return snapshot->error;
+}
+
+static int hfs_controlled_storage_add(u64 *total, u64 bytes)
+{
+	return check_add_overflow(*total, bytes, total) ? -EOVERFLOW : 0;
+}
+
+static u64 hfs_controlled_json_bytes(const struct hfs_json *json)
+{
+	/* parse_owned retains the exact compacted count, or the equal initial
+	 * capacity. The doubled arena during compaction is transient staging.
+	 */
+	return sizeof(*json) + (u64)json->len + 1ULL +
+		(u64)json->count * sizeof(*json->tokens);
+}
+
+/* Refuse a slot budget below the documented mount floor (see
+ * hfs_controlled_internal.h) before any mount can consume an enrollment.
+ * At most 64 mounts of at most 95 credits each: no overflow.
+ */
+static int hfs_controlled_slot_floor(const struct hfs_controlled_registry *registry)
+{
+	u32 control = 0, ordinary = 0, control_received = 0, ordinary_received = 0, i;
+
+	for (i = 0; i < registry->nr_mounts; i++) {
+		bool terminal = registry->mounts[i]->enrollment.protocol_features ==
+				HFS_TERMINAL_FEATURES;
+
+		control += (terminal ? 3U : 2U) * HFS_FLOOR_PACKAGE + HFS_FLOOR_CONTROL_BASE;
+		control_received += HFS_FLOOR_CONTROL_RECEIVED_BASE + (terminal ? 1U : 0U);
+		ordinary += HFS_FLOOR_ORDINARY;
+		ordinary_received += HFS_FLOOR_ORDINARY_RECEIVED;
+	}
+	if (registry->budget.reservations / 2 < control ||
+	    registry->budget.reservations / 2 < ordinary ||
+	    registry->budget.received / 2 < control_received ||
+	    registry->budget.received / 2 < ordinary_received)
+		return -ENOSPC;
+	return 0;
+}
+
+/* Permanent control bytes of the accepted registry, then the slot floor. */
+static int hfs_controlled_base_charge(struct hfs_controlled_registry *registry)
+{
+	u64 total = HFS_CONTROLLED_STAGING_BYTES + HFS_CONTROLLED_BOOT_BYTES +
+		(HFS_ADMISSION_OPEN_MAX + 1ULL) * HFS_CONTROLLED_OPEN_BYTES +
+		HFS_ADMISSION_OPEN_MAX * (sizeof(struct hfs_buf) + HFS_ADMISSION_MAX) +
+		HFS_ADMISSION_MAX + 1ULL; /* accepted artifact prealloc buffer */
+	u32 i;
+	int err;
+
+	err = hfs_controlled_storage_add(&total, sizeof(*registry));
+	if (!err)
+		err = hfs_controlled_storage_add(&total,
+			hfs_controlled_json_bytes(registry->provision));
+	for (i = 0; !err && i < registry->nr_mounts; i++)
+		err = hfs_controlled_storage_add(&total, sizeof(*registry->mounts[i]) +
+			sizeof(struct hfs_session));
+	for (i = 0; !err && i < registry->nr_groups; i++) {
+		const struct hfs_signed_enrollment *enrollment = registry->groups[i].enrollment;
+
+		err = hfs_controlled_storage_add(&total, sizeof(*enrollment));
+		if (!err)
+			err = hfs_controlled_storage_add(&total,
+				hfs_controlled_json_bytes(enrollment->json));
+	}
+	if (!err && total >= registry->budget.control_bytes)
+		err = -ENOSPC;
+	if (!err)
+		err = hfs_controlled_slot_floor(registry);
+	if (!err)
+		registry->control_base_bytes = total;
+	return err;
+}
+
+static int hfs_install_provision(const void *bytes, u32 length)
+{
+	struct hfs_controlled_registry *registry;
+	struct hfs_json *json;
+	struct hfs_buf worst;
+	uuid_t boot, nonce;
+	u32 count, signatures_count, group, signatures, i;
+	int payload, groups, all_signatures, err;
+
+	if (!length || length > HFS_ADMISSION_MAX)
+		return -E2BIG;
+	mutex_lock(&hfs_controlled_lock);
+	err = hfs_controlled_registry ? -EALREADY : 0;
+	mutex_unlock(&hfs_controlled_lock);
+	if (err)
+		return err;
+	registry = kzalloc(sizeof(*registry), GFP_KERNEL);
+	if (!registry)
+		return -ENOMEM;
+	err = hfs_json_parse(bytes, length, &registry->provision);
+	if (err)
+		goto fail;
+	json = registry->provision;
+	payload = hfs_json_field(json, 0, "payload");
+	groups = hfs_json_field(json, payload, "groups");
+	all_signatures = hfs_json_field(json, 0, "group_signatures");
+	if (hfs_json_exact(json, 0, "group_signatures,operator_signature,payload") ||
+	    hfs_json_exact(json, payload, "boot_id,budget,groups,provider_nonce,version") ||
+	    !hfs_json_is(json, hfs_json_field(json, payload, "version"), "\"homelabfs-guest-provision/1\"") ||
+	    hfs_artifact_uuid(json, payload, "boot_id", &boot) || !uuid_equal(&boot, &hfs_controlled_boot) ||
+	    hfs_artifact_uuid(json, payload, "provider_nonce", &nonce) || !uuid_equal(&nonce, &hfs_controlled_nonce) ||
+	    hfs_artifact_budget(json, hfs_json_field(json, payload, "budget"), &registry->budget) ||
+	    hfs_enrollment_array(json, groups, 64, &count) || !count ||
+	    hfs_enrollment_array(json, all_signatures, count, &signatures_count) || count != signatures_count ||
+	    hfs_artifact_signature(json, hfs_json_field(json, 0, "operator_signature"),
+			hfs_controlled_operator, json->data + json->tokens[payload].start,
+			json->tokens[payload].end - json->tokens[payload].start)) {
+		err = -EKEYREJECTED;
+		goto fail;
+	}
+	registry->nr_groups = count;
+	group = groups + 1;
+	signatures = all_signatures + 1;
+	for (i = 0; i < count; i++) {
+		err = hfs_artifact_group(json, group, signatures, payload, registry, i);
+		if (err)
+			goto fail;
+		group = hfs_enrollment_next(json, group);
+		signatures = hfs_enrollment_next(json, signatures);
+	}
+	err = hfs_controlled_base_charge(registry);
+	if (err)
+		goto fail;
+	hfs_hash(json->data + json->tokens[payload].start,
+		 json->tokens[payload].end - json->tokens[payload].start, registry->provision_hash);
+	err = hfs_buf_init(&worst, HFS_ADMISSION_MAX);
+	if (err)
+		goto fail;
+	hfs_registry_snapshot(registry, &worst, true);
+	err = worst.error;
+	hfs_buf_free(&worst);
+	if (err)
+		goto fail;
+	mutex_lock(&hfs_controlled_lock);
+	if (hfs_controlled_registry)
+		err = -EALREADY;
+	else
+		hfs_controlled_registry = registry;
+	mutex_unlock(&hfs_controlled_lock);
+	if (err)
+		goto fail;
+	return 0;
+fail:
+	hfs_registry_free_uninstalled(registry);
+	return err;
+}
+
+static int hfs_install_bind(const void *bytes, u32 length)
+{
+	struct hfs_json *json = NULL;
+	struct hfs_controlled_registry *registry;
+	struct hfs_controlled_group *group = NULL;
+	uuid_t boot, nonce, id, controller;
+	u8 provision_hash[32];
+	u32 i;
+	int payload, err;
+
+	if (!length || length > HFS_ADMISSION_MAX)
+		return -E2BIG;
+	err = hfs_json_parse(bytes, length, &json);
+	if (err)
+		return err;
+	payload = hfs_json_field(json, 0, "payload");
+	if (hfs_json_exact(json, 0, "domain_signatures,operator_signature,payload") ||
+	    hfs_json_exact(json, payload, "boot_id,controller,group_id,provider_nonce,provision_hash,version") ||
+	    !hfs_json_is(json, hfs_json_field(json, payload, "version"), "\"homelabfs-guest-bind/1\"") ||
+	    hfs_artifact_uuid(json, payload, "boot_id", &boot) || !uuid_equal(&boot, &hfs_controlled_boot) ||
+	    hfs_artifact_uuid(json, payload, "provider_nonce", &nonce) || !uuid_equal(&nonce, &hfs_controlled_nonce) ||
+	    hfs_artifact_uuid(json, payload, "group_id", &id) ||
+	    hfs_artifact_uuid(json, payload, "controller", &controller) ||
+	    hfs_artifact_hash(json, payload, "provision_hash", provision_hash)) {
+		err = -EPROTO;
+		goto out;
+	}
+	mutex_lock(&hfs_controlled_lock);
+	registry = hfs_controlled_registry;
+	if (registry && !memcmp(registry->provision_hash, provision_hash, 32))
+		for (i = 0; i < registry->nr_groups; i++) {
+			if (registry->groups[i].bound && uuid_equal(&registry->groups[i].controller, &controller))
+				goto denied;
+			if (uuid_equal(&registry->groups[i].enrollment->id, &id))
+				group = &registry->groups[i];
+		}
+	if (!group || group->bound)
+		goto denied;
+	err = hfs_artifact_signature(json, hfs_json_field(json, 0, "operator_signature"),
+			hfs_controlled_operator, json->data + json->tokens[payload].start,
+			json->tokens[payload].end - json->tokens[payload].start);
+	if (!err)
+		err = hfs_artifact_signatures(json, hfs_json_field(json, 0, "domain_signatures"),
+			group->enrollment, json->data + json->tokens[payload].start,
+			json->tokens[payload].end - json->tokens[payload].start);
+	if (!err) {
+		group->controller = controller;
+		group->bound = true;
+	}
+	mutex_unlock(&hfs_controlled_lock);
+	goto out;
+denied:
+	mutex_unlock(&hfs_controlled_lock);
+	err = -EALREADY;
+out:
+	hfs_json_free(json);
+	return err;
+}
+
+/* One accepted administrative open across BOTH endpoints. kernfs prealloc
+ * serializes same-fd copy+callback before of->mutex; open alone is insufficient.
+ * Generic allocations made before ops.open are deliberately outside this pool.
+ */
+static int hfs_artifact_open(struct kernfs_open_file *file)
+{
+	if (current_user_ns() != &init_user_ns || !capable(CAP_SYS_ADMIN))
+		return -EPERM;
+	if (atomic_inc_return(&hfs_artifact_opens) > 1) {
+		atomic_dec(&hfs_artifact_opens);
+		return -ENOSPC;
+	}
+	file->priv = &hfs_artifact_opens;
+	return 0;
+}
+
+static void hfs_artifact_release(struct kernfs_open_file *file)
+{
+	if (file->priv == &hfs_artifact_opens) {
+		file->priv = NULL;
+		atomic_dec(&hfs_artifact_opens);
+	}
+}
+
+static ssize_t hfs_provision_write(struct kernfs_open_file *file, char *bytes,
+				 size_t length, loff_t offset)
+{
+	int err;
+
+	if (!file || file->priv != &hfs_artifact_opens ||
+	    current_user_ns() != &init_user_ns || !capable(CAP_SYS_ADMIN))
+		return -EPERM;
+	if (offset || !length || length > HFS_ADMISSION_MAX)
+		return -EINVAL;
+	err = hfs_install_provision(bytes, length);
+	return err ? err : length;
+}
+
+static ssize_t hfs_bind_write(struct kernfs_open_file *file, char *bytes,
+			    size_t length, loff_t offset)
+{
+	int err;
+
+	if (!file || file->priv != &hfs_artifact_opens ||
+	    current_user_ns() != &init_user_ns || !capable(CAP_SYS_ADMIN))
+		return -EPERM;
+	if (offset || !length || length > HFS_ADMISSION_MAX)
+		return -EINVAL;
+	err = hfs_install_bind(bytes, length);
+	return err ? err : length;
+}
+
+static const struct kernfs_ops hfs_provision_operations = {
+	.open = hfs_artifact_open,
+	.release = hfs_artifact_release,
+	.prealloc = true,
+	.write = hfs_provision_write,
+	.atomic_write_len = HFS_ADMISSION_MAX,
+};
+static const struct kernfs_ops hfs_bind_operations = {
+	.open = hfs_artifact_open,
+	.release = hfs_artifact_release,
+	.prealloc = true,
+	.write = hfs_bind_write,
+	.atomic_write_len = HFS_ADMISSION_MAX,
+};
+
+int hfs_controlled_artifacts_init(void)
+{
+	struct hfs_buf key_json;
+	struct hfs_json *key = NULL;
+	struct kernfs_node *provision, *bind;
+	u32 length = 32;
+	int err;
+
+#ifndef HFS_PROVIDER_USERSPACE
+	BUILD_BUG_ON(sizeof(struct kernfs_open_file) + sizeof(struct seq_file) >
+		     HFS_CONTROLLED_OPEN_BYTES);
+	BUILD_BUG_ON(HFS_CONTROLLED_STAGING_REQUIRED > HFS_CONTROLLED_STAGING_BYTES);
+#endif
+	err = hfs_buf_init(&key_json, 128);
+	if (err)
+		return err;
+	hfs_buf_printf(&key_json, "\"%s\"", CONFIG_9P_FS_HOMELABFS_OPERATOR_KEY);
+	err = key_json.error ?: hfs_json_parse(key_json.data, key_json.len, &key);
+	if (!err)
+		err = hfs_json_hex(key, 0, hfs_controlled_operator, &length);
+	if (!err && (length != 32 || hfs_ed25519_key_validate(hfs_controlled_operator)))
+		err = -EKEYREJECTED;
+	hfs_json_free(key);
+	hfs_buf_free(&key_json);
+	if (err)
+		return err;
+	get_boot_id(hfs_controlled_boot.b);
+	uuid_gen(&hfs_controlled_nonce);
+	err = hfs_admission_init();
+	if (err)
+		return err;
+	provision = __kernfs_create_file(hfs_admission_root()->sd, "provision_v1", 0200,
+		GLOBAL_ROOT_UID, GLOBAL_ROOT_GID, HFS_ADMISSION_MAX,
+		&hfs_provision_operations, NULL, NULL, NULL);
+	if (IS_ERR(provision))
+		return PTR_ERR(provision);
+	bind = __kernfs_create_file(hfs_admission_root()->sd, "bind_v1", 0200,
+		GLOBAL_ROOT_UID, GLOBAL_ROOT_GID, HFS_ADMISSION_MAX,
+		&hfs_bind_operations, NULL, NULL, NULL);
+	if (IS_ERR(bind)) {
+		kernfs_remove(provision);
+		return PTR_ERR(bind);
+	}
+	return 0;
+}
diff --git a/fs/9p/hfs_controlled_internal.h b/fs/9p/hfs_controlled_internal.h
new file mode 100644
--- /dev/null
+++ b/fs/9p/hfs_controlled_internal.h
@@ -0,0 +1,154 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef FS_9P_HFS_CONTROLLED_INTERNAL_H
+#define FS_9P_HFS_CONTROLLED_INTERNAL_H
+#ifdef HFS_PROVIDER_USERSPACE
+#include "controlled_compat.h"
+#else
+#include "hfs.h"
+#endif
+#include "hfs_enrollment.h"
+#include "hfs_admission.h"
+
+struct hfs_controlled_group {
+	struct hfs_signed_enrollment *enrollment;
+	uuid_t controller;
+	bool bound;
+};
+
+struct hfs_controlled_mount {
+	struct hfs_controlled_group *group;
+	u32 domain_index;
+	struct hfs_enrollment enrollment;
+	char device_tag[256];
+	char device_name[256];
+	uuid_t user_namespace;
+	u8 idmap_hash[32];
+	struct hfs_session *session;
+	struct device *device;
+	struct super_block *super;
+	dev_t super_device;
+	char terminal_object[HFS_TERMINAL_OBJECT_MAX];
+	u32 terminal_length;
+	u8 terminal_hash[32];
+	uuid_t terminal_id;
+	u64 terminal_through;
+	bool terminal_retired;
+	bool claimed;
+	bool retained;
+	bool stopping;
+	u32 cookies;
+	u32 ordinary_credits;
+	u32 control_credits;
+	u32 ordinary_received;
+	u32 control_received;
+	u64 ordinary_floor;
+	u64 current_fence;
+	u64 observation_fence;
+	u64 revision;
+	char phase[24];
+	u8 event_hash[32];
+	u8 acknowledgement_hash[32];
+	u64 sequence;
+	u64 stop_revision;
+	u8 reopened_ack[32];
+	bool have_reopened_ack;
+};
+
+struct hfs_controlled_budget {
+	u64 ordinary_bytes;
+	u64 control_bytes;
+	u32 reservations;
+	u32 cookies;
+	u32 received;
+};
+
+/* Permanent control ownership: accepted provider operations only. Generic
+ * pre-admission VFS/kernfs syscall allocations are outside this budget.
+ */
+#define HFS_CONTROLLED_STAGING_BYTES (8ULL * 1024ULL * 1024ULL)
+#define HFS_CONTROLLED_OPEN_BYTES 8192ULL
+#define HFS_CONTROLLED_BOOT_BYTES 4096ULL
+/* Two conservatively overlapping parse/compaction packages, decoded original
+ * bytes, canonical profile (length+128), and worst-case observer preflight.
+ * Already retained registry/group allocations are charged separately.
+ */
+#define HFS_CONTROLLED_PARSER_BYTES (sizeof(struct hfs_json) + \
+	HFS_ADMISSION_MAX + 1ULL + 2ULL * (HFS_ADMISSION_MAX / 2ULL + 1ULL) * \
+	sizeof(struct hfs_token))
+#define HFS_CONTROLLED_STAGING_REQUIRED (2ULL * HFS_CONTROLLED_PARSER_BYTES + \
+	3ULL * HFS_ADMISSION_MAX + 128ULL)
+
+/* Provisioned slot floor (w54; zq3-r3 R3-1 provisioned reservations 32 and
+ * bind_super's first progress lane hit ENOSPC). reserve_owned refuses a new
+ * credit once its partition (control or ordinary) holds reservations / 2;
+ * received_reserve likewise refuses at received / 2. Both counters are
+ * global across every registry mount. Each credit below is an actual
+ * hfs_controlled_reserve that stays charged while a mount is bound,
+ * bootstrapped and serving its first operation. Suballocations from an
+ * existing completion (carriers, Received owners and descendants) spend no
+ * slot, and the bootstrap HELLO carrier is freed before bind_super.
+ *
+ *   package = one hfs_completion: parent + HFS_COMPLETION_SLOTS children = 17
+ *   owner   = request/ticket reservation + its completion package     = 18
+ *
+ * Control credits per mount:
+ *   progress lanes (bind_super): control, retirement [, terminal] 2|3 x 17
+ *   mount process identity (hfs_capture), view, mmap control
+ *   actor and bootstrap cleanup packet                                4
+ *   discovery lease: release ticket owner + control family           19
+ *   first operation (hfs_begin_cap from a new process): process
+ *   identity, observation cleanup, release ticket owner, family      21
+ *   = 78 (features 16383) or 95 (features 32767)
+ * Ordinary credits per mount:
+ *   ROOT request owner                                               18
+ *   discovery lease: acquire ticket owner + acquisition family       19
+ *   first operation: cookie, acquire ticket owner + family, request  38
+ *   = 75
+ * Received slots per mount (reserved with each package):
+ *   control: event lane 6 (HFS_MMAP_EVENTS_MAX + 3), retirement 2
+ *   [, terminal 1], two release ticket packages 2 x 3 = 14 or 15
+ *   ordinary: ROOT, two acquire ticket and one request package 4 x 3 = 12
+ *
+ * Floor: reservations / 2 >= max(sum control, sum ordinary) and
+ * received / 2 >= max(sum control received, sum ordinary received). The zq3
+ * lab's two features 32767 mounts need reservations >= 380, received >= 60.
+ * Not covered, by design: more concurrent operations, open descriptions,
+ * mapped pages/dirty packages and discovery retries (each retry adds one
+ * 18 + 18 ticket pair until the bootstrap cleanup retires it). Runtime
+ * retirement recovers ordinary owners under pressure; this floor only makes
+ * a budget that cannot even mount every enrolled domain fail at provision.
+ */
+#define HFS_FLOOR_PACKAGE 17U
+#define HFS_FLOOR_PACKAGE_RECEIVED 3U
+#define HFS_FLOOR_EVENT_RECEIVED 6U
+#define HFS_FLOOR_OWNER (1U + HFS_FLOOR_PACKAGE)
+#define HFS_FLOOR_CONTROL_BASE (4U + (HFS_FLOOR_OWNER + 1U) + (3U + HFS_FLOOR_OWNER))
+#define HFS_FLOOR_ORDINARY (HFS_FLOOR_OWNER + (HFS_FLOOR_OWNER + 1U) + (2U + 2U * HFS_FLOOR_OWNER))
+#define HFS_FLOOR_CONTROL_RECEIVED_BASE (HFS_FLOOR_EVENT_RECEIVED + 2U + \
+	2U * HFS_FLOOR_PACKAGE_RECEIVED)
+#define HFS_FLOOR_ORDINARY_RECEIVED (4U * HFS_FLOOR_PACKAGE_RECEIVED)
+
+struct hfs_controlled_registry {
+	struct hfs_json *provision;
+	u8 provision_hash[32];
+	struct hfs_controlled_budget budget;
+	u64 control_base_bytes;
+	u32 nr_groups;
+	u32 nr_mounts;
+	struct hfs_controlled_group groups[64];
+	struct hfs_controlled_mount *mounts[64];
+};
+
+/* All registry identities are immutable after one successful installation.
+ * Mutable live/physical/resource fields are protected by this provider mutex.
+ */
+extern struct mutex hfs_controlled_lock;
+extern struct hfs_controlled_registry *hfs_controlled_registry;
+extern uuid_t hfs_controlled_boot;
+extern uuid_t hfs_controlled_nonce;
+
+int hfs_controlled_artifacts_init(void);
+int hfs_controlled_idmap(u8 hash[32]);
+struct kobject *hfs_admission_root(void);
+
+#endif
diff --git a/fs/9p/hfs_enrollment.c b/fs/9p/hfs_enrollment.c
new file mode 100644
--- /dev/null
+++ b/fs/9p/hfs_enrollment.c
@@ -0,0 +1,457 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Exact original Go struct decoding, separate from canonical network JSON. */
+#include "hfs_enrollment.h"
+#include "hfs_crypto.h"
+#include "hfs_policy.h"
+#ifndef HFS_CODEC_USERSPACE
+#include <linux/base64.h>
+#include <linux/errno.h>
+#include <linux/slab.h>
+#include <linux/string.h>
+#endif
+
+u32 hfs_enrollment_next(const struct hfs_json *json, u32 token)
+{
+	u32 end = json->tokens[token++].end;
+
+	while (token < json->count && json->tokens[token].start < end)
+		token++;
+	return token;
+}
+
+int hfs_enrollment_array(const struct hfs_json *json, int token, u32 maximum,
+			 u32 *count)
+{
+	u32 child, size = 0;
+
+	if (token < 0 || (u32)token >= json->count ||
+	    json->tokens[token].kind != HFS_ARRAY)
+		return -EPROTO;
+	for (child = token + 1; child < json->count &&
+	     json->tokens[child].start < json->tokens[token].end;
+	     child = hfs_enrollment_next(json, child))
+		if (++size > maximum)
+			return -E2BIG;
+	*count = size;
+	return 0;
+}
+
+static int hfs_go_bytes(const struct hfs_json *json, int token, u8 *bytes,
+			u32 length)
+{
+	u32 count, child, i;
+	u64 value;
+
+	if (hfs_enrollment_array(json, token, length, &count) || count != length)
+		return -EPROTO;
+	child = token + 1;
+	for (i = 0; i < length; i++) {
+		if (hfs_json_u64(json, child, &value) || value > 255)
+			return -EPROTO;
+		bytes[i] = value;
+		child = hfs_enrollment_next(json, child);
+	}
+	return 0;
+}
+
+int hfs_go_uuid(const struct hfs_json *json, int token, uuid_t *uuid,
+		bool zero_allowed)
+{
+	static const u8 zero[16];
+	int err = hfs_go_bytes(json, token, uuid->b, sizeof(uuid->b));
+
+	if (!err && !zero_allowed && !memcmp(uuid->b, zero, sizeof(zero)))
+		err = -EPROTO;
+	return err;
+}
+
+static int hfs_go_number(const struct hfs_json *json, int object,
+			 const char *name, u64 minimum, u64 maximum)
+{
+	u64 value;
+
+	return hfs_json_u64(json, hfs_json_field(json, object, name), &value) ||
+		value < minimum || value > maximum ? -EPROTO : 0;
+}
+
+static int hfs_go_uuid_field(const struct hfs_json *json, int object,
+			     const char *name, bool zero_allowed)
+{
+	uuid_t uuid;
+
+	return hfs_go_uuid(json, hfs_json_field(json, object, name), &uuid,
+			   zero_allowed);
+}
+
+static int hfs_go_public_key(const struct hfs_json *json, int token, u8 key[32])
+{
+	char text[45], canonical[45];
+	u8 decoded[33];
+	int length;
+
+	if (hfs_json_string(json, token, text, sizeof(text)) != 44)
+		return -EPROTO;
+#ifdef HFS_CODEC_USERSPACE
+	{
+		length = EVP_DecodeBlock(decoded, (const unsigned char *)text, 44);
+		if (length != 33 || text[43] != '=')
+			return -EPROTO;
+		memcpy(key, decoded, 32);
+		length = EVP_EncodeBlock((unsigned char *)canonical, key, 32);
+	}
+#else
+	length = base64_decode(text, 44, decoded);
+	if (length != 32)
+		return -EPROTO;
+	memcpy(key, decoded, 32);
+	length = base64_encode(key, 32, canonical);
+#endif
+	if (length != 44 || memcmp(text, canonical, 44) ||
+	    hfs_ed25519_key_validate(key))
+		return -EPROTO;
+	return 0;
+}
+
+static int hfs_go_scope(const struct hfs_json *json, int scope)
+{
+	static const char *const ids[] = {
+		"cluster", "configuration", "export", "exporter_incarnation",
+		"fuse_session", "generation", "guest_boot", "guest_mount",
+		"origin_incarnation", "origin_journal", "origin_node", "session",
+		"vm", "volume",
+	};
+	static const char *const hashes[] = {
+		"authority_hash", "policy_hash", "registry_hash",
+	};
+	u8 hash[32];
+	uuid_t id;
+	u32 i, length;
+
+	if (hfs_json_exact(json, scope,
+		"authority_hash,cluster,configuration,export,exporter_incarnation,"
+		"fuse_session,generation,guest_boot,guest_mount,origin_incarnation,"
+		"origin_journal,origin_node,policy_hash,registry_hash,session,vm,volume"))
+		return -EPROTO;
+	for (i = 0; i < ARRAY_SIZE(ids); i++)
+		if (hfs_policy_uuid(json, hfs_json_field(json, scope, ids[i]), &id))
+			return -EPROTO;
+	for (i = 0; i < ARRAY_SIZE(hashes); i++) {
+		length = sizeof(hash);
+		if (hfs_json_hex(json, hfs_json_field(json, scope, hashes[i]), hash,
+				 &length) || length != sizeof(hash))
+			return -EPROTO;
+	}
+	return 0;
+}
+
+static int hfs_go_position(const struct hfs_json *json, int token)
+{
+	if (hfs_json_exact(json, token,
+			    "Volume,Generation,Configuration,Epoch,Sequence") ||
+	    hfs_go_uuid_field(json, token, "Volume", false) ||
+	    hfs_go_uuid_field(json, token, "Generation", false) ||
+	    hfs_go_uuid_field(json, token, "Configuration", false) ||
+	    hfs_go_number(json, token, "Epoch", 1, U64_MAX) ||
+	    hfs_go_number(json, token, "Sequence", 0, U64_MAX))
+		return -EPROTO;
+	return 0;
+}
+
+static int hfs_go_journal(const struct hfs_json *json, int journal)
+{
+	int stream = hfs_json_field(json, journal, "Stream");
+	int source = hfs_json_field(json, journal, "Source");
+
+	if (hfs_json_exact(json, journal, "Stream,Owner,Incarnation,Source") ||
+	    hfs_json_exact(json, stream,
+		"Volume,Generation,Configuration,Epoch,Kind,Reporter,ReporterIncarnation") ||
+	    hfs_json_exact(json, source, "Device,File") ||
+	    hfs_go_uuid_field(json, journal, "Owner", false) ||
+	    hfs_go_uuid_field(json, journal, "Incarnation", false) ||
+	    hfs_go_uuid_field(json, stream, "Volume", false) ||
+	    hfs_go_uuid_field(json, stream, "Generation", false) ||
+	    hfs_go_uuid_field(json, stream, "Configuration", false) ||
+	    hfs_go_uuid_field(json, stream, "Reporter", true) ||
+	    hfs_go_uuid_field(json, stream, "ReporterIncarnation", true) ||
+	    hfs_go_number(json, stream, "Epoch", 1, U64_MAX) ||
+	    hfs_go_number(json, stream, "Kind", 1, 2) ||
+	    hfs_go_number(json, source, "Device", 0, U64_MAX) ||
+	    hfs_go_number(json, source, "File", 0, U64_MAX))
+		return -EPROTO;
+	return 0;
+}
+
+static int hfs_go_domain(const struct hfs_json *json, int object,
+			 struct hfs_enrolled_domain *domain)
+{
+	int profile = hfs_json_field(json, object, "Profile");
+	int endpoint = hfs_json_field(json, object, "Endpoint");
+	u64 nodes[3], features;
+	uuid_t id, expected;
+	char profile_name[256];
+	int name_length;
+	u32 i;
+	static const char *const node_names[] = {
+		"command_node", "result_node", "recall_node",
+	};
+
+	if (hfs_json_u64(json, hfs_json_field(json, hfs_json_field(json, object, "Protocol"), "features"), &features) ||
+     (features != HFS_MAPPED_FEATURES && features != HFS_TERMINAL_FEATURES))
+  return -EPROTO;
+ domain->features = features;
+ domain->object = object;
+	domain->scope = hfs_json_field(json, object, "Scope");
+	name_length = hfs_json_string(json, hfs_json_field(json, profile, "Name"),
+				    profile_name, sizeof(profile_name));
+	if (hfs_json_exact(json, object,
+		"Protocol,Profile,Scope,Endpoint,ServingGeneration,Ledger,Journal,HostKey,GuestKey") ||
+	    hfs_protocol_selected_match(json, hfs_json_field(json, object, "Protocol"), 4, domain->features) ||
+	    hfs_json_exact(json, profile, "Disposable,Name") ||
+	    !hfs_json_is(json, hfs_json_field(json, profile, "Disposable"), "true") ||
+	    name_length <= 0 || name_length > 255 ||
+	    hfs_go_scope(json, domain->scope) ||
+	    hfs_json_exact(json, endpoint,
+			    "fuse_session,command_node,result_node,recall_node") ||
+	    hfs_policy_uuid(json, hfs_json_field(json, endpoint, "fuse_session"), &id) ||
+	    hfs_policy_uuid(json, hfs_json_field(json, domain->scope, "fuse_session"), &expected) ||
+	    memcmp(id.b, expected.b, 16) ||
+	    hfs_go_uuid_field(json, object, "ServingGeneration", false) ||
+	    hfs_go_uuid_field(json, object, "Ledger", false) ||
+	    hfs_go_journal(json, hfs_json_field(json, object, "Journal")) ||
+	    hfs_go_public_key(json, hfs_json_field(json, object, "HostKey"), domain->host) ||
+	    hfs_go_public_key(json, hfs_json_field(json, object, "GuestKey"), domain->guest) ||
+	    !memcmp(domain->host, domain->guest, 32) ||
+	    hfs_policy_uuid(json, hfs_json_field(json, domain->scope, "session"), &domain->session) ||
+	    hfs_policy_uuid(json, hfs_json_field(json, domain->scope, "guest_boot"), &domain->boot) ||
+	    hfs_policy_uuid(json, hfs_json_field(json, domain->scope, "vm"), &domain->vm))
+		return -EPROTO;
+	for (i = 0; i < name_length; i++)
+		if (profile_name[i] < 0x20 || profile_name[i] > 0x7e ||
+		    profile_name[i] == '<' || profile_name[i] == '>' || profile_name[i] == '&')
+			return -EPROTO;
+	for (i = 0; i < ARRAY_SIZE(nodes); i++)
+		if (hfs_json_u64(json, hfs_json_field(json, endpoint, node_names[i]), &nodes[i]) || nodes[i] < 2)
+			return -EPROTO;
+	return nodes[0] == nodes[1] || nodes[0] == nodes[2] || nodes[1] == nodes[2] ?
+		-EPROTO : 0;
+}
+
+static int hfs_go_bounds(const struct hfs_json *json, int object)
+{
+	static const char *const names[] = {
+		"WorkBytes", "Tickets", "ControlTickets", "Reservations",
+		"Identities", "Sources", "SourceBytes", "LedgerBytes",
+	};
+	u64 values[ARRAY_SIZE(names)], minimum;
+	u32 i;
+
+	if (hfs_json_exact(json, object,
+		"WorkBytes,Tickets,ControlTickets,Reservations,Identities,Sources,SourceBytes,LedgerBytes"))
+		return -EPROTO;
+	for (i = 0; i < ARRAY_SIZE(names); i++)
+		if (hfs_json_u64(json, hfs_json_field(json, object, names[i]), &values[i]))
+			return -EPROTO;
+	/* The same bounded arithmetic as viewcontrol.validBounds. Check each
+	 * operand before computing its complete retained-storage lower bound.
+	 */
+	if (!values[0] || values[0] > (2ULL << 30) ||
+	    !values[1] || values[1] > 65536 || values[2] < 4 || values[2] > 16384 ||
+	    !values[3] || values[3] > 64 || values[4] > 65536 ||
+	    values[4] < values[1] + values[2] || values[5] < 2 || values[5] > 128 ||
+	    values[6] < 4096 || values[6] > (16ULL << 20) || values[7] > (512ULL << 20))
+		return -EPROTO;
+	minimum = values[3] * (128U << 10) + values[6] * values[5] * 3 +
+		(values[1] + values[2]) * (128U << 10) + values[4] * (32U << 10);
+	if (values[7] < minimum)
+		return -EPROTO;
+	return 0;
+}
+
+static int hfs_go_key_compare(const struct hfs_json *json, u32 left, u32 right)
+{
+	u32 a = json->tokens[left].end - json->tokens[left].start;
+	u32 b = json->tokens[right].end - json->tokens[right].start;
+	int result = memcmp(json->data + json->tokens[left].start,
+			    json->data + json->tokens[right].start,
+			    min_t(u32, a, b));
+
+	return result ? result : (a > b) - (a < b);
+}
+
+/* Only the fully validated known Enrollment representation reaches this
+ * routine. Object keys are fixed ASCII; string values retain canonical ASCII
+ * spelling. Original signature verification still uses the ORIGINAL bytes.
+ */
+static void hfs_go_canonical(struct hfs_buf *out, const struct hfs_json *json,
+			     int token)
+{
+	u32 keys[32], count = 0, child, i, j, temporary;
+	enum hfs_json_kind kind = json->tokens[token].kind;
+
+	if (kind != HFS_OBJECT && kind != HFS_ARRAY) {
+		hfs_buf_token(out, json, token);
+		return;
+	}
+	if (kind == HFS_ARRAY) {
+		hfs_buf_literal(out, "[");
+		for (child = token + 1; child < json->count &&
+		     json->tokens[child].start < json->tokens[token].end;
+		     child = hfs_enrollment_next(json, child)) {
+			if (count++) hfs_buf_literal(out, ",");
+			hfs_go_canonical(out, json, child);
+		}
+		hfs_buf_literal(out, "]");
+		return;
+	}
+	for (child = token + 1; child < json->count &&
+	     json->tokens[child].start < json->tokens[token].end;
+	     child = hfs_enrollment_next(json, child + 1)) {
+		if (count == ARRAY_SIZE(keys)) {
+			out->error = -E2BIG;
+			return;
+		}
+		keys[count++] = child;
+	}
+	for (i = 1; i < count; i++)
+		for (j = i; j && hfs_go_key_compare(json, keys[j - 1], keys[j]) > 0; j--) {
+			temporary = keys[j]; keys[j] = keys[j - 1]; keys[j - 1] = temporary;
+		}
+	hfs_buf_literal(out, "{");
+	for (i = 0; i < count; i++) {
+		if (i) hfs_buf_literal(out, ",");
+		hfs_buf_token(out, json, keys[i]);
+		hfs_buf_literal(out, ":");
+		hfs_go_canonical(out, json, keys[i] + 1);
+	}
+	hfs_buf_literal(out, "}");
+}
+
+static int hfs_go_baseline(const struct hfs_json *json, int object)
+{
+	static const char *const names[] = { "Reporter", "ReporterIncarnation" };
+	u8 hash[32];
+	u32 i;
+	int token;
+
+	if (hfs_json_exact(json, object,
+			    "StreamKind,Reporter,ReporterIncarnation,Position,SHA256") ||
+	    hfs_go_number(json, object, "StreamKind", 1, 2) ||
+	    hfs_go_position(json, hfs_json_field(json, object, "Position")) ||
+	    hfs_go_bytes(json, hfs_json_field(json, object, "SHA256"), hash, 32))
+		return -EPROTO;
+	for (i = 0; i < ARRAY_SIZE(names); i++) {
+		token = hfs_json_field(json, object, names[i]);
+		if (!hfs_json_is(json, token, "null") &&
+		    hfs_go_uuid_field(json, object, names[i], false))
+			return -EPROTO;
+	}
+	return 0;
+}
+
+static int hfs_go_families(const struct hfs_json *json, int object,
+			   struct hfs_enrolled_domain *domain)
+{
+	int acquisition = hfs_json_field(json, object, "Acquisition");
+	int control = hfs_json_field(json, object, "Control");
+
+	if (hfs_json_exact(json, object, "Acquisition,Control") ||
+	    hfs_json_exact(json, acquisition, "Anchor,Nonce") ||
+	    hfs_json_exact(json, control, "Anchor,Nonce") ||
+	    hfs_policy_uuid(json, hfs_json_field(json, acquisition, "Anchor"), &domain->acquisition_anchor) ||
+	    hfs_policy_uuid(json, hfs_json_field(json, acquisition, "Nonce"), &domain->acquisition_nonce) ||
+	    hfs_policy_uuid(json, hfs_json_field(json, control, "Anchor"), &domain->control_anchor) ||
+	    hfs_policy_uuid(json, hfs_json_field(json, control, "Nonce"), &domain->control_nonce) ||
+	    (!memcmp(domain->acquisition_anchor.b, domain->control_anchor.b, 16) &&
+	     !memcmp(domain->acquisition_nonce.b, domain->control_nonce.b, 16)))
+		return -EPROTO;
+	return 0;
+}
+
+int hfs_signed_enrollment_decode(const void *bytes, u32 length,
+				 struct hfs_signed_enrollment **out)
+{
+	struct hfs_signed_enrollment *enrollment;
+	struct hfs_json *json;
+	struct hfs_buf profile;
+	u32 count, families_count, i, j, domain, family, hash_length = 32;
+	u8 hash[32];
+	int domains, families, err;
+
+	*out = NULL;
+	if (!length || length > 128U * 1024U)
+		return -E2BIG;
+	enrollment = kzalloc(sizeof(*enrollment), GFP_KERNEL);
+	if (!enrollment)
+		return -ENOMEM;
+	err = hfs_json_parse_go_enrollment(bytes, length, &enrollment->json);
+	if (err)
+		goto fail;
+	json = enrollment->json;
+	domains = hfs_json_field(json, 0, "Domains");
+	families = hfs_json_field(json, 0, "TicketFamilies");
+	if (hfs_json_exact(json, 0,
+		"TicketFamilies,Version,ID,Domains,PageSize,Bounds,Baseline,BaselineStateHash") ||
+	    !hfs_json_is(json, hfs_json_field(json, 0, "Version"),
+			 "\"homelabfs-private-viewcontrol/1\"") ||
+	    hfs_go_uuid(json, hfs_json_field(json, 0, "ID"), &enrollment->id, false) ||
+	    hfs_go_number(json, 0, "PageSize", 4096, 4096) ||
+	    hfs_go_bounds(json, hfs_json_field(json, 0, "Bounds")) ||
+	    hfs_go_baseline(json, hfs_json_field(json, 0, "Baseline")) ||
+	    hfs_json_hex(json, hfs_json_field(json, 0, "BaselineStateHash"), hash, &hash_length) ||
+	    hash_length != 32 ||
+	    hfs_enrollment_array(json, domains, HFS_ENROLLED_DOMAINS_MAX, &count) ||
+	    !count || hfs_enrollment_array(json, families, count, &families_count) ||
+	    count != families_count) {
+		err = -EPROTO;
+		goto fail;
+	}
+	enrollment->count = count;
+	domain = domains + 1;
+	family = families + 1;
+	for (i = 0; i < count; i++) {
+		err = hfs_go_domain(json, domain, &enrollment->domains[i]);
+		if (!err)
+			err = hfs_go_families(json, family, &enrollment->domains[i]);
+		if (err)
+			goto fail;
+		for (j = 0; j < i; j++)
+			if (!memcmp(enrollment->domains[j].session.b,
+				     enrollment->domains[i].session.b, 16)) {
+				err = -EPROTO;
+				goto fail;
+			}
+		domain = hfs_enrollment_next(json, domain);
+		family = hfs_enrollment_next(json, family);
+	}
+	hfs_hash(bytes, length, enrollment->enrollment_hash);
+	err = hfs_buf_init(&profile, length + 128);
+	if (err)
+		goto fail;
+	/* Exact recursively canonicalized existing host profile-hash structure. */
+	hfs_buf_literal(&profile, "{\"Bounds\":");
+	hfs_go_canonical(&profile, json, hfs_json_field(json, 0, "Bounds"));
+	hfs_buf_literal(&profile, ",\"Domains\":");
+	hfs_go_canonical(&profile, json, domains);
+	hfs_buf_literal(&profile, ",\"Families\":");
+	hfs_go_canonical(&profile, json, families);
+	hfs_buf_literal(&profile, ",\"PageSize\":4096}");
+	err = profile.error;
+	if (!err)
+		hfs_hash(profile.data, profile.len, enrollment->profile_hash);
+	hfs_buf_free(&profile);
+	if (err)
+		goto fail;
+	*out = enrollment;
+	return 0;
+fail:
+	hfs_signed_enrollment_free(enrollment);
+	return err;
+}
+
+void hfs_signed_enrollment_free(struct hfs_signed_enrollment *enrollment)
+{
+	if (enrollment) {
+		hfs_json_free(enrollment->json);
+		kfree(enrollment);
+	}
+}
diff --git a/fs/9p/hfs_enrollment.h b/fs/9p/hfs_enrollment.h
new file mode 100644
--- /dev/null
+++ b/fs/9p/hfs_enrollment.h
@@ -0,0 +1,43 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef FS_9P_HFS_ENROLLMENT_H
+#define FS_9P_HFS_ENROLLMENT_H
+#include "hfs_protocol.h"
+
+#define HFS_ENROLLED_DOMAINS_MAX 64U
+struct hfs_enrolled_domain {
+	u32 features;
+	int object;
+	int scope;
+	uuid_t session;
+	uuid_t boot;
+	uuid_t vm;
+	uuid_t acquisition_anchor;
+	uuid_t acquisition_nonce;
+	uuid_t control_anchor;
+	uuid_t control_nonce;
+	u8 host[32];
+	u8 guest[32];
+};
+
+/* Inert decoding. Caller must verify all original and provisioning signatures
+ * and privately capture actual boot/device/maps before installing anything.
+ */
+struct hfs_signed_enrollment {
+	struct hfs_json *json;
+	uuid_t id;
+	u32 count;
+	struct hfs_enrolled_domain domains[HFS_ENROLLED_DOMAINS_MAX];
+	u8 enrollment_hash[32];
+	u8 profile_hash[32];
+};
+
+int hfs_signed_enrollment_decode(const void *bytes, u32 length,
+				 struct hfs_signed_enrollment **out);
+void hfs_signed_enrollment_free(struct hfs_signed_enrollment *enrollment);
+int hfs_go_uuid(const struct hfs_json *json, int token, uuid_t *uuid,
+		bool zero_allowed);
+u32 hfs_enrollment_next(const struct hfs_json *json, u32 token);
+int hfs_enrollment_array(const struct hfs_json *json, int token, u32 maximum,
+			 u32 *count);
+
+#endif
diff --git a/fs/9p/hfs_received.h b/fs/9p/hfs_received.h
new file mode 100644
--- /dev/null
+++ b/fs/9p/hfs_received.h
@@ -0,0 +1,57 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef FS_9P_HFS_RECEIVED_H
+#define FS_9P_HFS_RECEIVED_H
+#include "hfs_protocol.h"
+#ifndef HFS_CODEC_USERSPACE
+#include <linux/errno.h>
+#endif
+struct hfs_session;
+
+#ifdef CONFIG_9P_FS_HOMELABFS_CONTROLLED
+u64 hfs_received_capacity(u32 command_capacity, u32 body);
+u64 hfs_received_copy_capacity(u32 body);
+
+/* No factory is exposed. Creation is static inside the actual transport TU. */
+int hfs_received_require(struct hfs_session *session, const struct hfs_json *json,
+			  int token);
+int hfs_received_source(struct hfs_session *session, const struct hfs_json *json,
+			int token);
+int hfs_received_target(struct hfs_session *session, const struct hfs_json *json,
+			 int token);
+int hfs_received_publication(struct hfs_session *session, const struct hfs_json *json,
+			      int token);
+int hfs_received_event(struct hfs_session *session, const struct hfs_json *json,
+			int token);
+int hfs_received_acknowledgement(struct hfs_session *session,
+		const struct hfs_json *json, const struct hfs_buf *payload);
+int hfs_received_retirement(struct hfs_session *session,
+	const struct hfs_json *json, bool view, const struct hfs_buf *expected,
+	u64 through, const u8 proof[32]);
+int hfs_received_exclusive(struct hfs_session *session, const struct hfs_json *json);
+int hfs_received_terminal(struct hfs_session *session, const struct hfs_json *json,
+ const struct hfs_buf *expected);
+void *hfs_received_terminal_credit(struct hfs_session *session, const struct hfs_json *allowed);
+int hfs_received_terminal_empty(struct hfs_session *session, const struct hfs_json *allowed);
+int hfs_received_original(struct hfs_session *session, const struct hfs_json *json,
+	const char *operation, const struct hfs_buf *expected);
+int hfs_received_copy(const struct hfs_json *json, int token, struct hfs_json **out);
+void hfs_received_forget(struct hfs_json *json);
+#else
+static inline int hfs_received_exclusive(struct hfs_session *session, const struct hfs_json *json) { return -EOPNOTSUPP; }
+static inline int hfs_received_source(struct hfs_session *session,
+		const struct hfs_json *json, int token)
+{
+	(void)session; (void)json; (void)token;
+	return -EOPNOTSUPP; /* Minor4 has no private SOURCE factory here. */
+}
+static inline int hfs_received_copy(const struct hfs_json *json, int token,
+				   struct hfs_json **out)
+{
+	if (token < 0 || (u32)token >= json->count)
+		return -EPROTO;
+	return hfs_json_parse(json->data + json->tokens[token].start,
+		json->tokens[token].end - json->tokens[token].start, out);
+}
+static inline void hfs_received_forget(struct hfs_json *json) { (void)json; }
+#endif
+#endif
diff --git a/fs/9p/hfs_received.inc b/fs/9p/hfs_received.inc
new file mode 100644
--- /dev/null
+++ b/fs/9p/hfs_received.inc
@@ -0,0 +1,738 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Included ONLY by hfs_session.c. The factory stays static beside the actual
+ * validated transport completion and is not part of any provider/caller API.
+ */
+struct hfs_received_capture {
+	u64 revision;
+	enum hfs_view_phase phase;
+	bool have_view;
+};
+
+struct hfs_kernel_received {
+	struct hfs_completion *completion;
+	struct kref refs;
+	struct hfs_session *session;
+	struct hfs_json *original;
+	struct hfs_json *response;
+	struct hfs_received_capture capture;
+	enum hfs_attestation_kind kind;
+	int target;
+	int source;
+	int event;
+	int publication;
+	u16 channel;
+	u16 frame_kind;
+	bool control;
+	bool cleanup;
+	u64 cell;
+	void *credit;
+};
+
+struct hfs_received_link {
+	struct list_head list;
+	struct hfs_json *json;
+	struct hfs_kernel_received *owner;
+	u32 start;
+	u32 length;
+	void *credit;
+};
+
+static bool hfs_received_source_current(struct hfs_kernel_received *owner);
+
+static DEFINE_MUTEX(hfs_received_lock);
+static LIST_HEAD(hfs_received_links);
+
+static void hfs_received_release_owner(struct kref *reference)
+{
+	struct hfs_kernel_received *owner = container_of(reference,
+						struct hfs_kernel_received, refs);
+
+	struct hfs_session *session = owner->session;
+	void *credit = owner->credit;
+
+	hfs_json_free(owner->original);
+	hfs_json_free(owner->response);
+	kfree(owner);
+	hfs_controlled_received_release(session, credit);
+}
+
+static void hfs_received_put(struct hfs_kernel_received *owner)
+{
+	if (owner)
+		kref_put(&owner->refs, hfs_received_release_owner);
+}
+
+/* Caller holds the provider's ordinary borrowed-json lifetime. Association is
+ * by exact allocated json identity, never a copied public pointer/boolean.
+ */
+static struct hfs_kernel_received *hfs_received_get(const struct hfs_json *json,
+						  u32 *start, u32 *length)
+{
+	struct hfs_received_link *link;
+	struct hfs_kernel_received *owner = NULL;
+
+	mutex_lock(&hfs_received_lock);
+	list_for_each_entry(link, &hfs_received_links, list)
+		if (link->json == json) {
+			owner = link->owner;
+			kref_get(&owner->refs);
+			*start = link->start;
+			*length = link->length;
+			break;
+		}
+	mutex_unlock(&hfs_received_lock);
+	if (owner && (json->len != *length || *start > owner->response->len ||
+	    *length > owner->response->len - *start ||
+	    memcmp(json->data, owner->response->data + *start, *length))) {
+		hfs_received_put(owner);
+		owner = NULL;
+	}
+	return owner;
+}
+
+/* Token starts are strictly increasing in the private canonical parse. */
+static bool hfs_received_original_span(const struct hfs_kernel_received *owner,
+				       u32 start, u32 length)
+{
+	u32 low = 0, high = owner->response->count;
+
+	while (low < high) {
+		u32 middle = low + (high - low) / 2;
+		const struct hfs_token *token = &owner->response->tokens[middle];
+
+		if (token->start < start)
+			low = middle + 1;
+		else if (token->start > start)
+			high = middle;
+		else
+			return token->end - token->start == length;
+	}
+	return false;
+}
+
+static int hfs_received_token_span(const struct hfs_kernel_received *owner,
+		const struct hfs_json *json, int token, u32 offset, u32 *start, u32 *length)
+{
+	if (token < 0 || (u32)token >= json->count ||
+	    json->tokens[token].start > json->tokens[token].end ||
+	    json->tokens[token].end > json->len)
+		return -EPROTO;
+	*start = offset + json->tokens[token].start;
+	*length = json->tokens[token].end - json->tokens[token].start;
+	return hfs_received_original_span(owner, *start, *length) ? 0 : -EKEYREJECTED;
+}
+
+int hfs_received_require(struct hfs_session *session, const struct hfs_json *json,
+			  int token)
+{
+	struct hfs_kernel_received *owner;
+	u32 offset, length, start, span;
+	int err = -EKEYREJECTED;
+
+	owner = hfs_received_get(json, &offset, &length);
+	if (!owner)
+		return err;
+	if (owner->session == session) {
+		err = hfs_received_token_span(owner, json, token, offset, &start, &span);
+		if (!err)
+			err = owner->cleanup ? hfs_controlled_control_admissible(session) :
+			hfs_controlled_admissible(session);
+	}
+	hfs_received_put(owner);
+	return err;
+}
+
+/* Consumption-time gate: exact selected private SOURCE, never merely a raw
+ * transported outcome or a caller-built/parsed receipt. No factory is exposed.
+ */
+int hfs_received_source(struct hfs_session *session, const struct hfs_json *json,
+			int token)
+{
+	struct hfs_kernel_received *owner;
+	u32 offset, length, start, span;
+	int err = -EKEYREJECTED;
+
+	if (!session)
+		return -EINVAL;
+	if (session->bridge_minor < 4)
+		return 0; /* Explicit closed older provider contract. */
+	if (session->bridge_minor != 4 || !hfs_controlled_owns(session))
+		return -EKEYREJECTED;
+	owner = hfs_received_get(json, &offset, &length);
+	if (!owner)
+		return err;
+	if (owner->session != session || owner->kind != HFS_ATTESTATION_SOURCE ||
+	    owner->source < 0 || owner->channel != HFS_CHANNEL_RESULT ||
+	    owner->frame_kind != HFS_FRAME_RESULT)
+		goto out;
+	err = hfs_received_token_span(owner, json, token, offset, &start, &span);
+	if (!err && (start != owner->response->tokens[owner->source].start ||
+	    span != owner->response->tokens[owner->source].end - start))
+		err = -EKEYREJECTED;
+	if (!err)
+		err = owner->cleanup ? hfs_controlled_control_admissible(session) :
+			hfs_controlled_admissible(session);
+	if (!err && !hfs_received_source_current(owner))
+		err = -ESTALE;
+out:
+	hfs_received_put(owner);
+	return err;
+}
+
+static int hfs_received_selected(struct hfs_session *session,
+		const struct hfs_json *json, int token, bool event)
+{
+	struct hfs_kernel_received *owner;
+	u32 offset, length, start, span;
+	int selected, err = -EKEYREJECTED;
+
+	owner = hfs_received_get(json, &offset, &length);
+	if (!owner)
+		return err;
+	selected = event ? owner->event : owner->target;
+	if (owner->session != session || selected < 0 ||
+	    (event && owner->kind != HFS_ATTESTATION_EVENT) ||
+	    (!event && owner->kind != HFS_ATTESTATION_SOURCE && owner->kind != HFS_ATTESTATION_EVENT))
+		goto out;
+	err = hfs_received_token_span(owner, json, token, offset, &start, &span);
+	if (!err && (start != owner->response->tokens[selected].start ||
+	    span != owner->response->tokens[selected].end - start))
+		err = -EKEYREJECTED;
+	if (!err)
+		err = owner->cleanup ? hfs_controlled_control_admissible(session) :
+			hfs_controlled_admissible(session);
+	if (!err && !event && owner->kind == HFS_ATTESTATION_SOURCE) {
+		struct hfs_view *view = hfs_view_get(session);
+		unsigned long flags;
+
+		if (!view) {
+			err = -ESTALE;
+			goto out;
+		}
+		spin_lock_irqsave(&view->lock, flags);
+		if (!owner->capture.have_view || view->revision != owner->capture.revision ||
+		    (view->phase != HFS_VIEW_LIVE && view->phase != HFS_VIEW_UNBOUND) ||
+		    (view->target.len && (view->target.len != span ||
+		      memcmp(view->target.data, owner->response->data + start, span))))
+			err = -ESTALE;
+		spin_unlock_irqrestore(&view->lock, flags);
+		hfs_view_put(view);
+	}
+out:
+	hfs_received_put(owner);
+	return err;
+}
+
+int hfs_received_target(struct hfs_session *session, const struct hfs_json *json,
+			 int token)
+{
+	return hfs_received_selected(session, json, token, false);
+}
+
+int hfs_received_event(struct hfs_session *session, const struct hfs_json *json,
+			int token)
+{
+	return hfs_received_selected(session, json, token, true);
+}
+
+int hfs_received_publication(struct hfs_session *session, const struct hfs_json *json,
+			      int token)
+{
+	struct hfs_kernel_received *owner;
+	u32 offset, length, start, span;
+	int err = -EKEYREJECTED;
+
+	owner = hfs_received_get(json, &offset, &length);
+	if (!owner)
+		return err;
+	if (owner->session == session && owner->publication >= 0 &&
+	    owner->channel == HFS_CHANNEL_RESULT && owner->frame_kind == HFS_FRAME_RESULT) {
+		err = hfs_received_token_span(owner, json, token, offset, &start, &span);
+		if (!err && (start != owner->response->tokens[owner->publication].start ||
+		    span != owner->response->tokens[owner->publication].end - start))
+			err = -EKEYREJECTED;
+		if (!err)
+			err = owner->cleanup ? hfs_controlled_control_admissible(session) :
+			hfs_controlled_admissible(session);
+	}
+	hfs_received_put(owner);
+	return err;
+}
+
+int hfs_received_acknowledgement(struct hfs_session *session,
+		const struct hfs_json *json, const struct hfs_buf *payload)
+{
+	struct hfs_kernel_received *owner;
+	u32 start, length;
+	int token, response, err = -EKEYREJECTED;
+
+	owner = hfs_received_get(json, &start, &length);
+	if (!owner)
+		return err;
+	token = hfs_json_field(owner->original, 0, "payload");
+	response = hfs_json_field(owner->response, 0, "payload");
+	if (owner->session == session && !start && length == owner->response->len &&
+	    owner->channel == HFS_CHANNEL_RESULT && owner->frame_kind == HFS_FRAME_RESULT &&
+	    hfs_json_is(owner->original, hfs_json_field(owner->original, 0, "op"), "\"VIEW_ACK\"") &&
+	    token >= 0 && owner->original->tokens[token].end - owner->original->tokens[token].start == payload->len &&
+	    !memcmp(owner->original->data + owner->original->tokens[token].start, payload->data, payload->len) &&
+	    !hfs_json_exact(owner->response, response, "status") &&
+	    hfs_json_is(owner->response, hfs_json_field(owner->response, response, "status"), "\"ACCEPTED\""))
+		err = owner->cleanup ? hfs_controlled_control_admissible(session) :
+			hfs_controlled_admissible(session);
+	hfs_received_put(owner);
+	return err;
+}
+
+/* Only the actual transport owner can bind a floor to the complete original
+ * retirement payload selected by the provider's still-owned local prefix.
+ */
+int hfs_received_retirement(struct hfs_session *session,
+		const struct hfs_json *json, bool view, const struct hfs_buf *expected,
+		u64 through, const u8 proof[32])
+{
+	struct hfs_kernel_received *owner;
+	u32 start, length, hash_length = 32;
+	u8 hash[32];
+	u64 floor;
+	int original, payload, err = -EKEYREJECTED;
+
+	owner = hfs_received_get(json, &start, &length);
+	if (!owner)
+		return err;
+	original = hfs_json_field(owner->original, 0, "payload");
+	payload = hfs_json_field(owner->response, 0, "payload");
+	if (owner->session != session || start || length != owner->response->len ||
+	    owner->kind != (view ? HFS_ATTESTATION_VIEW_FLOOR : HFS_ATTESTATION_FLOOR) ||
+	    owner->channel != HFS_CHANNEL_RESULT || owner->frame_kind != HFS_FRAME_RESULT ||
+	    !hfs_json_is(owner->original, hfs_json_field(owner->original, 0, "op"),
+		view ? "\"VIEW_RETIRE\"" : "\"RETIRE\"") ||
+	    original < 0 || expected->error ||
+	    owner->original->tokens[original].end - owner->original->tokens[original].start != expected->len ||
+	    memcmp(owner->original->data + owner->original->tokens[original].start,
+		expected->data, expected->len) ||
+	    hfs_json_u64(owner->response, hfs_json_field(owner->response, payload, "floor"), &floor) ||
+	    floor != through ||
+	    hfs_json_hex(owner->response, hfs_json_field(owner->response, payload, "proof_hash"), hash, &hash_length) ||
+	    hash_length != 32 || memcmp(hash, proof, 32))
+		goto out;
+	err = hfs_controlled_control_admissible(session);
+out:
+	hfs_received_put(owner);
+	return err;
+}
+
+/* A private complete EVENT may be disposed only with its sole original link.
+ * Copies and outstanding private borrows keep independent owner references. */
+int hfs_received_exclusive(struct hfs_session *session, const struct hfs_json *json)
+{
+	struct hfs_kernel_received *owner;
+	u32 start, length;
+	int err = -EBUSY;
+
+	owner = hfs_received_get(json, &start, &length);
+	if (!owner)
+		return -EKEYREJECTED;
+	mutex_lock(&hfs_received_lock);
+	if (owner->session == session && owner->kind == HFS_ATTESTATION_EVENT && !start &&
+	    length == owner->response->len && refcount_read(&owner->refs.refcount) == 2)
+		err = 0;
+	mutex_unlock(&hfs_received_lock);
+	hfs_received_put(owner);
+	return err;
+}
+
+void *hfs_received_terminal_credit(struct hfs_session *session, const struct hfs_json *allowed)
+{
+	struct hfs_received_link *link;
+	void *credit = NULL;
+
+	mutex_lock(&hfs_received_lock);
+	list_for_each_entry(link, &hfs_received_links, list)
+		if (link->json == allowed && link->owner->session == session &&
+		    link->owner->kind == HFS_ATTESTATION_SESSION_RETIRED && !link->start &&
+		    link->length == link->owner->response->len)
+			credit = link->owner->credit;
+	mutex_unlock(&hfs_received_lock);
+	return credit;
+}
+
+int hfs_received_terminal_empty(struct hfs_session *session, const struct hfs_json *allowed)
+{
+	struct hfs_received_link *link;
+	int err = 0;
+
+	mutex_lock(&hfs_received_lock);
+	list_for_each_entry(link, &hfs_received_links, list)
+		if (link->owner->session == session &&
+		    (link->json != allowed || link->start ||
+		     link->length != link->owner->response->len ||
+		     refcount_read(&link->owner->refs.refcount) != 1)) {
+			err = -EBUSY;
+			break;
+		}
+	mutex_unlock(&hfs_received_lock);
+	return err;
+}
+
+int hfs_received_terminal(struct hfs_session *session, const struct hfs_json *json,
+			  const struct hfs_buf *expected)
+{
+	struct hfs_kernel_received *owner;
+	u32 start, length, hash_length;
+	u64 cell, donor_cell;
+	u8 donor_hash[32];
+	int token, donor, err = -EKEYREJECTED;
+	bool donor_matches;
+
+	owner = hfs_received_get(json, &start, &length);
+	if (!owner)
+		return err;
+	token = hfs_json_field(owner->original, 0, "payload");
+	donor = hfs_json_field(owner->original, 0, "reclaim");
+	hash_length = sizeof(donor_hash);
+	donor_matches =
+		!session->terminal_donor ?
+			hfs_json_is(owner->original, donor, "null") :
+			!hfs_json_exact(owner->original, donor, "cell,response_hash") &&
+				!hfs_json_u64(owner->original,
+					      hfs_json_field(owner->original, donor, "cell"),
+					      &donor_cell) &&
+				donor_cell == session->terminal_donor &&
+				!hfs_json_hex(owner->original,
+					      hfs_json_field(owner->original, donor,
+							     "response_hash"),
+					      donor_hash, &hash_length) &&
+				hash_length == sizeof(donor_hash) &&
+				!memcmp(donor_hash, session->terminal_donor_hash,
+					sizeof(donor_hash));
+	if (owner->session == session && !start && length == owner->response->len &&
+	    owner->kind == HFS_ATTESTATION_SESSION_RETIRED && owner->cleanup &&
+	    owner->channel == HFS_CHANNEL_RESULT && owner->frame_kind == HFS_FRAME_RESULT &&
+	    session->terminal_pending &&
+	    session->enrollment.protocol_features == HFS_TERMINAL_FEATURES &&
+	    !hfs_json_u64(owner->original, hfs_json_field(owner->original, 0, "cell"), &cell) &&
+	    cell == session->terminal_cell && donor_matches &&
+	    hfs_json_is(owner->original, hfs_json_field(owner->original, 0, "op"),
+			"\"SESSION_RETIRE\"") &&
+	    token >= 0 && !expected->error &&
+	    owner->original->tokens[token].end - owner->original->tokens[token].start ==
+		    expected->len &&
+	    !memcmp(owner->original->data + owner->original->tokens[token].start, expected->data,
+		    expected->len))
+		err = hfs_controlled_control_admissible(session);
+	hfs_received_put(owner);
+	return err;
+}
+
+/* Raw private replies identify an original request, not retirement authority.
+ * A protected signed FLOOR is independently required before destruction.
+ */
+int hfs_received_original(struct hfs_session *session, const struct hfs_json *json,
+		const char *operation, const struct hfs_buf *expected)
+{
+	struct hfs_kernel_received *owner;
+	char op[32];
+	u32 start, length;
+	int payload, err = -EKEYREJECTED;
+
+	owner = hfs_received_get(json, &start, &length);
+	if (!owner)
+		return err;
+	payload = hfs_json_field(owner->original, 0, "payload");
+	if (owner->session == session && !start && length == owner->response->len &&
+	    owner->channel == HFS_CHANNEL_RESULT && owner->frame_kind == HFS_FRAME_RESULT &&
+	    hfs_json_string(owner->original, hfs_json_field(owner->original, 0, "op"), op, sizeof(op)) >= 0 &&
+	    !strcmp(op, operation) && payload >= 0 && !expected->error &&
+	    owner->original->tokens[payload].end - owner->original->tokens[payload].start == expected->len &&
+	    !memcmp(owner->original->data + owner->original->tokens[payload].start, expected->data, expected->len))
+		err = hfs_controlled_control_admissible(session);
+	hfs_received_put(owner);
+	return err;
+}
+
+int hfs_received_copy(const struct hfs_json *json, int token, struct hfs_json **out)
+{
+	struct hfs_kernel_received *owner;
+	struct hfs_received_link *link = NULL;
+	u32 offset, length, start, span;
+	u64 bytes;
+	void *credit = NULL;
+	int err;
+
+	*out = NULL;
+	if (token < 0 || (u32)token >= json->count)
+		return -EPROTO;
+	owner = hfs_received_get(json, &offset, &length);
+	if (!owner)
+		return hfs_json_parse(json->data + json->tokens[token].start,
+				      json->tokens[token].end - json->tokens[token].start, out);
+	err = hfs_received_token_span(owner, json, token, offset, &start, &span);
+	if (err)
+		goto out;
+	/* Account actual private parse plus peak old/new token arenas, and the
+   * separate association. The existing request owner is not repurposed.
+   */
+	bytes = span + 1ULL + sizeof(**out) + sizeof(*link) +
+		2ULL * min_t(u32, span / 2 + 1, 131072U) * sizeof(struct hfs_token);
+	err = owner->completion ? hfs_completion_reserve(owner->completion, bytes, false, &credit) :
+				  -ESTALE;
+	if (err == -ESTALE || err == -ENOSPC)
+		err = owner->session->provider->reserve(owner->session, bytes, owner->control,
+							&credit);
+	if (err)
+		goto out;
+	link = kzalloc(sizeof(*link), GFP_KERNEL);
+	if (!link) {
+		err = -ENOMEM;
+		goto out;
+	}
+	err = hfs_json_parse(owner->response->data + start, span, out);
+	if (err)
+		goto out;
+	link->json = *out;
+	link->owner = owner;
+	link->start = start;
+	link->length = span;
+	link->credit = credit;
+	mutex_lock(&hfs_received_lock);
+	list_add_tail(&link->list, &hfs_received_links);
+	mutex_unlock(&hfs_received_lock);
+	return 0; /* Borrowed owner reference transfers to the new association. */
+out:
+	kfree(link);
+	if (credit)
+		owner->session->provider->unreserve(owner->session, credit);
+	hfs_received_put(owner);
+	return err;
+}
+
+void hfs_received_forget(struct hfs_json *json)
+{
+	struct hfs_received_link *link, *release = NULL;
+
+	mutex_lock(&hfs_received_lock);
+	list_for_each_entry(link, &hfs_received_links, list)
+		if (link->json == json) {
+			list_del(&link->list);
+			release = link;
+			break;
+		}
+	mutex_unlock(&hfs_received_lock);
+	if (release) {
+		struct hfs_kernel_received *owner = release->owner;
+		void *credit = release->credit;
+
+		kfree(release);
+		if (credit)
+			owner->session->provider->unreserve(owner->session, credit);
+		hfs_received_put(owner);
+	}
+}
+
+static void hfs_received_capture(struct hfs_session *session,
+				 struct hfs_received_capture *capture)
+{
+	struct hfs_view *view = hfs_view_get(session);
+	unsigned long flags;
+
+	memset(capture, 0, sizeof(*capture));
+	if (!view)
+		return;
+	spin_lock_irqsave(&view->lock, flags);
+	capture->have_view = true;
+	capture->revision = view->revision;
+	capture->phase = view->phase;
+	spin_unlock_irqrestore(&view->lock, flags);
+	hfs_view_put(view);
+}
+
+static bool hfs_received_source_current(struct hfs_kernel_received *owner)
+{
+	const struct hfs_json *json = owner->response;
+	struct hfs_view *view = hfs_view_get(owner->session);
+	u64 fence = 0, expected_fence;
+	unsigned long flags;
+	int payload = hfs_json_field(json, 0, "payload");
+	int lease = hfs_json_field(json, payload, "lease");
+	int entry = hfs_json_field(json, payload, "entry");
+	bool source_current = false;
+
+	if (!view || !owner->capture.have_view)
+		goto out;
+	expected_fence = hfs_controlled_current_fence(owner->session);
+	if (!hfs_json_is(json, lease, "null") &&
+	    (hfs_json_u64(json, hfs_json_field(json, lease, "fence"), &fence) ||
+	     !expected_fence || fence != expected_fence))
+		goto out;
+	spin_lock_irqsave(&view->lock, flags);
+	if (view->revision == owner->capture.revision && view->phase == owner->capture.phase) {
+		if (!hfs_json_is(json, entry, "null"))
+			source_current = view->phase == HFS_VIEW_QUIESCENT || view->phase == HFS_VIEW_STOPPED;
+		else
+			source_current = view->phase == HFS_VIEW_LIVE || view->phase == HFS_VIEW_UNBOUND;
+		if (source_current && owner->target >= 0 && view->target.len) {
+			u32 start = json->tokens[owner->target].start;
+			u32 length = json->tokens[owner->target].end - start;
+
+			source_current = length == view->target.len &&
+				!memcmp(view->target.data, json->data + start, length);
+		}
+	}
+	spin_unlock_irqrestore(&view->lock, flags);
+out:
+	hfs_view_put(view);
+	return source_current;
+}
+
+/* Only the hfs_control transport-completion call site can invoke this factory.
+ * Missing/invalid evidence never becomes an authoritative received subtype.
+ */
+u64 hfs_received_capacity(u32 command_capacity, u32 body)
+{
+	u64 tokens = min_t(u64, body / 2 + 1, 131072ULL);
+
+	return sizeof(struct hfs_kernel_received) + sizeof(struct hfs_received_link) +
+		3ULL * sizeof(struct hfs_json) + command_capacity + 2ULL * body + 3ULL +
+		128ULL * 1024ULL + (2ULL * min_t(u32, command_capacity / 2 + 1, 131072U) +
+		3ULL * tokens) * sizeof(struct hfs_token);
+}
+
+u64 hfs_received_copy_capacity(u32 body)
+{
+	return body + 1ULL + sizeof(struct hfs_json) + sizeof(struct hfs_received_link) +
+		2ULL * min_t(u32, body / 2 + 1, 131072U) * sizeof(struct hfs_token);
+}
+
+/* Resource capacity only, reserved before response data, never authority. */
+static int hfs_received_prepare(struct hfs_session *session, u32 command_capacity,
+	struct hfs_response_profile response, bool control,
+	struct hfs_completion *completion, void **credit)
+{
+	u64 bytes = hfs_received_capacity(command_capacity, response.max_body);
+
+	return completion ? hfs_completion_reserve(completion, bytes, true, credit) :
+		hfs_controlled_received_reserve(session, bytes, control, credit);
+}
+
+static int hfs_received_new(struct hfs_session *session, const struct hfs_buf *command,
+			    struct hfs_json *json, const struct hfs_received_capture *capture,
+			    struct hfs_response_profile response, bool control, bool cleanup,
+			    struct hfs_completion *completion, void **prepared)
+{
+	struct hfs_kernel_received *owner;
+	struct hfs_received_link *link;
+	struct hfs_mapped_attestation attestation = { 0 };
+	u64 bytes;
+	int payload, lease, receipt, evidence, err;
+	void *credit = *prepared;
+
+	*prepared = NULL;
+	bytes = sizeof(*owner) + sizeof(*link) + 2ULL * sizeof(struct hfs_json) + command->len +
+		json->len + 2ULL + 128ULL * 1024ULL +
+		2ULL *
+			(min_t(u32, command->len / 2 + 1, 131072U) +
+			 min_t(u32, json->len / 2 + 1, 131072U)) *
+			sizeof(struct hfs_token) +
+		/* The original returned parse outlives the transient carrier credit. */
+		sizeof(*json) + json->len + 1ULL + (u64)json->count * sizeof(struct hfs_token);
+	err = hfs_controlled_trim_credit(session, credit, bytes);
+	if (err) {
+		hfs_controlled_received_release(session, credit);
+		return err;
+	}
+	owner = kzalloc(sizeof(*owner), GFP_KERNEL);
+	link = kzalloc(sizeof(*link), GFP_KERNEL);
+	if (!owner || !link) {
+		kfree(owner);
+		kfree(link);
+		hfs_controlled_received_release(session, credit);
+		return -ENOMEM;
+	}
+	kref_init(&owner->refs);
+	owner->session = session;
+	owner->credit = credit;
+	owner->target = owner->source = owner->event = owner->publication = -1;
+	owner->capture = *capture;
+	owner->channel = response.channel;
+	owner->frame_kind = response.kind;
+	owner->control = control;
+	owner->cleanup = cleanup;
+	owner->completion = completion;
+	err = hfs_json_parse(command->data, command->len, &owner->original);
+	if (!err)
+		err = hfs_json_parse(json->data, json->len, &owner->response);
+	if (!err)
+		err = hfs_controlled_verify_received(session, owner->original, owner->response,
+						     &attestation);
+	if (!err)
+		err = hfs_json_u64(owner->original, hfs_json_field(owner->original, 0, "cell"),
+				   &owner->cell);
+	if (err)
+		goto fail;
+	payload = hfs_json_field(owner->response, 0, "payload");
+	if (hfs_json_is(owner->original, hfs_json_field(owner->original, 0, "op"), "\"QUERY\"") &&
+	    hfs_json_is(owner->response, hfs_json_field(owner->response, payload, "status"),
+			"\"TERMINAL\""))
+		owner->publication = hfs_json_field(
+			owner->response, hfs_json_field(owner->response, payload, "result"),
+			"publication");
+	if (attestation.kind == HFS_ATTESTATION_EVENT) {
+		owner->kind = HFS_ATTESTATION_EVENT;
+		owner->event = hfs_json_field(owner->response, payload, "event");
+		owner->target = hfs_json_field(owner->response, owner->event, "target");
+		if (hfs_json_is(owner->response, owner->target, "null"))
+			owner->target = -1;
+	} else if (attestation.kind == HFS_ATTESTATION_SOURCE) {
+		lease = hfs_json_field(owner->response, payload, "lease");
+		if (!hfs_json_is(owner->response, lease, "null"))
+			owner->target = hfs_json_field(owner->response, lease, "target");
+		owner->source = lease;
+		if (hfs_json_is(owner->response, owner->source, "null"))
+			owner->source = hfs_json_field(owner->response, payload, "reservation");
+		if (hfs_json_is(owner->response, owner->source, "null"))
+			owner->source = hfs_json_field(owner->response, payload, "entry");
+		if (owner->source < 0 || hfs_json_is(owner->response, owner->source, "null")) {
+			err = -EPROTO;
+			goto fail;
+		}
+		if (hfs_received_source_current(owner))
+			owner->kind = HFS_ATTESTATION_SOURCE;
+		else {
+			owner->target = owner->source = -1; /* Raw outcome, no stale adoption. */
+		}
+	}
+	if (attestation.kind == HFS_ATTESTATION_FLOOR ||
+	    attestation.kind == HFS_ATTESTATION_VIEW_FLOOR ||
+	    attestation.kind == HFS_ATTESTATION_SESSION_RETIRED)
+		owner->kind = attestation.kind;
+	receipt = hfs_json_field(owner->response, 0, "verification");
+	evidence = hfs_json_field(owner->response, receipt, "evidence");
+	if (owner->target >= 0) {
+		int expected = hfs_json_field(owner->response, evidence, "target");
+		u32 start = owner->response->tokens[owner->target].start;
+		u32 length = owner->response->tokens[owner->target].end - start;
+
+		if (expected < 0 ||
+		    owner->response->tokens[expected].end -
+				    owner->response->tokens[expected].start !=
+			    length ||
+		    memcmp(owner->response->data + start,
+			   owner->response->data + owner->response->tokens[expected].start,
+			   length)) {
+			err = -ESTALE;
+			goto fail;
+		}
+	}
+	link->json = json;
+	link->owner = owner;
+	link->length = json->len;
+	mutex_lock(&hfs_received_lock);
+	list_add_tail(&link->list, &hfs_received_links);
+	mutex_unlock(&hfs_received_lock);
+	return 0;
+fail:
+	kfree(link);
+	hfs_received_put(owner);
+	return err;
+}
