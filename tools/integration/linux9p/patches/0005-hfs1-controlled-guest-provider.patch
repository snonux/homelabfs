+static int hfs_controlled_retirement(struct hfs_session *session, u64 through,
+		const u8 hash[32], const struct hfs_json *response)
+{
+	struct hfs_request *request, *issuer = NULL;
+	struct hfs_controlled_mount *mount;
+	struct hfs_retirement_cut *cut = session->retirement_cut;
+	struct hfs_buf expected = {};
+	void *scratch_credit;
+	u64 floor, number;
+	u32 count = 0;
+	u8 result[32];
+	int err;
+
+	mutex_lock(&hfs_controlled_lock);
+	mount = hfs_controlled_mount(session);
+	err = hfs_controlled_cleanup_live(mount);
+	floor = mount ? mount->ordinary_floor : 0;
+	mutex_unlock(&hfs_controlled_lock);
+	if (err || through < floor || (through == floor &&
+	    (!cut || cut->through != through || cut->response != response)))
+		return err ?: -ESTALE;
+	err = hfs_controlled_progress_reserve(session, HFS_BODY_MAX, &scratch_credit);
+	if (err)
+		return err;
+	err = hfs_buf_init(&expected, HFS_BODY_MAX);
+	if (err)
+		goto unreserve;
+	mutex_lock(&session->lock);
+	list_for_each_entry(request, &session->requests, list) {
+		issuer = request;
+		break;
+	}
+	if (!issuer) {
+		err = -ESTALE;
+		goto unlock;
+	}
+	hfs_buf_printf(&expected, "{\"anchor\":\"%pUb\",\"credentials\":", &session->enrollment.anchor);
+	hfs_buf_add(&expected, issuer->credentials.data, issuer->credentials.len);
+	hfs_buf_printf(&expected, ",\"nonce\":\"%pUb\",\"realm\":\"%pUb\",\"result_hashes\":[",
+		&session->enrollment.nonce, &session->enrollment.realm);
+	number = cut && cut->through == through && cut->response == response ? cut->first - 1 : floor;
+	list_for_each_entry(request, &session->requests, list) {
+		if (request->number > through)
+			break;
+		if (request->number != number + 1 || request->held || request->users ||
+		    !request->terminal || !request->adopted || count == 1024 ||
+		    request->credentials.len != issuer->credentials.len ||
+		    memcmp(request->credentials.data, issuer->credentials.data, issuer->credentials.len) ||
+		    hfs_controlled_request_hash(request, result)) {
+			err = -EBUSY;
+			goto unlock;
+		}
+		if (count++)
+			hfs_buf_literal(&expected, ",");
+		hfs_buf_hex(&expected, result, 32);
+		number = request->number;
+	}
+	if (!count || number != through) {
+		err = -ESTALE;
+		goto unlock;
+	}
+	hfs_buf_literal(&expected, "],\"subject\":");
+	hfs_buf_hex(&expected, session->enrollment.subject, session->enrollment.subject_len);
+	hfs_buf_printf(&expected, ",\"through\":%llu}", through);
+unlock:
+	mutex_unlock(&session->lock);
+	if (!err)
+		err = hfs_received_retirement(session, response, false, &expected, through, hash);
+	if (!err) {
+		mutex_lock(&hfs_controlled_lock);
+		/* No concurrent retirement can pass the session retirement mutex. */
+		if (mount->ordinary_floor != floor)
+			err = -ESTALE;
+		else
+			mount->ordinary_floor = through;
+		mutex_unlock(&hfs_controlled_lock);
+	}
+	hfs_buf_free(&expected);
+unreserve:
+	hfs_controlled_unreserve(session, scratch_credit);
+	return err;
+}
