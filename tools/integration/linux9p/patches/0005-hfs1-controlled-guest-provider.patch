+/* Strict canonical prime-order keys only; no admission is created here. */
+__attribute__((externally_visible))
+int hfs_ed25519_key_validate(const unsigned char key[32]);
+__attribute__((externally_visible))
+int hfs_ed25519_verify(const unsigned char key[32], const void *message,
+		       unsigned int length, const unsigned char signature[64]);
