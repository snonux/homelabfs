diff --git a/net/9p/trans_virtio.c b/net/9p/trans_virtio.c
--- a/net/9p/trans_virtio.c
+++ b/net/9p/trans_virtio.c
@@ -809,6 +809,51 @@
 };
 
 /* The standard init function */
+#ifdef CONFIG_9P_FS_HOMELABFS_CONTROLLED
+/* A retained device reference pins identity only. Admission must repeat this
+ * live channel check; removal unlinks the channel before waiting for users.
+ * Never expose chan->tag storage beyond virtio_9p_lock.
+ */
+int p9_client_hfs_virtio_identity(struct p9_client *client,
+		struct device **device, char *name, size_t name_size,
+		char *tag, size_t tag_size)
+{
+	struct virtio_chan *chan;
+	size_t name_length, tag_length;
+	int err = -ENODEV;
+
+	if (!client || !device || !name || !tag || !name_size || !tag_size)
+		return -EINVAL;
+	*device = NULL;
+	mutex_lock(&virtio_9p_lock);
+	if (client->trans_mod != &p9_virtio_trans ||
+	    READ_ONCE(client->status) != Connected)
+		goto out;
+	list_for_each_entry(chan, &virtio_chan_list, chan_list) {
+		if (!chan->inuse || chan->client != client ||
+		    chan != client->trans || chan->vdev->priv != chan ||
+		    !device_is_registered(&chan->vdev->dev))
+			continue;
+		name_length = strnlen(dev_name(&chan->vdev->dev), name_size);
+		tag_length = strnlen(chan->tag, tag_size);
+		if (name_length == name_size || tag_length == tag_size) {
+			err = -ENAMETOOLONG;
+			goto out;
+		}
+		*device = get_device(&chan->vdev->dev);
+		if (!*device)
+			goto out;
+		memcpy(name, dev_name(*device), name_length + 1);
+		memcpy(tag, chan->tag, tag_length + 1);
+		err = 0;
+		break;
+	}
+out:
+	mutex_unlock(&virtio_9p_lock);
+	return err;
+}
+#endif
+
 static int __init p9_virtio_init(void)
 {
 	int rc;
diff --git a/fs/9p/hfs_admission.c b/fs/9p/hfs_admission.c
new file mode 100644
--- /dev/null
+++ b/fs/9p/hfs_admission.c
@@ -0,0 +1,112 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Immutable bounded per-open sysfs observation, using existing kernfs APIs. */
+#include "hfs_admission.h"
+#include "hfs_protocol.h"
+#ifndef HFS_PROVIDER_USERSPACE
+#include <linux/atomic.h>
+#include <linux/err.h>
+#include <linux/kernfs.h>
+#include <linux/kobject.h>
+#include <linux/slab.h>
+#endif
+
+static atomic_t hfs_admission_opens = ATOMIC_INIT(0);
+static struct kobject *hfs_admission_kobject;
+
+static int hfs_admission_open(struct kernfs_open_file *file)
+{
+	struct hfs_buf *snapshot;
+	int err;
+
+	if (atomic_inc_return(&hfs_admission_opens) > HFS_ADMISSION_OPEN_MAX) {
+		atomic_dec(&hfs_admission_opens);
+		return -ENOSPC;
+	}
+	snapshot = kzalloc(sizeof(*snapshot), GFP_KERNEL);
+	if (!snapshot) {
+		err = -ENOMEM;
+		goto release_slot;
+	}
+	err = hfs_buf_init(snapshot, HFS_ADMISSION_MAX);
+	if (!err)
+		err = hfs_controlled_snapshot(snapshot);
+	if (!err)
+		err = snapshot->error;
+	if (!err && (!snapshot->len || snapshot->len > HFS_ADMISSION_MAX))
+		err = -EOVERFLOW;
+	if (err) {
+		hfs_buf_free(snapshot);
+		kfree(snapshot);
+		goto release_slot;
+	}
+	file->priv = snapshot;
+	return 0;
+release_slot:
+	/* kernfs explicitly suppresses release() after a failed open(). */
+	atomic_dec(&hfs_admission_opens);
+	return err;
+}
+
+static ssize_t hfs_admission_read(struct kernfs_open_file *file, char *buffer,
+				  size_t count, loff_t offset)
+{
+	const struct hfs_buf *snapshot = file->priv;
+	size_t length;
+
+	if (!snapshot || offset < 0)
+		return -EINVAL;
+	if (offset >= snapshot->len)
+		return 0;
+	length = min_t(size_t, count, snapshot->len - offset);
+	memcpy(buffer, snapshot->data + offset, length);
+	return length;
+}
+
+static void hfs_admission_release(struct kernfs_open_file *file)
+{
+	struct hfs_buf *snapshot = file->priv;
+
+	file->priv = NULL;
+	if (snapshot) {
+		hfs_buf_free(snapshot);
+		kfree(snapshot);
+		atomic_dec(&hfs_admission_opens);
+	}
+}
+
+static const struct kernfs_ops hfs_admission_operations = {
+	.open = hfs_admission_open,
+	.read = hfs_admission_read,
+	.release = hfs_admission_release,
+};
+
+int hfs_admission_init(void)
+{
+	struct kernfs_node *node;
+	int err;
+
+	if (hfs_admission_kobject)
+		return -EALREADY;
+	hfs_admission_kobject = kobject_create_and_add("homelabfs", kernel_kobj);
+	if (!hfs_admission_kobject)
+		return -ENOMEM;
+	node = __kernfs_create_file(hfs_admission_kobject->sd, "admission_v1",
+				    0400, GLOBAL_ROOT_UID, GLOBAL_ROOT_GID,
+				    HFS_ADMISSION_MAX,
+				    &hfs_admission_operations, NULL, NULL, NULL);
+	if (IS_ERR(node)) {
+		err = PTR_ERR(node);
+		kobject_put(hfs_admission_kobject);
+		hfs_admission_kobject = NULL;
+		return err;
+	}
+	/* The built-in boot-owned provider and all original identities live for
+	 * this entire boot. There is deliberately no unload/reset interface.
+	 */
+	return 0;
+}
+
+struct kobject *hfs_admission_root(void)
+{
+	return hfs_admission_kobject;
+}
diff --git a/fs/9p/hfs_admission.h b/fs/9p/hfs_admission.h
new file mode 100644
--- /dev/null
+++ b/fs/9p/hfs_admission.h
@@ -0,0 +1,17 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef FS_9P_HFS_ADMISSION_H
+#define FS_9P_HFS_ADMISSION_H
+
+#define HFS_ADMISSION_MAX (128U * 1024U)
+#define HFS_ADMISSION_OPEN_MAX 4U
+
+/* Implemented by the private boot-owned provider inventory. It serializes one
+ * complete locked state; no external JSON/callback can install observations.
+ */
+struct hfs_buf;
+int hfs_controlled_snapshot(struct hfs_buf *snapshot);
+int hfs_admission_init(void);
+struct kobject;
+struct kobject *hfs_admission_root(void);
+
+#endif
diff --git a/fs/9p/hfs_controlled.c b/fs/9p/hfs_controlled.c
new file mode 100644
--- /dev/null
+++ b/fs/9p/hfs_controlled.c
@@ -0,0 +1,1345 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Registered controlled-only provider and finite retained ownership. */
+#include "hfs_controlled.h"
+#include "hfs_controlled_internal.h"
+#include "hfs_crypto.h"
+#include "hfs_received.h"
+#include <linux/device.h>
+#include <linux/init.h>
+#include <linux/overflow.h>
+#include <linux/slab.h>
+#include <linux/user_namespace.h>
+
+struct hfs_controlled_credit {
+	struct hfs_completion *completion;
+	struct list_head list;
+	struct hfs_session *session;
+	u64 bytes;
+	bool control;
+	bool received;
+	bool completion_received;
+};
+struct hfs_controlled_cookie {
+	struct list_head list;
+	struct hfs_session *session;
+	void *credit;
+};
+
+static LIST_HEAD(hfs_controlled_credits);
+static LIST_HEAD(hfs_controlled_cookies);
+static u64 hfs_controlled_ordinary_used;
+static u64 hfs_controlled_control_used;
+static u32 hfs_controlled_nr_credits;
+static u32 hfs_controlled_nr_cookies;
+static u32 hfs_controlled_nr_received;
+static u32 hfs_controlled_nr_control_credits;
+static u32 hfs_controlled_nr_control_received;
+static const struct hfs_provider hfs_controlled_provider;
+static void hfs_completion_release_credit(struct hfs_controlled_credit *credit);
+static void hfs_controlled_unreserve(struct hfs_session *session, void *reservation);
+static int hfs_controlled_target_metadata(struct hfs_session *session, const struct hfs_json *json,
+					  int target);
+
+static int hfs_controlled_hash(const struct hfs_json *json, int object,
+			       const char *name, u8 hash[32])
+{
+	u32 length = 32;
+
+	return hfs_json_hex(json, hfs_json_field(json, object, name), hash, &length) ||
+		length != 32 ? -EPROTO : 0;
+}
+
+static struct hfs_controlled_mount *hfs_controlled_mount(struct hfs_session *session)
+{
+	u32 i;
+
+	if (!hfs_controlled_registry || session->provider != &hfs_controlled_provider)
+		return NULL;
+	for (i = 0; i < hfs_controlled_registry->nr_mounts; i++) {
+		struct hfs_controlled_mount *mount = hfs_controlled_registry->mounts[i];
+
+		if (mount->session == session && mount->claimed &&
+		    uuid_equal(&mount->enrollment.session, &session->enrollment.session) &&
+		    mount->enrollment.context_len == session->enrollment.context_len &&
+		    !memcmp(mount->enrollment.context, session->enrollment.context,
+			    mount->enrollment.context_len))
+			return mount;
+	}
+	return NULL;
+}
+
+/* Called with provider mutex, never physical/service locks or an RPC. */
+static int hfs_controlled_identity(struct hfs_controlled_mount *mount, bool super)
+{
+	struct device *device = NULL;
+	char name[256], tag[256];
+	u8 map[32];
+	int err;
+
+	if (!mount || !mount->group->bound || !mount->session ||
+	    !mount->device || !mount->session->client ||
+	    mount->session->bridge_minor != 4 ||
+	    (super && (!mount->super || mount->super->s_fs_info != mount->session ||
+		mount->super->s_dev != mount->super_device ||
+		mount->super->s_user_ns != &init_user_ns)))
+		return -ESTALE;
+	err = hfs_controlled_idmap(map);
+	if (err || memcmp(map, mount->idmap_hash, 32))
+		return -EACCES;
+	err = p9_client_hfs_virtio_identity(mount->session->client, &device,
+					  name, sizeof(name), tag, sizeof(tag));
+	if (!err && (device != mount->device || strcmp(name, mount->device_name) ||
+		      strcmp(tag, mount->device_tag)))
+		err = -ESTALE;
+	put_device(device);
+	return err;
+}
+
+/* Ordinary ingress never reopens after STOP or uncertain shutdown. */
+static int hfs_controlled_live(struct hfs_controlled_mount *mount, bool super)
+{
+	if (!mount || !mount->session || mount->retained || mount->stopping ||
+	    READ_ONCE(mount->session->closing))
+		return -ESTALE;
+	return hfs_controlled_identity(mount, super);
+}
+
+/* Closing sessions retain their device and immutable original sb binding.
+ * kill_super can already have destroyed the sb; never dereference it here.
+ */
+static int hfs_controlled_cleanup_live(struct hfs_controlled_mount *mount)
+{
+	if (!mount || !mount->super)
+		return -ESTALE;
+	return hfs_controlled_identity(mount, !READ_ONCE(mount->session->closing));
+}
+
+static bool hfs_controlled_cleanup_operation(const char *operation)
+{
+	return !strcmp(operation, "QUERY") || !strcmp(operation, "GAP_RESOLVE") ||
+		!strcmp(operation, "RETIRE") || !strcmp(operation, "RELEASE_CELL") ||
+		!strcmp(operation, "VIEW_RELEASE") || !strcmp(operation, "VIEW_QUERY") ||
+		!strcmp(operation, "VIEW_CANCEL") || !strcmp(operation, "VIEW_RETIRE") ||
+		!strcmp(operation, "VIEW_WAIT") || !strcmp(operation, "VIEW_POLL") ||
+		!strcmp(operation, "VIEW_ACK") || !strcmp(operation, "DIRTY_FREEZE");
+}
+
+/* Before a carrier package exists, compare only already-owned immutable
+ * buffers. No parser allocation or provider/view lock nests under session lock.
+ */
+static bool hfs_controlled_segment(const struct hfs_buf *payload, u32 *offset,
+		const void *bytes, u32 length)
+{
+	if (*offset > payload->len || length > payload->len - *offset ||
+	    memcmp(payload->data + *offset, bytes, length))
+		return false;
+	*offset += length;
+	return true;
+}
+
+static bool hfs_controlled_owned_cleanup(struct hfs_session *session,
+		const char *operation, const struct hfs_buf *payload)
+{
+	struct hfs_request *request;
+	const char *suffix = !strcmp(operation, "CALL") ?
+		",\"opcode\":\"DRAIN_WRITE\"}" : ",\"opcode\":\"READDIR\"}";
+	bool found = false;
+	u32 offset;
+
+	mutex_lock(&session->lock);
+	list_for_each_entry(request, &session->requests, list) {
+		if (request->session != session || !request->reservation ||
+		    request->intent.len < strlen(suffix) ||
+		    memcmp(request->intent.data + request->intent.len - strlen(suffix), suffix, strlen(suffix)))
+			continue;
+		if (!strcmp(operation, "READDIR_CLEANUP")) {
+			if (request->terminal && request->users && request->result &&
+			    request->readdir_cleanup.data && request->readdir_cleanup.len == payload->len &&
+			    !request->readdir_cleanup.error &&
+			    !memcmp(request->readdir_cleanup.data, payload->data, payload->len)) {
+				found = true;
+				break;
+			}
+			continue;
+		}
+		if (!request->earmarked || !request->bound || !request->held ||
+		    !request->control || request->terminal || !request->earmark_ticket ||
+		    request->original_context.len != session->enrollment.context_len ||
+		    memcmp(request->original_context.data, session->enrollment.context,
+			request->original_context.len))
+			continue;
+		offset = 0;
+		if (hfs_controlled_segment(payload, &offset, "{\"claim\":", sizeof("{\"claim\":") - 1) &&
+		    hfs_controlled_segment(payload, &offset, request->claim.data, request->claim.len) &&
+		    hfs_controlled_segment(payload, &offset, ",\"credentials\":", sizeof(",\"credentials\":") - 1) &&
+		    hfs_controlled_segment(payload, &offset, request->credentials.data, request->credentials.len) &&
+		    hfs_controlled_segment(payload, &offset, ",\"intent\":", sizeof(",\"intent\":") - 1) &&
+		    hfs_controlled_segment(payload, &offset, request->intent.data, request->intent.len) &&
+		    hfs_controlled_segment(payload, &offset, "}", 1) && offset == payload->len) {
+			found = true;
+			break;
+		}
+	}
+	mutex_unlock(&session->lock);
+	return found;
+}
+
+static bool hfs_controlled_cleanup_command(struct hfs_session *session, const char *operation,
+					   const struct hfs_buf *payload)
+{
+	if (!strcmp(operation, "SESSION_RETIRE"))
+		return session->terminal_pending &&
+		       session->enrollment.protocol_features == HFS_TERMINAL_FEATURES &&
+		       !payload->error && payload->len == session->terminal_payload.len &&
+		       !memcmp(payload->data, session->terminal_payload.data, payload->len);
+	if (!strcmp(operation, "CALL") || !strcmp(operation, "READDIR_CLEANUP"))
+		return hfs_controlled_owned_cleanup(session, operation, payload);
+	return hfs_controlled_cleanup_operation(operation);
+}
+
+bool hfs_controlled_owns(struct hfs_session *session)
+{
+	return session && session->provider == &hfs_controlled_provider;
+}
+
+bool hfs_controlled_consumed(struct hfs_session *session)
+{
+	u32 i;
+	bool consumed = false;
+
+	if (!hfs_controlled_owns(session))
+		return false;
+	mutex_lock(&hfs_controlled_lock);
+	if (hfs_controlled_registry)
+		for (i = 0; i < hfs_controlled_registry->nr_mounts; i++) {
+			struct hfs_controlled_mount *mount = hfs_controlled_registry->mounts[i];
+
+			if (mount->claimed && uuid_equal(&mount->enrollment.session,
+						     &session->enrollment.session)) {
+				consumed = true;
+				break;
+			}
+		}
+	mutex_unlock(&hfs_controlled_lock);
+	return consumed;
+}
+
+int hfs_controlled_admissible(struct hfs_session *session)
+{
+	int err;
+
+	mutex_lock(&hfs_controlled_lock);
+	err = hfs_controlled_live(hfs_controlled_mount(session), true);
+	mutex_unlock(&hfs_controlled_lock);
+	return err;
+}
+
+int hfs_controlled_control_admissible(struct hfs_session *session)
+{
+	int err;
+
+	mutex_lock(&hfs_controlled_lock);
+	err = hfs_controlled_cleanup_live(hfs_controlled_mount(session));
+	mutex_unlock(&hfs_controlled_lock);
+	return err;
+}
+
+u64 hfs_controlled_current_fence(struct hfs_session *session)
+{
+	struct hfs_controlled_mount *mount;
+	u64 fence = 0;
+
+	mutex_lock(&hfs_controlled_lock);
+	mount = hfs_controlled_mount(session);
+	if (!hfs_controlled_cleanup_live(mount))
+		fence = mount->current_fence;
+	mutex_unlock(&hfs_controlled_lock);
+	return fence;
+}
+
+static int hfs_controlled_enroll(const char *device, struct hfs_enrollment *enrollment)
+{
+	u32 i;
+	int err = -EACCES;
+
+	if (!device || current_user_ns() != &init_user_ns)
+		return -EACCES;
+	mutex_lock(&hfs_controlled_lock);
+	if (hfs_controlled_registry)
+		for (i = 0; i < hfs_controlled_registry->nr_mounts; i++) {
+			struct hfs_controlled_mount *mount = hfs_controlled_registry->mounts[i];
+
+			if (!strcmp(device, mount->device_tag)) {
+				if (mount->group->bound && !mount->claimed) {
+					mount->claimed = true;
+					*enrollment = mount->enrollment;
+					err = 0;
+				}
+				break;
+			}
+		}
+	mutex_unlock(&hfs_controlled_lock);
+	return err;
+}
+
+int hfs_controlled_bind_transport(struct hfs_session *session)
+{
+	struct device *device = NULL;
+	struct hfs_controlled_mount *mount = NULL;
+	char name[256], tag[256];
+	u32 i;
+	int err;
+
+	if (!hfs_controlled_owns(session))
+		return 0; /* Other existing profiles keep their own mandatory provider. */
+	err = p9_client_hfs_virtio_identity(session->client, &device,
+					  name, sizeof(name), tag, sizeof(tag));
+	if (err)
+		return err;
+	mutex_lock(&hfs_controlled_lock);
+	if (hfs_controlled_registry)
+		for (i = 0; i < hfs_controlled_registry->nr_mounts; i++)
+			if (uuid_equal(&hfs_controlled_registry->mounts[i]->enrollment.session,
+				       &session->enrollment.session)) {
+				mount = hfs_controlled_registry->mounts[i];
+				break;
+			}
+	if (!mount || !mount->claimed || !mount->group->bound || mount->session ||
+	    strcmp(name, mount->device_name) || strcmp(tag, mount->device_tag) ||
+	    session->bridge_minor != 4 || session->client->proto_version != p9_proto_hfs14)
+		err = -EACCES;
+	else {
+		mount->session = session;
+		mount->device = device;
+		device = NULL;
+	}
+	mutex_unlock(&hfs_controlled_lock);
+	put_device(device);
+	return err;
+}
+
+/* Binds the sb and creates the preowned progress lanes (control, retirement
+ * and, for features 32767, terminal). A failure leaves every lane NULL and
+ * returns all of their credits; mount_nodev then still calls kill_sb, so the
+ * close path must accept that partial state (zq3-r3 R3-1). mount->claimed and
+ * mount->session deliberately stay set: the accepted HELLO already consumed a
+ * native cell under this enrollment, kill_sb retains the session, and a
+ * registry row is never re-enrolled. Recovery is a fresh boot and provision.
+ */
+int hfs_controlled_bind_super(struct hfs_session *session, struct super_block *super)
+{
+	struct hfs_controlled_mount *mount;
+	int err;
+
+	if (!hfs_controlled_owns(session))
+		return 0;
+	mutex_lock(&hfs_controlled_lock);
+	mount = hfs_controlled_mount(session);
+	err = hfs_controlled_live(mount, false);
+	if (!err && (mount->super || super->s_fs_info != session ||
+		     super->s_user_ns != &init_user_ns || current_user_ns() != &init_user_ns))
+		err = -EACCES;
+	if (!err) {
+		mount->super = super;
+		mount->super_device = super->s_dev;
+	}
+	mutex_unlock(&hfs_controlled_lock);
+	if (!err) {
+		err = hfs_completion_progress_new(session, false, &session->control_completion);
+		if (!err)
+			err = hfs_completion_progress_new(session, true,
+							  &session->retirement_completion);
+		if (!err && session->enrollment.protocol_features == HFS_TERMINAL_FEATURES)
+			err = hfs_completion_terminal_new(session, &session->terminal_completion);
+		if (err) {
+			hfs_completion_close(session->retirement_completion);
+			session->retirement_completion = NULL;
+			hfs_completion_close(session->control_completion);
+			session->control_completion = NULL;
+			mutex_lock(&hfs_controlled_lock);
+			mount->super = NULL;
+			mount->super_device = 0;
+			mutex_unlock(&hfs_controlled_lock);
+		}
+	}
+	return err;
+}
+
+int hfs_controlled_begin_close(struct hfs_session *session)
+{
+	struct hfs_cred *credentials = NULL;
+	int err;
+
+	if (!hfs_controlled_owns(session) ||
+	    session->enrollment.protocol_features != HFS_TERMINAL_FEATURES)
+		return 0;
+	if (session->terminal_credentials.data)
+		return 0;
+	/* A failed bind_super never created the terminal lane, and fill_super
+	 * admitted nothing to settle. Refuse rather than dereference it; the
+	 * caller fences the retained session as blocked.
+	 */
+	if (!session->terminal_completion)
+		return -ESTALE;
+	err = hfs_completion_reserve(session->terminal_completion, 3ULL * HFS_TERMINAL_OBJECT_MAX,
+				     false, &session->terminal_storage);
+	if (err)
+		return err;
+	err = hfs_buf_init(&session->terminal_credentials, HFS_TERMINAL_OBJECT_MAX);
+	if (!err)
+		err = hfs_buf_init(&session->terminal_payload, HFS_TERMINAL_OBJECT_MAX);
+	if (!err)
+		err = hfs_buf_init(&session->terminal_settled, HFS_TERMINAL_OBJECT_MAX);
+	if (!err)
+		err = hfs_capture_terminal(session, &credentials);
+	if (!err) {
+		hfs_cred_write(&session->terminal_credentials, credentials);
+		err = session->terminal_credentials.error;
+	}
+	hfs_cred_free(credentials);
+	if (err) {
+		hfs_buf_free(&session->terminal_credentials);
+		hfs_buf_free(&session->terminal_payload);
+		hfs_buf_free(&session->terminal_settled);
+		hfs_controlled_unreserve(session, session->terminal_storage);
+		session->terminal_storage = NULL;
+	}
+	return err;
+}
+
+int hfs_controlled_before_send(struct hfs_session *session, const char *operation,
+			       const struct hfs_buf *payload, bool reserved)
+{
+	struct hfs_controlled_mount *mount;
+	const char *hello = hfs_protocol_selected_text(4, session->enrollment.protocol_features);
+	bool bootstrap, cleanup;
+	int err;
+
+	if (!hfs_controlled_owns(session))
+		return 0;
+	if (!operation || !payload || payload->error || !payload->len)
+		return -EINVAL;
+	if (strcmp(operation, "HELLO") &&
+	    (!session->control_completion || !session->retirement_completion))
+		return -ESTALE;
+	bootstrap = !strcmp(operation, "HELLO");
+	if (session->terminal_pending && strcmp(operation, "SESSION_RETIRE"))
+		return -ESTALE;
+	cleanup = (reserved || !strcmp(operation, "RELEASE_CELL")) &&
+		  hfs_controlled_cleanup_command(session, operation, payload);
+	if (reserved && (!strcmp(operation, "CALL") || !strcmp(operation, "READDIR_CLEANUP")) &&
+	    !cleanup)
+		return -EACCES;
+	mutex_lock(&hfs_controlled_lock);
+	mount = hfs_controlled_mount(session);
+	err = cleanup ? hfs_controlled_cleanup_live(mount) : hfs_controlled_live(mount, !bootstrap);
+	if (!err && bootstrap &&
+	    (reserved || mount->super || payload->len != strlen(hello) ||
+	     memcmp(payload->data, hello, payload->len)))
+		err = -EPROTO;
+	mutex_unlock(&hfs_controlled_lock);
+	return err;
+}
+
+static int hfs_controlled_map(struct hfs_session *session, const struct cred *cred,
+		struct user_namespace *mount_userns, uuid_t *namespace, u8 hash[32])
+{
+	struct hfs_controlled_mount *mount;
+	int err;
+
+	if (!cred || cred->user_ns != &init_user_ns || mount_userns != &init_user_ns)
+		return -EACCES;
+	mutex_lock(&hfs_controlled_lock);
+	mount = hfs_controlled_mount(session);
+	err = hfs_controlled_live(mount, true);
+	if (!err) {
+		*namespace = mount->user_namespace;
+		memcpy(hash, mount->idmap_hash, 32);
+	}
+	mutex_unlock(&hfs_controlled_lock);
+	return err;
+}
+
+static int hfs_controlled_reserve_owned(struct hfs_session *session, u64 bytes, bool control,
+					bool bootstrap, void **reservation)
+{
+	struct hfs_controlled_credit *credit;
+	struct hfs_controlled_mount *mount;
+	u64 total, limit, used;
+	int err;
+
+	*reservation = NULL;
+	if (!bytes || check_add_overflow(bytes, (u64)sizeof(*credit), &total))
+		return -EOVERFLOW;
+	mutex_lock(&hfs_controlled_lock);
+	mount = hfs_controlled_mount(session);
+	err = bootstrap ? (!mount || mount->super ? -ESTALE : hfs_controlled_live(mount, false)) :
+	      control	? hfs_controlled_cleanup_live(mount) :
+			  hfs_controlled_live(mount, true);
+	if (err)
+		goto out;
+	limit = control ? hfs_controlled_registry->budget.control_bytes :
+			  hfs_controlled_registry->budget.ordinary_bytes;
+	used = control ? hfs_controlled_control_used : hfs_controlled_ordinary_used;
+	if (control &&
+	    check_add_overflow(used, hfs_controlled_registry->control_base_bytes, &used)) {
+		err = -EOVERFLOW;
+		goto out;
+	}
+	/* Slot partitions are independent as well as byte partitions. The
+   * signed total is unchanged; ordinary pressure cannot borrow controls. */
+	if ((control ? hfs_controlled_nr_control_credits :
+		       hfs_controlled_nr_credits - hfs_controlled_nr_control_credits) >=
+		    hfs_controlled_registry->budget.reservations / 2 ||
+	    used > limit || total > limit - used) {
+		err = -ENOSPC;
+		goto out;
+	}
+	hfs_controlled_nr_credits++;
+	if (control) {
+		hfs_controlled_nr_control_credits++;
+		mount->control_credits++;
+	} else
+		mount->ordinary_credits++;
+	if (control)
+		hfs_controlled_control_used += total;
+	else
+		hfs_controlled_ordinary_used += total;
+out:
+	mutex_unlock(&hfs_controlled_lock);
+	if (err)
+		return err;
+	/* Reserve the complete byte/slot package BEFORE allocation. Allocation
+   * occurs without the provider lock, so reclaim cannot recurse under it.
+   */
+	credit = kzalloc(sizeof(*credit), GFP_KERNEL);
+	mutex_lock(&hfs_controlled_lock);
+	mount = hfs_controlled_mount(session);
+	err = !credit	? -ENOMEM :
+	      bootstrap ? (!mount || mount->super ? -ESTALE : hfs_controlled_live(mount, false)) :
+	      control	? hfs_controlled_cleanup_live(mount) :
+			  hfs_controlled_live(mount, true);
+	if (!err) {
+		credit->session = session;
+		credit->bytes = total;
+		credit->control = control;
+		list_add_tail(&credit->list, &hfs_controlled_credits);
+		*reservation = credit;
+	} else {
+		/* Nothing was returned or externally exposed from this pending
+     * allocation. Its definite local failure retires only this package.
+     */
+		hfs_controlled_nr_credits--;
+		if (control) {
+			hfs_controlled_nr_control_credits--;
+			mount->control_credits--;
+		} else
+			mount->ordinary_credits--;
+		if (control)
+			hfs_controlled_control_used -= total;
+		else
+			hfs_controlled_ordinary_used -= total;
+	}
+	mutex_unlock(&hfs_controlled_lock);
+	if (err)
+		kfree(credit);
+	return err;
+}
+
+static int hfs_controlled_reserve(struct hfs_session *session, u64 bytes,
+		bool control, void **reservation)
+{
+	return hfs_controlled_reserve_owned(session, bytes, control, false, reservation);
+}
+
+/* The caller already passed the typed pre-send gate. HELLO has no sb yet;
+ * it spends control ownership without creating source or workload authority.
+ */
+int hfs_controlled_transport_reserve(struct hfs_session *session,
+		const char *operation, u64 bytes, bool control, void **reservation)
+{
+	return hfs_controlled_reserve_owned(session, bytes,
+		control || !strcmp(operation, "HELLO"), !strcmp(operation, "HELLO"), reservation);
+}
+
+static void hfs_controlled_unreserve(struct hfs_session *session, void *reservation)
+{
+	struct hfs_controlled_credit *credit, *release = NULL;
+	struct hfs_controlled_mount *mount;
+
+	mutex_lock(&hfs_controlled_lock);
+	mount = hfs_controlled_mount(session);
+	/* Only this exact locally destroyed owner can return its charge.
+   * Retention never authorizes a blanket ledger reset. */
+	if (mount)
+		list_for_each_entry(credit, &hfs_controlled_credits, list)
+			if (credit == reservation && credit->session == session &&
+			    !credit->received) {
+				list_del(&credit->list);
+				if (credit->completion) {
+					mutex_unlock(&hfs_controlled_lock);
+					hfs_completion_release_credit(credit);
+					return;
+				}
+				hfs_controlled_nr_credits--;
+				if (credit->control) {
+					hfs_controlled_nr_control_credits--;
+					mount->control_credits--;
+				} else
+					mount->ordinary_credits--;
+				if (credit->control)
+					hfs_controlled_control_used -= credit->bytes;
+				else
+					hfs_controlled_ordinary_used -= credit->bytes;
+				release = credit;
+				break;
+			}
+	mutex_unlock(&hfs_controlled_lock);
+	kfree(release);
+}
+
+int hfs_controlled_received_reserve(struct hfs_session *session, u64 bytes,
+				   bool control, void **credit)
+{
+	int err = hfs_controlled_reserve(session, bytes, control, credit);
+
+	if (err)
+		return err;
+	mutex_lock(&hfs_controlled_lock);
+	if ((control ? hfs_controlled_nr_control_received :
+	    hfs_controlled_nr_received - hfs_controlled_nr_control_received) >=
+	    hfs_controlled_registry->budget.received / 2)
+		err = -ENOSPC;
+	else {
+		((struct hfs_controlled_credit *)*credit)->received = true;
+		hfs_controlled_nr_received++;
+		if (control) { hfs_controlled_nr_control_received++; hfs_controlled_mount(session)->control_received++; }
+		else hfs_controlled_mount(session)->ordinary_received++;
+	}
+	mutex_unlock(&hfs_controlled_lock);
+	if (err) {
+		hfs_controlled_unreserve(session, *credit);
+		*credit = NULL;
+	}
+	return err;
+}
+
+void hfs_controlled_received_release(struct hfs_session *session, void *credit)
+{
+	struct hfs_controlled_credit *candidate;
+	bool found = false;
+
+	mutex_lock(&hfs_controlled_lock);
+	list_for_each_entry(candidate, &hfs_controlled_credits, list)
+		if (candidate == credit && candidate->session == session && candidate->received) {
+			candidate->received = false;
+			if (candidate->completion) {
+				mutex_unlock(&hfs_controlled_lock);
+				hfs_controlled_unreserve(session, credit);
+				return;
+			}
+			hfs_controlled_nr_received--;
+			if (candidate->control) { hfs_controlled_nr_control_received--; hfs_controlled_mount(session)->control_received--; }
+			else hfs_controlled_mount(session)->ordinary_received--;
+			found = true;
+			break;
+		}
+	mutex_unlock(&hfs_controlled_lock);
+	if (found)
+		hfs_controlled_unreserve(session, credit);
+}
+
+#include "hfs_completion.inc"
+
+static int hfs_controlled_cap_consistent(struct hfs_session *session, const struct hfs_cap *cap)
+{
+	const struct hfs_json *json = cap->json;
+	uuid_t uuid;
+	u64 value;
+	u8 hash[32];
+	int kind = hfs_json_field(json, 0, "kind");
+	int scope = hfs_json_field(json, 0, "scope");
+
+	if (hfs_json_exact(json, 0,
+			   "ancestors_hash,credential_hash,description,kind,object_"
+			   "allocation,object_home,revision,rights,scope,token") ||
+	    !(hfs_json_is(json, kind, "\"ROOT\"") || hfs_json_is(json, kind, "\"PATH\"") ||
+	      hfs_json_is(json, kind, "\"DESCRIPTION\"")) ||
+	    hfs_json_u64(json, hfs_json_field(json, 0, "rights"), &value) || value != cap->rights ||
+	    hfs_json_u64(json, hfs_json_field(json, 0, "revision"), &value) ||
+	    value != cap->revision ||
+	    hfs_uuid(json, hfs_json_field(json, 0, "object_home"), &uuid) ||
+	    !uuid_equal(&uuid, &cap->home) ||
+	    hfs_uuid(json, hfs_json_field(json, 0, "object_allocation"), &uuid) ||
+	    !uuid_equal(&uuid, &cap->allocation) || hfs_controlled_hash(json, 0, "token", hash) ||
+	    memcmp(hash, cap->token, 32) || hfs_controlled_hash(json, 0, "credential_hash", hash) ||
+	    memcmp(hash, cap->credential_hash, 32) ||
+	    hfs_controlled_hash(json, 0, "ancestors_hash", hash) ||
+	    memcmp(hash, cap->ancestors_hash, 32) || scope < 0 ||
+	    json->tokens[scope].end - json->tokens[scope].start !=
+		    session->enrollment.context_len ||
+	    memcmp(json->data + json->tokens[scope].start, session->enrollment.context,
+		   session->enrollment.context_len))
+		return -EACCES;
+	if (hfs_json_is(json, kind, "\"DESCRIPTION\""))
+		return hfs_uuid(json, hfs_json_field(json, 0, "description"), &uuid) ||
+				       !uuid_equal(&uuid, &cap->description) ?
+			       -EACCES :
+			       0;
+	return uuid_is_null(&cap->description) &&
+			       hfs_json_is(json, hfs_json_field(json, 0, "description"), "null") ?
+		       0 :
+		       -EACCES;
+}
+
+static int hfs_controlled_enter(struct hfs_session *session, const struct hfs_cap *cap,
+				bool mutation, void **cookie)
+{
+	struct hfs_controlled_cookie *candidate;
+	void *credit;
+	int err;
+
+	*cookie = NULL;
+	if (!cap || !cap->json || !cap->revision || (mutation && !(cap->rights & 2)))
+		return -EACCES;
+	err = hfs_received_require(session, cap->json, 0);
+	if (!err)
+		err = hfs_controlled_cap_consistent(session, cap);
+	if (err)
+		return err;
+	err = hfs_controlled_reserve(session, sizeof(*candidate), false, &credit);
+	if (err)
+		return err;
+	candidate = kzalloc(sizeof(*candidate), GFP_KERNEL);
+	if (!candidate) {
+		err = -ENOMEM;
+		goto fail;
+	}
+	mutex_lock(&hfs_controlled_lock);
+	if (READ_ONCE(session->blocked) || READ_ONCE(session->closing) ||
+	    hfs_controlled_nr_cookies == hfs_controlled_registry->budget.cookies)
+		err = -EAGAIN;
+	else {
+		candidate->session = session;
+		candidate->credit = credit;
+		list_add_tail(&candidate->list, &hfs_controlled_cookies);
+		hfs_controlled_nr_cookies++;
+		hfs_controlled_mount(session)->cookies++;
+		*cookie = candidate;
+	}
+	mutex_unlock(&hfs_controlled_lock);
+	if (!err)
+		return 0;
+	kfree(candidate);
+fail:
+	hfs_controlled_unreserve(session, credit);
+	return err;
+}
+
+static void hfs_controlled_leave(struct hfs_session *session, void *cookie)
+{
+	struct hfs_controlled_cookie *candidate, *release = NULL;
+
+	mutex_lock(&hfs_controlled_lock);
+	list_for_each_entry(candidate, &hfs_controlled_cookies, list)
+		if (candidate == cookie && candidate->session == session) {
+			list_del(&candidate->list);
+			hfs_controlled_nr_cookies--;
+			hfs_controlled_mount(session)->cookies--;
+			release = candidate;
+			break;
+		}
+	mutex_unlock(&hfs_controlled_lock);
+	if (release) {
+		hfs_controlled_unreserve(session, release->credit);
+		kfree(release);
+	}
+}
+
+static int hfs_controlled_publication(struct hfs_session *session,
+				     const struct hfs_json *json, int token)
+{
+	if (!hfs_json_is(json, token, "null"))
+		return -EACCES;
+	return hfs_received_publication(session, json, token);
+}
+
+static int hfs_controlled_target_metadata(struct hfs_session *session,
+					 const struct hfs_json *json, int target)
+{
+	struct hfs_controlled_mount *mount;
+	struct hfs_signed_enrollment *enrollment;
+	struct hfs_json *original;
+	u8 hash[32];
+	uuid_t journal, expected;
+	u64 epoch, expected_epoch, position, baseline_position;
+	int cut, domain, stream, baseline, err;
+
+	mutex_lock(&hfs_controlled_lock);
+	mount = hfs_controlled_mount(session);
+	err = hfs_controlled_cleanup_live(mount);
+	if (err)
+		goto out;
+	enrollment = mount->group->enrollment;
+	original = enrollment->json;
+	domain = enrollment->domains[mount->domain_index].object;
+	stream = hfs_json_field(original, hfs_json_field(original, domain, "Journal"), "Stream");
+	baseline = hfs_json_field(original, hfs_json_field(original, 0, "Baseline"), "Position");
+	cut = hfs_json_field(json, target, "cut");
+	if (!hfs_json_is(json, hfs_json_field(json, target, "kind"), "\"CONTROLLED_LOCAL\"") ||
+	    hfs_controlled_hash(json, cut, "enrollment_hash", hash) || memcmp(hash, enrollment->enrollment_hash, 32) ||
+	    hfs_controlled_hash(json, cut, "profile_hash", hash) || memcmp(hash, enrollment->profile_hash, 32) ||
+	    hfs_uuid(json, hfs_json_field(json, cut, "journal_incarnation"), &journal) ||
+	    hfs_go_uuid(original, hfs_json_field(original,
+		hfs_json_field(original, domain, "Journal"), "Incarnation"), &expected, false) ||
+	    !uuid_equal(&journal, &expected) ||
+	    hfs_json_u64(json, hfs_json_field(json, cut, "journal_epoch"), &epoch) ||
+	    hfs_json_u64(original, hfs_json_field(original, stream, "Epoch"), &expected_epoch) || epoch != expected_epoch ||
+	    hfs_json_u64(json, hfs_json_field(json, cut, "journal_position"), &position) ||
+	    hfs_json_u64(original, hfs_json_field(original, baseline, "Sequence"), &baseline_position) || position < baseline_position)
+		err = -ESTALE;
+out:
+	mutex_unlock(&hfs_controlled_lock);
+	return err;
+}
+
+static int hfs_controlled_target(struct hfs_session *session,
+				 const struct hfs_json *json, int target)
+{
+	int err = hfs_received_target(session, json, target);
+
+	return err ?: hfs_controlled_target_metadata(session, json, target);
+}
+
+static int hfs_controlled_receipt_context(struct hfs_session *session,
+					 struct hfs_json **context, u8 key[32])
+{
+	struct hfs_controlled_mount *mount;
+	struct hfs_enrolled_domain *domain;
+	struct hfs_json *original;
+	struct hfs_buf bytes;
+	uuid_t generation;
+	int endpoint, err;
+
+	*context = NULL;
+	err = hfs_buf_init(&bytes, 8192);
+	if (err)
+		return err;
+	mutex_lock(&hfs_controlled_lock);
+	mount = hfs_controlled_mount(session);
+	err = hfs_controlled_cleanup_live(mount);
+	if (err)
+		goto out;
+	domain = &mount->group->enrollment->domains[mount->domain_index];
+	original = mount->group->enrollment->json;
+	endpoint = hfs_json_field(original, domain->object, "Endpoint");
+	err = hfs_go_uuid(original, hfs_json_field(original, domain->object,
+						 "ServingGeneration"), &generation, false);
+	if (err)
+		goto out;
+	hfs_buf_printf(&bytes, "{\"controller\":\"%pUb\",\"endpoint\":{\"command_node\":",
+		       &mount->group->controller);
+	hfs_buf_token(&bytes, original, hfs_json_field(original, endpoint, "command_node"));
+	hfs_buf_literal(&bytes, ",\"fuse_session\":");
+	hfs_buf_token(&bytes, original, hfs_json_field(original, endpoint, "fuse_session"));
+	hfs_buf_literal(&bytes, ",\"recall_node\":");
+	hfs_buf_token(&bytes, original, hfs_json_field(original, endpoint, "recall_node"));
+	hfs_buf_literal(&bytes, ",\"result_node\":");
+	hfs_buf_token(&bytes, original, hfs_json_field(original, endpoint, "result_node"));
+	hfs_buf_literal(&bytes, "},\"scope\":");
+	hfs_buf_add(&bytes, mount->enrollment.context, mount->enrollment.context_len);
+	hfs_buf_printf(&bytes, ",\"serving_generation\":\"%pUb\"}", &generation);
+	memcpy(key, domain->host, 32);
+	err = bytes.error;
+out:
+	mutex_unlock(&hfs_controlled_lock);
+	if (!err)
+		err = hfs_json_parse(bytes.data, bytes.len, context);
+	hfs_buf_free(&bytes);
+	return err;
+}
+
+static int hfs_controlled_query_original(struct hfs_session *session,
+		const struct hfs_json *original, const struct hfs_json *response)
+{
+	struct hfs_view_ticket *ticket;
+	struct hfs_json *retained = NULL;
+	int request = hfs_json_field(original, hfs_json_field(original, 0, "payload"), "request");
+	int err = -ESTALE;
+
+	if (request < 0)
+		return -EPROTO;
+	mutex_lock(&session->lock);
+	list_for_each_entry(ticket, &session->view_tickets, list)
+		if (ticket->bound && ticket->request.len == original->tokens[request].end -
+			original->tokens[request].start &&
+		    !memcmp(ticket->request.data, original->data + original->tokens[request].start,
+			    ticket->request.len)) {
+			err = hfs_json_parse(ticket->original.data, ticket->original.len, &retained);
+			break;
+		}
+	mutex_unlock(&session->lock);
+	if (!err)
+		err = hfs_mapped_source_policy(original, hfs_json_field(original, 0, "context"),
+			retained, response, hfs_json_field(response, 0, "payload"));
+	hfs_json_free(retained);
+	return err;
+}
+
+int hfs_controlled_verify_received(struct hfs_session *session, const struct hfs_json *original,
+				   const struct hfs_json *response,
+				   struct hfs_mapped_attestation *attestation)
+{
+	struct hfs_mapped_binding binding = { .verify_ed25519 = hfs_ed25519_verify };
+	struct hfs_json *context = NULL;
+	int receipt = hfs_json_field(response, 0, "verification");
+	int payload = hfs_json_field(response, 0, "payload"), evidence, target, err;
+	char operation[32];
+	bool cleanup;
+
+	memset(attestation, 0, sizeof(*attestation));
+	if (hfs_json_string(original, hfs_json_field(original, 0, "op"), operation,
+			    sizeof(operation)) < 0)
+		return -EPROTO;
+	{
+		int original_payload = hfs_json_field(original, 0, "payload");
+		struct hfs_buf original_bytes;
+
+		if (original_payload < 0)
+			return -EPROTO;
+		original_bytes = (struct hfs_buf){
+			.data = original->data + original->tokens[original_payload].start,
+			.len = original->tokens[original_payload].end -
+			       original->tokens[original_payload].start,
+		};
+		cleanup = hfs_controlled_cleanup_command(session, operation, &original_bytes);
+	}
+	err = cleanup ? hfs_controlled_control_admissible(session) :
+			hfs_controlled_admissible(session);
+	if (err)
+		return err;
+	if (hfs_json_is(response, receipt, "null")) {
+		/* A missing receipt may expose a non-authoritative status or ordinary
+     * controlled result, never a lease/reservation/frozen entry/event/floor.
+     */
+		static const char *const fields[] = { "lease", "reservation", "entry", "event" };
+		u32 i;
+
+		for (i = 0; i < ARRAY_SIZE(fields); i++) {
+			int token = hfs_json_field(response, payload, fields[i]);
+
+			if (token >= 0 && !hfs_json_is(response, token, "null"))
+				return -EKEYREJECTED;
+		}
+		if (hfs_json_is(response, hfs_json_field(response, payload, "status"),
+				"\"RETIRED\""))
+			return -EKEYREJECTED;
+		return 0;
+	}
+	err = hfs_controlled_receipt_context(session, &context, binding.public_key);
+	if (err)
+		return err;
+	binding.context = context;
+	binding.features = session->enrollment.protocol_features;
+	err = hfs_mapped_receipt_verify(&binding, original, response, attestation);
+	if (!err && attestation->kind == HFS_ATTESTATION_SOURCE &&
+	    hfs_json_is(original, hfs_json_field(original, 0, "op"), "\"VIEW_QUERY\""))
+		err = hfs_controlled_query_original(session, original, response);
+	if (!err && (attestation->kind == HFS_ATTESTATION_SOURCE ||
+		     attestation->kind == HFS_ATTESTATION_EVENT)) {
+		evidence = hfs_json_field(response, receipt, "evidence");
+		target = hfs_json_field(response, evidence, "target");
+		if (!hfs_json_is(response, target, "null"))
+			err = hfs_controlled_target_metadata(session, response, target);
+	}
+	if (!err)
+		err = cleanup ? hfs_controlled_control_admissible(session) :
+				hfs_controlled_admissible(session);
+	hfs_json_free(context);
+	return err;
+}
+
+static int hfs_controlled_view_event(struct hfs_session *session,
+				     const struct hfs_json *json, int event)
+{
+	struct hfs_controlled_mount *mount;
+	u64 sequence;
+	u8 hash[32];
+	int domain = hfs_json_field(json, event, "domain"), err;
+
+	err = hfs_received_event(session, json, event);
+	if (err)
+		return err;
+	if (!session->domain || domain < 0 ||
+	    json->tokens[domain].end - json->tokens[domain].start != session->domain->json->len ||
+	    memcmp(json->data + json->tokens[domain].start, session->domain->json->data,
+		   session->domain->json->len) ||
+	    hfs_json_u64(json, hfs_json_field(json, event, "sequence"), &sequence) || !sequence)
+		return -ESTALE;
+	hfs_hash(json->data + json->tokens[event].start,
+		 json->tokens[event].end - json->tokens[event].start, hash);
+	mutex_lock(&hfs_controlled_lock);
+	mount = hfs_controlled_mount(session);
+	err = hfs_controlled_cleanup_live(mount);
+	if (!err && (sequence < mount->sequence ||
+	    (sequence == mount->sequence && memcmp(hash, mount->event_hash, 32))))
+		err = -ESTALE;
+	mutex_unlock(&hfs_controlled_lock);
+	return err;
+}
+
+static bool hfs_controlled_token_equal(const struct hfs_json *a, int x,
+				       const struct hfs_json *b, int y)
+{
+	u32 length;
+
+	if (x < 0 || y < 0 || (u32)x >= a->count || (u32)y >= b->count)
+		return false;
+	length = a->tokens[x].end - a->tokens[x].start;
+	return length == b->tokens[y].end - b->tokens[y].start &&
+		!memcmp(a->data + a->tokens[x].start, b->data + b->tokens[y].start, length);
+}
+
+static bool hfs_controlled_ack_predecessor(const char *old, const char *next)
+{
+	if (!strcmp(old, next))
+		return true;
+	if (!strcmp(next, "STOPPED"))
+		return !strcmp(old, "LIVE") || !strcmp(old, "REOPENED");
+	if (!strcmp(next, "INSTALLED_DRAIN"))
+		return !strcmp(old, "STOPPED");
+	if (!strcmp(next, "DRAINED"))
+		return !strcmp(old, "INSTALLED_DRAIN");
+	if (!strcmp(next, "INSTALLED_FINAL"))
+		return !strcmp(old, "DRAINED");
+	return !strcmp(next, "REOPENED") && !strcmp(old, "INSTALLED_FINAL");
+}
+
+int hfs_controlled_before_ack(struct hfs_view *view, const struct hfs_json *event, int token,
+			      const char *phase, const struct hfs_buf *payload)
+{
+	static const char *const fields[] = {
+		"authority_hash", "closure_hash", "domain", "inventory_hash", "recall", "sequence",
+	};
+	struct hfs_session *session;
+	struct hfs_controlled_mount *mount;
+	struct hfs_json *ack = NULL;
+	enum hfs_view_phase required;
+	unsigned long flags;
+	uuid_t recall, ack_session;
+	u64 sequence, revision;
+	u8 event_hash[32], ack_hash[32];
+	char encoded_phase[20];
+	bool manifest, target, reopened;
+	u32 i;
+	int value, err;
+
+	if (!view || !event || !phase || !payload)
+		return -EINVAL;
+	session = view->session;
+	if (!hfs_controlled_owns(session))
+		return 0;
+	if (view != READ_ONCE(session->view) || payload->error)
+		return -ESTALE;
+	if (!strcmp(phase, "STOPPED"))
+		required = HFS_VIEW_STOPPED;
+	else if (!strcmp(phase, "INSTALLED_DRAIN"))
+		required = HFS_VIEW_INSTALLED_DRAIN;
+	else if (!strcmp(phase, "DRAINED"))
+		required = HFS_VIEW_DRAINED;
+	else if (!strcmp(phase, "INSTALLED_FINAL"))
+		required = HFS_VIEW_FINAL;
+	else if (!strcmp(phase, "REOPENED"))
+		required = HFS_VIEW_LIVE;
+	else
+		return -EPROTO;
+	manifest = !strcmp(phase, "STOPPED") || !strcmp(phase, "DRAINED");
+	target = strcmp(phase, "STOPPED") != 0;
+	reopened = !strcmp(phase, "REOPENED");
+	/* Private event/source checks precede all physical transition locks. */
+	err = hfs_controlled_view_event(session, event, token);
+	if (!err)
+		err = hfs_json_parse(payload->data, payload->len, &ack);
+	if (err)
+		goto out;
+	if (hfs_json_exact(ack, 0,
+			   "authority_hash,closure_hash,domain,inventory_hash,"
+			   "manifest,phase,recall,sequence,session,target") ||
+	    hfs_json_string(ack, hfs_json_field(ack, 0, "phase"), encoded_phase,
+			    sizeof(encoded_phase)) < 0 ||
+	    strcmp(encoded_phase, phase) ||
+	    hfs_uuid(ack, hfs_json_field(ack, 0, "session"), &ack_session) ||
+	    !uuid_equal(&ack_session, &session->enrollment.session) ||
+	    hfs_uuid(event, hfs_json_field(event, token, "recall"), &recall) ||
+	    hfs_json_u64(event, hfs_json_field(event, token, "sequence"), &sequence)) {
+		err = -EPROTO;
+		goto out;
+	}
+	for (i = 0; i < ARRAY_SIZE(fields); i++)
+		if (!hfs_controlled_token_equal(ack, hfs_json_field(ack, 0, fields[i]), event,
+						hfs_json_field(event, token, fields[i]))) {
+			err = -ESTALE;
+			goto out;
+		}
+	if (target && !hfs_controlled_token_equal(ack, hfs_json_field(ack, 0, "target"), event,
+						  hfs_json_field(event, token, "target"))) {
+		err = -ESTALE;
+		goto out;
+	}
+	hfs_hash(event->data + event->tokens[token].start,
+		 event->tokens[token].end - event->tokens[token].start, event_hash);
+	hfs_hash(payload->data, payload->len, ack_hash);
+	mutex_lock(&view->transitions);
+	spin_lock_irqsave(&view->lock, flags);
+	revision = view->revision;
+	if (view->phase != required || view->sequence != sequence ||
+	    !uuid_equal(&view->recall, &recall) ||
+	    (!reopened && (!view->quiescent || view->active)) || (reopened && view->quiescent) ||
+	    ((required == HFS_VIEW_DRAINED || required == HFS_VIEW_FINAL || reopened) &&
+	     view->nr_dirty))
+		err = -ESTALE;
+	value = hfs_json_field(ack, 0, "manifest");
+	if (!err && (manifest ? !view->manifest.len ||
+					ack->tokens[value].end - ack->tokens[value].start !=
+						view->manifest.len ||
+					memcmp(ack->data + ack->tokens[value].start,
+					       view->manifest.data, view->manifest.len) :
+				!hfs_json_is(ack, value, "null")))
+		err = -ESTALE;
+	value = hfs_json_field(ack, 0, "target");
+	if (!err && (target ? !view->target.len ||
+				      ack->tokens[value].end - ack->tokens[value].start !=
+					      view->target.len ||
+				      memcmp(ack->data + ack->tokens[value].start,
+					     view->target.data, view->target.len) :
+			      !hfs_json_is(ack, value, "null")))
+		err = -ESTALE;
+	spin_unlock_irqrestore(&view->lock, flags);
+	if (!err) {
+		mutex_lock(&hfs_controlled_lock);
+		mount = hfs_controlled_mount(session);
+		if (!mount || hfs_controlled_cleanup_live(mount) ||
+		    !hfs_controlled_ack_predecessor(mount->phase, phase) ||
+		    sequence < mount->sequence || revision < mount->revision ||
+		    (reopened && (!mount->stop_revision || revision <= mount->stop_revision ||
+				  mount->current_fence == U64_MAX)))
+			err = -ESTALE;
+		else if (sequence == mount->sequence && !strcmp(mount->phase, phase)) {
+			/* Exact retry preserves its original fence even after acceptance. */
+			if (memcmp(mount->event_hash, event_hash, 32) ||
+			    memcmp(mount->acknowledgement_hash, ack_hash, 32))
+				err = -ESTALE;
+		} else {
+			mount->sequence = sequence;
+			mount->revision = revision;
+			mount->observation_fence = mount->current_fence;
+			strscpy(mount->phase, phase, sizeof(mount->phase));
+			memcpy(mount->event_hash, event_hash, 32);
+			memcpy(mount->acknowledgement_hash, ack_hash, 32);
+			if (required == HFS_VIEW_STOPPED)
+				mount->stop_revision = revision;
+		}
+		mutex_unlock(&hfs_controlled_lock);
+	}
+	mutex_unlock(&view->transitions);
+out:
+	hfs_json_free(ack);
+	return err;
+}
+
+int hfs_controlled_after_ack(struct hfs_session *session, const char *phase,
+			     const struct hfs_buf *payload, const struct hfs_json *response)
+{
+	struct hfs_controlled_mount *mount;
+	u8 hash[32];
+	int err = 0;
+
+	if (!hfs_controlled_owns(session) || strcmp(phase, "REOPENED"))
+		return 0;
+	err = hfs_received_acknowledgement(session, response, payload);
+	if (err)
+		return err;
+	hfs_hash(payload->data, payload->len, hash);
+	mutex_lock(&hfs_controlled_lock);
+	mount = hfs_controlled_mount(session);
+	if (!mount || hfs_controlled_cleanup_live(mount) || strcmp(mount->phase, "REOPENED") ||
+	    memcmp(mount->acknowledgement_hash, hash, 32))
+		err = -ESTALE;
+	else if (!mount->have_reopened_ack || memcmp(mount->reopened_ack, hash, 32)) {
+		if (mount->current_fence == U64_MAX)
+			err = -EOVERFLOW;
+		else {
+			mount->current_fence++;
+			mount->have_reopened_ack = true;
+			memcpy(mount->reopened_ack, hash, 32);
+		}
+	}
+	mutex_unlock(&hfs_controlled_lock);
+	return err;
+}
+
+static int hfs_controlled_stop(struct hfs_session *session)
+{
+	struct hfs_controlled_mount *mount;
+	struct hfs_view *view;
+	unsigned long flags;
+	int err = -EBUSY;
+	bool cookies;
+
+	/* Close admission BEFORE inspecting or joining any existing owner. */
+	WRITE_ONCE(session->blocked, true);
+	mutex_lock(&hfs_controlled_lock);
+	mount = hfs_controlled_mount(session);
+	if (mount)
+		mount->stopping = true;
+	cookies = mount && mount->cookies;
+	mutex_unlock(&hfs_controlled_lock);
+	if (!mount)
+		return -ESTALE;
+	view = hfs_view_get(session);
+	if (!view)
+		return cookies ? -EBUSY : 0; /* No physical grants were installed. */
+	wake_up_all(&view->wait); /* Parked entrants leave through the closed gate. */
+	spin_lock_irqsave(&view->lock, flags);
+	/* A bare FENCED phase never proves all-alias physical quiescence.
+   * The authenticated recall worker retains and drains busy/dirty state.
+   */
+	if (!cookies && !view->active && !view->nr_dirty && !view->nr_cached &&
+	    !view->nr_observations && !view->nr_mappings &&
+	    (view->phase == HFS_VIEW_UNBOUND || view->quiescent))
+		err = 0;
+	spin_unlock_irqrestore(&view->lock, flags);
+	hfs_view_put(view);
+	return err;
+}
+
+int hfs_controlled_terminal_event_done(struct hfs_session *session, const struct hfs_json *json,
+				       const struct hfs_buf *last_ack, u64 sequence)
+{
+	struct hfs_controlled_mount *mount;
+	u8 event_hash[32], ack_hash[32];
+	u64 actual;
+	int payload, event, err;
+
+	if (session->enrollment.protocol_features != HFS_TERMINAL_FEATURES || !session->closing ||
+	    !session->retained)
+		return -EACCES;
+	if (!json)
+		return !sequence && !last_ack->len ? 0 : -ESTALE;
+	payload = hfs_json_field(json, 0, "payload");
+	event = hfs_json_field(json, payload, "event");
+	err = hfs_received_event(session, json, event);
+	if (!err)
+		err = hfs_received_exclusive(session, json);
+	if (err)
+		return err;
+	if (last_ack->error || !last_ack->len || event < 0 ||
+	    !hfs_json_is(json, hfs_json_field(json, event, "phase"), "\"REOPEN\"") ||
+	    hfs_json_u64(json, hfs_json_field(json, event, "sequence"), &actual) ||
+	    actual != sequence)
+		return -ESTALE;
+	hfs_hash(json->data + json->tokens[event].start,
+		 json->tokens[event].end - json->tokens[event].start, event_hash);
+	hfs_hash(last_ack->data, last_ack->len, ack_hash);
+	mutex_lock(&hfs_controlled_lock);
+	mount = hfs_controlled_mount(session);
+	err = hfs_controlled_cleanup_live(mount);
+	if (!err && (!mount->have_reopened_ack || strcmp(mount->phase, "REOPENED") ||
+		     mount->sequence != sequence || memcmp(mount->event_hash, event_hash, 32) ||
+		     memcmp(mount->acknowledgement_hash, ack_hash, 32) ||
+		     memcmp(mount->reopened_ack, ack_hash, 32)))
+		err = -ESTALE;
+	mutex_unlock(&hfs_controlled_lock);
+	return err;
+}
+
+int hfs_controlled_release_ready(struct hfs_session *session)
+{
+	struct hfs_controlled_mount *mount;
+	int err = 0;
+
+	if (!session->terminal_verified)
+		return 0;
+	mutex_lock(&hfs_controlled_lock);
+	mount = hfs_controlled_mount(session);
+	if (!mount || mount != session->terminal_mount || !mount->terminal_retired ||
+	    !mount->terminal_length || !mount->claimed || !mount->device)
+		err = -ESTALE;
+	mutex_unlock(&hfs_controlled_lock);
+	return err;
+}
+
+/* Called only after release_ready and every fallible teardown check. Registry
+ * rows are permanent and cannot be removed/rebound, so this final detach has
+ * no allocation, RPC or failure window. The device remains a consumed identity.
+ */
+void hfs_controlled_session_released(struct hfs_session *session)
+{
+	if (!session->terminal_verified)
+		return;
+	mutex_lock(&hfs_controlled_lock);
+	session->terminal_mount->session = NULL;
+	session->terminal_mount->super = NULL;
+	session->terminal_mount->super_device = 0;
+	mutex_unlock(&hfs_controlled_lock);
+}
+
+static void hfs_controlled_retain(struct hfs_session *session)
+{
+	struct hfs_view *view;
+	u32 i;
+
+	WRITE_ONCE(session->blocked, true);
+	mutex_lock(&hfs_controlled_lock);
+	if (hfs_controlled_registry)
+		for (i = 0; i < hfs_controlled_registry->nr_mounts; i++) {
+			struct hfs_controlled_mount *mount = hfs_controlled_registry->mounts[i];
+
+			if (uuid_equal(&mount->enrollment.session, &session->enrollment.session)) {
+				if (WARN_ON_ONCE(mount->session && mount->session != session))
+					break;
+				mount->session = session;
+				mount->stopping = true;
+				mount->retained = true;
+				break;
+			}
+		}
+	mutex_unlock(&hfs_controlled_lock);
+	view = hfs_view_get(session);
+	if (view) {
+		wake_up_all(&view->wait);
+		hfs_view_put(view);
+	}
+}
+
+#include "hfs_controlled_lifetime.inc"
+
+static const struct hfs_provider hfs_controlled_provider = {
+	.owner = THIS_MODULE,
+	.features = HFS_MAPPED_FEATURES,
+	.enroll = hfs_controlled_enroll,
+	.map = hfs_controlled_map,
+	.enter = hfs_controlled_enter,
+	.leave = hfs_controlled_leave,
+	.publication = hfs_controlled_publication,
+	.target = hfs_controlled_target,
+	.view_event = hfs_controlled_view_event,
+	.stop = hfs_controlled_stop,
+	.reserve = hfs_controlled_reserve,
+	.unreserve = hfs_controlled_unreserve,
+	.retirement = hfs_controlled_retirement,
+	.view_retirement = hfs_controlled_view_retirement,
+	.resolve_gap = hfs_controlled_resolve_gap,
+	.retire_session = hfs_controlled_retire_session,
+	.retain = hfs_controlled_retain,
+};
+
+static int __init hfs_controlled_init(void)
+{
+	int err = hfs_controlled_artifacts_init();
+
+	if (!err)
+		err = v9fs_hfs_register_provider(&hfs_controlled_provider);
+	return err;
+}
+late_initcall(hfs_controlled_init);
