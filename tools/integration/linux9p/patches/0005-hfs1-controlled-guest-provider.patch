+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Included by the owned provider. Local absence never substitutes for a floor.
+ */
+static int hfs_controlled_request_hash(struct hfs_request *request, u8 hash[32])
+{
+	u32 length = 32;
+	const struct hfs_json *json = request->result;
+	int object = 0;
+	const char *field = "id";
+
+	if (!json && request->gap && request->gap_response) {
+		json = request->gap_response;
+		object = hfs_json_field(json, 0, "payload");
+		field = "proof_hash";
+	}
+	if (!json || hfs_json_hex(json, hfs_json_field(json, object, field), hash, &length) || length != 32)
+		return -EPROTO;
+	return 0;
+}
