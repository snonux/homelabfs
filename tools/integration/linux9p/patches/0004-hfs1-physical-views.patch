+int hfs_view_enter(struct hfs_view *view, const struct hfs_view_stamp *stamp,
+		   bool wait, void **cookie);
+void hfs_view_leave(void *cookie);
+int hfs_view_stop(struct hfs_view *view, const uuid_t *generation,
+		  const uuid_t *recall, u64 sequence);
+/* Caller has installed/verified the final target and resolved every old
+ * cache/dirty obligation before transitioning to FINAL. This closes the local
+ * epoch even when the visibility UUID is unchanged by the host mutation.
+ */
+void hfs_mmap_progress(struct hfs_session *session);
+int hfs_mmap_begin(struct inode *inode, bool mutation, const struct hfs_cred *cred,
+		    void *native_cookie, void **cookie);
+void hfs_mmap_end(void *cookie);
+int hfs_mmap_bootstrap(struct hfs_session *session, const struct hfs_cred *cred);
+int hfs_mmap_file(struct file *file, struct vm_area_struct *vma);
+int hfs_mmap_sync(struct file *file);
+int hfs_mmap_start(struct hfs_view *view);
+int hfs_mmap_prepare_retire(struct hfs_view *view);
+int hfs_mmap_terminal_prepare(struct hfs_view *view);
+int hfs_mmap_stop(struct hfs_view *view);
+int hfs_mmap_install(struct hfs_view *view, const struct hfs_json *event,
+		     int target, const uuid_t *recall, u64 sequence, bool final);
+int hfs_view_seal(struct hfs_view *view);
+int hfs_view_reopen(struct hfs_view *view, const uuid_t *recall, u64 sequence);
+void hfs_view_fence(struct hfs_view *view);
+
+#endif
diff --git a/fs/9p/hfs_view.c b/fs/9p/hfs_view.c
new file mode 100644
--- /dev/null
+++ b/fs/9p/hfs_view.c
@@ -0,0 +1,1089 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Physical retained-cache admission and all-alias PTE/TLB/MMU quiescence. */
+#include <linux/mm.h>
+#include <linux/pagemap.h>
+#include <linux/slab.h>
+#include <linux/vmalloc.h>
+#include <linux/migrate.h>
+#include <linux/writeback.h>
+#include "hfs.h"
+#include "hfs_view.h"
+
+static void hfs_view_release(struct kref *refs)
+{
+	struct hfs_view *view = container_of(refs, struct hfs_view, refs);
+
+	WARN_ON_ONCE(view->control || view->active || view->nr_mappings ||
+		     view->nr_cached || view->nr_dirty || view->nr_dirty_packages ||
+		     view->nr_grants || view->nr_observations);
+	hfs_buf_free(&view->target);
+	hfs_buf_free(&view->manifest);
+	hfs_buf_free(&view->retire_payload);
+	kvfree(view->retiring);
+	kvfree(view->stopping_pages);
+	kvfree(view->stopping);
+	view->session->provider->unreserve(view->session, view->reservation);
+	kfree(view);
+}
+
+struct hfs_view *hfs_view_get(struct hfs_session *session)
+{
+	struct hfs_view *view;
+
+	/* The caller owns a VFS file/superblock or controller session lifetime. */
+	mutex_lock(&session->lock);
+	view = session->view;
+	if (view && try_module_get(THIS_MODULE))
+		kref_get(&view->refs);
+	else
+		view = NULL;
+	mutex_unlock(&session->lock);
+	return view;
+}
+
+void hfs_view_put(struct hfs_view *view)
+{
+	if (!view)
+		return;
+	kref_put(&view->refs, hfs_view_release);
+	module_put(THIS_MODULE);
+}
+
+static int hfs_view_create(struct hfs_session *session, const uuid_t *generation, bool unbound)
+{
+	struct hfs_view *view;
+	void *reservation;
+	int err;
+
+	if (!generation || (!unbound && uuid_is_null(generation)) || session->view)
+		return -EINVAL;
+	err = session->provider->reserve(session, sizeof(*view) +
+			HFS_IDENTITIES_MAX * sizeof(struct inode *) +
+			HFS_CACHE_PAGES_MAX * sizeof(struct page *) +
+			HFS_VIEW_FAMILIES_MAX * sizeof(struct hfs_view_family *) +
+			HFS_VIEW_BODY_MAX + HFS_BODY_MAX + HFS_TARGET_MAX, true,
+			&reservation);
+	if (err)
+		return err;
+	view = kzalloc(sizeof(*view), GFP_KERNEL);
+	if (!view) {
+		session->provider->unreserve(session, reservation);
+		return -ENOMEM;
+	}
+	view->stopping = kvcalloc(HFS_IDENTITIES_MAX, sizeof(struct inode *),
+				  GFP_KERNEL);
+	if (!view->stopping) {
+		session->provider->unreserve(session, reservation);
+		kfree(view);
+		return -ENOMEM;
+	}
+	view->stopping_pages = kvcalloc(HFS_CACHE_PAGES_MAX,
+					sizeof(struct page *), GFP_KERNEL);
+	if (!view->stopping_pages) {
+		kvfree(view->stopping);
+		session->provider->unreserve(session, reservation);
+		kfree(view);
+		return -ENOMEM;
+	}
+	view->retiring = kvcalloc(HFS_VIEW_FAMILIES_MAX,
+				 sizeof(struct hfs_view_family *), GFP_KERNEL);
+	if (!view->retiring || hfs_buf_init(&view->retire_payload, HFS_VIEW_BODY_MAX) ||
+	    hfs_buf_init(&view->target, HFS_TARGET_MAX) ||
+	    hfs_buf_init(&view->manifest, HFS_BODY_MAX)) {
+		hfs_buf_free(&view->retire_payload);
+		hfs_buf_free(&view->target);
+		hfs_buf_free(&view->manifest);
+		kvfree(view->retiring);
+		kvfree(view->stopping_pages);
+		kvfree(view->stopping);
+		session->provider->unreserve(session, reservation);
+		kfree(view);
+		return -ENOMEM;
+	}
+	kref_init(&view->refs);
+	spin_lock_init(&view->lock);
+	mutex_init(&view->transitions);
+	init_waitqueue_head(&view->wait);
+	INIT_LIST_HEAD(&view->mappings);
+	INIT_LIST_HEAD(&view->cache);
+	INIT_LIST_HEAD(&view->dirty);
+	INIT_LIST_HEAD(&view->observations);
+	view->session = session;
+	view->reservation = reservation;
+	view->generation = *generation;
+	view->revision = 1;
+	view->phase = unbound ? HFS_VIEW_UNBOUND : HFS_VIEW_LIVE;
+	session->view = view;
+	return 0;
+}
+
+int hfs_view_new(struct hfs_session *session, const uuid_t *generation)
+{
+	return hfs_view_create(session, generation, false);
+}
+
+int hfs_view_new_unbound(struct hfs_session *session)
+{
+	uuid_t none = {};
+
+	return hfs_view_create(session, &none, true);
+}
+
+int hfs_view_free(struct hfs_session *session)
+{
+	struct hfs_view *view;
+	int err = 0;
+
+	mutex_lock(&session->lock);
+	view = session->view;
+	if (!view)
+		goto out;
+	/* get() and owner removal are serialized; parked callers retain refs. */
+	if (view->control || view->phase != HFS_VIEW_FENCED || view->active ||
+	    view->nr_mappings || view->nr_cached || view->nr_dirty || view->nr_observations ||
+	    refcount_read(&view->refs.refcount) != 1) {
+		err = -EBUSY;
+		goto out;
+	}
+	session->view = NULL;
+	mutex_unlock(&session->lock);
+	kref_put(&view->refs, hfs_view_release);
+	return 0;
+out:
+	mutex_unlock(&session->lock);
+	return err;
+}
+
+int hfs_view_register_inode(struct inode *inode)
+{
+	struct hfs_view *view = hfs_view_get(HFS_S(inode));
+	unsigned long flags;
+	int err = 0;
+
+	if (!view)
+		return -ESTALE;
+	spin_lock_irqsave(&view->lock, flags);
+	if (!list_empty(&HFS_I(inode)->view_list)) {
+		err = 0;
+	} else if (view->phase != HFS_VIEW_LIVE) {
+		err = -EAGAIN;
+	} else if (view->nr_mappings == HFS_IDENTITIES_MAX) {
+		err = -ENOSPC;
+	} else {
+		list_add_tail(&HFS_I(inode)->view_list, &view->mappings);
+		view->nr_mappings++;
+	}
+	spin_unlock_irqrestore(&view->lock, flags);
+	hfs_view_put(view);
+	return err;
+}
+
+void hfs_view_unregister_inode(struct inode *inode)
+{
+	struct hfs_view *view = hfs_view_get(HFS_S(inode));
+	unsigned long flags;
+
+	if (!view)
+		return;
+	spin_lock_irqsave(&view->lock, flags);
+	if (!list_empty(&HFS_I(inode)->view_list)) {
+		list_del_init(&HFS_I(inode)->view_list);
+		view->nr_mappings--;
+	}
+	spin_unlock_irqrestore(&view->lock, flags);
+	hfs_view_put(view);
+}
+
+int hfs_view_bind_initial(struct hfs_view *view, const struct hfs_lease *lease)
+{
+	unsigned long flags;
+	int token = hfs_json_field(lease->json, 0, "target");
+	u32 len;
+	int err = 0;
+
+	if (token < 0)
+		return -EPROTO;
+	len = lease->json->tokens[token].end - lease->json->tokens[token].start;
+	if (len > HFS_TARGET_MAX)
+		return -EPROTO;
+	mutex_lock(&view->transitions);
+	spin_lock_irqsave(&view->lock, flags);
+	if (view->phase == HFS_VIEW_LIVE && view->target.len) {
+		/* An initial target:null acquire may first require a verified empty
+		 * all-domain recall. It must name the actual already installed cut.
+		 */
+		err = uuid_equal(&view->generation, &lease->visibility) &&
+			!memcmp(view->target_hash, lease->target_hash, 32) ? 0 : -ESTALE;
+	} else if ((view->phase != HFS_VIEW_UNBOUND && view->phase != HFS_VIEW_LIVE) ||
+		   view->target.len || view->active || view->nr_mappings || view->nr_cached ||
+		   (view->phase == HFS_VIEW_LIVE &&
+		    !uuid_equal(&view->generation, &lease->visibility))) {
+		err = -ESTALE;
+	} else {
+		hfs_buf_add(&view->target, lease->json->data +
+			    lease->json->tokens[token].start, len);
+		memcpy(view->target_hash, lease->target_hash, 32);
+		view->generation = lease->visibility;
+		view->phase = HFS_VIEW_LIVE;
+		err = view->target.error;
+	}
+	spin_unlock_irqrestore(&view->lock, flags);
+	mutex_unlock(&view->transitions);
+	return err;
+}
+
+int hfs_view_capture(struct hfs_view *view, struct hfs_view_stamp *stamp,
+		     struct hfs_buf *target)
+{
+	unsigned long flags;
+	int err = 0;
+
+	spin_lock_irqsave(&view->lock, flags);
+	if (view->phase != HFS_VIEW_LIVE || !view->target.len) {
+		err = -EAGAIN;
+	} else if (target->cap < view->target.len) {
+		err = -ENOSPC;
+	} else {
+		target->len = 0;
+		target->error = 0;
+		hfs_buf_add(target, view->target.data, view->target.len);
+		stamp->generation = view->generation;
+		stamp->revision = view->revision;
+		err = target->error;
+	}
+	spin_unlock_irqrestore(&view->lock, flags);
+	return err;
+}
+
+int hfs_view_snapshot(struct hfs_view *view, struct hfs_view_stamp *stamp)
+{
+	unsigned long flags;
+	int err = 0;
+
+	spin_lock_irqsave(&view->lock, flags);
+	if (view->phase != HFS_VIEW_LIVE) {
+		err = -EAGAIN;
+	} else {
+		stamp->generation = view->generation;
+		stamp->revision = view->revision;
+	}
+	spin_unlock_irqrestore(&view->lock, flags);
+	return err;
+}
+
+static int hfs_view_try_enter_locked(struct hfs_view *view,
+				     const struct hfs_view_stamp *stamp,
+				     void **cookie)
+{
+	if (view->phase == HFS_VIEW_FENCED ||
+	    (view->session->bridge_minor == 4 &&
+	     (READ_ONCE(view->session->closing) || READ_ONCE(view->session->blocked))))
+		return -ESTALE;
+	if (stamp && (!uuid_equal(&view->generation, &stamp->generation) ||
+		      view->revision != stamp->revision))
+		return -ESTALE;
+	if (view->phase != HFS_VIEW_LIVE)
+		return -EAGAIN;
+	if (view->active == U32_MAX || !try_module_get(THIS_MODULE))
+		return -EOVERFLOW;
+	kref_get(&view->refs);
+	view->active++;
+	*cookie = view;
+	return 0;
+}
+
+int hfs_view_enter(struct hfs_view *view, const struct hfs_view_stamp *stamp,
+		   bool wait, void **cookie)
+{
+	unsigned long flags;
+	int err;
+
+	*cookie = NULL;
+	/* This independent reference protects parked entrants, before admission. */
+	if (!try_module_get(THIS_MODULE))
+		return -ESHUTDOWN;
+	kref_get(&view->refs);
+	for (;;) {
+		spin_lock_irqsave(&view->lock, flags);
+		err = hfs_view_try_enter_locked(view, stamp, cookie);
+		spin_unlock_irqrestore(&view->lock, flags);
+		if (!wait || err != -EAGAIN)
+			break;
+		err = wait_event_killable(view->wait,
+					  READ_ONCE(view->phase) == HFS_VIEW_LIVE ||
+					  READ_ONCE(view->phase) == HFS_VIEW_FENCED ||
+					  (view->session->bridge_minor == 4 &&
+					   (READ_ONCE(view->session->closing) ||
+					    READ_ONCE(view->session->blocked))));
+		if (err)
+			break;
+	}
+	hfs_view_put(view);
+	return err;
+}
+
+void hfs_view_leave(void *cookie)
+{
+	struct hfs_view *view = cookie;
+	unsigned long flags;
+	bool wake;
+
+	if (!view)
+		return;
+	/* kzalloc's aligned view pointer leaves bit0 for a lifetime-only
+	 * private-anonymous COW cookie. It has no backing-cache authority.
+	 */
+	if ((unsigned long)view & 1UL) {
+		hfs_view_put((struct hfs_view *)((unsigned long)view & ~1UL));
+		return;
+	}
+	spin_lock_irqsave(&view->lock, flags);
+	if (WARN_ON_ONCE(!view->active)) {
+		spin_unlock_irqrestore(&view->lock, flags);
+		return;
+	}
+	wake = !--view->active;
+	spin_unlock_irqrestore(&view->lock, flags);
+	if (wake)
+		wake_up_all(&view->wait);
+	hfs_view_put(view);
+}
+
+int hfs_view_stop(struct hfs_view *view, const uuid_t *generation,
+		  const uuid_t *recall, u64 sequence)
+{
+	struct hfs_inode *object;
+	struct hfs_cache_page *entry;
+	struct hfs_cache_grant *grant;
+	struct hfs_observation *observation;
+	unsigned long flags;
+	u32 count = 0, pages = 0, i;
+	int err = 0;
+
+	if (!sequence || uuid_is_null(recall))
+		return -EINVAL;
+	mutex_lock(&view->transitions);
+	spin_lock_irqsave(&view->lock, flags);
+	if (view->phase == HFS_VIEW_UNBOUND) {
+		if (uuid_is_null(generation) || view->active || view->nr_cached ||
+		    view->nr_dirty || view->nr_mappings || view->target.len) {
+			err = -ESTALE;
+			goto unlock_initial;
+		}
+		/* Only the mandatory authenticated event path calls STOP here.
+		 * No synthetic Context-generation -> visibility conversion exists.
+		 */
+		view->generation = *generation;
+		view->phase = HFS_VIEW_RECALLING;
+		view->recall = *recall;
+		view->sequence = sequence;
+	}
+	if (!uuid_equal(&view->generation, generation) ||
+	    view->phase == HFS_VIEW_FENCED || sequence < view->sequence) {
+		err = -ESTALE;
+		goto unlock_initial;
+	}
+	if (view->phase == HFS_VIEW_LIVE && sequence > view->sequence) {
+		view->phase = HFS_VIEW_RECALLING;
+		view->quiescent = false;
+		view->recall = *recall;
+		view->sequence = sequence;
+	} else if (sequence != view->sequence ||
+		   !uuid_equal(&view->recall, recall)) {
+		err = -ESTALE;
+		goto unlock_initial;
+	} else if (view->phase == HFS_VIEW_QUIESCENT ||
+		   view->phase == HFS_VIEW_STOPPED ||
+		   view->phase == HFS_VIEW_INSTALLED_DRAIN ||
+		   view->phase == HFS_VIEW_DRAINED ||
+		   view->phase == HFS_VIEW_FINAL) {
+		goto unlock_initial;
+	} else if (view->phase != HFS_VIEW_RECALLING) {
+		err = -ESTALE;
+		goto unlock_initial;
+	}
+	spin_unlock_irqrestore(&view->lock, flags);
+	/* No mmap/i_mmap/page/PTE lock is held while joining token holders. */
+	wait_event(view->wait, !READ_ONCE(view->active));
+	spin_lock_irqsave(&view->lock, flags);
+	if (view->phase != HFS_VIEW_RECALLING) {
+		spin_unlock_irqrestore(&view->lock, flags);
+		mutex_unlock(&view->transitions);
+		return -ESTALE;
+	}
+	/* evict unregisters before free, outside inode->i_lock. The only
+	 * nesting is view lock -> igrab's i_lock; no inode lock -> view path.
+	 */
+	list_for_each_entry(object, &view->mappings, view_list) {
+		struct inode *inode = igrab(&object->inode);
+
+		/* An inode already freeing has no live VMA/file observation. */
+		if (inode)
+			view->stopping[count++] = inode;
+	}
+	list_for_each_entry(entry, &view->cache, list) {
+		if (entry->page) {
+			get_page(entry->page);
+			view->stopping_pages[pages++] = entry->page;
+		}
+	}
+	spin_unlock_irqrestore(&view->lock, flags);
+	for (i = 0; i < count; i++) {
+		struct inode *inode = view->stopping[i];
+
+		/* Includes fork aliases/open-unlinked/executable file PTEs.
+		 * zap_page_range_single completes notifier and TLB invalidation.
+		 * Private anonymous modifications are application-owned snapshots.
+		 */
+		unmap_mapping_range(inode->i_mapping, 0, 0, 0);
+		iput(inode);
+		view->stopping[i] = NULL;
+	}
+	for (i = 0; i < pages; i++) {
+		struct page *page = view->stopping_pages[i];
+
+		lock_page(page);
+		/* No external kernel ref/pin path may bypass the page marker.
+		 * Refuse conservative pin/writeback/busy findings; never unpin,
+		 * force-write or assert success to advance a barrier.
+		 */
+		if (page_mapped(page) || PageWriteback(page) ||
+		    folio_maybe_dma_pinned(page_folio(page)))
+			err = -EBUSY;
+		/* A clean page may have completed eviction after our snapshot;
+		 * it no longer supplies any filesystem PTE or cache observation.
+		 */
+		if (page_mapping(page) && !PageHfsnogup(page))
+			err = -ESTALE;
+		unlock_page(page);
+		put_page(page);
+		view->stopping_pages[i] = NULL;
+	}
+	spin_lock_irqsave(&view->lock, flags);
+	if (!err && view->phase == HFS_VIEW_RECALLING) {
+		list_for_each_entry(entry, &view->cache, list) {
+			if (entry->lease)
+				WRITE_ONCE(entry->lease->revoked, true);
+			list_for_each_entry(grant, &entry->readers, list)
+				WRITE_ONCE(grant->lease->revoked, true);
+		}
+		list_for_each_entry(observation, &view->observations, list)
+			if (observation->lease)
+				WRITE_ONCE(observation->lease->revoked, true);
+		view->phase = HFS_VIEW_QUIESCENT;
+		view->quiescent = true;
+	} else if (!err)
+		err = -ESTALE;
+unlock_initial:
+	spin_unlock_irqrestore(&view->lock, flags);
+	mutex_unlock(&view->transitions);
+	return err;
+}
+
+int hfs_view_seal(struct hfs_view *view)
+{
+	struct hfs_dirty *dirty, *ordered[HFS_DIRTY_PAGES_MAX], *tmp;
+	struct hfs_buf *manifest = &view->manifest;
+	unsigned long flags;
+	u32 count = 0, i, j, entries_start, entries_len;
+	int err = 0;
+
+	mutex_lock(&view->transitions);
+	spin_lock_irqsave(&view->lock, flags);
+	if (view->phase == HFS_VIEW_STOPPED)
+		goto unlock;
+	if (view->phase != HFS_VIEW_QUIESCENT || !view->quiescent || view->active) {
+		err = -ESTALE;
+		goto unlock;
+	}
+	list_for_each_entry(dirty, &view->dirty, list) {
+		if (!dirty->adopted || !dirty->captured || !dirty->frozen ||
+		    !dirty->frozen_entry || count == HFS_DIRTY_PAGES_MAX) {
+			err = -EBUSY;
+			goto unlock;
+		}
+		ordered[count++] = dirty;
+	}
+	if (count != view->nr_dirty) {
+		err = -EPROTO;
+		goto unlock;
+	}
+	/* Insertion sort is bounded by sixteen immutable obligation records. */
+	for (i = 1; i < count; i++) {
+		tmp = ordered[i];
+		for (j = i; j && memcmp(ordered[j - 1]->entry_id, tmp->entry_id, 32) > 0; j--)
+			ordered[j] = ordered[j - 1];
+		ordered[j] = tmp;
+	}
+	manifest->len = 0;
+	manifest->error = 0;
+	hfs_buf_literal(manifest, "{\"entries\":");
+	entries_start = manifest->len;
+	hfs_buf_literal(manifest, "[");
+	for (i = 0; i < count; i++) {
+		if (i && !memcmp(ordered[i - 1]->entry_id, ordered[i]->entry_id, 32)) {
+			err = -EPROTO;
+			goto unlock;
+		}
+		if (i)
+			hfs_buf_literal(manifest, ",");
+		hfs_buf_add(manifest, ordered[i]->frozen_entry->data,
+			    ordered[i]->frozen_entry->len);
+	}
+	hfs_buf_literal(manifest, "]");
+	entries_len = manifest->len - entries_start;
+	if (manifest->error) {
+		err = manifest->error;
+		goto unlock;
+	}
+	hfs_hash(manifest->data + entries_start, entries_len, view->manifest_hash);
+	hfs_buf_literal(manifest, ",\"hash\":");
+	hfs_buf_hex(manifest, view->manifest_hash, 32);
+	hfs_buf_literal(manifest, "}");
+	err = manifest->error;
+	if (!err)
+		view->phase = HFS_VIEW_STOPPED;
+unlock:
+	spin_unlock_irqrestore(&view->lock, flags);
+	mutex_unlock(&view->transitions);
+	return err;
+}
+
+int hfs_view_reopen(struct hfs_view *view, const uuid_t *recall, u64 sequence)
+{
+	struct hfs_cache_page *entry;
+	unsigned long flags;
+	int err = 0;
+
+	mutex_lock(&view->transitions);
+	spin_lock_irqsave(&view->lock, flags);
+	if (view->phase == HFS_VIEW_LIVE && view->sequence == sequence &&
+	    uuid_equal(&view->recall, recall))
+		goto unlock;
+	if (view->phase != HFS_VIEW_FINAL || !view->quiescent ||
+	    !uuid_equal(&view->recall, recall) || sequence <= view->sequence ||
+	    !sequence || !view->target.len || view->active ||
+	    view->nr_dirty) {
+		err = -ESTALE;
+	} else {
+		/* A parked RPC may retain detached old metadata; it supplies no
+		 * cache observation and its old stamp will fail adoption below.
+		 */
+		list_for_each_entry(entry, &view->cache, list)
+			if (entry->page) {
+				err = -EBUSY;
+				break;
+			}
+	}
+	if (!err && view->revision == U64_MAX) {
+		/* Never wrap a stamp into an earlier admission lifetime. */
+		view->phase = HFS_VIEW_FENCED;
+		err = -EOVERFLOW;
+	} else if (!err) {
+		/* Same lock as reservation adoption and final writable-PTE entry.
+		 * A reserve captured before STOP cannot be adopted after REOPEN.
+		 */
+		view->revision++;
+		view->sequence = sequence;
+		view->quiescent = false;
+		view->phase = HFS_VIEW_LIVE;
+	}
+unlock:
+	spin_unlock_irqrestore(&view->lock, flags);
+	mutex_unlock(&view->transitions);
+	if (!err || err == -EOVERFLOW)
+		wake_up_all(&view->wait);
+	return err;
+}
+
+void hfs_view_fence(struct hfs_view *view)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&view->lock, flags);
+	view->phase = HFS_VIEW_FENCED;
+	spin_unlock_irqrestore(&view->lock, flags);
+	wake_up_all(&view->wait);
+}
+
+/* Page resources are admitted before allocating/exposing the cache page. */
+int hfs_view_page_prepare(struct hfs_view *view,
+			  const struct hfs_view_stamp *stamp,
+			  struct hfs_cache_page **out)
+{
+	struct hfs_cache_page *entry;
+	void *reservation;
+	unsigned long flags;
+	int err;
+
+	*out = NULL;
+	err = view->session->provider->reserve(view->session,
+			sizeof(*entry) + PAGE_SIZE + HFS_TARGET_MAX, false, &reservation);
+	if (err)
+		return err;
+	entry = kzalloc(sizeof(*entry), GFP_KERNEL);
+	if (!entry) {
+		view->session->provider->unreserve(view->session, reservation);
+		return -ENOMEM;
+	}
+	if (hfs_buf_init(&entry->target, HFS_TARGET_MAX)) {
+		view->session->provider->unreserve(view->session, reservation);
+		kfree(entry);
+		return -ENOMEM;
+	}
+	kref_init(&entry->refs);
+	INIT_LIST_HEAD(&entry->list);
+	INIT_LIST_HEAD(&entry->readers);
+	entry->view = view;
+	entry->stamp = *stamp;
+	entry->reservation = reservation;
+	spin_lock_irqsave(&view->lock, flags);
+	if (view->phase != HFS_VIEW_LIVE ||
+	    !uuid_equal(&view->generation, &stamp->generation) ||
+	    view->revision != stamp->revision) {
+		err = -ESTALE;
+	} else if (view->nr_cached == HFS_CACHE_PAGES_MAX) {
+		err = -ENOSPC;
+	} else if (!try_module_get(THIS_MODULE)) {
+		err = -ESHUTDOWN;
+	} else {
+		kref_get(&view->refs);
+		view->nr_cached++;
+		hfs_buf_add(&entry->target, view->target.data, view->target.len);
+		list_add_tail(&entry->list, &view->cache);
+		err = 0;
+	}
+	spin_unlock_irqrestore(&view->lock, flags);
+	if (err) {
+		hfs_buf_free(&entry->target);
+		view->session->provider->unreserve(view->session, reservation);
+		kfree(entry);
+		return err;
+	}
+	*out = entry;
+	return 0;
+}
+
+static void hfs_view_page_release(struct kref *refs)
+{
+	struct hfs_cache_page *entry = container_of(refs, struct hfs_cache_page, refs);
+	struct hfs_view *view = entry->view;
+	struct hfs_cache_grant *grant;
+	unsigned long flags;
+
+	if (WARN_ON_ONCE(entry->page || entry->dirty))
+		return;
+	spin_lock_irqsave(&view->lock, flags);
+	list_del_init(&entry->list);
+	view->nr_cached--;
+	if (entry->dirty_slot && !entry->cleanup)
+		view->nr_dirty_packages--;
+	list_for_each_entry(grant, &entry->readers, list)
+		view->nr_grants--;
+	spin_unlock_irqrestore(&view->lock, flags);
+	if (entry->dispose)
+		entry->dispose(entry);
+	hfs_buf_free(&entry->target);
+	view->session->provider->unreserve(view->session, entry->reservation);
+	kfree(entry);
+	hfs_view_put(view);
+}
+
+void hfs_view_page_get(struct hfs_cache_page *entry)
+{
+	kref_get(&entry->refs);
+}
+
+void hfs_view_page_put(struct hfs_cache_page *entry)
+{
+	kref_put(&entry->refs, hfs_view_page_release);
+}
+
+void hfs_view_page_discard(struct hfs_cache_page *entry)
+{
+	if (WARN_ON_ONCE(entry->page || entry->dirty))
+		return;
+	hfs_view_page_put(entry);
+}
+
+int hfs_view_page_attach(struct hfs_cache_page *entry, struct page *page)
+{
+	struct hfs_view *view = entry->view;
+	void *cookie;
+	unsigned long flags;
+	int err;
+
+	if (!PageLocked(page) || PageCompound(page) || PagePrivate(page) ||
+	    entry->page)
+		return -EINVAL;
+	if (!entry->lease || READ_ONCE(entry->lease->revoked) ||
+	    !uuid_equal(&entry->lease->visibility, &entry->stamp.generation))
+		return -ESTALE;
+	err = hfs_view_enter(view, &entry->stamp, false, &cookie);
+	if (err)
+		return err;
+	/* No PTE can see this page before marker + metadata are installed. */
+	SetPageHfsnogup(page);
+	folio_attach_private(page_folio(page), entry);
+	hfs_view_page_get(entry); /* private metadata ownership */
+	spin_lock_irqsave(&view->lock, flags);
+	entry->page = page;
+	spin_unlock_irqrestore(&view->lock, flags);
+	hfs_view_leave(cookie);
+	return 0;
+}
+
+struct hfs_cache_page *hfs_view_page_find(struct hfs_view *view, struct page *page)
+{
+	struct hfs_cache_page *entry, *found = NULL;
+	unsigned long flags;
+
+	spin_lock_irqsave(&view->lock, flags);
+	list_for_each_entry(entry, &view->cache, list)
+		if (entry->page == page && !entry->revoking) {
+			hfs_view_page_get(entry);
+			found = entry;
+			break;
+		}
+	spin_unlock_irqrestore(&view->lock, flags);
+	return found;
+}
+
+int hfs_view_dirty_slot(struct hfs_cache_page *entry)
+{
+	struct hfs_view *view = entry->view;
+	unsigned long flags;
+	int err = 0;
+
+	spin_lock_irqsave(&view->lock, flags);
+	if (view->phase != HFS_VIEW_LIVE || entry->revoking ||
+	    !uuid_equal(&view->generation, &entry->stamp.generation) ||
+	    view->revision != entry->stamp.revision)
+		err = -ESTALE;
+	else if (entry->dirty_slot)
+		err = -EBUSY;
+	else if (view->nr_dirty_packages == HFS_DIRTY_PAGES_MAX)
+		err = -ENOSPC;
+	else {
+		view->nr_dirty_packages++;
+		entry->dirty_slot = true;
+	}
+	spin_unlock_irqrestore(&view->lock, flags);
+	return err;
+}
+
+void hfs_view_dirty_unslot(struct hfs_cache_page *entry)
+{
+	struct hfs_view *view = entry->view;
+	unsigned long flags;
+
+	spin_lock_irqsave(&view->lock, flags);
+	if (!WARN_ON_ONCE(entry->dirty || !entry->dirty_slot)) {
+		entry->dirty_slot = false;
+		view->nr_dirty_packages--;
+	}
+	spin_unlock_irqrestore(&view->lock, flags);
+}
+
+int hfs_view_adopt_dirty(struct hfs_view *view, struct hfs_cache_page *entry,
+			 struct hfs_dirty *dirty)
+{
+	unsigned long flags;
+	int err = 0;
+
+	/* These immutable records and actual credit handles exist before PTEs.
+	 * Complete Reservation/number/Cred checks occur in the wire decoder.
+	 */
+	if (!dirty || !dirty->reservation || !dirty->reserve_ticket ||
+	    !dirty->freeze_ticket || !dirty->freeze_ticket->control ||
+	    !dirty->request || !dirty->request->reservation || !dirty->credit ||
+	    !dirty->request->earmarked || !dirty->request->control ||
+	    !dirty->length || dirty->length > 4096 || !entry->lease ||
+	    !entry->lease->dirty)
+		return -EINVAL;
+	spin_lock_irqsave(&view->lock, flags);
+	/* Capture predates dispatch. Neither a delayed reserve during STOP nor
+	 * an original replay after REOPEN may adopt into a later local epoch.
+	 */
+	if (view->phase != HFS_VIEW_LIVE || entry->revoking ||
+	    READ_ONCE(entry->lease->revoked) ||
+	    !uuid_equal(&view->generation, &entry->stamp.generation) ||
+	    view->revision != entry->stamp.revision ||
+	    memcmp(view->target_hash, entry->lease->target_hash, 32))
+		err = -ESTALE;
+	else if (entry->dirty || dirty->adopted)
+		err = -EBUSY;
+	else if (view->nr_dirty == HFS_DIRTY_PAGES_MAX)
+		err = -ENOSPC;
+	else {
+		/* Cancellation closes this same bit before its RPC. No cancellation
+		 * may certify no-effect concurrently with physical adoption.
+		 */
+		spin_lock(&dirty->reserve_ticket->admission_lock);
+		if (dirty->reserve_ticket->closed) {
+			err = -ECANCELED;
+			spin_unlock(&dirty->reserve_ticket->admission_lock);
+			goto unlock;
+		}
+		if (!entry->dirty_slot || !entry->page || !PageLocked(entry->page)) {
+			err = -EINVAL;
+			spin_unlock(&dirty->reserve_ticket->admission_lock);
+			goto unlock;
+		}
+		dirty->reserve_ticket->published = true;
+		spin_unlock(&dirty->reserve_ticket->admission_lock);
+		dirty->entry = entry;
+		dirty->adopted = true;
+		entry->dirty = dirty;
+		view->nr_dirty++;
+		list_add_tail(&dirty->list, &view->dirty);
+		hfs_view_page_get(entry); /* frozen obligation, independent of VMA */
+	}
+unlock:
+	spin_unlock_irqrestore(&view->lock, flags);
+	return err;
+}
+
+int hfs_view_page_lease(struct hfs_cache_page *entry, struct hfs_lease *lease)
+{
+	struct hfs_view *view = entry->view;
+	unsigned long flags;
+	int err = 0;
+
+	if (!lease || !lease->release_ticket)
+		return -EINVAL;
+	spin_lock_irqsave(&view->lock, flags);
+	if (view->phase != HFS_VIEW_LIVE || entry->revoking || entry->lease ||
+	    view->revision != entry->stamp.revision ||
+	    !uuid_equal(&view->generation, &entry->stamp.generation) ||
+	    !uuid_equal(&lease->visibility, &entry->stamp.generation) ||
+	    READ_ONCE(lease->revoked) || memcmp(view->target_hash, lease->target_hash, 32))
+		err = -ESTALE;
+	else
+		entry->lease = lease; /* complete preowned object; STOP shares this lock */
+	spin_unlock_irqrestore(&view->lock, flags);
+	return err;
+}
+
+int hfs_view_page_grant(struct hfs_cache_page *entry, struct hfs_cache_grant *grant,
+			 struct hfs_cache_page *from)
+{
+	struct hfs_view *view = entry->view;
+	unsigned long flags;
+	int err = 0;
+
+	if (!grant || !grant->lease || grant->lease->dirty || !grant->lease->release_ticket ||
+	    (from && (from->view != view || from->page || from->lease != grant->lease)))
+		return -EINVAL;
+	spin_lock_irqsave(&view->lock, flags);
+	if (view->phase != HFS_VIEW_LIVE || entry->revoking ||
+	    !uuid_equal(&view->generation, &entry->stamp.generation) ||
+	    view->revision != entry->stamp.revision ||
+	    memcmp(view->target_hash, grant->lease->target_hash, 32))
+		err = -ESTALE;
+	else if (view->nr_grants == HFS_CACHE_GRANTS_MAX)
+		err = -ENOSPC;
+	else {
+		list_add_tail(&grant->list, &entry->readers);
+		view->nr_grants++;
+		if (from)
+			from->lease = NULL; /* atomic with publication into the reader registry */
+	}
+	spin_unlock_irqrestore(&view->lock, flags);
+	return err;
+}
+
+int hfs_view_page_enter(struct vm_area_struct *vma, struct page *page,
+			bool write, void **cookie)
+{
+	struct hfs_view *view = hfs_view_get(HFS_S(file_inode(vma->vm_file)));
+	struct hfs_cache_page *entry;
+	struct hfs_cache_grant *grant;
+	struct hfs_description *description = vma->vm_file->private_data;
+	struct hfs_lease *lease;
+	struct hfs_view_stamp stamp;
+	unsigned long flags;
+	int err;
+
+	*cookie = NULL;
+	if (!view)
+		return -ESTALE;
+	if (!page) {
+		err = hfs_view_enter(view, NULL, true, cookie);
+		goto out;
+	}
+	/* Private anonymous COW is application data, not backing cache state. */
+	if (PageAnon(page)) {
+		/* Preserve application-owned COW data even while backing cache is
+		 * stopped/fenced. The cookie still pins the actual view/module
+		 * until the snapshotted end callback completes after any VMA loss.
+		 */
+		*cookie = (void *)((unsigned long)view | 1UL);
+		return 0; /* transfer this get() reference, without an active token */
+	}
+	if (PageCompound(page) || !PageHfsnogup(page)) {
+		err = -ESTALE;
+		goto out;
+	}
+	/* wp_page_copy's original page need not be locked. The registry, not
+	 * a lockless page->private dereference, protects metadata lifetime.
+	 */
+	err = -ESTALE;
+	spin_lock_irqsave(&view->lock, flags);
+	list_for_each_entry(entry, &view->cache, list) {
+		if (entry->page != page)
+			continue;
+		lease = NULL;
+		if (!description || !description->cap || entry->revoking)
+			break;
+		if (entry->lease && !memcmp(entry->lease->description, description->cap->token, 32))
+			lease = entry->lease;
+		if (!write && !lease)
+			list_for_each_entry(grant, &entry->readers, list)
+				if (!memcmp(grant->lease->description, description->cap->token, 32)) {
+					lease = grant->lease;
+					break;
+				}
+		if (lease && !READ_ONCE(lease->revoked) &&
+		    !memcmp(lease->target_hash, view->target_hash, 32) &&
+		    (!write || (lease == entry->lease && lease->dirty &&
+				entry->dirty && entry->dirty->adopted))) {
+			stamp = entry->stamp;
+			err = hfs_view_try_enter_locked(view, &stamp, cookie);
+			if (!err)
+				WRITE_ONCE(lease->published, true);
+		}
+		break;
+	}
+	spin_unlock_irqrestore(&view->lock, flags);
+out:
+	hfs_view_put(view);
+	return err;
+}
+
+static bool hfs_cache_frozen_detachable(struct hfs_cache_page *entry)
+{
+	return entry->dirty && entry->dirty->captured && entry->dirty->frozen &&
+		entry->view->quiescent && !entry->view->active &&
+		(entry->view->phase == HFS_VIEW_STOPPED ||
+		 entry->view->phase == HFS_VIEW_INSTALLED_DRAIN);
+}
+
+static int hfs_cache_launder(struct folio *folio)
+{
+	struct hfs_cache_page *entry = folio_get_private(folio);
+	struct hfs_view *view;
+	unsigned long flags;
+	bool detachable;
+
+	if (!entry)
+		return -EBUSY;
+	view = entry->view;
+	spin_lock_irqsave(&view->lock, flags);
+	detachable = hfs_cache_frozen_detachable(entry);
+	spin_unlock_irqrestore(&view->lock, flags);
+	if (!detachable)
+		return -EBUSY;
+	/* Not generic writeback: exact bytes/Claim and credits remain in the
+	 * complete frozen registry and protected DIRTY_FREEZE record. An
+	 * independent reserved drain still must obtain its exact terminal result.
+	 */
+	clear_page_dirty_for_io(&folio->page);
+	return 0;
+}
+
+static void hfs_cache_invalidate(struct folio *folio, size_t offset, size_t len)
+{
+	struct hfs_cache_page *entry = folio_get_private(folio);
+	struct hfs_view *view;
+	struct hfs_cache_grant *grant;
+	unsigned long flags;
+
+	if (!entry)
+		return;
+	view = entry->view;
+	spin_lock_irqsave(&view->lock, flags);
+	if (offset || len != PAGE_SIZE || folio_mapped(folio) ||
+	    PageWriteback(&folio->page) || folio_maybe_dma_pinned(folio) ||
+	    (entry->dirty && !entry->dirty->resolved && !hfs_cache_frozen_detachable(entry)) ||
+	    (view->active && entry->lease && READ_ONCE(entry->lease->published) &&
+	     (!folio->mapping || !mapping_exiting(folio->mapping)))) {
+		/* Dirty provenance owns its private page ref through truncation.
+		 * Unexpected invalidation fences instead of losing an obligation.
+		 */
+		view->phase = HFS_VIEW_FENCED;
+		spin_unlock_irqrestore(&view->lock, flags);
+		wake_up_all(&view->wait);
+		return;
+	}
+	entry->revoking = true;
+	if (entry->lease)
+		WRITE_ONCE(entry->lease->revoked, true);
+	list_for_each_entry(grant, &entry->readers, list)
+		WRITE_ONCE(grant->lease->revoked, true);
+	entry->page = NULL;
+	spin_unlock_irqrestore(&view->lock, flags);
+	folio_clear_uptodate(folio);
+	folio_detach_private(folio);
+	hfs_view_page_put(entry); /* private metadata ownership */
+	/* Keep NoGup until actual mapping detachment in free_folio. */
+}
+
+static bool hfs_cache_release(struct folio *folio, gfp_t gfp)
+{
+	struct hfs_cache_page *entry = folio_get_private(folio);
+
+	(void)gfp;
+	if (!entry)
+		return true;
+	if (folio_mapped(folio) ||
+	    (entry->dirty && !entry->dirty->resolved && !hfs_cache_frozen_detachable(entry)) ||
+	    READ_ONCE(entry->view->phase) < HFS_VIEW_QUIESCENT)
+		return false;
+	hfs_cache_invalidate(folio, 0, PAGE_SIZE);
+	return !folio_get_private(folio);
+}
+
+static void hfs_cache_free(struct folio *folio)
+{
+	/* filemap/vmscan call only after mapping detachment and PTE removal.
+	 * A speculative old fast-GUP reference still rechecks its old PTE;
+	 * clearing this flag cannot validate that now-removed PTE. No mapping
+	 * pointer is dereferenced by GUP, and this physical page is not reused
+	 * until the speculative reference is released.
+	 */
+	if (WARN_ON_ONCE(folio_mapped(folio)))
+		return;
+	if (folio_get_private(folio)) {
+		hfs_cache_invalidate(folio, 0, PAGE_SIZE);
+		if (folio_get_private(folio))
+			return; /* retained unresolved provenance still owns the page */
+	}
+	ClearPageHfsnogup(&folio->page);
+}
+
+static int hfs_cache_migrate(struct address_space *mapping,
+			     struct folio *dst, struct folio *src,
+			     enum migrate_mode mode)
+{
+	/* No generic migration can drop a provenance/NoGup flag or lease. */
+	(void)mapping;
+	(void)dst;
+	(void)src;
+	(void)mode;
+	return -EBUSY;
+}
+
+const struct address_space_operations hfs_cache_aops = {
+	/* All shared writable PTEs already own an adopted immutable obligation.
+	 * Track the real dirty bit without generic writeback tags/accounting or
+	 * replacement credentials. PTE removal can dirty again while RECALLING;
+	 * this atomic callback must not wait, allocate, RPC or require LIVE.
+	 */
+	.dirty_folio = noop_dirty_folio,
+	.launder_folio = hfs_cache_launder,
+	.invalidate_folio = hfs_cache_invalidate,
+	.release_folio = hfs_cache_release,
+	.free_folio = hfs_cache_free,
+	.migrate_folio = hfs_cache_migrate,
+};
diff --git a/fs/9p/hfs_lease.h b/fs/9p/hfs_lease.h
new file mode 100644
--- /dev/null
+++ b/fs/9p/hfs_lease.h
@@ -0,0 +1,121 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef FS_9P_HFS_LEASE_H
+#define FS_9P_HFS_LEASE_H
+
+#include <linux/list.h>
+#include <linux/kref.h>
+#include <linux/spinlock.h>
+#include <linux/mutex.h>
+#include <linux/wait.h>
+#include "hfs_protocol.h"
+
+struct hfs_session;
+struct hfs_cred;
+struct hfs_cap;
+struct hfs_cache_page;
+struct hfs_dirty;
+struct hfs_view;
+
+#define HFS_VIEW_TICKETS_MAX 256U
+#define HFS_VIEW_CONTROL_TICKETS_MAX 256U
+#define HFS_VIEW_FAMILIES_MAX 4096U
+#define HFS_DIRTY_PAGES_MAX 16U
+
+struct hfs_view_family {
+	struct mutex dispatch;
+	wait_queue_head_t wait;
+	struct hfs_view_ticket *initial;
+	struct hfs_retirement_cut *retirement_cut;
+	struct list_head list;
+	struct hfs_buf credentials;
+	u8 hash[32];
+	uuid_t nonce;
+	uuid_t anchor;
+	bool control;
+	u64 next;
+	u64 prepared; /* preowned finite counter slots, not wire identities */
+	u64 floor;
+	void *reservation;
+};
+
+struct hfs_view_ticket {
+	struct hfs_completion *completion;
+	/* Never take a view/session lock while holding this lock. */
+	spinlock_t admission_lock;
+	struct list_head list;
+	struct hfs_view_family *family;
+	struct hfs_session *session;
+	u32 users;
+	struct hfs_buf request;
+	struct hfs_buf payload;
+	struct hfs_buf query;
+	struct hfs_buf original;
+	struct hfs_token *scratch;
+	bool admitted;
+	struct hfs_json *response;
+	struct hfs_json *initial_response;
+	void *reservation;
+	u64 number;
+	u8 request_hash[32];
+	char operation[24];
+	bool control;
+	bool bound;
+	bool terminal;
+	bool uncertain;
+	bool closed;
+	bool published;
+};
+
+struct hfs_lease {
+	struct kref refs;
+	struct mutex release_lock;
+	bool released;
+	struct hfs_view_ticket *release_ticket;
+	struct hfs_buf release_payload;
+	struct hfs_json *json;
+	struct hfs_view_ticket *ticket;
+	struct hfs_cred *issuer;
+	bool published;
+	bool revoked; /* irreversible actual all-alias physical exclusion */
+	u8 id[32];
+	u8 target_hash[32];
+	u8 description[32];
+	uuid_t visibility;
+	u64 fence;
+	u64 revision;
+	bool dirty;
+};
+
+void hfs_view_ticket_put(struct hfs_view_ticket *ticket);
+int hfs_view_retire(struct hfs_session *session);
+bool hfs_view_tickets_busy(struct hfs_session *session);
+void hfs_view_tickets_destroy(struct hfs_session *session);
+int hfs_view_target(struct hfs_session *session, const struct hfs_json *json,
+		    int token, uuid_t *visibility, u8 target_hash[32]);
+int hfs_json_hash_fields(const struct hfs_json *json, int object,
+			 const char *fields, u8 digest[32]);
+int hfs_view_ticket_prepare(struct hfs_session *session, const struct hfs_cred *cred,
+			    bool control, struct hfs_view_ticket **out);
+int hfs_view_ticket_activate(struct hfs_view_ticket *ticket);
+int hfs_view_query(struct hfs_session *session, struct hfs_view_ticket *ticket,
+		    bool cancel, struct hfs_json **response);
+int hfs_view_exchange(struct hfs_session *session, struct hfs_view_ticket *ticket,
+		      const char *operation, const struct hfs_buf *payload,
+		      struct hfs_json **response);
+int hfs_lease_acquire(struct hfs_session *session, const struct hfs_cred *cred,
+		      const struct hfs_cap *object, const struct hfs_cap *description,
+		      u64 offset, bool dirty, const struct hfs_buf *expected_target,
+		      struct hfs_lease **out);
+int hfs_lease_release(struct hfs_session *session, struct hfs_lease *lease);
+void hfs_lease_get(struct hfs_lease *lease);
+void hfs_lease_free(struct hfs_lease *lease);
