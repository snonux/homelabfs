+
+/* Physical state, distinct from authority/journal/publication verification. */
+enum hfs_view_phase {
+	HFS_VIEW_UNBOUND, /* no target, observations, cache or PTE authority */
+	HFS_VIEW_LIVE,
+	HFS_VIEW_RECALLING,
+	HFS_VIEW_QUIESCENT,
+	HFS_VIEW_STOPPED,
+	HFS_VIEW_INSTALLED_DRAIN,
+	HFS_VIEW_DRAINED,
+	HFS_VIEW_FINAL,
+	HFS_VIEW_FENCED,
+};
+
+#define HFS_MMAP_EVENTS_MAX 3U
+
+struct hfs_mmap_control;
+
+/* A background pressure pass may hold for in-flight observations this long
+ * (p84, hfs_mmap_pressure). Ordinary requests finish in milliseconds and a
+ * scoped clean recall well within a second, so five seconds covers a slow
+ * in-flight request while leaving 25 s of the guest's 30 s acquisition and
+ * transport window for the held release, its recall and a retried
+ * acquisition.
+ */
+#define HFS_PRESSURE_HOLD_MS 5000
+
+/* A waiting hfs_view_enter gives up after this long with -ETIMEDOUT (1a4,
+ * zq3-r11 R11-2). Before 1a4 the wait had no time bound: a recall the host
+ * never completes (r11's stayed in WAIT_DRAINED for about nine minutes) left
+ * every getattr, stat and lookup of that mount, and umount(8)'s own stat of
+ * the mount point, in D state until the guest was powered off. A clean
+ * recall takes well under a second, so the bound only fires on a recall that
+ * is stuck. It is the same 30 s as the guest's request window and the x84
+ * allocation-fence wait (HFS_ALLOCATION_WAIT_MS in hfs.h): a waiter gets the
+ * same bound as any other exchange of that mount.
+ *
+ * It is one of several 30 s windows a syscall can pay in sequence. A getattr
+ * can wait here (30 s), then for its observation's VIEW_ACQUIRE exchange
+ * (hfs_view_exchange, 30 s), then for another request's pending ALLOCATE
+ * (30 s) and its own request window (30 s): about 90-120 s in the worst
+ * case. read()/write() into an hfs MAP_SHARED buffer pays more, since the
+ * fault inside its observation pays another view wait and its exchanges.
+ *
+ * ie4: hfs_mmap_begin's retries after a failed observation re-check
+ * (hfs_view_enter_until) share the deadline of its first view wait, so the
+ * re-check adds no further 30 s window; a retry that needs a fresh
+ * VIEW_ACQUIRE still pays that exchange's own bound. hfs_attr_install's
+ * re-check of a cache observation (hfs_attr_restamp) waits its own 30 s,
+ * since it has no handle on the observation's deadline, and a GETATTR or
+ * LOOKUP whose view target moved is re-issued (hfs_reissue) only while a
+ * further 30 s deadline from the syscall's start has not passed; each
+ * re-issue pays the windows above again.
+ *
+ * re4: a host BLOCKED answer to the observation's VIEW_ACQUIRE is retried
+ * within that same deadline too, at most three times and only after a
+ * VIEW_RETIRE round or the held lease's release made progress
+ * (hfs_mmap_blocked_backoff), so it adds no window either; the held release,
+ * each retry's VIEW_ACQUIRE and VIEW_RETIRE still pay their own bounds.
+ */
+#define HFS_VIEW_ENTER_WAIT_MS 30000U
+/* re4 review: the least gap between two VIEW_RETIRE rounds that observations
+ * kick while a refusal persists (e.g. a long-held lease of the same
+ * credentials), so a busy mount does not send one round per syscall
+ * (hfs_mmap_retire_kick; a recall's REOPENED kick is not limited).
+ */
+#define HFS_RETIRE_KICK_MS 1000U
+
+struct hfs_view {
+	struct hfs_mmap_control *control;
+	struct kref refs;
+	/* Phase, inventory, cache metadata and admitted-token count. */
+	spinlock_t lock;
+	/* Exclusive ownership of stop/install/reopen workspaces. */
+	struct mutex transitions;
+	wait_queue_head_t wait;
+	struct list_head mappings;
+	/* wj4: the inodes with hfs_inode.view_mmapped (view_mmap_list), so
+	 * hfs_view_unmark_idle_locked visits nr_mmapped inodes, not every
+	 * registered one (up to HFS_IDENTITIES_MAX).
+	 */
+	struct list_head mmapped;
+	struct list_head cache;
+	struct list_head dirty;
+	struct list_head observations;
+	u32 nr_observations;
+	/* A background pressure pass is being held for in-flight observations
+	 * since pressure_held_since (jiffies). Cleared when nr_observations
+	 * reaches zero or the bounded hold releases (hfs_mmap_pressure).
+	 */
+	bool pressure_holding;
+	unsigned long pressure_held_since;
+	u32 nr_dirty;
+	u32 nr_dirty_packages;
+	u32 nr_grants;
+	struct hfs_session *session;
+	struct inode **stopping;
+	struct page **stopping_pages;
+	struct hfs_view_family **retiring;
+	struct hfs_buf retire_payload;
+	/* re4: the last hfs_view_retire pass saw a BLOCKED VIEW_RETIRE. Written
+	 * under session->retirement; hfs_mmap_retire_kick re-sends it after a
+	 * recall's REOPENED and on the next observation (at most once a second).
+	 */
+	bool retire_blocked;
+	/* re4 final review: counts floor advances of any hfs_view_retire pass
+	 * (incremented under session->retirement and session->lock, read with
+	 * READ_ONCE); a BLOCKED observation retries when it changed. 1h4: each
+	 * advance wakes view->wait.
+	 */
+	unsigned long retire_progress;
+	/* 1h4 (zq3-r19 R19-1): counts releases of session->retirement by any
+	 * holder: a view retirement round (hfs_view_retire_mode), ordinary
+	 * request retirement (hfs_retire) and session destruction
+	 * (hfs_session_destroy). Every holder releases the mutex through
+	 * hfs_retirement_unlock, which increments this only after the unlock
+	 * and then wakes view->wait (review rounds 1 and 2: a round that
+	 * counted before its unlock, or a holder that did not count at all, let
+	 * a waiter sleep to its 30 s deadline). A BLOCKED observation reads it
+	 * before its hfs_view_retire_try. When that try finds the mutex held,
+	 * the holder has not unlocked, so has not counted yet, and its count
+	 * changes the value the observation waits on (hfs_view_retire_wait),
+	 * provided the holder releases through hfs_retirement_unlock and this
+	 * view is still session->view then. A mutex_unlock of
+	 * session->retirement elsewhere would be missed; the observation's
+	 * bounded wait slice (HFS_RETIRE_BUSY_SLICE_MS, hfs_mmap.c) limits
+	 * that to one slice. Atomic because the counts run outside the mutex.
+	 */
+	atomic_long_t retirement_releases;
+	/* 2f4 (zq3-r17 R17-1): counts accepted REOPENED ACKs, i.e. raises of
+	 * the mount's current_fence (hfs_view_reopen_acked, after
+	 * hfs_controlled_after_ack). Incremented under view->lock, read with
+	 * READ_ONCE; a VIEW_ACQUIRE whose GRANTED reply crossed this mount's
+	 * own REOPEN -> REOPENED ACK window waits for it to change
+	 * (hfs_view_reopen_wait) before it queries the ticket again.
+	 */
+	unsigned long reopen_acks;
+	struct hfs_buf manifest;
+	u8 manifest_hash[32];
+	struct hfs_buf target;
+	u8 target_hash[32];
+	void *reservation;
+	uuid_t generation;
+	uuid_t recall;
+	/* Raised under view->lock by every target install, REOPEN and (xf4)
+	 * adopted advance (hfs_view_advance), so a stamp taken before any of
+	 * them fails its re-check.
+	 */
+	u64 revision;
+	u64 sequence;
+	u32 active;
+	/* Registered inodes (view->mappings): the STOP/recall inventory. */
+	u32 nr_mappings;
+	/* tj4: those of them that were mmapped (hfs_inode.view_mmapped; wj4:
+	 * and still have a VMA or a page-cache page, see
+	 * hfs_view_unmark_idle_locked). The xf4 cacheless test counts these,
+	 * not nr_mappings: the mount root and every looked-up inode are
+	 * registered without holding any target-bound state
+	 * (hfs_view_cacheless_locked).
+	 */
+	u32 nr_mmapped;
+	u32 nr_cached;
+	bool quiescent;
+	enum hfs_view_phase phase;
+};
+
+/* A stamp is local physical-cache state; it is never a normal certificate. */
+struct hfs_view_stamp {
+	uuid_t generation;
+	u64 revision;
+};
+
+/* Every API taking view requires a get/put reference, including parked calls. */
+struct hfs_view *hfs_view_get(struct hfs_session *session);
+void hfs_view_put(struct hfs_view *view);
+#define HFS_CACHE_PAGES_MAX 128U
+#define HFS_TARGET_MAX 8192U
+#define HFS_CACHE_GRANTS_MAX 256U
+
+struct hfs_observation {
+	struct list_head list;
+	struct hfs_view *view;
+	struct hfs_lease *lease;
+	struct hfs_view_stamp stamp;
+	struct hfs_buf target;
+	void *native_cookie;
+	void *cleanup;
+};
+
+struct hfs_cache_grant {
+	struct list_head list;
+	struct hfs_lease *lease;
+	void *reservation;
+};
+
+struct hfs_cache_page {
+	struct kref refs;
+	struct list_head list;
+	struct hfs_view *view;
+	struct hfs_view_stamp stamp;
+	struct hfs_buf target;
+	struct hfs_lease *lease;
+	struct list_head readers;
+	struct page *page;
+	void *reservation;
+	struct hfs_dirty *dirty;
+	bool revoking;
+	bool dirty_slot;
+	void *cleanup;
+	u8 fill[4096];
+	u32 fill_length;
+	/* Resource disposal may queue work; never RPC or wait under page lock. */
+	void (*dispose)(struct hfs_cache_page *entry);
+};
+
+struct hfs_dirty {
+	struct list_head list;
+	struct hfs_cache_page *entry;
+	struct hfs_json *reservation;
+	struct hfs_json *frozen_entry;
+	struct hfs_view_ticket *reserve_ticket;
+	struct hfs_view_ticket *freeze_ticket;
+	struct hfs_request *request;
+	struct hfs_buf freeze_payload;
+	struct hfs_buf drain_args;
+	void *credit;
+	u8 id[32];
+	u8 entry_id[32];
+	uuid_t home;
+	uuid_t allocation;
+	u8 data[4096];
+	u64 offset;
+	u32 length;
+	uuid_t recall;
+	bool captured;
+	bool adopted;
+	bool frozen;
+	bool resolved;
+};
+
+int hfs_view_dirty_slot(struct hfs_cache_page *entry);
+void hfs_view_dirty_unslot(struct hfs_cache_page *entry);
+int hfs_view_adopt_dirty(struct hfs_view *view, struct hfs_cache_page *entry,
+			 struct hfs_dirty *dirty);
+struct hfs_cache_page *hfs_view_page_find(struct hfs_view *view, struct page *page);
+
+int hfs_view_page_lease(struct hfs_cache_page *entry, struct hfs_lease *lease);
+int hfs_view_page_grant(struct hfs_cache_page *entry, struct hfs_cache_grant *grant,
+			 struct hfs_cache_page *from);
+int hfs_view_page_prepare(struct hfs_view *view,
+			  const struct hfs_view_stamp *stamp,
+			  struct hfs_cache_page **out);
+int hfs_view_page_attach(struct hfs_cache_page *entry, struct page *page);
+void hfs_view_page_get(struct hfs_cache_page *entry);
+void hfs_view_page_put(struct hfs_cache_page *entry);
+void hfs_view_page_discard(struct hfs_cache_page *entry);
+int hfs_view_page_enter(struct vm_area_struct *vma, struct page *page,
+			bool write, void **cookie);
+extern const struct address_space_operations hfs_cache_aops;
+
+int hfs_view_new_unbound(struct hfs_session *session);
+int hfs_view_new(struct hfs_session *session, const uuid_t *generation);
+int hfs_view_free(struct hfs_session *session);
+int hfs_view_register_inode(struct inode *inode);
+int hfs_view_mmap_inode(struct inode *inode);
+void hfs_view_vma_open(struct inode *inode);
+void hfs_view_vma_close(struct inode *inode);
+void hfs_view_unregister_inode(struct inode *inode);
+int hfs_view_bind_initial(struct hfs_view *view, const struct hfs_lease *lease);
+int hfs_view_capture(struct hfs_view *view, struct hfs_view_stamp *stamp,
+		     struct hfs_buf *target);
+int hfs_view_capture_ex(struct hfs_view *view, struct hfs_view_stamp *stamp,
+			struct hfs_buf *target, bool *cacheless);
+int hfs_view_advance(struct hfs_view *view, struct hfs_lease *lease,
+		     struct hfs_view_stamp *stamp, struct hfs_buf *target,
+		     unsigned long deadline);
+int hfs_view_snapshot(struct hfs_view *view, struct hfs_view_stamp *stamp);
+int hfs_view_snapshot_target(struct hfs_view *view, struct hfs_view_stamp *stamp,
+			     u8 *target_hash);
+bool hfs_view_refused(const struct hfs_view *view);
+int hfs_view_enter(struct hfs_view *view, const struct hfs_view_stamp *stamp,
+		   bool wait, void **cookie);
+int hfs_view_enter_until(struct hfs_view *view, const struct hfs_view_stamp *stamp,
+			 bool wait, unsigned long deadline, void **cookie);
+const char *hfs_view_phase_name(enum hfs_view_phase phase);
+void hfs_view_reopen_acked(struct hfs_view *view);
+int hfs_view_reopen_wait(struct hfs_view *view, unsigned long acks,
+			 unsigned long deadline);
+void hfs_retirement_unlock(struct hfs_session *session);
+int hfs_view_retire_wait(struct hfs_view *view, long releases,
+			 unsigned long progress, unsigned long deadline);
+void hfs_view_leave(void *cookie);
+int hfs_view_stop(struct hfs_view *view, const uuid_t *generation,
+		  const uuid_t *recall, u64 sequence);
+/* Caller has installed/verified the final target and resolved every old
+ * cache/dirty obligation before transitioning to FINAL. This closes the local
+ * epoch even when the visibility UUID is unchanged by the host mutation.
+ */
+void hfs_mmap_progress(struct hfs_session *session);
+void hfs_mmap_settle(struct hfs_session *session);
+int hfs_mmap_begin(struct inode *inode, bool mutation, const struct hfs_cred *cred,
+		    void *native_cookie, void **cookie);
+void hfs_mmap_end(void *cookie);
+int hfs_mmap_bootstrap(struct hfs_session *session, const struct hfs_cred *cred);
+int hfs_mmap_file(struct file *file, struct vm_area_struct *vma);
+int hfs_mmap_sync(struct file *file);
+int hfs_mmap_start(struct hfs_view *view);
+int hfs_mmap_prepare_retire(struct hfs_view *view);
+int hfs_mmap_terminal_prepare(struct hfs_view *view);
+int hfs_mmap_stop(struct hfs_view *view);
+int hfs_mmap_install(struct hfs_view *view, const struct hfs_json *event,
+		     int target, const uuid_t *recall, u64 sequence, bool final);
+int hfs_view_seal(struct hfs_view *view);
+int hfs_view_reopen(struct hfs_view *view, const uuid_t *recall, u64 sequence);
+void hfs_view_fence(struct hfs_view *view);
+
+#endif
diff --git a/fs/9p/hfs_view.c b/fs/9p/hfs_view.c
new file mode 100644
--- /dev/null
+++ b/fs/9p/hfs_view.c
@@ -0,0 +1,1645 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Physical retained-cache admission and all-alias PTE/TLB/MMU quiescence. */
+#include <linux/mm.h>
+#include <linux/pagemap.h>
+#include <linux/slab.h>
+#include <linux/vmalloc.h>
+#include <linux/migrate.h>
+#include <linux/writeback.h>
+#include "hfs.h"
+#include "hfs_view.h"
+
+/* The last reference: nothing may still count against the view. wj4:
+ * nr_mmapped too, as a tripwire; it is bounded by nr_mappings (both drop in
+ * hfs_view_unregister_inode), so it can only fire with that count broken.
+ */
+static void hfs_view_release(struct kref *refs)
+{
+	struct hfs_view *view = container_of(refs, struct hfs_view, refs);
+
+	WARN_ON_ONCE(view->control || view->active || view->nr_mappings ||
+		     view->nr_mmapped || view->nr_cached || view->nr_dirty ||
+		     view->nr_dirty_packages || view->nr_grants ||
+		     view->nr_observations);
+	hfs_buf_free(&view->target);
+	hfs_buf_free(&view->manifest);
+	hfs_buf_free(&view->retire_payload);
+	kvfree(view->retiring);
+	kvfree(view->stopping_pages);
+	kvfree(view->stopping);
+	view->session->provider->unreserve(view->session, view->reservation);
+	kfree(view);
+}
+
+struct hfs_view *hfs_view_get(struct hfs_session *session)
+{
+	struct hfs_view *view;
+
+	/* The caller owns a VFS file/superblock or controller session lifetime. */
+	mutex_lock(&session->lock);
+	view = session->view;
+	if (view && try_module_get(THIS_MODULE))
+		kref_get(&view->refs);
+	else
+		view = NULL;
+	mutex_unlock(&session->lock);
+	return view;
+}
+
+void hfs_view_put(struct hfs_view *view)
+{
+	if (!view)
+		return;
+	kref_put(&view->refs, hfs_view_release);
+	module_put(THIS_MODULE);
+}
+
+static int hfs_view_create(struct hfs_session *session, const uuid_t *generation, bool unbound)
+{
+	struct hfs_view *view;
+	void *reservation;
+	int err;
+
+	if (!generation || (!unbound && uuid_is_null(generation)) || session->view)
+		return -EINVAL;
+	err = session->provider->reserve(session, sizeof(*view) +
+			HFS_IDENTITIES_MAX * sizeof(struct inode *) +
+			HFS_CACHE_PAGES_MAX * sizeof(struct page *) +
+			HFS_VIEW_FAMILIES_MAX * sizeof(struct hfs_view_family *) +
+			HFS_VIEW_BODY_MAX + HFS_BODY_MAX + HFS_TARGET_MAX, true,
+			&reservation);
+	if (err)
+		return err;
+	view = kzalloc(sizeof(*view), GFP_KERNEL);
+	if (!view) {
+		session->provider->unreserve(session, reservation);
+		return -ENOMEM;
+	}
+	view->stopping = kvcalloc(HFS_IDENTITIES_MAX, sizeof(struct inode *),
+				  GFP_KERNEL);
+	if (!view->stopping) {
+		session->provider->unreserve(session, reservation);
+		kfree(view);
+		return -ENOMEM;
+	}
+	view->stopping_pages = kvcalloc(HFS_CACHE_PAGES_MAX,
+					sizeof(struct page *), GFP_KERNEL);
+	if (!view->stopping_pages) {
+		kvfree(view->stopping);
+		session->provider->unreserve(session, reservation);
+		kfree(view);
+		return -ENOMEM;
+	}
+	view->retiring = kvcalloc(HFS_VIEW_FAMILIES_MAX,
+				 sizeof(struct hfs_view_family *), GFP_KERNEL);
+	if (!view->retiring || hfs_buf_init(&view->retire_payload, HFS_VIEW_BODY_MAX) ||
+	    hfs_buf_init(&view->target, HFS_TARGET_MAX) ||
+	    hfs_buf_init(&view->manifest, HFS_BODY_MAX)) {
+		hfs_buf_free(&view->retire_payload);
+		hfs_buf_free(&view->target);
+		hfs_buf_free(&view->manifest);
+		kvfree(view->retiring);
+		kvfree(view->stopping_pages);
+		kvfree(view->stopping);
+		session->provider->unreserve(session, reservation);
+		kfree(view);
+		return -ENOMEM;
+	}
+	kref_init(&view->refs);
+	spin_lock_init(&view->lock);
+	mutex_init(&view->transitions);
+	init_waitqueue_head(&view->wait);
+	INIT_LIST_HEAD(&view->mappings);
+	INIT_LIST_HEAD(&view->mmapped);
+	INIT_LIST_HEAD(&view->cache);
+	INIT_LIST_HEAD(&view->dirty);
+	INIT_LIST_HEAD(&view->observations);
+	view->session = session;
+	view->reservation = reservation;
+	view->generation = *generation;
+	view->revision = 1;
+	view->phase = unbound ? HFS_VIEW_UNBOUND : HFS_VIEW_LIVE;
+	session->view = view;
+	return 0;
+}
+
+int hfs_view_new(struct hfs_session *session, const uuid_t *generation)
+{
+	return hfs_view_create(session, generation, false);
+}
+
+int hfs_view_new_unbound(struct hfs_session *session)
+{
+	uuid_t none = {};
+
+	return hfs_view_create(session, &none, true);
+}
+
+int hfs_view_free(struct hfs_session *session)
+{
+	struct hfs_view *view;
+	int err = 0;
+
+	mutex_lock(&session->lock);
+	view = session->view;
+	if (!view)
+		goto out;
+	/* get() and owner removal are serialized; parked callers retain refs. */
+	if (view->control || view->phase != HFS_VIEW_FENCED || view->active ||
+	    view->nr_mappings || view->nr_cached || view->nr_dirty || view->nr_observations ||
+	    refcount_read(&view->refs.refcount) != 1) {
+		err = -EBUSY;
+		goto out;
+	}
+	session->view = NULL;
+	mutex_unlock(&session->lock);
+	kref_put(&view->refs, hfs_view_release);
+	return 0;
+out:
+	mutex_unlock(&session->lock);
+	return err;
+}
+
+/* Caller holds view->lock: put object on the STOP/recall inventory
+ * (view->mappings) unless it is already there. A new registration needs a
+ * LIVE view with room; an existing one stays valid in any phase.
+ */
+static int hfs_view_link_locked(struct hfs_view *view, struct hfs_inode *object)
+{
+	if (!list_empty(&object->view_list))
+		return 0;
+	if (view->phase != HFS_VIEW_LIVE)
+		return -EAGAIN;
+	if (view->nr_mappings == HFS_IDENTITIES_MAX)
+		return -ENOSPC;
+	list_add_tail(&object->view_list, &view->mappings);
+	view->nr_mappings++;
+	return 0;
+}
+
+/* Register inode with its session's view. tj4: mmapped also marks it as
+ * mapped (view_mmapped, view->nr_mmapped, view->mmapped) in the same
+ * critical section, so a concurrent hfs_view_advance either sees the mark
+ * in its re-check and refuses, or switched the target before this mapping
+ * exists. wj4: a successful mmapped registration also counts the new VMA
+ * (view_vmas) there; hfs_mmap_file installs hfs_mmap_ops, whose ->close
+ * gives it back, only after that success. This is the only step that
+ * takes view_vmas from 0 to 1 (->open copies a live VMA), and it holds
+ * view->lock, so hfs_view_unmark_idle_locked cannot drop a mark whose new
+ * VMA it did not see. The mark is only set on a registered inode and is
+ * cleared, with the count, only under view->lock, so nr_mmapped <=
+ * nr_mappings and no path can unbalance it.
+ */
+static int hfs_view_register(struct inode *inode, bool mmapped)
+{
+	struct hfs_view *view = hfs_view_get(HFS_S(inode));
+	struct hfs_inode *object = HFS_I(inode);
+	unsigned long flags;
+	int err;
+
+	if (!view)
+		return -ESTALE;
+	spin_lock_irqsave(&view->lock, flags);
+	err = hfs_view_link_locked(view, object);
+	if (!err && mmapped) {
+		atomic_inc(&object->view_vmas);
+		if (!object->view_mmapped) {
+			object->view_mmapped = true;
+			list_add_tail(&object->view_mmap_list, &view->mmapped);
+			view->nr_mmapped++;
+		}
+	}
+	spin_unlock_irqrestore(&view->lock, flags);
+	hfs_view_put(view);
+	return err;
+}
+
+/* Every inode of a bridge session (hfs_inode_get): inventory only. */
+int hfs_view_register_inode(struct inode *inode)
+{
+	return hfs_view_register(inode, false);
+}
+
+/* tj4: hfs_mmap_file, before it installs hfs_mmap_ops. Only a mapped inode
+ * can fault pages into the view cache, carry PTEs or take PAGE grants, so
+ * only it makes the view non-cacheless. wj4: the mark now lasts while the
+ * inode has a VMA or a page-cache page (hfs_view_unmark_idle_locked), not
+ * until eviction. Each success counts one VMA, so hfs_mmap_file must
+ * install hfs_mmap_ops (and so ->close) exactly when this returns 0.
+ */
+int hfs_view_mmap_inode(struct inode *inode)
+{
+	return hfs_view_register(inode, true);
+}
+
+/* wj4: hfs_mmap_ops->open, for a copy of a live hfs VMA: dup_mmap (fork),
+ * __split_vma and copy_vma (mremap). The source VMA still counts, so
+ * view_vmas is >= 1 and this never makes a cleared mark stale; no lock is
+ * needed, and none is taken: ->open and ->close run under mmap_lock
+ * (write, or read after munmap's downgrade, or exit_mmap), and keeping
+ * them lock-free adds no mmap_lock -> view lock order at all.
+ */
+void hfs_view_vma_open(struct inode *inode)
+{
+	atomic_inc(&HFS_I(inode)->view_vmas);
+}
+
+/* wj4: hfs_mmap_ops->close (remove_vma, and the failure paths of
+ * __split_vma and of copy_vma's vma_link (out_vma_link), each balancing
+ * that copy's own ->open; vma_close calls it at most once per VMA). The
+ * VMA's PTEs are gone by then (unmap_region before remove_vma; a failed
+ * copy was never linked), and no fault can still run on it (it left, or
+ * never entered, the mm's tree under mmap_write_lock). Release ordering: a
+ * view_vmas of 0 read with acquire in hfs_view_unmark_idle_locked also
+ * shows that VMA's page-cache insertions in i_mapping->nrpages. A negative
+ * count is a pairing bug; it never reads as 0, so the mark stays (the safe
+ * side) and the warning reports it.
+ */
+void hfs_view_vma_close(struct inode *inode)
+{
+	WARN_ON_ONCE(atomic_dec_return_release(&HFS_I(inode)->view_vmas) < 0);
+}
+
+/* Caller holds view->lock: object leaves the mmapped count (view->mmapped,
+ * nr_mmapped) if it is marked.
+ */
+static void hfs_view_unmark_locked(struct hfs_view *view, struct hfs_inode *object)
+{
+	if (!object->view_mmapped)
+		return;
+	object->view_mmapped = false;
+	list_del_init(&object->view_mmap_list);
+	view->nr_mmapped--;
+}
+
+/* wj4: caller holds view->lock. Drop the mark of every mmapped inode that
+ * can no longer hold target-bound state: no VMA with hfs_mmap_ops is left
+ * (view_vmas == 0, so no PTE and no fault can add a page) and its page
+ * cache is empty (nrpages == 0). A page left behind after munmap keeps the
+ * mark until it leaves the cache (truncate, reclaim, a recall), however
+ * it is accounted otherwise: the tj4 argument that a never-mmapped inode
+ * holds no target-bound state rests on its page cache being empty, so an
+ * unmarked inode must look exactly like that. hfs_cache_aops has no
+ * read_folio, readahead, splice or direct_IO, so the hfs_mmap_ops fault
+ * path is the only page-cache insertion, and it needs a VMA. A new VMA
+ * comes only from hfs_view_mmap_inode, which re-marks the inode under
+ * this lock, so a mark dropped here is never stale for an advance that
+ * re-checks in the same critical section.
+ */
+static void hfs_view_unmark_idle_locked(struct hfs_view *view)
+{
+	struct hfs_inode *object, *next;
+
+	list_for_each_entry_safe(object, next, &view->mmapped, view_mmap_list) {
+		if (atomic_read_acquire(&object->view_vmas) ||
+		    READ_ONCE(object->inode.i_mapping->nrpages))
+			continue;
+		hfs_view_unmark_locked(view, object);
+	}
+}
+
+/* Eviction: leave the inventory and, if it is still marked, the mmapped
+ * count. A live VMA pins its file and so its inode, so a mapped inode only
+ * gets here once no mapping of it remains.
+ */
+void hfs_view_unregister_inode(struct inode *inode)
+{
+	struct hfs_view *view = hfs_view_get(HFS_S(inode));
+	struct hfs_inode *object = HFS_I(inode);
+	unsigned long flags;
+
+	if (!view)
+		return;
+	spin_lock_irqsave(&view->lock, flags);
+	if (!list_empty(&object->view_list)) {
+		list_del_init(&object->view_list);
+		view->nr_mappings--;
+		hfs_view_unmark_locked(view, object);
+	}
+	spin_unlock_irqrestore(&view->lock, flags);
+	hfs_view_put(view);
+}
+
+int hfs_view_bind_initial(struct hfs_view *view, const struct hfs_lease *lease)
+{
+	unsigned long flags;
+	int token = hfs_json_field(lease->json, 0, "target");
+	u32 len;
+	int err = 0;
+
+	if (token < 0)
+		return -EPROTO;
+	if (lease->unadopted)
+		return -ESTALE; /* 2f4: release only, never the initial cut */
+	len = lease->json->tokens[token].end - lease->json->tokens[token].start;
+	if (len > HFS_TARGET_MAX)
+		return -EPROTO;
+	mutex_lock(&view->transitions);
+	spin_lock_irqsave(&view->lock, flags);
+	if (view->phase == HFS_VIEW_LIVE && view->target.len) {
+		/* An initial target:null acquire may first require a verified empty
+		 * all-domain recall. It must name the actual already installed cut.
+		 */
+		err = uuid_equal(&view->generation, &lease->visibility) &&
+			!memcmp(view->target_hash, lease->target_hash, 32) ? 0 : -ESTALE;
+	} else if ((view->phase != HFS_VIEW_UNBOUND && view->phase != HFS_VIEW_LIVE) ||
+		   view->target.len || view->active || view->nr_mappings || view->nr_cached ||
+		   (view->phase == HFS_VIEW_LIVE &&
+		    !uuid_equal(&view->generation, &lease->visibility))) {
+		err = -ESTALE;
+	} else {
+		hfs_buf_add(&view->target, lease->json->data +
+			    lease->json->tokens[token].start, len);
+		memcpy(view->target_hash, lease->target_hash, 32);
+		view->generation = lease->visibility;
+		view->phase = HFS_VIEW_LIVE;
+		err = view->target.error;
+	}
+	spin_unlock_irqrestore(&view->lock, flags);
+	mutex_unlock(&view->transitions);
+	return err;
+}
+
+/* xf4: the view holds no target-bound state, under view->lock: no cached
+ * page (the mmap page cache), no mmapped inode, no dirty page or dirty
+ * package (DIRTY_RESERVE reservations), no PAGE grant, no admitted physical
+ * token and no published observation. Such a view can adopt a newer cut
+ * without a recall: a recall's guest-side effect on it is only "target :=
+ * current cut, revision++" (docs/design/xf4-view-advance.md). Attributes and
+ * dentries are not view state (refreshed per permission check; dentries
+ * revalidate through an observation). view->reservation is the view's own
+ * memory credit, not a dirty reservation, so it does not count.
+ *
+ * tj4 (zq3-r20): registered inodes (view->mappings, nr_mappings) are not
+ * counted, only mmapped ones (nr_mmapped). hfs_inode_get registers every
+ * inode, so the mount root alone kept every live view non-cacheless and
+ * advance was never sent. A registered, never-mmapped inode holds nothing
+ * bound to the target: read_iter/write_iter go over the bridge (hfs_io),
+ * hfs_cache_aops has no read_folio, and the only page-cache insertion,
+ * PTE and PAGE grant come from the hfs_mmap_ops fault path, which
+ * hfs_mmap_file installs only after hfs_view_mmap_inode marked the inode.
+ * view->mappings stays the STOP/recall inventory, exactly as before.
+ *
+ * wj4: an inode whose VMAs have all closed and whose page cache is empty
+ * is back in that never-mmapped state, so its mark is dropped here, in
+ * the same critical section as the test (hfs_view_unmark_idle_locked);
+ * only when everything else is already clean, so a busy view pays no walk.
+ * Otherwise one exec or shared library mapped from the mount would
+ * withhold advance for as long as its inode stays cached.
+ */
+static bool hfs_view_cacheless_locked(struct hfs_view *view)
+{
+	if (view->nr_cached || view->nr_dirty || view->nr_dirty_packages ||
+	    view->nr_grants || view->active || view->nr_observations ||
+	    !list_empty(&view->cache) || !list_empty(&view->dirty))
+		return false;
+	if (view->nr_mmapped)
+		hfs_view_unmark_idle_locked(view);
+	return !view->nr_mmapped;
+}
+
+/* The stamp and installed target of a LIVE view. xf4: *cacheless (when not
+ * NULL) is hfs_view_cacheless_locked in the same critical section: the hint
+ * hfs_mmap_observe needs to request an advance. It is only a hint;
+ * hfs_view_advance checks it again before adopting.
+ */
+int hfs_view_capture_ex(struct hfs_view *view, struct hfs_view_stamp *stamp,
+			struct hfs_buf *target, bool *cacheless)
+{
+	unsigned long flags;
+	int err = 0;
+
+	if (cacheless)
+		*cacheless = false;
+	spin_lock_irqsave(&view->lock, flags);
+	if (view->phase != HFS_VIEW_LIVE || !view->target.len) {
+		err = -EAGAIN;
+	} else if (target->cap < view->target.len) {
+		err = -ENOSPC;
+	} else {
+		target->len = 0;
+		target->error = 0;
+		hfs_buf_add(target, view->target.data, view->target.len);
+		stamp->generation = view->generation;
+		stamp->revision = view->revision;
+		err = target->error;
+		if (!err && cacheless)
+			*cacheless = hfs_view_cacheless_locked(view);
+	}
+	spin_unlock_irqrestore(&view->lock, flags);
+	return err;
+}
+
+int hfs_view_capture(struct hfs_view *view, struct hfs_view_stamp *stamp,
+		     struct hfs_buf *target)
+{
+	return hfs_view_capture_ex(view, stamp, target, NULL);
+}
+
+/* xf4: may the view adopt lease's target now (view->lock held)? It is still
+ * the LIVE, unrefused view of the capture (stamp: revision and generation;
+ * target: the captured expected target, still installed), holds no
+ * target-bound state (hfs_view_cacheless_locked, our own unpublished
+ * observation not counted), and the candidate keeps the visibility
+ * generation (hash: the target hash hfs_view_advance_target computed).
+ * tj4: that includes nr_mmapped. hfs_mmap_file marks an inode under this
+ * same lock before it installs hfs_mmap_ops, so an mmap racing the
+ * adoption is either seen here (refused, -EXDEV) or created after the
+ * switch, its faults then stamped with the new revision and target.
+ * wj4: the re-check may drop idle marks (hfs_view_unmark_idle_locked),
+ * which is why view is not const; it happens under this same lock, so it
+ * is part of the decision, not a separate earlier hint.
+ */
+static bool hfs_view_advance_allowed(struct hfs_view *view, const struct hfs_lease *lease,
+				     const struct hfs_view_stamp *stamp,
+				     const struct hfs_buf *target, const uuid_t *visibility,
+				     const u8 hash[32], u32 len)
+{
+	return !hfs_view_refused(view) && view->phase == HFS_VIEW_LIVE &&
+	       view->revision == stamp->revision && view->revision != U64_MAX &&
+	       uuid_equal(&view->generation, &stamp->generation) &&
+	       uuid_equal(&view->generation, visibility) &&
+	       view->target.len == target->len &&
+	       !memcmp(view->target.data, target->data, target->len) &&
+	       hfs_view_cacheless_locked(view) && len <= view->target.cap &&
+	       lease->advance && !lease->unadopted && !lease->published &&
+	       !memcmp(lease->target_hash, hash, 32);
+}
+
+/* xf4: take view->transitions for an adoption without waiting as long as
+ * its holder (4h4 review round 1). A STOP holds it, without a deadline,
+ * while it joins admitted tokens; an adoption must not inherit that wait,
+ * since before xf4 the observation path only waited for LIVE, within its
+ * deadline. A view that left LIVE (a STOP sets RECALLING before it waits)
+ * or is refused ends the attempt at once with -EXDEV: the adoption would
+ * be refused anyway. While the view is LIVE every other holder keeps it
+ * only for a check under view->lock (ch4: the actual LIVE-phase holders):
+ * the REOPENED ACK check (hfs_controlled_before_ack, which also takes
+ * hfs_controlled_lock), a STOP until it sets RECALLING, a seal or
+ * finish_drained that finds LIVE and refuses it, an install that refuses a
+ * non-install phase, the initial bind of an already LIVE view, an exact
+ * REOPEN replay, and a concurrent adoption's switch. Those are waited for
+ * one jiffy at a time, killable, until the observation's deadline
+ * (time_before, so a jiffies wrap between capture and wait is harmless):
+ * -ETIMEDOUT, or -EINTR on a fatal signal.
+ */
+static int hfs_view_transitions_bounded(struct hfs_view *view, unsigned long deadline)
+{
+	while (!mutex_trylock(&view->transitions)) {
+		if (READ_ONCE(view->phase) != HFS_VIEW_LIVE || hfs_view_refused(view))
+			return -EXDEV;
+		if (!time_before(jiffies, deadline))
+			return -ETIMEDOUT;
+		if (wait_event_killable_timeout(view->wait,
+						READ_ONCE(view->phase) != HFS_VIEW_LIVE ||
+						hfs_view_refused(view), 1) < 0)
+			return -EINTR;
+	}
+	return 0;
+}
+
+/* The switch itself, under view->transitions and view->lock: re-check the
+ * view and the candidate (hfs_view_advance_allowed), then install the
+ * target with revision++ and re-stamp the caller's stamp and target. A
+ * refused re-check marks the lease unadopted.
+ */
+static int hfs_view_advance_switch(struct hfs_view *view, struct hfs_lease *lease,
+				   struct hfs_view_stamp *stamp, struct hfs_buf *target,
+				   int token, const uuid_t *visibility, const u8 hash[32])
+{
+	u32 len = lease->json->tokens[token].end - lease->json->tokens[token].start;
+	unsigned long flags;
+	int err = 0;
+
+	spin_lock_irqsave(&view->lock, flags);
+	if (len > target->cap ||
+	    !hfs_view_advance_allowed(view, lease, stamp, target, visibility, hash, len)) {
+		lease->advance = false;
+		lease->unadopted = true;
+		err = -EXDEV;
+	} else {
+		view->target.len = 0;
+		view->target.error = 0;
+		hfs_buf_token(&view->target, lease->json, token);
+		memcpy(view->target_hash, hash, 32);
+		view->revision++;
+		lease->visibility = *visibility;
+		lease->advance = false;
+		stamp->revision = view->revision;
+		target->len = 0;
+		target->error = 0;
+		hfs_buf_add(target, view->target.data, view->target.len);
+	}
+	spin_unlock_irqrestore(&view->lock, flags);
+	return err;
+}
+
+/* xf4 (guest-requested view advance): adopt an advance candidate (an
+ * unpublished lease with lease->advance from hfs_lease_acquire_ex) for the
+ * observation captured at stamp with expected target target, by its
+ * deadline. The target is verified natively first (hfs_view_advance_target),
+ * outside every view lock, as hfs_mmap_install verifies an event's target:
+ * the provider sleeps. Then view->transitions is taken bounded
+ * (hfs_view_transitions_bounded), so no STOP or install runs between the
+ * re-check and the switch: a STOP that comes first leaves the view
+ * RECALLING or later and the adoption is refused at once; one that comes
+ * after sees the advanced view and handles it like any other. Under
+ * view->lock hfs_view_advance_switch re-checks everything the verification
+ * relied on (LIVE, same revision and generation, expected target still
+ * installed) and switches the target with revision++ (as an install would;
+ * no fence or sequence moves, no event is involved). Every stamp taken
+ * before, a concurrent capture's included, fails its re-check afterwards.
+ * The caller's stamp and target are re-stamped to the advanced view, so the
+ * following hfs_mmap_publish accepts the lease.
+ *
+ * Any refusal marks the lease unadopted (release only, never authority:
+ * hfs_mmap_publish, initial bind and page paths refuse it) and returns
+ * -EXDEV, so the caller holds it, acquires again and then releases it
+ * (hfs_mmap_attempt); a passed deadline or a fatal signal while waiting for
+ * view->transitions returns -ETIMEDOUT or -EINTR, and the caller's cleanup
+ * packet releases the lease. ch4: only hfs_view_transitions_bounded's
+ * results pass through; every verification failure is a refusal (-EXDEV),
+ * even an -ETIMEDOUT or -EINTR the provider returned. Nothing blocks the
+ * session.
+ */
+int hfs_view_advance(struct hfs_view *view, struct hfs_lease *lease,
+		     struct hfs_view_stamp *stamp, struct hfs_buf *target,
+		     unsigned long deadline)
+{
+	int token = hfs_json_field(lease->json, 0, "target");
+	unsigned long flags;
+	uuid_t visibility;
+	u8 hash[32];
+	int err;
+
+	if (token < 0 || hfs_view_advance_target(view->session, lease->json, token,
+						 target, &visibility, hash)) {
+		err = -EXDEV;
+	} else {
+		/* -EXDEV, -ETIMEDOUT or -EINTR, or 0 with transitions held. */
+		err = hfs_view_transitions_bounded(view, deadline);
+		if (!err) {
+			err = hfs_view_advance_switch(view, lease, stamp, target, token,
+						      &visibility, hash);
+			mutex_unlock(&view->transitions);
+			return err;
+		}
+	}
+	spin_lock_irqsave(&view->lock, flags);
+	lease->advance = false;
+	lease->unadopted = true;
+	spin_unlock_irqrestore(&view->lock, flags);
+	return err;
+}
+
+/* The stamp of a LIVE view and, when target_hash is not NULL, the hash of
+ * its installed target in the same critical section (ie4: a cache
+ * observation's request keeps it so hfs_attr_install can tell a recall that
+ * reinstalled the same cut from one that moved the view to another).
+ */
+int hfs_view_snapshot_target(struct hfs_view *view, struct hfs_view_stamp *stamp,
+			     u8 *target_hash)
+{
+	unsigned long flags;
+	int err = 0;
+
+	spin_lock_irqsave(&view->lock, flags);
+	if (view->phase != HFS_VIEW_LIVE) {
+		err = -EAGAIN;
+	} else {
+		stamp->generation = view->generation;
+		stamp->revision = view->revision;
+		if (target_hash)
+			memcpy(target_hash, view->target_hash, 32);
+	}
+	spin_unlock_irqrestore(&view->lock, flags);
+	return err;
+}
+
+int hfs_view_snapshot(struct hfs_view *view, struct hfs_view_stamp *stamp)
+{
+	return hfs_view_snapshot_target(view, stamp, NULL);
+}
+
+/* A view that refuses every entrant for good: FENCED, or a closing or
+ * blocked hfs1.4 session (oc4). Callers hold view->lock or accept a racy
+ * answer (hfs_view_enter_settled's wake-up condition). ie4: a failed
+ * observation re-check keeps -ESTALE only in this case; anything else is a
+ * routine recall and is retried.
+ */
+bool hfs_view_refused(const struct hfs_view *view)
+{
+	return READ_ONCE(view->phase) == HFS_VIEW_FENCED ||
+	       (view->session->bridge_minor == 4 &&
+		(READ_ONCE(view->session->closing) ||
+		 READ_ONCE(view->session->blocked)));
+}
+
+static int hfs_view_try_enter_locked(struct hfs_view *view,
+				     const struct hfs_view_stamp *stamp,
+				     void **cookie)
+{
+	if (hfs_view_refused(view))
+		return -ESTALE;
+	if (stamp && (!uuid_equal(&view->generation, &stamp->generation) ||
+		      view->revision != stamp->revision))
+		return -ESTALE;
+	if (view->phase != HFS_VIEW_LIVE)
+		return -EAGAIN;
+	if (view->active == U32_MAX || !try_module_get(THIS_MODULE))
+		return -EOVERFLOW;
+	kref_get(&view->refs);
+	view->active++;
+	*cookie = view;
+	return 0;
+}
+
+/* 5f4: while parked on view->wait, also wait on session->stop_wait, which
+ * hfs_session_mark_blocked, the closing paths and a failed transport wake
+ * (hfs_session_stop_wake): those stops are part of the wait conditions
+ * below (hfs_view_refused, transport_failed), but their writers have no
+ * view to wake. The extra entry wakes this task directly; the
+ * wait_event_*() loop parked on view->wait then re-checks its condition,
+ * and a wake-up that comes before the task sleeps is not lost (the
+ * condition is checked after the task state is set). Removed again before
+ * the waiter returns, so no wake-up reaches a later, unrelated sleep.
+ */
+static void hfs_view_watch_stops(struct hfs_view *view, struct wait_queue_entry *entry)
+{
+	init_waitqueue_entry(entry, current);
+	add_wait_queue(&view->session->stop_wait, entry);
+}
+
+static void hfs_view_unwatch_stops(struct hfs_view *view, struct wait_queue_entry *entry)
+{
+	remove_wait_queue(&view->session->stop_wait, entry);
+}
+
+/* A parked entrant's wake-up condition: a phase that admits (LIVE) or
+ * refuses for good (FENCED, or a closing/blocked hfs1.4 session).
+ */
+static bool hfs_view_enter_settled(struct hfs_view *view)
+{
+	return READ_ONCE(view->phase) == HFS_VIEW_LIVE || hfs_view_refused(view);
+}
+
+/* With wait, a non-LIVE view (a recall in progress) parks the caller until
+ * the view settles, a fatal signal arrives (-ERESTARTSYS) or
+ * HFS_VIEW_ENTER_WAIT_MS has passed since entry (-ETIMEDOUT, 1a4). The
+ * deadline is fixed at entry, so wake-ups by intermediate recall phases do
+ * not extend it. No caller blocks the session on -ETIMEDOUT: getattr,
+ * lookup and the other observations return it to userspace before sending
+ * anything, a page fault raises SIGBUS, fork and mremap fail. One caller
+ * comes after the host already committed: hfs_attr_install's initial
+ * install of a new inode from CREATE, MKDIR or SYMLINK. There the object
+ * exists on the host, but the guest neither installs nor adopts it
+ * (iget_failed sends no FORGET, the result stays retained unadopted and
+ * pins its retirement floor) and userspace gets ETIMEDOUT; that path logs
+ * a line (hfs_attr_timeout_warn).
+ *
+ * hfs_view_enter_until takes the deadline from its caller instead (ie4):
+ * hfs_mmap_begin re-enters the view after a failed observation re-check and
+ * keeps the deadline of its first entry, so its retries share one
+ * HFS_VIEW_ENTER_WAIT_MS bound rather than restarting it.
+ */
+int hfs_view_enter(struct hfs_view *view, const struct hfs_view_stamp *stamp,
+		   bool wait, void **cookie)
+{
+	return hfs_view_enter_until(view, stamp, wait,
+				    jiffies + msecs_to_jiffies(HFS_VIEW_ENTER_WAIT_MS),
+				    cookie);
+}
+
+int hfs_view_enter_until(struct hfs_view *view, const struct hfs_view_stamp *stamp,
+			 bool wait, unsigned long deadline, void **cookie)
+{
+	struct wait_queue_entry stop;
+	unsigned long flags, now;
+	long left;
+	int err;
+
+	*cookie = NULL;
+	/* This independent reference protects parked entrants, before admission. */
+	if (!try_module_get(THIS_MODULE))
+		return -ESHUTDOWN;
+	kref_get(&view->refs);
+	for (;;) {
+		spin_lock_irqsave(&view->lock, flags);
+		err = hfs_view_try_enter_locked(view, stamp, cookie);
+		spin_unlock_irqrestore(&view->lock, flags);
+		if (!wait || err != -EAGAIN)
+			break;
+		now = jiffies;
+		if (!time_before(now, deadline)) {
+			err = -ETIMEDOUT;
+			break;
+		}
+		/* A timed-out sleep (0) loops once more: that last try still
+		 * admits a view that settled at the deadline, then the check
+		 * above ends the wait. 5f4: a session block or close (a refusal)
+		 * wakes it through session->stop_wait.
+		 */
+		hfs_view_watch_stops(view, &stop);
+		left = wait_event_killable_timeout(view->wait,
+						   hfs_view_enter_settled(view),
+						   deadline - now);
+		hfs_view_unwatch_stops(view, &stop);
+		if (left < 0) {
+			err = left;
+			break;
+		}
+	}
+	hfs_view_put(view);
+	return err;
+}
+
+/* 2f4 (zq3-r17 R17-1): the mount accepted a recall's REOPENED ACK and
+ * raised its current_fence (hfs_mmap_ack, after hfs_controlled_after_ack).
+ * Wakes hfs_view_reopen_wait.
+ */
+void hfs_view_reopen_acked(struct hfs_view *view)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&view->lock, flags);
+	WRITE_ONCE(view->reopen_acks, view->reopen_acks + 1);
+	spin_unlock_irqrestore(&view->lock, flags);
+	wake_up_all(&view->wait);
+}
+
+/* 2f4: parks until another REOPENED ACK was accepted (view->reopen_acks is
+ * no longer acks, as read by the caller before it looked at the fence), the
+ * view refuses for good (hfs_view_refused: FENCED, or a closing or blocked
+ * hfs1.4 session) or the transport failed. Returns 0 for any of those (the
+ * caller looks again), -ETIMEDOUT at the deadline and -EINTR on a fatal
+ * signal. Event-driven: hfs_view_reopen_acked and the stop/fence paths wake
+ * view->wait; 5f4: a session block (hfs_session_block and every other
+ * writer of blocked), a close and a failed transport wake
+ * session->stop_wait, which this wait watches too (hfs_view_watch_stops).
+ * Before 5f4 those stops were seen only at the deadline (up to 30 s).
+ */
+int hfs_view_reopen_wait(struct hfs_view *view, unsigned long acks,
+			 unsigned long deadline)
+{
+	struct wait_queue_entry stop;
+	unsigned long now = jiffies;
+	long left;
+
+	if (!time_before(now, deadline))
+		return -ETIMEDOUT;
+	hfs_view_watch_stops(view, &stop);
+	left = wait_event_killable_timeout(view->wait,
+		READ_ONCE(view->reopen_acks) != acks || hfs_view_refused(view) ||
+		READ_ONCE(view->session->transport_failed),
+		deadline - now);
+	hfs_view_unwatch_stops(view, &stop);
+	if (left < 0)
+		return -EINTR;
+	return left ? 0 : -ETIMEDOUT;
+}
+
+/* 1h4 (zq3-r19 R19-1, review round 2): the only release of
+ * session->retirement. Every holder (hfs_view_retire_mode, hfs_retire,
+ * hfs_session_destroy) ends here: unlock, then count the release on the
+ * session's view, then wake view->wait, so an observation whose trylock
+ * failed against this holder (hfs_view_retire_wait) decides again. Called
+ * without session->lock (hfs_view_get takes it) and with the session alive;
+ * a session without a view has no waiter (a waiter holds a view reference,
+ * and a view leaving session->view is fenced first, which is a stop).
+ */
+void hfs_retirement_unlock(struct hfs_session *session)
+{
+	struct hfs_view *view;
+
+	mutex_unlock(&session->retirement);
+	view = hfs_view_get(session);
+	if (!view)
+		return;
+	atomic_long_inc(&view->retirement_releases);
+	wake_up_all(&view->wait);
+	hfs_view_put(view);
+}
+
+/* 1h4 (zq3-r19 R19-1): parks until the holder of session->retirement that
+ * the caller's hfs_view_retire_try found has released it
+ * (view->retirement_releases is no longer releases, as read by the caller
+ * before that try; hfs_retirement_unlock counts after the unlock), a floor
+ * advanced (view->retire_progress is no longer progress), the view refuses
+ * for good (hfs_view_refused) or the transport failed, or until deadline,
+ * which the caller sets to one bounded slice. Returns 0 for any of those
+ * but the deadline (the caller checks its stops and decides again),
+ * -ETIMEDOUT at the deadline and -EINTR on a fatal signal. Event-driven:
+ * hfs_retirement_unlock and each floor advance wake view->wait, and the
+ * stop/fence paths wake it too. 5f4: a session block, a close or a failed
+ * transport wakes session->stop_wait, which this wait watches too
+ * (hfs_view_watch_stops), as hfs_view_reopen_wait does.
+ */
+int hfs_view_retire_wait(struct hfs_view *view, long releases,
+			 unsigned long progress, unsigned long deadline)
+{
+	struct wait_queue_entry stop;
+	unsigned long now = jiffies;
+	long left;
+
+	if (!time_before(now, deadline))
+		return -ETIMEDOUT;
+	hfs_view_watch_stops(view, &stop);
+	left = wait_event_killable_timeout(view->wait,
+		atomic_long_read(&view->retirement_releases) != releases ||
+		READ_ONCE(view->retire_progress) != progress ||
+		hfs_view_refused(view) || READ_ONCE(view->session->transport_failed),
+		deadline - now);
+	hfs_view_unwatch_stops(view, &stop);
+	if (left < 0)
+		return -EINTR;
+	return left ? 0 : -ETIMEDOUT;
+}
+
+/* For log lines only (hfs_mmap_fail). */
+const char *hfs_view_phase_name(enum hfs_view_phase phase)
+{
+	static const char *const names[] = {
+		[HFS_VIEW_UNBOUND] = "UNBOUND",
+		[HFS_VIEW_LIVE] = "LIVE",
+		[HFS_VIEW_RECALLING] = "RECALLING",
+		[HFS_VIEW_QUIESCENT] = "QUIESCENT",
+		[HFS_VIEW_STOPPED] = "STOPPED",
+		[HFS_VIEW_INSTALLED_DRAIN] = "INSTALLED_DRAIN",
+		[HFS_VIEW_DRAINED] = "DRAINED",
+		[HFS_VIEW_FINAL] = "FINAL",
+		[HFS_VIEW_FENCED] = "FENCED",
+	};
+
+	if ((unsigned int)phase >= sizeof(names) / sizeof(names[0]) || !names[phase])
+		return "?";
+	return names[phase];
+}
+
+void hfs_view_leave(void *cookie)
+{
+	struct hfs_view *view = cookie;
+	unsigned long flags;
+	bool wake;
+
+	if (!view)
+		return;
+	/* kzalloc's aligned view pointer leaves bit0 for a lifetime-only
+	 * private-anonymous COW cookie. It has no backing-cache authority.
+	 */
+	if ((unsigned long)view & 1UL) {
+		hfs_view_put((struct hfs_view *)((unsigned long)view & ~1UL));
+		return;
+	}
+	spin_lock_irqsave(&view->lock, flags);
+	if (WARN_ON_ONCE(!view->active)) {
+		spin_unlock_irqrestore(&view->lock, flags);
+		return;
+	}
+	wake = !--view->active;
+	spin_unlock_irqrestore(&view->lock, flags);
+	if (wake)
+		wake_up_all(&view->wait);
+	hfs_view_put(view);
+}
+
+int hfs_view_stop(struct hfs_view *view, const uuid_t *generation,
+		  const uuid_t *recall, u64 sequence)
+{
+	struct hfs_inode *object;
+	struct hfs_cache_page *entry;
+	struct hfs_cache_grant *grant;
+	struct hfs_observation *observation;
+	unsigned long flags;
+	u32 count = 0, pages = 0, i;
+	int err = 0;
+
+	if (!sequence || uuid_is_null(recall))
+		return -EINVAL;
+	mutex_lock(&view->transitions);
+	spin_lock_irqsave(&view->lock, flags);
+	if (view->phase == HFS_VIEW_UNBOUND) {
+		if (uuid_is_null(generation) || view->active || view->nr_cached ||
+		    view->nr_dirty || view->nr_mappings || view->target.len) {
+			err = -ESTALE;
+			goto unlock_initial;
+		}
+		/* Only the mandatory authenticated event path calls STOP here.
+		 * No synthetic Context-generation -> visibility conversion exists.
+		 */
+		view->generation = *generation;
+		view->phase = HFS_VIEW_RECALLING;
+		view->recall = *recall;
+		view->sequence = sequence;
+	}
+	if (!uuid_equal(&view->generation, generation) ||
+	    view->phase == HFS_VIEW_FENCED || sequence < view->sequence) {
+		err = -ESTALE;
+		goto unlock_initial;
+	}
+	if (view->phase == HFS_VIEW_LIVE && sequence > view->sequence) {
+		view->phase = HFS_VIEW_RECALLING;
+		view->quiescent = false;
+		view->recall = *recall;
+		view->sequence = sequence;
+	} else if (sequence != view->sequence ||
+		   !uuid_equal(&view->recall, recall)) {
+		err = -ESTALE;
+		goto unlock_initial;
+	} else if (view->phase == HFS_VIEW_QUIESCENT ||
+		   view->phase == HFS_VIEW_STOPPED ||
+		   view->phase == HFS_VIEW_INSTALLED_DRAIN ||
+		   view->phase == HFS_VIEW_DRAINED ||
+		   view->phase == HFS_VIEW_FINAL) {
+		goto unlock_initial;
+	} else if (view->phase != HFS_VIEW_RECALLING) {
+		err = -ESTALE;
+		goto unlock_initial;
+	}
+	spin_unlock_irqrestore(&view->lock, flags);
+	/* No mmap/i_mmap/page/PTE lock is held while joining token holders. */
+	wait_event(view->wait, !READ_ONCE(view->active));
+	spin_lock_irqsave(&view->lock, flags);
+	if (view->phase != HFS_VIEW_RECALLING) {
+		spin_unlock_irqrestore(&view->lock, flags);
+		mutex_unlock(&view->transitions);
+		return -ESTALE;
+	}
+	/* evict unregisters before free, outside inode->i_lock. The only
+	 * nesting is view lock -> igrab's i_lock; no inode lock -> view path.
+	 */
+	list_for_each_entry(object, &view->mappings, view_list) {
+		struct inode *inode = igrab(&object->inode);
+
+		/* An inode already freeing has no live VMA/file observation. */
+		if (inode)
+			view->stopping[count++] = inode;
+	}
+	list_for_each_entry(entry, &view->cache, list) {
+		if (entry->page) {
+			get_page(entry->page);
+			view->stopping_pages[pages++] = entry->page;
+		}
+	}
+	spin_unlock_irqrestore(&view->lock, flags);
+	for (i = 0; i < count; i++) {
+		struct inode *inode = view->stopping[i];
+
+		/* Includes fork aliases/open-unlinked/executable file PTEs.
+		 * zap_page_range_single completes notifier and TLB invalidation.
+		 * Private anonymous modifications are application-owned snapshots.
+		 */
+		unmap_mapping_range(inode->i_mapping, 0, 0, 0);
+		iput(inode);
+		view->stopping[i] = NULL;
+	}
+	for (i = 0; i < pages; i++) {
+		struct page *page = view->stopping_pages[i];
+
+		lock_page(page);
+		/* No external kernel ref/pin path may bypass the page marker.
+		 * Refuse conservative pin/writeback/busy findings; never unpin,
+		 * force-write or assert success to advance a barrier.
+		 */
+		if (page_mapped(page) || PageWriteback(page) ||
+		    folio_maybe_dma_pinned(page_folio(page)))
+			err = -EBUSY;
+		/* A clean page may have completed eviction after our snapshot;
+		 * it no longer supplies any filesystem PTE or cache observation.
+		 */
+		if (page_mapping(page) && !PageHfsnogup(page))
+			err = -ESTALE;
+		unlock_page(page);
+		put_page(page);
+		view->stopping_pages[i] = NULL;
+	}
+	spin_lock_irqsave(&view->lock, flags);
+	if (!err && view->phase == HFS_VIEW_RECALLING) {
+		list_for_each_entry(entry, &view->cache, list) {
+			if (entry->lease)
+				WRITE_ONCE(entry->lease->revoked, true);
+			list_for_each_entry(grant, &entry->readers, list)
+				WRITE_ONCE(grant->lease->revoked, true);
+		}
+		list_for_each_entry(observation, &view->observations, list)
+			if (observation->lease)
+				WRITE_ONCE(observation->lease->revoked, true);
+		view->phase = HFS_VIEW_QUIESCENT;
+		view->quiescent = true;
+	} else if (!err)
+		err = -ESTALE;
+unlock_initial:
+	spin_unlock_irqrestore(&view->lock, flags);
+	mutex_unlock(&view->transitions);
+	return err;
+}
+
+int hfs_view_seal(struct hfs_view *view)
+{
+	struct hfs_dirty *dirty, *ordered[HFS_DIRTY_PAGES_MAX], *tmp;
+	struct hfs_buf *manifest = &view->manifest;
+	unsigned long flags;
+	u32 count = 0, i, j, entries_start, entries_len;
+	int err = 0;
+
+	mutex_lock(&view->transitions);
+	spin_lock_irqsave(&view->lock, flags);
+	if (view->phase == HFS_VIEW_STOPPED)
+		goto unlock;
+	if (view->phase != HFS_VIEW_QUIESCENT || !view->quiescent || view->active) {
+		err = -ESTALE;
+		goto unlock;
+	}
+	list_for_each_entry(dirty, &view->dirty, list) {
+		if (!dirty->adopted || !dirty->captured || !dirty->frozen ||
+		    !dirty->frozen_entry || count == HFS_DIRTY_PAGES_MAX) {
+			err = -EBUSY;
+			goto unlock;
+		}
+		ordered[count++] = dirty;
+	}
+	if (count != view->nr_dirty) {
+		err = -EPROTO;
+		goto unlock;
+	}
+	/* Insertion sort is bounded by sixteen immutable obligation records. */
+	for (i = 1; i < count; i++) {
+		tmp = ordered[i];
+		for (j = i; j && memcmp(ordered[j - 1]->entry_id, tmp->entry_id, 32) > 0; j--)
+			ordered[j] = ordered[j - 1];
+		ordered[j] = tmp;
+	}
+	manifest->len = 0;
+	manifest->error = 0;
+	hfs_buf_literal(manifest, "{\"entries\":");
+	entries_start = manifest->len;
+	hfs_buf_literal(manifest, "[");
+	for (i = 0; i < count; i++) {
+		if (i && !memcmp(ordered[i - 1]->entry_id, ordered[i]->entry_id, 32)) {
+			err = -EPROTO;
+			goto unlock;
+		}
+		if (i)
+			hfs_buf_literal(manifest, ",");
+		hfs_buf_add(manifest, ordered[i]->frozen_entry->data,
+			    ordered[i]->frozen_entry->len);
+	}
+	hfs_buf_literal(manifest, "]");
+	entries_len = manifest->len - entries_start;
+	if (manifest->error) {
+		err = manifest->error;
+		goto unlock;
+	}
+	hfs_hash(manifest->data + entries_start, entries_len, view->manifest_hash);
+	hfs_buf_literal(manifest, ",\"hash\":");
+	hfs_buf_hex(manifest, view->manifest_hash, 32);
+	hfs_buf_literal(manifest, "}");
+	err = manifest->error;
+	if (!err)
+		view->phase = HFS_VIEW_STOPPED;
+unlock:
+	spin_unlock_irqrestore(&view->lock, flags);
+	mutex_unlock(&view->transitions);
+	return err;
+}
+
+int hfs_view_reopen(struct hfs_view *view, const uuid_t *recall, u64 sequence)
+{
+	struct hfs_cache_page *entry;
+	unsigned long flags;
+	int err = 0;
+
+	mutex_lock(&view->transitions);
+	spin_lock_irqsave(&view->lock, flags);
+	if (view->phase == HFS_VIEW_LIVE && view->sequence == sequence &&
+	    uuid_equal(&view->recall, recall))
+		goto unlock;
+	if (view->phase != HFS_VIEW_FINAL || !view->quiescent ||
+	    !uuid_equal(&view->recall, recall) || sequence <= view->sequence ||
+	    !sequence || !view->target.len || view->active ||
+	    view->nr_dirty) {
+		err = -ESTALE;
+	} else {
+		/* A parked RPC may retain detached old metadata; it supplies no
+		 * cache observation and its old stamp will fail adoption below.
+		 */
+		list_for_each_entry(entry, &view->cache, list)
+			if (entry->page) {
+				err = -EBUSY;
+				break;
+			}
+	}
+	if (!err && view->revision == U64_MAX) {
+		/* Never wrap a stamp into an earlier admission lifetime. */
+		view->phase = HFS_VIEW_FENCED;
+		err = -EOVERFLOW;
+	} else if (!err) {
+		/* Same lock as reservation adoption and final writable-PTE entry.
+		 * A reserve captured before STOP cannot be adopted after REOPEN.
+		 */
+		view->revision++;
+		view->sequence = sequence;
+		view->quiescent = false;
+		view->phase = HFS_VIEW_LIVE;
+	}
+unlock:
+	spin_unlock_irqrestore(&view->lock, flags);
+	mutex_unlock(&view->transitions);
+	if (!err || err == -EOVERFLOW)
+		wake_up_all(&view->wait);
+	return err;
+}
+
+void hfs_view_fence(struct hfs_view *view)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&view->lock, flags);
+	view->phase = HFS_VIEW_FENCED;
+	spin_unlock_irqrestore(&view->lock, flags);
+	wake_up_all(&view->wait);
+}
+
+/* Page resources are admitted before allocating/exposing the cache page. */
+int hfs_view_page_prepare(struct hfs_view *view,
+			  const struct hfs_view_stamp *stamp,
+			  struct hfs_cache_page **out)
+{
+	struct hfs_cache_page *entry;
+	void *reservation;
+	unsigned long flags;
+	int err;
+
+	*out = NULL;
+	err = view->session->provider->reserve(view->session,
+			sizeof(*entry) + PAGE_SIZE + HFS_TARGET_MAX, false, &reservation);
+	if (err)
+		return err;
+	entry = kzalloc(sizeof(*entry), GFP_KERNEL);
+	if (!entry) {
+		view->session->provider->unreserve(view->session, reservation);
+		return -ENOMEM;
+	}
+	if (hfs_buf_init(&entry->target, HFS_TARGET_MAX)) {
+		view->session->provider->unreserve(view->session, reservation);
+		kfree(entry);
+		return -ENOMEM;
+	}
+	kref_init(&entry->refs);
+	INIT_LIST_HEAD(&entry->list);
+	INIT_LIST_HEAD(&entry->readers);
+	entry->view = view;
+	entry->stamp = *stamp;
+	entry->reservation = reservation;
+	spin_lock_irqsave(&view->lock, flags);
+	if (view->phase != HFS_VIEW_LIVE ||
+	    !uuid_equal(&view->generation, &stamp->generation) ||
+	    view->revision != stamp->revision) {
+		err = -ESTALE;
+	} else if (view->nr_cached == HFS_CACHE_PAGES_MAX) {
+		err = -ENOSPC;
+	} else if (!try_module_get(THIS_MODULE)) {
+		err = -ESHUTDOWN;
+	} else {
+		kref_get(&view->refs);
+		view->nr_cached++;
+		hfs_buf_add(&entry->target, view->target.data, view->target.len);
+		list_add_tail(&entry->list, &view->cache);
+		err = 0;
+	}
+	spin_unlock_irqrestore(&view->lock, flags);
+	if (err) {
+		hfs_buf_free(&entry->target);
+		view->session->provider->unreserve(view->session, reservation);
+		kfree(entry);
+		return err;
+	}
+	*out = entry;
+	return 0;
+}
+
+static void hfs_view_page_release(struct kref *refs)
+{
+	struct hfs_cache_page *entry = container_of(refs, struct hfs_cache_page, refs);
+	struct hfs_view *view = entry->view;
+	struct hfs_cache_grant *grant;
+	unsigned long flags;
+
+	if (WARN_ON_ONCE(entry->page || entry->dirty))
+		return;
+	spin_lock_irqsave(&view->lock, flags);
+	list_del_init(&entry->list);
+	view->nr_cached--;
+	if (entry->dirty_slot && !entry->cleanup)
+		view->nr_dirty_packages--;
+	list_for_each_entry(grant, &entry->readers, list)
+		view->nr_grants--;
+	spin_unlock_irqrestore(&view->lock, flags);
+	if (entry->dispose)
+		entry->dispose(entry);
+	hfs_buf_free(&entry->target);
+	view->session->provider->unreserve(view->session, entry->reservation);
+	kfree(entry);
+	hfs_view_put(view);
+}
+
+void hfs_view_page_get(struct hfs_cache_page *entry)
+{
+	kref_get(&entry->refs);
+}
+
+void hfs_view_page_put(struct hfs_cache_page *entry)
+{
+	kref_put(&entry->refs, hfs_view_page_release);
+}
+
+void hfs_view_page_discard(struct hfs_cache_page *entry)
+{
+	if (WARN_ON_ONCE(entry->page || entry->dirty))
+		return;
+	hfs_view_page_put(entry);
+}
+
+int hfs_view_page_attach(struct hfs_cache_page *entry, struct page *page)
+{
+	struct hfs_view *view = entry->view;
+	void *cookie;
+	unsigned long flags;
+	int err;
+
+	if (!PageLocked(page) || PageCompound(page) || PagePrivate(page) ||
+	    entry->page)
+		return -EINVAL;
+	if (!entry->lease || READ_ONCE(entry->lease->revoked) ||
+	    !uuid_equal(&entry->lease->visibility, &entry->stamp.generation))
+		return -ESTALE;
+	err = hfs_view_enter(view, &entry->stamp, false, &cookie);
+	if (err)
+		return err;
+	/* No PTE can see this page before marker + metadata are installed. */
+	SetPageHfsnogup(page);
+	folio_attach_private(page_folio(page), entry);
+	hfs_view_page_get(entry); /* private metadata ownership */
+	spin_lock_irqsave(&view->lock, flags);
+	entry->page = page;
+	spin_unlock_irqrestore(&view->lock, flags);
+	hfs_view_leave(cookie);
+	return 0;
+}
+
+struct hfs_cache_page *hfs_view_page_find(struct hfs_view *view, struct page *page)
+{
+	struct hfs_cache_page *entry, *found = NULL;
+	unsigned long flags;
+
+	spin_lock_irqsave(&view->lock, flags);
+	list_for_each_entry(entry, &view->cache, list)
+		if (entry->page == page && !entry->revoking) {
+			hfs_view_page_get(entry);
+			found = entry;
+			break;
+		}
+	spin_unlock_irqrestore(&view->lock, flags);
+	return found;
+}
+
+int hfs_view_dirty_slot(struct hfs_cache_page *entry)
+{
+	struct hfs_view *view = entry->view;
+	unsigned long flags;
+	int err = 0;
+
+	spin_lock_irqsave(&view->lock, flags);
+	if (view->phase != HFS_VIEW_LIVE || entry->revoking ||
+	    !uuid_equal(&view->generation, &entry->stamp.generation) ||
+	    view->revision != entry->stamp.revision)
+		err = -ESTALE;
+	else if (entry->dirty_slot)
+		err = -EBUSY;
+	else if (view->nr_dirty_packages == HFS_DIRTY_PAGES_MAX)
+		err = -ENOSPC;
+	else {
+		view->nr_dirty_packages++;
+		entry->dirty_slot = true;
+	}
+	spin_unlock_irqrestore(&view->lock, flags);
+	return err;
+}
+
+void hfs_view_dirty_unslot(struct hfs_cache_page *entry)
+{
+	struct hfs_view *view = entry->view;
+	unsigned long flags;
+
+	spin_lock_irqsave(&view->lock, flags);
+	if (!WARN_ON_ONCE(entry->dirty || !entry->dirty_slot)) {
+		entry->dirty_slot = false;
+		view->nr_dirty_packages--;
+	}
+	spin_unlock_irqrestore(&view->lock, flags);
+}
+
+int hfs_view_adopt_dirty(struct hfs_view *view, struct hfs_cache_page *entry,
+			 struct hfs_dirty *dirty)
+{
+	unsigned long flags;
+	int err = 0;
+
+	/* These immutable records and actual credit handles exist before PTEs.
+	 * Complete Reservation/number/Cred checks occur in the wire decoder.
+	 */
+	if (!dirty || !dirty->reservation || !dirty->reserve_ticket ||
+	    !dirty->freeze_ticket || !dirty->freeze_ticket->control ||
+	    !dirty->request || !dirty->request->reservation || !dirty->credit ||
+	    !dirty->request->earmarked || !dirty->request->control ||
+	    !dirty->length || dirty->length > 4096 || !entry->lease ||
+	    !entry->lease->dirty)
+		return -EINVAL;
+	spin_lock_irqsave(&view->lock, flags);
+	/* Capture predates dispatch. Neither a delayed reserve during STOP nor
+	 * an original replay after REOPEN may adopt into a later local epoch.
+	 */
+	if (view->phase != HFS_VIEW_LIVE || entry->revoking ||
+	    READ_ONCE(entry->lease->revoked) ||
+	    !uuid_equal(&view->generation, &entry->stamp.generation) ||
+	    view->revision != entry->stamp.revision ||
+	    memcmp(view->target_hash, entry->lease->target_hash, 32))
+		err = -ESTALE;
+	else if (entry->dirty || dirty->adopted)
+		err = -EBUSY;
+	else if (view->nr_dirty == HFS_DIRTY_PAGES_MAX)
+		err = -ENOSPC;
+	else {
+		/* Cancellation closes this same bit before its RPC. No cancellation
+		 * may certify no-effect concurrently with physical adoption.
+		 */
+		spin_lock(&dirty->reserve_ticket->admission_lock);
+		if (dirty->reserve_ticket->closed) {
+			err = -ECANCELED;
+			spin_unlock(&dirty->reserve_ticket->admission_lock);
+			goto unlock;
+		}
+		if (!entry->dirty_slot || !entry->page || !PageLocked(entry->page)) {
+			err = -EINVAL;
+			spin_unlock(&dirty->reserve_ticket->admission_lock);
+			goto unlock;
+		}
+		dirty->reserve_ticket->published = true;
+		spin_unlock(&dirty->reserve_ticket->admission_lock);
+		dirty->entry = entry;
+		dirty->adopted = true;
+		entry->dirty = dirty;
+		view->nr_dirty++;
+		list_add_tail(&dirty->list, &view->dirty);
+		hfs_view_page_get(entry); /* frozen obligation, independent of VMA */
+	}
+unlock:
+	spin_unlock_irqrestore(&view->lock, flags);
+	return err;
+}
+
+int hfs_view_page_lease(struct hfs_cache_page *entry, struct hfs_lease *lease)
+{
+	struct hfs_view *view = entry->view;
+	unsigned long flags;
+	int err = 0;
+
+	if (!lease || !lease->release_ticket)
+		return -EINVAL;
+	if (lease->unadopted)
+		return -ESTALE; /* 2f4: release only, never PTE authority */
+	spin_lock_irqsave(&view->lock, flags);
+	if (view->phase != HFS_VIEW_LIVE || entry->revoking || entry->lease ||
+	    view->revision != entry->stamp.revision ||
+	    !uuid_equal(&view->generation, &entry->stamp.generation) ||
+	    !uuid_equal(&lease->visibility, &entry->stamp.generation) ||
+	    READ_ONCE(lease->revoked) || memcmp(view->target_hash, lease->target_hash, 32))
+		err = -ESTALE;
+	else
+		entry->lease = lease; /* complete preowned object; STOP shares this lock */
+	spin_unlock_irqrestore(&view->lock, flags);
+	return err;
+}
+
+int hfs_view_page_grant(struct hfs_cache_page *entry, struct hfs_cache_grant *grant,
+			 struct hfs_cache_page *from)
+{
+	struct hfs_view *view = entry->view;
+	unsigned long flags;
+	int err = 0;
+
+	if (!grant || !grant->lease || grant->lease->dirty || !grant->lease->release_ticket ||
+	    grant->lease->unadopted ||
+	    (from && (from->view != view || from->page || from->lease != grant->lease)))
+		return -EINVAL;
+	spin_lock_irqsave(&view->lock, flags);
+	if (view->phase != HFS_VIEW_LIVE || entry->revoking ||
+	    !uuid_equal(&view->generation, &entry->stamp.generation) ||
+	    view->revision != entry->stamp.revision ||
+	    memcmp(view->target_hash, grant->lease->target_hash, 32))
+		err = -ESTALE;
+	else if (view->nr_grants == HFS_CACHE_GRANTS_MAX)
+		err = -ENOSPC;
+	else {
+		list_add_tail(&grant->list, &entry->readers);
+		view->nr_grants++;
+		if (from)
+			from->lease = NULL; /* atomic with publication into the reader registry */
+	}
+	spin_unlock_irqrestore(&view->lock, flags);
+	return err;
+}
+
+int hfs_view_page_enter(struct vm_area_struct *vma, struct page *page,
+			bool write, void **cookie)
+{
+	struct hfs_view *view = hfs_view_get(HFS_S(file_inode(vma->vm_file)));
+	struct hfs_cache_page *entry;
+	struct hfs_cache_grant *grant;
+	struct hfs_description *description = vma->vm_file->private_data;
+	struct hfs_lease *lease;
+	struct hfs_view_stamp stamp;
+	unsigned long flags;
+	int err;
+
+	*cookie = NULL;
+	if (!view)
+		return -ESTALE;
+	if (!page) {
+		err = hfs_view_enter(view, NULL, true, cookie);
+		goto out;
+	}
+	/* Private anonymous COW is application data, not backing cache state. */
+	if (PageAnon(page)) {
+		/* Preserve application-owned COW data even while backing cache is
+		 * stopped/fenced. The cookie still pins the actual view/module
+		 * until the snapshotted end callback completes after any VMA loss.
+		 */
+		*cookie = (void *)((unsigned long)view | 1UL);
+		return 0; /* transfer this get() reference, without an active token */
+	}
+	if (PageCompound(page) || !PageHfsnogup(page)) {
+		err = -ESTALE;
+		goto out;
+	}
+	/* wp_page_copy's original page need not be locked. The registry, not
+	 * a lockless page->private dereference, protects metadata lifetime.
+	 */
+	err = -ESTALE;
+	spin_lock_irqsave(&view->lock, flags);
+	list_for_each_entry(entry, &view->cache, list) {
+		if (entry->page != page)
+			continue;
+		lease = NULL;
+		if (!description || !description->cap || entry->revoking)
+			break;
+		if (entry->lease && !memcmp(entry->lease->description, description->cap->token, 32))
+			lease = entry->lease;
+		if (!write && !lease)
+			list_for_each_entry(grant, &entry->readers, list)
+				if (!memcmp(grant->lease->description, description->cap->token, 32)) {
+					lease = grant->lease;
+					break;
+				}
+		if (lease && !READ_ONCE(lease->revoked) &&
+		    !memcmp(lease->target_hash, view->target_hash, 32) &&
+		    (!write || (lease == entry->lease && lease->dirty &&
+				entry->dirty && entry->dirty->adopted))) {
+			stamp = entry->stamp;
+			err = hfs_view_try_enter_locked(view, &stamp, cookie);
+			if (!err)
+				WRITE_ONCE(lease->published, true);
+		}
+		break;
+	}
+	spin_unlock_irqrestore(&view->lock, flags);
+out:
+	hfs_view_put(view);
+	return err;
+}
+
+static bool hfs_cache_frozen_detachable(struct hfs_cache_page *entry)
+{
+	return entry->dirty && entry->dirty->captured && entry->dirty->frozen &&
+		entry->view->quiescent && !entry->view->active &&
+		(entry->view->phase == HFS_VIEW_STOPPED ||
+		 entry->view->phase == HFS_VIEW_INSTALLED_DRAIN);
+}
+
+static int hfs_cache_launder(struct folio *folio)
+{
+	struct hfs_cache_page *entry = folio_get_private(folio);
+	struct hfs_view *view;
+	unsigned long flags;
+	bool detachable;
+
+	if (!entry)
+		return -EBUSY;
+	view = entry->view;
+	spin_lock_irqsave(&view->lock, flags);
+	detachable = hfs_cache_frozen_detachable(entry);
+	spin_unlock_irqrestore(&view->lock, flags);
+	if (!detachable)
+		return -EBUSY;
+	/* Not generic writeback: exact bytes/Claim and credits remain in the
+	 * complete frozen registry and protected DIRTY_FREEZE record. An
+	 * independent reserved drain still must obtain its exact terminal result.
+	 */
+	clear_page_dirty_for_io(&folio->page);
+	return 0;
+}
+
+static void hfs_cache_invalidate(struct folio *folio, size_t offset, size_t len)
+{
+	struct hfs_cache_page *entry = folio_get_private(folio);
+	struct hfs_view *view;
+	struct hfs_cache_grant *grant;
+	unsigned long flags;
+
+	if (!entry)
+		return;
+	view = entry->view;
+	spin_lock_irqsave(&view->lock, flags);
+	if (offset || len != PAGE_SIZE || folio_mapped(folio) ||
+	    PageWriteback(&folio->page) || folio_maybe_dma_pinned(folio) ||
+	    (entry->dirty && !entry->dirty->resolved && !hfs_cache_frozen_detachable(entry)) ||
+	    (view->active && entry->lease && READ_ONCE(entry->lease->published) &&
+	     (!folio->mapping || !mapping_exiting(folio->mapping)))) {
+		/* Dirty provenance owns its private page ref through truncation.
+		 * Unexpected invalidation fences instead of losing an obligation.
+		 */
+		view->phase = HFS_VIEW_FENCED;
+		spin_unlock_irqrestore(&view->lock, flags);
+		wake_up_all(&view->wait);
+		return;
+	}
+	entry->revoking = true;
+	if (entry->lease)
+		WRITE_ONCE(entry->lease->revoked, true);
+	list_for_each_entry(grant, &entry->readers, list)
+		WRITE_ONCE(grant->lease->revoked, true);
+	entry->page = NULL;
+	spin_unlock_irqrestore(&view->lock, flags);
+	folio_clear_uptodate(folio);
+	folio_detach_private(folio);
+	hfs_view_page_put(entry); /* private metadata ownership */
+	/* Keep NoGup until actual mapping detachment in free_folio. */
+}
+
+static bool hfs_cache_release(struct folio *folio, gfp_t gfp)
+{
+	struct hfs_cache_page *entry = folio_get_private(folio);
+
+	(void)gfp;
+	if (!entry)
+		return true;
+	if (folio_mapped(folio) ||
+	    (entry->dirty && !entry->dirty->resolved && !hfs_cache_frozen_detachable(entry)) ||
+	    READ_ONCE(entry->view->phase) < HFS_VIEW_QUIESCENT)
+		return false;
+	hfs_cache_invalidate(folio, 0, PAGE_SIZE);
+	return !folio_get_private(folio);
+}
+
+static void hfs_cache_free(struct folio *folio)
+{
+	/* filemap/vmscan call only after mapping detachment and PTE removal.
+	 * A speculative old fast-GUP reference still rechecks its old PTE;
+	 * clearing this flag cannot validate that now-removed PTE. No mapping
+	 * pointer is dereferenced by GUP, and this physical page is not reused
+	 * until the speculative reference is released.
+	 */
+	if (WARN_ON_ONCE(folio_mapped(folio)))
+		return;
+	if (folio_get_private(folio)) {
+		hfs_cache_invalidate(folio, 0, PAGE_SIZE);
+		if (folio_get_private(folio))
+			return; /* retained unresolved provenance still owns the page */
+	}
+	ClearPageHfsnogup(&folio->page);
+}
+
+static int hfs_cache_migrate(struct address_space *mapping,
+			     struct folio *dst, struct folio *src,
+			     enum migrate_mode mode)
+{
+	/* No generic migration can drop a provenance/NoGup flag or lease. */
+	(void)mapping;
+	(void)dst;
+	(void)src;
+	(void)mode;
+	return -EBUSY;
+}
+
+const struct address_space_operations hfs_cache_aops = {
+	/* All shared writable PTEs already own an adopted immutable obligation.
+	 * Track the real dirty bit without generic writeback tags/accounting or
+	 * replacement credentials. PTE removal can dirty again while RECALLING;
+	 * this atomic callback must not wait, allocate, RPC or require LIVE.
+	 */
+	.dirty_folio = noop_dirty_folio,
+	.launder_folio = hfs_cache_launder,
+	.invalidate_folio = hfs_cache_invalidate,
+	.release_folio = hfs_cache_release,
+	.free_folio = hfs_cache_free,
+	.migrate_folio = hfs_cache_migrate,
+};
diff --git a/fs/9p/hfs_lease.h b/fs/9p/hfs_lease.h
new file mode 100644
--- /dev/null
+++ b/fs/9p/hfs_lease.h
@@ -0,0 +1,156 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef FS_9P_HFS_LEASE_H
+#define FS_9P_HFS_LEASE_H
+
+#include <linux/list.h>
+#include <linux/kref.h>
+#include <linux/spinlock.h>
+#include <linux/mutex.h>
+#include <linux/wait.h>
+#include "hfs_protocol.h"
+
+struct hfs_session;
+struct hfs_cred;
+struct hfs_cap;
+struct hfs_cache_page;
+struct hfs_dirty;
+struct hfs_view;
+
+#define HFS_VIEW_TICKETS_MAX 256U
+#define HFS_VIEW_CONTROL_TICKETS_MAX 256U
+#define HFS_VIEW_FAMILIES_MAX 4096U
+#define HFS_DIRTY_PAGES_MAX 16U
+
+struct hfs_view_family {
+	struct mutex dispatch;
+	wait_queue_head_t wait;
+	struct hfs_view_ticket *initial;
+	struct hfs_retirement_cut *retirement_cut;
+	struct list_head list;
+	struct hfs_buf credentials;
+	u8 hash[32];
+	uuid_t nonce;
+	uuid_t anchor;
+	bool control;
+	u64 next;
+	u64 prepared; /* preowned finite counter slots, not wire identities */
+	u64 floor;
+	void *reservation;
+};
+
+struct hfs_view_ticket {
+	struct hfs_completion *completion;
+	/* Never take a view/session lock while holding this lock. */
+	spinlock_t admission_lock;
+	struct list_head list;
+	struct hfs_view_family *family;
+	struct hfs_session *session;
+	u32 users;
+	struct hfs_buf request;
+	struct hfs_buf payload;
+	struct hfs_buf query;
+	struct hfs_buf original;
+	struct hfs_token *scratch;
+	bool admitted;
+	struct hfs_json *response;
+	struct hfs_json *initial_response;
+	void *reservation;
+	u64 number;
+	u8 request_hash[32];
+	char operation[24];
+	bool control;
+	bool bound;
+	bool terminal;
+	bool uncertain;
+	bool closed;
+	bool published;
+	/* xf4: this VIEW_ACQUIRE carries "advance": true (set before it is
+	 * bound, never changed after). A GRANTED reply whose lease target
+	 * differs from the expected one then skips the 2f4 settle wait and is
+	 * classified by hfs_lease_decode instead (hfs_view_exchange_source).
+	 */
+	bool advance;
+};
+
+struct hfs_lease {
+	struct kref refs;
+	struct mutex release_lock;
+	bool released;
+	struct hfs_view_ticket *release_ticket;
+	struct hfs_buf release_payload;
+	struct hfs_json *json;
+	struct hfs_view_ticket *ticket;
+	struct hfs_cred *issuer;
+	bool published;
+	bool revoked; /* irreversible actual all-alias physical exclusion */
+	u8 id[32];
+	u8 target_hash[32];
+	u8 description[32];
+	uuid_t visibility;
+	u64 fence;
+	u64 revision;
+	bool dirty;
+	/* 2f4 review 1: a GRANTED handed out only to be released (a later
+	 * recall passed it, or the exchange stopped before the view settled;
+	 * hfs_view_grant_settle). Also, as the code has done since 2f4 and
+	 * xf4 (documented here since 5f4): a GRANTED that hfs_view_exchange
+	 * copied into the caller's response but could not keep as the
+	 * ticket's Current (-ENOMEM; hfs_view_exchange_terminal), and a moved
+	 * target that is no advance candidate (-EXDEV;
+	 * hfs_lease_decode_target). Its target was never verified by the
+	 * provider (visibility stays zero), so it is never authority: no
+	 * initial bind, page lease, page grant or observation publish takes it.
+	 */
+	bool unadopted;
+	/* xf4: an advance candidate, granted on a target other than the
+	 * request's expected one and verified for adoption
+	 * (hfs_view_advance_target) but not adopted yet. Like unadopted it is
+	 * no authority: hfs_mmap_publish refuses it until hfs_view_advance
+	 * installs its target and clears this under view->lock; a failed
+	 * adoption marks it unadopted instead, for release only.
+	 */
+	bool advance;
+};
+
+void hfs_view_ticket_put(struct hfs_view_ticket *ticket);
+int hfs_view_retire(struct hfs_session *session);
+int hfs_view_retire_try(struct hfs_session *session, bool *ran);
+bool hfs_view_tickets_busy(struct hfs_session *session);
+void hfs_view_tickets_destroy(struct hfs_session *session);
+int hfs_view_target(struct hfs_session *session, const struct hfs_json *json,
+		    int token, uuid_t *visibility, u8 target_hash[32]);
+int hfs_view_advance_target(struct hfs_session *session, const struct hfs_json *json,
+			    int token, const struct hfs_buf *expected, uuid_t *visibility,
+			    u8 target_hash[32]);
+bool hfs_view_advance_supported(const struct hfs_session *session);
+int hfs_json_hash_fields(const struct hfs_json *json, int object,
+			 const char *fields, u8 digest[32]);
+int hfs_view_ticket_prepare(struct hfs_session *session, const struct hfs_cred *cred,
+			    bool control, struct hfs_view_ticket **out);
+int hfs_view_ticket_activate(struct hfs_view_ticket *ticket);
+int hfs_view_query(struct hfs_session *session, struct hfs_view_ticket *ticket,
+		    bool cancel, struct hfs_json **response);
+int hfs_view_exchange(struct hfs_session *session, struct hfs_view_ticket *ticket,
+		      const char *operation, const struct hfs_buf *payload,
+		      struct hfs_json **response);
+int hfs_lease_acquire(struct hfs_session *session, const struct hfs_cred *cred,
+		      const struct hfs_cap *object, const struct hfs_cap *description,
+		      u64 offset, bool dirty, const struct hfs_buf *expected_target,
+		      struct hfs_lease **out);
+int hfs_lease_acquire_ex(struct hfs_session *session, const struct hfs_cred *cred,
+			 const struct hfs_cap *object, const struct hfs_cap *description,
+			 u64 offset, bool dirty, const struct hfs_buf *expected_target,
+			 bool advance, struct hfs_lease **out, bool *blocked);
+int hfs_lease_release(struct hfs_session *session, struct hfs_lease *lease);
+void hfs_lease_get(struct hfs_lease *lease);
+void hfs_lease_free(struct hfs_lease *lease);
+
+int hfs_dirty_reserve(struct hfs_session *session, struct hfs_cache_page *entry,
+		       const struct hfs_cap *description, u64 offset, u32 length,
+		       struct hfs_dirty **out);
+int hfs_dirty_resume_reserve(struct hfs_session *session, struct hfs_dirty *dirty,
+			     struct hfs_lease *lease);
+int hfs_dirty_freeze(struct hfs_view *view, struct hfs_dirty *dirty);
+int hfs_dirty_drain(struct hfs_view *view, struct hfs_dirty *dirty);
+
+#endif
diff --git a/fs/9p/hfs_lease.c b/fs/9p/hfs_lease.c
new file mode 100644
--- /dev/null
+++ b/fs/9p/hfs_lease.c
@@ -0,0 +1,2449 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Exact bridge1.1 ticket/lease transport; no physical or source-proof defaults. */
+#include <linux/slab.h>
+#include <linux/delay.h>
+#include <linux/highmem.h>
+#include <linux/pagemap.h>
+#include <linux/writeback.h>
+#include "hfs.h"
+#include "hfs_received.h"
+#include "hfs_controlled.h"
+#include "hfs_lease.h"
+
+int hfs_json_hash_fields(const struct hfs_json *json, int object,
+			 const char *fields, u8 digest[32])
+{
+	struct hfs_buf original;
+	char name[64];
+	const char *p = fields;
+	u32 len, count = 0;
+	int err, token;
+
+	err = hfs_buf_init(&original, HFS_VIEW_BODY_MAX);
+	if (err)
+		return err;
+	hfs_buf_literal(&original, "{");
+	while (*p) {
+		len = strcspn(p, ",");
+		if (!len || len >= sizeof(name)) {
+			original.error = -EINVAL;
+			break;
+		}
+		memcpy(name, p, len);
+		name[len] = 0;
+		token = hfs_json_field(json, object, name);
+		if (token < 0) {
+			original.error = -EPROTO;
+			break;
+		}
+		hfs_buf_printf(&original, "%s\"%s\":", count++ ? "," : "", name);
+		hfs_buf_token(&original, json, token);
+		p += len + (p[len] == ',');
+	}
+	hfs_buf_literal(&original, "}");
+	err = original.error;
+	if (!err)
+		hfs_hash(original.data, original.len, digest);
+	hfs_buf_free(&original);
+	return err;
+}
+
+static int hfs_copy_json(const struct hfs_json *json, int token,
+			 struct hfs_json **out)
+{
+	return hfs_received_copy(json, token, out);
+}
+
+static bool hfs_token_equal(const struct hfs_json *json, int token,
+			    const void *bytes, u32 len)
+{
+	return token >= 0 && token < json->count &&
+	       json->tokens[token].end - json->tokens[token].start == len &&
+	       !memcmp(json->data + json->tokens[token].start, bytes, len);
+}
+
+static int hfs_hex32(const struct hfs_json *json, int object, const char *field,
+		     u8 digest[32])
+{
+	u32 len = 32;
+
+	if (hfs_json_hex(json, hfs_json_field(json, object, field), digest, &len) ||
+	    len != 32)
+		return -EPROTO;
+	return 0;
+}
+
+static int hfs_u64_field(const struct hfs_json *json, int object,
+			 const char *field, u64 *value)
+{
+	return hfs_json_u64(json, hfs_json_field(json, object, field), value);
+}
+
+static int hfs_normal_target(const struct hfs_json *json, int token,
+			     uuid_t *visibility)
+{
+	static const char * const hashes[] = {
+		"authority_hash", "selection_hash", "source_manifest_hash",
+	};
+	static const char * const ids[] = {
+		"sequencer_incarnation", "sequencer_node", "visibility_generation",
+	};
+	static const char * const reference_ids[] = {
+		"cluster", "configuration", "creator_incarnation", "creator_node",
+		"generation", "journal_incarnation", "origin_node", "volume",
+	};
+	u64 serial, value;
+	uuid_t id;
+	u8 hash[32];
+	u32 i;
+	int ref;
+
+	if (hfs_json_exact(json, token,
+		"authority_hash,result_ref,selection_hash,sequencer_incarnation,"
+		"sequencer_node,serial,source_manifest_hash,visibility_generation") ||
+	    hfs_u64_field(json, token, "serial", &serial))
+		return -EPROTO;
+	for (i = 0; i < ARRAY_SIZE(hashes); i++)
+		if (hfs_hex32(json, token, hashes[i], hash))
+			return -EPROTO;
+	for (i = 0; i < ARRAY_SIZE(ids); i++)
+		if (hfs_uuid(json, hfs_json_field(json, token, ids[i]), &id))
+			return -EPROTO;
+	*visibility = id;
+	ref = hfs_json_field(json, token, "result_ref");
+	if (hfs_json_is(json, ref, "null"))
+		return 0;
+	if (!serial || hfs_json_exact(json, ref,
+		"cluster,configuration,creator_incarnation,creator_node,epoch,frame_hash,"
+		"generation,journal_incarnation,kind,origin_node,sequence,volume") ||
+	    hfs_u64_field(json, ref, "epoch", &value) || !value ||
+	    hfs_u64_field(json, ref, "sequence", &value) || !value ||
+	    hfs_u64_field(json, ref, "kind", &value) || value < 1 || value > 13 ||
+	    hfs_hex32(json, ref, "frame_hash", hash))
+		return -EPROTO;
+	for (i = 0; i < ARRAY_SIZE(reference_ids); i++)
+		if (hfs_uuid(json, hfs_json_field(json, ref, reference_ids[i]), &id))
+			return -EPROTO;
+	return 0;
+}
+
+/* A CONTROLLED_LOCAL target's journal is this Context's origin journal.
+ * Context's original journal is immutable; the epoch is independently
+ * verified by the actual source provider, never guessed from Context.
+ */
+static int hfs_view_target_journal(struct hfs_session *session, const uuid_t *journal)
+{
+	struct hfs_json *context = NULL;
+	uuid_t expected;
+	int err;
+
+	err = hfs_json_parse(session->enrollment.context,
+			     session->enrollment.context_len, &context);
+	if (!err)
+		err = hfs_uuid(context, hfs_json_field(context, 0, "origin_journal"), &expected);
+	hfs_json_free(context);
+	return err || !uuid_equal(journal, &expected) ? -ESTALE : 0;
+}
+
+/* A CONTROLLED_LOCAL target {cut,kind} of this mount's scope: an exact cut
+ * with a nonzero epoch, hex hashes, this Context's hash and origin journal
+ * (its visibility generation in *visibility).
+ */
+static int hfs_view_local_target(struct hfs_session *session,
+				 const struct hfs_json *json, int token, uuid_t *visibility)
+{
+	static const char * const fields[] = {
+		"enrollment_hash", "journal_hash", "profile_hash", "state_hash",
+	};
+	u8 hash[32], context_hash[32];
+	u64 epoch, position;
+	uuid_t journal;
+	int body;
+	u32 i;
+
+	if (session->enrollment.view_scope != HFS_SCOPE_CONTROLLED_LOCAL)
+		return -ESTALE;
+	if (hfs_json_exact(json, token, "cut,kind"))
+		return -EPROTO;
+	body = hfs_json_field(json, token, "cut");
+	if (hfs_json_exact(json, body,
+		"context_hash,enrollment_hash,journal_epoch,journal_hash,"
+		"journal_incarnation,journal_position,profile_hash,state_hash,"
+		"visibility_generation") ||
+	    hfs_u64_field(json, body, "journal_epoch", &epoch) || !epoch ||
+	    hfs_u64_field(json, body, "journal_position", &position) ||
+	    hfs_uuid(json, hfs_json_field(json, body, "journal_incarnation"), &journal) ||
+	    hfs_uuid(json, hfs_json_field(json, body, "visibility_generation"), visibility) ||
+	    hfs_hex32(json, body, "context_hash", context_hash))
+		return -EPROTO;
+	hfs_hash(session->enrollment.context, session->enrollment.context_len, hash);
+	if (memcmp(hash, context_hash, 32))
+		return -ESTALE;
+	for (i = 0; i < ARRAY_SIZE(fields); i++)
+		if (hfs_hex32(json, body, fields[i], hash))
+			return -EPROTO;
+	return hfs_view_target_journal(session, &journal);
+}
+
+/* The codec half of hfs_view_target: a well-formed target of this mount's
+ * scope and Context (its visibility generation in *visibility), either
+ * CONTROLLED_LOCAL (hfs_view_local_target) or NORMAL_PUBLIC. No source
+ * proof: the provider verifies that.
+ */
+static int hfs_view_target_decode(struct hfs_session *session,
+				  const struct hfs_json *json, int token,
+				  uuid_t *visibility)
+{
+	int kind = hfs_json_field(json, token, "kind");
+
+	if (hfs_json_is(json, kind, "\"CONTROLLED_LOCAL\""))
+		return hfs_view_local_target(session, json, token, visibility);
+	if (!hfs_json_is(json, kind, "\"NORMAL_PUBLIC\""))
+		return -EPROTO;
+	if (session->enrollment.view_scope != HFS_SCOPE_NORMAL_PUBLIC)
+		return -ESTALE;
+	if (hfs_json_exact(json, token, "kind,publication") ||
+	    hfs_normal_target(json, hfs_json_field(json, token, "publication"), visibility))
+		return -EPROTO;
+	return 0;
+}
+
+int hfs_view_target(struct hfs_session *session,
+			   const struct hfs_json *json, int token,
+			   uuid_t *visibility, u8 target_hash[32])
+{
+	int err = hfs_view_target_decode(session, json, token, visibility);
+
+	/* No codec-valid cut, empty baseline or callback pointer is source proof.
+	 * The separately admitted provider must verify the full actual source.
+	 */
+	if (!err)
+		err = session->provider->target(session, json, token);
+	if (err)
+		return err;
+	hfs_hash(json->data + json->tokens[token].start,
+		 json->tokens[token].end - json->tokens[token].start, target_hash);
+	return 0;
+}
+
+/* xf4: may this session request a guest-requested view advance? Only an
+ * hfs1.4 session whose provider verifies advance candidates
+ * (provider->advance_target); every other session sends today's bytes.
+ */
+bool hfs_view_advance_supported(const struct hfs_session *session)
+{
+	return session->bridge_minor == 4 && session->provider->advance_target;
+}
+
+/* xf4: verify a GRANTED lease target (token in json) for adoption by a view
+ * installed at expected, the request's expected target: the same codec checks
+ * as hfs_view_target, AdvanceCompatible with expected
+ * (hfs_view_advance_compatible: same enrollment, profile, context, journal
+ * incarnation, epoch and visibility generation, not behind), and the
+ * provider's native advance check (hfs_received_advance: the verified
+ * receipt at the mount's fence, captured at the view's current revision,
+ * with the LIVE view still at expected). It installs nothing; hfs_view_advance
+ * does, after re-checking the view under its lock. Never the target of a
+ * reply that was already current: that is no advance, and
+ * hfs_received_advance refuses it as unverified (-EKEYREJECTED: no stale
+ * SOURCE owner).
+ */
+int hfs_view_advance_target(struct hfs_session *session, const struct hfs_json *json,
+			    int token, const struct hfs_buf *expected, uuid_t *visibility,
+			    u8 target_hash[32])
+{
+	struct hfs_json *old = NULL;
+	int err;
+
+	if (!hfs_view_advance_supported(session))
+		return -EOPNOTSUPP;
+	err = hfs_json_parse(expected->data, expected->len, &old);
+	if (!err)
+		err = hfs_view_advance_compatible(old, 0, json, token);
+	hfs_json_free(old);
+	if (!err)
+		err = hfs_view_target_decode(session, json, token, visibility);
+	if (!err)
+		err = session->provider->advance_target(session, json, token, expected);
+	if (err)
+		return err;
+	hfs_hash(json->data + json->tokens[token].start,
+		 json->tokens[token].end - json->tokens[token].start, target_hash);
+	return 0;
+}
+
+void hfs_view_ticket_put(struct hfs_view_ticket *ticket)
+{
+	struct hfs_session *session;
+	bool unused = false;
+
+	if (!ticket)
+		return;
+	session = ticket->session;
+	mutex_lock(&session->lock);
+	if (!WARN_ON_ONCE(!ticket->users))
+		ticket->users--;
+	/* A prepared package has no wire identity and was never dispatched.
+	 * Its capacity may be released locally without any counter rollback.
+	 */
+	if (!ticket->users && !ticket->number) {
+		if (!WARN_ON_ONCE(!ticket->family->prepared))
+			ticket->family->prepared--;
+		list_del(&ticket->list);
+		session->nr_view_tickets--;
+		if (ticket->control)
+			session->nr_view_control_tickets--;
+		unused = true;
+	}
+	mutex_unlock(&session->lock);
+	if (unused) {
+		hfs_buf_free(&ticket->request);
+		hfs_buf_free(&ticket->payload);
+		hfs_buf_free(&ticket->query);
+	hfs_buf_free(&ticket->original);
+	kvfree(ticket->scratch);
+		hfs_completion_close(ticket->completion);
+		session->provider->unreserve(session, ticket->reservation);
+		kfree(ticket);
+	}
+}
+
+bool hfs_view_tickets_busy(struct hfs_session *session)
+{
+	struct hfs_view_ticket *ticket;
+	struct hfs_view_family *family;
+	bool busy = false;
+
+	mutex_lock(&session->lock);
+	list_for_each_entry(ticket, &session->view_tickets, list)
+		if (ticket->users) {
+			busy = true;
+			break;
+		}
+	list_for_each_entry(family, &session->view_families, list)
+		if (family->retirement_cut)
+			busy = true;
+	mutex_unlock(&session->lock);
+	return busy;
+}
+
+void hfs_view_tickets_destroy(struct hfs_session *session)
+{
+	struct hfs_view_ticket *ticket, *next_ticket;
+	struct hfs_view_family *family, *next_family;
+
+	/* Only protected whole-session retirement or pre-transport failure calls
+	 * this path. Disconnect/close/timeout never discard these identities.
+	 */
+	list_for_each_entry(family, &session->view_families, list)
+		if (WARN_ON_ONCE(family->retirement_cut))
+			return;
+	list_for_each_entry_safe(ticket, next_ticket, &session->view_tickets, list) {
+		hfs_buf_free(&ticket->request);
+		hfs_buf_free(&ticket->payload);
+		hfs_buf_free(&ticket->query);
+	hfs_buf_free(&ticket->original);
+	kvfree(ticket->scratch);
+		hfs_json_free(ticket->response);
+		hfs_json_free(ticket->initial_response);
+		hfs_completion_close(ticket->completion);
+		session->provider->unreserve(session, ticket->reservation);
+		kfree(ticket);
+	}
+	list_for_each_entry_safe(family, next_family, &session->view_families, list) {
+		hfs_buf_free(&family->credentials);
+		session->provider->unreserve(session, family->reservation);
+		kfree(family);
+	}
+}
+
+/* One attempt at a ticket's complete charge: its 1 MiB (4 MiB unconsumed)
+ * reservation, a family record's credit and its view completion package
+ * (about 24.5 MiB with HFS_VIEW_BODY_MAX). A failed attempt keeps none.
+ */
+static int hfs_view_ticket_charge_once(struct hfs_session *session, bool control,
+				       void **credit, void **family_credit,
+				       struct hfs_completion **completion)
+{
+	int err;
+
+	err = session->provider->reserve(session, (hfs_controlled_consumed(session) ? 1ULL : 4ULL) * 1024 * 1024,
+					 control, credit);
+	if (err)
+		return err;
+	err = session->provider->reserve(session, sizeof(struct hfs_view_family) + 16384,
+					 control, family_credit);
+	if (!err) {
+		err = hfs_completion_new(session, control, true, HFS_VIEW_BODY_MAX, completion);
+		if (!err)
+			return 0;
+		session->provider->unreserve(session, *family_credit);
+	}
+	session->provider->unreserve(session, *credit);
+	*credit = *family_credit = NULL;
+	return err;
+}
+
+/* 6m4 (zq3-r21 R21-1): the ticket's whole charge, retried once after a
+ * shared retirement (hfs_retire_shared) on ENOSPC/EAGAIN, as hfs_call's
+ * requests are. Before 6m4 an acquisition under ordinary byte pressure
+ * failed ENOSPC at once while retirable requests, of this or another mount,
+ * held the bytes. Retiring requests returns only their own lane's bytes; a
+ * control ticket after ordinary retirements (or the reverse) still fails
+ * cleanly.
+ *
+ * 9n4 (zq3-r23 R23-1): the retirement generation is read before the first
+ * attempt, so a concurrent round that freed requests meanwhile also earns
+ * the one retry (hfs_retire_shared).
+ *
+ * gn4 (zq3-r24 R24-1): the shared round now also retires this session's
+ * retirable view tickets (hfs_view_retire), the only owners of control
+ * bytes besides the permanent packages; a retry that fails again is logged
+ * (hfs_retire_shared_failed), as r24's was not.
+ */
+static int hfs_view_ticket_charge(struct hfs_session *session, bool control, void **credit,
+				  void **family_credit, struct hfs_completion **completion)
+{
+	unsigned int since = hfs_retire_generation();
+	int err = hfs_view_ticket_charge_once(session, control, credit, family_credit,
+					      completion);
+
+	if ((err == -ENOSPC || err == -EAGAIN) && !hfs_retire_shared(session, control, since)) {
+		err = hfs_view_ticket_charge_once(session, control, credit, family_credit,
+						  completion);
+		if (err)
+			hfs_retire_shared_failed(session, control, err);
+	}
+	return err;
+}
+
+int hfs_view_ticket_prepare(struct hfs_session *session, const struct hfs_cred *cred,
+			bool control, struct hfs_view_ticket **out)
+{
+	struct hfs_view_ticket *ticket;
+	struct hfs_view_family *family, *candidate;
+	struct hfs_completion *completion = NULL;
+	void *credit, *family_credit;
+	int err;
+
+	*out = NULL;
+	if (session->bridge_minor != 1 && session->bridge_minor != 4)
+		return -EOPNOTSUPP;
+	err = hfs_view_ticket_charge(session, control, &credit, &family_credit, &completion);
+	if (err)
+		return err;
+	ticket = kzalloc(sizeof(*ticket), GFP_KERNEL);
+	candidate = kzalloc(sizeof(*candidate), GFP_KERNEL);
+	if (!ticket || !candidate) {
+		err = -ENOMEM;
+		goto allocation;
+	}
+	ticket->completion = completion;
+	completion = NULL;
+	ticket->reservation = credit;
+	candidate->reservation = family_credit;
+	INIT_LIST_HEAD(&ticket->list);
+	INIT_LIST_HEAD(&candidate->list);
+	if (hfs_buf_init(&candidate->credentials, 16384) ||
+	    hfs_buf_init(&ticket->request, 32768) ||
+	    hfs_buf_init(&ticket->payload, HFS_VIEW_BODY_MAX) ||
+	    hfs_buf_init(&ticket->query, 32768) ||
+	    hfs_buf_init(&ticket->original, HFS_VIEW_BODY_MAX)) {
+		err = -ENOMEM;
+		goto buffers;
+	}
+	ticket->scratch = kvcalloc(4096, sizeof(*ticket->scratch), GFP_KERNEL);
+	if (!ticket->scratch) {
+		err = -ENOMEM;
+		goto buffers;
+	}
+	hfs_cred_write(&candidate->credentials, cred);
+	if (candidate->credentials.error) {
+		err = candidate->credentials.error;
+		goto buffers;
+	}
+	hfs_hash(candidate->credentials.data, candidate->credentials.len, candidate->hash);
+	mutex_init(&candidate->dispatch);
+	init_waitqueue_head(&candidate->wait);
+	candidate->next = 1;
+	candidate->control = control;
+	candidate->nonce = control ? session->enrollment.view_control_nonce :
+				    session->enrollment.nonce;
+	candidate->anchor = session->enrollment.anchor;
+	if (session->bridge_minor == 4) {
+		candidate->anchor = control ? session->enrollment.control_anchor :
+					       session->enrollment.acquisition_anchor;
+		if (!control)
+			candidate->nonce = session->enrollment.acquisition_nonce;
+	}
+	mutex_lock(&session->lock);
+	if ((control && session->nr_view_control_tickets == HFS_VIEW_CONTROL_TICKETS_MAX) ||
+	    (!control && session->nr_view_tickets - session->nr_view_control_tickets ==
+			HFS_VIEW_TICKETS_MAX)) {
+		err = -ENOSPC;
+		goto unlock;
+	}
+	list_for_each_entry(family, &session->view_families, list)
+		if (family->control == control &&
+		    !memcmp(family->hash, candidate->hash, 32) &&
+		    family->credentials.len == candidate->credentials.len &&
+		    !memcmp(family->credentials.data, candidate->credentials.data,
+			    family->credentials.len))
+			goto found;
+	if (session->nr_view_families == HFS_VIEW_FAMILIES_MAX) {
+		err = -ENOSPC;
+		goto unlock;
+	}
+	family = candidate;
+	candidate = NULL;
+	list_add_tail(&family->list, &session->view_families);
+	session->nr_view_families++;
+found:
+	/* Reserve finite number capacity without assigning a wire identity.
+	 * Mandatory deferred controls cannot discover wrap only after dirtying.
+	 */
+	if (family->next >= U64_MAX - family->prepared) {
+		err = -EOVERFLOW;
+		goto unlock;
+	}
+	family->prepared++;
+	ticket->family = family;
+	ticket->session = session;
+	spin_lock_init(&ticket->admission_lock);
+	ticket->users = 1;
+	ticket->control = control;
+	/* Resource ownership is distinct from a numbered wire admission. */
+	list_add_tail(&ticket->list, &session->view_tickets);
+	session->nr_view_tickets++;
+	if (control)
+		session->nr_view_control_tickets++;
+	err = 0;
+	*out = ticket;
+	mutex_unlock(&session->lock);
+	if (candidate) {
+		hfs_buf_free(&candidate->credentials);
+		session->provider->unreserve(session, candidate->reservation);
+		kfree(candidate);
+	}
+	return err;
+unlock:
+	mutex_unlock(&session->lock);
+buffers:
+	if (candidate)
+		hfs_buf_free(&candidate->credentials);
+	hfs_buf_free(&ticket->request);
+	hfs_buf_free(&ticket->payload);
+	hfs_buf_free(&ticket->query);
+	hfs_buf_free(&ticket->original);
+	kvfree(ticket->scratch);
+allocation:
+	if (ticket)
+		hfs_completion_close(ticket->completion);
+	hfs_completion_close(completion); /* not yet moved into the ticket */
+	kfree(candidate);
+	kfree(ticket);
+	session->provider->unreserve(session, family_credit);
+	session->provider->unreserve(session, credit);
+	return err;
+}
+
+int hfs_view_ticket_activate(struct hfs_view_ticket *ticket)
+{
+	struct hfs_session *session = ticket->session;
+	struct hfs_view_family *family = ticket->family;
+	int err = 0;
+
+	if (READ_ONCE(ticket->number))
+		return 0;
+retry:
+	mutex_lock(&family->dispatch);
+	if (family->initial && family->initial != ticket) {
+		mutex_unlock(&family->dispatch);
+		err = wait_event_killable(family->wait, !READ_ONCE(family->initial));
+		if (err)
+			return err;
+		goto retry;
+	}
+
+	mutex_lock(&session->lock);
+	if (ticket->number)
+		goto out;
+	if (WARN_ON_ONCE(!family->prepared || family->next == U64_MAX)) {
+		err = -EOVERFLOW;
+		goto out;
+	}
+	family->prepared--;
+	ticket->number = family->next++;
+	WRITE_ONCE(family->initial, ticket);
+	hfs_buf_printf(&ticket->request, "{\"anchor\":\"%pUb\",\"credentials\":",
+		       &family->anchor);
+	hfs_buf_add(&ticket->request, family->credentials.data, family->credentials.len);
+	hfs_buf_printf(&ticket->request, ",\"nonce\":\"%pUb\",\"number\":%llu}",
+		       &family->nonce, ticket->number);
+	hfs_buf_literal(&ticket->query, "{\"request\":");
+	hfs_buf_add(&ticket->query, ticket->request.data, ticket->request.len);
+	hfs_buf_literal(&ticket->query, "}");
+	/* Number assignment order is the retirement order, regardless of when
+	 * a future freeze package reserved its resources.
+	 */
+	list_move_tail(&ticket->list, &session->view_tickets);
+	err = ticket->request.error ?: ticket->query.error;
+out:
+	mutex_unlock(&session->lock);
+	mutex_unlock(&family->dispatch);
+	return err;
+}
+
+static int hfs_ticket_union(struct hfs_view_ticket *ticket,
+			    const struct hfs_json *json, int body,
+			    const char *wire_operation)
+{
+	int status = hfs_json_field(json, body, "status");
+	bool lease = !hfs_json_is(json, hfs_json_field(json, body, "lease"), "null");
+	bool reservation = !hfs_json_is(json, hfs_json_field(json, body, "reservation"), "null");
+	bool entry = !hfs_json_is(json, hfs_json_field(json, body, "entry"), "null");
+	const char *original = ticket->operation;
+	bool query = !strcmp(wire_operation, "VIEW_QUERY");
+	bool cancel = !strcmp(wire_operation, "VIEW_CANCEL");
+
+	if (hfs_json_is(json, status, "\"PENDING\"") ||
+	    hfs_json_is(json, status, "\"INDETERMINATE\"") ||
+	    hfs_json_is(json, status, "\"BLOCKED\"") ||
+	    hfs_json_is(json, status, "\"RETIRED_ID\""))
+		return lease || reservation || entry ? -EPROTO : 0;
+	if (hfs_json_is(json, status, "\"CANCELLED\""))
+		return (!query && !cancel) || lease || reservation || entry ? -EPROTO : 0;
+	if (cancel)
+		return -EPROTO;
+	if (hfs_json_is(json, status, "\"RELEASED\""))
+		return strcmp(original, "VIEW_RELEASE") || lease || reservation || entry ? -EPROTO : 0;
+	if (hfs_json_is(json, status, "\"FROZEN\""))
+		return strcmp(original, "DIRTY_FREEZE") || lease || reservation || !entry ? -EPROTO : 0;
+	if (!hfs_json_is(json, status, "\"GRANTED\"") || entry)
+		return -EPROTO;
+	if (!strcmp(original, "VIEW_ACQUIRE") || !strcmp(original, "VIEW_RENEW"))
+		return !lease || reservation ? -EPROTO : 0;
+	return strcmp(original, "DIRTY_RESERVE") || lease || !reservation ? -EPROTO : 0;
+}
+
+static int hfs_ticket_reply(struct hfs_view_ticket *ticket,
+			    const struct hfs_json *json, int payload,
+			    const char *wire_operation)
+{
+	u8 expected[32], actual[32];
+	char operation[24];
+	int err;
+
+	if (hfs_json_exact(json, payload,
+		"entry,id,lease,operation,request,request_hash,reservation,status") ||
+	    !hfs_token_equal(json, hfs_json_field(json, payload, "request"),
+			     ticket->request.data, ticket->request.len) ||
+	    hfs_json_string(json, hfs_json_field(json, payload, "operation"),
+			    operation, sizeof(operation)) < 0 ||
+	    strcmp(operation, ticket->operation) ||
+	    hfs_hex32(json, payload, "request_hash", expected) ||
+	    memcmp(expected, ticket->request_hash, 32) ||
+	    hfs_hex32(json, payload, "id", expected))
+		return -EPROTO;
+	err = hfs_json_hash_fields(json, payload,
+		"entry,lease,operation,request,request_hash,reservation,status", actual);
+	if (err || memcmp(expected, actual, 32))
+		return err ?: -EPROTO;
+	return hfs_ticket_union(ticket, json, payload, wire_operation);
+}
+
+int hfs_view_query(struct hfs_session *session, struct hfs_view_ticket *ticket,
+		    bool cancel, struct hfs_json **response)
+{
+	struct hfs_json *reply = NULL;
+	const char *operation = cancel ? "VIEW_CANCEL" : "VIEW_QUERY";
+	unsigned long flags;
+	int err, body = -1;
+
+	*response = NULL;
+	if (!ticket->bound)
+		return -EAGAIN;
+	if (cancel) {
+		/* This API is only for never-published work. Real cache rights are
+		 * released after their separate physical revocation path.
+		 */
+		spin_lock_irqsave(&ticket->admission_lock, flags);
+		if (ticket->published) {
+			spin_unlock_irqrestore(&ticket->admission_lock, flags);
+			return -EBUSY;
+		}
+		ticket->closed = true;
+		spin_unlock_irqrestore(&ticket->admission_lock, flags);
+	}
+	mutex_lock(&ticket->family->dispatch);
+	err = hfs_control(session, operation, &ticket->query, true, &reply);
+	if (!err) {
+		body = hfs_json_field(reply, 0, "payload");
+		err = hfs_ticket_reply(ticket, reply, body, operation);
+		if (!err && !ticket->admitted) {
+			ticket->admitted = true;
+			WRITE_ONCE(ticket->family->initial, NULL);
+			wake_up_all(&ticket->family->wait);
+		}
+	}
+	mutex_unlock(&ticket->family->dispatch);
+	if (err) {
+		hfs_json_free(reply);
+		if (err == -EPROTO)
+			hfs_session_block(session, "invalid view ticket reply", operation, err);
+		return err;
+	}
+	if (!err)
+		err = hfs_copy_json(reply, body, response);
+	if (!err && hfs_json_is(reply, hfs_json_field(reply, body, "status"),
+				"\"CANCELLED\"")) {
+		struct hfs_json *closure = NULL;
+
+		err = hfs_copy_json(reply, body, &closure);
+		if (!err) {
+			/* Retirement follows Current; initial admission stays immutable. */
+			hfs_json_free(ticket->response);
+			ticket->response = closure;
+			ticket->terminal = true;
+		}
+	}
+	hfs_json_free(reply);
+	if (err == -EPROTO)
+		hfs_session_block(session, "invalid view ticket closure", operation, err);
+	return err;
+}
+
+/* 2f4 (zq3-r17 R17-1): the host grants a PENDING VIEW_ACQUIRE lazily, on
+ * the first VIEW_QUERY after the recall that held it completed (readmit,
+ * internal/viewcontrol/tickets.go), i.e. right after it accepted this
+ * mount's REOPENED ACK. The guest raises its current_fence only when that
+ * ACK's reply arrives (hfs_controlled_after_ack), so a GRANTED reply at the
+ * new fence, or one captured at the revision before the REOPEN, can be
+ * verified but not current (hfs_received_source_ex). Before 2f4 that was
+ * -EKEYREJECTED and blocked the session. Re-sending VIEW_QUERY for a
+ * GRANTED ticket returns the stored reply unchanged: no new ticket,
+ * identity or lease. One exchange's settle state: the view->reopen_acks
+ * and view->revision of the last re-query.
+ */
+struct hfs_grant_settle {
+	unsigned long acks;
+	u64 revision;
+	bool requeried;
+};
+
+/* Only a lease VIEW_ACQUIRE's GRANTED waits for the view to settle. A
+ * DIRTY_RESERVE/DIRTY_FREEZE source is current only while the view is
+ * QUIESCENT/STOPPED, so a wait for LIVE would only time out; those keep
+ * failing closed.
+ */
+static bool hfs_view_lease_grant(const struct hfs_view_ticket *ticket,
+				 const struct hfs_json *reply, int body)
+{
+	return !strcmp(ticket->operation, "VIEW_ACQUIRE") &&
+	       hfs_json_is(reply, hfs_json_field(reply, body, "status"), "\"GRANTED\"") &&
+	       !hfs_json_is(reply, hfs_json_field(reply, body, "lease"), "null");
+}
+
+/* One look at the view for a verified GRANTED lease at fence that is not
+ * current: 1 to query again (the view is LIVE or UNBOUND at the lease's
+ * fence and moved since the last re-query), -EXDEV (a later recall passed
+ * the lease: the mount's fence is beyond it), -EPROTO (settled and
+ * unchanged since a re-query that still was not current: fail closed as
+ * before 2f4), -EAGAIN (not settled yet: wait) or a stop (-EHOSTDOWN for a
+ * refused view, a mount no longer admissible or the poll halt; review 1:
+ * not -ESTALE, which hfs_lease_acquire_ex treats as a stale grant and
+ * blocks on).
+ */
+static int hfs_view_grant_look(struct hfs_session *session, struct hfs_view *view,
+			       u64 fence, struct hfs_grant_settle *settle,
+			       unsigned long acks)
+{
+	enum hfs_view_phase phase;
+	unsigned long flags;
+	u64 current_fence, revision;
+	int err;
+
+	if (hfs_view_refused(view))
+		return -EHOSTDOWN;
+	err = hfs_session_poll_halt(session, false);
+	if (err)
+		return err;
+	current_fence = hfs_controlled_current_fence(session);
+	if (!current_fence)
+		return -EHOSTDOWN;
+	if (current_fence > fence)
+		return -EXDEV;
+	spin_lock_irqsave(&view->lock, flags);
+	phase = view->phase;
+	revision = view->revision;
+	spin_unlock_irqrestore(&view->lock, flags);
+	if (current_fence < fence ||
+	    (phase != HFS_VIEW_LIVE && phase != HFS_VIEW_UNBOUND))
+		return -EAGAIN;
+	if (settle->requeried && settle->acks == acks && settle->revision == revision)
+		return -EPROTO;
+	settle->requeried = true;
+	settle->acks = acks;
+	settle->revision = revision;
+	return 1;
+}
+
+/* 2f4: wait (event-driven, hfs_view_reopen_wait) within the exchange's
+ * deadline until the view is LIVE and the mount's fence reached the lease's,
+ * then return 1 to query the ticket again; the fresh capture of that query
+ * validates the stored reply. -EPROTO blocks as an invalid reply. Every
+ * other outcome (-EXDEV: a later recall passed the lease; -ETIMEDOUT,
+ * -EINTR, -EHOSTDOWN: the wait stopped) hands the GRANTED out without a
+ * block: the host holds an active lease with a reserved release credit, so
+ * hfs_lease_acquire_ex builds it unadopted for the caller to release (review
+ * 1; before, a stop left the ticket uncertain and the lease unreleased).
+ * One rate-limited line per outcome.
+ */
+static int hfs_view_grant_settle(struct hfs_session *session, const struct hfs_json *reply,
+				 int body, unsigned long deadline,
+				 struct hfs_grant_settle *settle)
+{
+	struct hfs_view *view = hfs_view_get(session);
+	unsigned long acks;
+	u64 fence;
+	int err;
+
+	if (!view)
+		return -EHOSTDOWN;
+	if (hfs_u64_field(reply, hfs_json_field(reply, body, "lease"), "fence", &fence) ||
+	    !fence) {
+		hfs_view_put(view);
+		return -EPROTO;
+	}
+	pr_info_ratelimited("9p-hfs: session %pUb VIEW_ACQUIRE GRANTED at fence %llu is not current (mount fence %llu, view %s); querying again once the view settles\n",
+			    &session->enrollment.session, fence,
+			    hfs_controlled_current_fence(session),
+			    hfs_view_phase_name(READ_ONCE(view->phase)));
+	for (;;) {
+		/* Read before the look: an ACK accepted after it still wakes. */
+		acks = READ_ONCE(view->reopen_acks);
+		err = hfs_view_grant_look(session, view, fence, settle, acks);
+		if (err == 1 && !time_before(jiffies, deadline))
+			err = -ETIMEDOUT;
+		if (err != -EAGAIN)
+			break;
+		err = hfs_view_reopen_wait(view, acks, deadline);
+		if (err)
+			break;
+	}
+	if (err == -EXDEV)
+		pr_info_ratelimited("9p-hfs: session %pUb VIEW_ACQUIRE GRANTED at fence %llu was passed by a later recall; releasing it and acquiring again (-EXDEV)\n",
+				    &session->enrollment.session, fence);
+	else if (err == -ETIMEDOUT)
+		pr_warn_ratelimited("9p-hfs: session %pUb VIEW_ACQUIRE GRANTED at fence %llu: view did not settle before the exchange deadline (-ETIMEDOUT)\n",
+				    &session->enrollment.session, fence);
+	hfs_view_put(view);
+	return err;
+}
+
+/* xf4: does the lease of this GRANTED reply name another target than the
+ * ticket's own VIEW_ACQUIRE expected (a nonnull "target" of the bound
+ * payload)? Only asked for an advance ticket: 1 moved, 0 not, or the
+ * error of parsing the payload (memory). 4h4 review round 1: an error is
+ * not taken as "moved"; the caller hands the reply out to be built
+ * unadopted and released, so the granted host lease never leaks.
+ */
+static int hfs_view_grant_moved(const struct hfs_view_ticket *ticket,
+				const struct hfs_json *reply, int body)
+{
+	int granted = hfs_json_field(reply, hfs_json_field(reply, body, "lease"), "target");
+	struct hfs_json *request = NULL;
+	int expected, moved = 0;
+	int err = hfs_json_parse(ticket->payload.data, ticket->payload.len, &request);
+
+	if (err)
+		return err;
+	expected = hfs_json_field(request, 0, "target");
+	if (expected >= 0 && !hfs_json_is(request, expected, "null"))
+		moved = !hfs_token_equal(reply, granted,
+					 request->data + request->tokens[expected].start,
+					 request->tokens[expected].end -
+					 request->tokens[expected].start);
+	hfs_json_free(request);
+	return moved;
+}
+
+/* The hfs1.4 source check of a GRANTED/FROZEN reply (0 or older minors: no
+ * check). 2f4: a verified lease GRANTED that is not current goes to
+ * hfs_view_grant_settle (1: query again; -EXDEV and its stops: the GRANTED
+ * is handed out unadopted); every other failure, DIRTY_RESERVE/DIRTY_FREEZE
+ * ones included, stays fatal (*fatal): the exchange blocks the session as
+ * before.
+ *
+ * xf4: an advance ticket's GRANTED on another target than its expected one
+ * is never current at receipt (the view still holds the expected target).
+ * Waiting for the view to settle would only end in -EPROTO, so it is handed
+ * out at once (0, not fatal): hfs_lease_decode classifies it as an advance
+ * candidate (hfs_view_advance_target) or builds it unadopted for release
+ * (-EXDEV). If the comparison itself fails (memory), it is handed out with
+ * -EXDEV, built unadopted and released. Without advance such a reply
+ * settles and fails closed as before.
+ */
+static int hfs_view_exchange_source(struct hfs_session *session,
+				    const struct hfs_view_ticket *ticket,
+				    const struct hfs_json *reply, int body,
+				    unsigned long deadline,
+				    struct hfs_grant_settle *settle, bool *fatal)
+{
+	int status = hfs_json_field(reply, body, "status"), source, err, moved;
+	bool not_current;
+
+	*fatal = true;
+	if (session->bridge_minor != 4 ||
+	    (!hfs_json_is(reply, status, "\"GRANTED\"") &&
+	     !hfs_json_is(reply, status, "\"FROZEN\"")))
+		return 0;
+	source = hfs_json_field(reply, body, "lease");
+	if (hfs_json_is(reply, source, "null"))
+		source = hfs_json_field(reply, body, "reservation");
+	if (hfs_json_is(reply, source, "null"))
+		source = hfs_json_field(reply, body, "entry");
+	err = hfs_received_source_ex(session, reply, source, &not_current);
+	if (!err || !not_current || !hfs_view_lease_grant(ticket, reply, body))
+		return err;
+	if (ticket->advance) {
+		moved = hfs_view_grant_moved(ticket, reply, body);
+		if (moved) {
+			/* An error (moved < 0) hands it out for release only:
+			 * hfs_lease_acquire_ex builds it unadopted on -EXDEV.
+			 */
+			*fatal = false;
+			return moved < 0 ? -EXDEV : 0;
+		}
+	}
+	err = hfs_view_grant_settle(session, reply, body, deadline, settle);
+	*fatal = err == -EPROTO;
+	return err;
+}
+
+/* One hfs_view_exchange's wire state: the next request (op, sent, control),
+ * its oc4 poll-halt exemption, the 30 s deadline and the 2f4 settle state.
+ * op is the command itself only until the ticket is admitted; every later
+ * round is a VIEW_QUERY of the ticket (hfs_view_round_query).
+ */
+struct hfs_view_round {
+	const char *op;
+	const struct hfs_buf *sent;
+	bool control;
+	/* oc4: the VIEW_QUERY polls serve the command, so they share its
+	 * exemption from stopping on a blocked session.
+	 */
+	bool after_block;
+	unsigned long deadline;
+	struct hfs_grant_settle settle;
+};
+
+static void hfs_view_round_query(struct hfs_view_round *round,
+				 const struct hfs_view_ticket *ticket)
+{
+	round->op = "VIEW_QUERY";
+	round->sent = &ticket->query;
+	round->control = true;
+}
+
+/* Bind an unbound ticket to operation and payload (the payload's request
+ * must be the ticket's; the hashed original request and the payload are
+ * kept), or check that a bound ticket is re-sent with exactly the
+ * operation and payload it was bound to (-ESTALE otherwise).
+ */
+static int hfs_view_exchange_bind(struct hfs_view_ticket *ticket, const char *operation,
+				  const struct hfs_buf *payload)
+{
+	struct hfs_buf *original = &ticket->original;
+	struct hfs_json request;
+	int err;
+
+	if (ticket->bound) {
+		if (strcmp(ticket->operation, operation) ||
+		    ticket->payload.len != payload->len ||
+		    memcmp(ticket->payload.data, payload->data, payload->len))
+			return -ESTALE;
+		return 0;
+	}
+	err = hfs_json_parse_into(payload->data, payload->len, &request,
+				  ticket->scratch, 4096);
+	if (!err && !hfs_token_equal(&request,
+		hfs_json_field(&request, 0, "request"),
+		ticket->request.data, ticket->request.len))
+		err = -EPROTO;
+	if (err)
+		return err;
+	original->len = 0;
+	original->error = 0;
+	hfs_buf_printf(original, "{\"op\":\"%s\",\"payload\":", operation);
+	hfs_buf_add(original, payload->data, payload->len);
+	hfs_buf_literal(original, "}");
+	err = original->error;
+	if (!err) {
+		hfs_hash(original->data, original->len, ticket->request_hash);
+		hfs_buf_add(&ticket->payload, payload->data, payload->len);
+		err = ticket->payload.error;
+	}
+	if (err)
+		return err;
+	strscpy(ticket->operation, operation, sizeof(ticket->operation));
+	ticket->bound = true;
+	return 0;
+}
+
+/* Send one round and check its reply (*reply, payload object *body).
+ * Initial admissions are serialized per family, but terminal waits do not
+ * own that mutex. Retries after protected initial observation QUERY
+ * Current; they never reinterpret Initial GRANTED as fresh authority.
+ *
+ * Returns the transport error (the ticket is then uncertain and nothing
+ * else happened); *check is the reply check's error (hfs_ticket_reply, or
+ * the copy of an initial response), which the caller blocks on.
+ */
+static int hfs_view_exchange_send(struct hfs_session *session,
+				  struct hfs_view_ticket *ticket,
+				  const struct hfs_view_round *round,
+				  struct hfs_json **reply, int *body, int *check)
+{
+	bool initial = !ticket->admitted;
+	int err;
+
+	*check = 0;
+	if (initial)
+		mutex_lock(&ticket->family->dispatch);
+	err = hfs_control_flagged(session, round->op, round->sent, round->control,
+				  round->after_block, reply);
+	if (err) {
+		if (initial)
+			mutex_unlock(&ticket->family->dispatch);
+		ticket->uncertain = true;
+		return err;
+	}
+	*body = hfs_json_field(*reply, 0, "payload");
+	err = hfs_ticket_reply(ticket, *reply, *body, round->op);
+	if (initial) {
+		if (!err) {
+			ticket->admitted = true;
+			WRITE_ONCE(ticket->family->initial, NULL);
+			wake_up_all(&ticket->family->wait);
+			if (!ticket->initial_response)
+				err = hfs_copy_json(*reply, *body, &ticket->initial_response);
+		}
+		mutex_unlock(&ticket->family->dispatch);
+	}
+	*check = err;
+	return 0;
+}
+
+/* A status that ends the exchange with the reply as its response. */
+static bool hfs_view_terminal_status(const struct hfs_json *reply, int status)
+{
+	return hfs_json_is(reply, status, "\"GRANTED\"") ||
+	       hfs_json_is(reply, status, "\"FROZEN\"") ||
+	       hfs_json_is(reply, status, "\"RELEASED\"") ||
+	       hfs_json_is(reply, status, "\"CANCELLED\"") ||
+	       hfs_json_is(reply, status, "\"BLOCKED\"");
+}
+
+/* A terminal reply: check its source (hfs_view_exchange_source), then hand
+ * it out in *response and keep it as the ticket's Current (ticket->response,
+ * terminal). 1: the view settled, query the ticket again (2f4). Otherwise
+ * the exchange's result: 0, -ECANCELED (CANCELLED), -EAGAIN (the host's
+ * terminal BLOCKED; re4's *blocked in hfs_lease_acquire_ex), the settle
+ * outcome of a verified GRANTED that is handed out unadopted for release
+ * only (2f4), or -ENOMEM when *response was copied but ticket->response
+ * was not (a GRANTED is then handed out too, with the ticket not
+ * terminal; hfs_lease_acquire_ex builds it unadopted for release; this
+ * predates 5f4, which only documents it).
+ * *invalid: the caller blocks the session on the error.
+ */
+static int hfs_view_exchange_terminal(struct hfs_session *session,
+				      struct hfs_view_ticket *ticket,
+				      const struct hfs_json *reply, int body,
+				      struct hfs_view_round *round,
+				      struct hfs_json **response, bool *invalid)
+{
+	int status = hfs_json_field(reply, body, "status"), result, err;
+	bool fatal;
+
+	*invalid = true;
+	err = hfs_view_exchange_source(session, ticket, reply, body, round->deadline,
+				       &round->settle, &fatal);
+	if (err == 1 || (err && fatal)) {
+		*invalid = err != 1;
+		return err;
+	}
+	result = err;
+	err = hfs_copy_json(reply, body, response);
+	if (err)
+		return err;
+	*invalid = false;
+	hfs_json_free(ticket->response);
+	err = hfs_copy_json(reply, body, &ticket->response);
+	ticket->terminal = !err;
+	if (!err && hfs_json_is(reply, status, "\"CANCELLED\""))
+		err = -ECANCELED;
+	if (!err && hfs_json_is(reply, status, "\"BLOCKED\""))
+		err = -EAGAIN;
+	/* 2f4: the caller gets the lease to release (hfs_lease_acquire_ex),
+	 * with the settle outcome.
+	 */
+	if (!err && result)
+		err = result;
+	return err;
+}
+
+/* A non-terminal reply carries no source. 0: PENDING or INDETERMINATE,
+ * poll again; -EAGAIN: RETIRED_ID (and BLOCKED, which
+ * hfs_view_terminal_status already takes: kept as before the split);
+ * -EPROTO with *invalid for anything else.
+ */
+static int hfs_view_exchange_pending(const struct hfs_json *reply, int body, bool *invalid)
+{
+	int status = hfs_json_field(reply, body, "status");
+
+	*invalid = true;
+	if (!hfs_json_is(reply, hfs_json_field(reply, body, "entry"), "null") ||
+	    !hfs_json_is(reply, hfs_json_field(reply, body, "lease"), "null") ||
+	    !hfs_json_is(reply, hfs_json_field(reply, body, "reservation"), "null"))
+		return -EPROTO;
+	if (hfs_json_is(reply, status, "\"BLOCKED\"") ||
+	    hfs_json_is(reply, status, "\"RETIRED_ID\"")) {
+		*invalid = false;
+		return -EAGAIN;
+	}
+	if (!hfs_json_is(reply, status, "\"PENDING\"") &&
+	    !hfs_json_is(reply, status, "\"INDETERMINATE\""))
+		return -EPROTO;
+	*invalid = false;
+	return 0;
+}
+
+/* Before the next VIEW_QUERY poll: -ETIMEDOUT at the deadline, a short
+ * sleep, then the poll halt; the ticket stays uncertain on either stop.
+ */
+static int hfs_view_exchange_poll(struct hfs_session *session,
+				  struct hfs_view_ticket *ticket,
+				  struct hfs_view_round *round)
+{
+	int err;
+
+	if (time_after_eq(jiffies, round->deadline)) {
+		ticket->uncertain = true;
+		return -ETIMEDOUT;
+	}
+	usleep_range(10000, 12000);
+	/* oc4 (zq3-r12 R12-1): no further VIEW_QUERY round once the session
+	 * is blocked; the ticket stays uncertain, as for a timeout.
+	 */
+	err = hfs_session_poll_halt(session, round->after_block);
+	if (err) {
+		ticket->uncertain = true;
+		return err;
+	}
+	hfs_view_round_query(round, ticket);
+	return 0;
+}
+
+/* One round of hfs_view_exchange: send it, classify its reply
+ * (hfs_view_exchange_terminal or hfs_view_exchange_pending) and prepare the
+ * next one. 1: send the next round (round is set up for it); otherwise the
+ * exchange's result. *invalid: the caller marks the ticket uncertain and
+ * blocks the session on that error, then frees *reply (kept for it);
+ * otherwise *reply is already freed or was never set (a transport error,
+ * which leaves the ticket uncertain without a block).
+ */
+static int hfs_view_exchange_round(struct hfs_session *session,
+				   struct hfs_view_ticket *ticket,
+				   struct hfs_view_round *round, struct hfs_json **response,
+				   struct hfs_json **reply, bool *invalid)
+{
+	bool terminal;
+	int err, body, check;
+
+	*invalid = false;
+	err = hfs_view_exchange_send(session, ticket, round, reply, &body, &check);
+	if (err)
+		return err;
+	*invalid = true;
+	if (check)
+		return check;
+	terminal = hfs_view_terminal_status(*reply, hfs_json_field(*reply, body, "status"));
+	if (terminal)
+		err = hfs_view_exchange_terminal(session, ticket, *reply, body, round,
+						 response, invalid);
+	else
+		err = hfs_view_exchange_pending(*reply, body, invalid);
+	if (*invalid)
+		return err;
+	hfs_json_free(*reply);
+	*reply = NULL;
+	if (err == 1) { /* 2f4: the view settled; query the ticket again. */
+		hfs_view_round_query(round, ticket);
+		return 1;
+	}
+	if (err || terminal)
+		return err;
+	return hfs_view_exchange_poll(session, ticket, round) ?: 1;
+}
+
+/* One view command (not VIEW_QUERY/VIEW_CANCEL) on ticket: bind it, send
+ * it until admitted, then poll it with VIEW_QUERY until a terminal reply,
+ * the deadline or a stop. Split for 5f4 (the 50-line rule) without changes
+ * in order, locking or error paths: hfs_view_exchange_round runs one round
+ * (hfs_view_exchange_send sends it, hfs_view_exchange_terminal and
+ * hfs_view_exchange_pending classify the reply, hfs_view_exchange_poll
+ * waits before the next VIEW_QUERY).
+ */
+int hfs_view_exchange(struct hfs_session *session, struct hfs_view_ticket *ticket,
+		      const char *operation, const struct hfs_buf *payload,
+		      struct hfs_json **response)
+{
+	struct hfs_json *reply = NULL;
+	struct hfs_view_round round = {
+		.op = operation, .sent = &ticket->payload,
+		.control = hfs_view_command_control(operation),
+		.after_block = hfs_after_block_operation(operation),
+		.deadline = jiffies + 30 * HZ,
+	};
+	bool invalid;
+	int err;
+
+	*response = NULL;
+	if (!ticket->number || !hfs_view_command(operation) || payload->error ||
+	    hfs_view_command_control_family(operation) != ticket->control ||
+	    !strcmp(operation, "VIEW_QUERY") || !strcmp(operation, "VIEW_CANCEL"))
+		return -EINVAL;
+	err = hfs_view_exchange_bind(ticket, operation, payload);
+	if (err)
+		return err;
+	if (ticket->admitted)
+		hfs_view_round_query(&round, ticket);
+	do {
+		err = hfs_view_exchange_round(session, ticket, &round, response, &reply,
+					      &invalid);
+	} while (err == 1);
+	if (!invalid)
+		return err;
+	/* op is VIEW_QUERY once the initial command was admitted (the zq3
+	 * "VIEW_QUERY uncertain" case), otherwise the command itself.
+	 */
+	ticket->uncertain = true;
+	hfs_session_block(session, "uncertain view ticket", round.op, err);
+	hfs_json_free(reply);
+	return err;
+}
+
+/* The target of a decoded GRANTED lease (token in response).
+ * - Equal to the request's expected target (or none expected): verified
+ *   natively (hfs_view_target), as before xf4.
+ * - Another target without advance: -ESTALE, the caller blocks the session.
+ * - xf4, another target on an advance request: an advance candidate when
+ *   hfs_view_advance_target verifies it for the view still installed at the
+ *   expected target (lease->advance; hfs_view_advance adopts it). Failing
+ *   that, an ordinary lease when the view already holds exactly that target
+ *   and the reply is current for it (hfs_view_target: a replay after the
+ *   adoption, or a readmitted PENDING ticket whose recall reinstalled the
+ *   view at the granted cut; host review annotation (b)). The caller's
+ *   stamp predates that move, so hfs_mmap_publish refuses it (-EXDEV) and
+ *   the observation holds it, acquires again and releases it, as for any
+ *   grant the view moved past (ie4); nothing is served under it. Otherwise
+ *   (the view moved elsewhere: a further move after a replay, another cut
+ *   reinstalled, a passed fence) it is built unadopted for release;
+ *   hfs_lease_acquire_ex returns -EXDEV and nothing blocks. The VIEW_QUERY
+ *   reply of a readmitted ticket gets no target check from the bridge or the
+ *   codec policy (no original request there), so this is its only gate.
+ * - 2f4 review 1: an unadopted GRANTED is not current, so the provider's
+ *   target check (hfs_controlled_target -> hfs_received_selected) refuses it
+ *   by design. It is only ever released: keep its bytes and hash, no
+ *   verified visibility, and mark it so no authority path takes it.
+ */
+static int hfs_lease_decode_target(struct hfs_session *session,
+				   const struct hfs_view_ticket *ticket,
+				   const struct hfs_json *response, int token,
+				   const struct hfs_buf *expected_target, bool unadopted,
+				   struct hfs_lease *lease)
+{
+	bool moved = expected_target &&
+		!hfs_token_equal(response, token, expected_target->data, expected_target->len);
+
+	if (moved && !ticket->advance)
+		return -ESTALE;
+	if (moved && !unadopted) {
+		if (!hfs_view_advance_target(session, response, token, expected_target,
+					     &lease->visibility, lease->target_hash)) {
+			lease->advance = true;
+			return 0;
+		}
+		if (!hfs_view_target(session, response, token, &lease->visibility,
+				     lease->target_hash))
+			return 0;
+	}
+	if (moved || unadopted) {
+		lease->unadopted = true;
+		memset(&lease->visibility, 0, sizeof(lease->visibility));
+		hfs_hash(response->data + response->tokens[token].start,
+			 response->tokens[token].end - response->tokens[token].start,
+			 lease->target_hash);
+		return 0;
+	}
+	return hfs_view_target(session, response, token, &lease->visibility,
+			       lease->target_hash);
+}
+
+/* The GRANTED reply's shape and lease identity: a lease-only GRANTED of
+ * exactly this request's access, domain, scope, mode and credential family,
+ * whose id (in id) is the hash of its other fields. -EPROTO otherwise.
+ */
+static int hfs_lease_decode_check(struct hfs_session *session,
+				  const struct hfs_view_ticket *ticket,
+				  const struct hfs_json *response, int body,
+				  const struct hfs_buf *access, bool dirty, u8 id[32])
+{
+	u8 actual[32];
+	int err;
+
+	if (!hfs_json_is(response, hfs_json_field(response, 0, "status"), "\"GRANTED\"") ||
+	    !hfs_json_is(response, hfs_json_field(response, 0, "reservation"), "null") ||
+	    !hfs_json_is(response, hfs_json_field(response, 0, "entry"), "null") ||
+	    hfs_json_exact(response, body,
+		"access,credential_hash,domain,fence,id,mode,revision,scope,target") ||
+	    !hfs_token_equal(response, hfs_json_field(response, body, "access"),
+			     access->data, access->len) ||
+	    !hfs_token_equal(response, hfs_json_field(response, body, "domain"),
+			     session->domain->json->data, session->domain->json->len) ||
+	    !hfs_token_equal(response, hfs_json_field(response, body, "scope"),
+			     session->enrollment.context, session->enrollment.context_len) ||
+	    !hfs_json_is(response, hfs_json_field(response, body, "mode"),
+			 dirty ? "\"EXCLUSIVE_DIRTY\"" : "\"READ\"") ||
+	    hfs_hex32(response, body, "credential_hash", actual) ||
+	    memcmp(actual, ticket->family->hash, 32) ||
+	    hfs_hex32(response, body, "id", id))
+		return -EPROTO;
+	err = hfs_json_hash_fields(response, body,
+		"access,credential_hash,domain,fence,mode,revision,scope,target", actual);
+	if (err || memcmp(actual, id, 32))
+		return err ?: -EPROTO;
+	return 0;
+}
+
+static int hfs_lease_decode(struct hfs_session *session,
+			    struct hfs_view_ticket *ticket,
+			    const struct hfs_json *response,
+			    const struct hfs_buf *access, bool dirty,
+			    const struct hfs_buf *expected_target,
+			    bool unadopted, struct hfs_lease **out)
+{
+	struct hfs_lease *lease;
+	u8 expected[32];
+	int body = hfs_json_field(response, 0, "lease"), token, err;
+
+	*out = NULL;
+	err = hfs_lease_decode_check(session, ticket, response, body, access, dirty, expected);
+	if (err)
+		return err;
+	lease = kzalloc(sizeof(*lease), GFP_KERNEL);
+	if (!lease)
+		return -ENOMEM;
+	kref_init(&lease->refs);
+	mutex_init(&lease->release_lock);
+	memcpy(lease->id, expected, 32);
+	lease->dirty = dirty;
+	err = hfs_u64_field(response, body, "fence", &lease->fence);
+	if (!err)
+		err = hfs_u64_field(response, body, "revision", &lease->revision);
+	if (err || !lease->fence || !lease->revision) {
+		err = -EPROTO;
+		goto fail;
+	}
+	token = hfs_json_field(response, body, "target");
+	err = hfs_lease_decode_target(session, ticket, response, token, expected_target,
+				      unadopted, lease);
+	if (!err)
+		err = hfs_copy_json(response, body, &lease->json);
+	if (err)
+		goto fail;
+	lease->ticket = ticket;
+	*out = lease;
+	return 0;
+fail:
+	hfs_lease_free(lease);
+	return err;
+}
+
+/* The access of a lease VIEW_ACQUIRE: a PAGE of description at offset, an
+ * OBJECT, or the DOMAIN.
+ */
+static void hfs_lease_access(struct hfs_buf *access, const struct hfs_cap *object,
+			     const struct hfs_cap *description, u64 offset)
+{
+	if (description) {
+		hfs_buf_literal(access, "{\"description\":");
+		hfs_cap_write(access, description);
+		hfs_buf_printf(access, ",\"kind\":\"PAGE\",\"length\":4096,\"offset\":%llu}", offset);
+	} else if (object) {
+		hfs_buf_literal(access, "{\"kind\":\"OBJECT\",\"object\":");
+		hfs_cap_write(access, object);
+		hfs_buf_literal(access, "}");
+	} else {
+		hfs_buf_literal(access, "{\"kind\":\"DOMAIN\"}");
+	}
+}
+
+/* The canonical VIEW_ACQUIRE payload, keys sorted. xf4: "advance": true
+ * follows "access" only when requested; without it the bytes are exactly the
+ * pre-xf4 ones, and false is never sent (one encoding per request).
+ */
+static void hfs_lease_acquire_payload(struct hfs_buf *payload, struct hfs_session *session,
+				      const struct hfs_view_ticket *ticket,
+				      const struct hfs_buf *access, bool dirty,
+				      const struct hfs_buf *expected_target, bool advance)
+{
+	hfs_buf_literal(payload, "{\"access\":");
+	hfs_buf_add(payload, access->data, access->len);
+	if (advance)
+		hfs_buf_literal(payload, ",\"advance\":true");
+	hfs_buf_literal(payload, ",\"domain\":");
+	hfs_cap_write(payload, session->domain);
+	hfs_buf_printf(payload, ",\"mode\":\"%s\",\"request\":", dirty ? "EXCLUSIVE_DIRTY" : "READ");
+	hfs_buf_add(payload, ticket->request.data, ticket->request.len);
+	hfs_buf_literal(payload, ",\"target\":");
+	if (expected_target)
+		hfs_buf_add(payload, expected_target->data, expected_target->len);
+	else
+		hfs_buf_literal(payload, "null");
+	hfs_buf_literal(payload, "}");
+}
+
+/* The release state of a decoded lease: the PAGE description, the issuer's
+ * credentials (immutable, with a native reference) and the preowned control
+ * release ticket (*release, which the lease takes over) and payload. On an
+ * error the caller frees the lease, and with it the release ticket.
+ *
+ * gn4 (zq3-r24 R24-1): the release ticket is prepared by
+ * hfs_lease_acquire_ex before its VIEW_ACQUIRE is sent, no longer here
+ * after the GRANTED. In r24 this charge failed ENOSPC on a full control
+ * lane after the 1024-group child's second VIEW_ACQUIRE was granted: the
+ * guest freed the lease locally, but the host kept it active with no
+ * release ticket. Nothing could release it, and the then domain-wide
+ * retirement check (factsLedger.checkRetire; per credentials since gn4,
+ * per ticket since hp4)
+ * answered every later VIEW_RETIRE of m0 BLOCKED, so the host still held
+ * 22 tickets and 8 leases afterwards.
+ */
+static int hfs_lease_own(const struct hfs_cred *cred, const struct hfs_cap *description,
+			 struct hfs_view_ticket **release, struct hfs_lease *lease)
+{
+	lease->release_ticket = *release;
+	*release = NULL;
+	if (description)
+		memcpy(lease->description, description->token, 32);
+	lease->issuer = kmemdup(cred, sizeof(*cred), GFP_KERNEL);
+	if (!lease->issuer)
+		return -ENOMEM;
+	lease->issuer->native = get_cred(cred->native);
+	return hfs_buf_init(&lease->release_payload, 32768);
+}
+
+/* The arguments of hfs_lease_acquire_ex that its grant needs. gn4: release
+ * points at the release ticket prepared before the VIEW_ACQUIRE; the
+ * decoded lease takes it over (hfs_lease_own).
+ */
+struct hfs_lease_want {
+	const struct hfs_cred *cred;
+	const struct hfs_cap *description;
+	const struct hfs_buf *access;
+	const struct hfs_buf *expected;
+	struct hfs_view_ticket **release;
+	bool dirty;
+};
+
+/* hfs_lease_acquire_ex's argument rules: no OBJECT and PAGE together, a
+ * dirty PAGE needs write rights and a READ one read rights, a page-aligned
+ * offset in range, and xf4's advance only on a READ DOMAIN acquisition with
+ * an expected target.
+ */
+static bool hfs_lease_acquire_valid(const struct hfs_session *session,
+				    const struct hfs_cred *cred,
+				    const struct hfs_cap *object,
+				    const struct hfs_cap *description, u64 offset, bool dirty,
+				    const struct hfs_buf *expected_target, bool advance)
+{
+	return session->domain && cred && !(object && description) &&
+	       !(dirty && (!description || !(description->rights & 2))) &&
+	       !(description && !dirty && !(description->rights & 1)) &&
+	       !(description && (offset & 4095 || offset > S64_MAX - 4096)) &&
+	       !(advance && (object || description || dirty || !expected_target));
+}
+
+/* The ticket and VIEW_ACQUIRE access of one acquisition, up to its payload:
+ * payload and access buffers, the access of object/description at offset,
+ * the activated ticket, marked for xf4 advance. Errors here are
+ * hfs_lease_acquire_ex's early failures: no exchange and no grant handling.
+ */
+static int hfs_lease_acquire_request(struct hfs_view_ticket *ticket,
+				     const struct hfs_cap *object,
+				     const struct hfs_lease_want *want, u64 offset,
+				     bool advance, struct hfs_buf *payload,
+				     struct hfs_buf *access)
+{
+	int err;
+
+	if (hfs_buf_init(payload, HFS_VIEW_BODY_MAX) || hfs_buf_init(access, 16384))
+		return -ENOMEM;
+	hfs_lease_access(access, object, want->description, offset);
+	err = access->error ?: (want->expected ? want->expected->error : 0);
+	if (!err)
+		err = hfs_view_ticket_activate(ticket);
+	if (err)
+		return err;
+	ticket->advance = advance;
+	return 0;
+}
+
+/* The lease of a VIEW_ACQUIRE exchange that returned err with response.
+ * 2f4: a GRANTED handed out with an error (a settle outcome, or -ENOMEM
+ * from keeping the ticket's Current; pre-existing, documented since 5f4)
+ * is still decoded and completed, unadopted, for its release (*result:
+ * that error). xf4: a moved target that is no advance candidate is built
+ * unadopted too (*result -EXDEV).
+ * Once the decoded lease holds the ticket, freeing it puts both, so
+ * *ticket is cleared. -EPROTO (also the exchange's), and -ESTALE for the
+ * grant itself (decode), block the session; the exchange's other failures
+ * already blocked there or are stops that must not (review 1).
+ */
+static int hfs_lease_acquire_grant(struct hfs_session *session,
+				   struct hfs_view_ticket **ticket,
+				   const struct hfs_lease_want *want, int err,
+				   const struct hfs_json *response, struct hfs_lease **out,
+				   int *result)
+{
+	if (err && response &&
+	    hfs_json_is(response, hfs_json_field(response, 0, "status"), "\"GRANTED\"")) {
+		*result = err;
+		err = 0;
+	}
+	if (err) {
+		if (err == -EPROTO) /* as before the split; usually blocked already */
+			hfs_session_block(session, "invalid or stale lease grant", "VIEW_ACQUIRE", err);
+		return err;
+	}
+	err = hfs_lease_decode(session, *ticket, response, want->access, want->dirty,
+			       want->expected, *result != 0, out);
+	if (!err && !*result && (*out)->unadopted)
+		*result = -EXDEV;
+	if (!err) {
+		err = hfs_lease_own(want->cred, want->description, want->release, *out);
+		if (err) {
+			hfs_lease_free(*out);
+			*out = NULL;
+			*ticket = NULL;
+		}
+	}
+	if (err == -EPROTO || err == -ESTALE)
+		hfs_session_block(session, "invalid or stale lease grant", "VIEW_ACQUIRE", err);
+	return err;
+}
+
+/* re4 (zq3-r16 R16-1): *blocked (when not NULL) tells the host's terminal
+ * BLOCKED answer apart from the other -EAGAIN results (RETIRED_ID, local
+ * ticket capacity). Only hfs_view_exchange's terminal BLOCKED path marks the
+ * ticket terminal while returning -EAGAIN. The host gives no reason with
+ * BLOCKED; for a VIEW_ACQUIRE it is mostly capacity (control tickets, lease
+ * or identity bounds, the Sources bound) or an expected target that a recall
+ * replaced, and both can clear: hfs_mmap_begin backs off and retries.
+ *
+ * 2f4 (zq3-r17 R17-1): an error with *out set is a verified GRANTED that
+ * was not current and never settled (hfs_view_grant_settle): -EXDEV when a
+ * later recall passed it, or the wait's stop (-ETIMEDOUT, -EINTR,
+ * -EHOSTDOWN). Or -ENOMEM (pre-existing; documented since 5f4), when
+ * hfs_view_exchange copied the GRANTED into its response but could not
+ * keep it as the ticket's Current (hfs_view_exchange_terminal; that grant
+ * may even be current, but it is not taken). The host still counts it as
+ * active, so the caller owns *out and must release it; it is unadopted
+ * (lease->unadopted) and never authority. The ie4 observation path
+ * (hfs_mmap_observe) holds it and acquires again on -EXDEV; every other
+ * path hands it to its cleanup packet.
+ *
+ * xf4: advance (only a READ DOMAIN acquisition with an expected target, else
+ * -EINVAL) adds "advance": true to the request. A GRANTED on another target
+ * is then an advance candidate (*out with lease->advance, 0), an ordinary
+ * lease already current for the installed view (0), or -EXDEV with an
+ * unadopted *out as above (hfs_lease_decode_target).
+ */
+int hfs_lease_acquire_ex(struct hfs_session *session, const struct hfs_cred *cred,
+			 const struct hfs_cap *object, const struct hfs_cap *description,
+			 u64 offset, bool dirty, const struct hfs_buf *expected_target,
+			 bool advance, struct hfs_lease **out, bool *blocked)
+{
+	struct hfs_view_ticket *ticket, *release = NULL;
+	struct hfs_buf payload = {}, access = {};
+	struct hfs_lease_want want = {
+		.cred = cred, .description = description, .access = &access,
+		.expected = expected_target, .release = &release, .dirty = dirty,
+	};
+	struct hfs_json *response = NULL;
+	int err, result = 0;
+
+	*out = NULL;
+	if (blocked)
+		*blocked = false;
+	if (!hfs_lease_acquire_valid(session, cred, object, description, offset, dirty,
+				     expected_target, advance))
+		return -EINVAL;
+	err = hfs_view_ticket_prepare(session, cred, false, &ticket);
+	if (err)
+		return err;
+	/* gn4 (zq3-r24 R24-1): the lease's control release ticket is charged
+	 * before the VIEW_ACQUIRE is sent (see hfs_lease_own). A full control
+	 * lane now refuses the acquisition ENOSPC with no host lease, and its
+	 * charge's view retirement (hfs_retire_shared) runs before this
+	 * acquisition's grant. Under gn4's host rule a family whose credentials
+	 * held an active lease could not retire at all; since hp4 (zq3-r25
+	 * R25-1) the host refuses (BLOCKED) only a range holding the GRANTED
+	 * acquisition of a still active lease, so answered releases retire
+	 * even while this caller holds another lease. An unused release
+	 * ticket is unnumbered and is put locally below.
+	 */
+	err = hfs_view_ticket_prepare(session, cred, true, &release);
+	if (err)
+		goto free;
+	err = hfs_lease_acquire_request(ticket, object, &want, offset, advance,
+					&payload, &access);
+	if (err)
+		goto free;
+	/* A payload error goes through the grant handling, as before 5f4. */
+	hfs_lease_acquire_payload(&payload, session, ticket, &access, dirty, expected_target,
+				  advance);
+	err = payload.error ?: hfs_view_exchange(session, ticket, "VIEW_ACQUIRE", &payload, &response);
+	if (err == -EAGAIN && blocked && ticket->terminal)
+		*blocked = true;
+	err = hfs_lease_acquire_grant(session, &ticket, &want, err, response, out, &result);
+free:
+	if (err)
+		hfs_view_ticket_put(ticket);
+	hfs_view_ticket_put(release); /* NULL once a decoded lease took it */
+	hfs_json_free(response);
+	hfs_buf_free(&payload);
+	hfs_buf_free(&access);
+	return err ?: result;
+}
+
+int hfs_lease_acquire(struct hfs_session *session, const struct hfs_cred *cred,
+		      const struct hfs_cap *object, const struct hfs_cap *description,
+		      u64 offset, bool dirty, const struct hfs_buf *expected_target,
+		      struct hfs_lease **out)
+{
+	return hfs_lease_acquire_ex(session, cred, object, description, offset, dirty,
+				    expected_target, false, out, NULL);
+}
+
+static int hfs_lease_release_locked(struct hfs_session *session, struct hfs_lease *lease)
+{
+	struct hfs_view_ticket *ticket = lease->release_ticket;
+	struct hfs_buf *payload = &lease->release_payload;
+	struct hfs_json *response = NULL;
+	int err;
+
+	/* This preowned control may initiate pressure recall while PTEs still
+	 * exist. No physical/page/transition lock may cover the parked RPC.
+	 * The issuer may return PENDING; only verified physical/source closure
+	 * can make it RELEASED. The final local check below is independent.
+	 */
+	if (!ticket || !lease->issuer ||
+	    memcmp(ticket->family->hash, lease->ticket->family->hash, 32))
+		return -ESTALE;
+	err = hfs_view_ticket_activate(ticket);
+	if (err)
+		return err;
+	payload->len = 0;
+	payload->error = 0;
+	hfs_buf_literal(payload, "{\"lease\":");
+	hfs_buf_add(payload, lease->json->data, lease->json->len);
+	hfs_buf_literal(payload, ",\"request\":");
+	hfs_buf_add(payload, ticket->request.data, ticket->request.len);
+	hfs_buf_literal(payload, "}");
+	err = hfs_view_exchange(session, ticket, "VIEW_RELEASE", payload, &response);
+	if (!err &&
+	    (!hfs_json_is(response, hfs_json_field(response, 0, "status"), "\"RELEASED\"") ||
+	     !hfs_json_is(response, hfs_json_field(response, 0, "entry"), "null") ||
+	     !hfs_json_is(response, hfs_json_field(response, 0, "lease"), "null") ||
+	     !hfs_json_is(response, hfs_json_field(response, 0, "reservation"), "null"))) {
+		err = -EPROTO;
+		hfs_session_block(session, "unexpected lease release status", "VIEW_RELEASE", err);
+	}
+	if (!err && READ_ONCE(lease->published) && !READ_ONCE(lease->revoked)) {
+		struct hfs_view *view = hfs_view_get(session);
+
+		if (view) {
+			hfs_view_fence(view);
+			hfs_view_put(view);
+		}
+		err = -EPROTO;
+		hfs_session_block(session, "lease released while still published", "VIEW_RELEASE", err);
+	}
+	hfs_json_free(response);
+	return err;
+}
+
+int hfs_lease_release(struct hfs_session *session, struct hfs_lease *lease)
+{
+	int err;
+
+	mutex_lock(&lease->release_lock);
+	if (lease->released) {
+		err = 0;
+	} else {
+		err = hfs_lease_release_locked(session, lease);
+		if (!err)
+			lease->released = true;
+	}
+	mutex_unlock(&lease->release_lock);
+	return err;
+}
+
+static void hfs_lease_destroy(struct kref *refs)
+{
+	struct hfs_lease *lease = container_of(refs, struct hfs_lease, refs);
+
+	hfs_buf_free(&lease->release_payload);
+	hfs_view_ticket_put(lease->release_ticket);
+	hfs_json_free(lease->json);
+	hfs_cred_free(lease->issuer);
+	hfs_view_ticket_put(lease->ticket);
+	kfree(lease);
+}
+
+void hfs_lease_get(struct hfs_lease *lease)
+{
+	kref_get(&lease->refs);
+}
+
+void hfs_lease_free(struct hfs_lease *lease)
+{
+	if (lease)
+		kref_put(&lease->refs, hfs_lease_destroy);
+}
+
+
+/* One hfs_view_retire_mode round, under session->retirement: the view, the
+ * round's view of view->retire_payload (its storage, reserved before
+ * writable admission; len is reset per family), and what the round saw: a
+ * floor that advanced, and a family whose VIEW_RETIRE the host answered
+ * BLOCKED (re4; host_blocked, not "blocked", which stop_wake_guard in
+ * tests/view/run.py reserves for the session flag).
+ */
+struct hfs_retire_round {
+	struct hfs_session *session;
+	struct hfs_view *view;
+	struct hfs_buf payload;
+	bool advanced;
+	bool host_blocked;
+};
+
+/* Snapshot the session's view families into view->retiring. Families are
+ * retained with permanent floors until protected session retirement.
+ */
+static u32 hfs_view_retire_families(struct hfs_session *session, struct hfs_view *view)
+{
+	struct hfs_view_family *family;
+	u32 nr_families = 0;
+
+	mutex_lock(&session->lock);
+	list_for_each_entry(family, &session->view_families, list)
+		view->retiring[nr_families++] = family;
+	mutex_unlock(&session->lock);
+	return nr_families;
+}
+
+/* Build family's VIEW_RETIRE payload: the result hashes of its terminal,
+ * unused tickets numbered contiguously from floor + 1 (at most 1024), with
+ * *through the last of them. Returns how many; 0: nothing to retire (the
+ * payload is then unfinished and unused). Advancing a floor never resets
+ * next or forgets credentials.
+ */
+static u32 hfs_view_retire_payload(struct hfs_session *session,
+				   struct hfs_view_family *family,
+				   struct hfs_buf *payload, u64 *through)
+{
+	struct hfs_view_ticket *ticket;
+	u8 hash[32];
+	u32 count = 0;
+
+	payload->len = 0;
+	payload->error = 0;
+	*through = family->floor;
+	hfs_buf_printf(payload, "{\"anchor\":\"%pUb\",\"credentials\":", &family->anchor);
+	hfs_buf_add(payload, family->credentials.data, family->credentials.len);
+	hfs_buf_printf(payload, ",\"nonce\":\"%pUb\",\"result_hashes\":[", &family->nonce);
+	mutex_lock(&session->lock);
+	list_for_each_entry(ticket, &session->view_tickets, list) {
+		if (ticket->family != family || !ticket->number)
+			continue;
+		if (ticket->users || !ticket->terminal || !ticket->response ||
+		    ticket->number != *through + 1)
+			break;
+		if (hfs_hex32(ticket->response, 0, "id", hash))
+			break;
+		if (count++)
+			hfs_buf_literal(payload, ",");
+		hfs_buf_hex(payload, hash, 32);
+		*through = ticket->number;
+		if (count == 1024)
+			break;
+	}
+	mutex_unlock(&session->lock);
+	if (count)
+		hfs_buf_printf(payload, "],\"through\":%llu}", *through);
+	return count;
+}
+
+/* The VIEW_RETIRE reply of a cut (hfs1.4: a stored reply is reused, a new
+ * one is stored in the cut) or of the plain payload (hfs1.1).
+ */
+static int hfs_view_retire_send(struct hfs_session *session, struct hfs_retirement_cut *cut,
+				const struct hfs_buf *payload, struct hfs_json **reply)
+{
+	int err;
+
+	if (cut && cut->response) {
+		*reply = cut->response;
+		return 0;
+	}
+	err = hfs_control(session, "VIEW_RETIRE", cut ? &cut->payload : payload, true, reply);
+	if (!err && cut)
+		cut->response = *reply;
+	return err;
+}
+
+/* Check a VIEW_RETIRE reply for through. BLOCKED (with a null proof) sets
+ * *refused: re4, the host refuses while any recall runs or while the range
+ * holds the GRANTED acquisition of a still active lease (retirementBlocked;
+ * per ticket since hp4, per credentials before). RETIRED at
+ * exactly through is handed to the provider's view_retirement. -EPROTO for
+ * any other reply.
+ */
+static int hfs_view_retire_verify(struct hfs_session *session,
+				  struct hfs_view_family *family,
+				  struct hfs_json *reply, u64 through, bool *refused)
+{
+	int body = hfs_json_field(reply, 0, "payload");
+	u8 proof[32];
+	u64 floor;
+
+	*refused = false;
+	if (hfs_json_exact(reply, body, "floor,proof_hash,status") ||
+	    hfs_u64_field(reply, body, "floor", &floor))
+		return -EPROTO;
+	if (hfs_json_is(reply, hfs_json_field(reply, body, "status"), "\"BLOCKED\"")) {
+		if (!hfs_json_is(reply, hfs_json_field(reply, body, "proof_hash"), "null"))
+			return -EPROTO;
+		*refused = true;
+		return 0;
+	}
+	if (!hfs_json_is(reply, hfs_json_field(reply, body, "status"), "\"RETIRED\"") ||
+	    floor != through || hfs_hex32(reply, body, "proof_hash", proof))
+		return -EPROTO;
+	return session->provider->view_retirement(session, &family->credentials,
+						  through, proof, reply);
+}
+
+/* Under session->lock: is a hfs1.4 ticket of family through through still
+ * in use, not terminal or without its response?
+ */
+static bool hfs_view_retire_busy(struct hfs_session *session,
+				 const struct hfs_view_family *family, u64 through)
+{
+	struct hfs_view_ticket *ticket;
+
+	if (session->bridge_minor != 4)
+		return false;
+	list_for_each_entry(ticket, &session->view_tickets, list) {
+		if (ticket->family == family && ticket->number && ticket->number <= through &&
+		    (ticket->users || !ticket->terminal || !ticket->response))
+			return true;
+	}
+	return false;
+}
+
+/* Under session->lock: move family's tickets through through from the
+ * session to released, uncharging them. A ticket still in use stops it
+ * with -EBUSY and blocks the session (WARN: hfs_view_retire_busy checked).
+ */
+static int hfs_view_retire_take(struct hfs_session *session,
+				const struct hfs_view_family *family, u64 through,
+				struct list_head *released)
+{
+	struct hfs_view_ticket *ticket, *next;
+
+	list_for_each_entry_safe(ticket, next, &session->view_tickets, list) {
+		if (ticket->family != family || !ticket->number || ticket->number > through)
+			continue;
+		if (WARN_ON_ONCE(ticket->users)) {
+			hfs_session_block(session, "retired view ticket still in use", "VIEW_RETIRE",
+					  -EBUSY);
+			return -EBUSY;
+		}
+		list_move_tail(&ticket->list, released);
+		session->nr_view_tickets--;
+		if (ticket->control)
+			session->nr_view_control_tickets--;
+	}
+	return 0;
+}
+
+/* Free retired tickets (off every list) and return their reservations. */
+static void hfs_view_retire_free(struct hfs_session *session, struct list_head *released)
+{
+	struct hfs_view_ticket *ticket, *next;
+
+	list_for_each_entry_safe(ticket, next, released, list) {
+		void *reservation = ticket->reservation;
+
+		list_del(&ticket->list);
+		hfs_buf_free(&ticket->request);
+		hfs_buf_free(&ticket->payload);
+		hfs_buf_free(&ticket->query);
+		hfs_buf_free(&ticket->original);
+		kvfree(ticket->scratch);
+		hfs_json_free(ticket->response);
+		hfs_json_free(ticket->initial_response);
+		hfs_completion_close(ticket->completion);
+		kfree(ticket);
+		session->provider->unreserve(session, reservation);
+	}
+}
+
+/* Advance family's floor to through after the provider accepted the
+ * retirement, in one session->lock section with the hfs1.4 busy check:
+ * -EBUSY with *keep (the cut stays for a retry) when a ticket is still in
+ * use. Otherwise *keep is false: the floor advanced, the waiters were
+ * woken and the retired tickets freed; -EBUSY only for the WARN case of
+ * hfs_view_retire_take.
+ */
+static int hfs_view_retire_advance(struct hfs_retire_round *round,
+				   struct hfs_view_family *family, u64 through, bool *keep)
+{
+	struct hfs_session *session = round->session;
+	struct hfs_view *view = round->view;
+	LIST_HEAD(released);
+	int err;
+
+	mutex_lock(&session->lock);
+	if (hfs_view_retire_busy(session, family, through)) {
+		mutex_unlock(&session->lock);
+		return -EBUSY;
+	}
+	*keep = false;
+	family->floor = through;
+	round->advanced = true;
+	/* re4: progress for BLOCKED observations (hfs_mmap_blocked_backoff).
+	 * 1h4: an observation waiting behind this round (hfs_view_retire_wait)
+	 * retries at once, without waiting for the other families' exchanges.
+	 */
+	WRITE_ONCE(view->retire_progress, view->retire_progress + 1);
+	wake_up_all(&view->wait);
+	err = hfs_view_retire_take(session, family, through, &released);
+	mutex_unlock(&session->lock);
+	hfs_view_retire_free(session, &released);
+	return err;
+}
+
+/* Offer one family's VIEW_RETIRE (its stored hfs1.4 cut, or a new payload
+ * and cut) and apply the answer. A BLOCKED answer leaves the tickets
+ * charged (an acquisition family's against the ordinary Tickets bound, a
+ * release family's against ControlTickets), so round->host_blocked asks
+ * to offer them again (hfs_mmap_retire_kick) instead of waiting for the
+ * next cleanup packet. A failure before the floor advanced keeps the cut (and its stored
+ * reply) for a retry; once answered and applied, the cut or reply is freed.
+ */
+static int hfs_view_retire_family(struct hfs_retire_round *round,
+				  struct hfs_view_family *family)
+{
+	struct hfs_session *session = round->session;
+	struct hfs_retirement_cut *cut = session->bridge_minor == 4 ?
+		family->retirement_cut : NULL;
+	struct hfs_json *reply = NULL;
+	bool refused = false, keep = true;
+	u64 through;
+	int err;
+
+	if (cut) {
+		through = cut->through;
+	} else {
+		if (!hfs_view_retire_payload(session, family, &round->payload, &through))
+			return 0;
+		if (session->bridge_minor == 4) {
+			err = hfs_retirement_cut_new(session, "VIEW_RETIRE", &round->payload,
+						     family->floor + 1, through, &cut);
+			if (err)
+				return err;
+			family->retirement_cut = cut;
+		}
+	}
+	err = hfs_view_retire_send(session, cut, &round->payload, &reply);
+	if (!err)
+		err = hfs_view_retire_verify(session, family, reply, through, &refused);
+	if (!err && !refused)
+		err = hfs_view_retire_advance(round, family, through, &keep);
+	if (err && keep) {
+		if (!cut)
+			hfs_json_free(reply);
+		return err;
+	}
+	if (cut) {
+		family->retirement_cut = NULL;
+		hfs_retirement_cut_free(session, cut);
+	} else {
+		hfs_json_free(reply);
+	}
+	if (refused)
+		round->host_blocked = true;
+	return err;
+}
+
+/* try (re4 review): an observation's BLOCKED back-off must not wait behind a
+ * running retirement round (the cleanup worker's), so it skips with -EBUSY.
+ * 1h4 review round 1: *ran (try only) says whether a round ran, so the
+ * caller can tell a held mutex (-EBUSY, !*ran) from a round that ran and
+ * itself returned -EBUSY (a retired ticket still in use).
+ *
+ * 5f4: split per the 50-line rule (hfs_view_retire_family offers one
+ * family) without changes in order, locking or error paths. A round that
+ * offered every family returns 0 if some floor advanced, else -EAGAIN; the
+ * first error ends the round and is returned.
+ */
+static int hfs_view_retire_mode(struct hfs_session *session, bool try, bool *ran)
+{
+	struct hfs_retire_round round = { .session = session };
+	struct hfs_view *view;
+	u32 nr_families, index;
+	int err = 0;
+
+	if (session->bridge_minor != 1 && session->bridge_minor != 4)
+		return -EOPNOTSUPP;
+	view = hfs_view_get(session);
+	if (!view)
+		return -EAGAIN;
+	if (!try) {
+		mutex_lock(&session->retirement);
+	} else if (!mutex_trylock(&session->retirement)) {
+		hfs_view_put(view);
+		return -EBUSY;
+	}
+	if (ran)
+		*ran = true;
+	round.view = view;
+	round.payload = view->retire_payload;
+	nr_families = hfs_view_retire_families(session, view);
+	for (index = 0; index < nr_families && !err; index++)
+		err = hfs_view_retire_family(&round, view->retiring[index]);
+	/* re4: view->retire_blocked says some family's VIEW_RETIRE was BLOCKED
+	 * and is still owed. A pass that offered every family replaces it; an
+	 * aborted pass only adds a refusal it saw (a spare retry is harmless).
+	 */
+	if (!err || round.host_blocked)
+		WRITE_ONCE(view->retire_blocked, round.host_blocked);
+	/* gn4: a round that advanced a floor returned its tickets' bytes, so a
+	 * charge that failed meanwhile earns its one retry (hfs_retire_shared,
+	 * 9n4), as after an hfs_retire round that freed requests.
+	 */
+	if (round.advanced)
+		hfs_retire_generation_advance();
+	/* 1h4: this round is over, whatever it achieved; an observation whose
+	 * try found it busy (hfs_view_retire_wait) decides again.
+	 */
+	hfs_retirement_unlock(session);
+	hfs_view_put(view);
+	return err ?: (round.advanced ? 0 : -EAGAIN);
+}
+
+/* 0 when some family's floor advanced, else an error (-EAGAIN: nothing
+ * retired, e.g. every VIEW_RETIRE BLOCKED).
+ */
+int hfs_view_retire(struct hfs_session *session)
+{
+	return hfs_view_retire_mode(session, false, NULL);
+}
+
+/* As hfs_view_retire, but -EBUSY at once while another round runs. *ran is
+ * true only when a round ran (1h4): -EBUSY with !*ran is the held mutex.
+ */
+int hfs_view_retire_try(struct hfs_session *session, bool *ran)
+{
+	*ran = false;
+	return hfs_view_retire_mode(session, true, ran);
+}
+
+/* Outputs remain owned on uncertain errors: their exact ticket and ordinary
+ * number must be resolved; timeout is never a destructor or no-effect proof.
+ */
+int hfs_dirty_reserve(struct hfs_session *session, struct hfs_cache_page *entry,
+		       const struct hfs_cap *description, u64 offset, u32 length,
+		       struct hfs_dirty **out)
+{
+	struct hfs_dirty *dirty;
+	struct hfs_json *reply = NULL;
+	struct hfs_buf *payload;
+	const struct hfs_cred *cred;
+	u8 expected[32], actual[32];
+	uuid_t provenance;
+	u64 number;
+	int err, body;
+
+	*out = NULL;
+	if (!entry->lease || !entry->lease->dirty || !description ||
+	    !(description->rights & 2) || offset % 4096 || offset > S64_MAX - 4096 ||
+	    !length || length > 4096)
+		return -EINVAL;
+	err = hfs_view_dirty_slot(entry);
+	if (err)
+		return err;
+	cred = entry->lease->issuer;
+	dirty = kzalloc(sizeof(*dirty), GFP_KERNEL);
+	if (!dirty) {
+		hfs_view_dirty_unslot(entry);
+		return -ENOMEM;
+	}
+	INIT_LIST_HEAD(&dirty->list);
+	dirty->offset = offset;
+	dirty->length = length;
+	dirty->home = description->home;
+	dirty->allocation = description->allocation;
+	err = session->provider->reserve(session, sizeof(*dirty) + 4ULL * 1024 * 1024,
+					 true, &dirty->credit);
+	if (err) {
+		kfree(dirty);
+		hfs_view_dirty_unslot(entry);
+		return err;
+	}
+	/* From here cleanup must resolve any numbered local/remote obligation. */
+	*out = dirty;
+	if (hfs_buf_init(&dirty->freeze_payload, HFS_VIEW_BODY_MAX) ||
+	    hfs_buf_init(&dirty->drain_args, 32768))
+		return -ENOMEM;
+	err = hfs_view_ticket_prepare(session, cred, true, &dirty->freeze_ticket);
+	if (!err)
+		err = hfs_view_ticket_prepare(session, cred, false, &dirty->reserve_ticket);
+	if (!err)
+		err = hfs_request_earmark(session, cred, dirty->reserve_ticket, &dirty->request);
+	if (err)
+		return err;
+	err = hfs_view_ticket_activate(dirty->reserve_ticket);
+	if (err)
+		return err;
+	payload = &dirty->freeze_payload;
+	hfs_buf_literal(payload, "{\"claim_number\":");
+	hfs_buf_add(payload, dirty->request->earmark_number.data,
+		    dirty->request->earmark_number.len);
+	hfs_buf_literal(payload, ",\"description\":");
+	hfs_cap_write(payload, description);
+	hfs_buf_literal(payload, ",\"lease\":");
+	hfs_buf_add(payload, entry->lease->json->data, entry->lease->json->len);
+	hfs_buf_printf(payload, ",\"length\":4096,\"offset\":%llu,\"request\":", offset);
+	hfs_buf_add(payload, dirty->reserve_ticket->request.data,
+		    dirty->reserve_ticket->request.len);
+	hfs_buf_literal(payload, "}");
+	err = hfs_view_exchange(session, dirty->reserve_ticket, "DIRTY_RESERVE", payload, &reply);
+	if (err)
+		goto done;
+	body = hfs_json_field(reply, 0, "reservation");
+	if (hfs_json_exact(reply, body,
+		"claim_number,credentials,description,drain_credit,id,lease_id,length,offset,provenance,scope") ||
+	    !hfs_token_equal(reply, hfs_json_field(reply, body, "claim_number"),
+			     dirty->request->earmark_number.data, dirty->request->earmark_number.len) ||
+	    !hfs_token_equal(reply, hfs_json_field(reply, body, "credentials"),
+			     dirty->request->credentials.data, dirty->request->credentials.len) ||
+	    !hfs_token_equal(reply, hfs_json_field(reply, body, "description"),
+			     description->json->data, description->json->len) ||
+	    !hfs_token_equal(reply, hfs_json_field(reply, body, "scope"),
+			     dirty->request->original_context.data, dirty->request->original_context.len) ||
+	    hfs_hex32(reply, body, "lease_id", actual) || memcmp(actual, entry->lease->id, 32) ||
+	    hfs_hex32(reply, body, "drain_credit", actual) ||
+	    hfs_hex32(reply, body, "id", expected) ||
+	    hfs_uuid(reply, hfs_json_field(reply, body, "provenance"), &provenance) ||
+	    uuid_is_null(&provenance) ||
+	    hfs_u64_field(reply, body, "offset", &number) || number != offset ||
+	    hfs_u64_field(reply, body, "length", &number) || number != 4096) {
+		err = -EPROTO;
+		goto done;
+	}
+	err = hfs_json_hash_fields(reply, body,
+		"claim_number,credentials,description,drain_credit,lease_id,length,offset,provenance,scope", actual);
+	if (!err && memcmp(expected, actual, 32))
+		err = -EPROTO;
+	if (!err && session->bridge_minor == 4)
+		err = hfs_received_source(session, reply, body);
+	if (!err)
+		err = hfs_copy_json(reply, body, &dirty->reservation);
+	if (!err) {
+		memcpy(dirty->id, expected, 32);
+		hfs_request_earmark_admitted(session, dirty->request);
+	}
+done:
+	hfs_json_free(reply);
+	if (err == -EPROTO)
+		hfs_session_block(session, "invalid dirty reservation", "DIRTY_RESERVE", err);
+	return err;
+}
+
+int hfs_dirty_resume_reserve(struct hfs_session *session, struct hfs_dirty *dirty,
+			     struct hfs_lease *lease)
+{
+	struct hfs_view_ticket *ticket = dirty->reserve_ticket;
+	struct hfs_buf *payload = &dirty->freeze_payload;
+	struct hfs_json *response = NULL;
+	int err, access, description;
+
+	if (!ticket || !dirty->request || !lease || !lease->json)
+		return -EINVAL;
+	if (ticket->bound) {
+		err = hfs_view_exchange(session, ticket, "DIRTY_RESERVE", &ticket->payload, &response);
+	} else {
+		err = hfs_view_ticket_activate(ticket);
+		if (err)
+			return err;
+		access = hfs_json_field(lease->json, 0, "access");
+		description = hfs_json_field(lease->json, access, "description");
+		payload->len = 0;
+		payload->error = 0;
+		hfs_buf_literal(payload, "{\"claim_number\":");
+		hfs_buf_add(payload, dirty->request->earmark_number.data,
+			    dirty->request->earmark_number.len);
+		hfs_buf_literal(payload, ",\"description\":");
+		hfs_buf_token(payload, lease->json, description);
+		hfs_buf_literal(payload, ",\"lease\":");
+		hfs_buf_add(payload, lease->json->data, lease->json->len);
+		hfs_buf_printf(payload, ",\"length\":4096,\"offset\":%llu,\"request\":", dirty->offset);
+		hfs_buf_add(payload, ticket->request.data, ticket->request.len);
+		hfs_buf_literal(payload, "}");
+		err = hfs_view_exchange(session, ticket, "DIRTY_RESERVE", payload, &response);
+	}
+	/* No admission/replay result from this cleanup path is ever adopted.
+	 * It only resolves the original numbered reservation before CANCEL.
+	 */
+	hfs_json_free(response);
+	return err;
+}
+
+int hfs_dirty_freeze(struct hfs_view *view, struct hfs_dirty *dirty)
+{
+	struct hfs_session *session = view->session;
+	struct hfs_buf *payload = &dirty->freeze_payload, *args = &dirty->drain_args;
+	struct hfs_json *reply = NULL, *expected_entry = NULL, *received_entry = NULL;
+	struct page *page = dirty->entry->page;
+	u8 data_hash[32], entry_id[32];
+	void *address;
+	unsigned long flags;
+	u64 revision;
+	int description, entry, err;
+
+	if (dirty->frozen)
+		return 0;
+	spin_lock_irqsave(&view->lock, flags);
+	err = !dirty->adopted || !view->quiescent ||
+		view->phase != HFS_VIEW_QUIESCENT || view->active ? -ESTALE : 0;
+	revision = view->revision;
+	spin_unlock_irqrestore(&view->lock, flags);
+	if (err || !page)
+		return err ?: -ESTALE;
+	if (!dirty->captured) {
+		lock_page(page);
+		if (page_mapped(page) || PageWriteback(page) ||
+		    folio_maybe_dma_pinned(page_folio(page))) {
+			unlock_page(page);
+			return -EBUSY;
+		}
+		address = kmap_local_page(page);
+		memcpy(dirty->data, address, dirty->length);
+		kunmap_local(address);
+		unlock_page(page);
+		dirty->recall = view->recall;
+		dirty->captured = true;
+	} else if (!uuid_equal(&dirty->recall, &view->recall)) {
+		return -ESTALE;
+	}
+	/* Frozen page bytes are now in already reserved immutable RAM. All
+	 * following RPC/JSON work happens outside page/PTE/MM critical locks.
+	 */
+	hfs_hash(dirty->data, dirty->length, data_hash);
+	description = hfs_json_field(dirty->reservation, 0, "description");
+	payload->len = 0;
+	payload->error = 0;
+	hfs_buf_literal(payload, "{\"description\":");
+	hfs_buf_token(payload, dirty->reservation, description);
+	hfs_buf_printf(payload, ",\"length\":%u,\"offset\":%llu,\"payload_hash\":",
+		       dirty->length, dirty->offset);
+	hfs_buf_hex(payload, data_hash, 32);
+	hfs_buf_literal(payload, ",\"reservation\":");
+	hfs_buf_hex(payload, dirty->id, 32);
+	hfs_buf_literal(payload, "}");
+	if (payload->error)
+		return payload->error;
+	hfs_hash(payload->data, payload->len, entry_id);
+	args->len = 0;
+	args->error = 0;
+	hfs_buf_literal(args, "{\"data\":");
+	hfs_buf_hex(args, dirty->data, dirty->length);
+	hfs_buf_literal(args, ",\"description\":");
+	hfs_buf_token(args, dirty->reservation, description);
+	hfs_buf_literal(args, ",\"dirty_entry\":");
+	hfs_buf_hex(args, entry_id, 32);
+	hfs_buf_printf(args, ",\"offset\":%llu,\"recall\":\"%pUb\",\"reservation\":",
+		       dirty->offset, &dirty->recall);
+	hfs_buf_hex(args, dirty->id, 32);
+	hfs_buf_literal(args, "}");
+	if (!dirty->request->bound) {
+		err = hfs_request_bind_drain(session, dirty->request, args);
+		if (err)
+			return err;
+	}
+	payload->len = 0;
+	payload->error = 0;
+	hfs_buf_literal(payload, "{\"claim\":");
+	hfs_buf_add(payload, dirty->request->claim.data, dirty->request->claim.len);
+	hfs_buf_literal(payload, ",\"description\":");
+	hfs_buf_token(payload, dirty->reservation, description);
+	hfs_buf_literal(payload, ",\"id\":");
+	hfs_buf_hex(payload, entry_id, 32);
+	hfs_buf_printf(payload, ",\"length\":%u,\"offset\":%llu,\"payload_hash\":",
+		       dirty->length, dirty->offset);
+	hfs_buf_hex(payload, data_hash, 32);
+	hfs_buf_literal(payload, ",\"reservation\":");
+	hfs_buf_hex(payload, dirty->id, 32);
+	hfs_buf_literal(payload, "}");
+	err = payload->error ?: hfs_json_parse(payload->data, payload->len, &expected_entry);
+	if (err)
+		return err;
+	payload->len = 0;
+	payload->error = 0;
+	hfs_buf_literal(payload, "{\"claim\":");
+	hfs_buf_add(payload, dirty->request->claim.data, dirty->request->claim.len);
+	hfs_buf_literal(payload, ",\"data\":");
+	hfs_buf_hex(payload, dirty->data, dirty->length);
+	err = hfs_view_ticket_activate(dirty->freeze_ticket);
+	if (err)
+		goto done;
+	hfs_buf_printf(payload, ",\"recall\":\"%pUb\",\"request\":", &dirty->recall);
+	hfs_buf_add(payload, dirty->freeze_ticket->request.data, dirty->freeze_ticket->request.len);
+	hfs_buf_literal(payload, ",\"reservation\":");
+	hfs_buf_add(payload, dirty->reservation->data, dirty->reservation->len);
+	hfs_buf_literal(payload, "}");
+	err = hfs_view_exchange(session, dirty->freeze_ticket, "DIRTY_FREEZE", payload, &reply);
+	if (err)
+		goto done;
+	entry = hfs_json_field(reply, 0, "entry");
+	if (!hfs_token_equal(reply, entry, expected_entry->data, expected_entry->len)) {
+		err = -EPROTO;
+		goto done;
+	}
+	if (session->bridge_minor == 4) {
+		err = hfs_received_source(session, reply, entry);
+		if (!err)
+			err = hfs_received_copy(reply, entry, &received_entry);
+		if (err)
+			goto done;
+		/* Copy/verification can sleep. Adoption itself is a physical-state
+		 * transition and rechecks the actual capture before publication.
+		 */
+		spin_lock_irqsave(&view->lock, flags);
+		if (!view->quiescent || view->phase != HFS_VIEW_QUIESCENT || view->active ||
+		    view->revision != revision || !uuid_equal(&view->recall, &dirty->recall)) {
+			err = -ESTALE;
+		} else {
+			memcpy(dirty->entry_id, entry_id, 32);
+			dirty->frozen_entry = received_entry;
+			received_entry = NULL;
+			dirty->frozen = true;
+		}
+		spin_unlock_irqrestore(&view->lock, flags);
+	} else {
+		/* Preserve the closed older provider contract and allocation path. */
+		memcpy(dirty->entry_id, entry_id, 32);
+		dirty->frozen_entry = expected_entry;
+		expected_entry = NULL;
+		dirty->frozen = true;
+	}
+done:
+	hfs_json_free(received_entry);
+	hfs_json_free(reply);
+	hfs_json_free(expected_entry);
+	if (err == -EPROTO)
+		hfs_session_block(session, "invalid dirty freeze entry", "DIRTY_FREEZE", err);
+	return err;
+}
+
+static void hfs_dirty_mapping_error(struct hfs_view *view, struct hfs_dirty *dirty, int err)
+{
+	struct hfs_inode *object;
+	struct inode *inode = NULL;
+	unsigned long flags;
+
+	spin_lock_irqsave(&view->lock, flags);
+	list_for_each_entry(object, &view->mappings, view_list)
+		if (uuid_equal(&object->object->home, &dirty->home) &&
+		    uuid_equal(&object->object->allocation, &dirty->allocation)) {
+			inode = igrab(&object->inode);
+			break;
+		}
+	spin_unlock_irqrestore(&view->lock, flags);
+	if (inode) {
+		mapping_set_error(inode->i_mapping, err);
+		iput(inode);
+	}
+}
+
+int hfs_dirty_drain(struct hfs_view *view, struct hfs_dirty *dirty)
+{
+	struct hfs_json *result = NULL;
+	struct page *page;
+	unsigned long flags;
+	u64 count;
+	int err;
+
+	if (!dirty->adopted || !dirty->frozen || !dirty->request ||
+	    !READ_ONCE(view->quiescent))
+		return -ESTALE;
+	if (dirty->resolved)
+		return 0;
+	if (dirty->request->terminal) {
+		err = dirty->request->result ? hfs_copy_json(dirty->request->result, 0, &result) : -EPROTO;
+		if (!err)
+			err = hfs_result_code(result);
+	} else {
+		err = hfs_request_drain(view->session, dirty->request, &result);
+	}
+	if (!err && (hfs_u64_field(result, 0, "count", &count) || count != dirty->length))
+		err = -EIO;
+	if (err) {
+		hfs_dirty_mapping_error(view, dirty, err);
+		goto out;
+	}
+	spin_lock_irqsave(&view->lock, flags);
+	page = dirty->entry->page;
+	if (page)
+		get_page(page);
+	spin_unlock_irqrestore(&view->lock, flags);
+	if (page) {
+		lock_page(page);
+		if (page_mapped(page) || PageWriteback(page) ||
+		    folio_maybe_dma_pinned(page_folio(page)))
+			err = -EBUSY;
+		else
+			clear_page_dirty_for_io(page);
+		unlock_page(page);
+		put_page(page);
+	}
+	if (!err) {
+		/* Intermediate installs may have detached the old cache page.
+		 * Immutable bytes/Claim remained in reserved RAM throughout; the
+		 * exact protected full-length result now resolves that obligation.
+		 */
+		spin_lock_irqsave(&view->lock, flags);
+		dirty->resolved = true;
+		spin_unlock_irqrestore(&view->lock, flags);
+	}
+out:
+	hfs_json_free(result);
+	return err;
+}
diff --git a/fs/9p/hfs_mmap.c b/fs/9p/hfs_mmap.c
new file mode 100644
--- /dev/null
+++ b/fs/9p/hfs_mmap.c
@@ -0,0 +1,2713 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Retained file mappings: physical stopped installation and reserved drains. */
+#include <linux/mm.h>
+#include <linux/pagemap.h>
+#include <linux/slab.h>
+#include <linux/writeback.h>
+#include <linux/workqueue.h>
+#include <linux/delay.h>
+#include <linux/highmem.h>
+#include <linux/user_namespace.h>
+#include "hfs.h"
+#include "hfs_received.h"
+#include "hfs_controlled.h"
+
+/* transitions owns the preallocated inode workspace. No network/user copy or
+ * source verifier runs in this page/PTE critical phase.
+ */
+static int hfs_mmap_invalidate_stopped(struct hfs_view *view)
+{
+	struct hfs_inode *object;
+	struct hfs_cache_page *entry;
+	unsigned long flags;
+	u32 count = 0, pages = 0, i;
+	int err = 0, current_err;
+
+	spin_lock_irqsave(&view->lock, flags);
+	if (!view->quiescent || view->active || view->phase == HFS_VIEW_LIVE ||
+	    view->phase == HFS_VIEW_FENCED) {
+		err = -ESTALE;
+		goto unlock;
+	}
+	list_for_each_entry(object, &view->mappings, view_list) {
+		struct inode *inode = igrab(&object->inode);
+
+		if (inode)
+			view->stopping[count++] = inode;
+	}
+	spin_unlock_irqrestore(&view->lock, flags);
+	for (i = 0; i < count; i++) {
+		struct inode *inode = view->stopping[i];
+
+		/* STOP already zapped all aliases including executable and
+		 * open-unlinked; this check independently refuses a late busy page.
+		 * Frozen bytes/claims remain in the complete reserved registry even
+		 * when their terminal result is waiting for this cut installation.
+		 */
+		current_err = invalidate_inode_pages2(inode->i_mapping);
+		if (current_err && !err)
+			err = current_err;
+		iput(inode);
+		view->stopping[i] = NULL;
+	}
+	spin_lock_irqsave(&view->lock, flags);
+	list_for_each_entry(entry, &view->cache, list)
+		if (entry->page) {
+			get_page(entry->page);
+			view->stopping_pages[pages++] = entry->page;
+		}
+	spin_unlock_irqrestore(&view->lock, flags);
+	for (i = 0; i < pages; i++) {
+		struct page *page = view->stopping_pages[i];
+
+		lock_page(page);
+		/* Last close/unlink/eviction can already have detached a retained
+		 * provenance page from its inode. Frozen RAM still owns its bytes.
+		 */
+		if (!page_mapping(page) && !page_mapped(page) && !PageWriteback(page) &&
+		    !folio_maybe_dma_pinned(page_folio(page))) {
+			current_err = PageDirty(page) ?
+				hfs_cache_aops.launder_folio(page_folio(page)) : 0;
+			if (!current_err) {
+				hfs_cache_aops.invalidate_folio(page_folio(page), 0, PAGE_SIZE);
+				hfs_cache_aops.free_folio(page_folio(page));
+			}
+		}
+		unlock_page(page);
+		put_page(page);
+		view->stopping_pages[i] = NULL;
+	}
+	spin_lock_irqsave(&view->lock, flags);
+	list_for_each_entry(entry, &view->cache, list)
+		if (entry->page)
+			err = err ?: -EBUSY;
+unlock:
+	spin_unlock_irqrestore(&view->lock, flags);
+	return err;
+}
+
+/* An actual terminal full-length drain and physical cache detachment are both
+ * required. The canonical manifest has already copied the frozen records and
+ * remains immutable through final ACK/replay; removing this in-memory registry
+ * does not change that manifest or the host's protected source inventory.
+ */
+static int hfs_mmap_close_drained(struct hfs_view *view)
+{
+	struct hfs_dirty *dirty, *next;
+	LIST_HEAD(closed);
+	unsigned long flags;
+	int err = 0;
+
+	spin_lock_irqsave(&view->lock, flags);
+	list_for_each_entry(dirty, &view->dirty, list)
+		if (!dirty->resolved || !dirty->frozen || dirty->entry->page) {
+			err = -EBUSY;
+			goto unlock;
+		}
+	list_for_each_entry_safe(dirty, next, &view->dirty, list) {
+		dirty->entry->dirty = NULL;
+		view->nr_dirty--;
+		list_move_tail(&dirty->list, &closed);
+	}
+unlock:
+	spin_unlock_irqrestore(&view->lock, flags);
+	if (err)
+		return err;
+	list_for_each_entry_safe(dirty, next, &closed, list) {
+		struct hfs_request *request = dirty->request;
+
+		list_del(&dirty->list);
+		dirty->request = NULL;
+		hfs_request_unhold(view->session, request);
+		hfs_view_ticket_put(dirty->reserve_ticket);
+		hfs_view_ticket_put(dirty->freeze_ticket);
+		hfs_json_free(dirty->reservation);
+		hfs_json_free(dirty->frozen_entry);
+		hfs_buf_free(&dirty->freeze_payload);
+		hfs_buf_free(&dirty->drain_args);
+		hfs_view_page_put(dirty->entry);
+		view->session->provider->unreserve(view->session, dirty->credit);
+		kfree(dirty);
+	}
+	return 0;
+}
+
+static bool hfs_mmap_install_phase(struct hfs_view *view, bool final)
+{
+	return final ? view->phase == HFS_VIEW_DRAINED :
+		(view->phase == HFS_VIEW_STOPPED || view->phase == HFS_VIEW_INSTALLED_DRAIN);
+}
+
+int hfs_mmap_install(struct hfs_view *view, const struct hfs_json *event,
+		     int target, const uuid_t *recall, u64 sequence, bool final)
+{
+	u8 target_hash[32];
+	uuid_t visibility;
+	unsigned long flags;
+	u32 len;
+	int err;
+
+	if (!sequence || target < 0 || target >= event->count)
+		return -EPROTO;
+	len = event->tokens[target].end - event->tokens[target].start;
+	if (!len || len > HFS_TARGET_MAX)
+		return -EPROTO;
+	/* Native source verification is mandatory. It runs while observations
+	 * are stopped, outside every page/PTE/physical critical token.
+	 */
+	err = hfs_view_target(view->session, event, target, &visibility, target_hash);
+	if (err)
+		return err;
+	mutex_lock(&view->transitions);
+	spin_lock_irqsave(&view->lock, flags);
+	if ((final ? view->phase == HFS_VIEW_FINAL :
+	     (view->phase == HFS_VIEW_INSTALLED_DRAIN || view->phase == HFS_VIEW_DRAINED)) &&
+	    view->quiescent && !view->active && sequence == view->sequence &&
+	    uuid_equal(&view->recall, recall) && !memcmp(view->target_hash, target_hash, 32)) {
+		spin_unlock_irqrestore(&view->lock, flags);
+		err = 0;
+		goto out;
+	}
+	if (!view->quiescent || view->active || !uuid_equal(&view->recall, recall) ||
+	    sequence <= view->sequence ||
+	    !hfs_mmap_install_phase(view, final))
+		err = -ESTALE;
+	spin_unlock_irqrestore(&view->lock, flags);
+	if (err)
+		goto out;
+	err = hfs_mmap_invalidate_stopped(view);
+	if (err)
+		goto out;
+	spin_lock_irqsave(&view->lock, flags);
+	/* Source validation may park; fence still wins before installation.
+	 * Revalidate exact phase/event immediately before installing target.
+	 */
+	if (!view->quiescent || view->active || !uuid_equal(&view->recall, recall) ||
+	    sequence <= view->sequence ||
+	    !hfs_mmap_install_phase(view, final)) {
+		err = -ESTALE;
+	} else if (view->revision == U64_MAX) {
+		view->phase = HFS_VIEW_FENCED;
+		err = -EOVERFLOW;
+	} else {
+		view->target.len = 0;
+		view->target.error = 0;
+		hfs_buf_token(&view->target, event, target);
+		err = view->target.error;
+		if (!err) {
+			memcpy(view->target_hash, target_hash, 32);
+			view->generation = visibility;
+			view->revision++;
+			view->sequence = sequence;
+			view->phase = final ? HFS_VIEW_FINAL : HFS_VIEW_INSTALLED_DRAIN;
+		}
+	}
+	spin_unlock_irqrestore(&view->lock, flags);
+out:
+	mutex_unlock(&view->transitions);
+	return err;
+}
+
+static int hfs_mmap_finish_drained(struct hfs_view *view)
+{
+	unsigned long flags;
+	int err;
+
+	mutex_lock(&view->transitions);
+	spin_lock_irqsave(&view->lock, flags);
+	err = view->phase == HFS_VIEW_INSTALLED_DRAIN && view->quiescent &&
+		!view->active ? 0 : -ESTALE;
+	spin_unlock_irqrestore(&view->lock, flags);
+	if (!err)
+		err = hfs_mmap_close_drained(view);
+	if (!err) {
+		spin_lock_irqsave(&view->lock, flags);
+		if (view->phase != HFS_VIEW_INSTALLED_DRAIN || !view->quiescent || view->active)
+			err = -ESTALE;
+		else
+			view->phase = HFS_VIEW_DRAINED;
+		spin_unlock_irqrestore(&view->lock, flags);
+	}
+	mutex_unlock(&view->transitions);
+	return err;
+}
+
+/* Independent poll, event and drain queues prevent a parked service grant from
+ * owning the executor needed to install that grant's protected intermediate cut.
+ */
+struct hfs_mmap_control {
+	struct kref refs;
+	struct hfs_view *view;
+	struct workqueue_struct *poll_queue;
+	struct workqueue_struct *event_queue;
+	struct workqueue_struct *drain_queue;
+	struct workqueue_struct *cleanup_queue;
+	struct workqueue_struct *pressure_queue;
+	struct delayed_work poll;
+	struct delayed_work events;
+	struct delayed_work pressure;
+	struct delayed_work drained;
+	/* re4: re-sends a BLOCKED VIEW_RETIRE (hfs_mmap_retire_kick); runs on
+	 * cleanup_queue, so it is serialized with the cleanup packets.
+	 */
+	struct delayed_work retire;
+	unsigned long retire_after; /* next unforced kick (control->lock) */
+	struct hfs_json *drain_event;
+	bool drained_acked;
+	unsigned long pressure_after;
+	struct work_struct drains;
+	spinlock_t lock;
+	struct list_head cleanup;
+	struct hfs_json *pending[HFS_MMAP_EVENTS_MAX];
+	u32 head;
+	u32 count;
+	u64 delivered;
+	u64 completed;
+	uuid_t recall;
+	uuid_t old_visibility;
+	bool have_recall;
+	struct hfs_json *last_event;
+	struct hfs_buf poll_payload;
+	struct hfs_buf ack;
+	struct hfs_buf last_ack;
+	void *credit;
+	bool stopping;
+	int error;
+	/* 1a4: what the event executor was doing, for hfs_mmap_fail's line.
+	 * Only event_queue work (hfs_mmap_events, hfs_mmap_drained) writes
+	 * these; that unbound queue has max_active 1, so it runs one item at a
+	 * time. event_phase is the host event being processed, ack_phase the
+	 * ACK sent for it (NULL before one) and ack_status the host's reply
+	 * status ("" while no reply arrived, e.g. a transport timeout).
+	 */
+	char event_phase[24];
+	const char *ack_phase;
+	char ack_status[24];
+};
+
+static void hfs_mmap_control_release(struct kref *refs)
+{
+	struct hfs_mmap_control *control = container_of(refs, struct hfs_mmap_control, refs);
+	struct hfs_view *view = control->view;
+
+	hfs_buf_free(&control->poll_payload);
+	hfs_buf_free(&control->ack);
+	hfs_buf_free(&control->last_ack);
+	view->session->provider->unreserve(view->session, control->credit);
+	hfs_view_put(view);
+	kfree(control);
+}
+
+static struct hfs_mmap_control *hfs_mmap_control_get(struct hfs_view *view)
+{
+	struct hfs_mmap_control *control;
+	unsigned long flags;
+
+	spin_lock_irqsave(&view->lock, flags);
+	control = view->control;
+	if (control && !control->stopping)
+		kref_get(&control->refs);
+	else
+		control = NULL;
+	spin_unlock_irqrestore(&view->lock, flags);
+	return control;
+}
+
+static void hfs_mmap_control_put(struct hfs_mmap_control *control)
+{
+	if (control)
+		kref_put(&control->refs, hfs_mmap_control_release);
+}
+
+static int hfs_mmap_hash32(const struct hfs_json *json, int object,
+			  const char *name, u8 out[32])
+{
+	u32 len = 32;
+
+	if (hfs_json_hex(json, hfs_json_field(json, object, name), out, &len) || len != 32)
+		return -EPROTO;
+	return 0;
+}
+
+static bool hfs_mmap_token(const struct hfs_json *json, int token,
+			    const void *data, u32 len)
+{
+	return token >= 0 && token < json->count &&
+		json->tokens[token].end - json->tokens[token].start == len &&
+		!memcmp(json->data + json->tokens[token].start, data, len);
+}
+
+/* The full canonical VIEW_WAIT envelope remains available to the mandatory
+ * native verifier. Local parsing does not replace enrolled source authority.
+ */
+static int hfs_mmap_event_check(struct hfs_view *view, const struct hfs_json *json,
+			       int event, u64 *sequence, uuid_t *recall)
+{
+	struct hfs_session *session = view->session;
+	u8 digest[32];
+	uuid_t old;
+	int phase = hfs_json_field(json, event, "phase");
+	bool is_recall = hfs_json_is(json, phase, "\"RECALL\"");
+
+	if (!json->transported || json->channel != HFS_CHANNEL_RECALL ||
+	    json->frame_kind != HFS_FRAME_RECALL || json->frame_minor != session->bridge_minor ||
+	    !json->native_cell || !uuid_equal(&json->native_session, &session->enrollment.session))
+		return -EPROTO;
+	if (hfs_json_exact(json, event,
+		"authority_hash,closure_hash,domain,inventory_hash,manifest_hash,"
+		"old_visibility,phase,recall,sequence,target") ||
+	    hfs_json_u64(json, hfs_json_field(json, event, "sequence"), sequence) || !*sequence ||
+	    hfs_uuid(json, hfs_json_field(json, event, "recall"), recall) || uuid_is_null(recall) ||
+	    hfs_uuid(json, hfs_json_field(json, event, "old_visibility"), &old) || uuid_is_null(&old) ||
+	    !hfs_mmap_token(json, hfs_json_field(json, event, "domain"),
+			     session->domain->json->data, session->domain->json->len) ||
+	    hfs_mmap_hash32(json, event, "authority_hash", digest) ||
+	    hfs_mmap_hash32(json, event, "closure_hash", digest) ||
+	    hfs_mmap_hash32(json, event, "inventory_hash", digest))
+		return -EPROTO;
+	if (is_recall) {
+		if (!hfs_json_is(json, hfs_json_field(json, event, "target"), "null") ||
+		    !hfs_json_is(json, hfs_json_field(json, event, "manifest_hash"), "null"))
+			return -EPROTO;
+	} else {
+		if ((!hfs_json_is(json, phase, "\"INSTALL_DRAIN\"") &&
+		     !hfs_json_is(json, phase, "\"INSTALL_FINAL\"") &&
+		     !hfs_json_is(json, phase, "\"REOPEN\"")) ||
+		    hfs_json_is(json, hfs_json_field(json, event, "target"), "null") ||
+		    hfs_mmap_hash32(json, event, "manifest_hash", digest))
+			return -EPROTO;
+	}
+	return session->provider->view_event(session, json, event);
+}
+
+/* Copy a host status or phase word for a log line (1a4). The text comes from
+ * the host, so only [A-Z_] is printed; anything else (or a missing or
+ * oversized string) becomes "?".
+ */
+static void hfs_mmap_word(const struct hfs_json *json, int token, char *out, u32 cap)
+{
+	int len = hfs_json_string(json, token, out, cap);
+	int i;
+
+	for (i = 0; i < len; i++)
+		if (!(out[i] >= 'A' && out[i] <= 'Z') && out[i] != '_')
+			break;
+	if (len <= 0 || i < len) {
+		out[0] = '?';
+		out[1] = 0;
+	}
+}
+
+static int hfs_mmap_ack(struct hfs_mmap_control *control, const struct hfs_json *event,
+			int body, const char *phase, bool manifest, bool target)
+{
+	struct hfs_view *view = control->view;
+	struct hfs_session *session = view->session;
+	struct hfs_buf *payload = &control->ack;
+	struct hfs_json *reply = NULL;
+	int err, result;
+
+	payload->len = 0;
+	payload->error = 0;
+	hfs_buf_literal(payload, "{\"authority_hash\":");
+	hfs_buf_token(payload, event, hfs_json_field(event, body, "authority_hash"));
+	hfs_buf_literal(payload, ",\"closure_hash\":");
+	hfs_buf_token(payload, event, hfs_json_field(event, body, "closure_hash"));
+	hfs_buf_literal(payload, ",\"domain\":");
+	hfs_cap_write(payload, session->domain);
+	hfs_buf_literal(payload, ",\"inventory_hash\":");
+	hfs_buf_token(payload, event, hfs_json_field(event, body, "inventory_hash"));
+	hfs_buf_literal(payload, ",\"manifest\":");
+	if (manifest)
+		hfs_buf_add(payload, view->manifest.data, view->manifest.len);
+	else
+		hfs_buf_literal(payload, "null");
+	hfs_buf_printf(payload, ",\"phase\":\"%s\",\"recall\":", phase);
+	hfs_buf_token(payload, event, hfs_json_field(event, body, "recall"));
+	hfs_buf_literal(payload, ",\"sequence\":");
+	hfs_buf_token(payload, event, hfs_json_field(event, body, "sequence"));
+	hfs_buf_printf(payload, ",\"session\":\"%pUb\",\"target\":", &session->enrollment.session);
+	if (target)
+		hfs_buf_token(payload, event, hfs_json_field(event, body, "target"));
+	else
+		hfs_buf_literal(payload, "null");
+	hfs_buf_literal(payload, "}");
+	control->ack_phase = phase;
+	control->ack_status[0] = 0;
+	err = payload->error ?: hfs_controlled_before_ack(view, event, body, phase, payload);
+	if (!err)
+		err = hfs_control(session, "VIEW_ACK", payload, true, &reply);
+	if (err)
+		return err;
+	result = hfs_json_field(reply, 0, "payload");
+	hfs_mmap_word(reply, hfs_json_field(reply, result, "status"),
+		      control->ack_status, sizeof(control->ack_status));
+	if (hfs_json_exact(reply, result, "status"))
+		err = -EPROTO;
+	else if (hfs_json_is(reply, hfs_json_field(reply, result, "status"), "\"BLOCKED\""))
+		err = -EAGAIN;
+	else if (!hfs_json_is(reply, hfs_json_field(reply, result, "status"), "\"ACCEPTED\""))
+		err = -ESTALE;
+	if (!err)
+		err = hfs_controlled_after_ack(session, phase, payload, reply);
+	/* 2f4: a REOPENED ACK raised the mount's fence; wake VIEW_ACQUIRE
+	 * exchanges whose GRANTED reply arrived before it (hfs_view_grant_settle).
+	 */
+	if (!err && !strcmp(phase, "REOPENED"))
+		hfs_view_reopen_acked(view);
+	if (!err) {
+		control->last_ack.len = 0;
+		control->last_ack.error = 0;
+		hfs_buf_add(&control->last_ack, payload->data, payload->len);
+		err = control->last_ack.error;
+	}
+	hfs_json_free(reply);
+	return err;
+}
+
+/* Where the view control worker stopped (1a4); NULL fields print as "-". */
+struct hfs_mmap_where {
+	const char *step;	/* VIEW_WAIT, EVENT, DRAINED, DRAIN_WRITE or CLEANUP */
+	const char *event;	/* host event phase being processed */
+	const char *ack;	/* ACK phase sent for it */
+	const char *status;	/* host reply status */
+	const uuid_t *recall;	/* recall in progress, event executor only */
+};
+
+static const char *hfs_mmap_or_dash(const char *text)
+{
+	return text && text[0] ? text : "-";
+}
+
+/* The worker stops for good here (no further VIEW_WAIT or ACK), so the
+ * cause must be visible in the guest log of a lab run. Before 1a4 the line
+ * was a ratelimited "view control worker stopped, error %d": zq3-r11's -116
+ * did not say which session, which recall step or what the host answered
+ * (it was the host's STALE to an early DRAINED). The line now names the
+ * enrolled session UUID, the worker step, the host event and ACK phases, the
+ * host's reply status, the view phase and the recall, and keeps the old
+ * prefix text so earlier run notes still match.
+ *
+ * Once per session, as hfs_session_block (m64): a plain pr_warn bounded by
+ * its own once bit (HFS_REPORTED_VIEW_STOP), so a burst cannot drop the
+ * session's only explanation and two failing workers of one session log
+ * once. hfs_session_block's bit 0 is left alone: a later independent block
+ * of the same session (a QUERY timeout, a failed FORGET) still logs its own
+ * line, which is evidence of its own; that costs at most one extra line.
+ * A missing recall prints "-". Since oc4 the line also prints the raw
+ * reason of the session's last exporter ERROR reply ("-" for none; see
+ * hfs_session_block), right after the errno.
+ */
+static void hfs_mmap_fail(struct hfs_mmap_control *control, int error,
+			  const struct hfs_mmap_where *where)
+{
+	struct hfs_view *view = control->view;
+	struct hfs_session *session = view->session;
+	u16 code = READ_ONCE(session->exporter_error);
+	char text[8] = "-";
+
+	WRITE_ONCE(control->error, error);
+	hfs_session_mark_blocked(session); /* 5f4: wakes the view waits */
+	if (!test_and_set_bit(HFS_REPORTED_VIEW_STOP, &session->block_reported)) {
+		if (code)
+			snprintf(text, sizeof(text), "%u", code);
+		if (where->recall)
+			pr_warn("9p-hfs: session %pUb view control worker stopped, error %d, exporter ERROR %s, at %s (event %s, ack %s, host status %s, view phase %s, recall %pUb); later operations on this mount fail\n",
+				&session->enrollment.session, error, text,
+				hfs_mmap_or_dash(where->step), hfs_mmap_or_dash(where->event),
+				hfs_mmap_or_dash(where->ack), hfs_mmap_or_dash(where->status),
+				hfs_view_phase_name(READ_ONCE(view->phase)), where->recall);
+		else
+			pr_warn("9p-hfs: session %pUb view control worker stopped, error %d, exporter ERROR %s, at %s (event %s, ack %s, host status %s, view phase %s, recall -); later operations on this mount fail\n",
+				&session->enrollment.session, error, text,
+				hfs_mmap_or_dash(where->step), hfs_mmap_or_dash(where->event),
+				hfs_mmap_or_dash(where->ack), hfs_mmap_or_dash(where->status),
+				hfs_view_phase_name(READ_ONCE(view->phase)));
+	}
+	/* This closes admission, not a declaration of physical STOPPED. All
+	 * original grants/bytes/tickets and canonical evidence remain retained.
+	 */
+	hfs_view_fence(view);
+}
+
+/* An event executor failure: its own record says how far it got. */
+static void hfs_mmap_fail_event(struct hfs_mmap_control *control, int error,
+				const char *step)
+{
+	struct hfs_mmap_where where = {
+		.step = step,
+		.event = control->event_phase,
+		.ack = control->ack_phase,
+		.status = control->ack_status,
+		.recall = control->have_recall ? &control->recall : NULL,
+	};
+
+	hfs_mmap_fail(control, error, &where);
+}
+
+/* The event executor starts on a host event: forget the previous ACK. */
+static void hfs_mmap_note_event(struct hfs_mmap_control *control,
+				const struct hfs_json *json)
+{
+	int event = hfs_json_field(json, hfs_json_field(json, 0, "payload"), "event");
+
+	hfs_mmap_word(json, hfs_json_field(json, event, "phase"),
+		      control->event_phase, sizeof(control->event_phase));
+	control->ack_phase = NULL;
+	control->ack_status[0] = 0;
+}
+
+static void hfs_mmap_drains(struct work_struct *work)
+{
+	struct hfs_mmap_control *control = container_of(work, struct hfs_mmap_control, drains);
+	struct hfs_view *view = control->view;
+	struct hfs_dirty *dirty, *ordered[HFS_DIRTY_PAGES_MAX], *tmp;
+	unsigned long flags;
+	u32 count = 0, i, j;
+	int err;
+
+	if (READ_ONCE(control->stopping) || READ_ONCE(control->error))
+		return;
+	spin_lock_irqsave(&view->lock, flags);
+	list_for_each_entry(dirty, &view->dirty, list) {
+		if (count == ARRAY_SIZE(ordered)) {
+			spin_unlock_irqrestore(&view->lock, flags);
+			hfs_mmap_fail(control, -EOVERFLOW,
+				      &(struct hfs_mmap_where){ .step = "DRAIN_WRITE" });
+			return;
+		}
+		ordered[count++] = dirty;
+	}
+	spin_unlock_irqrestore(&view->lock, flags);
+	/* Ordinary earmarks form a contiguous protected origin sequence. Drain
+	 * in that order; manifest order independently remains DirtyEntry id.
+	 */
+	for (i = 1; i < count; i++) {
+		tmp = ordered[i];
+		for (j = i; j && ordered[j - 1]->request->number > tmp->request->number; j--)
+			ordered[j] = ordered[j - 1];
+		ordered[j] = tmp;
+	}
+	for (i = 0; i < count; i++) {
+		err = hfs_dirty_drain(view, ordered[i]);
+		if (err) {
+			hfs_mmap_fail(control, err,
+				      &(struct hfs_mmap_where){ .step = "DRAIN_WRITE" });
+			return;
+		}
+	}
+}
+
+static void hfs_mmap_drained(struct work_struct *work);
+static void hfs_mmap_retire_kick(struct hfs_view *view, bool force);
+
+static int hfs_mmap_process(struct hfs_mmap_control *control, struct hfs_json *json)
+{
+	struct hfs_view *view = control->view;
+	struct hfs_dirty *dirty;
+	unsigned long flags;
+	u8 hash[32];
+	uuid_t recall, old;
+	u64 sequence;
+	int body = hfs_json_field(json, 0, "payload");
+	int event = hfs_json_field(json, body, "event");
+	int phase = hfs_json_field(json, event, "phase");
+	int target = hfs_json_field(json, event, "target");
+	int err;
+
+	err = hfs_mmap_event_check(view, json, event, &sequence, &recall);
+	if (err)
+		return err;
+	if (sequence <= control->completed)
+		return -ESTALE;
+	err = hfs_uuid(json, hfs_json_field(json, event, "old_visibility"), &old);
+	if (err)
+		return err;
+	if (hfs_json_is(json, phase, "\"RECALL\"")) {
+		if (!control->have_recall) {
+			spin_lock_irqsave(&view->lock, flags);
+			err = view->phase == HFS_VIEW_UNBOUND ||
+				(uuid_equal(&old, &view->generation) &&
+				 view->phase == HFS_VIEW_LIVE) ? 0 : -ESTALE;
+			spin_unlock_irqrestore(&view->lock, flags);
+			if (err)
+				return err;
+			control->recall = recall;
+			control->old_visibility = old;
+			control->have_recall = true;
+			control->drained_acked = false;
+		}
+		if (!uuid_equal(&control->recall, &recall) ||
+		    !uuid_equal(&control->old_visibility, &old))
+			return -ESTALE;
+		err = hfs_view_stop(view, &old, &recall, sequence);
+		if (err)
+			return err;
+		if (view->phase == HFS_VIEW_QUIESCENT) {
+			/* Admission is closed; only this event executor changes the
+			 * frozen registry until STOPPED has been accepted.
+			 */
+			list_for_each_entry(dirty, &view->dirty, list) {
+				err = hfs_dirty_freeze(view, dirty);
+				if (err)
+					return err;
+			}
+			err = hfs_view_seal(view);
+			if (err)
+				return err;
+		}
+		err = hfs_mmap_ack(control, json, event, "STOPPED", true, false);
+		if (!err)
+			queue_work(control->drain_queue, &control->drains);
+		return err;
+	}
+	if (!control->have_recall || !uuid_equal(&control->recall, &recall) ||
+	    !uuid_equal(&control->old_visibility, &old) ||
+	    hfs_mmap_hash32(json, event, "manifest_hash", hash) ||
+	    memcmp(hash, view->manifest_hash, 32))
+		return -ESTALE;
+	if (hfs_json_is(json, phase, "\"INSTALL_DRAIN\"")) {
+		err = hfs_mmap_install(view, json, target, &recall, sequence, false);
+		if (!err)
+			err = hfs_mmap_ack(control, json, event, "INSTALLED_DRAIN", false, true);
+		if (!err) {
+			struct hfs_json *retained = NULL;
+
+			err = hfs_received_copy(json, 0, &retained);
+			if (!err) {
+				hfs_json_free(control->drain_event);
+				control->drain_event = retained;
+				queue_delayed_work(control->event_queue, &control->drained, 0);
+			}
+		}
+		return err;
+	}
+	if (hfs_json_is(json, phase, "\"INSTALL_FINAL\"")) {
+		err = hfs_mmap_install(view, json, target, &recall, sequence, true);
+		if (!err)
+			err = hfs_mmap_ack(control, json, event, "INSTALLED_FINAL", false, true);
+		return err;
+	}
+	if (!hfs_json_is(json, phase, "\"REOPEN\"") ||
+	    !hfs_mmap_token(json, target, view->target.data, view->target.len))
+		return -ESTALE;
+	err = hfs_view_reopen(view, &recall, sequence);
+	if (!err)
+		err = hfs_mmap_ack(control, json, event, "REOPENED", false, true);
+	if (!err) {
+		control->have_recall = false;
+		/* re4: the host ends the recall at this ACK, and with it the
+		 * refusal of a VIEW_RETIRE that was BLOCKED during the recall.
+		 */
+		hfs_mmap_retire_kick(view, true);
+	}
+	return err;
+}
+
+static void hfs_mmap_drained(struct work_struct *work)
+{
+	struct hfs_mmap_control *control = container_of(to_delayed_work(work),
+						       struct hfs_mmap_control, drained);
+	struct hfs_json *json = control->drain_event;
+	struct hfs_view *view = control->view;
+	int body, event, err;
+
+	if (!json || control->drained_acked || READ_ONCE(control->stopping) ||
+	    READ_ONCE(control->error))
+		return;
+	hfs_mmap_note_event(control, json);
+	err = READ_ONCE(view->phase) == HFS_VIEW_DRAINED ? 0 : hfs_mmap_finish_drained(view);
+	if (!err) {
+		body = hfs_json_field(json, 0, "payload");
+		event = hfs_json_field(json, body, "event");
+		err = hfs_mmap_ack(control, json, event, "DRAINED", true, true);
+	}
+	if (err == -EAGAIN || err == -EBUSY) {
+		if (!READ_ONCE(control->stopping))
+			queue_delayed_work(control->event_queue, &control->drained, msecs_to_jiffies(10));
+	} else if (err) {
+		hfs_mmap_fail_event(control, err, "DRAINED");
+	} else {
+		control->drained_acked = true;
+	}
+}
+
+static void hfs_mmap_events(struct work_struct *work)
+{
+	struct hfs_mmap_control *control = container_of(to_delayed_work(work),
+						       struct hfs_mmap_control, events);
+	struct hfs_json *json;
+	unsigned long flags;
+	u64 sequence;
+	int body, event, err;
+
+	spin_lock_irqsave(&control->lock, flags);
+	json = control->count ? control->pending[control->head] : NULL;
+	spin_unlock_irqrestore(&control->lock, flags);
+	if (!json || READ_ONCE(control->stopping) || READ_ONCE(control->error))
+		return;
+	hfs_mmap_note_event(control, json);
+	err = hfs_mmap_process(control, json);
+	if (err == -EAGAIN || err == -EBUSY) {
+		if (!READ_ONCE(control->stopping))
+			queue_delayed_work(control->event_queue, &control->events, msecs_to_jiffies(10));
+		return;
+	}
+	if (err) {
+		hfs_mmap_fail_event(control, err, "EVENT");
+		return;
+	}
+	body = hfs_json_field(json, 0, "payload");
+	event = hfs_json_field(json, body, "event");
+	err = hfs_json_u64(json, hfs_json_field(json, event, "sequence"), &sequence);
+	if (err) {
+		hfs_mmap_fail_event(control, err, "EVENT");
+		return;
+	}
+	spin_lock_irqsave(&control->lock, flags);
+	control->pending[control->head] = NULL;
+	control->head = (control->head + 1) % ARRAY_SIZE(control->pending);
+	control->count--;
+	control->completed = sequence;
+	spin_unlock_irqrestore(&control->lock, flags);
+	hfs_json_free(control->last_event);
+	control->last_event = json; /* complete actual canonical envelope */
+	if (!READ_ONCE(control->stopping)) {
+		queue_delayed_work(control->poll_queue, &control->poll, 0);
+		queue_delayed_work(control->event_queue, &control->events, 0);
+	}
+}
+
+static void hfs_mmap_poll(struct work_struct *work)
+{
+	struct hfs_mmap_control *control = container_of(to_delayed_work(work),
+						       struct hfs_mmap_control, poll);
+	struct hfs_session *session = control->view->session;
+	struct hfs_buf *payload = &control->poll_payload;
+	struct hfs_json *reply = NULL;
+	unsigned long flags;
+	uuid_t recall;
+	u64 after, sequence;
+	char status[24] = "";
+	int body, event, err;
+
+	if (READ_ONCE(control->stopping) || READ_ONCE(control->error))
+		return;
+	spin_lock_irqsave(&control->lock, flags);
+	if (control->count == ARRAY_SIZE(control->pending)) {
+		spin_unlock_irqrestore(&control->lock, flags);
+		return;
+	}
+	after = control->delivered;
+	spin_unlock_irqrestore(&control->lock, flags);
+	payload->len = 0;
+	payload->error = 0;
+	hfs_buf_printf(payload, "{\"after_sequence\":%llu,\"domain\":", after);
+	hfs_cap_write(payload, session->domain);
+	hfs_buf_literal(payload, "}");
+	err = payload->error ?: hfs_control(session, "VIEW_WAIT", payload, true, &reply);
+	if (err)
+		goto failed;
+	body = hfs_json_field(reply, 0, "payload");
+	event = hfs_json_field(reply, body, "event");
+	if (hfs_json_exact(reply, body, "event,status")) {
+		err = -EPROTO;
+		goto failed;
+	}
+	if (hfs_json_is(reply, hfs_json_field(reply, body, "status"), "\"EMPTY\"")) {
+		if (!hfs_json_is(reply, event, "null")) {
+			err = -EPROTO;
+			goto failed;
+		}
+		hfs_json_free(reply);
+		if (!READ_ONCE(control->stopping))
+			queue_delayed_work(control->poll_queue, &control->poll, msecs_to_jiffies(10));
+		return;
+	}
+	if (!hfs_json_is(reply, hfs_json_field(reply, body, "status"), "\"EVENT\"")) {
+		err = -EPROTO;
+		goto failed;
+	}
+	err = hfs_mmap_event_check(control->view, reply, event, &sequence, &recall);
+	if (err || sequence <= after) {
+		err = err ?: -ESTALE;
+		goto failed;
+	}
+	spin_lock_irqsave(&control->lock, flags);
+	control->pending[(control->head + control->count) % ARRAY_SIZE(control->pending)] = reply;
+	control->count++;
+	control->delivered = sequence;
+	spin_unlock_irqrestore(&control->lock, flags);
+	/* Repost the independent reserved VIEW_WAIT before any event ACK. */
+	if (!READ_ONCE(control->stopping)) {
+		queue_delayed_work(control->poll_queue, &control->poll, 0);
+		queue_delayed_work(control->event_queue, &control->events, 0);
+	}
+	return;
+failed:
+	/* The canonical unexpected response remains retained for inspection. */
+	if (reply) {
+		hfs_mmap_word(reply, hfs_json_field(reply, hfs_json_field(reply, 0, "payload"),
+						    "status"), status, sizeof(status));
+		spin_lock_irqsave(&control->lock, flags);
+		control->pending[(control->head + control->count) % ARRAY_SIZE(control->pending)] = reply;
+		control->count++;
+		spin_unlock_irqrestore(&control->lock, flags);
+	}
+	hfs_mmap_fail(control, err,
+		      &(struct hfs_mmap_where){ .step = "VIEW_WAIT", .status = status });
+}
+
+static void hfs_mmap_pressure_work(struct work_struct *work);
+static void hfs_mmap_retire_work(struct work_struct *work);
+
+int hfs_mmap_start(struct hfs_view *view)
+{
+	struct hfs_mmap_control *control;
+	struct hfs_session *session = view->session;
+	unsigned long flags;
+	int err;
+
+	if (!session->bridge_minor || view->control ||
+	    (!view->target.len && view->phase != HFS_VIEW_UNBOUND))
+		return -EINVAL;
+	control = kzalloc(sizeof(*control), GFP_KERNEL);
+	if (!control)
+		return -ENOMEM;
+	/* Independent bounded control workspaces. Ticket/request credits cover
+	 * their own immutable sources; this covers envelopes/polls/ACK retention.
+	 */
+	if (session->bridge_minor == 4 &&
+	    session->enrollment.protocol_features == HFS_TERMINAL_FEATURES &&
+	    hfs_controlled_consumed(session)) {
+		/* Progress parents already charge event/ACK carriers, parsers and
+		 * retained Received owners. Charge the actual persistent actor
+		 * buffers here; tickets and dirty packages retain their charges.
+		 */
+		if (!session->control_completion || !session->retirement_completion) {
+			err = -ESTALE;
+			goto allocation;
+		}
+		err = session->provider->reserve(session,
+				sizeof(*control) + 16384ULL + 2ULL * HFS_BODY_MAX,
+				true, &control->credit);
+	} else {
+		err = session->provider->reserve(session,
+				sizeof(*control) + 32ULL * 1024 * 1024,
+				true, &control->credit);
+	}
+	if (err)
+		goto allocation;
+	control->view = hfs_view_get(session);
+	if (control->view != view) {
+		err = -ESTALE;
+		goto references;
+	}
+	if (hfs_buf_init(&control->poll_payload, 16384) ||
+	    hfs_buf_init(&control->ack, HFS_BODY_MAX) ||
+	    hfs_buf_init(&control->last_ack, HFS_BODY_MAX)) {
+		err = -ENOMEM;
+		goto buffers;
+	}
+	control->poll_queue = alloc_workqueue("9p-hfs-poll", WQ_UNBOUND | WQ_MEM_RECLAIM, 1);
+	control->event_queue = alloc_workqueue("9p-hfs-events", WQ_UNBOUND | WQ_MEM_RECLAIM, 1);
+	control->drain_queue = alloc_workqueue("9p-hfs-drains", WQ_UNBOUND | WQ_MEM_RECLAIM, 1);
+	control->cleanup_queue = alloc_workqueue("9p-hfs-cleanup", WQ_UNBOUND | WQ_MEM_RECLAIM, 1);
+	control->pressure_queue = alloc_workqueue("9p-hfs-pressure", WQ_UNBOUND | WQ_MEM_RECLAIM, 1);
+	if (!control->poll_queue || !control->event_queue ||
+	    !control->drain_queue || !control->cleanup_queue || !control->pressure_queue) {
+		err = -ENOMEM;
+		goto queues;
+	}
+	kref_init(&control->refs);
+	spin_lock_init(&control->lock);
+	INIT_LIST_HEAD(&control->cleanup);
+	INIT_DELAYED_WORK(&control->poll, hfs_mmap_poll);
+	INIT_DELAYED_WORK(&control->events, hfs_mmap_events);
+	INIT_DELAYED_WORK(&control->pressure, hfs_mmap_pressure_work);
+	INIT_DELAYED_WORK(&control->drained, hfs_mmap_drained);
+	INIT_DELAYED_WORK(&control->retire, hfs_mmap_retire_work);
+	/* jiffies starts near wrap: a zero stamp could hold kicks for minutes. */
+	control->retire_after = jiffies;
+	INIT_WORK(&control->drains, hfs_mmap_drains);
+	spin_lock_irqsave(&view->lock, flags);
+	if (view->control || (view->phase != HFS_VIEW_LIVE && view->phase != HFS_VIEW_UNBOUND)) {
+		spin_unlock_irqrestore(&view->lock, flags);
+		err = -ESTALE;
+		goto queues;
+	}
+	view->control = control;
+	spin_unlock_irqrestore(&view->lock, flags);
+	queue_delayed_work(control->poll_queue, &control->poll, 0);
+	return 0;
+queues:
+	if (control->pressure_queue)
+		destroy_workqueue(control->pressure_queue);
+	if (control->cleanup_queue)
+		destroy_workqueue(control->cleanup_queue);
+	if (control->drain_queue)
+		destroy_workqueue(control->drain_queue);
+	if (control->event_queue)
+		destroy_workqueue(control->event_queue);
+	if (control->poll_queue)
+		destroy_workqueue(control->poll_queue);
+buffers:
+	hfs_buf_free(&control->poll_payload);
+	hfs_buf_free(&control->ack);
+	hfs_buf_free(&control->last_ack);
+references:
+	hfs_view_put(control->view);
+	session->provider->unreserve(session, control->credit);
+allocation:
+	kfree(control);
+	return err;
+}
+
+static void hfs_mmap_quiesce_control(struct hfs_mmap_control *control)
+{
+	cancel_delayed_work_sync(&control->poll);
+	cancel_delayed_work_sync(&control->events);
+	cancel_delayed_work_sync(&control->drained);
+	cancel_delayed_work_sync(&control->pressure);
+	/* A queued retire work owns a control reference (hfs_mmap_retire_kick). */
+	if (cancel_delayed_work_sync(&control->retire))
+		hfs_mmap_control_put(control);
+	flush_workqueue(control->drain_queue);
+	flush_workqueue(control->cleanup_queue);
+}
+
+int hfs_mmap_prepare_retire(struct hfs_view *view)
+{
+	struct hfs_mmap_control *control;
+	unsigned long flags;
+
+	spin_lock_irqsave(&view->lock, flags);
+	control = view->control;
+	if (!control) {
+		spin_unlock_irqrestore(&view->lock, flags);
+		return 0;
+	}
+	kref_get(&control->refs);
+	if (view->nr_cached || view->nr_dirty || view->nr_observations || view->active ||
+	    refcount_read(&control->refs.refcount) != 2) {
+		spin_unlock_irqrestore(&view->lock, flags);
+		hfs_mmap_control_put(control);
+		return -EBUSY;
+	}
+	/* Stop generating new transport cells before whole-session retirement
+	 * evidence is verified. Canonical events/ACKs/unknowns remain owned.
+	 * A failed/unknown retirement never silently reopens this old lifetime.
+	 */
+	view->phase = HFS_VIEW_FENCED;
+	WRITE_ONCE(control->stopping, true);
+	spin_unlock_irqrestore(&view->lock, flags);
+	wake_up_all(&view->wait);
+	hfs_mmap_quiesce_control(control);
+	hfs_mmap_control_put(control);
+	return 0;
+}
+
+/* This exact controlled terminal seam disposes joined, physically empty
+ * bookkeeping. It neither sets retired nor weakens generic STOP authority. */
+int hfs_mmap_terminal_prepare(struct hfs_view *view)
+{
+	struct hfs_session *session = view->session;
+	struct hfs_mmap_control *control;
+	unsigned long flags;
+	u32 i;
+	int err;
+
+	if (session->enrollment.protocol_features != HFS_TERMINAL_FEATURES || !session->closing ||
+	    !session->retained)
+		return -EACCES;
+	err = hfs_mmap_prepare_retire(view);
+	if (err)
+		return err;
+	spin_lock_irqsave(&view->lock, flags);
+	control = view->control;
+	if (view->active || view->nr_cached || view->nr_dirty || view->nr_dirty_packages ||
+	    view->nr_observations || view->nr_mappings || view->nr_grants ||
+	    refcount_read(&view->refs.refcount) != (control ? 3 : 2)) {
+		spin_unlock_irqrestore(&view->lock, flags);
+		return -EBUSY;
+	}
+	if (!control) {
+		view->phase = HFS_VIEW_FENCED;
+		spin_unlock_irqrestore(&view->lock, flags);
+		return 0;
+	}
+	kref_get(&control->refs);
+	spin_unlock_irqrestore(&view->lock, flags);
+	/* The real cancel/flush above joins every actor before inspecting these
+	 * private fields; an actor's extra reference or revealed event refuses. */
+	if (refcount_read(&control->refs.refcount) != 2 || control->error || !control->stopping ||
+	    control->count || control->have_recall || control->delivered != control->completed ||
+	    !list_empty(&control->cleanup) || (control->drain_event && !control->drained_acked)) {
+		err = -EBUSY;
+		goto out;
+	}
+	for (i = 0; i < ARRAY_SIZE(control->pending); i++)
+		if (control->pending[i]) {
+			err = -EBUSY;
+			goto out;
+		}
+	err = hfs_controlled_terminal_event_done(session, control->last_event, &control->last_ack,
+						 control->completed);
+	if (!err && control->drain_event)
+		err = hfs_received_exclusive(session, control->drain_event);
+	if (err)
+		goto out;
+	spin_lock_irqsave(&view->lock, flags);
+	if (view->control != control || refcount_read(&control->refs.refcount) != 2) {
+		spin_unlock_irqrestore(&view->lock, flags);
+		err = -EBUSY;
+		goto out;
+	}
+	view->control = NULL;
+	spin_unlock_irqrestore(&view->lock, flags);
+	destroy_workqueue(control->pressure_queue);
+	destroy_workqueue(control->cleanup_queue);
+	destroy_workqueue(control->drain_queue);
+	destroy_workqueue(control->event_queue);
+	destroy_workqueue(control->poll_queue);
+	hfs_json_free(control->last_event);
+	control->last_event = NULL;
+	hfs_json_free(control->drain_event);
+	control->drain_event = NULL;
+	hfs_mmap_control_put(control); /* actual owner */
+	err = 0;
+out:
+	hfs_mmap_control_put(control); /* this joined caller */
+	return err;
+}
+
+int hfs_mmap_stop(struct hfs_view *view)
+{
+	struct hfs_mmap_control *control;
+	unsigned long flags;
+	u32 i;
+
+	spin_lock_irqsave(&view->lock, flags);
+	control = view->control;
+	if (!control) {
+		spin_unlock_irqrestore(&view->lock, flags);
+		return 0;
+	}
+	kref_get(&control->refs); /* independent STOP caller lifetime */
+	/* A generic stop callback, disconnect and bare fence are insufficient.
+	 * Whole-session protected retirement is verified by the provider before
+	 * this flag; local physical/cache/source owners must already be gone.
+	 */
+	if (!view->session->retired || view->phase != HFS_VIEW_FENCED ||
+	    view->nr_cached || view->nr_dirty || view->active ||
+	    refcount_read(&control->refs.refcount) != 2) {
+		spin_unlock_irqrestore(&view->lock, flags);
+		hfs_mmap_control_put(control);
+		return -EBUSY;
+	}
+	WRITE_ONCE(control->stopping, true);
+	view->control = NULL;
+	spin_unlock_irqrestore(&view->lock, flags);
+	hfs_mmap_quiesce_control(control);
+	destroy_workqueue(control->pressure_queue);
+	destroy_workqueue(control->cleanup_queue);
+	destroy_workqueue(control->drain_queue);
+	destroy_workqueue(control->event_queue);
+	destroy_workqueue(control->poll_queue);
+	for (i = 0; i < ARRAY_SIZE(control->pending); i++)
+		hfs_json_free(control->pending[i]);
+	hfs_json_free(control->last_event);
+	hfs_json_free(control->drain_event);
+	hfs_mmap_control_put(control); /* owner removed under view lock */
+	hfs_mmap_control_put(control); /* this STOP caller */
+	return 0;
+}
+
+struct hfs_cache_cleanup {
+	struct list_head list;
+	struct delayed_work work;
+	struct hfs_mmap_control *control;
+	struct hfs_lease *lease;
+	struct list_head readers;
+	struct hfs_dirty *pending;
+	void *credit;
+	bool dirty_slot;
+};
+
+static void hfs_mmap_cleanup(struct work_struct *work)
+{
+	struct hfs_cache_cleanup *cleanup = container_of(to_delayed_work(work),
+						       struct hfs_cache_cleanup, work);
+	struct hfs_mmap_control *control = cleanup->control;
+	struct hfs_view *view = control->view;
+	struct hfs_session *session = view->session;
+	struct hfs_cache_grant *grant, *next;
+	struct hfs_dirty *dirty = cleanup->pending;
+	unsigned long flags;
+	int err;
+
+	if (READ_ONCE(control->error))
+		return; /* retained in control->cleanup with exact source ownership */
+	if (dirty && dirty->request) {
+		if (!dirty->reserve_ticket->bound || !dirty->reserve_ticket->admitted) {
+			err = hfs_dirty_resume_reserve(session, dirty, cleanup->lease);
+			if (err && err != -EAGAIN && err != -ECANCELED)
+				goto failed;
+		}
+		err = hfs_request_cancel_earmark(session, dirty->request);
+		if (err) {
+			if (err != -EAGAIN && err != -EBUSY)
+				goto failed;
+			/* Only actual old-epoch STOPPED exclusion/source closure can
+			 * cancel an issued unseen reservation. Its original preowned
+			 * RELEASE starts that recall without acquisition-family credit.
+			 */
+			err = hfs_lease_release(session, cleanup->lease);
+			if (err)
+				goto failed;
+			queue_delayed_work(control->cleanup_queue, &cleanup->work, msecs_to_jiffies(10));
+			return;
+		}
+		hfs_request_unhold(session, dirty->request);
+		dirty->request = NULL;
+	}
+	if (dirty) {
+		hfs_view_ticket_put(dirty->reserve_ticket);
+		hfs_view_ticket_put(dirty->freeze_ticket);
+		hfs_json_free(dirty->reservation);
+		hfs_json_free(dirty->frozen_entry);
+		hfs_buf_free(&dirty->freeze_payload);
+		hfs_buf_free(&dirty->drain_args);
+		session->provider->unreserve(session, dirty->credit);
+		kfree(dirty);
+		cleanup->pending = NULL;
+	}
+	if (cleanup->lease) {
+		err = hfs_lease_release(session, cleanup->lease);
+		if (err)
+			goto failed;
+		hfs_lease_free(cleanup->lease);
+		cleanup->lease = NULL;
+	}
+	list_for_each_entry_safe(grant, next, &cleanup->readers, list) {
+		err = hfs_lease_release(session, grant->lease);
+		if (err)
+			goto failed;
+		list_del(&grant->list);
+		hfs_lease_free(grant->lease);
+		session->provider->unreserve(session, grant->reservation);
+		kfree(grant);
+	}
+	if (cleanup->dirty_slot) {
+		spin_lock_irqsave(&view->lock, flags);
+		view->nr_dirty_packages--;
+		spin_unlock_irqrestore(&view->lock, flags);
+		cleanup->dirty_slot = false;
+	}
+	/* Exact protected floors, independently keyed full-Cred ticket families.
+	 * Neither routine invents a gap result or drops a held/uncertain row.
+	 */
+	hfs_retire(session);
+	hfs_view_retire(session);
+	spin_lock_irqsave(&control->lock, flags);
+	list_del(&cleanup->list);
+	spin_unlock_irqrestore(&control->lock, flags);
+	session->provider->unreserve(session, cleanup->credit);
+	kfree(cleanup);
+	hfs_mmap_control_put(control);
+	return;
+failed:
+	if (err == -EAGAIN || err == -EBUSY || err == -ENOSPC || err == -ENOMEM) {
+		queue_delayed_work(control->cleanup_queue, &cleanup->work, msecs_to_jiffies(10));
+		return;
+	}
+	hfs_mmap_fail(control, err, &(struct hfs_mmap_where){ .step = "CLEANUP" });
+}
+
+static void hfs_mmap_dispose(struct hfs_cache_page *entry)
+{
+	struct hfs_cache_cleanup *cleanup = entry->cleanup;
+
+	/* kref destruction runs under arbitrary page/VFS context. Transfer only
+	 * preowned records; the independent worker performs every parked RPC.
+	 */
+	if (entry->lease)
+		cleanup->lease = entry->lease;
+	cleanup->dirty_slot = entry->dirty_slot;
+	list_splice_init(&entry->readers, &cleanup->readers);
+	queue_delayed_work(cleanup->control->cleanup_queue, &cleanup->work, 0);
+}
+
+static int hfs_mmap_prepare(struct hfs_view *view, const struct hfs_view_stamp *stamp,
+			    struct hfs_cache_page **out)
+{
+	struct hfs_cache_cleanup *cleanup;
+	struct hfs_mmap_control *control = hfs_mmap_control_get(view);
+	unsigned long flags;
+	int err;
+
+	*out = NULL;
+	if (!control)
+		return -ESTALE;
+	cleanup = kzalloc(sizeof(*cleanup), GFP_KERNEL);
+	if (!cleanup) {
+		err = -ENOMEM;
+		goto reference;
+	}
+	err = view->session->provider->reserve(view->session, sizeof(*cleanup), true, &cleanup->credit);
+	if (err)
+		goto allocation;
+	err = hfs_view_page_prepare(view, stamp, out);
+	if (err)
+		goto credit;
+	cleanup->control = control;
+	INIT_LIST_HEAD(&cleanup->list);
+	INIT_LIST_HEAD(&cleanup->readers);
+	INIT_DELAYED_WORK(&cleanup->work, hfs_mmap_cleanup);
+	spin_lock_irqsave(&control->lock, flags);
+	list_add_tail(&cleanup->list, &control->cleanup);
+	spin_unlock_irqrestore(&control->lock, flags);
+	(*out)->cleanup = cleanup;
+	(*out)->dispose = hfs_mmap_dispose;
+	return 0;
+credit:
+	view->session->provider->unreserve(view->session, cleanup->credit);
+allocation:
+	kfree(cleanup);
+reference:
+	hfs_mmap_control_put(control);
+	return err;
+}
+
+/* Release one published cache-page lease to start recall progress while
+ * acquisition or cache capacity is blocked.
+ *
+ * Any release recalls the domain, and the recall moves the view under every
+ * request still in flight: its first admission can be refused behind the
+ * recall and its stamped hfs_view_enter (hfs_attr_install) can see a moved
+ * fence/revision and return ESTALE (p84, zq3-r9 R9-1). Two rules keep that
+ * off requests that never asked for it:
+ *
+ * - Observation leases are never selected. Every entry on view->observations
+ *   is still in use: hfs_mmap_begin publishes it and only hfs_mmap_end, after
+ *   the request completed, removes it and queues its release.
+ * - A transport-triggered (background) pass holds while any observation is
+ *   in flight, for at most HFS_PRESSURE_HOLD_MS. hfs_transport queues it
+ *   after any 50 ms ordinary-lane wait, which does not show that a cache
+ *   release would help the waiting request.
+ *
+ * The hold must stay bounded. Recalls never depend on it: the host starts
+ * the recall a conflict needs itself, and hfs_view_stop revokes observation
+ * leases without waiting for their requests. Host acquisition capacity does:
+ * a held cache lease pins its ticket family's retirement floor, so once
+ * identities are exhausted only a release frees one, and the background
+ * pass may be the only caller. read()/write() copy user buffers inside
+ * their own observation, so a fault on an uncached HFS MAP_SHARED buffer
+ * acquires while that observation is in flight. An unbounded hold could
+ * then outlast the 30 s acquisition window, and that timeout leaves an
+ * uncertain ticket that pins the floor. After the bound one cache lease is
+ * released and the hold restarts, so a busy view pays at most one recall
+ * per HFS_PRESSURE_HOLD_MS. A held pass still advances pressure_after in
+ * hfs_mmap_progress; that only rate-limits retries.
+ *
+ * An early observation release would return no guest ticket capacity (that
+ * comes back only at lease free). Capacity callers (the 129th clean page,
+ * read-first mkwrite, dirty sync) pass background == false and release a
+ * cache lease at once, even under an in-flight request; they cannot
+ * progress otherwise, so that residual cost is accepted.
+ */
+static int hfs_mmap_pressure(struct hfs_view *view, bool background)
+{
+	struct hfs_cache_page *entry;
+	struct hfs_lease *lease = NULL;
+	unsigned long flags;
+	bool hold = false;
+	int err;
+
+	spin_lock_irqsave(&view->lock, flags);
+	if (!view->nr_observations) {
+		view->pressure_holding = false;
+	} else if (background) {
+		if (!view->pressure_holding) {
+			view->pressure_holding = true;
+			view->pressure_held_since = jiffies;
+		}
+		hold = time_before(jiffies, view->pressure_held_since +
+				   msecs_to_jiffies(HFS_PRESSURE_HOLD_MS));
+		if (!hold)
+			view->pressure_holding = false;
+	}
+	if (!hold)
+		list_for_each_entry(entry, &view->cache, list)
+			if (entry->lease && READ_ONCE(entry->lease->published) &&
+			    !READ_ONCE(entry->lease->released)) {
+				lease = entry->lease;
+				break;
+			}
+	if (lease)
+		hfs_lease_get(lease);
+	spin_unlock_irqrestore(&view->lock, flags);
+	if (!lease)
+		return -EAGAIN;
+	/* No page, transition, PTE or physical admission token covers this wait.
+	 * The original lease has already reserved RELEASE identity/credit.
+	 */
+	err = hfs_lease_release(view->session, lease);
+	hfs_lease_free(lease);
+	return err;
+}
+
+static void hfs_mmap_pressure_work(struct work_struct *work)
+{
+	struct hfs_mmap_control *control = container_of(to_delayed_work(work),
+						       struct hfs_mmap_control, pressure);
+
+	if (!READ_ONCE(control->error) && !READ_ONCE(control->stopping))
+		hfs_mmap_pressure(control->view, true);
+	hfs_mmap_control_put(control); /* transferred by the successful queue */
+}
+
+/* Caller holds view->lock: nothing left for the unmount stop to refuse. */
+static bool hfs_view_settled(const struct hfs_view *view)
+{
+	return !view->active && !view->nr_dirty && !view->nr_cached && !view->nr_observations &&
+	       !view->nr_mappings &&
+	       (view->phase == HFS_VIEW_UNBOUND || view->phase == HFS_VIEW_LIVE || view->quiescent);
+}
+
+/* z84: best-effort settle of an unmounting view before the controlled stop.
+ * kill_sb calls this after kill_anon_super and the control flush, with
+ * admission closed. The last I/O's observation ends and cache cleanups
+ * queue their lease releases on cleanup_queue; one flush sends them. A
+ * release can recall the domain, so then wait, at most
+ * HFS_UNMOUNT_SETTLE_MS, while a recall or remaining owner is visible. The
+ * host may start that recall only after this returns; that is harmless,
+ * since no physical owner remains to stop and the stop's verdict only
+ * decides whether kill_sb logs. A FENCED view never settles, so the wait
+ * ends at once there. A cleanup that requeues itself (a refused release
+ * retried every 10 ms) is not chased, and an unsettled view still makes
+ * the stop refuse and log. The flush is bounded by the releases' own
+ * exchange timeouts; cleanup work takes no superblock or inode lock.
+ */
+void hfs_mmap_settle(struct hfs_session *session)
+{
+	struct hfs_view *view = hfs_view_get(session);
+	struct hfs_mmap_control *control;
+	unsigned long flags, deadline;
+	bool settled;
+
+	if (!view)
+		return;
+	/* kill_sb has set closing and blocked, but nothing woke a parked
+	 * hfs_view_enter (1a4): wake it so it refuses now instead of at its
+	 * HFS_VIEW_ENTER_WAIT_MS bound. Normally none is parked, since a caller
+	 * in a syscall holds the mount busy until it returns.
+	 */
+	wake_up_all(&view->wait);
+	spin_lock_irqsave(&view->lock, flags);
+	control = view->control;
+	if (control)
+		kref_get(&control->refs);
+	spin_unlock_irqrestore(&view->lock, flags);
+	if (control) {
+		flush_workqueue(control->cleanup_queue);
+		hfs_mmap_control_put(control);
+	}
+	deadline = jiffies + msecs_to_jiffies(HFS_UNMOUNT_SETTLE_MS);
+	for (;;) {
+		spin_lock_irqsave(&view->lock, flags);
+		/* FENCED is terminal; the recall phases (STOPPED, drains,
+		 * FINAL) still progress to LIVE and are worth the wait.
+		 */
+		settled = hfs_view_settled(view) || view->phase == HFS_VIEW_FENCED;
+		spin_unlock_irqrestore(&view->lock, flags);
+		if (settled || !time_before(jiffies, deadline))
+			break;
+		msleep(10);
+	}
+	hfs_view_put(view);
+}
+
+void hfs_mmap_progress(struct hfs_session *session)
+{
+	struct hfs_view *view = hfs_view_get(session);
+	struct hfs_mmap_control *control;
+	unsigned long flags;
+	bool queued = false;
+
+	if (!view)
+		return;
+	control = hfs_mmap_control_get(view);
+	hfs_view_put(view);
+	if (!control)
+		return;
+	spin_lock_irqsave(&control->lock, flags);
+	if (!control->error && !control->stopping &&
+	    time_after_eq(jiffies, control->pressure_after)) {
+		control->pressure_after = jiffies + msecs_to_jiffies(100);
+		queued = queue_delayed_work(control->pressure_queue, &control->pressure, 0);
+	}
+	spin_unlock_irqrestore(&control->lock, flags);
+	if (!queued)
+		hfs_mmap_control_put(control);
+}
+
+static int hfs_mmap_read(struct hfs_session *session, struct hfs_description *description,
+			 const struct hfs_cred *cred, u64 offset, struct hfs_cache_page *entry)
+{
+	struct hfs_buf args;
+	struct hfs_json *result = NULL;
+	u64 count;
+	u32 actual, wanted;
+	int err;
+
+	err = hfs_buf_init(&args, 16384);
+	if (err)
+		return err;
+	entry->fill_length = 0;
+	memset(entry->fill, 0, sizeof(entry->fill));
+	/* A regular-file short read need not fill the requested range. Continue
+	 * at its exact offset; zero means EOF. No page/PTE lock covers these
+	 * source reads. A later exact target/revision grant rejects mixed cuts.
+	 */
+	while (entry->fill_length < sizeof(entry->fill)) {
+		wanted = sizeof(entry->fill) - entry->fill_length;
+		args.len = 0;
+		args.error = 0;
+		hfs_buf_printf(&args, "{\"count\":%u,\"description\":", wanted);
+		hfs_cap_write(&args, description->cap);
+		hfs_buf_printf(&args, ",\"offset\":%llu}", offset + entry->fill_length);
+		err = hfs_call(session, "READ", &args, cred, false, &result);
+		if (err)
+			break;
+		actual = wanted;
+		if (hfs_json_u64(result, hfs_json_field(result, 0, "count"), &count) || count > wanted ||
+		    hfs_json_hex(result, hfs_json_field(result, 0, "data"),
+				 entry->fill + entry->fill_length, &actual) || actual != count) {
+			err = -EPROTO;
+			break;
+		}
+		hfs_json_free(result);
+		result = NULL;
+		if (!count)
+			break;
+		entry->fill_length += count;
+	}
+	hfs_json_free(result);
+	hfs_buf_free(&args);
+	return err;
+}
+
+/* No retry can succeed: the view is fenced for good (hfs_mmap_fail, a
+ * failed recall), the session is closing or blocked, or the task is dying.
+ */
+static bool hfs_mmap_fault_final(struct hfs_view *view)
+{
+	return READ_ONCE(view->phase) == HFS_VIEW_FENCED ||
+	       READ_ONCE(view->session->closing) || READ_ONCE(view->session->blocked) ||
+	       fatal_signal_pending(current);
+}
+
+/* Transient refusals retry the fault with VM_FAULT_NOPAGE. Two cases get
+ * SIGBUS instead (a kernel access, e.g. read() into such a mapping, gets
+ * EFAULT), as for any other mapping whose backing cannot be reached:
+ *
+ * - -ETIMEDOUT, a recall that did not finish within HFS_VIEW_ENTER_WAIT_MS
+ *   (1a4): retrying would restore the unbounded wait.
+ * - A final refusal (hfs_mmap_fault_final; 1a4 review, pre-existing). Before,
+ *   -ESTALE/-ERESTARTSYS were retried even then, so every fault on an
+ *   uncached page of a fenced view retried forever, and a kernel uaccess
+ *   fault (read(2) into an hfs mapping) looped unkillably: x86 checks
+ *   signals only on VM_FAULT_RETRY, not on NOPAGE.
+ */
+static vm_fault_t hfs_mmap_fault_error(struct hfs_view *view, int err)
+{
+	if (err == -ENOMEM)
+		return VM_FAULT_OOM;
+	if (hfs_mmap_fault_final(view))
+		return VM_FAULT_SIGBUS;
+	if (err == -ENOSPC || err == -EAGAIN || err == -ESTALE ||
+	    err == -ERESTARTSYS || err == -EINTR) {
+		if (err == -ENOSPC)
+			hfs_mmap_pressure(view, false);
+		usleep_range(1000, 2000);
+		return VM_FAULT_NOPAGE;
+	}
+	return VM_FAULT_SIGBUS;
+}
+
+static vm_fault_t hfs_mmap_fault(struct vm_fault *vmf)
+{
+	struct file *file = vmf->vma->vm_file;
+	struct inode *inode = file_inode(file);
+	struct hfs_session *session = HFS_S(inode);
+	struct hfs_description *description = file->private_data;
+	struct hfs_view *view = hfs_view_get(session);
+	struct hfs_cache_page *entry = NULL, *existing;
+	struct hfs_cache_cleanup *cleanup;
+	struct hfs_cred *cred = NULL;
+	struct hfs_dirty *dirty = NULL;
+	struct hfs_lease *lease = NULL;
+	struct hfs_view_stamp stamp;
+	struct hfs_cache_grant *grant = NULL;
+	struct page *page = NULL;
+	void *cookie = NULL, *address;
+	u64 offset;
+	bool write = (vmf->flags & FAULT_FLAG_WRITE) && (vmf->vma->vm_flags & VM_SHARED);
+	bool attached = false, inserted = false;
+	vm_fault_t result;
+	int err;
+
+	if (!view || !description || !description->cap ||
+	    vmf->pgoff > ((S64_MAX - 4096) >> PAGE_SHIFT)) {
+		hfs_view_put(view);
+		return VM_FAULT_SIGBUS;
+	}
+	offset = (u64)vmf->pgoff << PAGE_SHIFT;
+	/* Legal dup/fork/transfer aliases may reuse their exact original grant.
+	 * Another Description must obtain its own actual protected READ lease.
+	 */
+	page = find_get_page(inode->i_mapping, vmf->pgoff);
+	if (page) {
+		lock_page(page);
+		if (PageUptodate(page) && page_mapping(page) == inode->i_mapping) {
+			err = hfs_view_page_enter(vmf->vma, page, write, &cookie);
+			if (!err) {
+				hfs_view_leave(cookie);
+				vmf->page = page;
+				hfs_view_put(view);
+				return VM_FAULT_LOCKED;
+			}
+		}
+		unlock_page(page);
+		put_page(page);
+		page = NULL;
+	}
+	err = hfs_view_enter(view, NULL, true, &cookie);
+	if (err)
+		goto failed;
+	hfs_view_leave(cookie);
+	cookie = NULL;
+	err = hfs_view_snapshot(view, &stamp);
+	if (err)
+		goto failed;
+	err = hfs_mmap_prepare(view, &stamp, &entry);
+	if (err)
+		goto failed;
+	cleanup = entry->cleanup;
+	err = hfs_view_capture(view, &stamp, &entry->target);
+	if (err || stamp.revision != entry->stamp.revision ||
+	    !uuid_equal(&stamp.generation, &entry->stamp.generation)) {
+		err = err ?: -ESTALE;
+		goto failed;
+	}
+	err = hfs_capture(session, &init_user_ns, &cred);
+	if (err)
+		goto failed;
+	err = hfs_mmap_read(session, description, cred, offset, entry);
+	if (err)
+		goto failed;
+	if (!entry->fill_length) {
+		err = -ENXIO; /* first byte beyond regular-file EOF */
+		goto failed;
+	}
+	err = hfs_lease_acquire(session, cred, NULL, description->cap,
+				offset, write, &entry->target, &lease);
+	/* 2f4: -EXDEV (a later recall passed it), a settle stop or -ENOMEM
+	 * (hfs_lease_acquire_ex; pre-existing, documented since 5f4) may
+	 * still hand out an unadopted lease; the cleanup packet releases it,
+	 * and the fault fails as for any moved view.
+	 */
+	cleanup->lease = lease;
+	if (err == -EXDEV)
+		err = -ESTALE;
+	if (err)
+		goto failed;
+	err = hfs_view_page_lease(entry, lease);
+	if (err)
+		goto failed;
+	if (write) {
+		err = hfs_dirty_reserve(session, entry, description->cap,
+					offset, entry->fill_length, &dirty);
+		cleanup->pending = dirty;
+		if (err)
+			goto failed;
+	}
+	page = find_get_page(inode->i_mapping, vmf->pgoff);
+	if (page && !write) {
+		/* Compatible readers can share bytes, but retain their distinct
+		 * exact Description leases for final PTE admission and recall.
+		 */
+		grant = kzalloc(sizeof(*grant), GFP_KERNEL);
+		if (!grant) {
+			err = -ENOMEM;
+			goto failed;
+		}
+		INIT_LIST_HEAD(&grant->list);
+		err = session->provider->reserve(session, sizeof(*grant), true, &grant->reservation);
+		if (err)
+			goto failed;
+		lock_page(page);
+		existing = hfs_view_page_find(view, page);
+		if (!existing || !PageUptodate(page) || page_mapping(page) != inode->i_mapping) {
+			if (existing)
+				hfs_view_page_put(existing);
+			unlock_page(page);
+			err = -ESTALE;
+			goto failed;
+		}
+		grant->lease = entry->lease;
+		err = hfs_view_page_grant(existing, grant, entry);
+		hfs_view_page_put(existing);
+		if (err) {
+			grant->lease = NULL;
+			unlock_page(page);
+			goto failed;
+		}
+		cleanup->lease = NULL;
+		grant = NULL;
+		vmf->page = page;
+		hfs_cred_free(cred);
+		hfs_view_page_put(entry);
+		hfs_view_put(view);
+		return VM_FAULT_LOCKED;
+	}
+	if (page) {
+		err = -ESTALE; /* conflicting write recall invalidated the old epoch */
+		goto failed;
+	}
+	page = alloc_page(GFP_HIGHUSER | __GFP_ZERO);
+	if (!page) {
+		err = -ENOMEM;
+		goto failed;
+	}
+	lock_page(page);
+	err = hfs_view_enter(view, &entry->stamp, false, &cookie);
+	if (err)
+		goto unlock;
+	/* NOFS excludes recursive filesystem reclaim/recall while this bounded
+	 * physical token joins cache attachment and immutable dirty adoption.
+	 */
+	err = add_to_page_cache_lru(page, inode->i_mapping, vmf->pgoff, GFP_NOFS);
+	if (err)
+		goto unlock;
+	inserted = true;
+	address = kmap_local_page(page);
+	memcpy(address, entry->fill, sizeof(entry->fill));
+	kunmap_local(address);
+	SetPageUptodate(page);
+	err = hfs_view_page_attach(entry, page);
+	if (err)
+		goto unlock;
+	attached = true;
+	if (dirty) {
+		err = hfs_view_adopt_dirty(view, entry, dirty);
+		if (err)
+			goto unlock;
+		cleanup->pending = NULL; /* adopted registry now owns this obligation */
+	}
+	hfs_view_leave(cookie);
+	cookie = NULL;
+	vmf->page = page;
+	hfs_cred_free(cred);
+	hfs_view_page_put(entry); /* private + adopted registry retain resources */
+	hfs_view_put(view);
+	return VM_FAULT_LOCKED;
+unlock:
+	hfs_view_leave(cookie);
+	cookie = NULL;
+	if (inserted)
+		delete_from_page_cache(page);
+	unlock_page(page);
+failed:
+	if (page)
+		put_page(page);
+	if (grant) {
+		if (grant->reservation)
+			session->provider->unreserve(session, grant->reservation);
+		kfree(grant);
+	}
+	if (entry) {
+		/* Cache-removal callbacks detach private ownership; an adopted
+		 * dirty obligation can never take this failure path after exposure.
+		 */
+		WARN_ON_ONCE(attached && entry->page);
+		hfs_view_page_put(entry);
+	}
+	hfs_cred_free(cred);
+	result = hfs_mmap_fault_error(view, err);
+	hfs_view_put(view);
+	return result;
+}
+
+/* wj4: count the VMAs of an mmapped inode (hfs_inode.view_vmas), so its
+ * view_mmapped mark can be dropped once none is left and its page cache is
+ * empty (hfs_view_unmark_idle_locked). hfs_mmap_file's successful
+ * hfs_view_mmap_inode counted the first VMA; ->open counts each copy
+ * (dup_mmap, __split_vma, copy_vma), ->close each removal (remove_vma, a
+ * failed split, copy_vma's failed vma_link: out_vma_link). Both are
+ * atomics only and take no lock, so the
+ * mmap_lock they run under orders before nothing new. Having ->close also
+ * makes is_mergeable_vma refuse merging these VMAs, so vma_merge never
+ * frees one without ->close. The only free without ->close left in 6.1 is
+ * __mmap_region's post-->mmap vma_merge, which needs a mergeable
+ * neighbour of the same struct file, i.e. another hfs VMA, which has
+ * ->close and is refused; were it ever taken, the count would only stay
+ * high and keep the mark (the safe side).
+ */
+static void hfs_mmap_open(struct vm_area_struct *vma)
+{
+	hfs_view_vma_open(file_inode(vma->vm_file));
+}
+
+static void hfs_mmap_close(struct vm_area_struct *vma)
+{
+	hfs_view_vma_close(file_inode(vma->vm_file));
+}
+
+static vm_fault_t hfs_mmap_mkwrite(struct vm_fault *vmf)
+{
+	struct hfs_view *view = hfs_view_get(HFS_S(file_inode(vmf->vma->vm_file)));
+	void *cookie = NULL;
+	int err;
+	vm_fault_t result;
+
+	if (!view)
+		return VM_FAULT_SIGBUS;
+	lock_page(vmf->page);
+	err = hfs_view_page_enter(vmf->vma, vmf->page, true, &cookie);
+	if (!err) {
+		hfs_view_leave(cookie);
+		hfs_view_put(view);
+		return VM_FAULT_LOCKED;
+	}
+	unlock_page(vmf->page);
+	/* Upgrade the original read-only mapping by recalling its old epoch.
+	 * Never replace vmf->page: do_page_mkwrite holds a reference to that
+	 * exact page. Its next ordinary write fault obtains an EXCLUSIVE_DIRTY
+	 * lease and full reservation before a new writable PTE can be installed.
+	 */
+	err = hfs_mmap_pressure(view, false);
+	result = !err ? VM_FAULT_NOPAGE : hfs_mmap_fault_error(view, err);
+	hfs_view_put(view);
+	return result;
+}
+
+static const struct vm_operations_struct hfs_mmap_ops = {
+	.open = hfs_mmap_open,
+	.close = hfs_mmap_close,
+	.fault = hfs_mmap_fault,
+	.page_mkwrite = hfs_mmap_mkwrite,
+	.cache_begin = hfs_view_page_enter,
+	.cache_end = hfs_view_leave,
+	.no_gup = true,
+};
+
+int hfs_mmap_file(struct file *file, struct vm_area_struct *vma)
+{
+	struct inode *inode = file_inode(file);
+	struct hfs_session *session = HFS_S(inode);
+	struct hfs_description *description = file->private_data;
+	struct hfs_view *view = hfs_view_get(session);
+	struct hfs_mmap_control *control;
+	int err;
+
+	if (!view || !description || !description->cap || !S_ISREG(inode->i_mode) ||
+	    PAGE_SIZE != 4096 || !(description->cap->rights & 1) ||
+	    ((vma->vm_flags & VM_SHARED) && (vma->vm_flags & VM_WRITE) &&
+	     !(description->cap->rights & 2))) {
+		hfs_view_put(view);
+		return -EACCES;
+	}
+	control = hfs_mmap_control_get(view);
+	if (!control) {
+		hfs_view_put(view);
+		return -ESTALE;
+	}
+	/* tj4: mark the inode mmapped (view->nr_mmapped) under view->lock
+	 * before hfs_mmap_ops can fault anything, so the view stops counting as
+	 * cacheless for xf4 advance before it can hold target-bound state.
+	 * wj4: a success also counts this VMA (view_vmas), so hfs_mmap_ops,
+	 * whose ->close gives it back, is installed exactly then; a failure
+	 * counts nothing and installs nothing.
+	 */
+	err = READ_ONCE(session->blocked) || READ_ONCE(control->error) ? -EHOSTDOWN :
+		hfs_view_mmap_inode(inode);
+	if (!err) {
+		/* The common MM check also refuses THP even if MADV_HUGEPAGE
+		 * later clears this hint; executable and private COW stay legal.
+		 */
+		vma->vm_flags |= VM_NOHUGEPAGE;
+		vma->vm_ops = &hfs_mmap_ops;
+		file_accessed(file);
+	}
+	hfs_mmap_control_put(control);
+	hfs_view_put(view);
+	return err;
+}
+
+int hfs_mmap_sync(struct file *file)
+{
+	struct hfs_view *view = hfs_view_get(HFS_S(file_inode(file)));
+	unsigned long flags;
+	bool dirty;
+	int err = 0, writeback;
+
+	if (!view)
+		return -ESTALE;
+	spin_lock_irqsave(&view->lock, flags);
+	dirty = view->nr_dirty != 0;
+	spin_unlock_irqrestore(&view->lock, flags);
+	if (dirty)
+		err = hfs_mmap_pressure(view, false);
+	/* Includes terminal short/error drains; never erase them with a later
+	 * successful metadata SYNC. Standard errseq is per open file reference.
+	 */
+	writeback = file_check_and_advance_wb_err(file);
+	hfs_view_put(view);
+	return writeback ?: err;
+}
+
+/* hfs_mmap_bootstrap's cleanup packet: allocated with its provider credit,
+ * owning the caller's control reference, and queued on control->cleanup
+ * (not yet scheduled). On an error nothing is allocated or queued and the
+ * caller still owns its control reference.
+ */
+static int hfs_mmap_bootstrap_packet(struct hfs_session *session,
+				     struct hfs_mmap_control *control,
+				     struct hfs_cache_cleanup **out)
+{
+	struct hfs_cache_cleanup *cleanup;
+	unsigned long flags;
+	int err;
+
+	cleanup = kzalloc(sizeof(*cleanup), GFP_KERNEL);
+	if (!cleanup)
+		return -ENOMEM;
+	err = session->provider->reserve(session, sizeof(*cleanup), true, &cleanup->credit);
+	if (err) {
+		kfree(cleanup);
+		return err;
+	}
+	cleanup->control = control;
+	INIT_LIST_HEAD(&cleanup->list);
+	INIT_LIST_HEAD(&cleanup->readers);
+	INIT_DELAYED_WORK(&cleanup->work, hfs_mmap_cleanup);
+	spin_lock_irqsave(&control->lock, flags);
+	list_add_tail(&cleanup->list, &control->cleanup);
+	spin_unlock_irqrestore(&control->lock, flags);
+	*out = cleanup;
+	return 0;
+}
+
+/* Bind the new view's initial cut: acquire a DOMAIN discovery lease, bind
+ * it (hfs_view_bind_initial) and release it, again on -ESTALE/-EAGAIN until
+ * deadline. A lease still held when this returns (a failed release, or a
+ * stop that handed one out) stays in cleanup->lease for the packet.
+ */
+static int hfs_mmap_bootstrap_bind(struct hfs_session *session, const struct hfs_cred *cred,
+				   struct hfs_view *view, struct hfs_cache_cleanup *cleanup,
+				   unsigned long deadline)
+{
+	struct hfs_lease *lease = NULL;
+	int err;
+
+	for (;;) {
+		/* The issuer selects/verifies an actual cut. An empty unbound
+		 * domain is already polling and can close a necessary first recall.
+		 */
+		err = hfs_lease_acquire(session, cred, NULL, NULL, 0, false, NULL, &lease);
+		/* 2f4: a lease a later recall passed (-EXDEV) is released below
+		 * and acquired again, like a discovery lease of a moved view; on
+		 * a settle stop (or -ENOMEM, hfs_lease_acquire_ex; pre-existing,
+		 * documented since 5f4) the packet queued after the loop
+		 * releases it.
+		 */
+		cleanup->lease = lease;
+		if (err == -EXDEV)
+			err = -ESTALE;
+		else if (err)
+			break;
+		else
+			err = hfs_view_bind_initial(view, lease);
+		if (err && err != -ESTALE && err != -EAGAIN)
+			break;
+		/* This discovery lease was never cache/PTE authority. Its actual
+		 * original release can still start an empty verified recall.
+		 */
+		if (hfs_lease_release(session, lease)) {
+			err = -EAGAIN;
+			break;
+		}
+		hfs_lease_free(lease);
+		cleanup->lease = NULL;
+		lease = NULL;
+		if (!err || time_after_eq(jiffies, deadline))
+			break;
+	}
+	return err;
+}
+
+/* A new mount's unbound view: create it, start its control worker, then
+ * bind its initial cut (hfs_mmap_bootstrap_bind) within 30 s of entry. Split
+ * for 5f4 (the 50-line rule) without changes in order or error paths.
+ */
+int hfs_mmap_bootstrap(struct hfs_session *session, const struct hfs_cred *cred)
+{
+	struct hfs_view *view;
+	struct hfs_mmap_control *control;
+	struct hfs_cache_cleanup *cleanup;
+	unsigned long deadline = jiffies + 30 * HZ;
+	int err;
+
+	err = hfs_view_new_unbound(session);
+	if (err)
+		return err;
+	view = hfs_view_get(session);
+	if (!view)
+		return -ESTALE;
+	err = hfs_mmap_start(view);
+	if (err)
+		goto view;
+	control = hfs_mmap_control_get(view);
+	if (!control) {
+		err = -ESTALE;
+		goto view;
+	}
+	err = hfs_mmap_bootstrap_packet(session, control, &cleanup);
+	if (err)
+		goto reference;
+	err = hfs_mmap_bootstrap_bind(session, cred, view, cleanup, deadline);
+	/* The preowned packet retains any uncertain lease/release evidence and
+	 * its original issuer; no stack pointer or mount caller lifetime escapes.
+	 */
+	queue_delayed_work(control->cleanup_queue, &cleanup->work, 0);
+	hfs_view_put(view);
+	return err;
+reference:
+	hfs_mmap_control_put(control);
+view:
+	hfs_view_put(view);
+	return err;
+}
+
+/* ie4 (zq3-r15 R15-1): an observation's re-check found the view moved on
+ * since its stamp. reason says how, action what hfs_mmap_begin does about it.
+ * Recalls are routine, so this is information, not an error.
+ */
+static void hfs_mmap_recheck_note(struct hfs_view *view, const char *reason,
+				  const char *action)
+{
+	pr_info_ratelimited("9p-hfs: session %pUb observation re-check failed (%s); %s\n",
+			    &view->session->enrollment.session, reason, action);
+}
+
+/* re4 (zq3-r16 R16-1): every unretired view ticket stays charged on the host
+ * until its family's floor passes it: an acquisition ticket against the
+ * ordinary Tickets bound (and an identity), a VIEW_RELEASE ticket against the
+ * shared ControlTickets bound. Before re4 the guest offered retirement only
+ * at the end of a cleanup packet and dropped a BLOCKED VIEW_RETIRE (the host
+ * refuses while any recall runs or the range holds the GRANTED acquisition
+ * of a still active lease, retirementBlocked; until hp4 any active lease of
+ * the family's credentials), so tickets could stay charged until some later
+ * cleanup. hfs_view_retire now records the refusal (view->retire_blocked);
+ * this work re-sends it.
+ */
+static void hfs_mmap_retire_work(struct work_struct *work)
+{
+	struct hfs_mmap_control *control = container_of(to_delayed_work(work),
+						       struct hfs_mmap_control, retire);
+
+	if (!READ_ONCE(control->error) && !READ_ONCE(control->stopping))
+		hfs_view_retire(control->view->session);
+	hfs_mmap_control_put(control); /* transferred by the successful queue */
+}
+
+/* Queues hfs_mmap_retire_work if the last retirement pass was BLOCKED.
+ * force: after a recall's REOPENED ACK (the host ends the recall at that ACK,
+ * and with it the refusal); otherwise (the start of an observation,
+ * hfs_mmap_begin) at most once per HFS_RETIRE_KICK_MS. It takes no lock the
+ * callers hold and never waits: the RPC runs on cleanup_queue. A kick while
+ * the work is already queued only drops its reference again.
+ */
+static void hfs_mmap_retire_kick(struct hfs_view *view, bool force)
+{
+	struct hfs_mmap_control *control;
+	unsigned long flags;
+	bool queued = false;
+
+	if (!READ_ONCE(view->retire_blocked))
+		return;
+	control = hfs_mmap_control_get(view);
+	if (!control)
+		return;
+	spin_lock_irqsave(&control->lock, flags);
+	if (force || time_after_eq(jiffies, control->retire_after)) {
+		control->retire_after = jiffies + msecs_to_jiffies(HFS_RETIRE_KICK_MS);
+		queued = queue_delayed_work(control->cleanup_queue, &control->retire, 0);
+	}
+	spin_unlock_irqrestore(&control->lock, flags);
+	if (!queued)
+		hfs_mmap_control_put(control);
+}
+
+/* One observation and its cleanup packet. The packet owns the control
+ * reference, the credit and, once granted, the lease; queueing it
+ * (hfs_mmap_cleanup_queue) releases all three exactly once. The observation
+ * itself is freed by hfs_mmap_end once published, or by
+ * hfs_mmap_observation_drop before that.
+ */
+static int hfs_mmap_observation_new(struct hfs_view *view, void *native_cookie,
+				    struct hfs_observation **out)
+{
+	struct hfs_session *session = view->session;
+	struct hfs_mmap_control *control = hfs_mmap_control_get(view);
+	struct hfs_observation *observation;
+	struct hfs_cache_cleanup *cleanup;
+	unsigned long flags;
+	int err;
+
+	if (!control)
+		return -ESTALE;
+	observation = kzalloc(sizeof(*observation), GFP_KERNEL);
+	cleanup = kzalloc(sizeof(*cleanup), GFP_KERNEL);
+	err = !observation || !cleanup ? -ENOMEM :
+		session->provider->reserve(session, sizeof(*observation) + sizeof(*cleanup) +
+					   HFS_TARGET_MAX, true, &cleanup->credit);
+	if (!err) {
+		err = hfs_buf_init(&observation->target, HFS_TARGET_MAX);
+		if (err)
+			session->provider->unreserve(session, cleanup->credit);
+	}
+	if (err) {
+		kfree(observation);
+		kfree(cleanup);
+		hfs_mmap_control_put(control);
+		return err;
+	}
+	observation->view = view;
+	observation->native_cookie = native_cookie;
+	observation->cleanup = cleanup;
+	INIT_LIST_HEAD(&observation->list);
+	INIT_LIST_HEAD(&cleanup->list);
+	INIT_LIST_HEAD(&cleanup->readers);
+	cleanup->control = control;
+	INIT_DELAYED_WORK(&cleanup->work, hfs_mmap_cleanup);
+	spin_lock_irqsave(&control->lock, flags);
+	list_add_tail(&cleanup->list, &control->cleanup);
+	spin_unlock_irqrestore(&control->lock, flags);
+	*out = observation;
+	return 0;
+}
+
+/* Frees an unpublished observation and returns its cleanup packet, which the
+ * caller queues now or, for a stale lease, after the retry's acquisition.
+ */
+static struct hfs_cache_cleanup *hfs_mmap_observation_drop(struct hfs_observation *observation)
+{
+	struct hfs_cache_cleanup *cleanup = observation->cleanup;
+
+	hfs_buf_free(&observation->target);
+	kfree(observation);
+	return cleanup;
+}
+
+static void hfs_mmap_cleanup_queue(struct hfs_cache_cleanup *cleanup)
+{
+	if (cleanup)
+		queue_delayed_work(cleanup->control->cleanup_queue, &cleanup->work, 0);
+}
+
+/* The post-acquire re-check, under view->lock. Before ie4 any difference
+ * from the captured stamp returned -ESTALE to userspace (zq3-r15 R15-1: a
+ * root fstat failed because a recall, most likely started by the open's own
+ * lease release, completed while its VIEW_ACQUIRE was PENDING). Now:
+ * - a refused view (hfs_view_refused: FENCED, closing or blocked) is
+ *   -ESTALE, as before;
+ * - a held lease on a view that moved (revision or generation), is not LIVE
+ *   or has another target is -EXDEV: the caller acquires again and only
+ *   then releases this lease. The lease is never re-stamped: the host
+ *   deactivates every lease of a recall participant at STOPPED, published
+ *   or not (quiesceParticipants, internal/viewcontrol/recall.go), while the
+ *   guest's STOPPED revokes only published ones, and an equal target cannot
+ *   tell a grant after the recall from one before it (ie4 review round 1).
+ *   Publishing under a quiesced lease would let a peer's write pass the
+ *   host's conflict check without a recall;
+ * - without a lease (a mutation) a moved stamp or a view that is not LIVE is
+ *   -EAGAIN, and the caller captures the view again.
+ * xf4: an advance candidate (lease->advance) is published only after
+ * hfs_view_advance adopted it, which re-stamps the observation to the
+ * advanced view and clears the flag; until then, and after a failed
+ * adoption (unadopted), it is -EXDEV like any lease the view moved past.
+ */
+static int hfs_mmap_publish(struct hfs_view *view, struct hfs_observation *observation)
+{
+	struct hfs_lease *lease = observation->lease;
+	unsigned long flags;
+	bool moved;
+	int err = 0;
+
+	spin_lock_irqsave(&view->lock, flags);
+	moved = view->revision != observation->stamp.revision ||
+		!uuid_equal(&view->generation, &observation->stamp.generation);
+	if (hfs_view_refused(view))
+		err = -ESTALE;
+	else if (lease && (moved || view->phase != HFS_VIEW_LIVE || lease->unadopted ||
+			   lease->advance || memcmp(view->target_hash, lease->target_hash, 32)))
+		err = -EXDEV; /* 2f4/xf4: an unadopted lease is never published */
+	else if (moved || view->phase != HFS_VIEW_LIVE)
+		err = -EAGAIN;
+	else if (view->nr_observations == HFS_IDENTITIES_MAX)
+		err = -ENOSPC;
+	if (!err) {
+		list_add_tail(&observation->list, &view->observations);
+		view->nr_observations++;
+		if (lease)
+			WRITE_ONCE(lease->published, true);
+	}
+	spin_unlock_irqrestore(&view->lock, flags);
+	return err;
+}
+
+/* A failed re-check is retried only before the deadline, while the transport
+ * still works (oc4: after transport_failed every exchange stops at its first
+ * retry, so another acquisition cannot succeed) and without a pending fatal
+ * signal.
+ */
+static int hfs_mmap_retry_allowed(struct hfs_view *view, unsigned long deadline)
+{
+	if (READ_ONCE(view->session->transport_failed))
+		return -ESTALE;
+	if (fatal_signal_pending(current))
+		return -EINTR;
+	return time_before(jiffies, deadline) ? 0 : -ETIMEDOUT;
+}
+
+/* re4: the first pause after a BLOCKED VIEW_ACQUIRE (doubled per pause), and
+ * the most retries one observation takes after BLOCKED answers. Each BLOCKED
+ * acquisition still takes a host ticket number and an identity until a
+ * VIEW_RETIRE passes it (review round 1): of the zq3 Tickets bound (16) one
+ * syscall spends at most HFS_BLOCKED_RETRIES_MAX + 1 on BLOCKED answers,
+ * whether they needed retirement progress (attempts->blocked) or were
+ * re-checks after a reinstall (attempts->reinstalled, 1h4). Several threads
+ * may retry on one floor advance; each stays within its own cap, and the
+ * host's ticket admission still bounds them all.
+ */
+#define HFS_BLOCKED_BACKOFF_MIN_MS 50U
+#define HFS_BLOCKED_RETRIES_MAX 3U
+
+/* One hfs_mmap_begin call's retry state. All retries, after a failed
+ * re-check and after a host BLOCKED, share one HFS_VIEW_ENTER_WAIT_MS
+ * deadline from the call's start. rechecks counts failed re-checks (the
+ * reinstalled BLOCKED answers included); blocked counts the host's BLOCKED
+ * answers on an unchanged view, which retry only after retirement progress,
+ * plus this call's own retirement rounds that ran and returned -EBUSY (each
+ * followed by another pause, as in re4); reinstalled counts BLOCKED answers
+ * after the view was reinstalled since the capture (1h4), which retry at
+ * once. blocked + reinstalled bounds the BLOCKED tickets (at most that many),
+ * capped by HFS_BLOCKED_RETRIES_MAX; a local wait behind a retirement mutex
+ * held by another holder counts against neither (1h4: before, it counted as
+ * an attempt). host_blocked is the last acquisition's answer;
+ * backoff_ms is the next pause; progress is view->retire_progress as read
+ * before the last acquisition, acks view->reopen_acks as read before its
+ * capture. no_advance (xf4): an acquisition of this call that requested an
+ * advance ended in -EXDEV (not a candidate, or its adoption failed), so the
+ * call's later acquisitions send today's request (no "advance") and a
+ * persistent refusal costs at most one extra round trip, never a loop of
+ * advance grants up to the deadline.
+ */
+struct hfs_mmap_attempts {
+	unsigned long deadline;
+	unsigned long progress;
+	unsigned long acks;
+	unsigned int rechecks;
+	unsigned int blocked;
+	unsigned int reinstalled;
+	unsigned int backoff_ms;
+	bool host_blocked;
+	bool no_advance;
+};
+
+/* The attempts counted against the cap; at least the host tickets this
+ * call spent on BLOCKED answers.
+ */
+static unsigned int hfs_mmap_blocked_tickets(const struct hfs_mmap_attempts *attempts)
+{
+	return attempts->blocked + attempts->reinstalled;
+}
+
+/* The host's BLOCKED stands: return its -EAGAIN with one rate-limited line. */
+static int hfs_mmap_blocked_give_up(struct hfs_view *view,
+				    const struct hfs_mmap_attempts *attempts,
+				    const char *reason)
+{
+	pr_warn_ratelimited("9p-hfs: session %pUb observation VIEW_ACQUIRE BLOCKED, %s after %d attempts (-EAGAIN)\n",
+			    &view->session->enrollment.session, reason,
+			    (int)hfs_mmap_blocked_tickets(attempts));
+	return -EAGAIN;
+}
+
+/* The stop checks before another BLOCKED retry or wait (oc4:
+ * transport_failed; a refused view, i.e. FENCED or a closing or blocked
+ * hfs1.4 session; a fatal signal) and the deadline, which gives the host's
+ * BLOCKED back.
+ */
+static int hfs_mmap_blocked_stop(struct hfs_view *view,
+				 const struct hfs_mmap_attempts *attempts)
+{
+	int err;
+
+	/* hfs_view_refused reads only READ_ONCE state; no view->lock needed. */
+	err = hfs_view_refused(view) ? -ESTALE :
+		hfs_mmap_retry_allowed(view, attempts->deadline);
+	if (err == -ETIMEDOUT)
+		return hfs_mmap_blocked_give_up(view, attempts, "deadline exhausted");
+	return err;
+}
+
+/* One pause of the BLOCKED back-off, after the stop checks (a fatal signal
+ * also ends the pause), the deadline and the ticket cap. Only a host BLOCKED
+ * on an unchanged view pauses.
+ */
+static int hfs_mmap_blocked_pause(struct hfs_view *view, struct hfs_mmap_attempts *attempts)
+{
+	unsigned long pause;
+	int err;
+
+	err = hfs_mmap_blocked_stop(view, attempts);
+	if (err)
+		return err;
+	if (hfs_mmap_blocked_tickets(attempts) > HFS_BLOCKED_RETRIES_MAX)
+		return hfs_mmap_blocked_give_up(view, attempts, "retry limit reached");
+	pause = min(msecs_to_jiffies(attempts->backoff_ms), attempts->deadline - jiffies);
+	pr_info_ratelimited("9p-hfs: session %pUb observation VIEW_ACQUIRE BLOCKED by the host (attempt %d); retiring, then retrying after %d ms if that frees anything\n",
+			    &view->session->enrollment.session,
+			    (int)hfs_mmap_blocked_tickets(attempts),
+			    (int)jiffies_to_msecs(pause));
+	schedule_timeout_killable(pause);
+	attempts->backoff_ms *= 2;
+	return fatal_signal_pending(current) ? -EINTR : 0;
+}
+
+/* 1h4 review round 2: the longest single wait behind another holder of
+ * session->retirement. Every holder releases through hfs_retirement_unlock,
+ * which wakes the waiter at once, so this bound normally never expires. It
+ * is there so a holder that releases the mutex some other way (none today;
+ * a future path that forgets the helper) costs one slice, not the rest of
+ * the 30 s deadline, which before 1h4 was a 50-200 ms pause. An expired
+ * slice is no answer from the host either: the offer tries again, uncounted.
+ */
+#define HFS_RETIRE_BUSY_SLICE_MS 200U
+
+/* 1h4 (zq3-r19 R19-1): the back-off's retirement try found another holder of
+ * session->retirement (-EBUSY, no round ran; e.g. the round a recall's
+ * REOPENED ACK forces, hfs_mmap_retire_kick, or ordinary request retirement,
+ * hfs_retire). That is no answer from the host, so it neither counts against
+ * the cap nor pauses again: wait (killable) for that holder to release the
+ * mutex or a floor to advance, for at most one HFS_RETIRE_BUSY_SLICE_MS slice
+ * within the deadline. releases is view->retirement_releases as read before
+ * the try. After a wake or an expired slice the stop checks run again
+ * (review round 1), so a refused view or a failed transport ends here with
+ * -ESTALE instead of running another round, and an exhausted deadline gives
+ * the host's -EAGAIN. Its own rate-limited line (first wait of an offer only,
+ * log), apart from the host BLOCKED pause's.
+ */
+static int hfs_mmap_retire_busy(struct hfs_view *view,
+				const struct hfs_mmap_attempts *attempts,
+				long releases, bool log)
+{
+	unsigned long now, end;
+	int err;
+
+	err = hfs_mmap_blocked_stop(view, attempts);
+	if (err)
+		return err;
+	/* The stop check passed the deadline, but jiffies moves on; never
+	 * print a wrapped remainder.
+	 */
+	now = jiffies;
+	if (log)
+		pr_info_ratelimited("9p-hfs: session %pUb observation VIEW_ACQUIRE BLOCKED (attempt %d): local retirement mutex busy; waiting for its holder (up to %d ms)\n",
+				    &view->session->enrollment.session,
+				    (int)hfs_mmap_blocked_tickets(attempts),
+				    time_before(now, attempts->deadline) ?
+				    (int)jiffies_to_msecs(attempts->deadline - now) : 0);
+	end = now + msecs_to_jiffies(HFS_RETIRE_BUSY_SLICE_MS);
+	if (!time_before(end, attempts->deadline))
+		end = attempts->deadline;
+	err = hfs_view_retire_wait(view, releases, attempts->progress, end);
+	if (err && err != -ETIMEDOUT)
+		return err;
+	return hfs_mmap_blocked_stop(view, attempts);
+}
+
+/* One retirement offer of the back-off: try a round without blocking on the
+ * mutex (hfs_view_retire_try) and wait behind another holder of it
+ * (hfs_mmap_retire_busy), as often as holders keep it busy within the
+ * deadline. Returns 1 when the acquisition may be retried (the held release
+ * completed, this round advanced a floor, or any floor advanced since before
+ * the acquisition: view->retire_progress, also seen right after a wake),
+ * 0 when this call's own round ran and returned -EBUSY (a retired ticket
+ * still in use: counted and paused again, as before 1h4), or an error (no
+ * progress after a round that ran: the host's -EAGAIN).
+ */
+static int hfs_mmap_retire_offer(struct hfs_view *view, struct hfs_mmap_attempts *attempts,
+				 bool released)
+{
+	unsigned int waits = 0;
+	bool ran;
+	long releases;
+	int err;
+
+	for (;;) {
+		/* Read before the try: a holder that makes it fail counts its
+		 * release only after unlocking (hfs_retirement_unlock), so that
+		 * release changes this value.
+		 */
+		releases = atomic_long_read(&view->retirement_releases);
+		err = hfs_view_retire_try(view->session, &ran);
+		if (released || !err || READ_ONCE(view->retire_progress) != attempts->progress)
+			return 1;
+		if (err == -EBUSY && ran)
+			return 0;
+		if (err != -EBUSY)
+			return hfs_mmap_blocked_give_up(view, attempts, "no retirement progress");
+		err = hfs_mmap_retire_busy(view, attempts, releases, !waits++);
+		if (err)
+			return err;
+		if (READ_ONCE(view->retire_progress) != attempts->progress)
+			return 1;
+	}
+}
+
+/* re4 (zq3-r16 R16-1): the host answered BLOCKED to an observation's
+ * VIEW_ACQUIRE on a view that did not move since the capture, usually for
+ * capacity that only retirement frees. The caller has already released the
+ * held lease, if any (released: it completed), and queued the packets, whose
+ * worker retires too. Retry only after progress, since every BLOCKED
+ * acquisition costs a ticket number until it is retired: pause, then offer
+ * tickets for retirement (hfs_mmap_retire_offer), and retry if the held
+ * release completed or any floor advanced since before the acquisition (by
+ * this call or by the cleanup worker during the pause; final review). A
+ * round of this call that ran and returned -EBUSY counts as an attempt and
+ * pauses again; 1h4: a mutex held by another holder is waited for instead,
+ * not counted. No progress after a round that ran, the cap or an exhausted
+ * deadline (also when the retirement round ran past it) return the host's
+ * -EAGAIN with one line.
+ */
+static int hfs_mmap_blocked_backoff(struct hfs_view *view, struct hfs_mmap_attempts *attempts,
+				    bool released)
+{
+	int err;
+
+	for (;;) {
+		err = hfs_mmap_blocked_pause(view, attempts);
+		if (err)
+			return err;
+		err = hfs_mmap_retire_offer(view, attempts, released);
+		if (err < 0)
+			return err;
+		if (err)
+			break;
+		attempts->blocked++;
+	}
+	if (!time_before(jiffies, attempts->deadline))
+		return hfs_mmap_blocked_give_up(view, attempts, "deadline exhausted");
+	return 0;
+}
+
+/* 1h4 (zq3-r19 R19-1): did the view move since this observation's capture,
+ * i.e. did a REOPENED ACK arrive (view->reopen_acks, read before the capture
+ * into attempts->acks) or the stamp change (a reinstall raises the revision,
+ * so a new target always does)? The host answers BLOCKED to a VIEW_ACQUIRE
+ * whose expected target a recall replaced while it was PENDING
+ * (internal/viewcontrol tickets.go: expectedMismatch, then BLOCKED for the
+ * old expectation on re-admission). An ACK between the read and the capture
+ * only costs one spare re-check, within the ticket cap.
+ */
+static bool hfs_mmap_reinstalled(struct hfs_view *view,
+				 const struct hfs_observation *observation,
+				 const struct hfs_mmap_attempts *attempts)
+{
+	unsigned long flags;
+	bool moved;
+
+	spin_lock_irqsave(&view->lock, flags);
+	moved = view->reopen_acks != attempts->acks ||
+		view->revision != observation->stamp.revision ||
+		!uuid_equal(&view->generation, &observation->stamp.generation);
+	spin_unlock_irqrestore(&view->lock, flags);
+	return moved;
+}
+
+/* 1h4: a BLOCKED for the expectation before a reinstall is a failed
+ * re-check, not a shortage: the view was just reinstalled, so nothing needs
+ * retiring. Acquire again at once at the new target (no pause, no progress
+ * requirement, not counted in attempts->blocked), within the deadline and
+ * the ticket cap.
+ */
+static int hfs_mmap_blocked_recheck(struct hfs_view *view, struct hfs_mmap_attempts *attempts)
+{
+	int err;
+
+	attempts->rechecks++;
+	attempts->reinstalled++;
+	hfs_mmap_recheck_note(view, "VIEW_ACQUIRE BLOCKED for the target before a reinstall",
+			      "acquiring again at once");
+	err = hfs_mmap_blocked_stop(view, attempts);
+	if (err)
+		return err;
+	if (hfs_mmap_blocked_tickets(attempts) > HFS_BLOCKED_RETRIES_MAX)
+		return hfs_mmap_blocked_give_up(view, attempts, "retry limit reached");
+	return 0;
+}
+
+/* The DOMAIN lease of one captured observation (not a mutation). xf4: when
+ * the capture found the view cacheless (hfs_view_capture_ex), the provider
+ * can verify an advance and no earlier acquisition of this call refused one
+ * (attempts->no_advance), the request carries "advance": true, and a GRANTED
+ * advance candidate is adopted at once (hfs_view_advance re-stamps the
+ * observation; a view with mmap pages, an mmapped inode or any other
+ * target-bound state never sends it, tj4: merely registered inodes such as
+ * the mount root do not count). A refused advance, from the acquisition or the
+ * adoption, is -EXDEV with an unadopted lease and sets attempts->no_advance;
+ * an adoption that waited past the deadline or for a fatal signal returns
+ * -ETIMEDOUT or -EINTR (hfs_view_advance), and the packet releases the
+ * unadopted lease.
+ * -EAGAIN with no lease: the host's BLOCKED (attempts->host_blocked;
+ * hfs_mmap_attempt re-checks at once after a reinstall, 1h4, else backs off
+ * and retries, re4) or RETIRED_ID (returned at once). Either way it is never
+ * retried back to back here. 2f4: -EXDEV with a lease a later recall passed
+ * before the view settled (hfs_view_grant_settle): held and acquired again,
+ * as for a failed re-check (ie4). A settle stop may also carry an unadopted
+ * lease; this packet releases it.
+ */
+static int hfs_mmap_observe_lease(struct hfs_view *view, struct hfs_observation *observation,
+				  const struct hfs_cred *cred, bool cacheless,
+				  struct hfs_mmap_attempts *attempts)
+{
+	struct hfs_cache_cleanup *cleanup = observation->cleanup;
+	bool advance = cacheless && !attempts->no_advance &&
+		hfs_view_advance_supported(view->session);
+	int err;
+
+	err = hfs_lease_acquire_ex(view->session, cred, NULL, NULL, 0, false,
+				   &observation->target, advance, &observation->lease,
+				   &attempts->host_blocked);
+	cleanup->lease = observation->lease;
+	if (!err && observation->lease->advance)
+		err = hfs_view_advance(view, observation->lease, &observation->stamp,
+				       &observation->target, attempts->deadline);
+	if (err == -EXDEV && advance) {
+		attempts->no_advance = true;
+		pr_info_ratelimited("9p-hfs: session %pUb observation VIEW_ACQUIRE advance not adopted (view moved or not a candidate); releasing that lease and acquiring without advance\n",
+				    &view->session->enrollment.session);
+	}
+	return err;
+}
+
+/* Enter (waiting for a LIVE view), capture, acquire and publish one
+ * observation. A granted lease stays with this observation's cleanup packet
+ * whatever happens. attempts->rechecks counts failed re-checks for
+ * hfs_mmap_begin's exhaustion line. Returns 0 (published), -EXDEV (an
+ * unpublished lease the view moved past, or a refused advance) or another
+ * error; for a host BLOCKED (-EAGAIN) attempts->host_blocked is set.
+ */
+static int hfs_mmap_observe(struct hfs_view *view, struct hfs_observation *observation,
+			    bool mutation, const struct hfs_cred *cred,
+			    struct hfs_mmap_attempts *attempts)
+{
+	void *physical = NULL;
+	bool cacheless;
+	int err;
+
+	attempts->host_blocked = false;
+	for (;;) {
+		err = hfs_view_enter_until(view, NULL, true, attempts->deadline, &physical);
+		if (err)
+			return err;
+		hfs_view_leave(physical);
+		/* 1h4: a REOPENED ACK after this read marks a BLOCKED answer as
+		 * one for an expectation the recall replaced (hfs_mmap_reinstalled).
+		 */
+		attempts->acks = READ_ONCE(view->reopen_acks);
+		err = hfs_view_capture_ex(view, &observation->stamp, &observation->target,
+					  &cacheless);
+		if (!err && !mutation) {
+			err = hfs_mmap_observe_lease(view, observation, cred, cacheless, attempts);
+			if (err)
+				return err;
+		}
+		if (!err)
+			err = hfs_mmap_publish(view, observation);
+		/* -EAGAIN here: hfs_view_capture_ex met a view that left LIVE, or a
+		 * mutation's (lease-less) re-check met a moved view. A held lease's
+		 * failed re-check is -EXDEV instead.
+		 */
+		if (err != -EAGAIN)
+			return err;
+		attempts->rechecks++;
+		hfs_mmap_recheck_note(view, "view not LIVE or moved", "capturing it again");
+		err = hfs_mmap_retry_allowed(view, attempts->deadline);
+		if (err)
+			return err;
+	}
+}
+
+/* re4: on a BLOCKED acquisition the lease held from a moved re-check (ie4)
+ * is released at once, before the next try, so its release ticket can be
+ * retired (that release may start the recall ie4 avoids, or wait behind a
+ * running one within its own exchange bound). Returns true when it
+ * completed. The caller still queues the packet exactly once; the release is
+ * idempotent (lease->released), so the worker frees it without another RPC.
+ */
+static bool hfs_mmap_release_held(struct hfs_view *view, struct hfs_cache_cleanup *held)
+{
+	return held && held->lease && !hfs_lease_release(view->session, held->lease);
+}
+
+/* ie4: the view moved past this attempt's lease; note it, check the bound. */
+static int hfs_mmap_moved(struct hfs_view *view, struct hfs_mmap_attempts *attempts)
+{
+	attempts->rechecks++;
+	hfs_mmap_recheck_note(view, "view moved past the granted lease",
+			      "acquiring again before releasing it");
+	return hfs_mmap_retry_allowed(view, attempts->deadline);
+}
+
+/* One attempt of hfs_mmap_begin: 0 (published, *cookie set), 1 (try again)
+ * or an error. *held is the previous attempt's packet with a lease the view
+ * moved past or a refused advance left unadopted (-EXDEV, xf4); it is queued
+ * after this attempt's acquisition
+ * (granted or BLOCKED), and on BLOCKED released before that. A BLOCKED on a
+ * view reinstalled since the capture is retried at once (1h4), any other
+ * after the back-off.
+ */
+static int hfs_mmap_attempt(struct hfs_view *view, bool mutation, const struct hfs_cred *cred,
+			    void *native_cookie, struct hfs_mmap_attempts *attempts,
+			    struct hfs_cache_cleanup **held, void **cookie)
+{
+	struct hfs_observation *observation;
+	struct hfs_cache_cleanup *cleanup;
+	bool blocked, reinstalled = false, released = false;
+	int err;
+
+	err = hfs_mmap_observation_new(view, native_cookie, &observation);
+	if (err)
+		return err;
+	/* A floor advance after this read is progress for a BLOCKED answer. */
+	attempts->progress = READ_ONCE(view->retire_progress);
+	err = hfs_mmap_observe(view, observation, mutation, cred, attempts);
+	blocked = err == -EAGAIN && attempts->host_blocked;
+	if (blocked) {
+		reinstalled = hfs_mmap_reinstalled(view, observation, attempts);
+		released = hfs_mmap_release_held(view, *held);
+	}
+	hfs_mmap_cleanup_queue(*held);
+	*held = NULL;
+	if (!err) {
+		/* The packet's control reference owns view/module/session lifetime. */
+		*cookie = observation;
+		return 0;
+	}
+	cleanup = hfs_mmap_observation_drop(observation);
+	if (err == -EXDEV) {
+		*held = cleanup;
+		return hfs_mmap_moved(view, attempts) ?: 1;
+	}
+	hfs_mmap_cleanup_queue(cleanup);
+	if (!blocked)
+		return err;
+	if (reinstalled)
+		return hfs_mmap_blocked_recheck(view, attempts) ?: 1;
+	attempts->blocked++;
+	return hfs_mmap_blocked_backoff(view, attempts, released) ?: 1;
+}
+
+/* Opens one observation of the view for a VFS operation (hfs_begin). Since
+ * ie4 a failed re-check does not fail the syscall by itself (see
+ * hfs_mmap_publish), and since re4 neither does a host BLOCKED that
+ * retirement can clear (see hfs_mmap_blocked_backoff), nor since 1h4 one for
+ * an expectation a reinstall replaced (hfs_mmap_blocked_recheck): retries
+ * share one
+ * HFS_VIEW_ENTER_WAIT_MS deadline from this call's start. Exhaustion after
+ * failed re-checks is -ETIMEDOUT, a BLOCKED that stands the host's -EAGAIN,
+ * each with one rate-limited line. A RETIRED_ID or local -EAGAIN is returned
+ * at once.
+ *
+ * On -EXDEV the old lease is released only after the next attempt's own
+ * acquisition, so its release starts no recall that could fail the retry
+ * again (no self-recall loop). Host semantics (internal/viewcontrol):
+ * - old lease still active (granted after the recall, R15-1): the new
+ *   acquisition shares it (grantLease -> shareLease) and the old release
+ *   only returns a holder reference (releaseLease -> releaseHolder);
+ * - old lease quiesced by a recall after its grant: the new lease carries
+ *   the advanced fence, a different lineage (sameLineage compares Fence),
+ *   so the old release finds no active sibling (releaseNeedsRecall) and is
+ *   RELEASED without a recall.
+ * If that next acquisition is BLOCKED instead (zq3-r16 R16-1: the shared
+ * ControlTickets budget was full, the held lease's reserved release credit
+ * included), the held lease is released before the next try
+ * (hfs_mmap_release_held).
+ * Every attempt's cleanup packet is queued exactly once (held at most one
+ * attempt, then hfs_mmap_cleanup_queue), so no lease, ticket or credit
+ * leaks and none is released twice. A held lease is never published, so a
+ * recall's QUIESCENT ACK neither waits for nor revokes it.
+ */
+int hfs_mmap_begin(struct inode *inode, bool mutation, const struct hfs_cred *cred,
+		    void *native_cookie, void **cookie)
+{
+	struct hfs_view *view = hfs_view_get(HFS_S(inode));
+	struct hfs_mmap_attempts attempts = {
+		.deadline = jiffies + msecs_to_jiffies(HFS_VIEW_ENTER_WAIT_MS),
+		.backoff_ms = HFS_BLOCKED_BACKOFF_MIN_MS,
+	};
+	struct hfs_cache_cleanup *held = NULL;
+	int err;
+
+	*cookie = NULL;
+	if (!view)
+		return -ESTALE;
+	/* re4: a VIEW_RETIRE still owed from a BLOCKED pass goes out (rate-limited). */
+	hfs_mmap_retire_kick(view, false);
+	do
+		err = hfs_mmap_attempt(view, mutation, cred, native_cookie, &attempts,
+				       &held, cookie);
+	while (err == 1);
+	hfs_mmap_cleanup_queue(held);
+	if (err == -ETIMEDOUT && attempts.rechecks)
+		pr_warn_ratelimited("9p-hfs: session %pUb observation retries exhausted after %d failed re-checks (-ETIMEDOUT)\n",
+				    &view->session->enrollment.session, (int)attempts.rechecks);
+	hfs_view_put(view);
+	return err;
+}
+
+void hfs_mmap_end(void *cookie)
+{
+	struct hfs_observation *observation = cookie;
+	struct hfs_cache_cleanup *cleanup;
+	struct hfs_view *view;
+	unsigned long flags;
+
+	if (!observation)
+		return;
+	view = observation->view;
+	cleanup = observation->cleanup;
+	spin_lock_irqsave(&view->lock, flags);
+	list_del(&observation->list);
+	/* The last in-flight observation ends any background pressure hold. */
+	if (!--view->nr_observations)
+		view->pressure_holding = false;
+	/* DOMAIN observations install only under separately stamped short MM
+	 * tokens. No PTE is authorized by this lease. Closing its last observer
+	 * excludes every future use; cached dentries revalidate through RPC and
+	 * attributes never become timeless pathname permission.
+	 */
+	if (observation->lease)
+		WRITE_ONCE(observation->lease->revoked, true);
+	spin_unlock_irqrestore(&view->lock, flags);
+	view->session->provider->leave(view->session, observation->native_cookie);
+	hfs_buf_free(&observation->target);
+	kfree(observation);
+	queue_delayed_work(cleanup->control->cleanup_queue, &cleanup->work, 0);
+}
