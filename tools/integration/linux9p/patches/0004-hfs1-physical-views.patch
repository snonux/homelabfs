  * to the functions called when a no-page or a wp-page exception occurs.
  */
 struct vm_operations_struct {
+	/*
+	 * Retained cache domains: bracket final PTE installation/copy/move.
+	 * begin must not sleep when page != NULL (caller may hold locks).
+	 * A successful begin owns a cookie and callback lifetime until end.
+	 * No RPC or wait for a visibility barrier may occur inside a bracket.
+	 * Opted-in domains are order-0 only; hugepage collapse is excluded.
+	 */
+	int (*cache_begin)(struct vm_area_struct *vma, struct page *page,
+			   bool write, void **cookie);
+	void (*cache_end)(void *cookie);
+	bool no_gup;
 	void (*open)(struct vm_area_struct * area);
 	/**
 	 * @close: Called when the VMA is being removed from the MM.
@@ -622,6 +633,38 @@
 	struct page *(*find_special_page)(struct vm_area_struct *vma,
 					  unsigned long addr);
 };
+
+/* Snapshotted callbacks remain valid even if the VMA is subsequently retired. */
+struct vm_cache_cookie {
+	void *data;
+	void (*end)(void *data);
+};
+
+static inline int vm_cache_begin(struct vm_area_struct *vma, struct page *page,
+				 bool write, struct vm_cache_cookie *cookie)
+{
+	const struct vm_operations_struct *ops = vma->vm_ops;
+	void (*end)(void *data);
+	int err;
+
+	cookie->end = NULL;
+	cookie->data = NULL;
+	if (!ops || !ops->cache_begin)
+		return 0;
+	if (WARN_ON_ONCE(!ops->cache_end))
+		return -EINVAL;
+	end = ops->cache_end; /* no VMA/ops dereference after a parked callback */
+	err = ops->cache_begin(vma, page, write, &cookie->data);
+	if (!err)
+		cookie->end = end;
+	return err;
+}
+
+static inline void vm_cache_end(struct vm_cache_cookie *cookie)
+{
+	if (cookie->end)
+		cookie->end(cookie->data);
+}
 
