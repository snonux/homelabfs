+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef FS_9P_HFS_VIEW_H
+#define FS_9P_HFS_VIEW_H
+
+#include <linux/kref.h>
+#include <linux/list.h>
+#include <linux/mutex.h>
+#include <linux/spinlock.h>
+#include <linux/uuid.h>
