diff --git a/fs/9p/hfs_lease.c b/fs/9p/hfs_lease.c
new file mode 100644
--- /dev/null
+++ b/fs/9p/hfs_lease.c
@@ -0,0 +1,1531 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Exact bridge1.1 ticket/lease transport; no physical or source-proof defaults. */
+#include <linux/slab.h>
+#include <linux/delay.h>
+#include <linux/highmem.h>
+#include <linux/pagemap.h>
+#include <linux/writeback.h>
+#include "hfs.h"
+#include "hfs_received.h"
+#include "hfs_controlled.h"
+#include "hfs_lease.h"
+
+int hfs_json_hash_fields(const struct hfs_json *json, int object,
+			 const char *fields, u8 digest[32])
+{
+	struct hfs_buf original;
+	char name[64];
+	const char *p = fields;
+	u32 len, count = 0;
+	int err, token;
+
+	err = hfs_buf_init(&original, HFS_VIEW_BODY_MAX);
+	if (err)
+		return err;
+	hfs_buf_literal(&original, "{");
+	while (*p) {
+		len = strcspn(p, ",");
+		if (!len || len >= sizeof(name)) {
+			original.error = -EINVAL;
+			break;
+		}
+		memcpy(name, p, len);
+		name[len] = 0;
+		token = hfs_json_field(json, object, name);
+		if (token < 0) {
+			original.error = -EPROTO;
+			break;
+		}
+		hfs_buf_printf(&original, "%s\"%s\":", count++ ? "," : "", name);
+		hfs_buf_token(&original, json, token);
+		p += len + (p[len] == ',');
+	}
+	hfs_buf_literal(&original, "}");
+	err = original.error;
+	if (!err)
+		hfs_hash(original.data, original.len, digest);
+	hfs_buf_free(&original);
+	return err;
+}
+
+static int hfs_copy_json(const struct hfs_json *json, int token,
+			 struct hfs_json **out)
+{
+	return hfs_received_copy(json, token, out);
+}
+
+static bool hfs_token_equal(const struct hfs_json *json, int token,
+			    const void *bytes, u32 len)
+{
+	return token >= 0 && token < json->count &&
+	       json->tokens[token].end - json->tokens[token].start == len &&
+	       !memcmp(json->data + json->tokens[token].start, bytes, len);
+}
+
+static int hfs_hex32(const struct hfs_json *json, int object, const char *field,
+		     u8 digest[32])
+{
+	u32 len = 32;
+
+	if (hfs_json_hex(json, hfs_json_field(json, object, field), digest, &len) ||
+	    len != 32)
+		return -EPROTO;
+	return 0;
+}
+
+static int hfs_u64_field(const struct hfs_json *json, int object,
+			 const char *field, u64 *value)
+{
+	return hfs_json_u64(json, hfs_json_field(json, object, field), value);
+}
+
+static int hfs_normal_target(const struct hfs_json *json, int token,
+			     uuid_t *visibility)
+{
+	static const char * const hashes[] = {
+		"authority_hash", "selection_hash", "source_manifest_hash",
+	};
+	static const char * const ids[] = {
+		"sequencer_incarnation", "sequencer_node", "visibility_generation",
+	};
+	static const char * const reference_ids[] = {
+		"cluster", "configuration", "creator_incarnation", "creator_node",
+		"generation", "journal_incarnation", "origin_node", "volume",
+	};
+	u64 serial, value;
+	uuid_t id;
+	u8 hash[32];
+	u32 i;
+	int ref;
+
+	if (hfs_json_exact(json, token,
+		"authority_hash,result_ref,selection_hash,sequencer_incarnation,"
+		"sequencer_node,serial,source_manifest_hash,visibility_generation") ||
+	    hfs_u64_field(json, token, "serial", &serial))
+		return -EPROTO;
+	for (i = 0; i < ARRAY_SIZE(hashes); i++)
+		if (hfs_hex32(json, token, hashes[i], hash))
+			return -EPROTO;
+	for (i = 0; i < ARRAY_SIZE(ids); i++)
+		if (hfs_uuid(json, hfs_json_field(json, token, ids[i]), &id))
+			return -EPROTO;
+	*visibility = id;
+	ref = hfs_json_field(json, token, "result_ref");
+	if (hfs_json_is(json, ref, "null"))
+		return 0;
+	if (!serial || hfs_json_exact(json, ref,
+		"cluster,configuration,creator_incarnation,creator_node,epoch,frame_hash,"
+		"generation,journal_incarnation,kind,origin_node,sequence,volume") ||
+	    hfs_u64_field(json, ref, "epoch", &value) || !value ||
+	    hfs_u64_field(json, ref, "sequence", &value) || !value ||
+	    hfs_u64_field(json, ref, "kind", &value) || value < 1 || value > 13 ||
+	    hfs_hex32(json, ref, "frame_hash", hash))
+		return -EPROTO;
+	for (i = 0; i < ARRAY_SIZE(reference_ids); i++)
+		if (hfs_uuid(json, hfs_json_field(json, ref, reference_ids[i]), &id))
+			return -EPROTO;
+	return 0;
+}
+
+int hfs_view_target(struct hfs_session *session,
+			   const struct hfs_json *json, int token,
+			   uuid_t *visibility, u8 target_hash[32])
+{
+	int kind = hfs_json_field(json, token, "kind"), body;
+	u64 epoch, position;
+	uuid_t journal, expected;
+	u8 hash[32], context_hash[32];
+	int err;
+
+	if (hfs_json_is(json, kind, "\"CONTROLLED_LOCAL\"")) {
+		if (session->enrollment.view_scope != HFS_SCOPE_CONTROLLED_LOCAL)
+			return -ESTALE;
+		if (hfs_json_exact(json, token, "cut,kind"))
+			return -EPROTO;
+		body = hfs_json_field(json, token, "cut");
+		if (hfs_json_exact(json, body,
+			"context_hash,enrollment_hash,journal_epoch,journal_hash,"
+			"journal_incarnation,journal_position,profile_hash,state_hash,"
+			"visibility_generation") ||
+		    hfs_u64_field(json, body, "journal_epoch", &epoch) || !epoch ||
+		    hfs_u64_field(json, body, "journal_position", &position) ||
+		    hfs_uuid(json, hfs_json_field(json, body, "journal_incarnation"), &journal) ||
+		    hfs_uuid(json, hfs_json_field(json, body, "visibility_generation"), visibility) ||
+		    hfs_hex32(json, body, "context_hash", context_hash))
+			return -EPROTO;
+		hfs_hash(session->enrollment.context, session->enrollment.context_len, hash);
+		if (memcmp(hash, context_hash, 32))
+			return -ESTALE;
+		{
+			static const char * const fields[] = {
+				"enrollment_hash", "journal_hash", "profile_hash", "state_hash",
+			};
+			u32 i;
+
+			for (i = 0; i < ARRAY_SIZE(fields); i++)
+				if (hfs_hex32(json, body, fields[i], hash))
+					return -EPROTO;
+		}
+		/* Context's original journal is immutable; epoch is independently
+		 * verified by the actual source provider, never guessed from Context.
+		 */
+		{
+			struct hfs_json *context = NULL;
+
+			err = hfs_json_parse(session->enrollment.context,
+					     session->enrollment.context_len, &context);
+			if (!err)
+				err = hfs_uuid(context,
+					hfs_json_field(context, 0, "origin_journal"), &expected);
+			hfs_json_free(context);
+			if (err || !uuid_equal(&journal, &expected))
+				return -ESTALE;
+		}
+	} else if (hfs_json_is(json, kind, "\"NORMAL_PUBLIC\"")) {
+		if (session->enrollment.view_scope != HFS_SCOPE_NORMAL_PUBLIC)
+			return -ESTALE;
+		if (hfs_json_exact(json, token, "kind,publication"))
+			return -EPROTO;
+		body = hfs_json_field(json, token, "publication");
+		if (hfs_normal_target(json, body, visibility))
+			return -EPROTO;
+	} else {
+		return -EPROTO;
+	}
+	/* No codec-valid cut, empty baseline or callback pointer is source proof.
+	 * The separately admitted provider must verify the full actual source.
+	 */
+	err = session->provider->target(session, json, token);
+	if (err)
+		return err;
+	hfs_hash(json->data + json->tokens[token].start,
+		 json->tokens[token].end - json->tokens[token].start, target_hash);
+	return 0;
+}
+
+void hfs_view_ticket_put(struct hfs_view_ticket *ticket)
+{
+	struct hfs_session *session;
+	bool unused = false;
+
+	if (!ticket)
+		return;
+	session = ticket->session;
+	mutex_lock(&session->lock);
+	if (!WARN_ON_ONCE(!ticket->users))
+		ticket->users--;
+	/* A prepared package has no wire identity and was never dispatched.
+	 * Its capacity may be released locally without any counter rollback.
+	 */
+	if (!ticket->users && !ticket->number) {
+		if (!WARN_ON_ONCE(!ticket->family->prepared))
+			ticket->family->prepared--;
+		list_del(&ticket->list);
+		session->nr_view_tickets--;
+		if (ticket->control)
+			session->nr_view_control_tickets--;
+		unused = true;
+	}
+	mutex_unlock(&session->lock);
+	if (unused) {
+		hfs_buf_free(&ticket->request);
+		hfs_buf_free(&ticket->payload);
+		hfs_buf_free(&ticket->query);
+	hfs_buf_free(&ticket->original);
+	kvfree(ticket->scratch);
+		hfs_completion_close(ticket->completion);
+		session->provider->unreserve(session, ticket->reservation);
+		kfree(ticket);
+	}
+}
+
+bool hfs_view_tickets_busy(struct hfs_session *session)
+{
+	struct hfs_view_ticket *ticket;
+	struct hfs_view_family *family;
+	bool busy = false;
+
+	mutex_lock(&session->lock);
+	list_for_each_entry(ticket, &session->view_tickets, list)
+		if (ticket->users) {
+			busy = true;
+			break;
+		}
+	list_for_each_entry(family, &session->view_families, list)
+		if (family->retirement_cut)
+			busy = true;
+	mutex_unlock(&session->lock);
+	return busy;
+}
+
+void hfs_view_tickets_destroy(struct hfs_session *session)
+{
+	struct hfs_view_ticket *ticket, *next_ticket;
+	struct hfs_view_family *family, *next_family;
+
+	/* Only protected whole-session retirement or pre-transport failure calls
+	 * this path. Disconnect/close/timeout never discard these identities.
+	 */
+	list_for_each_entry(family, &session->view_families, list)
+		if (WARN_ON_ONCE(family->retirement_cut))
+			return;
+	list_for_each_entry_safe(ticket, next_ticket, &session->view_tickets, list) {
+		hfs_buf_free(&ticket->request);
+		hfs_buf_free(&ticket->payload);
+		hfs_buf_free(&ticket->query);
+	hfs_buf_free(&ticket->original);
+	kvfree(ticket->scratch);
+		hfs_json_free(ticket->response);
+		hfs_json_free(ticket->initial_response);
+		hfs_completion_close(ticket->completion);
+		session->provider->unreserve(session, ticket->reservation);
+		kfree(ticket);
+	}
+	list_for_each_entry_safe(family, next_family, &session->view_families, list) {
+		hfs_buf_free(&family->credentials);
+		session->provider->unreserve(session, family->reservation);
+		kfree(family);
+	}
+}
+
+int hfs_view_ticket_prepare(struct hfs_session *session, const struct hfs_cred *cred,
+			bool control, struct hfs_view_ticket **out)
+{
+	struct hfs_view_ticket *ticket;
+	struct hfs_view_family *family, *candidate;
+	void *credit, *family_credit;
+	int err;
+
+	*out = NULL;
+	if (session->bridge_minor != 1 && session->bridge_minor != 4)
+		return -EOPNOTSUPP;
+	err = session->provider->reserve(session, (hfs_controlled_consumed(session) ? 1ULL : 4ULL) * 1024 * 1024,
+					 control, &credit);
+	if (err)
+		return err;
+	err = session->provider->reserve(session, sizeof(*candidate) + 16384,
+					 control, &family_credit);
+	if (err)
+		goto unreserve;
+	ticket = kzalloc(sizeof(*ticket), GFP_KERNEL);
+	candidate = kzalloc(sizeof(*candidate), GFP_KERNEL);
+	if (!ticket || !candidate) {
+		err = -ENOMEM;
+		goto allocation;
+	}
+	err = hfs_completion_new(session, control, true, HFS_VIEW_BODY_MAX, &ticket->completion);
+	if (err)
+		goto allocation;
+	ticket->reservation = credit;
+	candidate->reservation = family_credit;
+	INIT_LIST_HEAD(&ticket->list);
+	INIT_LIST_HEAD(&candidate->list);
+	if (hfs_buf_init(&candidate->credentials, 16384) ||
+	    hfs_buf_init(&ticket->request, 32768) ||
+	    hfs_buf_init(&ticket->payload, HFS_VIEW_BODY_MAX) ||
+	    hfs_buf_init(&ticket->query, 32768) ||
+	    hfs_buf_init(&ticket->original, HFS_VIEW_BODY_MAX)) {
+		err = -ENOMEM;
+		goto buffers;
+	}
+	ticket->scratch = kvcalloc(4096, sizeof(*ticket->scratch), GFP_KERNEL);
+	if (!ticket->scratch) {
+		err = -ENOMEM;
+		goto buffers;
+	}
+	hfs_cred_write(&candidate->credentials, cred);
+	if (candidate->credentials.error) {
+		err = candidate->credentials.error;
+		goto buffers;
+	}
+	hfs_hash(candidate->credentials.data, candidate->credentials.len, candidate->hash);
+	mutex_init(&candidate->dispatch);
+	init_waitqueue_head(&candidate->wait);
+	candidate->next = 1;
+	candidate->control = control;
+	candidate->nonce = control ? session->enrollment.view_control_nonce :
+				    session->enrollment.nonce;
+	candidate->anchor = session->enrollment.anchor;
+	if (session->bridge_minor == 4) {
+		candidate->anchor = control ? session->enrollment.control_anchor :
+					       session->enrollment.acquisition_anchor;
+		if (!control)
+			candidate->nonce = session->enrollment.acquisition_nonce;
+	}
+	mutex_lock(&session->lock);
+	if ((control && session->nr_view_control_tickets == HFS_VIEW_CONTROL_TICKETS_MAX) ||
+	    (!control && session->nr_view_tickets - session->nr_view_control_tickets ==
+			HFS_VIEW_TICKETS_MAX)) {
+		err = -ENOSPC;
+		goto unlock;
+	}
+	list_for_each_entry(family, &session->view_families, list)
+		if (family->control == control &&
+		    !memcmp(family->hash, candidate->hash, 32) &&
+		    family->credentials.len == candidate->credentials.len &&
+		    !memcmp(family->credentials.data, candidate->credentials.data,
+			    family->credentials.len))
+			goto found;
+	if (session->nr_view_families == HFS_VIEW_FAMILIES_MAX) {
+		err = -ENOSPC;
+		goto unlock;
+	}
+	family = candidate;
+	candidate = NULL;
+	list_add_tail(&family->list, &session->view_families);
+	session->nr_view_families++;
+found:
+	/* Reserve finite number capacity without assigning a wire identity.
+	 * Mandatory deferred controls cannot discover wrap only after dirtying.
+	 */
+	if (family->next >= U64_MAX - family->prepared) {
+		err = -EOVERFLOW;
+		goto unlock;
+	}
+	family->prepared++;
+	ticket->family = family;
+	ticket->session = session;
+	spin_lock_init(&ticket->admission_lock);
+	ticket->users = 1;
+	ticket->control = control;
+	/* Resource ownership is distinct from a numbered wire admission. */
+	list_add_tail(&ticket->list, &session->view_tickets);
+	session->nr_view_tickets++;
+	if (control)
+		session->nr_view_control_tickets++;
+	err = 0;
+	*out = ticket;
+	mutex_unlock(&session->lock);
+	if (candidate) {
+		hfs_buf_free(&candidate->credentials);
+		session->provider->unreserve(session, candidate->reservation);
+		kfree(candidate);
+	}
+	return err;
+unlock:
+	mutex_unlock(&session->lock);
+buffers:
+	if (candidate)
+		hfs_buf_free(&candidate->credentials);
+	hfs_buf_free(&ticket->request);
+	hfs_buf_free(&ticket->payload);
+	hfs_buf_free(&ticket->query);
+	hfs_buf_free(&ticket->original);
+	kvfree(ticket->scratch);
+allocation:
+	if (ticket)
+		hfs_completion_close(ticket->completion);
+	kfree(candidate);
+	kfree(ticket);
+	session->provider->unreserve(session, family_credit);
+unreserve:
+	session->provider->unreserve(session, credit);
+	return err;
+}
+
+int hfs_view_ticket_activate(struct hfs_view_ticket *ticket)
+{
+	struct hfs_session *session = ticket->session;
+	struct hfs_view_family *family = ticket->family;
+	int err = 0;
+
+	if (READ_ONCE(ticket->number))
+		return 0;
+retry:
+	mutex_lock(&family->dispatch);
+	if (family->initial && family->initial != ticket) {
+		mutex_unlock(&family->dispatch);
+		err = wait_event_killable(family->wait, !READ_ONCE(family->initial));
+		if (err)
+			return err;
+		goto retry;
+	}
+
+	mutex_lock(&session->lock);
+	if (ticket->number)
+		goto out;
+	if (WARN_ON_ONCE(!family->prepared || family->next == U64_MAX)) {
+		err = -EOVERFLOW;
+		goto out;
+	}
+	family->prepared--;
+	ticket->number = family->next++;
+	WRITE_ONCE(family->initial, ticket);
+	hfs_buf_printf(&ticket->request, "{\"anchor\":\"%pUb\",\"credentials\":",
+		       &family->anchor);
+	hfs_buf_add(&ticket->request, family->credentials.data, family->credentials.len);
+	hfs_buf_printf(&ticket->request, ",\"nonce\":\"%pUb\",\"number\":%llu}",
+		       &family->nonce, ticket->number);
+	hfs_buf_literal(&ticket->query, "{\"request\":");
+	hfs_buf_add(&ticket->query, ticket->request.data, ticket->request.len);
+	hfs_buf_literal(&ticket->query, "}");
+	/* Number assignment order is the retirement order, regardless of when
+	 * a future freeze package reserved its resources.
+	 */
+	list_move_tail(&ticket->list, &session->view_tickets);
+	err = ticket->request.error ?: ticket->query.error;
+out:
+	mutex_unlock(&session->lock);
+	mutex_unlock(&family->dispatch);
+	return err;
+}
+
+static int hfs_ticket_union(struct hfs_view_ticket *ticket,
+			    const struct hfs_json *json, int body,
+			    const char *wire_operation)
+{
+	int status = hfs_json_field(json, body, "status");
+	bool lease = !hfs_json_is(json, hfs_json_field(json, body, "lease"), "null");
+	bool reservation = !hfs_json_is(json, hfs_json_field(json, body, "reservation"), "null");
+	bool entry = !hfs_json_is(json, hfs_json_field(json, body, "entry"), "null");
+	const char *original = ticket->operation;
+	bool query = !strcmp(wire_operation, "VIEW_QUERY");
+	bool cancel = !strcmp(wire_operation, "VIEW_CANCEL");
+
+	if (hfs_json_is(json, status, "\"PENDING\"") ||
+	    hfs_json_is(json, status, "\"INDETERMINATE\"") ||
+	    hfs_json_is(json, status, "\"BLOCKED\"") ||
+	    hfs_json_is(json, status, "\"RETIRED_ID\""))
+		return lease || reservation || entry ? -EPROTO : 0;
+	if (hfs_json_is(json, status, "\"CANCELLED\""))
+		return (!query && !cancel) || lease || reservation || entry ? -EPROTO : 0;
+	if (cancel)
+		return -EPROTO;
+	if (hfs_json_is(json, status, "\"RELEASED\""))
+		return strcmp(original, "VIEW_RELEASE") || lease || reservation || entry ? -EPROTO : 0;
+	if (hfs_json_is(json, status, "\"FROZEN\""))
+		return strcmp(original, "DIRTY_FREEZE") || lease || reservation || !entry ? -EPROTO : 0;
+	if (!hfs_json_is(json, status, "\"GRANTED\"") || entry)
+		return -EPROTO;
+	if (!strcmp(original, "VIEW_ACQUIRE") || !strcmp(original, "VIEW_RENEW"))
+		return !lease || reservation ? -EPROTO : 0;
+	return strcmp(original, "DIRTY_RESERVE") || lease || !reservation ? -EPROTO : 0;
+}
+
+static int hfs_ticket_reply(struct hfs_view_ticket *ticket,
+			    const struct hfs_json *json, int payload,
+			    const char *wire_operation)
+{
+	u8 expected[32], actual[32];
+	char operation[24];
+	int err;
+
+	if (hfs_json_exact(json, payload,
+		"entry,id,lease,operation,request,request_hash,reservation,status") ||
+	    !hfs_token_equal(json, hfs_json_field(json, payload, "request"),
+			     ticket->request.data, ticket->request.len) ||
+	    hfs_json_string(json, hfs_json_field(json, payload, "operation"),
+			    operation, sizeof(operation)) < 0 ||
+	    strcmp(operation, ticket->operation) ||
+	    hfs_hex32(json, payload, "request_hash", expected) ||
+	    memcmp(expected, ticket->request_hash, 32) ||
+	    hfs_hex32(json, payload, "id", expected))
+		return -EPROTO;
+	err = hfs_json_hash_fields(json, payload,
+		"entry,lease,operation,request,request_hash,reservation,status", actual);
+	if (err || memcmp(expected, actual, 32))
+		return err ?: -EPROTO;
+	return hfs_ticket_union(ticket, json, payload, wire_operation);
+}
+
+int hfs_view_query(struct hfs_session *session, struct hfs_view_ticket *ticket,
+		    bool cancel, struct hfs_json **response)
+{
+	struct hfs_json *reply = NULL;
+	const char *operation = cancel ? "VIEW_CANCEL" : "VIEW_QUERY";
+	unsigned long flags;
+	int err, body = -1;
+
+	*response = NULL;
+	if (!ticket->bound)
+		return -EAGAIN;
+	if (cancel) {
+		/* This API is only for never-published work. Real cache rights are
+		 * released after their separate physical revocation path.
+		 */
+		spin_lock_irqsave(&ticket->admission_lock, flags);
+		if (ticket->published) {
+			spin_unlock_irqrestore(&ticket->admission_lock, flags);
+			return -EBUSY;
+		}
+		ticket->closed = true;
+		spin_unlock_irqrestore(&ticket->admission_lock, flags);
+	}
+	mutex_lock(&ticket->family->dispatch);
+	err = hfs_control(session, operation, &ticket->query, true, &reply);
+	if (!err) {
+		body = hfs_json_field(reply, 0, "payload");
+		err = hfs_ticket_reply(ticket, reply, body, operation);
+		if (!err && !ticket->admitted) {
+			ticket->admitted = true;
+			WRITE_ONCE(ticket->family->initial, NULL);
+			wake_up_all(&ticket->family->wait);
+		}
+	}
+	mutex_unlock(&ticket->family->dispatch);
+	if (err) {
+		hfs_json_free(reply);
+		if (err == -EPROTO)
+			WRITE_ONCE(session->blocked, true);
+		return err;
+	}
+	if (!err)
+		err = hfs_copy_json(reply, body, response);
+	if (!err && hfs_json_is(reply, hfs_json_field(reply, body, "status"),
+				"\"CANCELLED\"")) {
+		struct hfs_json *closure = NULL;
+
+		err = hfs_copy_json(reply, body, &closure);
+		if (!err) {
+			/* Retirement follows Current; initial admission stays immutable. */
+			hfs_json_free(ticket->response);
+			ticket->response = closure;
+			ticket->terminal = true;
+		}
+	}
+	hfs_json_free(reply);
+	if (err == -EPROTO)
+		WRITE_ONCE(session->blocked, true);
+	return err;
+}
+
+int hfs_view_exchange(struct hfs_session *session, struct hfs_view_ticket *ticket,
+		      const char *operation, const struct hfs_buf *payload,
+		      struct hfs_json **response)
+{
+	struct hfs_json *reply = NULL, request;
+	struct hfs_buf *original = &ticket->original;
+	const struct hfs_buf *sent = payload;
+	const char *op = operation;
+	unsigned long deadline = jiffies + 30 * HZ;
+	bool control = hfs_view_command_control(operation);
+	int err, body, status;
+
+	*response = NULL;
+	if (!ticket->number || !hfs_view_command(operation) || payload->error ||
+	    hfs_view_command_control_family(operation) != ticket->control ||
+	    !strcmp(operation, "VIEW_QUERY") || !strcmp(operation, "VIEW_CANCEL"))
+		return -EINVAL;
+	if (ticket->bound) {
+		if (strcmp(ticket->operation, operation) ||
+		    ticket->payload.len != payload->len ||
+		    memcmp(ticket->payload.data, payload->data, payload->len))
+			return -ESTALE;
+	} else {
+		err = hfs_json_parse_into(payload->data, payload->len, &request,
+					  ticket->scratch, 4096);
+		if (!err && !hfs_token_equal(&request,
+			hfs_json_field(&request, 0, "request"),
+			ticket->request.data, ticket->request.len))
+			err = -EPROTO;
+		if (err)
+			return err;
+		original->len = 0;
+		original->error = 0;
+		hfs_buf_printf(original, "{\"op\":\"%s\",\"payload\":", operation);
+		hfs_buf_add(original, payload->data, payload->len);
+		hfs_buf_literal(original, "}");
+		err = original->error;
+		if (!err) {
+			hfs_hash(original->data, original->len, ticket->request_hash);
+			hfs_buf_add(&ticket->payload, payload->data, payload->len);
+			err = ticket->payload.error;
+		}
+		if (err)
+			return err;
+		strscpy(ticket->operation, operation, sizeof(ticket->operation));
+		ticket->bound = true;
+	}
+	/* Initial admissions are serialized per family, but terminal waits do
+	 * not own that mutex. Retries after protected initial observation QUERY
+	 * Current; they never reinterpret Initial GRANTED as fresh authority.
+	 */
+	sent = &ticket->payload;
+	if (ticket->admitted) {
+		op = "VIEW_QUERY";
+		sent = &ticket->query;
+		control = true;
+	}
+	for (;;) {
+		bool initial = !ticket->admitted;
+
+		if (initial)
+			mutex_lock(&ticket->family->dispatch);
+		err = hfs_control(session, op, sent, control, &reply);
+		if (err) {
+			if (initial)
+				mutex_unlock(&ticket->family->dispatch);
+			ticket->uncertain = true;
+			return err;
+		}
+		body = hfs_json_field(reply, 0, "payload");
+		err = hfs_ticket_reply(ticket, reply, body, op);
+		if (initial) {
+			if (!err) {
+				ticket->admitted = true;
+				WRITE_ONCE(ticket->family->initial, NULL);
+				wake_up_all(&ticket->family->wait);
+				if (!ticket->initial_response)
+					err = hfs_copy_json(reply, body, &ticket->initial_response);
+			}
+			mutex_unlock(&ticket->family->dispatch);
+		}
+		if (err)
+			goto invalid;
+		status = hfs_json_field(reply, body, "status");
+		if (hfs_json_is(reply, status, "\"GRANTED\"") ||
+		    hfs_json_is(reply, status, "\"FROZEN\"") ||
+		    hfs_json_is(reply, status, "\"RELEASED\"") ||
+		    hfs_json_is(reply, status, "\"CANCELLED\"") ||
+		    hfs_json_is(reply, status, "\"BLOCKED\"")) {
+			if (session->bridge_minor == 4 &&
+			    (hfs_json_is(reply, status, "\"GRANTED\"") ||
+			     hfs_json_is(reply, status, "\"FROZEN\""))) {
+				int source = hfs_json_field(reply, body, "lease");
+
+				if (hfs_json_is(reply, source, "null"))
+					source = hfs_json_field(reply, body, "reservation");
+				if (hfs_json_is(reply, source, "null"))
+					source = hfs_json_field(reply, body, "entry");
+				err = hfs_received_source(session, reply, source);
+				if (err)
+					goto invalid;
+			}
+			err = hfs_copy_json(reply, body, response);
+			if (err)
+				goto invalid;
+			hfs_json_free(ticket->response);
+			err = hfs_copy_json(reply, body, &ticket->response);
+			ticket->terminal = !err;
+			if (!err && hfs_json_is(reply, status, "\"CANCELLED\""))
+				err = -ECANCELED;
+			if (!err && hfs_json_is(reply, status, "\"BLOCKED\""))
+				err = -EAGAIN;
+			hfs_json_free(reply);
+			return err;
+		}
+		if (!hfs_json_is(reply, hfs_json_field(reply, body, "entry"), "null") ||
+		    !hfs_json_is(reply, hfs_json_field(reply, body, "lease"), "null") ||
+		    !hfs_json_is(reply, hfs_json_field(reply, body, "reservation"), "null")) {
+			err = -EPROTO;
+			goto invalid;
+		}
+		if (hfs_json_is(reply, status, "\"BLOCKED\"") ||
+		    hfs_json_is(reply, status, "\"RETIRED_ID\"")) {
+			hfs_json_free(reply);
+			return -EAGAIN;
+		}
+		if (!hfs_json_is(reply, status, "\"PENDING\"") &&
+		    !hfs_json_is(reply, status, "\"INDETERMINATE\"")) {
+			err = -EPROTO;
+			goto invalid;
+		}
+		hfs_json_free(reply);
+		reply = NULL;
+		if (time_after_eq(jiffies, deadline)) {
+			ticket->uncertain = true;
+			return -ETIMEDOUT;
+		}
+		usleep_range(10000, 12000);
+		op = "VIEW_QUERY";
+		sent = &ticket->query;
+		control = true;
+	}
+invalid:
+	ticket->uncertain = true;
+	WRITE_ONCE(session->blocked, true);
+	hfs_json_free(reply);
+	return err;
+}
+
+static int hfs_lease_decode(struct hfs_session *session,
+			    struct hfs_view_ticket *ticket,
+			    const struct hfs_json *response,
+			    const struct hfs_buf *access, bool dirty,
+			    const struct hfs_buf *expected_target,
+			    struct hfs_lease **out)
+{
+	struct hfs_lease *lease;
+	u8 actual[32], expected[32];
+	int body = hfs_json_field(response, 0, "lease"), token, err;
+
+	*out = NULL;
+	if (!hfs_json_is(response, hfs_json_field(response, 0, "status"), "\"GRANTED\"") ||
+	    !hfs_json_is(response, hfs_json_field(response, 0, "reservation"), "null") ||
+	    !hfs_json_is(response, hfs_json_field(response, 0, "entry"), "null") ||
+	    hfs_json_exact(response, body,
+		"access,credential_hash,domain,fence,id,mode,revision,scope,target") ||
+	    !hfs_token_equal(response, hfs_json_field(response, body, "access"),
+			     access->data, access->len) ||
+	    !hfs_token_equal(response, hfs_json_field(response, body, "domain"),
+			     session->domain->json->data, session->domain->json->len) ||
+	    !hfs_token_equal(response, hfs_json_field(response, body, "scope"),
+			     session->enrollment.context, session->enrollment.context_len) ||
+	    !hfs_json_is(response, hfs_json_field(response, body, "mode"),
+			 dirty ? "\"EXCLUSIVE_DIRTY\"" : "\"READ\"") ||
+	    hfs_hex32(response, body, "credential_hash", actual) ||
+	    memcmp(actual, ticket->family->hash, 32) ||
+	    hfs_hex32(response, body, "id", expected))
+		return -EPROTO;
+	err = hfs_json_hash_fields(response, body,
+		"access,credential_hash,domain,fence,mode,revision,scope,target", actual);
+	if (err || memcmp(actual, expected, 32))
+		return err ?: -EPROTO;
+	lease = kzalloc(sizeof(*lease), GFP_KERNEL);
+	if (!lease)
+		return -ENOMEM;
+	kref_init(&lease->refs);
+	mutex_init(&lease->release_lock);
+	memcpy(lease->id, expected, 32);
+	lease->dirty = dirty;
+	err = hfs_u64_field(response, body, "fence", &lease->fence);
+	if (!err)
+		err = hfs_u64_field(response, body, "revision", &lease->revision);
+	if (err || !lease->fence || !lease->revision) {
+		err = -EPROTO;
+		goto fail;
+	}
+	token = hfs_json_field(response, body, "target");
+	if (expected_target && !hfs_token_equal(response, token,
+					      expected_target->data, expected_target->len)) {
+		err = -ESTALE;
+		goto fail;
+	}
+	err = hfs_view_target(session, response, token, &lease->visibility,
+			      lease->target_hash);
+	if (!err)
+		err = hfs_copy_json(response, body, &lease->json);
+	if (err)
+		goto fail;
+	lease->ticket = ticket;
+	*out = lease;
+	return 0;
+fail:
+	hfs_lease_free(lease);
+	return err;
+}
+
+int hfs_lease_acquire(struct hfs_session *session, const struct hfs_cred *cred,
+		      const struct hfs_cap *object, const struct hfs_cap *description,
+		      u64 offset, bool dirty, const struct hfs_buf *expected_target,
+		      struct hfs_lease **out)
+{
+	struct hfs_view_ticket *ticket;
+	struct hfs_json *response = NULL;
+	struct hfs_buf payload = {}, access = {};
+	int err;
+
+	*out = NULL;
+	if (!session->domain || !cred || (object && description) ||
+	    (dirty && (!description || !(description->rights & 2))) ||
+	    (description && (!dirty && !(description->rights & 1))) ||
+	    (description && (offset & 4095 || offset > S64_MAX - 4096)))
+		return -EINVAL;
+	err = hfs_view_ticket_prepare(session, cred, false, &ticket);
+	if (err)
+		return err;
+	if (hfs_buf_init(&payload, HFS_VIEW_BODY_MAX) || hfs_buf_init(&access, 16384)) {
+		err = -ENOMEM;
+		goto free;
+	}
+	if (description) {
+		hfs_buf_literal(&access, "{\"description\":");
+		hfs_cap_write(&access, description);
+		hfs_buf_printf(&access, ",\"kind\":\"PAGE\",\"length\":4096,\"offset\":%llu}", offset);
+	} else if (object) {
+		hfs_buf_literal(&access, "{\"kind\":\"OBJECT\",\"object\":");
+		hfs_cap_write(&access, object);
+		hfs_buf_literal(&access, "}");
+	} else {
+		hfs_buf_literal(&access, "{\"kind\":\"DOMAIN\"}");
+	}
+	if (access.error || (expected_target && expected_target->error)) {
+		err = access.error ?: expected_target->error;
+		goto free;
+	}
+	err = hfs_view_ticket_activate(ticket);
+	if (err)
+		goto free;
+	hfs_buf_literal(&payload, "{\"access\":");
+	hfs_buf_add(&payload, access.data, access.len);
+	hfs_buf_literal(&payload, ",\"domain\":");
+	hfs_cap_write(&payload, session->domain);
+	hfs_buf_printf(&payload, ",\"mode\":\"%s\",\"request\":", dirty ? "EXCLUSIVE_DIRTY" : "READ");
+	hfs_buf_add(&payload, ticket->request.data, ticket->request.len);
+	hfs_buf_literal(&payload, ",\"target\":");
+	if (expected_target)
+		hfs_buf_add(&payload, expected_target->data, expected_target->len);
+	else
+		hfs_buf_literal(&payload, "null");
+	hfs_buf_literal(&payload, "}");
+	err = access.error ?: hfs_view_exchange(session, ticket, "VIEW_ACQUIRE", &payload, &response);
+	if (!err)
+		err = hfs_lease_decode(session, ticket, response, &access, dirty, expected_target, out);
+	if (!err && description)
+		memcpy((*out)->description, description->token, 32);
+	if (!err) {
+		(*out)->issuer = kmemdup(cred, sizeof(*cred), GFP_KERNEL);
+		if (!(*out)->issuer) {
+			hfs_lease_free(*out);
+			*out = NULL;
+			ticket = NULL;
+			err = -ENOMEM;
+		} else {
+			(*out)->issuer->native = get_cred(cred->native);
+		}
+	}
+	if (!err)
+		err = hfs_buf_init(&(*out)->release_payload, 32768);
+	if (!err)
+		err = hfs_view_ticket_prepare(session, cred, true, &(*out)->release_ticket);
+	if (err && *out) {
+		hfs_lease_free(*out);
+		*out = NULL;
+		ticket = NULL;
+	}
+	if (err == -EPROTO || err == -ESTALE)
+		WRITE_ONCE(session->blocked, true);
+free:
+	if (err)
+		hfs_view_ticket_put(ticket);
+	hfs_json_free(response);
+	hfs_buf_free(&payload);
+	hfs_buf_free(&access);
+	return err;
+}
+
+static int hfs_lease_release_locked(struct hfs_session *session, struct hfs_lease *lease)
+{
+	struct hfs_view_ticket *ticket = lease->release_ticket;
+	struct hfs_buf *payload = &lease->release_payload;
+	struct hfs_json *response = NULL;
+	int err;
+
+	/* This preowned control may initiate pressure recall while PTEs still
+	 * exist. No physical/page/transition lock may cover the parked RPC.
+	 * The issuer may return PENDING; only verified physical/source closure
+	 * can make it RELEASED. The final local check below is independent.
+	 */
+	if (!ticket || !lease->issuer ||
+	    memcmp(ticket->family->hash, lease->ticket->family->hash, 32))
+		return -ESTALE;
+	err = hfs_view_ticket_activate(ticket);
+	if (err)
+		return err;
+	payload->len = 0;
+	payload->error = 0;
+	hfs_buf_literal(payload, "{\"lease\":");
+	hfs_buf_add(payload, lease->json->data, lease->json->len);
+	hfs_buf_literal(payload, ",\"request\":");
+	hfs_buf_add(payload, ticket->request.data, ticket->request.len);
+	hfs_buf_literal(payload, "}");
+	err = hfs_view_exchange(session, ticket, "VIEW_RELEASE", payload, &response);
+	if (!err &&
+	    (!hfs_json_is(response, hfs_json_field(response, 0, "status"), "\"RELEASED\"") ||
+	     !hfs_json_is(response, hfs_json_field(response, 0, "entry"), "null") ||
+	     !hfs_json_is(response, hfs_json_field(response, 0, "lease"), "null") ||
+	     !hfs_json_is(response, hfs_json_field(response, 0, "reservation"), "null"))) {
+		err = -EPROTO;
+		WRITE_ONCE(session->blocked, true);
+	}
+	if (!err && READ_ONCE(lease->published) && !READ_ONCE(lease->revoked)) {
+		struct hfs_view *view = hfs_view_get(session);
+
+		if (view) {
+			hfs_view_fence(view);
+			hfs_view_put(view);
+		}
+		WRITE_ONCE(session->blocked, true);
+		err = -EPROTO;
+	}
+	hfs_json_free(response);
+	return err;
+}
+
+int hfs_lease_release(struct hfs_session *session, struct hfs_lease *lease)
+{
+	int err;
+
+	mutex_lock(&lease->release_lock);
+	if (lease->released) {
+		err = 0;
+	} else {
+		err = hfs_lease_release_locked(session, lease);
+		if (!err)
+			lease->released = true;
+	}
+	mutex_unlock(&lease->release_lock);
+	return err;
+}
+
+static void hfs_lease_destroy(struct kref *refs)
+{
+	struct hfs_lease *lease = container_of(refs, struct hfs_lease, refs);
+
+	hfs_buf_free(&lease->release_payload);
+	hfs_view_ticket_put(lease->release_ticket);
+	hfs_json_free(lease->json);
+	hfs_cred_free(lease->issuer);
+	hfs_view_ticket_put(lease->ticket);
+	kfree(lease);
+}
+
+void hfs_lease_get(struct hfs_lease *lease)
+{
+	kref_get(&lease->refs);
+}
+
+void hfs_lease_free(struct hfs_lease *lease)
+{
+	if (lease)
+		kref_put(&lease->refs, hfs_lease_destroy);
+}
+
+
+int hfs_view_retire(struct hfs_session *session)
+{
+	struct hfs_view_family *family;
+	struct hfs_view *view;
+	struct hfs_view_ticket *ticket, *next;
+	struct hfs_buf payload = {};
+	struct hfs_json *reply = NULL;
+	struct hfs_retirement_cut *cut = NULL;
+	LIST_HEAD(released);
+	u8 hash[32], proof[32];
+	u64 through, floor;
+	u32 count, nr_families = 0, index;
+	bool advanced = false;
+	int err = -EAGAIN, body;
+
+	if (session->bridge_minor != 1 && session->bridge_minor != 4)
+		return -EOPNOTSUPP;
+	view = hfs_view_get(session);
+	if (!view)
+		return -EAGAIN;
+	mutex_lock(&session->retirement);
+	payload = view->retire_payload;
+	mutex_lock(&session->lock);
+	list_for_each_entry(family, &session->view_families, list)
+		view->retiring[nr_families++] = family;
+	mutex_unlock(&session->lock);
+	/* Families are retained with permanent floors until protected session
+	 * retirement. Advancing a floor never resets next or forgets credentials.
+	 */
+	for (index = 0; index < nr_families; index++) {
+		family = view->retiring[index];
+		cut = session->bridge_minor == 4 ? family->retirement_cut : NULL;
+		if (cut) {
+			through = cut->through;
+			goto exchange;
+		}
+		payload.len = 0;
+		payload.error = 0;
+		count = 0;
+		through = family->floor;
+		hfs_buf_printf(&payload, "{\"anchor\":\"%pUb\",\"credentials\":",
+			       &family->anchor);
+		hfs_buf_add(&payload, family->credentials.data, family->credentials.len);
+		hfs_buf_printf(&payload, ",\"nonce\":\"%pUb\",\"result_hashes\":[",
+			       &family->nonce);
+		mutex_lock(&session->lock);
+		list_for_each_entry(ticket, &session->view_tickets, list) {
+			if (ticket->family != family || !ticket->number)
+				continue;
+			if (ticket->users || !ticket->terminal || !ticket->response ||
+			    ticket->number != through + 1)
+				break;
+			if (hfs_hex32(ticket->response, 0, "id", hash))
+				break;
+			if (count++)
+				hfs_buf_literal(&payload, ",");
+			hfs_buf_hex(&payload, hash, 32);
+			through = ticket->number;
+			if (count == 1024)
+				break;
+		}
+		mutex_unlock(&session->lock);
+		if (!count)
+			continue;
+		hfs_buf_printf(&payload, "],\"through\":%llu}", through);
+		if (session->bridge_minor == 4) {
+			err = hfs_retirement_cut_new(session, "VIEW_RETIRE", &payload,
+				family->floor + 1, through, &cut);
+			if (err)
+				goto out;
+			family->retirement_cut = cut;
+		}
+exchange:
+		if (cut && cut->response)
+			reply = cut->response;
+		else {
+			err = hfs_control(session, "VIEW_RETIRE", cut ? &cut->payload : &payload, true, &reply);
+			if (err)
+				goto out;
+			if (cut)
+				cut->response = reply;
+		}
+		body = hfs_json_field(reply, 0, "payload");
+		if (hfs_json_exact(reply, body, "floor,proof_hash,status") ||
+		    hfs_u64_field(reply, body, "floor", &floor)) {
+			err = -EPROTO;
+			goto out;
+		}
+		if (hfs_json_is(reply, hfs_json_field(reply, body, "status"), "\"BLOCKED\"")) {
+			if (!hfs_json_is(reply, hfs_json_field(reply, body, "proof_hash"), "null")) {
+				err = -EPROTO;
+				goto out;
+			}
+			if (cut) {
+				family->retirement_cut = NULL;
+				hfs_retirement_cut_free(session, cut);
+				cut = NULL;
+			} else
+				hfs_json_free(reply);
+			reply = NULL;
+			continue;
+		}
+		if (!hfs_json_is(reply, hfs_json_field(reply, body, "status"), "\"RETIRED\"") ||
+		    floor != through || hfs_hex32(reply, body, "proof_hash", proof)) {
+			err = -EPROTO;
+			goto out;
+		}
+		err = session->provider->view_retirement(session, &family->credentials,
+						 through, proof, reply);
+		if (err)
+			goto out;
+		mutex_lock(&session->lock);
+		if (session->bridge_minor == 4) {
+			list_for_each_entry(ticket, &session->view_tickets, list) {
+				if (ticket->family == family && ticket->number && ticket->number <= through &&
+				    (ticket->users || !ticket->terminal || !ticket->response)) {
+					err = -EBUSY;
+					break;
+				}
+			}
+			if (err) {
+				mutex_unlock(&session->lock);
+				goto out;
+			}
+		}
+		family->floor = through;
+		advanced = true;
+		list_for_each_entry_safe(ticket, next, &session->view_tickets, list) {
+			if (ticket->family != family || !ticket->number || ticket->number > through)
+				continue;
+			if (WARN_ON_ONCE(ticket->users)) {
+				WRITE_ONCE(session->blocked, true);
+				err = -EBUSY;
+				break;
+			}
+			list_move_tail(&ticket->list, &released);
+			session->nr_view_tickets--;
+			if (ticket->control)
+				session->nr_view_control_tickets--;
+		}
+		mutex_unlock(&session->lock);
+		list_for_each_entry_safe(ticket, next, &released, list) {
+			void *reservation = ticket->reservation;
+
+			list_del(&ticket->list);
+			hfs_buf_free(&ticket->request);
+			hfs_buf_free(&ticket->payload);
+			hfs_buf_free(&ticket->query);
+			hfs_buf_free(&ticket->original);
+			kvfree(ticket->scratch);
+			hfs_json_free(ticket->response);
+			hfs_json_free(ticket->initial_response);
+			hfs_completion_close(ticket->completion);
+			kfree(ticket);
+			session->provider->unreserve(session, reservation);
+		}
+		if (cut) {
+			family->retirement_cut = NULL;
+			hfs_retirement_cut_free(session, cut);
+			cut = NULL;
+		} else
+			hfs_json_free(reply);
+		reply = NULL;
+		if (err)
+			goto out;
+	}
+out:
+	if (!cut)
+		hfs_json_free(reply);
+	/* Payload and snapshot storage were reserved before writable admission. */
+	mutex_unlock(&session->retirement);
+	hfs_view_put(view);
+	return err ?: (advanced ? 0 : -EAGAIN);
+}
+
+/* Outputs remain owned on uncertain errors: their exact ticket and ordinary
+ * number must be resolved; timeout is never a destructor or no-effect proof.
+ */
+int hfs_dirty_reserve(struct hfs_session *session, struct hfs_cache_page *entry,
+		       const struct hfs_cap *description, u64 offset, u32 length,
+		       struct hfs_dirty **out)
+{
+	struct hfs_dirty *dirty;
+	struct hfs_json *reply = NULL;
+	struct hfs_buf *payload;
+	const struct hfs_cred *cred;
+	u8 expected[32], actual[32];
+	uuid_t provenance;
+	u64 number;
+	int err, body;
+
+	*out = NULL;
+	if (!entry->lease || !entry->lease->dirty || !description ||
+	    !(description->rights & 2) || offset % 4096 || offset > S64_MAX - 4096 ||
+	    !length || length > 4096)
+		return -EINVAL;
+	err = hfs_view_dirty_slot(entry);
+	if (err)
+		return err;
+	cred = entry->lease->issuer;
+	dirty = kzalloc(sizeof(*dirty), GFP_KERNEL);
+	if (!dirty) {
+		hfs_view_dirty_unslot(entry);
+		return -ENOMEM;
+	}
+	INIT_LIST_HEAD(&dirty->list);
+	dirty->offset = offset;
+	dirty->length = length;
+	dirty->home = description->home;
+	dirty->allocation = description->allocation;
+	err = session->provider->reserve(session, sizeof(*dirty) + 4ULL * 1024 * 1024,
+					 true, &dirty->credit);
+	if (err) {
+		kfree(dirty);
+		hfs_view_dirty_unslot(entry);
+		return err;
+	}
+	/* From here cleanup must resolve any numbered local/remote obligation. */
+	*out = dirty;
+	if (hfs_buf_init(&dirty->freeze_payload, HFS_VIEW_BODY_MAX) ||
+	    hfs_buf_init(&dirty->drain_args, 32768))
+		return -ENOMEM;
+	err = hfs_view_ticket_prepare(session, cred, true, &dirty->freeze_ticket);
+	if (!err)
+		err = hfs_view_ticket_prepare(session, cred, false, &dirty->reserve_ticket);
+	if (!err)
+		err = hfs_request_earmark(session, cred, dirty->reserve_ticket, &dirty->request);
+	if (err)
+		return err;
+	err = hfs_view_ticket_activate(dirty->reserve_ticket);
+	if (err)
+		return err;
+	payload = &dirty->freeze_payload;
+	hfs_buf_literal(payload, "{\"claim_number\":");
+	hfs_buf_add(payload, dirty->request->earmark_number.data,
+		    dirty->request->earmark_number.len);
+	hfs_buf_literal(payload, ",\"description\":");
+	hfs_cap_write(payload, description);
+	hfs_buf_literal(payload, ",\"lease\":");
+	hfs_buf_add(payload, entry->lease->json->data, entry->lease->json->len);
+	hfs_buf_printf(payload, ",\"length\":4096,\"offset\":%llu,\"request\":", offset);
+	hfs_buf_add(payload, dirty->reserve_ticket->request.data,
+		    dirty->reserve_ticket->request.len);
+	hfs_buf_literal(payload, "}");
+	err = hfs_view_exchange(session, dirty->reserve_ticket, "DIRTY_RESERVE", payload, &reply);
+	if (err)
+		goto done;
+	body = hfs_json_field(reply, 0, "reservation");
+	if (hfs_json_exact(reply, body,
+		"claim_number,credentials,description,drain_credit,id,lease_id,length,offset,provenance,scope") ||
+	    !hfs_token_equal(reply, hfs_json_field(reply, body, "claim_number"),
+			     dirty->request->earmark_number.data, dirty->request->earmark_number.len) ||
+	    !hfs_token_equal(reply, hfs_json_field(reply, body, "credentials"),
+			     dirty->request->credentials.data, dirty->request->credentials.len) ||
+	    !hfs_token_equal(reply, hfs_json_field(reply, body, "description"),
+			     description->json->data, description->json->len) ||
+	    !hfs_token_equal(reply, hfs_json_field(reply, body, "scope"),
+			     dirty->request->original_context.data, dirty->request->original_context.len) ||
+	    hfs_hex32(reply, body, "lease_id", actual) || memcmp(actual, entry->lease->id, 32) ||
+	    hfs_hex32(reply, body, "drain_credit", actual) ||
+	    hfs_hex32(reply, body, "id", expected) ||
+	    hfs_uuid(reply, hfs_json_field(reply, body, "provenance"), &provenance) ||
+	    uuid_is_null(&provenance) ||
+	    hfs_u64_field(reply, body, "offset", &number) || number != offset ||
+	    hfs_u64_field(reply, body, "length", &number) || number != 4096) {
+		err = -EPROTO;
+		goto done;
+	}
+	err = hfs_json_hash_fields(reply, body,
+		"claim_number,credentials,description,drain_credit,lease_id,length,offset,provenance,scope", actual);
+	if (!err && memcmp(expected, actual, 32))
+		err = -EPROTO;
+	if (!err && session->bridge_minor == 4)
+		err = hfs_received_source(session, reply, body);
+	if (!err)
+		err = hfs_copy_json(reply, body, &dirty->reservation);
+	if (!err) {
+		memcpy(dirty->id, expected, 32);
+		hfs_request_earmark_admitted(session, dirty->request);
+	}
+done:
+	hfs_json_free(reply);
+	if (err == -EPROTO)
+		WRITE_ONCE(session->blocked, true);
+	return err;
+}
+
+int hfs_dirty_resume_reserve(struct hfs_session *session, struct hfs_dirty *dirty,
+			     struct hfs_lease *lease)
+{
+	struct hfs_view_ticket *ticket = dirty->reserve_ticket;
+	struct hfs_buf *payload = &dirty->freeze_payload;
+	struct hfs_json *response = NULL;
+	int err, access, description;
+
+	if (!ticket || !dirty->request || !lease || !lease->json)
+		return -EINVAL;
+	if (ticket->bound) {
+		err = hfs_view_exchange(session, ticket, "DIRTY_RESERVE", &ticket->payload, &response);
+	} else {
+		err = hfs_view_ticket_activate(ticket);
+		if (err)
+			return err;
+		access = hfs_json_field(lease->json, 0, "access");
+		description = hfs_json_field(lease->json, access, "description");
+		payload->len = 0;
+		payload->error = 0;
+		hfs_buf_literal(payload, "{\"claim_number\":");
+		hfs_buf_add(payload, dirty->request->earmark_number.data,
+			    dirty->request->earmark_number.len);
+		hfs_buf_literal(payload, ",\"description\":");
+		hfs_buf_token(payload, lease->json, description);
+		hfs_buf_literal(payload, ",\"lease\":");
+		hfs_buf_add(payload, lease->json->data, lease->json->len);
+		hfs_buf_printf(payload, ",\"length\":4096,\"offset\":%llu,\"request\":", dirty->offset);
+		hfs_buf_add(payload, ticket->request.data, ticket->request.len);
+		hfs_buf_literal(payload, "}");
+		err = hfs_view_exchange(session, ticket, "DIRTY_RESERVE", payload, &response);
+	}
+	/* No admission/replay result from this cleanup path is ever adopted.
+	 * It only resolves the original numbered reservation before CANCEL.
+	 */
+	hfs_json_free(response);
+	return err;
+}
+
+int hfs_dirty_freeze(struct hfs_view *view, struct hfs_dirty *dirty)
+{
+	struct hfs_session *session = view->session;
+	struct hfs_buf *payload = &dirty->freeze_payload, *args = &dirty->drain_args;
+	struct hfs_json *reply = NULL, *expected_entry = NULL, *received_entry = NULL;
+	struct page *page = dirty->entry->page;
+	u8 data_hash[32], entry_id[32];
+	void *address;
+	unsigned long flags;
+	u64 revision;
+	int description, entry, err;
+
+	if (dirty->frozen)
+		return 0;
+	spin_lock_irqsave(&view->lock, flags);
+	err = !dirty->adopted || !view->quiescent ||
+		view->phase != HFS_VIEW_QUIESCENT || view->active ? -ESTALE : 0;
+	revision = view->revision;
+	spin_unlock_irqrestore(&view->lock, flags);
+	if (err || !page)
+		return err ?: -ESTALE;
+	if (!dirty->captured) {
+		lock_page(page);
+		if (page_mapped(page) || PageWriteback(page) ||
+		    folio_maybe_dma_pinned(page_folio(page))) {
+			unlock_page(page);
+			return -EBUSY;
+		}
+		address = kmap_local_page(page);
+		memcpy(dirty->data, address, dirty->length);
+		kunmap_local(address);
+		unlock_page(page);
+		dirty->recall = view->recall;
+		dirty->captured = true;
+	} else if (!uuid_equal(&dirty->recall, &view->recall)) {
+		return -ESTALE;
+	}
+	/* Frozen page bytes are now in already reserved immutable RAM. All
+	 * following RPC/JSON work happens outside page/PTE/MM critical locks.
+	 */
+	hfs_hash(dirty->data, dirty->length, data_hash);
+	description = hfs_json_field(dirty->reservation, 0, "description");
+	payload->len = 0;
+	payload->error = 0;
+	hfs_buf_literal(payload, "{\"description\":");
+	hfs_buf_token(payload, dirty->reservation, description);
+	hfs_buf_printf(payload, ",\"length\":%u,\"offset\":%llu,\"payload_hash\":",
+		       dirty->length, dirty->offset);
+	hfs_buf_hex(payload, data_hash, 32);
+	hfs_buf_literal(payload, ",\"reservation\":");
+	hfs_buf_hex(payload, dirty->id, 32);
+	hfs_buf_literal(payload, "}");
+	if (payload->error)
+		return payload->error;
+	hfs_hash(payload->data, payload->len, entry_id);
+	args->len = 0;
+	args->error = 0;
+	hfs_buf_literal(args, "{\"data\":");
+	hfs_buf_hex(args, dirty->data, dirty->length);
+	hfs_buf_literal(args, ",\"description\":");
+	hfs_buf_token(args, dirty->reservation, description);
+	hfs_buf_literal(args, ",\"dirty_entry\":");
+	hfs_buf_hex(args, entry_id, 32);
+	hfs_buf_printf(args, ",\"offset\":%llu,\"recall\":\"%pUb\",\"reservation\":",
+		       dirty->offset, &dirty->recall);
+	hfs_buf_hex(args, dirty->id, 32);
+	hfs_buf_literal(args, "}");
+	if (!dirty->request->bound) {
+		err = hfs_request_bind_drain(session, dirty->request, args);
+		if (err)
+			return err;
+	}
+	payload->len = 0;
+	payload->error = 0;
+	hfs_buf_literal(payload, "{\"claim\":");
+	hfs_buf_add(payload, dirty->request->claim.data, dirty->request->claim.len);
+	hfs_buf_literal(payload, ",\"description\":");
+	hfs_buf_token(payload, dirty->reservation, description);
+	hfs_buf_literal(payload, ",\"id\":");
+	hfs_buf_hex(payload, entry_id, 32);
+	hfs_buf_printf(payload, ",\"length\":%u,\"offset\":%llu,\"payload_hash\":",
+		       dirty->length, dirty->offset);
+	hfs_buf_hex(payload, data_hash, 32);
+	hfs_buf_literal(payload, ",\"reservation\":");
+	hfs_buf_hex(payload, dirty->id, 32);
+	hfs_buf_literal(payload, "}");
+	err = payload->error ?: hfs_json_parse(payload->data, payload->len, &expected_entry);
+	if (err)
+		return err;
+	payload->len = 0;
+	payload->error = 0;
+	hfs_buf_literal(payload, "{\"claim\":");
+	hfs_buf_add(payload, dirty->request->claim.data, dirty->request->claim.len);
+	hfs_buf_literal(payload, ",\"data\":");
+	hfs_buf_hex(payload, dirty->data, dirty->length);
+	err = hfs_view_ticket_activate(dirty->freeze_ticket);
+	if (err)
+		goto done;
+	hfs_buf_printf(payload, ",\"recall\":\"%pUb\",\"request\":", &dirty->recall);
+	hfs_buf_add(payload, dirty->freeze_ticket->request.data, dirty->freeze_ticket->request.len);
+	hfs_buf_literal(payload, ",\"reservation\":");
+	hfs_buf_add(payload, dirty->reservation->data, dirty->reservation->len);
+	hfs_buf_literal(payload, "}");
+	err = hfs_view_exchange(session, dirty->freeze_ticket, "DIRTY_FREEZE", payload, &reply);
+	if (err)
+		goto done;
+	entry = hfs_json_field(reply, 0, "entry");
+	if (!hfs_token_equal(reply, entry, expected_entry->data, expected_entry->len)) {
+		err = -EPROTO;
+		goto done;
+	}
+	if (session->bridge_minor == 4) {
+		err = hfs_received_source(session, reply, entry);
+		if (!err)
+			err = hfs_received_copy(reply, entry, &received_entry);
+		if (err)
+			goto done;
+		/* Copy/verification can sleep. Adoption itself is a physical-state
+		 * transition and rechecks the actual capture before publication.
+		 */
+		spin_lock_irqsave(&view->lock, flags);
+		if (!view->quiescent || view->phase != HFS_VIEW_QUIESCENT || view->active ||
+		    view->revision != revision || !uuid_equal(&view->recall, &dirty->recall)) {
+			err = -ESTALE;
+		} else {
+			memcpy(dirty->entry_id, entry_id, 32);
+			dirty->frozen_entry = received_entry;
+			received_entry = NULL;
+			dirty->frozen = true;
+		}
+		spin_unlock_irqrestore(&view->lock, flags);
+	} else {
+		/* Preserve the closed older provider contract and allocation path. */
+		memcpy(dirty->entry_id, entry_id, 32);
+		dirty->frozen_entry = expected_entry;
+		expected_entry = NULL;
+		dirty->frozen = true;
+	}
+done:
+	hfs_json_free(received_entry);
+	hfs_json_free(reply);
+	hfs_json_free(expected_entry);
+	if (err == -EPROTO)
+		WRITE_ONCE(session->blocked, true);
+	return err;
+}
+
+static void hfs_dirty_mapping_error(struct hfs_view *view, struct hfs_dirty *dirty, int err)
+{
+	struct hfs_inode *object;
+	struct inode *inode = NULL;
+	unsigned long flags;
+
+	spin_lock_irqsave(&view->lock, flags);
+	list_for_each_entry(object, &view->mappings, view_list)
+		if (uuid_equal(&object->object->home, &dirty->home) &&
+		    uuid_equal(&object->object->allocation, &dirty->allocation)) {
+			inode = igrab(&object->inode);
+			break;
+		}
+	spin_unlock_irqrestore(&view->lock, flags);
+	if (inode) {
+		mapping_set_error(inode->i_mapping, err);
+		iput(inode);
+	}
+}
+
+int hfs_dirty_drain(struct hfs_view *view, struct hfs_dirty *dirty)
+{
+	struct hfs_json *result = NULL;
+	struct page *page;
+	unsigned long flags;
+	u64 count;
+	int err;
+
+	if (!dirty->adopted || !dirty->frozen || !dirty->request ||
+	    !READ_ONCE(view->quiescent))
+		return -ESTALE;
+	if (dirty->resolved)
+		return 0;
+	if (dirty->request->terminal) {
+		err = dirty->request->result ? hfs_copy_json(dirty->request->result, 0, &result) : -EPROTO;
+		if (!err)
+			err = hfs_result_code(result);
+	} else {
+		err = hfs_request_drain(view->session, dirty->request, &result);
+	}
+	if (!err && (hfs_u64_field(result, 0, "count", &count) || count != dirty->length))
+		err = -EIO;
+	if (err) {
+		hfs_dirty_mapping_error(view, dirty, err);
+		goto out;
+	}
+	spin_lock_irqsave(&view->lock, flags);
+	page = dirty->entry->page;
+	if (page)
+		get_page(page);
+	spin_unlock_irqrestore(&view->lock, flags);
+	if (page) {
+		lock_page(page);
+		if (page_mapped(page) || PageWriteback(page) ||
+		    folio_maybe_dma_pinned(page_folio(page)))
+			err = -EBUSY;
+		else
+			clear_page_dirty_for_io(page);
+		unlock_page(page);
+		put_page(page);
+	}
+	if (!err) {
+		/* Intermediate installs may have detached the old cache page.
+		 * Immutable bytes/Claim remained in reserved RAM throughout; the
+		 * exact protected full-length result now resolves that obligation.
+		 */
+		spin_lock_irqsave(&view->lock, flags);
+		dirty->resolved = true;
+		spin_unlock_irqrestore(&view->lock, flags);
+	}
+out:
+	hfs_json_free(result);
+	return err;
+}
diff --git a/fs/9p/hfs_mmap.c b/fs/9p/hfs_mmap.c
new file mode 100644
--- /dev/null
+++ b/fs/9p/hfs_mmap.c
@@ -0,0 +1,1759 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Retained file mappings: physical stopped installation and reserved drains. */
+#include <linux/mm.h>
+#include <linux/pagemap.h>
+#include <linux/slab.h>
+#include <linux/writeback.h>
+#include <linux/workqueue.h>
+#include <linux/delay.h>
+#include <linux/highmem.h>
+#include <linux/user_namespace.h>
+#include "hfs.h"
+#include "hfs_received.h"
+#include "hfs_controlled.h"
+
+/* transitions owns the preallocated inode workspace. No network/user copy or
+ * source verifier runs in this page/PTE critical phase.
+ */
+static int hfs_mmap_invalidate_stopped(struct hfs_view *view)
+{
+	struct hfs_inode *object;
+	struct hfs_cache_page *entry;
+	unsigned long flags;
+	u32 count = 0, pages = 0, i;
+	int err = 0, current_err;
+
+	spin_lock_irqsave(&view->lock, flags);
+	if (!view->quiescent || view->active || view->phase == HFS_VIEW_LIVE ||
+	    view->phase == HFS_VIEW_FENCED) {
+		err = -ESTALE;
+		goto unlock;
+	}
+	list_for_each_entry(object, &view->mappings, view_list) {
+		struct inode *inode = igrab(&object->inode);
+
+		if (inode)
+			view->stopping[count++] = inode;
+	}
+	spin_unlock_irqrestore(&view->lock, flags);
+	for (i = 0; i < count; i++) {
+		struct inode *inode = view->stopping[i];
+
+		/* STOP already zapped all aliases including executable and
+		 * open-unlinked; this check independently refuses a late busy page.
+		 * Frozen bytes/claims remain in the complete reserved registry even
+		 * when their terminal result is waiting for this cut installation.
+		 */
+		current_err = invalidate_inode_pages2(inode->i_mapping);
+		if (current_err && !err)
+			err = current_err;
+		iput(inode);
+		view->stopping[i] = NULL;
+	}
+	spin_lock_irqsave(&view->lock, flags);
+	list_for_each_entry(entry, &view->cache, list)
+		if (entry->page) {
+			get_page(entry->page);
+			view->stopping_pages[pages++] = entry->page;
+		}
+	spin_unlock_irqrestore(&view->lock, flags);
+	for (i = 0; i < pages; i++) {
+		struct page *page = view->stopping_pages[i];
+
+		lock_page(page);
+		/* Last close/unlink/eviction can already have detached a retained
+		 * provenance page from its inode. Frozen RAM still owns its bytes.
+		 */
+		if (!page_mapping(page) && !page_mapped(page) && !PageWriteback(page) &&
+		    !folio_maybe_dma_pinned(page_folio(page))) {
+			current_err = PageDirty(page) ?
+				hfs_cache_aops.launder_folio(page_folio(page)) : 0;
+			if (!current_err) {
+				hfs_cache_aops.invalidate_folio(page_folio(page), 0, PAGE_SIZE);
+				hfs_cache_aops.free_folio(page_folio(page));
+			}
+		}
+		unlock_page(page);
+		put_page(page);
+		view->stopping_pages[i] = NULL;
+	}
+	spin_lock_irqsave(&view->lock, flags);
+	list_for_each_entry(entry, &view->cache, list)
+		if (entry->page)
+			err = err ?: -EBUSY;
+unlock:
+	spin_unlock_irqrestore(&view->lock, flags);
+	return err;
+}
+
+/* An actual terminal full-length drain and physical cache detachment are both
+ * required. The canonical manifest has already copied the frozen records and
+ * remains immutable through final ACK/replay; removing this in-memory registry
+ * does not change that manifest or the host's protected source inventory.
+ */
+static int hfs_mmap_close_drained(struct hfs_view *view)
+{
+	struct hfs_dirty *dirty, *next;
+	LIST_HEAD(closed);
+	unsigned long flags;
+	int err = 0;
+
+	spin_lock_irqsave(&view->lock, flags);
+	list_for_each_entry(dirty, &view->dirty, list)
+		if (!dirty->resolved || !dirty->frozen || dirty->entry->page) {
+			err = -EBUSY;
+			goto unlock;
+		}
+	list_for_each_entry_safe(dirty, next, &view->dirty, list) {
+		dirty->entry->dirty = NULL;
+		view->nr_dirty--;
+		list_move_tail(&dirty->list, &closed);
+	}
+unlock:
+	spin_unlock_irqrestore(&view->lock, flags);
+	if (err)
+		return err;
+	list_for_each_entry_safe(dirty, next, &closed, list) {
+		struct hfs_request *request = dirty->request;
+
+		list_del(&dirty->list);
+		dirty->request = NULL;
+		hfs_request_unhold(view->session, request);
+		hfs_view_ticket_put(dirty->reserve_ticket);
+		hfs_view_ticket_put(dirty->freeze_ticket);
+		hfs_json_free(dirty->reservation);
+		hfs_json_free(dirty->frozen_entry);
+		hfs_buf_free(&dirty->freeze_payload);
+		hfs_buf_free(&dirty->drain_args);
+		hfs_view_page_put(dirty->entry);
+		view->session->provider->unreserve(view->session, dirty->credit);
+		kfree(dirty);
+	}
+	return 0;
+}
+
+static bool hfs_mmap_install_phase(struct hfs_view *view, bool final)
+{
+	return final ? view->phase == HFS_VIEW_DRAINED :
+		(view->phase == HFS_VIEW_STOPPED || view->phase == HFS_VIEW_INSTALLED_DRAIN);
+}
+
+int hfs_mmap_install(struct hfs_view *view, const struct hfs_json *event,
+		     int target, const uuid_t *recall, u64 sequence, bool final)
+{
+	u8 target_hash[32];
+	uuid_t visibility;
+	unsigned long flags;
+	u32 len;
+	int err;
+
+	if (!sequence || target < 0 || target >= event->count)
+		return -EPROTO;
+	len = event->tokens[target].end - event->tokens[target].start;
+	if (!len || len > HFS_TARGET_MAX)
+		return -EPROTO;
+	/* Native source verification is mandatory. It runs while observations
+	 * are stopped, outside every page/PTE/physical critical token.
+	 */
+	err = hfs_view_target(view->session, event, target, &visibility, target_hash);
+	if (err)
+		return err;
+	mutex_lock(&view->transitions);
+	spin_lock_irqsave(&view->lock, flags);
+	if ((final ? view->phase == HFS_VIEW_FINAL :
+	     (view->phase == HFS_VIEW_INSTALLED_DRAIN || view->phase == HFS_VIEW_DRAINED)) &&
+	    view->quiescent && !view->active && sequence == view->sequence &&
+	    uuid_equal(&view->recall, recall) && !memcmp(view->target_hash, target_hash, 32)) {
+		spin_unlock_irqrestore(&view->lock, flags);
+		err = 0;
+		goto out;
+	}
+	if (!view->quiescent || view->active || !uuid_equal(&view->recall, recall) ||
+	    sequence <= view->sequence ||
+	    !hfs_mmap_install_phase(view, final))
+		err = -ESTALE;
+	spin_unlock_irqrestore(&view->lock, flags);
+	if (err)
+		goto out;
+	err = hfs_mmap_invalidate_stopped(view);
+	if (err)
+		goto out;
+	spin_lock_irqsave(&view->lock, flags);
+	/* Source validation may park; fence still wins before installation.
+	 * Revalidate exact phase/event immediately before installing target.
+	 */
+	if (!view->quiescent || view->active || !uuid_equal(&view->recall, recall) ||
+	    sequence <= view->sequence ||
+	    !hfs_mmap_install_phase(view, final)) {
+		err = -ESTALE;
+	} else if (view->revision == U64_MAX) {
+		view->phase = HFS_VIEW_FENCED;
+		err = -EOVERFLOW;
+	} else {
+		view->target.len = 0;
+		view->target.error = 0;
+		hfs_buf_token(&view->target, event, target);
+		err = view->target.error;
+		if (!err) {
+			memcpy(view->target_hash, target_hash, 32);
+			view->generation = visibility;
+			view->revision++;
+			view->sequence = sequence;
+			view->phase = final ? HFS_VIEW_FINAL : HFS_VIEW_INSTALLED_DRAIN;
+		}
+	}
+	spin_unlock_irqrestore(&view->lock, flags);
+out:
+	mutex_unlock(&view->transitions);
+	return err;
+}
+
+static int hfs_mmap_finish_drained(struct hfs_view *view)
+{
+	unsigned long flags;
+	int err;
+
+	mutex_lock(&view->transitions);
+	spin_lock_irqsave(&view->lock, flags);
+	err = view->phase == HFS_VIEW_INSTALLED_DRAIN && view->quiescent &&
+		!view->active ? 0 : -ESTALE;
+	spin_unlock_irqrestore(&view->lock, flags);
+	if (!err)
+		err = hfs_mmap_close_drained(view);
+	if (!err) {
+		spin_lock_irqsave(&view->lock, flags);
+		if (view->phase != HFS_VIEW_INSTALLED_DRAIN || !view->quiescent || view->active)
+			err = -ESTALE;
+		else
+			view->phase = HFS_VIEW_DRAINED;
+		spin_unlock_irqrestore(&view->lock, flags);
+	}
+	mutex_unlock(&view->transitions);
+	return err;
+}
+
+/* Independent poll, event and drain queues prevent a parked service grant from
+ * owning the executor needed to install that grant's protected intermediate cut.
+ */
+struct hfs_mmap_control {
+	struct kref refs;
+	struct hfs_view *view;
+	struct workqueue_struct *poll_queue;
+	struct workqueue_struct *event_queue;
+	struct workqueue_struct *drain_queue;
+	struct workqueue_struct *cleanup_queue;
+	struct workqueue_struct *pressure_queue;
+	struct delayed_work poll;
+	struct delayed_work events;
+	struct delayed_work pressure;
+	struct delayed_work drained;
+	struct hfs_json *drain_event;
+	bool drained_acked;
+	unsigned long pressure_after;
+	struct work_struct drains;
+	spinlock_t lock;
+	struct list_head cleanup;
+	struct hfs_json *pending[HFS_MMAP_EVENTS_MAX];
+	u32 head;
+	u32 count;
+	u64 delivered;
+	u64 completed;
+	uuid_t recall;
+	uuid_t old_visibility;
+	bool have_recall;
+	struct hfs_json *last_event;
+	struct hfs_buf poll_payload;
+	struct hfs_buf ack;
+	struct hfs_buf last_ack;
+	void *credit;
+	bool stopping;
+	int error;
+};
+
+static void hfs_mmap_control_release(struct kref *refs)
+{
+	struct hfs_mmap_control *control = container_of(refs, struct hfs_mmap_control, refs);
+	struct hfs_view *view = control->view;
+
+	hfs_buf_free(&control->poll_payload);
+	hfs_buf_free(&control->ack);
+	hfs_buf_free(&control->last_ack);
+	view->session->provider->unreserve(view->session, control->credit);
+	hfs_view_put(view);
+	kfree(control);
+}
+
+static struct hfs_mmap_control *hfs_mmap_control_get(struct hfs_view *view)
+{
+	struct hfs_mmap_control *control;
+	unsigned long flags;
+
+	spin_lock_irqsave(&view->lock, flags);
+	control = view->control;
+	if (control && !control->stopping)
+		kref_get(&control->refs);
+	else
+		control = NULL;
+	spin_unlock_irqrestore(&view->lock, flags);
+	return control;
+}
+
+static void hfs_mmap_control_put(struct hfs_mmap_control *control)
+{
+	if (control)
+		kref_put(&control->refs, hfs_mmap_control_release);
+}
+
+static int hfs_mmap_hash32(const struct hfs_json *json, int object,
+			  const char *name, u8 out[32])
+{
+	u32 len = 32;
+
+	if (hfs_json_hex(json, hfs_json_field(json, object, name), out, &len) || len != 32)
+		return -EPROTO;
+	return 0;
+}
+
+static bool hfs_mmap_token(const struct hfs_json *json, int token,
+			    const void *data, u32 len)
+{
+	return token >= 0 && token < json->count &&
+		json->tokens[token].end - json->tokens[token].start == len &&
+		!memcmp(json->data + json->tokens[token].start, data, len);
+}
+
+/* The full canonical VIEW_WAIT envelope remains available to the mandatory
+ * native verifier. Local parsing does not replace enrolled source authority.
+ */
+static int hfs_mmap_event_check(struct hfs_view *view, const struct hfs_json *json,
+			       int event, u64 *sequence, uuid_t *recall)
+{
+	struct hfs_session *session = view->session;
+	u8 digest[32];
+	uuid_t old;
+	int phase = hfs_json_field(json, event, "phase");
+	bool is_recall = hfs_json_is(json, phase, "\"RECALL\"");
+
+	if (!json->transported || json->channel != HFS_CHANNEL_RECALL ||
+	    json->frame_kind != HFS_FRAME_RECALL || json->frame_minor != session->bridge_minor ||
+	    !json->native_cell || !uuid_equal(&json->native_session, &session->enrollment.session))
+		return -EPROTO;
+	if (hfs_json_exact(json, event,
+		"authority_hash,closure_hash,domain,inventory_hash,manifest_hash,"
+		"old_visibility,phase,recall,sequence,target") ||
+	    hfs_json_u64(json, hfs_json_field(json, event, "sequence"), sequence) || !*sequence ||
+	    hfs_uuid(json, hfs_json_field(json, event, "recall"), recall) || uuid_is_null(recall) ||
+	    hfs_uuid(json, hfs_json_field(json, event, "old_visibility"), &old) || uuid_is_null(&old) ||
+	    !hfs_mmap_token(json, hfs_json_field(json, event, "domain"),
+			     session->domain->json->data, session->domain->json->len) ||
+	    hfs_mmap_hash32(json, event, "authority_hash", digest) ||
+	    hfs_mmap_hash32(json, event, "closure_hash", digest) ||
+	    hfs_mmap_hash32(json, event, "inventory_hash", digest))
+		return -EPROTO;
+	if (is_recall) {
+		if (!hfs_json_is(json, hfs_json_field(json, event, "target"), "null") ||
+		    !hfs_json_is(json, hfs_json_field(json, event, "manifest_hash"), "null"))
+			return -EPROTO;
+	} else {
+		if ((!hfs_json_is(json, phase, "\"INSTALL_DRAIN\"") &&
+		     !hfs_json_is(json, phase, "\"INSTALL_FINAL\"") &&
+		     !hfs_json_is(json, phase, "\"REOPEN\"")) ||
+		    hfs_json_is(json, hfs_json_field(json, event, "target"), "null") ||
+		    hfs_mmap_hash32(json, event, "manifest_hash", digest))
+			return -EPROTO;
+	}
+	return session->provider->view_event(session, json, event);
+}
+
+static int hfs_mmap_ack(struct hfs_mmap_control *control, const struct hfs_json *event,
+			int body, const char *phase, bool manifest, bool target)
+{
+	struct hfs_view *view = control->view;
+	struct hfs_session *session = view->session;
+	struct hfs_buf *payload = &control->ack;
+	struct hfs_json *reply = NULL;
+	int err, result;
+
+	payload->len = 0;
+	payload->error = 0;
+	hfs_buf_literal(payload, "{\"authority_hash\":");
+	hfs_buf_token(payload, event, hfs_json_field(event, body, "authority_hash"));
+	hfs_buf_literal(payload, ",\"closure_hash\":");
+	hfs_buf_token(payload, event, hfs_json_field(event, body, "closure_hash"));
+	hfs_buf_literal(payload, ",\"domain\":");
+	hfs_cap_write(payload, session->domain);
+	hfs_buf_literal(payload, ",\"inventory_hash\":");
+	hfs_buf_token(payload, event, hfs_json_field(event, body, "inventory_hash"));
+	hfs_buf_literal(payload, ",\"manifest\":");
+	if (manifest)
+		hfs_buf_add(payload, view->manifest.data, view->manifest.len);
+	else
+		hfs_buf_literal(payload, "null");
+	hfs_buf_printf(payload, ",\"phase\":\"%s\",\"recall\":", phase);
+	hfs_buf_token(payload, event, hfs_json_field(event, body, "recall"));
+	hfs_buf_literal(payload, ",\"sequence\":");
+	hfs_buf_token(payload, event, hfs_json_field(event, body, "sequence"));
+	hfs_buf_printf(payload, ",\"session\":\"%pUb\",\"target\":", &session->enrollment.session);
+	if (target)
+		hfs_buf_token(payload, event, hfs_json_field(event, body, "target"));
+	else
+		hfs_buf_literal(payload, "null");
+	hfs_buf_literal(payload, "}");
+	err = payload->error ?: hfs_controlled_before_ack(view, event, body, phase, payload);
+	if (!err)
+		err = hfs_control(session, "VIEW_ACK", payload, true, &reply);
+	if (err)
+		return err;
+	result = hfs_json_field(reply, 0, "payload");
+	if (hfs_json_exact(reply, result, "status"))
+		err = -EPROTO;
+	else if (hfs_json_is(reply, hfs_json_field(reply, result, "status"), "\"BLOCKED\""))
+		err = -EAGAIN;
+	else if (!hfs_json_is(reply, hfs_json_field(reply, result, "status"), "\"ACCEPTED\""))
+		err = -ESTALE;
+	if (!err)
+		err = hfs_controlled_after_ack(session, phase, payload, reply);
+	if (!err) {
+		control->last_ack.len = 0;
+		control->last_ack.error = 0;
+		hfs_buf_add(&control->last_ack, payload->data, payload->len);
+		err = control->last_ack.error;
+	}
+	hfs_json_free(reply);
+	return err;
+}
+
+static void hfs_mmap_fail(struct hfs_mmap_control *control, int error)
+{
+	/* The worker stops for good here (no further VIEW_WAIT or ACK), so the
+	 * cause must be visible in the guest log of a lab run.
+	 */
+	pr_warn_ratelimited("9p hfs: view control worker stopped, error %d\n", error);
+	WRITE_ONCE(control->error, error);
+	WRITE_ONCE(control->view->session->blocked, true);
+	/* This closes admission, not a declaration of physical STOPPED. All
+	 * original grants/bytes/tickets and canonical evidence remain retained.
+	 */
+	hfs_view_fence(control->view);
+}
+
+static void hfs_mmap_drains(struct work_struct *work)
+{
+	struct hfs_mmap_control *control = container_of(work, struct hfs_mmap_control, drains);
+	struct hfs_view *view = control->view;
+	struct hfs_dirty *dirty, *ordered[HFS_DIRTY_PAGES_MAX], *tmp;
+	unsigned long flags;
+	u32 count = 0, i, j;
+	int err;
+
+	if (READ_ONCE(control->stopping) || READ_ONCE(control->error))
+		return;
+	spin_lock_irqsave(&view->lock, flags);
+	list_for_each_entry(dirty, &view->dirty, list) {
+		if (count == ARRAY_SIZE(ordered)) {
+			spin_unlock_irqrestore(&view->lock, flags);
+			hfs_mmap_fail(control, -EOVERFLOW);
+			return;
+		}
+		ordered[count++] = dirty;
+	}
+	spin_unlock_irqrestore(&view->lock, flags);
+	/* Ordinary earmarks form a contiguous protected origin sequence. Drain
+	 * in that order; manifest order independently remains DirtyEntry id.
+	 */
+	for (i = 1; i < count; i++) {
+		tmp = ordered[i];
+		for (j = i; j && ordered[j - 1]->request->number > tmp->request->number; j--)
+			ordered[j] = ordered[j - 1];
+		ordered[j] = tmp;
+	}
+	for (i = 0; i < count; i++) {
+		err = hfs_dirty_drain(view, ordered[i]);
+		if (err) {
+			hfs_mmap_fail(control, err);
+			return;
+		}
+	}
+}
+
+static void hfs_mmap_drained(struct work_struct *work);
+
+static int hfs_mmap_process(struct hfs_mmap_control *control, struct hfs_json *json)
+{
+	struct hfs_view *view = control->view;
+	struct hfs_dirty *dirty;
+	unsigned long flags;
+	u8 hash[32];
+	uuid_t recall, old;
+	u64 sequence;
+	int body = hfs_json_field(json, 0, "payload");
+	int event = hfs_json_field(json, body, "event");
+	int phase = hfs_json_field(json, event, "phase");
+	int target = hfs_json_field(json, event, "target");
+	int err;
+
+	err = hfs_mmap_event_check(view, json, event, &sequence, &recall);
+	if (err)
+		return err;
+	if (sequence <= control->completed)
+		return -ESTALE;
+	err = hfs_uuid(json, hfs_json_field(json, event, "old_visibility"), &old);
+	if (err)
+		return err;
+	if (hfs_json_is(json, phase, "\"RECALL\"")) {
+		if (!control->have_recall) {
+			spin_lock_irqsave(&view->lock, flags);
+			err = view->phase == HFS_VIEW_UNBOUND ||
+				(uuid_equal(&old, &view->generation) &&
+				 view->phase == HFS_VIEW_LIVE) ? 0 : -ESTALE;
+			spin_unlock_irqrestore(&view->lock, flags);
+			if (err)
+				return err;
+			control->recall = recall;
+			control->old_visibility = old;
+			control->have_recall = true;
+			control->drained_acked = false;
+		}
+		if (!uuid_equal(&control->recall, &recall) ||
+		    !uuid_equal(&control->old_visibility, &old))
+			return -ESTALE;
+		err = hfs_view_stop(view, &old, &recall, sequence);
+		if (err)
+			return err;
+		if (view->phase == HFS_VIEW_QUIESCENT) {
+			/* Admission is closed; only this event executor changes the
+			 * frozen registry until STOPPED has been accepted.
+			 */
+			list_for_each_entry(dirty, &view->dirty, list) {
+				err = hfs_dirty_freeze(view, dirty);
+				if (err)
+					return err;
+			}
+			err = hfs_view_seal(view);
+			if (err)
+				return err;
+		}
+		err = hfs_mmap_ack(control, json, event, "STOPPED", true, false);
+		if (!err)
+			queue_work(control->drain_queue, &control->drains);
+		return err;
+	}
+	if (!control->have_recall || !uuid_equal(&control->recall, &recall) ||
+	    !uuid_equal(&control->old_visibility, &old) ||
+	    hfs_mmap_hash32(json, event, "manifest_hash", hash) ||
+	    memcmp(hash, view->manifest_hash, 32))
+		return -ESTALE;
+	if (hfs_json_is(json, phase, "\"INSTALL_DRAIN\"")) {
+		err = hfs_mmap_install(view, json, target, &recall, sequence, false);
+		if (!err)
+			err = hfs_mmap_ack(control, json, event, "INSTALLED_DRAIN", false, true);
+		if (!err) {
+			struct hfs_json *retained = NULL;
+
+			err = hfs_received_copy(json, 0, &retained);
+			if (!err) {
+				hfs_json_free(control->drain_event);
+				control->drain_event = retained;
+				queue_delayed_work(control->event_queue, &control->drained, 0);
+			}
+		}
+		return err;
+	}
+	if (hfs_json_is(json, phase, "\"INSTALL_FINAL\"")) {
+		err = hfs_mmap_install(view, json, target, &recall, sequence, true);
+		if (!err)
+			err = hfs_mmap_ack(control, json, event, "INSTALLED_FINAL", false, true);
+		return err;
+	}
+	if (!hfs_json_is(json, phase, "\"REOPEN\"") ||
+	    !hfs_mmap_token(json, target, view->target.data, view->target.len))
+		return -ESTALE;
+	err = hfs_view_reopen(view, &recall, sequence);
+	if (!err)
+		err = hfs_mmap_ack(control, json, event, "REOPENED", false, true);
+	if (!err)
+		control->have_recall = false;
+	return err;
+}
+
+static void hfs_mmap_drained(struct work_struct *work)
+{
+	struct hfs_mmap_control *control = container_of(to_delayed_work(work),
+						       struct hfs_mmap_control, drained);
+	struct hfs_json *json = control->drain_event;
+	struct hfs_view *view = control->view;
+	int body, event, err;
+
+	if (!json || control->drained_acked || READ_ONCE(control->stopping) ||
+	    READ_ONCE(control->error))
+		return;
+	err = READ_ONCE(view->phase) == HFS_VIEW_DRAINED ? 0 : hfs_mmap_finish_drained(view);
+	if (!err) {
+		body = hfs_json_field(json, 0, "payload");
+		event = hfs_json_field(json, body, "event");
+		err = hfs_mmap_ack(control, json, event, "DRAINED", true, true);
+	}
+	if (err == -EAGAIN || err == -EBUSY) {
+		if (!READ_ONCE(control->stopping))
+			queue_delayed_work(control->event_queue, &control->drained, msecs_to_jiffies(10));
+	} else if (err) {
+		hfs_mmap_fail(control, err);
+	} else {
+		control->drained_acked = true;
+	}
+}
+
+static void hfs_mmap_events(struct work_struct *work)
+{
+	struct hfs_mmap_control *control = container_of(to_delayed_work(work),
+						       struct hfs_mmap_control, events);
+	struct hfs_json *json;
+	unsigned long flags;
+	u64 sequence;
+	int body, event, err;
+
+	spin_lock_irqsave(&control->lock, flags);
+	json = control->count ? control->pending[control->head] : NULL;
+	spin_unlock_irqrestore(&control->lock, flags);
+	if (!json || READ_ONCE(control->stopping) || READ_ONCE(control->error))
+		return;
+	err = hfs_mmap_process(control, json);
+	if (err == -EAGAIN || err == -EBUSY) {
+		if (!READ_ONCE(control->stopping))
+			queue_delayed_work(control->event_queue, &control->events, msecs_to_jiffies(10));
+		return;
+	}
+	if (err) {
+		hfs_mmap_fail(control, err);
+		return;
+	}
+	body = hfs_json_field(json, 0, "payload");
+	event = hfs_json_field(json, body, "event");
+	err = hfs_json_u64(json, hfs_json_field(json, event, "sequence"), &sequence);
+	if (err) {
+		hfs_mmap_fail(control, err);
+		return;
+	}
+	spin_lock_irqsave(&control->lock, flags);
+	control->pending[control->head] = NULL;
+	control->head = (control->head + 1) % ARRAY_SIZE(control->pending);
+	control->count--;
+	control->completed = sequence;
+	spin_unlock_irqrestore(&control->lock, flags);
+	hfs_json_free(control->last_event);
+	control->last_event = json; /* complete actual canonical envelope */
+	if (!READ_ONCE(control->stopping)) {
+		queue_delayed_work(control->poll_queue, &control->poll, 0);
+		queue_delayed_work(control->event_queue, &control->events, 0);
+	}
+}
+
+static void hfs_mmap_poll(struct work_struct *work)
+{
+	struct hfs_mmap_control *control = container_of(to_delayed_work(work),
+						       struct hfs_mmap_control, poll);
+	struct hfs_session *session = control->view->session;
+	struct hfs_buf *payload = &control->poll_payload;
+	struct hfs_json *reply = NULL;
+	unsigned long flags;
+	uuid_t recall;
+	u64 after, sequence;
+	int body, event, err;
+
+	if (READ_ONCE(control->stopping) || READ_ONCE(control->error))
+		return;
+	spin_lock_irqsave(&control->lock, flags);
+	if (control->count == ARRAY_SIZE(control->pending)) {
+		spin_unlock_irqrestore(&control->lock, flags);
+		return;
+	}
+	after = control->delivered;
+	spin_unlock_irqrestore(&control->lock, flags);
+	payload->len = 0;
+	payload->error = 0;
+	hfs_buf_printf(payload, "{\"after_sequence\":%llu,\"domain\":", after);
+	hfs_cap_write(payload, session->domain);
+	hfs_buf_literal(payload, "}");
+	err = payload->error ?: hfs_control(session, "VIEW_WAIT", payload, true, &reply);
+	if (err)
+		goto failed;
+	body = hfs_json_field(reply, 0, "payload");
+	event = hfs_json_field(reply, body, "event");
+	if (hfs_json_exact(reply, body, "event,status")) {
+		err = -EPROTO;
+		goto failed;
+	}
+	if (hfs_json_is(reply, hfs_json_field(reply, body, "status"), "\"EMPTY\"")) {
+		if (!hfs_json_is(reply, event, "null")) {
+			err = -EPROTO;
+			goto failed;
+		}
+		hfs_json_free(reply);
+		if (!READ_ONCE(control->stopping))
+			queue_delayed_work(control->poll_queue, &control->poll, msecs_to_jiffies(10));
+		return;
+	}
+	if (!hfs_json_is(reply, hfs_json_field(reply, body, "status"), "\"EVENT\"")) {
+		err = -EPROTO;
+		goto failed;
+	}
+	err = hfs_mmap_event_check(control->view, reply, event, &sequence, &recall);
+	if (err || sequence <= after) {
+		err = err ?: -ESTALE;
+		goto failed;
+	}
+	spin_lock_irqsave(&control->lock, flags);
+	control->pending[(control->head + control->count) % ARRAY_SIZE(control->pending)] = reply;
+	control->count++;
+	control->delivered = sequence;
+	spin_unlock_irqrestore(&control->lock, flags);
+	/* Repost the independent reserved VIEW_WAIT before any event ACK. */
+	if (!READ_ONCE(control->stopping)) {
+		queue_delayed_work(control->poll_queue, &control->poll, 0);
+		queue_delayed_work(control->event_queue, &control->events, 0);
+	}
+	return;
+failed:
+	/* The canonical unexpected response remains retained for inspection. */
+	if (reply) {
+		spin_lock_irqsave(&control->lock, flags);
+		control->pending[(control->head + control->count) % ARRAY_SIZE(control->pending)] = reply;
+		control->count++;
+		spin_unlock_irqrestore(&control->lock, flags);
+	}
+	hfs_mmap_fail(control, err);
+}
+
+static void hfs_mmap_pressure_work(struct work_struct *work);
+
+int hfs_mmap_start(struct hfs_view *view)
+{
+	struct hfs_mmap_control *control;
+	struct hfs_session *session = view->session;
+	unsigned long flags;
+	int err;
+
+	if (!session->bridge_minor || view->control ||
+	    (!view->target.len && view->phase != HFS_VIEW_UNBOUND))
+		return -EINVAL;
+	control = kzalloc(sizeof(*control), GFP_KERNEL);
+	if (!control)
+		return -ENOMEM;
+	/* Independent bounded control workspaces. Ticket/request credits cover
+	 * their own immutable sources; this covers envelopes/polls/ACK retention.
+	 */
+	if (session->bridge_minor == 4 &&
+	    session->enrollment.protocol_features == HFS_TERMINAL_FEATURES &&
+	    hfs_controlled_consumed(session)) {
+		/* Progress parents already charge event/ACK carriers, parsers and
+		 * retained Received owners. Charge the actual persistent actor
+		 * buffers here; tickets and dirty packages retain their charges.
+		 */
+		if (!session->control_completion || !session->retirement_completion) {
+			err = -ESTALE;
+			goto allocation;
+		}
+		err = session->provider->reserve(session,
+				sizeof(*control) + 16384ULL + 2ULL * HFS_BODY_MAX,
+				true, &control->credit);
+	} else {
+		err = session->provider->reserve(session,
+				sizeof(*control) + 32ULL * 1024 * 1024,
+				true, &control->credit);
+	}
+	if (err)
+		goto allocation;
+	control->view = hfs_view_get(session);
+	if (control->view != view) {
+		err = -ESTALE;
+		goto references;
+	}
+	if (hfs_buf_init(&control->poll_payload, 16384) ||
+	    hfs_buf_init(&control->ack, HFS_BODY_MAX) ||
+	    hfs_buf_init(&control->last_ack, HFS_BODY_MAX)) {
+		err = -ENOMEM;
+		goto buffers;
+	}
+	control->poll_queue = alloc_workqueue("9p-hfs-poll", WQ_UNBOUND | WQ_MEM_RECLAIM, 1);
+	control->event_queue = alloc_workqueue("9p-hfs-events", WQ_UNBOUND | WQ_MEM_RECLAIM, 1);
+	control->drain_queue = alloc_workqueue("9p-hfs-drains", WQ_UNBOUND | WQ_MEM_RECLAIM, 1);
+	control->cleanup_queue = alloc_workqueue("9p-hfs-cleanup", WQ_UNBOUND | WQ_MEM_RECLAIM, 1);
+	control->pressure_queue = alloc_workqueue("9p-hfs-pressure", WQ_UNBOUND | WQ_MEM_RECLAIM, 1);
+	if (!control->poll_queue || !control->event_queue ||
+	    !control->drain_queue || !control->cleanup_queue || !control->pressure_queue) {
+		err = -ENOMEM;
+		goto queues;
+	}
+	kref_init(&control->refs);
+	spin_lock_init(&control->lock);
+	INIT_LIST_HEAD(&control->cleanup);
+	INIT_DELAYED_WORK(&control->poll, hfs_mmap_poll);
+	INIT_DELAYED_WORK(&control->events, hfs_mmap_events);
+	INIT_DELAYED_WORK(&control->pressure, hfs_mmap_pressure_work);
+	INIT_DELAYED_WORK(&control->drained, hfs_mmap_drained);
+	INIT_WORK(&control->drains, hfs_mmap_drains);
+	spin_lock_irqsave(&view->lock, flags);
+	if (view->control || (view->phase != HFS_VIEW_LIVE && view->phase != HFS_VIEW_UNBOUND)) {
+		spin_unlock_irqrestore(&view->lock, flags);
+		err = -ESTALE;
+		goto queues;
+	}
+	view->control = control;
+	spin_unlock_irqrestore(&view->lock, flags);
+	queue_delayed_work(control->poll_queue, &control->poll, 0);
+	return 0;
+queues:
+	if (control->pressure_queue)
+		destroy_workqueue(control->pressure_queue);
+	if (control->cleanup_queue)
+		destroy_workqueue(control->cleanup_queue);
+	if (control->drain_queue)
+		destroy_workqueue(control->drain_queue);
+	if (control->event_queue)
+		destroy_workqueue(control->event_queue);
+	if (control->poll_queue)
+		destroy_workqueue(control->poll_queue);
+buffers:
+	hfs_buf_free(&control->poll_payload);
+	hfs_buf_free(&control->ack);
+	hfs_buf_free(&control->last_ack);
+references:
+	hfs_view_put(control->view);
+	session->provider->unreserve(session, control->credit);
+allocation:
+	kfree(control);
+	return err;
+}
+
+static void hfs_mmap_quiesce_control(struct hfs_mmap_control *control)
+{
+	cancel_delayed_work_sync(&control->poll);
+	cancel_delayed_work_sync(&control->events);
+	cancel_delayed_work_sync(&control->drained);
+	cancel_delayed_work_sync(&control->pressure);
+	flush_workqueue(control->drain_queue);
+	flush_workqueue(control->cleanup_queue);
+}
+
+int hfs_mmap_prepare_retire(struct hfs_view *view)
+{
+	struct hfs_mmap_control *control;
+	unsigned long flags;
+
+	spin_lock_irqsave(&view->lock, flags);
+	control = view->control;
+	if (!control) {
+		spin_unlock_irqrestore(&view->lock, flags);
+		return 0;
+	}
+	kref_get(&control->refs);
+	if (view->nr_cached || view->nr_dirty || view->nr_observations || view->active ||
+	    refcount_read(&control->refs.refcount) != 2) {
+		spin_unlock_irqrestore(&view->lock, flags);
+		hfs_mmap_control_put(control);
+		return -EBUSY;
+	}
+	/* Stop generating new transport cells before whole-session retirement
+	 * evidence is verified. Canonical events/ACKs/unknowns remain owned.
+	 * A failed/unknown retirement never silently reopens this old lifetime.
+	 */
+	view->phase = HFS_VIEW_FENCED;
+	WRITE_ONCE(control->stopping, true);
+	spin_unlock_irqrestore(&view->lock, flags);
+	wake_up_all(&view->wait);
+	hfs_mmap_quiesce_control(control);
+	hfs_mmap_control_put(control);
+	return 0;
+}
+
+/* This exact controlled terminal seam disposes joined, physically empty
+ * bookkeeping. It neither sets retired nor weakens generic STOP authority. */
+int hfs_mmap_terminal_prepare(struct hfs_view *view)
+{
+	struct hfs_session *session = view->session;
+	struct hfs_mmap_control *control;
+	unsigned long flags;
+	u32 i;
+	int err;
+
+	if (session->enrollment.protocol_features != HFS_TERMINAL_FEATURES || !session->closing ||
+	    !session->retained)
+		return -EACCES;
+	err = hfs_mmap_prepare_retire(view);
+	if (err)
+		return err;
+	spin_lock_irqsave(&view->lock, flags);
+	control = view->control;
+	if (view->active || view->nr_cached || view->nr_dirty || view->nr_dirty_packages ||
+	    view->nr_observations || view->nr_mappings || view->nr_grants ||
+	    refcount_read(&view->refs.refcount) != (control ? 3 : 2)) {
+		spin_unlock_irqrestore(&view->lock, flags);
+		return -EBUSY;
+	}
+	if (!control) {
+		view->phase = HFS_VIEW_FENCED;
+		spin_unlock_irqrestore(&view->lock, flags);
+		return 0;
+	}
+	kref_get(&control->refs);
+	spin_unlock_irqrestore(&view->lock, flags);
+	/* The real cancel/flush above joins every actor before inspecting these
+	 * private fields; an actor's extra reference or revealed event refuses. */
+	if (refcount_read(&control->refs.refcount) != 2 || control->error || !control->stopping ||
+	    control->count || control->have_recall || control->delivered != control->completed ||
+	    !list_empty(&control->cleanup) || (control->drain_event && !control->drained_acked)) {
+		err = -EBUSY;
+		goto out;
+	}
+	for (i = 0; i < ARRAY_SIZE(control->pending); i++)
+		if (control->pending[i]) {
+			err = -EBUSY;
+			goto out;
+		}
+	err = hfs_controlled_terminal_event_done(session, control->last_event, &control->last_ack,
+						 control->completed);
+	if (!err && control->drain_event)
+		err = hfs_received_exclusive(session, control->drain_event);
+	if (err)
+		goto out;
+	spin_lock_irqsave(&view->lock, flags);
+	if (view->control != control || refcount_read(&control->refs.refcount) != 2) {
+		spin_unlock_irqrestore(&view->lock, flags);
+		err = -EBUSY;
+		goto out;
+	}
+	view->control = NULL;
+	spin_unlock_irqrestore(&view->lock, flags);
+	destroy_workqueue(control->pressure_queue);
+	destroy_workqueue(control->cleanup_queue);
+	destroy_workqueue(control->drain_queue);
+	destroy_workqueue(control->event_queue);
+	destroy_workqueue(control->poll_queue);
+	hfs_json_free(control->last_event);
+	control->last_event = NULL;
+	hfs_json_free(control->drain_event);
+	control->drain_event = NULL;
+	hfs_mmap_control_put(control); /* actual owner */
+	err = 0;
+out:
+	hfs_mmap_control_put(control); /* this joined caller */
+	return err;
+}
+
+int hfs_mmap_stop(struct hfs_view *view)
+{
+	struct hfs_mmap_control *control;
+	unsigned long flags;
+	u32 i;
+
+	spin_lock_irqsave(&view->lock, flags);
+	control = view->control;
+	if (!control) {
+		spin_unlock_irqrestore(&view->lock, flags);
+		return 0;
+	}
+	kref_get(&control->refs); /* independent STOP caller lifetime */
+	/* A generic stop callback, disconnect and bare fence are insufficient.
+	 * Whole-session protected retirement is verified by the provider before
+	 * this flag; local physical/cache/source owners must already be gone.
+	 */
+	if (!view->session->retired || view->phase != HFS_VIEW_FENCED ||
+	    view->nr_cached || view->nr_dirty || view->active ||
+	    refcount_read(&control->refs.refcount) != 2) {
+		spin_unlock_irqrestore(&view->lock, flags);
+		hfs_mmap_control_put(control);
+		return -EBUSY;
+	}
+	WRITE_ONCE(control->stopping, true);
+	view->control = NULL;
+	spin_unlock_irqrestore(&view->lock, flags);
+	hfs_mmap_quiesce_control(control);
+	destroy_workqueue(control->pressure_queue);
+	destroy_workqueue(control->cleanup_queue);
+	destroy_workqueue(control->drain_queue);
+	destroy_workqueue(control->event_queue);
+	destroy_workqueue(control->poll_queue);
+	for (i = 0; i < ARRAY_SIZE(control->pending); i++)
+		hfs_json_free(control->pending[i]);
+	hfs_json_free(control->last_event);
+	hfs_json_free(control->drain_event);
+	hfs_mmap_control_put(control); /* owner removed under view lock */
+	hfs_mmap_control_put(control); /* this STOP caller */
+	return 0;
+}
+
+struct hfs_cache_cleanup {
+	struct list_head list;
+	struct delayed_work work;
+	struct hfs_mmap_control *control;
+	struct hfs_lease *lease;
+	struct list_head readers;
+	struct hfs_dirty *pending;
+	void *credit;
+	bool dirty_slot;
+};
+
+static void hfs_mmap_cleanup(struct work_struct *work)
+{
+	struct hfs_cache_cleanup *cleanup = container_of(to_delayed_work(work),
+						       struct hfs_cache_cleanup, work);
+	struct hfs_mmap_control *control = cleanup->control;
+	struct hfs_view *view = control->view;
+	struct hfs_session *session = view->session;
+	struct hfs_cache_grant *grant, *next;
+	struct hfs_dirty *dirty = cleanup->pending;
+	unsigned long flags;
+	int err;
+
+	if (READ_ONCE(control->error))
+		return; /* retained in control->cleanup with exact source ownership */
+	if (dirty && dirty->request) {
+		if (!dirty->reserve_ticket->bound || !dirty->reserve_ticket->admitted) {
+			err = hfs_dirty_resume_reserve(session, dirty, cleanup->lease);
+			if (err && err != -EAGAIN && err != -ECANCELED)
+				goto failed;
+		}
+		err = hfs_request_cancel_earmark(session, dirty->request);
+		if (err) {
+			if (err != -EAGAIN && err != -EBUSY)
+				goto failed;
+			/* Only actual old-epoch STOPPED exclusion/source closure can
+			 * cancel an issued unseen reservation. Its original preowned
+			 * RELEASE starts that recall without acquisition-family credit.
+			 */
+			err = hfs_lease_release(session, cleanup->lease);
+			if (err)
+				goto failed;
+			queue_delayed_work(control->cleanup_queue, &cleanup->work, msecs_to_jiffies(10));
+			return;
+		}
+		hfs_request_unhold(session, dirty->request);
+		dirty->request = NULL;
+	}
+	if (dirty) {
+		hfs_view_ticket_put(dirty->reserve_ticket);
+		hfs_view_ticket_put(dirty->freeze_ticket);
+		hfs_json_free(dirty->reservation);
+		hfs_json_free(dirty->frozen_entry);
+		hfs_buf_free(&dirty->freeze_payload);
+		hfs_buf_free(&dirty->drain_args);
+		session->provider->unreserve(session, dirty->credit);
+		kfree(dirty);
+		cleanup->pending = NULL;
+	}
+	if (cleanup->lease) {
+		err = hfs_lease_release(session, cleanup->lease);
+		if (err)
+			goto failed;
+		hfs_lease_free(cleanup->lease);
+		cleanup->lease = NULL;
+	}
+	list_for_each_entry_safe(grant, next, &cleanup->readers, list) {
+		err = hfs_lease_release(session, grant->lease);
+		if (err)
+			goto failed;
+		list_del(&grant->list);
+		hfs_lease_free(grant->lease);
+		session->provider->unreserve(session, grant->reservation);
+		kfree(grant);
+	}
+	if (cleanup->dirty_slot) {
+		spin_lock_irqsave(&view->lock, flags);
+		view->nr_dirty_packages--;
+		spin_unlock_irqrestore(&view->lock, flags);
+		cleanup->dirty_slot = false;
+	}
+	/* Exact protected floors, independently keyed full-Cred ticket families.
+	 * Neither routine invents a gap result or drops a held/uncertain row.
+	 */
+	hfs_retire(session);
+	hfs_view_retire(session);
+	spin_lock_irqsave(&control->lock, flags);
+	list_del(&cleanup->list);
+	spin_unlock_irqrestore(&control->lock, flags);
+	session->provider->unreserve(session, cleanup->credit);
+	kfree(cleanup);
+	hfs_mmap_control_put(control);
+	return;
+failed:
+	if (err == -EAGAIN || err == -EBUSY || err == -ENOSPC || err == -ENOMEM) {
+		queue_delayed_work(control->cleanup_queue, &cleanup->work, msecs_to_jiffies(10));
+		return;
+	}
+	hfs_mmap_fail(control, err);
+}
+
+static void hfs_mmap_dispose(struct hfs_cache_page *entry)
+{
+	struct hfs_cache_cleanup *cleanup = entry->cleanup;
+
+	/* kref destruction runs under arbitrary page/VFS context. Transfer only
+	 * preowned records; the independent worker performs every parked RPC.
+	 */
+	if (entry->lease)
+		cleanup->lease = entry->lease;
+	cleanup->dirty_slot = entry->dirty_slot;
+	list_splice_init(&entry->readers, &cleanup->readers);
+	queue_delayed_work(cleanup->control->cleanup_queue, &cleanup->work, 0);
+}
+
+static int hfs_mmap_prepare(struct hfs_view *view, const struct hfs_view_stamp *stamp,
+			    struct hfs_cache_page **out)
+{
+	struct hfs_cache_cleanup *cleanup;
+	struct hfs_mmap_control *control = hfs_mmap_control_get(view);
+	unsigned long flags;
+	int err;
+
+	*out = NULL;
+	if (!control)
+		return -ESTALE;
+	cleanup = kzalloc(sizeof(*cleanup), GFP_KERNEL);
+	if (!cleanup) {
+		err = -ENOMEM;
+		goto reference;
+	}
+	err = view->session->provider->reserve(view->session, sizeof(*cleanup), true, &cleanup->credit);
+	if (err)
+		goto allocation;
+	err = hfs_view_page_prepare(view, stamp, out);
+	if (err)
+		goto credit;
+	cleanup->control = control;
+	INIT_LIST_HEAD(&cleanup->list);
+	INIT_LIST_HEAD(&cleanup->readers);
+	INIT_DELAYED_WORK(&cleanup->work, hfs_mmap_cleanup);
+	spin_lock_irqsave(&control->lock, flags);
+	list_add_tail(&cleanup->list, &control->cleanup);
+	spin_unlock_irqrestore(&control->lock, flags);
+	(*out)->cleanup = cleanup;
+	(*out)->dispose = hfs_mmap_dispose;
+	return 0;
+credit:
+	view->session->provider->unreserve(view->session, cleanup->credit);
+allocation:
+	kfree(cleanup);
+reference:
+	hfs_mmap_control_put(control);
+	return err;
+}
+
+static int hfs_mmap_pressure(struct hfs_view *view)
+{
+	struct hfs_cache_page *entry;
+	struct hfs_observation *observation;
+	struct hfs_lease *lease = NULL;
+	unsigned long flags;
+	int err;
+
+	spin_lock_irqsave(&view->lock, flags);
+	list_for_each_entry(entry, &view->cache, list)
+		if (entry->lease && READ_ONCE(entry->lease->published) &&
+		    !READ_ONCE(entry->lease->released)) {
+			lease = entry->lease;
+			break;
+		}
+	if (!lease)
+		list_for_each_entry(observation, &view->observations, list)
+			if (observation->lease && !READ_ONCE(observation->lease->released)) {
+				lease = observation->lease;
+				break;
+			}
+	if (lease)
+		hfs_lease_get(lease);
+	spin_unlock_irqrestore(&view->lock, flags);
+	if (!lease)
+		return -EAGAIN;
+	/* No page, transition, PTE or physical admission token covers this wait.
+	 * The original lease has already reserved RELEASE identity/credit.
+	 */
+	err = hfs_lease_release(view->session, lease);
+	hfs_lease_free(lease);
+	return err;
+}
+
+static void hfs_mmap_pressure_work(struct work_struct *work)
+{
+	struct hfs_mmap_control *control = container_of(to_delayed_work(work),
+						       struct hfs_mmap_control, pressure);
+
+	if (!READ_ONCE(control->error) && !READ_ONCE(control->stopping))
+		hfs_mmap_pressure(control->view);
+	hfs_mmap_control_put(control); /* transferred by the successful queue */
+}
+
+void hfs_mmap_progress(struct hfs_session *session)
+{
+	struct hfs_view *view = hfs_view_get(session);
+	struct hfs_mmap_control *control;
+	unsigned long flags;
+	bool queued = false;
+
+	if (!view)
+		return;
+	control = hfs_mmap_control_get(view);
+	hfs_view_put(view);
+	if (!control)
+		return;
+	spin_lock_irqsave(&control->lock, flags);
+	if (!control->error && !control->stopping &&
+	    time_after_eq(jiffies, control->pressure_after)) {
+		control->pressure_after = jiffies + msecs_to_jiffies(100);
+		queued = queue_delayed_work(control->pressure_queue, &control->pressure, 0);
+	}
+	spin_unlock_irqrestore(&control->lock, flags);
+	if (!queued)
+		hfs_mmap_control_put(control);
+}
+
+static int hfs_mmap_read(struct hfs_session *session, struct hfs_description *description,
+			 const struct hfs_cred *cred, u64 offset, struct hfs_cache_page *entry)
+{
+	struct hfs_buf args;
+	struct hfs_json *result = NULL;
+	u64 count;
+	u32 actual, wanted;
+	int err;
+
+	err = hfs_buf_init(&args, 16384);
+	if (err)
+		return err;
+	entry->fill_length = 0;
+	memset(entry->fill, 0, sizeof(entry->fill));
+	/* A regular-file short read need not fill the requested range. Continue
+	 * at its exact offset; zero means EOF. No page/PTE lock covers these
+	 * source reads. A later exact target/revision grant rejects mixed cuts.
+	 */
+	while (entry->fill_length < sizeof(entry->fill)) {
+		wanted = sizeof(entry->fill) - entry->fill_length;
+		args.len = 0;
+		args.error = 0;
+		hfs_buf_printf(&args, "{\"count\":%u,\"description\":", wanted);
+		hfs_cap_write(&args, description->cap);
+		hfs_buf_printf(&args, ",\"offset\":%llu}", offset + entry->fill_length);
+		err = hfs_call(session, "READ", &args, cred, false, &result);
+		if (err)
+			break;
+		actual = wanted;
+		if (hfs_json_u64(result, hfs_json_field(result, 0, "count"), &count) || count > wanted ||
+		    hfs_json_hex(result, hfs_json_field(result, 0, "data"),
+				 entry->fill + entry->fill_length, &actual) || actual != count) {
+			err = -EPROTO;
+			break;
+		}
+		hfs_json_free(result);
+		result = NULL;
+		if (!count)
+			break;
+		entry->fill_length += count;
+	}
+	hfs_json_free(result);
+	hfs_buf_free(&args);
+	return err;
+}
+
+static vm_fault_t hfs_mmap_fault_error(struct hfs_view *view, int err)
+{
+	if (err == -ENOMEM)
+		return VM_FAULT_OOM;
+	if (err == -ENOSPC || err == -EAGAIN || err == -ESTALE ||
+	    err == -ERESTARTSYS || err == -EINTR) {
+		if (err == -ENOSPC)
+			hfs_mmap_pressure(view);
+		usleep_range(1000, 2000);
+		return VM_FAULT_NOPAGE;
+	}
+	return VM_FAULT_SIGBUS;
+}
+
+static vm_fault_t hfs_mmap_fault(struct vm_fault *vmf)
+{
+	struct file *file = vmf->vma->vm_file;
+	struct inode *inode = file_inode(file);
+	struct hfs_session *session = HFS_S(inode);
+	struct hfs_description *description = file->private_data;
+	struct hfs_view *view = hfs_view_get(session);
+	struct hfs_cache_page *entry = NULL, *existing;
+	struct hfs_cache_cleanup *cleanup;
+	struct hfs_cred *cred = NULL;
+	struct hfs_dirty *dirty = NULL;
+	struct hfs_lease *lease = NULL;
+	struct hfs_view_stamp stamp;
+	struct hfs_cache_grant *grant = NULL;
+	struct page *page = NULL;
+	void *cookie = NULL, *address;
+	u64 offset;
+	bool write = (vmf->flags & FAULT_FLAG_WRITE) && (vmf->vma->vm_flags & VM_SHARED);
+	bool attached = false, inserted = false;
+	vm_fault_t result;
+	int err;
+
+	if (!view || !description || !description->cap ||
+	    vmf->pgoff > ((S64_MAX - 4096) >> PAGE_SHIFT)) {
+		hfs_view_put(view);
+		return VM_FAULT_SIGBUS;
+	}
+	offset = (u64)vmf->pgoff << PAGE_SHIFT;
+	/* Legal dup/fork/transfer aliases may reuse their exact original grant.
+	 * Another Description must obtain its own actual protected READ lease.
+	 */
+	page = find_get_page(inode->i_mapping, vmf->pgoff);
+	if (page) {
+		lock_page(page);
+		if (PageUptodate(page) && page_mapping(page) == inode->i_mapping) {
+			err = hfs_view_page_enter(vmf->vma, page, write, &cookie);
+			if (!err) {
+				hfs_view_leave(cookie);
+				vmf->page = page;
+				hfs_view_put(view);
+				return VM_FAULT_LOCKED;
+			}
+		}
+		unlock_page(page);
+		put_page(page);
+		page = NULL;
+	}
+	err = hfs_view_enter(view, NULL, true, &cookie);
+	if (err)
+		goto failed;
+	hfs_view_leave(cookie);
+	cookie = NULL;
+	err = hfs_view_snapshot(view, &stamp);
+	if (err)
+		goto failed;
+	err = hfs_mmap_prepare(view, &stamp, &entry);
+	if (err)
+		goto failed;
+	cleanup = entry->cleanup;
+	err = hfs_view_capture(view, &stamp, &entry->target);
+	if (err || stamp.revision != entry->stamp.revision ||
+	    !uuid_equal(&stamp.generation, &entry->stamp.generation)) {
+		err = err ?: -ESTALE;
+		goto failed;
+	}
+	err = hfs_capture(session, &init_user_ns, &cred);
+	if (err)
+		goto failed;
+	err = hfs_mmap_read(session, description, cred, offset, entry);
+	if (err)
+		goto failed;
+	if (!entry->fill_length) {
+		err = -ENXIO; /* first byte beyond regular-file EOF */
+		goto failed;
+	}
+	err = hfs_lease_acquire(session, cred, NULL, description->cap,
+				offset, write, &entry->target, &lease);
+	if (err)
+		goto failed;
+	cleanup->lease = lease;
+	err = hfs_view_page_lease(entry, lease);
+	if (err)
+		goto failed;
+	if (write) {
+		err = hfs_dirty_reserve(session, entry, description->cap,
+					offset, entry->fill_length, &dirty);
+		cleanup->pending = dirty;
+		if (err)
+			goto failed;
+	}
+	page = find_get_page(inode->i_mapping, vmf->pgoff);
+	if (page && !write) {
+		/* Compatible readers can share bytes, but retain their distinct
+		 * exact Description leases for final PTE admission and recall.
+		 */
+		grant = kzalloc(sizeof(*grant), GFP_KERNEL);
+		if (!grant) {
+			err = -ENOMEM;
+			goto failed;
+		}
+		INIT_LIST_HEAD(&grant->list);
+		err = session->provider->reserve(session, sizeof(*grant), true, &grant->reservation);
+		if (err)
+			goto failed;
+		lock_page(page);
+		existing = hfs_view_page_find(view, page);
+		if (!existing || !PageUptodate(page) || page_mapping(page) != inode->i_mapping) {
+			if (existing)
+				hfs_view_page_put(existing);
+			unlock_page(page);
+			err = -ESTALE;
+			goto failed;
+		}
+		grant->lease = entry->lease;
+		err = hfs_view_page_grant(existing, grant, entry);
+		hfs_view_page_put(existing);
+		if (err) {
+			grant->lease = NULL;
+			unlock_page(page);
+			goto failed;
+		}
+		cleanup->lease = NULL;
+		grant = NULL;
+		vmf->page = page;
+		hfs_cred_free(cred);
+		hfs_view_page_put(entry);
+		hfs_view_put(view);
+		return VM_FAULT_LOCKED;
+	}
+	if (page) {
+		err = -ESTALE; /* conflicting write recall invalidated the old epoch */
+		goto failed;
+	}
+	page = alloc_page(GFP_HIGHUSER | __GFP_ZERO);
+	if (!page) {
+		err = -ENOMEM;
+		goto failed;
+	}
+	lock_page(page);
+	err = hfs_view_enter(view, &entry->stamp, false, &cookie);
+	if (err)
+		goto unlock;
+	/* NOFS excludes recursive filesystem reclaim/recall while this bounded
+	 * physical token joins cache attachment and immutable dirty adoption.
+	 */
+	err = add_to_page_cache_lru(page, inode->i_mapping, vmf->pgoff, GFP_NOFS);
+	if (err)
+		goto unlock;
+	inserted = true;
+	address = kmap_local_page(page);
+	memcpy(address, entry->fill, sizeof(entry->fill));
+	kunmap_local(address);
+	SetPageUptodate(page);
+	err = hfs_view_page_attach(entry, page);
+	if (err)
+		goto unlock;
+	attached = true;
+	if (dirty) {
+		err = hfs_view_adopt_dirty(view, entry, dirty);
+		if (err)
+			goto unlock;
+		cleanup->pending = NULL; /* adopted registry now owns this obligation */
+	}
+	hfs_view_leave(cookie);
+	cookie = NULL;
+	vmf->page = page;
+	hfs_cred_free(cred);
+	hfs_view_page_put(entry); /* private + adopted registry retain resources */
+	hfs_view_put(view);
+	return VM_FAULT_LOCKED;
+unlock:
+	hfs_view_leave(cookie);
+	cookie = NULL;
+	if (inserted)
+		delete_from_page_cache(page);
+	unlock_page(page);
+failed:
+	if (page)
+		put_page(page);
+	if (grant) {
+		if (grant->reservation)
+			session->provider->unreserve(session, grant->reservation);
+		kfree(grant);
+	}
+	if (entry) {
+		/* Cache-removal callbacks detach private ownership; an adopted
+		 * dirty obligation can never take this failure path after exposure.
+		 */
+		WARN_ON_ONCE(attached && entry->page);
+		hfs_view_page_put(entry);
+	}
+	hfs_cred_free(cred);
+	result = hfs_mmap_fault_error(view, err);
+	hfs_view_put(view);
+	return result;
+}
+
+static vm_fault_t hfs_mmap_mkwrite(struct vm_fault *vmf)
+{
+	struct hfs_view *view = hfs_view_get(HFS_S(file_inode(vmf->vma->vm_file)));
+	void *cookie = NULL;
+	int err;
+	vm_fault_t result;
+
+	if (!view)
+		return VM_FAULT_SIGBUS;
+	lock_page(vmf->page);
+	err = hfs_view_page_enter(vmf->vma, vmf->page, true, &cookie);
+	if (!err) {
+		hfs_view_leave(cookie);
+		hfs_view_put(view);
+		return VM_FAULT_LOCKED;
+	}
+	unlock_page(vmf->page);
+	/* Upgrade the original read-only mapping by recalling its old epoch.
+	 * Never replace vmf->page: do_page_mkwrite holds a reference to that
+	 * exact page. Its next ordinary write fault obtains an EXCLUSIVE_DIRTY
+	 * lease and full reservation before a new writable PTE can be installed.
+	 */
+	err = hfs_mmap_pressure(view);
+	result = !err ? VM_FAULT_NOPAGE : hfs_mmap_fault_error(view, err);
+	hfs_view_put(view);
+	return result;
+}
+
+static const struct vm_operations_struct hfs_mmap_ops = {
+	.fault = hfs_mmap_fault,
+	.page_mkwrite = hfs_mmap_mkwrite,
+	.cache_begin = hfs_view_page_enter,
+	.cache_end = hfs_view_leave,
+	.no_gup = true,
+};
+
+int hfs_mmap_file(struct file *file, struct vm_area_struct *vma)
+{
+	struct inode *inode = file_inode(file);
+	struct hfs_session *session = HFS_S(inode);
+	struct hfs_description *description = file->private_data;
+	struct hfs_view *view = hfs_view_get(session);
+	struct hfs_mmap_control *control;
+	int err;
+
+	if (!view || !description || !description->cap || !S_ISREG(inode->i_mode) ||
+	    PAGE_SIZE != 4096 || !(description->cap->rights & 1) ||
+	    ((vma->vm_flags & VM_SHARED) && (vma->vm_flags & VM_WRITE) &&
+	     !(description->cap->rights & 2))) {
+		hfs_view_put(view);
+		return -EACCES;
+	}
+	control = hfs_mmap_control_get(view);
+	if (!control) {
+		hfs_view_put(view);
+		return -ESTALE;
+	}
+	err = READ_ONCE(session->blocked) || READ_ONCE(control->error) ? -EHOSTDOWN :
+		hfs_view_register_inode(inode);
+	if (!err) {
+		/* The common MM check also refuses THP even if MADV_HUGEPAGE
+		 * later clears this hint; executable and private COW stay legal.
+		 */
+		vma->vm_flags |= VM_NOHUGEPAGE;
+		vma->vm_ops = &hfs_mmap_ops;
+		file_accessed(file);
+	}
+	hfs_mmap_control_put(control);
+	hfs_view_put(view);
+	return err;
+}
+
+int hfs_mmap_sync(struct file *file)
+{
+	struct hfs_view *view = hfs_view_get(HFS_S(file_inode(file)));
+	unsigned long flags;
+	bool dirty;
+	int err = 0, writeback;
+
+	if (!view)
+		return -ESTALE;
+	spin_lock_irqsave(&view->lock, flags);
+	dirty = view->nr_dirty != 0;
+	spin_unlock_irqrestore(&view->lock, flags);
+	if (dirty)
+		err = hfs_mmap_pressure(view);
+	/* Includes terminal short/error drains; never erase them with a later
+	 * successful metadata SYNC. Standard errseq is per open file reference.
+	 */
+	writeback = file_check_and_advance_wb_err(file);
+	hfs_view_put(view);
+	return writeback ?: err;
+}
+
+int hfs_mmap_bootstrap(struct hfs_session *session, const struct hfs_cred *cred)
+{
+	struct hfs_view *view;
+	struct hfs_mmap_control *control;
+	struct hfs_cache_cleanup *cleanup;
+	struct hfs_lease *lease = NULL;
+	unsigned long flags, deadline = jiffies + 30 * HZ;
+	int err;
+
+	err = hfs_view_new_unbound(session);
+	if (err)
+		return err;
+	view = hfs_view_get(session);
+	if (!view)
+		return -ESTALE;
+	err = hfs_mmap_start(view);
+	if (err)
+		goto view;
+	control = hfs_mmap_control_get(view);
+	if (!control) {
+		err = -ESTALE;
+		goto view;
+	}
+	cleanup = kzalloc(sizeof(*cleanup), GFP_KERNEL);
+	if (!cleanup) {
+		err = -ENOMEM;
+		goto reference;
+	}
+	err = session->provider->reserve(session, sizeof(*cleanup), true, &cleanup->credit);
+	if (err) {
+		kfree(cleanup);
+		goto reference;
+	}
+	cleanup->control = control;
+	INIT_LIST_HEAD(&cleanup->list);
+	INIT_LIST_HEAD(&cleanup->readers);
+	INIT_DELAYED_WORK(&cleanup->work, hfs_mmap_cleanup);
+	spin_lock_irqsave(&control->lock, flags);
+	list_add_tail(&cleanup->list, &control->cleanup);
+	spin_unlock_irqrestore(&control->lock, flags);
+	for (;;) {
+		/* The issuer selects/verifies an actual cut. An empty unbound
+		 * domain is already polling and can close a necessary first recall.
+		 */
+		err = hfs_lease_acquire(session, cred, NULL, NULL, 0, false, NULL, &lease);
+		if (err)
+			break;
+		cleanup->lease = lease;
+		err = hfs_view_bind_initial(view, lease);
+		if (err && err != -ESTALE && err != -EAGAIN)
+			break;
+		/* This discovery lease was never cache/PTE authority. Its actual
+		 * original release can still start an empty verified recall.
+		 */
+		if (hfs_lease_release(session, lease)) {
+			err = -EAGAIN;
+			break;
+		}
+		hfs_lease_free(lease);
+		cleanup->lease = NULL;
+		lease = NULL;
+		if (!err || time_after_eq(jiffies, deadline))
+			break;
+	}
+	/* The preowned packet retains any uncertain lease/release evidence and
+	 * its original issuer; no stack pointer or mount caller lifetime escapes.
+	 */
+	queue_delayed_work(control->cleanup_queue, &cleanup->work, 0);
+	hfs_view_put(view);
+	return err;
+reference:
+	hfs_mmap_control_put(control);
+view:
+	hfs_view_put(view);
+	return err;
+}
+
+int hfs_mmap_begin(struct inode *inode, bool mutation, const struct hfs_cred *cred,
+		    void *native_cookie, void **cookie)
+{
+	struct hfs_session *session = HFS_S(inode);
+	struct hfs_view *view = hfs_view_get(session);
+	struct hfs_mmap_control *control;
+	struct hfs_observation *observation;
+	struct hfs_cache_cleanup *cleanup;
+	unsigned long flags;
+	void *physical = NULL;
+	int err;
+
+	*cookie = NULL;
+	if (!view)
+		return -ESTALE;
+	control = hfs_mmap_control_get(view);
+	if (!control) {
+		err = -ESTALE;
+		goto view;
+	}
+	observation = kzalloc(sizeof(*observation), GFP_KERNEL);
+	cleanup = kzalloc(sizeof(*cleanup), GFP_KERNEL);
+	if (!observation || !cleanup) {
+		err = -ENOMEM;
+		goto allocation;
+	}
+	err = session->provider->reserve(session,
+			sizeof(*observation) + sizeof(*cleanup) + HFS_TARGET_MAX, true, &cleanup->credit);
+	if (err)
+		goto allocation;
+	err = hfs_buf_init(&observation->target, HFS_TARGET_MAX);
+	if (err)
+		goto credit;
+	observation->view = view;
+	observation->native_cookie = native_cookie;
+	observation->cleanup = cleanup;
+	INIT_LIST_HEAD(&observation->list);
+	INIT_LIST_HEAD(&cleanup->list);
+	INIT_LIST_HEAD(&cleanup->readers);
+	cleanup->control = control;
+	INIT_DELAYED_WORK(&cleanup->work, hfs_mmap_cleanup);
+	spin_lock_irqsave(&control->lock, flags);
+	list_add_tail(&cleanup->list, &control->cleanup);
+	spin_unlock_irqrestore(&control->lock, flags);
+	err = hfs_view_enter(view, NULL, true, &physical);
+	if (err)
+		goto retained;
+	hfs_view_leave(physical);
+	err = hfs_view_capture(view, &observation->stamp, &observation->target);
+	if (err)
+		goto retained;
+	if (!mutation) {
+		err = hfs_lease_acquire(session, cred, NULL, NULL, 0, false,
+					&observation->target, &observation->lease);
+		cleanup->lease = observation->lease;
+		if (err)
+			goto retained;
+	}
+	spin_lock_irqsave(&view->lock, flags);
+	if (view->phase != HFS_VIEW_LIVE ||
+	    view->revision != observation->stamp.revision ||
+	    !uuid_equal(&view->generation, &observation->stamp.generation) ||
+	    (observation->lease && memcmp(view->target_hash, observation->lease->target_hash, 32))) {
+		err = -ESTALE;
+	} else if (view->nr_observations == HFS_IDENTITIES_MAX) {
+		err = -ENOSPC;
+	} else {
+		list_add_tail(&observation->list, &view->observations);
+		view->nr_observations++;
+		if (observation->lease)
+			WRITE_ONCE(observation->lease->published, true);
+	}
+	spin_unlock_irqrestore(&view->lock, flags);
+	if (err)
+		goto retained;
+	*cookie = observation;
+	/* The packet's control reference owns view/module/session lifetime. */
+	hfs_view_put(view);
+	return 0;
+retained:
+	queue_delayed_work(control->cleanup_queue, &cleanup->work, 0);
+	hfs_buf_free(&observation->target);
+	kfree(observation);
+	hfs_view_put(view);
+	return err;
+credit:
+	session->provider->unreserve(session, cleanup->credit);
+allocation:
+	kfree(observation);
+	kfree(cleanup);
+	hfs_mmap_control_put(control);
+view:
+	hfs_view_put(view);
+	return err;
+}
+
+void hfs_mmap_end(void *cookie)
+{
+	struct hfs_observation *observation = cookie;
+	struct hfs_cache_cleanup *cleanup;
+	struct hfs_view *view;
+	unsigned long flags;
+
+	if (!observation)
+		return;
+	view = observation->view;
+	cleanup = observation->cleanup;
+	spin_lock_irqsave(&view->lock, flags);
+	list_del(&observation->list);
+	view->nr_observations--;
+	/* DOMAIN observations install only under separately stamped short MM
+	 * tokens. No PTE is authorized by this lease. Closing its last observer
+	 * excludes every future use; cached dentries revalidate through RPC and
+	 * attributes never become timeless pathname permission.
+	 */
+	if (observation->lease)
+		WRITE_ONCE(observation->lease->revoked, true);
+	spin_unlock_irqrestore(&view->lock, flags);
+	view->session->provider->leave(view->session, observation->native_cookie);
+	hfs_buf_free(&observation->target);
+	kfree(observation);
+	queue_delayed_work(cleanup->control->cleanup_queue, &cleanup->work, 0);
+}
