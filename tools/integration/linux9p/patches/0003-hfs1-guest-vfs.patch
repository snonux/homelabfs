Subject: 9p: bind guest VFS requests to immutable credentials, claims and grants

Base-commit: 79807e970724c1f90cee1316361d61b80db4eef6
Owned integration patch; no installation or runtime admission.

diff --git a/fs/9p/Kconfig b/fs/9p/Kconfig
--- a/fs/9p/Kconfig
+++ b/fs/9p/Kconfig
@@ -43,3 +43,39 @@
 
 	  If you are not using a security module that requires using
 	  extended attributes for file security labels, say N.
+
+config 9P_FS_HOMELABFS
+	bool "HomelabFS retained-9p guest integration"
+	depends on 9P_FS && TRACEPOINTS && X86_64 && 64BIT
+	select CRYPTO_LIB_SHA256
+	help
+	  Build the separately versioned 9P2000.L.hfs1 guest adapter. This
+	  requires an exact enrolled provider for authority, namespace maps,
+	  aggregate credits, protected claims and physical view-token recalls.
+	  Without that provider mounting this profile fails before transport.
+	  This option supplies no normal serving or installed-artifact admission.
+	  Stock 9p mounts retain their existing behavior. If unsure, say N.
+
+config 9P_FS_HOMELABFS_CONTROLLED
+	bool "HomelabFS boot-owned controlled-local guest provider"
+	depends on 9P_FS_HOMELABFS && 9P_FS=y && NET_9P_VIRTIO=y
+	depends on SYSFS && SYSCTL && CC_IS_GCC
+	default n
+	help
+	  Build the explicitly provisioned1.4 guest provider into this kernel.
+	  Requires signed operator/endpoint artifacts, actual virtio/superblock
+	  binding, private transported receipts and physical view barriers.
+	  The boot-owned registry has no unload/reset operation. Missing credits,
+	  source evidence or continuity refuses admission. C7 protected retirement
+	  remains required before runtime readiness; no normal publication is added.
+	  GCC and the exact owned crypto compilation flags are mandatory. If
+	  unsure, say N. Existing profiles and stock mounts keep their behavior.
+
+config 9P_FS_HOMELABFS_OPERATOR_KEY
+	string "Pinned controlled-local operator Ed25519 public key (64 hex chars)"
+	depends on 9P_FS_HOMELABFS_CONTROLLED
+	default ""
+	help
+	  Pin the exact32-byte operator public key in this admitted kernel artifact.
+	  Empty, malformed or unsupported point encodings refuse provider startup.
+	  This is not an endpoint key selector or a normal-serving permission.
diff --git a/fs/9p/Makefile b/fs/9p/Makefile
--- a/fs/9p/Makefile
+++ b/fs/9p/Makefile
@@ -15,3 +15,20 @@
 
 9p-$(CONFIG_9P_FSCACHE) += cache.o
 9p-$(CONFIG_9P_FS_POSIX_ACL) += acl.o
+
+9p-$(CONFIG_9P_FS_HOMELABFS) += hfs_protocol.o hfs_policy.o hfs_session.o \
+	hfs_inode.o hfs_file.o hfs_cursor.o hfs_view.o hfs_lease.o hfs_mmap.o
+
+9p-$(CONFIG_9P_FS_HOMELABFS_CONTROLLED) += hfs_crypto_core.o \
+	hfs_crypto_ed25519.o hfs_enrollment.o hfs_admission.o \
+	hfs_controlled_artifacts.o hfs_controlled.o
+
+# Unchanged upstream crypto is compiled only through these owned wrappers.
