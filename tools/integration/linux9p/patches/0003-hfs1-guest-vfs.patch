diff --git a/fs/9p/hfs_session.c b/fs/9p/hfs_session.c
new file mode 100644
--- /dev/null
+++ b/fs/9p/hfs_session.c
@@ -0,0 +1,3986 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Owned retained-9p guest session, request and credential lifetimes. */
+#include "hfs.h"
+#include "hfs_controlled.h"
+#include "hfs_received.h"
+#include <linux/delay.h>
+#include <linux/magic.h>
+#include <linux/mount.h>
+#include <linux/sched/signal.h>
+#include <linux/seq_file.h>
+#include <linux/slab.h>
+#include <linux/sort.h>
+#include <linux/statfs.h>
+#include <linux/user_namespace.h>
+#include <linux/vmalloc.h>
+#include <net/9p/9p.h>
+#include <trace/events/sched.h>
+
+static DEFINE_MUTEX(hfs_provider_lock);
+static const struct hfs_provider *hfs_provider;
+static LIST_HEAD(hfs_sessions);
+static DEFINE_SPINLOCK(hfs_sessions_lock);
+static bool hfs_trace_registered;
+static struct tracepoint *hfs_exit_tracepoint;
+static atomic_t hfs_active_sessions = ATOMIC_INIT(0);
+
+static int hfs_field_u64(const struct hfs_json *json, int object,
+			 const char *key, u64 *value)
+{
+	return hfs_json_u64(json, hfs_json_field(json, object, key), value);
+}
+
+int hfs_uuid(const struct hfs_json *json, int token, uuid_t *id)
+{
+	return hfs_policy_uuid(json, token, id);
+}
+
+void hfs_cred_write(struct hfs_buf *buf, const struct hfs_cred *cred)
+{
+	u32 i;
+
+	hfs_buf_printf(buf, "{\"credential_revision\":%llu,\"fsgid\":%u,"
+		       "\"fsuid\":%u,\"groups\":[", cred->revision,
+		       cred->gid, cred->uid);
+	for (i = 0; i < cred->ngroups; i++)
+		hfs_buf_printf(buf, "%s%u", i ? "," : "", cred->groups[i]);
+	hfs_buf_literal(buf, "],\"idmap_hash\":");
+	hfs_buf_hex(buf, cred->idmap_hash, 32);
+	hfs_buf_printf(buf, ",\"process\":\"%pUb\",\"user_namespace\":\"%pUb\"}",
+		       &cred->process, &cred->user_namespace);
+}
+
+void hfs_cred_free(struct hfs_cred *cred)
+{
+	if (cred) {
+		put_cred(cred->native);
+		kfree(cred);
+	}
+}
+
+static void hfs_process_exit_work(struct work_struct *work)
+{
+	struct hfs_process *process = container_of(work, struct hfs_process,
+						 exit_work);
+	struct hfs_session *session = process->session;
+	struct hfs_buf args;
+	struct hfs_json *result = NULL;
+	int err;
+
+	err = hfs_args_init(&args);
+	if (!err) {
+		hfs_buf_printf(&args, "{\"exit_sequence\":1,\"process\":\"%pUb\"}",
+			       &process->id);
+		err = hfs_call(session, "PROCESS_EXIT", &args, process->last,
+			       true, &result);
+	}
+	if (err)
+		hfs_session_block(session, "process-exit failure", "PROCESS_EXIT", err);
+	hfs_json_free(result);
+	hfs_buf_free(&args);
+}
+
+/* hh4: queue the session's abandon_work, at most once per session. Only a
+ * controlled-capable session (minor >= 2, the hosts that know ABANDON or
+ * refuse it before any host state) with its control queue queues it.
+ * Nothing is sent here: hfs_session_block runs with locks held and from
+ * inside exchanges, and queue_work is safe there. A request that is skipped
+ * by the worker (a caller still uses it) is picked up by kill_sb's final
+ * pass, not by a second queueing.
+ */
+static void hfs_session_abandon_queue(struct hfs_session *session)
+{
+	if (session->bridge_minor < 2 || !session->control ||
+	    test_and_set_bit(HFS_ABANDON_QUEUED, &session->block_reported))
+		return;
+	queue_work(session->control, &session->abandon_work);
+}
+
+/* 5f4: wake the view waits parked on session->stop_wait after a stop was
+ * set (blocked, closing, transport_failed). The flag is written first. The
+ * waiter never takes the stop_wait lock to check its condition, so that
+ * lock does not order anything here: the wake-up (try_to_wake_up) has a
+ * full barrier before it reads the waiter's task state, which pairs with
+ * the barrier in the waiter's set_current_state (wait_event sets its task
+ * state, then checks the condition). Either the waiter sees the flag, or
+ * the wake-up sees it sleeping and wakes it, so the stop is never missed.
+ * Safe in any context and under any lock except stop_wait's own and the
+ * scheduler's (pi_lock, rq lock), which try_to_wake_up takes.
+ */
+void hfs_session_stop_wake(struct hfs_session *session)
+{
+	wake_up_all(&session->stop_wait);
+}
+
+/* 5f4: set session->blocked and wake the view waits that wait for it. Every
+ * writer of blocked goes through here, or wakes after its writes
+ * (hfs_mount_fail, kill_sb).
+ */
+void hfs_session_mark_blocked(struct hfs_session *session)
+{
+	WRITE_ONCE(session->blocked, true);
+	hfs_session_stop_wake(session);
+}
+
+/* Mark the session blocked and log why, once per session (g64).
+ *
+ * A blocked session refuses every later capture with EACCES and every
+ * ordinary request with EHOSTDOWN, without any further message. zq3-r7 R7-2
+ * was invisible in dmesg for that reason: the guest gave up on a QUERY, every
+ * later operation on the mount (including getattr on its root) returned
+ * EACCES and nothing said why. The first fault therefore names its reason,
+ * the operation and errno, and the enrolled session UUID; later blocks of the
+ * same session stay silent, so a retained session cannot flood the log. The
+ * first reason is normally the root cause: a caller whose hfs_call failed
+ * because hfs_request_run already blocked the session adds nothing.
+ *
+ * The line is a plain pr_warn, not ratelimited (m64). The once bit is set
+ * before printing, so a ratelimited printk that dropped the line (another
+ * 9p-hfs warning in the same burst is enough) would have lost this
+ * session's only explanation for good. The bit already bounds the output to
+ * one line per session, and only root mounts create sessions, so the global
+ * ratelimit adds no protection here.
+ *
+ * Since m64 the view/lease faults (patch 0004) also come through here, and
+ * the controlled stop and retain fences (patch 0005) through
+ * hfs_session_fence. kill_sb logs a failed close or stop here; a failed
+ * mount and the close/release sequence-wrap guards still set the flag
+ * directly (a retained failed mount reaches the retain fence, which logs),
+ * and hfs_mmap_fail logs the view control worker stop with its own once bit
+ * (session, step, host event/ACK phase and reply status, view phase and
+ * recall; 1a4). Its bit is separate, so a later block of the same session
+ * still logs its own line.
+ *
+ * Since oc4 both lines also print the raw reason of the last exporter ERROR
+ * reply the session failed on ("exporter ERROR 5" for UNAVAILABLE, "-" for
+ * none): zq3-r12 R12-1's "(-71)" did not show that the exporter had
+ * answered ERROR because the host transport was down. It is the session's
+ * latest ERROR, which is normally the exchange that caused the block.
+ *
+ * Since hh4 the first block also queues the ABANDON of the session's
+ * stranded never-prepared claims (hfs_session_abandon_queue), so the host
+ * can return their credit. A clean unmount blocks silently through
+ * hfs_session_fence and does not get here; kill_sb runs that pass itself.
+ */
+void hfs_session_block(struct hfs_session *session, const char *reason,
+		       const char *operation, int err)
+{
+	u16 code = READ_ONCE(session->exporter_error);
+	char text[8] = "-";
+
+	hfs_session_mark_blocked(session); /* 5f4: wakes hfs_view_reopen_wait */
+	hfs_session_abandon_queue(session);
+	if (test_and_set_bit(0, &session->block_reported))
+		return;
+	if (code)
+		snprintf(text, sizeof(text), "%u", code);
+	pr_warn("9p-hfs: session %pUb blocked by %s on %s (%d), exporter ERROR %s; later operations on this mount fail with EACCES or EHOSTDOWN\n",
+		&session->enrollment.session, reason,
+		operation ? operation : "-", err, text);
+}
+
+/* A provider stop/retain fence. During kill_sb (session->unmounting) it is
+ * the expected close of a clean unmount: the flag is set silently and the
+ * once bit stays clear, so zq3 dmesg evidence shows no fault for it and a
+ * later real fault (a failed stop) still logs. Anywhere else, e.g. retaining
+ * after a failed mount, it is logged like any other block (m64 review).
+ */
+void hfs_session_fence(struct hfs_session *session, const char *reason,
+		       const char *operation)
+{
+	if (READ_ONCE(session->unmounting)) {
+		hfs_session_mark_blocked(session);
+		return;
+	}
+	hfs_session_block(session, reason, operation, 0);
+}
+
+/* Non-sleeping trace hook: all work and credentials were reserved at capture.
+ */
+static void hfs_process_exit(void *unused, struct task_struct *task)
+{
+	struct hfs_session *session;
+	struct hfs_process *process;
+	unsigned long flags;
+
+	if (atomic_read(&task->signal->live))
+		return;
+	spin_lock_irqsave(&hfs_sessions_lock, flags);
+	list_for_each_entry(session, &hfs_sessions, global) {
+		spin_lock(&session->processes_lock);
+		list_for_each_entry(process, &session->processes, list) {
+			if (process->pid == task_tgid(task) &&
+			    atomic_cmpxchg(&process->exited, 0, 1) == 0)
+				queue_work(session->control, &process->exit_work);
+		}
+		spin_unlock(&session->processes_lock);
+	}
+	spin_unlock_irqrestore(&hfs_sessions_lock, flags);
+}
+
+static void hfs_find_exit_tracepoint(struct tracepoint *tracepoint, void *data)
+{
+	struct tracepoint **found = data;
+
+	if (!strcmp(tracepoint->name, "sched_process_exit"))
+		*found = tracepoint;
+}
+
+/* Complete mapped numeric snapshot; native cred pointer identity is not an
+ * exported credential epoch. Only observed changes advance the monotone epoch.
+ */
+static bool hfs_cred_equal(const struct hfs_cred *a, const struct hfs_cred *b)
+{
+	return a && b && a->uid == b->uid && a->gid == b->gid &&
+		a->ngroups == b->ngroups &&
+		!memcmp(a->groups, b->groups, a->ngroups * sizeof(a->groups[0])) &&
+		uuid_equal(&a->user_namespace, &b->user_namespace) &&
+		!memcmp(a->idmap_hash, b->idmap_hash, sizeof(a->idmap_hash));
+}
+
+/* Caller holds processes_lock. Entries live until protected session teardown.
+ */
+static struct hfs_process *hfs_process_find(struct hfs_session *session, struct pid *pid)
+{
+	struct hfs_process *process;
+
+	list_for_each_entry(process, &session->processes, list)
+		if (process->pid == pid)
+			return process;
+	return NULL;
+}
+
+static int hfs_capture_owned(struct hfs_session *session, struct user_namespace *mnt_userns,
+			     struct hfs_cred **out, bool terminal)
+{
+	struct hfs_cred *snapshot = NULL, *last = NULL, *displaced = NULL;
+	struct hfs_process *process, *candidate = NULL;
+	const struct cred *cred;
+	unsigned long flags;
+	u32 i;
+	int err;
+
+	*out = NULL;
+	/* Asynchronous workers must carry an already captured snapshot. */
+	if ((current->flags & PF_KTHREAD) || current_cred() != current_real_cred() ||
+	    READ_ONCE(session->blocked) || READ_ONCE(session->closing))
+		return -EACCES;
+	cred = get_current_cred();
+	if (cred->group_info->ngroups > HFS_GROUPS_MAX) {
+		put_cred(cred);
+		return -E2BIG;
+	}
+	snapshot = kzalloc(sizeof(*snapshot), GFP_KERNEL);
+	last = kzalloc(sizeof(*last), GFP_KERNEL);
+	if (!snapshot || !last) {
+		err = -ENOMEM;
+		goto fail;
+	}
+	snapshot->native = cred;
+	snapshot->uid = from_kuid(&init_user_ns, cred->fsuid);
+	snapshot->gid = from_kgid(&init_user_ns, cred->fsgid);
+	if (!uid_valid(cred->fsuid) || !gid_valid(cred->fsgid) || snapshot->uid == U32_MAX ||
+	    snapshot->gid == U32_MAX) {
+		err = -EOVERFLOW;
+		goto fail;
+	}
+	for (i = 0; i < cred->group_info->ngroups; i++) {
+		kgid_t group = cred->group_info->gid[i];
+
+		if (!gid_valid(group)) {
+			err = -EOVERFLOW;
+			goto fail;
+		}
+		snapshot->groups[i] = from_kgid(&init_user_ns, group);
+		if (snapshot->groups[i] == U32_MAX) {
+			err = -EOVERFLOW;
+			goto fail;
+		}
+	}
+	err = hfs_groups_snapshot(snapshot->groups, cred->group_info->ngroups, snapshot->groups,
+				  &snapshot->ngroups);
+	if (err)
+		goto fail;
+	err = session->provider->map(session, cred, mnt_userns, &snapshot->user_namespace,
+				     snapshot->idmap_hash);
+	err = hfs_identity_validate(snapshot->uid, snapshot->gid, &snapshot->user_namespace, err);
+	if (err)
+		goto fail;
+	spin_lock_irqsave(&session->processes_lock, flags);
+	process = hfs_process_find(session, task_tgid(current));
+	spin_unlock_irqrestore(&session->processes_lock, flags);
+	if (!process) {
+		candidate = kzalloc(sizeof(*candidate), GFP_KERNEL);
+		if (!candidate) {
+			err = -ENOMEM;
+			goto fail;
+		}
+		/* One cached numeric copy and bounded native reference allowance
+     * per retained process, independently of caller-owned snapshots.
+     * Existing-process captures need no duplicate cache admission.
+     */
+		if (terminal)
+			err = hfs_completion_reserve(
+				session->terminal_completion,
+				sizeof(*candidate) + sizeof(*last) + sizeof(struct cred) +
+					sizeof(struct group_info) +
+					HFS_GROUPS_MAX * sizeof(kgid_t) + sizeof(struct pid) +
+					sizeof(struct user_namespace),
+				false, &candidate->reservation);
+		else
+			err = session->provider->reserve(
+				session,
+				sizeof(*candidate) + sizeof(*last) + sizeof(struct cred) +
+					sizeof(struct group_info) +
+					HFS_GROUPS_MAX * sizeof(kgid_t) + sizeof(struct pid) +
+					sizeof(struct user_namespace),
+				true, &candidate->reservation);
+		if (err)
+			goto fail;
+		candidate->pid = get_pid(task_tgid(current));
+		uuid_gen(&candidate->id);
+		candidate->session = session;
+		INIT_WORK(&candidate->exit_work, hfs_process_exit_work);
+	}
+	spin_lock_irqsave(&session->processes_lock, flags);
+	process = hfs_process_find(session, task_tgid(current));
+	if (!process) {
+		if (session->nr_processes == HFS_IDENTITIES_MAX) {
+			err = -ENOSPC;
+			goto unlock;
+		}
+		process = candidate;
+		candidate = NULL;
+		list_add_tail(&process->list, &session->processes);
+		session->nr_processes++;
+	}
+	if (atomic_read(&process->exited)) {
+		err = -ESTALE;
+		goto unlock;
+	}
+	if (!hfs_cred_equal(snapshot, process->last)) {
+		if (process->revision == U64_MAX) {
+			err = -EOVERFLOW;
+			goto unlock;
+		}
+		/* Linearize concurrent captures here. A changed snapshot returning
+     * to older values still gets a new epoch: no A->B->A reuse.
+     * Earlier issued snapshots/grants retain their immutable bytes.
+     */
+		snapshot->revision = ++process->revision;
+		snapshot->process = process->id;
+		*last = *snapshot;
+		last->native = get_cred(cred);
+		displaced = process->last;
+		process->last = last;
+		last = NULL;
+	} else {
+		snapshot->revision = process->revision;
+		snapshot->process = process->id;
+	}
+	*out = snapshot;
+	err = 0;
+unlock:
+	spin_unlock_irqrestore(&session->processes_lock, flags);
+	/* Native reference release and credit providers never run under spin. */
+	hfs_cred_free(displaced);
+	if (candidate) {
+		if (candidate->reservation)
+			session->provider->unreserve(session, candidate->reservation);
+		put_pid(candidate->pid);
+		kfree(candidate);
+	}
+	kfree(last);
+	if (!err)
+		return 0;
+	candidate = NULL;
+	last = NULL;
+fail:
+	put_cred(cred);
+	kfree(snapshot);
+	if (candidate) {
+		if (candidate->reservation)
+			session->provider->unreserve(session, candidate->reservation);
+		put_pid(candidate->pid);
+		kfree(candidate);
+	}
+	kfree(last);
+	return err;
+}
+
+int hfs_capture(struct hfs_session *session, struct user_namespace *mnt_userns,
+		struct hfs_cred **out)
+{
+	return hfs_capture_owned(session, mnt_userns, out, false);
+}
+
+int hfs_capture_terminal(struct hfs_session *session, struct hfs_cred **out)
+{
+	if (session->bridge_minor != 4 || !session->terminal_completion ||
+	    session->enrollment.protocol_features != HFS_TERMINAL_FEATURES)
+		return -EACCES;
+	return hfs_capture_owned(session, &init_user_ns, out, true);
+}
+
+static int hfs_reply_scope(struct hfs_session *session, struct hfs_json *json, u64 cell,
+			   const char *operation)
+{
+	int context;
+	u64 selected;
+	char op[32];
+
+	if (hfs_json_exact(json, 0,
+			   session->bridge_minor >= 2 ?
+				   "cell,context,op,payload,protocol,verification" :
+			   session->bridge_minor ? "cell,context,op,payload,protocol" :
+						   "cell,context,op,payload") ||
+	    (session->bridge_minor &&
+	     hfs_protocol_selected_match(json, hfs_json_field(json, 0, "protocol"),
+					 session->bridge_minor,
+					 session->enrollment.protocol_features)) ||
+	    hfs_field_u64(json, 0, "cell", &selected) || selected != cell ||
+	    hfs_json_string(json, hfs_json_field(json, 0, "op"), op, sizeof(op)) < 0 ||
+	    strcmp(op, operation))
+		return -EPROTO;
+	context = hfs_json_field(json, 0, "context");
+	if (context < 0 ||
+	    json->tokens[context].end - json->tokens[context].start !=
+		    session->enrollment.context_len ||
+	    memcmp(json->data + json->tokens[context].start, session->enrollment.context,
+		   session->enrollment.context_len))
+		return -EPROTO;
+	return 0;
+}
+
+/* The host stopped answering (session->transport_failed); 5f4: wakes the
+ * view waits that stop on it (hfs_session_stop_wake).
+ */
+static void hfs_transport_failed(struct hfs_session *session)
+{
+	WRITE_ONCE(session->transport_failed, true);
+	hfs_session_stop_wake(session);
+}
+
+/* Record a failed exchange's ERROR reason for the block/stop log lines
+ * (oc4): hfs_session_block and hfs_mmap_fail print it, because their errno
+ * alone did not say what the exporter answered (zq3-r12 R12-1 logged -71).
+ */
+static void hfs_transport_note(struct hfs_session *session, const void *packet, u32 len)
+{
+	u16 reason = hfs_bridge_error_reason(packet, len);
+
+	if (reason)
+		WRITE_ONCE(session->exporter_error, reason);
+	if (reason == HFS_ERROR_UNAVAILABLE)
+		hfs_transport_failed(session);
+}
+
+/* -EHOSTDOWN when a retry or poll loop must stop because the session is
+ * blocked (oc4, zq3-r12 R12-1: mount-1 kept retrying its mount-time
+ * VIEW_QUERY for 30 s after its session was blocked). exempt is decided by
+ * the caller (hfs_control_flagged at admission, under session->lock): only
+ * retirement, release and cleanup traffic, plus the reserved drain and
+ * reconciliation work DRAIN_WRITE and GAP_RESOLVE (dh4) and ABANDON (hh4),
+ * may continue on a blocked session (hfs_after_block_operation). A clean unmount or a closing
+ * (failed, retained) mount is teardown and continues too.
+ *
+ * kill_sb and hfs_mount_fail write unmounting/closing, then smp_wmb(), then
+ * blocked; the smp_rmb() here pairs with that, so a reader that sees blocked
+ * also sees the teardown flag written before it and does not halt a FORGET
+ * or lease release that was in flight when the unmount started.
+ *
+ * A session whose host stopped answering (transport_failed) halts even
+ * exempt and teardown traffic, so unmount stays bounded (zq3-r13).
+ */
+int hfs_session_poll_halt(struct hfs_session *session, bool exempt)
+{
+	bool blocked = READ_ONCE(session->blocked);
+
+	if (READ_ONCE(session->transport_failed))
+		return -EHOSTDOWN;
+	if (!blocked)
+		return 0;
+	smp_rmb();
+	return hfs_transport_halt(exempt, blocked,
+				  READ_ONCE(session->unmounting) || READ_ONCE(session->closing));
+}
+
+/* The retry-loop exit shared by SEND and FETCH: the original deadline, then
+ * a blocked session (hfs_session_poll_halt).
+ *
+ * Reaching the deadline here, after 30 s of CAPACITY refusals or FETCH
+ * AGAIN, marks the session transport_failed (zq3-r13). That is also how a
+ * live exporter that keeps refusing ends, but after host loss the exporter
+ * pins the refused native write and answers AGAIN forever, so the deadline
+ * is the only signal of that loss; a session that waited 30 s is blocked
+ * by hfs_control anyway. ALLOCATE is the exception (review round 2): its
+ * deadline only sets allocation_uncertain and leaves the session usable.
+ */
+static int hfs_transport_stop(struct hfs_session *session, unsigned long deadline, u32 flags)
+{
+	if (time_after_eq(jiffies, deadline)) {
+		if (!(flags & HFS_TRANSPORT_ALLOCATE))
+			hfs_transport_failed(session);
+		return -ETIMEDOUT;
+	}
+	return hfs_session_poll_halt(session, flags & HFS_TRANSPORT_EXEMPT);
+}
+
+/* SEND every chunk of body under the writer. Only a CAPACITY refusal (or a
+ * busy fixed tag) retries, with the identical frame and chunk; any other
+ * ERROR fails with its reason's errno (hfs_send_reply).
+ */
+static int hfs_transport_send(struct hfs_session *session, const struct hfs_buf *body, u64 cell,
+			      u16 tag, unsigned long deadline, unsigned long pressure_at,
+			      u32 flags, void *frame, void *packet, bool *writer_held)
+{
+	u32 chunk, len, frame_len;
+	int err;
+
+	for (chunk = 0; chunk * HFS_CHUNK_MAX < body->len; chunk++) {
+		frame_len = HFS_HEADER_SIZE + HFS_CHUNK_MAX;
+		err = hfs_frame_encode_version(session->bridge_minor, 1,
+					       &session->enrollment.session, cell, body->data,
+					       body->len, chunk, frame, &frame_len);
+		if (err)
+			return err;
+retry_send:
+		len = HFS_HEADER_SIZE + HFS_CHUNK_MAX + 1;
+		err = p9_client_hfs_exchange(session->client, tag, 1, 1, cell, chunk, frame,
+					     frame_len, packet, &len);
+		/* No reply within the bounded wait (zq3-r13): the host is gone. */
+		if (err == -ETIMEDOUT)
+			hfs_transport_failed(session);
+		/* -EBUSY: a fixed tag stayed held past the exchange's bounded wait
+		 * and nothing was sent (net/9p p9_client_hfs_exchange). Retry the
+		 * same frame like a refused packet, under the same deadline. It is
+		 * never a transport fault, so the session is not blocked (zq3-r5
+		 * R5-1, 964).
+		 */
+		if (err == -EBUSY) {
+			err = -EAGAIN;
+		} else if (!err) {
+			err = hfs_send_reply(packet, len, time_after_eq(jiffies, deadline));
+			if (err && err != -EAGAIN)
+				hfs_transport_note(session, packet, len);
+		}
+		if (!err)
+			continue; /* COPIED: the next chunk. */
+		if (err != -EAGAIN)
+			return err;
+		/* No bytes of this packet were copied. Retain its exact frame and
+		 * chunk; yield the writer so reserved drains can progress.
+		 */
+		mutex_unlock(&session->writer);
+		*writer_held = false;
+		if (session->bridge_minor && tag == P9_NOTAG && time_after_eq(jiffies, pressure_at))
+			hfs_mmap_progress(session);
+		usleep_range(10000, 12000);
+		mutex_lock(&session->writer);
+		*writer_held = true;
+		err = hfs_transport_stop(session, deadline, flags);
+		if (err)
+			return err;
+		goto retry_send;
+	}
+	return 0;
+}
+
+/* FETCH one chunk until it is no longer AGAIN (or a busy fixed tag, which
+ * sent no FETCH). Returns 0 with a FRAME packet in packet/len; an ERROR reply
+ * fails with its reason's errno (oc4: UNAVAILABLE is -EHOSTDOWN, RETIRED_CELL
+ * -ESTALE; before oc4 every non-FRAME reply was -EPROTO).
+ */
+static int hfs_transport_fetch(struct hfs_session *session, u64 cell, u16 tag, u8 channel,
+			       u32 chunk, unsigned long deadline, unsigned long pressure_at,
+			       u32 flags, void *packet, u32 *len)
+{
+	int err;
+
+	for (;;) {
+		*len = HFS_HEADER_SIZE + HFS_CHUNK_MAX + 1;
+		err = p9_client_hfs_exchange(session->client, tag, 2, channel, cell, chunk, NULL, 0,
+					     packet, len);
+		if (err == -ETIMEDOUT)
+			hfs_transport_failed(session); /* as for SEND */
+		if (err && err != -EBUSY)
+			return err;
+		if (!err && (*len != 1 || *(u8 *)packet != 2))
+			break;
+		if (session->bridge_minor && tag == P9_NOTAG && time_after_eq(jiffies, pressure_at))
+			hfs_mmap_progress(session);
+		usleep_range(10000, 12000);
+		/* After the sleep, as for SEND: a block raised meanwhile sends
+		 * no further FETCH.
+		 */
+		err = hfs_transport_stop(session, deadline, flags);
+		if (err)
+			return err;
+	}
+	if (*(u8 *)packet == 3 && *len > 1)
+		return 0;
+	hfs_transport_note(session, packet, *len);
+	return hfs_bridge_error(hfs_bridge_error_reason(packet, *len));
+}
+
+/* Decode one fetched FRAME chunk into *assembled: chunk 0 allocates the
+ * whole body and fixes its length and hash, later chunks must repeat them.
+ */
+static int hfs_transport_chunk(struct hfs_session *session, u64 cell, u32 chunk,
+			       struct hfs_response_profile response, const void *packet, u32 len,
+			       void **assembled, u32 *total, u8 expected[32])
+{
+	u32 body_len, frame_len;
+	const void *bytes;
+	u8 hash[32];
+	int err;
+
+	err = hfs_frame_decode_version(session->bridge_minor, packet + 1, len - 1, response.kind,
+				       &session->enrollment.session, cell, chunk, &body_len, hash,
+				       &bytes, &frame_len);
+	if (err)
+		return err;
+	if (response.max_body && body_len > response.max_body)
+		return -EPROTO;
+	if (!chunk) {
+		*total = body_len;
+		memcpy(expected, hash, 32);
+		*assembled = kvmalloc(*total, GFP_KERNEL);
+		if (!*assembled)
+			return -ENOMEM;
+	} else if (*total != body_len || memcmp(expected, hash, 32)) {
+		return -EPROTO;
+	}
+	memcpy(*assembled + chunk * HFS_CHUNK_MAX, bytes, frame_len);
+	return 0;
+}
+
+/* FETCH and verify every response chunk, then the whole body's hash. */
+static int hfs_transport_collect(struct hfs_session *session, u64 cell, u16 tag,
+				 struct hfs_response_profile response, unsigned long deadline,
+				 unsigned long pressure_at, u32 flags, void *packet,
+				 void **reply, u32 *reply_len)
+{
+	void *assembled = NULL;
+	u8 expected[32], hash[32];
+	u32 chunk, total = 0, len;
+	int err;
+
+	for (chunk = 0;; chunk++) {
+		err = hfs_transport_fetch(session, cell, tag, response.channel, chunk, deadline,
+					  pressure_at, flags, packet, &len);
+		if (!err)
+			err = hfs_transport_chunk(session, cell, chunk, response, packet, len,
+						  &assembled, &total, expected);
+		if (err)
+			goto out;
+		if ((chunk + 1) * HFS_CHUNK_MAX >= total)
+			break;
+	}
+	hfs_hash(assembled, total, hash);
+	if (memcmp(expected, hash, 32)) {
+		err = -EPROTO;
+		goto out;
+	}
+	*reply = assembled;
+	*reply_len = total;
+	assembled = NULL;
+out:
+	kvfree(assembled);
+	return err;
+}
+
+/* One complete exchange: SEND the body (hfs_transport_send), release the
+ * writer, then FETCH it back (hfs_transport_collect). Every retry shares
+ * one 30 s deadline and stops once the session is blocked, unless flags
+ * has HFS_TRANSPORT_EXEMPT (hfs_session_poll_halt, oc4).
+ */
+static int hfs_transport(struct hfs_session *session, const struct hfs_buf *body, u64 cell, u16 tag,
+			 struct hfs_response_profile response, u32 flags, void **reply,
+			 u32 *reply_len, bool *writer_held)
+{
+	unsigned long deadline = jiffies + 30 * HZ;
+	unsigned long pressure_at = jiffies + msecs_to_jiffies(50);
+	void *frame, *packet;
+	int err = -ENOMEM;
+
+	frame = kmalloc(HFS_HEADER_SIZE + HFS_CHUNK_MAX, GFP_KERNEL);
+	packet = kmalloc(HFS_HEADER_SIZE + HFS_CHUNK_MAX + 1, GFP_KERNEL);
+	if (!frame || !packet)
+		goto out;
+	err = hfs_transport_send(session, body, cell, tag, deadline, pressure_at, flags, frame,
+				 packet, writer_held);
+	if (err)
+		goto out;
+	mutex_unlock(&session->writer);
+	*writer_held = false;
+	err = hfs_transport_collect(session, cell, tag, response, deadline, pressure_at, flags,
+				    packet, reply, reply_len);
+out:
+	kfree(frame);
+	kfree(packet);
+	return err;
+}
+
+#ifdef CONFIG_9P_FS_HOMELABFS_CONTROLLED
+#include "hfs_received.inc"
+#endif
+
+static bool hfs_result_needs_adoption(const struct hfs_json *result)
+{
+	return !hfs_json_is(result, hfs_json_field(result, 0, "capabilities"),
+			    "[]") ||
+	       !hfs_json_is(result, hfs_json_field(result, 0, "entries"), "[]");
+}
+
+static bool hfs_operation(const char *operation, bool call)
+{
+	static const char *const commands[] = {
+		"HELLO",	  "CALL",	  "QUERY",	     "CANCEL",	    "RETIRE",
+		"RELEASE_CELL",	  "RESUME",	  "VIEW_WAIT",	     "VIEW_ACK",    "VIEW_ACQUIRE",
+		"VIEW_RELEASE",	  "VIEW_RENEW",	  "VIEW_QUERY",	     "VIEW_CANCEL", "VIEW_RETIRE",
+		"DIRTY_RESERVE",  "DIRTY_FREEZE", "READDIR_CLEANUP", "ALLOCATE",    "GAP_RESOLVE",
+		"SESSION_RETIRE", "ABANDON",
+	};
+	static const char *const opcodes[] = {
+		"ROOT",
+		"LOOKUP",
+		"GETATTR",
+		"READLINK",
+		"CREATE",
+		"MKDIR",
+		"SYMLINK",
+		"OPEN",
+		"READ",
+		"WRITE",
+		"TRUNCATE",
+		"SETATTR",
+		"RENAME",
+		"LINK",
+		"UNLINK",
+		"RMDIR",
+		"READDIR",
+		"STATFS",
+		"SYNC",
+		"DESCRIPTION_CLOSE",
+		"DESCRIPTION_RELEASE",
+		"FORGET",
+		"PROCESS_EXIT",
+		"DRAIN_WRITE",
+	};
+	const char *const *names = call ? opcodes : commands;
+	u32 count = call ? ARRAY_SIZE(opcodes) : ARRAY_SIZE(commands), i;
+
+	for (i = 0; i < count; i++)
+		if (!strcmp(names[i], operation))
+			return true;
+	return false;
+}
+
+/* Only the exact retained allocation command may reuse its transport cell.
+ * Caller holds writer and session lock. The original body/donor are immutable.
+ */
+static struct hfs_candidate *hfs_allocation_candidate(struct hfs_session *session,
+						   const struct hfs_buf *payload)
+{
+	struct hfs_candidate *candidate;
+
+	list_for_each_entry(candidate, &session->uncertain, list) {
+		struct hfs_json *json = NULL;
+		int token;
+		bool match = false;
+
+		if (hfs_json_parse(candidate->command.data, candidate->command.len, &json))
+			continue;
+		token = hfs_json_field(json, 0, "payload");
+		if (hfs_json_is(json, hfs_json_field(json, 0, "op"), "\"ALLOCATE\"") &&
+		    token >= 0 && json->tokens[token].end - json->tokens[token].start == payload->len &&
+		    !memcmp(json->data + json->tokens[token].start, payload->data, payload->len))
+			match = true;
+		hfs_json_free(json);
+		if (match)
+			return candidate;
+	}
+	return NULL;
+}
+
+/* A controlled session's terminal candidate must still own its carrier
+ * reservation and the session's terminal completion. hfs_controlled_owns is
+ * declared only with CONFIG_9P_FS_HOMELABFS_CONTROLLED (dh4: calling it
+ * unguarded broke the build with the option off, since 614 (e199627));
+ * without it no session is controlled, so nothing can mismatch.
+ */
+static bool hfs_terminal_controlled_mismatch(struct hfs_session *session,
+					     const struct hfs_candidate *candidate)
+{
+#ifdef CONFIG_9P_FS_HOMELABFS_CONTROLLED
+	return hfs_controlled_owns(session) &&
+	       (!candidate->reservation ||
+		candidate->completion != session->terminal_completion);
+#else
+	(void)session;
+	(void)candidate;
+	return false;
+#endif
+}
+
+/* Exact typed terminal retry. No reconstructed payload can select a different
+ * candidate, and unrelated uncertain commands continue to block destruction. */
+static struct hfs_candidate *hfs_terminal_candidate(struct hfs_session *session,
+						    const struct hfs_buf *payload)
+{
+	struct hfs_candidate *candidate, *found = NULL;
+	struct hfs_response_profile expected = hfs_response_profile("SESSION_RETIRE");
+
+	if (session->terminal_slot >= ARRAY_SIZE(session->cells) || payload->error)
+		return NULL;
+	list_for_each_entry(candidate, &session->uncertain, list) {
+		struct hfs_json *json = NULL;
+		u8 hash[32];
+		u64 cell, donor_cell;
+		u32 length = sizeof(hash);
+		int token, context, donor;
+		bool donor_matches;
+
+		if (found || candidate->session != session || !candidate->slot ||
+		    !candidate->slot->reserved || candidate->cell != session->terminal_cell ||
+		    candidate->slot != &session->cells[session->terminal_slot] ||
+		    candidate->donor != session->terminal_donor ||
+		    candidate->response.channel != expected.channel ||
+		    candidate->response.kind != expected.kind ||
+		    candidate->response.max_body != expected.max_body ||
+		    hfs_terminal_controlled_mismatch(session, candidate) ||
+		    hfs_json_parse(candidate->command.data, candidate->command.len, &json))
+			return NULL;
+		token = hfs_json_field(json, 0, "payload");
+		context = hfs_json_field(json, 0, "context");
+		donor = hfs_json_field(json, 0, "reclaim");
+		donor_matches =
+			!session->terminal_donor ?
+				hfs_json_is(json, donor, "null") :
+				!hfs_json_exact(json, donor, "cell,response_hash") &&
+					!hfs_json_u64(json, hfs_json_field(json, donor, "cell"),
+						      &donor_cell) &&
+					donor_cell == session->terminal_donor &&
+					!hfs_json_hex(json,
+						      hfs_json_field(json, donor, "response_hash"),
+						      hash, &length) &&
+					length == sizeof(hash) &&
+					!memcmp(hash, session->terminal_donor_hash, sizeof(hash));
+		if (hfs_json_exact(json, 0,
+				   "cell,context,delegation,op,payload,protocol,reclaim") ||
+		    hfs_json_u64(json, hfs_json_field(json, 0, "cell"), &cell) ||
+		    cell != candidate->cell ||
+		    !hfs_json_is(json, hfs_json_field(json, 0, "delegation"), "null") ||
+		    hfs_protocol_selected_match(json, hfs_json_field(json, 0, "protocol"), 4,
+						HFS_TERMINAL_FEATURES) ||
+		    !donor_matches || context < 0 ||
+		    json->tokens[context].end - json->tokens[context].start !=
+			    session->enrollment.context_len ||
+		    memcmp(json->data + json->tokens[context].start, session->enrollment.context,
+			   session->enrollment.context_len) ||
+		    !hfs_json_is(json, hfs_json_field(json, 0, "op"), "\"SESSION_RETIRE\"") ||
+		    token < 0 ||
+		    json->tokens[token].end - json->tokens[token].start != payload->len ||
+		    memcmp(json->data + json->tokens[token].start, payload->data, payload->len)) {
+			hfs_json_free(json);
+			return NULL;
+		}
+		hfs_json_free(json);
+		found = candidate;
+	}
+	return found;
+}
+
+#ifdef CONFIG_9P_FS_HOMELABFS_CONTROLLED
+/* A HELLO parse has no private Received authority. Its actual candidate
+ * retains the complete carrier credit until json_free has freed the parse.
+ */
+static void hfs_candidate_parse_put(void *opaque)
+{
+	struct hfs_candidate *candidate = opaque;
+	struct hfs_session *session = candidate->session;
+	void *credit = candidate->reservation;
+
+	kfree(candidate);
+	session->provider->unreserve(session, credit);
+}
+
+#endif
+
+int hfs_control_flagged(struct hfs_session *session, const char *operation,
+			const struct hfs_buf *payload, bool reserved, bool after_block,
+			struct hfs_json **out)
+{
+	struct hfs_response_profile response = hfs_response_profile(operation);
+#ifdef CONFIG_9P_FS_HOMELABFS_CONTROLLED
+	struct hfs_received_capture received_capture;
+	struct hfs_completion *completion = NULL;
+	bool resource_control = false;
+	void *response_credit = NULL;
+	u64 command_bound = 0;
+	u32 retained_body = response.max_body;
+#endif
+	struct hfs_buf command;
+	struct hfs_json *json = NULL;
+	struct hfs_cell *slot = NULL;
+	struct hfs_candidate *candidate;
+	bool writer_held = true;
+	void *reply = NULL;
+	u32 i, first = reserved ? 64 : 0, last = reserved ? 80 : 64;
+	u32 reply_len = 0;
+	u64 cell, release_cell = 0;
+	u8 release_hash[32];
+	bool release = !strcmp(operation, "RELEASE_CELL");
+	bool allocate = !strcmp(operation, "ALLOCATE");
+	bool terminal = !strcmp(operation, "SESSION_RETIRE");
+	void *carrier_credit = NULL;
+	bool exempt = after_block;
+	int err;
+
+	*out = NULL;
+	err = hfs_controlled_before_send(session, operation, payload, reserved);
+	if (err)
+		return err;
+	if (terminal && (session->bridge_minor != 4 ||
+			 session->enrollment.protocol_features != HFS_TERMINAL_FEATURES ||
+			 !session->terminal_pending))
+		return -EACCES;
+	if (!hfs_operation(operation, false))
+		return -EOPNOTSUPP;
+	/* hh4: ABANDON, like GAP_RESOLVE, is reserved claim-ledger work of a
+	 * controlled (minor >= 2) session.
+	 */
+	if ((!strcmp(operation, "ALLOCATE") || !strcmp(operation, "GAP_RESOLVE") ||
+	     !strcmp(operation, "ABANDON")) &&
+	    session->bridge_minor < 2)
+		return -EOPNOTSUPP;
+	if ((!strcmp(operation, "ALLOCATE") && reserved) ||
+	    ((!strcmp(operation, "GAP_RESOLVE") || !strcmp(operation, "READDIR_CLEANUP") ||
+	      !strcmp(operation, "ABANDON")) &&
+	     !reserved))
+		return -EINVAL;
+	if (!strcmp(operation, "READDIR_CLEANUP") && session->bridge_minor < 3)
+		return -EOPNOTSUPP;
+	if (hfs_view_command(operation) &&
+	    (!session->bridge_minor || reserved != hfs_view_command_control(operation)))
+		return -EOPNOTSUPP;
+	if (payload->error || !payload->len)
+		return payload->error ?: -EINVAL;
+#ifdef CONFIG_9P_FS_HOMELABFS_CONTROLLED
+	if (hfs_controlled_owns(session)) {
+		if (check_add_overflow((u64)payload->len, (u64)session->enrollment.context_len,
+				       &command_bound) ||
+		    check_add_overflow(command_bound, 1024ULL, &command_bound))
+			return -EOVERFLOW;
+		command_bound =
+			min_t(u64, command_bound,
+			      hfs_view_command(operation) ? HFS_VIEW_BODY_MAX : HFS_BODY_MAX);
+	}
+#endif
+	/* A closed canonical ACK (u64 cell and64 hex digits) fits128 bytes.
+   * Check the bound without allocation; its parse shares the later command
+   * capacity and is freed before candidate/command allocation.
+   */
+	if (release && payload->len > 128)
+		return -EINVAL;
+	if ((allocate && READ_ONCE(session->allocation_uncertain)) ||
+	    (terminal && !list_empty(&session->uncertain))) {
+		mutex_lock(&session->writer);
+		mutex_lock(&session->lock);
+		candidate = terminal ? hfs_terminal_candidate(session, payload) :
+				       hfs_allocation_candidate(session, payload);
+		if (!candidate) {
+			mutex_unlock(&session->lock);
+			mutex_unlock(&session->writer);
+			return -EBUSY;
+		}
+		list_del(&candidate->list);
+		command = candidate->command;
+		cell = candidate->cell;
+		slot = candidate->slot;
+		response = candidate->response;
+		mutex_unlock(&session->lock);
+#ifdef CONFIG_9P_FS_HOMELABFS_CONTROLLED
+		completion = hfs_completion_get(candidate->completion);
+		resource_control = completion && hfs_completion_control(completion);
+		retained_body =
+			hfs_completion_retained_body(completion, operation, response.max_body);
+#endif
+		goto exchange;
+	}
+#ifdef CONFIG_9P_FS_HOMELABFS_CONTROLLED
+	if (hfs_controlled_owns(session)) {
+		if (!strcmp(operation, "ALLOCATE") || !strcmp(operation, "CALL") ||
+		    !strcmp(operation, "GAP_RESOLVE"))
+			response.max_body = HFS_CONTEXT_MAX + 4096 + 1024;
+		/* Complete command, assembled/raw parsed response, both parser token
+     * arenas, and transport/native frame packages are charged BEFORE
+     * any allocation/send. Received owners acquire separate exact credits
+     * before this temporary package is returned. Small request metadata
+     * and caller payloads remain in their preowned request/ticket package.
+     */
+		u64 command_cap = hfs_view_command(operation) ? HFS_VIEW_BODY_MAX : HFS_BODY_MAX;
+		u64 response_cap, bytes;
+
+		completion = hfs_completion_find(session, operation, payload);
+		if (completion && hfs_completion_body(completion) < response.max_body)
+			response.max_body = hfs_completion_body(completion);
+		retained_body =
+			hfs_completion_retained_body(completion, operation, response.max_body);
+		response_cap = response.max_body;
+		bytes = sizeof(*candidate) + command_cap + 2ULL * response_cap + 2ULL +
+			sizeof(struct hfs_json) +
+			2ULL * min_t(u64, response_cap / 2 + 1, 131072ULL) *
+				sizeof(struct hfs_token) +
+			6ULL * (HFS_HEADER_SIZE + HFS_CHUNK_MAX + 1ULL);
+
+		resource_control = completion ?
+					   hfs_completion_control(completion) :
+					   (reserved || release) && strcmp(operation, "QUERY") &&
+						   strcmp(operation, "CANCEL") &&
+						   strcmp(operation, "GAP_RESOLVE") &&
+						   strcmp(operation, "VIEW_QUERY") &&
+						   strcmp(operation, "VIEW_CANCEL") &&
+						   strcmp(operation, "VIEW_RENEW");
+		if (completion)
+			err = hfs_completion_reserve(completion, bytes, false, &carrier_credit);
+		else
+			err = hfs_controlled_transport_reserve(session, operation, bytes,
+							       resource_control, &carrier_credit);
+		if (err) {
+			hfs_completion_put(completion);
+			return err;
+		}
+	}
+#endif
+	if (release) {
+		struct hfs_json *ack = NULL;
+		u32 len = 32;
+
+		err = hfs_json_parse(payload->data, payload->len, &ack);
+		if (!err && (hfs_json_exact(ack, 0, "cell,response_hash") ||
+			     hfs_field_u64(ack, 0, "cell", &release_cell) || !release_cell ||
+			     hfs_json_hex(ack, hfs_json_field(ack, 0, "response_hash"),
+					  release_hash, &len) ||
+			     len != 32))
+			err = -EINVAL;
+		hfs_json_free(ack);
+		if (err) {
+			if (carrier_credit)
+				session->provider->unreserve(session, carrier_credit);
+#ifdef CONFIG_9P_FS_HOMELABFS_CONTROLLED
+			hfs_completion_put(completion);
+#endif
+			return err;
+		}
+	}
+	candidate = kzalloc(sizeof(*candidate), GFP_KERNEL);
+	if (!candidate) {
+		if (carrier_credit)
+			session->provider->unreserve(session, carrier_credit);
+#ifdef CONFIG_9P_FS_HOMELABFS_CONTROLLED
+		hfs_completion_put(completion);
+#endif
+		return -ENOMEM;
+	}
+#ifdef CONFIG_9P_FS_HOMELABFS_CONTROLLED
+	candidate->completion = completion;
+#endif
+	candidate->response = response;
+	candidate->session = session;
+	candidate->reservation = carrier_credit;
+	err = hfs_buf_init(&command,
+			   hfs_view_command(operation) ? HFS_VIEW_BODY_MAX : HFS_BODY_MAX);
+	if (err) {
+		kfree(candidate);
+		if (carrier_credit)
+			session->provider->unreserve(session, carrier_credit);
+#ifdef CONFIG_9P_FS_HOMELABFS_CONTROLLED
+		hfs_completion_put(completion);
+#endif
+		return err;
+	}
+#ifdef CONFIG_9P_FS_HOMELABFS_CONTROLLED
+	if (hfs_controlled_owns(session) && strcmp(operation, "HELLO")) {
+		struct hfs_response_profile receipt_profile = response;
+
+		receipt_profile.max_body = retained_body;
+		err = hfs_received_prepare(session, (u32)command_bound, receipt_profile,
+					   resource_control, completion, &response_credit);
+		if (err) {
+			hfs_buf_free(&command);
+			kfree(candidate);
+			session->provider->unreserve(session, carrier_credit);
+			hfs_completion_put(completion);
+			return err;
+		}
+	}
+#endif
+	/* Writer is never held while awaiting a service grant or recall. FETCH
+   * below must remain nonblocking; independent control workers own reserve.
+   */
+	mutex_lock(&session->writer);
+	mutex_lock(&session->lock);
+	if (((session->blocked || session->allocation_uncertain) && !reserved) ||
+	    session->next_cell > HFS_CELL_MAX) {
+		err = -EHOSTDOWN;
+		goto unlock;
+	}
+	/* oc4: decided here, under session->lock, so a block raised after
+	 * admission is never mistaken for an exemption.
+	 */
+	exempt = after_block || session->closing || session->unmounting;
+	if (terminal) {
+		release_cell = session->terminal_donor;
+		memcpy(release_hash, session->terminal_donor_hash, 32);
+	}
+	if (release || (terminal && release_cell)) {
+		for (i = 0; i < 80; i++)
+			if (session->cells[i].ack_ready && !session->cells[i].reserved &&
+			    session->cells[i].number == release_cell &&
+			    !memcmp(session->cells[i].hash, release_hash, 32)) {
+				slot = &session->cells[i];
+				break;
+			}
+		if (!slot) {
+			err = -ESTALE;
+			goto unlock;
+		}
+	}
+	for (i = first; !slot && i < last; i++)
+		if (!session->cells[i].reserved && session->cells[i].ack_ready) {
+			slot = &session->cells[i];
+			break;
+		}
+	if (!slot)
+		for (i = first; i < last; i++)
+			if (!session->cells[i].active && !session->cells[i].reserved) {
+				slot = &session->cells[i];
+				break;
+			}
+	if (!slot) {
+		err = -EAGAIN;
+		goto unlock;
+	}
+	cell = session->next_cell++;
+	if (terminal) {
+		session->terminal_cell = cell;
+		session->terminal_slot = slot - session->cells;
+	}
+	slot->reserved = true;
+	hfs_buf_printf(&command, "{\"cell\":%llu,\"context\":", cell);
+	hfs_buf_add(&command, session->enrollment.context, session->enrollment.context_len);
+	if (session->bridge_minor == 4)
+		hfs_buf_literal(&command, ",\"delegation\":null");
+	hfs_buf_printf(&command, ",\"op\":\"%s\",\"payload\":", operation);
+	hfs_buf_add(&command, payload->data, payload->len);
+	if (session->bridge_minor) {
+		hfs_buf_literal(&command, ",\"protocol\":");
+		hfs_buf_literal(&command,
+				hfs_protocol_selected_text(session->bridge_minor,
+							   session->enrollment.protocol_features));
+	}
+	hfs_buf_literal(&command, ",\"reclaim\":");
+	if (slot->ack_ready) {
+		hfs_buf_printf(&command, "{\"cell\":%llu,\"response_hash\":", slot->number);
+		hfs_buf_hex(&command, slot->hash, 32);
+		hfs_buf_literal(&command, "}");
+	} else {
+		hfs_buf_literal(&command, "null");
+	}
+	hfs_buf_literal(&command, "}");
+	mutex_unlock(&session->lock);
+	if (command.error) {
+		err = command.error;
+		goto fault;
+	}
+exchange:
+#ifdef CONFIG_9P_FS_HOMELABFS_CONTROLLED
+	if (hfs_controlled_owns(session) && strcmp(operation, "HELLO")) {
+		if (!response_credit) {
+			struct hfs_response_profile receipt_profile = response;
+
+			receipt_profile.max_body = retained_body;
+			err = hfs_received_prepare(session, (u32)command_bound, receipt_profile,
+						   resource_control, completion, &response_credit);
+			if (err)
+				goto fault;
+		}
+		hfs_received_capture(session, &received_capture);
+	}
+#endif
+	err = hfs_transport(session, &command, cell,
+			    !strcmp(operation, "VIEW_WAIT") ? 65534 :
+			    reserved || release		    ? 65533 :
+							      P9_NOTAG,
+			    response,
+			    (exempt ? HFS_TRANSPORT_EXEMPT : 0) |
+				    (allocate ? HFS_TRANSPORT_ALLOCATE : 0),
+			    &reply, &reply_len, &writer_held);
+	/* oc4 review: RETIRED_CELL keeps -EPROTO for ALLOCATE. Its session is
+	 * not blocked (allocation_uncertain instead), so a VFS caller seeing
+	 * -ESTALE could retry the lookup once and replay the uncertain
+	 * allocation fence; -EPROTO fails it as before oc4.
+	 */
+	if (allocate && err == -ESTALE)
+		err = -EPROTO;
+	if (err)
+		goto fault;
+	err = hfs_json_parse(reply, reply_len, &json);
+	if (!err)
+		err = hfs_reply_scope(session, json, cell, operation);
+	if (err)
+		goto fault;
+	json->transported = true;
+	json->channel = response.channel;
+	json->frame_kind = response.kind;
+	json->frame_minor = session->bridge_minor;
+	json->native_session = session->enrollment.session;
+	json->native_cell = cell;
+#ifdef CONFIG_9P_FS_HOMELABFS_CONTROLLED
+	if (hfs_controlled_owns(session) && strcmp(operation, "HELLO")) {
+		if (json->len > retained_body || command.len > command_bound) {
+			err = -EPROTO;
+			goto fault;
+		}
+		err = hfs_received_new(session, &command, json, &received_capture, response,
+				       resource_control, reserved || release, completion,
+				       &response_credit);
+		if (err)
+			goto fault;
+	}
+#endif
+	mutex_lock(&session->lock);
+	slot->active = true;
+	slot->number = cell;
+	hfs_hash(reply, reply_len, slot->hash);
+	slot->ack_ready = true;
+	slot->reserved = false;
+	if (allocate)
+		session->allocation_uncertain = false;
+	mutex_unlock(&session->lock);
+	if (writer_held)
+		mutex_unlock(&session->writer);
+	carrier_credit = candidate->reservation;
+#ifdef CONFIG_9P_FS_HOMELABFS_CONTROLLED
+	if (carrier_credit && !strcmp(operation, "HELLO")) {
+		json->owner = candidate;
+		json->owner_put = hfs_candidate_parse_put;
+		carrier_credit = NULL;
+	} else
+#endif
+		kfree(candidate);
+	hfs_buf_free(&command);
+	kvfree(reply);
+	/* Received owns returned parses except HELLO, which retains its actual
+   * carrier until the entire HELLO parse is destroyed.
+   */
+	if (carrier_credit)
+		session->provider->unreserve(session, carrier_credit);
+#ifdef CONFIG_9P_FS_HOMELABFS_CONTROLLED
+	hfs_completion_put(completion);
+#endif
+	*out = json;
+	return 0;
+fault:
+#ifdef CONFIG_9P_FS_HOMELABFS_CONTROLLED
+	hfs_controlled_received_release(session, response_credit);
+	hfs_completion_uncertain(completion);
+#endif
+	/* Keep exact uncertain candidate bytes. Never release donor evidence or
+   * issue another candidate after an uncertain transport/admission result.
+   */
+	if (allocate)
+		WRITE_ONCE(session->allocation_uncertain, true);
+	else
+		hfs_session_block(session, "uncertain control result", operation, err);
+	/* The command is owned by the retained session until reconciliation. */
+	candidate->command = command;
+	candidate->slot = slot;
+	candidate->cell = cell;
+	candidate->donor = slot->number;
+	mutex_lock(&session->lock);
+	list_add_tail(&candidate->list, &session->uncertain);
+	mutex_unlock(&session->lock);
+	if (writer_held)
+		mutex_unlock(&session->writer);
+	hfs_json_free(json);
+	kvfree(reply);
+#ifdef CONFIG_9P_FS_HOMELABFS_CONTROLLED
+	hfs_completion_put(completion);
+#endif
+	return err;
+unlock:
+	mutex_unlock(&session->lock);
+	mutex_unlock(&session->writer);
+#ifdef CONFIG_9P_FS_HOMELABFS_CONTROLLED
+	hfs_controlled_received_release(session, response_credit);
+#endif
+	carrier_credit = candidate->reservation;
+	hfs_buf_free(&command);
+	kfree(candidate);
+	if (carrier_credit)
+		session->provider->unreserve(session, carrier_credit);
+#ifdef CONFIG_9P_FS_HOMELABFS_CONTROLLED
+	hfs_completion_put(completion);
+#endif
+	return err;
+}
+EXPORT_SYMBOL_GPL(hfs_control_flagged);
+
+int hfs_control(struct hfs_session *session, const char *operation, const struct hfs_buf *payload,
+		bool reserved, struct hfs_json **out)
+{
+	return hfs_control_flagged(session, operation, payload, reserved,
+				   hfs_after_block_operation(operation), out);
+}
+EXPORT_SYMBOL_GPL(hfs_control);
+
+static int hfs_copy_token(const struct hfs_json *source, int token,
+			  struct hfs_json **out)
+{
+	return hfs_received_copy(source, token, out);
+}
+
+int hfs_result_code(const struct hfs_json *json)
+{
+	static const struct { const char *name; int error; } codes[] = {
+		{ "OK", 0 }, { "Invalid", -EINVAL }, { "NotFound", -ENOENT },
+		{ "Exists", -EEXIST }, { "Permission", -EACCES },
+		{ "ReadOnlyFS", -EROFS }, { "NotDirectory", -ENOTDIR },
+		{ "IsDirectory", -EISDIR }, { "NotEmpty", -ENOTEMPTY },
+		{ "CrossDevice", -EXDEV }, { "Unsupported", -EOPNOTSUPP },
+		{ "NoSpace", -ENOSPC }, { "Quota", -EDQUOT }, { "IO", -EIO },
+		{ "Unavailable", -EHOSTDOWN }, { "Stale", -ESTALE },
+		{ "Interrupted", -EINTR }, { "Busy", -EBUSY },
+		{ "WouldBlock", -EAGAIN }, { "TooManyLinks", -EMLINK },
+		{ "NameTooLong", -ENAMETOOLONG }, { "FileTooLarge", -EFBIG },
+		{ "ID_CONFLICT", -EPROTO },
+		{ "RETIRED_ID", -ESTALE }, { "PROTOCOL_ERROR", -EPROTO },
+	};
+	char code[32];
+	u32 i;
+
+	if (hfs_json_string(json, hfs_json_field(json, 0, "code"), code,
+			    sizeof(code)) < 0)
+		return -EPROTO;
+	for (i = 0; i < ARRAY_SIZE(codes); i++)
+		if (!strcmp(codes[i].name, code))
+			return codes[i].error;
+	return -EPROTO;
+}
+
+static int hfs_result_validate(struct hfs_session *session, struct hfs_json *result,
+			       const char *opcode, const struct hfs_buf *credentials)
+{
+	static const char *const fields[] = {
+		"attributes", "capabilities", "capacity", "code",
+		"count",      "data",	      "entries",  "publication",
+	};
+	struct hfs_buf original;
+	u8 expected[32], actual[32];
+	u32 len = 32, i;
+	int err, publication, array;
+	u32 caps = 0, wanted;
+	struct hfs_attr root_attr;
+	u8 credential_hash[32], empty_ancestors[32], root_token[32];
+	const char *kind;
+	u64 count;
+
+	if (hfs_json_exact(result, 0,
+			   "attributes,capabilities,capacity,code,count,data,entries,"
+			   "id,publication") ||
+	    hfs_json_hex(result, hfs_json_field(result, 0, "id"), expected, &len) || len != 32 ||
+	    hfs_field_u64(result, 0, "count", &count))
+		return -EPROTO;
+	err = hfs_buf_init(&original, HFS_BODY_MAX);
+	if (err)
+		return err;
+	hfs_buf_literal(&original, "{");
+	for (i = 0; i < ARRAY_SIZE(fields); i++) {
+		hfs_buf_printf(&original, "%s\"%s\":", i ? "," : "", fields[i]);
+		hfs_buf_token(&original, result, hfs_json_field(result, 0, fields[i]));
+	}
+	hfs_buf_literal(&original, "}");
+	err = original.error;
+	if (!err) {
+		hfs_hash(original.data, original.len, actual);
+		if (memcmp(expected, actual, 32))
+			err = -EPROTO;
+	}
+	hfs_buf_free(&original);
+	if (err)
+		return err;
+	err = hfs_result_code(result);
+	if (err &&
+	    (count || !hfs_json_is(result, hfs_json_field(result, 0, "attributes"), "null") ||
+	     !hfs_json_is(result, hfs_json_field(result, 0, "capacity"), "null") ||
+	     !hfs_json_is(result, hfs_json_field(result, 0, "capabilities"), "[]") ||
+	     !hfs_json_is(result, hfs_json_field(result, 0, "entries"), "[]") ||
+	     !hfs_json_is(result, hfs_json_field(result, 0, "data"), "\"\"")))
+		return -EPROTO;
+	array = hfs_json_field(result, 0, "capabilities");
+	if (array < 0 || result->tokens[array].kind != HFS_ARRAY)
+		return -EPROTO;
+	hfs_hash(credentials->data, credentials->len, credential_hash);
+	hfs_hash("[]", 2, empty_ancestors);
+	wanted = !strcmp(opcode, "CREATE") || !strcmp(opcode, "ROOT") ? 2 :
+		 !strcmp(opcode, "LOOKUP") || !strcmp(opcode, "OPEN") || !strcmp(opcode, "MKDIR") ||
+				 !strcmp(opcode, "SYMLINK") ?
+									1 :
+									0;
+	if (err)
+		wanted = 0;
+	for (i = array + 1; i < result->count; i++) {
+		struct hfs_cap *cap = NULL;
+		int field;
+
+		if (result->tokens[i].parent != array)
+			continue;
+		if (++caps > wanted)
+			return -EPROTO;
+		field = hfs_json_field(result, i, "kind");
+		kind = !strcmp(opcode, "ROOT") ? (caps == 1 ? "ROOT" : "DOMAIN") :
+		       !strcmp(opcode, "OPEN") ? "DESCRIPTION" :
+						 "PATH";
+		if (!strcmp(opcode, "CREATE") && hfs_json_is(result, field, "\"DESCRIPTION\""))
+			kind = "DESCRIPTION";
+		if (hfs_cap_parse(session, result, i, kind, &cap))
+			return -EPROTO;
+		if (memcmp(cap->credential_hash, credential_hash, 32)) {
+			hfs_cap_free(cap);
+			return -EPROTO;
+		}
+		if (!strcmp(opcode, "ROOT")) {
+			if (cap->rights != (caps == 1 ? 63 : 0) ||
+			    memcmp(cap->ancestors_hash, empty_ancestors, 32)) {
+				hfs_cap_free(cap);
+				return -EPROTO;
+			}
+			if (caps == 1) {
+				err = hfs_attr_decode(result,
+						      hfs_json_field(result, 0, "attributes"),
+						      &cap->home, &cap->allocation, S_IFDIR,
+						      &root_attr);
+				memcpy(root_token, cap->token, 32);
+			} else if (!uuid_equal(&cap->home, &root_attr.home) ||
+				   !uuid_equal(&cap->allocation, &root_attr.allocation) ||
+				   !memcmp(root_token, cap->token, 32)) {
+				err = -EPROTO;
+			}
+			if (err || cap->revision != root_attr.revision) {
+				hfs_cap_free(cap);
+				return -EPROTO;
+			}
+		}
+		hfs_cap_free(cap);
+	}
+	if (caps != wanted)
+		return -EPROTO;
+	publication = hfs_json_field(result, 0, "publication");
+	return session->provider->publication(session, result, publication);
+}
+
+static void hfs_request_result_put(void *owner)
+{
+	struct hfs_request *request = owner;
+	struct hfs_session *session = request->session;
+
+	mutex_lock(&session->lock);
+	if (!WARN_ON_ONCE(!request->users))
+		request->users--;
+	mutex_unlock(&session->lock);
+}
+
+/* The same exact full original is used for allocation, CALL and GAP. */
+static int hfs_request_payload(struct hfs_request *request, struct hfs_buf *payload)
+{
+	payload->len = 0;
+	payload->error = 0;
+	hfs_buf_literal(payload, "{\"claim\":");
+	hfs_buf_add(payload, request->claim.data, request->claim.len);
+	hfs_buf_literal(payload, ",\"credentials\":");
+	hfs_buf_add(payload, request->credentials.data, request->credentials.len);
+	hfs_buf_literal(payload, ",\"intent\":");
+	hfs_buf_add(payload, request->intent.data, request->intent.len);
+	hfs_buf_literal(payload, "}");
+	if (payload->error)
+		return payload->error;
+	return 0;
+}
+
+/* hh4: the request was listed in an ABANDON (request->abandoning). The
+ * guest promised the host never to send another CALL or QUERY for it, so
+ * hfs_request_run checks this before each one; -EHOSTDOWN, as for any send
+ * a blocked session halts. Independent of timing: a request can be listed
+ * while its caller is between two exchanges.
+ */
+static int hfs_request_abandon_halt(struct hfs_session *session, struct hfs_request *request)
+{
+	bool abandoning;
+
+	mutex_lock(&session->lock);
+	abandoning = request->abandoning;
+	mutex_unlock(&session->lock);
+	return abandoning ? -EHOSTDOWN : 0;
+}
+
+/* Caller holds session->lock: the allocation fence or its waiter queue
+ * changed. The caller wakes allocation_wait after unlocking (x84).
+ */
+static void hfs_allocation_changed_locked(struct hfs_session *session)
+{
+	session->allocation_epoch++;
+}
+
+/* Wake every hfs_call waiter to re-check the fence (x84). */
+static void hfs_allocation_wake(struct hfs_session *session)
+{
+	mutex_lock(&session->lock);
+	hfs_allocation_changed_locked(session);
+	mutex_unlock(&session->lock);
+	wake_up_all(&session->allocation_wait);
+}
+
+int hfs_request_allocate(struct hfs_session *session,
+			 struct hfs_request *request, struct hfs_buf *payload)
+{
+	struct hfs_json *reply = NULL;
+	int err, token, claim;
+
+	if (!request || request->session != session)
+		return -EINVAL;
+	if (session->bridge_minor < 2 || request->earmarked)
+		return 0;
+	mutex_lock(&session->lock);
+	if (request->allocating) {
+		mutex_unlock(&session->lock);
+		return -EAGAIN;
+	}
+	if (request->allocated) {
+		mutex_unlock(&session->lock);
+		return 0;
+	}
+	if (session->allocation_pending != request) {
+		mutex_unlock(&session->lock);
+		return -EBUSY;
+	}
+	request->allocating = true;
+	mutex_unlock(&session->lock);
+	err = hfs_request_payload(request, payload);
+	if (!err)
+		err = hfs_control(session, "ALLOCATE", payload, false, &reply);
+	if (err)
+		goto out;
+	token = hfs_json_field(reply, 0, "payload");
+	claim = hfs_json_field(reply, token, "claim");
+	if (hfs_json_exact(reply, token, "claim,status") || claim < 0 ||
+	    !hfs_json_is(reply, hfs_json_field(reply, token, "status"), "\"ALLOCATED\"") ||
+	    reply->tokens[claim].end - reply->tokens[claim].start != request->claim.len ||
+	    memcmp(reply->data + reply->tokens[claim].start,
+		   request->claim.data, request->claim.len)) {
+		err = -EPROTO;
+		goto out;
+	}
+	mutex_lock(&session->lock);
+	request->allocated = true;
+	request->allocation_receipt = reply;
+	reply = NULL;
+	session->allocation_pending = NULL;
+	mutex_unlock(&session->lock);
+out:
+	mutex_lock(&session->lock);
+	request->allocating = false;
+	if (err)
+		request->allocation_failed = true;
+	/* Cleared, failed or uncertain: waiters re-check either way (x84). */
+	hfs_allocation_changed_locked(session);
+	mutex_unlock(&session->lock);
+	wake_up_all(&session->allocation_wait);
+	/* Never clear pending on uncertain acknowledgement or change its bytes.
+	 * allocation_failed only tells waiting hfs_call callers (x84) that this
+	 * fence no longer clears by itself; a later exact retry (the controlled
+	 * harnesses replay one) still clears pending normally.
+	 */
+	hfs_json_free(reply);
+	return err;
+}
+EXPORT_SYMBOL_GPL(hfs_request_allocate);
+
+int hfs_request_resolve_gap(struct hfs_session *session, struct hfs_request *request)
+{
+	struct hfs_buf payload = {};
+	struct hfs_json *reply = NULL, *proof = NULL;
+	u8 digest[32];
+	u32 len = sizeof(digest);
+	int err, token, claim;
+
+	/* hh4: a request listed in an ABANDON gets a GAP_RESOLVE only when the
+	 * host answered ABANDONED (gap is then set; the GAP_RESOLVE returns the
+	 * same proof). One it kept stays retained, as promised.
+	 */
+	if (session->bridge_minor < 2 || request->earmarked || !request->allocated ||
+	    request->terminal || request->users || request->held ||
+	    (request->abandoning && !request->gap))
+		return -EINVAL;
+	err = hfs_buf_init(&payload, HFS_BODY_MAX);
+	if (!err)
+		err = hfs_request_payload(request, &payload);
+	if (!err)
+		err = hfs_control(session, "GAP_RESOLVE", &payload, true, &reply);
+	if (err)
+		goto out;
+	token = hfs_json_field(reply, 0, "payload");
+	claim = hfs_json_field(reply, token, "claim");
+	if (hfs_json_exact(reply, token, "claim,proof_hash,status") || claim < 0 ||
+	    !hfs_json_is(reply, hfs_json_field(reply, token, "status"), "\"GAP\"") ||
+	    hfs_json_hex(reply, hfs_json_field(reply, token, "proof_hash"), digest, &len) ||
+	    len != 32 ||
+	    reply->tokens[claim].end - reply->tokens[claim].start != request->claim.len ||
+	    memcmp(reply->data + reply->tokens[claim].start, request->claim.data,
+		   request->claim.len)) {
+		err = -EPROTO;
+		goto out;
+	}
+	/* A protected component receipt is not a verified runtime floor. The
+   * mandatory provider consumes its own source/floor evidence separately.
+   */
+	err = hfs_copy_token(reply, token, &proof);
+	if (!err) {
+		mutex_lock(&session->lock);
+		hfs_json_free(request->refusal);
+		request->refusal = proof;
+		if (!request->gap_response) {
+			request->gap_response = reply;
+			reply = NULL;
+		}
+		request->gap = true;
+		mutex_unlock(&session->lock);
+	}
+out:
+	hfs_json_free(reply);
+	hfs_buf_free(&payload);
+	return err;
+}
+EXPORT_SYMBOL_GPL(hfs_request_resolve_gap);
+
+/* hh4: a blocked session abandons its stranded claims.
+ *
+ * After hfs_request_run gives up on a claim (QUERY timeout, lost reply), the
+ * claim stays retained and the session blocked. If the host never prepared
+ * it (RESERVED/UNPREPARED, or ALLOCATED and never called), it still holds
+ * credit that the host cannot return on its own: nothing it sees proves the
+ * guest gave up. ABANDON is that proof (docs/design/hh4-abandon.md): the
+ * guest names its uncertain claims and promises never to send another CALL
+ * or QUERY for them (request->abandoning). The host answers each one:
+ * ABANDONED (now a protected gap with its proof; credit returned), KEPT (it
+ * may have had an effect), RETIRED_ID or UNKNOWN. Only ABANDONED changes
+ * guest state: the request becomes a gap, which hfs_retire resolves and
+ * retires through the existing GAP_RESOLVE path.
+ *
+ * A host or exporter without ABANDON refuses it before any host state is
+ * touched, so the claims simply stay retained, as before hh4.
+ */
+
+/* A request the session may give up on: its ALLOCATE was acknowledged (the
+ * host knows the claim), it has no terminal result or gap proof, it was
+ * never listed before, and no drain (earmarked, held, control) and no
+ * caller (users) owns it. A request skipped for users or held is left to
+ * kill_sb's final pass.
+ */
+static bool hfs_abandon_eligible(const struct hfs_request *request)
+{
+	return request->allocated && !request->terminal && !request->gap &&
+	       !request->abandoning && !request->earmarked && !request->control &&
+	       !request->held && !request->users;
+}
+
+/* Caller holds session->lock. Mark at most HFS_ABANDON_MAX eligible requests
+ * abandoning, in ascending claim order, and write the closed ABANDON payload
+ * {anchor, claims:[{number, original_hash}], nonce, realm, subject} from
+ * copies; numbers receives their claim numbers. No request pointer outlives
+ * the lock. The original hash is the claim's own: the hash of the request's
+ * intent (hfs_call_prepare). Returns the number listed, 0 when none is left.
+ */
+static u32 hfs_abandon_collect_locked(struct hfs_session *session, struct hfs_buf *payload,
+				      u64 *numbers)
+{
+	struct hfs_request *request;
+	u8 digest[32];
+	u32 count = 0;
+
+	payload->len = 0;
+	payload->error = 0;
+	hfs_buf_printf(payload, "{\"anchor\":\"%pUb\",\"claims\":[", &session->enrollment.anchor);
+	list_for_each_entry(request, &session->requests, list) {
+		if (count == HFS_ABANDON_MAX)
+			break;
+		if (!hfs_abandon_eligible(request) ||
+		    (count && request->number <= numbers[count - 1]))
+			continue;
+		hfs_hash(request->intent.data, request->intent.len, digest);
+		hfs_buf_printf(payload, "%s{\"number\":%llu,\"original_hash\":", count ? "," : "",
+			       request->number);
+		hfs_buf_hex(payload, digest, sizeof(digest));
+		hfs_buf_literal(payload, "}");
+		request->abandoning = true;
+		numbers[count++] = request->number;
+	}
+	hfs_buf_printf(payload, "],\"nonce\":\"%pUb\",\"realm\":\"%pUb\",\"subject\":",
+		       &session->enrollment.nonce, &session->enrollment.realm);
+	hfs_buf_hex(payload, session->enrollment.subject, session->enrollment.subject_len);
+	hfs_buf_literal(payload, "}");
+	return count;
+}
+
+/* One ABANDON outcome {number, proof_hash, status}: the listed number, and a
+ * 32-byte proof exactly on ABANDONED (null otherwise).
+ */
+static int hfs_abandon_outcome(const struct hfs_json *reply, int outcome, u64 number,
+			       bool *abandoned)
+{
+	int status = hfs_json_field(reply, outcome, "status");
+	int proof = hfs_json_field(reply, outcome, "proof_hash");
+	u8 hash[32];
+	u32 length = sizeof(hash);
+	u64 value;
+
+	if (hfs_json_exact(reply, outcome, "number,proof_hash,status") ||
+	    hfs_json_u64(reply, hfs_json_field(reply, outcome, "number"), &value) ||
+	    value != number)
+		return -EPROTO;
+	*abandoned = hfs_json_is(reply, status, "\"ABANDONED\"");
+	if (*abandoned)
+		return hfs_json_hex(reply, proof, hash, &length) || length != sizeof(hash) ?
+			       -EPROTO : 0;
+	if (!hfs_json_is(reply, proof, "null") ||
+	    (!hfs_json_is(reply, status, "\"KEPT\"") &&
+	     !hfs_json_is(reply, status, "\"RETIRED_ID\"") &&
+	     !hfs_json_is(reply, status, "\"UNKNOWN\"")))
+		return -EPROTO;
+	return 0;
+}
+
+/* The exact closed reply: verification null (ABANDON grants no source,
+ * event or floor authority) and {claims:[...]} with one outcome per listed
+ * number, in request order. Anything else applies nothing.
+ */
+static int hfs_abandon_check(const struct hfs_json *reply, const u64 *numbers, u32 count,
+			     bool *abandoned)
+{
+	int payload = hfs_json_field(reply, 0, "payload");
+	int claims = hfs_json_field(reply, payload, "claims");
+	u32 i, n = 0;
+	int err;
+
+	if (!hfs_json_is(reply, hfs_json_field(reply, 0, "verification"), "null") ||
+	    hfs_json_exact(reply, payload, "claims") || claims < 0 ||
+	    reply->tokens[claims].kind != HFS_ARRAY)
+		return -EPROTO;
+	for (i = claims + 1; i < reply->count; i++) {
+		if (reply->tokens[i].parent != claims)
+			continue;
+		if (n == count)
+			return -EPROTO;
+		err = hfs_abandon_outcome(reply, i, numbers[n], &abandoned[n]);
+		if (err)
+			return err;
+		n++;
+	}
+	return n == count ? 0 : -EPROTO;
+}
+
+/* Send one ABANDON. A lost or uncertain exchange is resent once with the
+ * identical payload (the host answers a replay from the same ledger state)
+ * unless the host stopped answering (transport_failed) or the refusal is
+ * definite: -EPROTO is an exporter ERROR INVALID/SCOPE (an exporter without
+ * ABANDON refuses it so) or a malformed reply, -ESTALE a retired cell, and
+ * the rest are local refusals before any send. Resending those would only
+ * park another control cell. Never falls back to QUERY.
+ */
+static int hfs_abandon_exchange(struct hfs_session *session, const struct hfs_buf *payload,
+				struct hfs_json **reply)
+{
+	int err = hfs_control(session, "ABANDON", payload, true, reply);
+
+	if (err && err != -EPROTO && err != -ESTALE && err != -EOPNOTSUPP && err != -EINVAL &&
+	    err != -EACCES && !READ_ONCE(session->transport_failed))
+		err = hfs_control(session, "ABANDON", payload, true, reply);
+	return err;
+}
+
+/* Apply a checked reply under session->lock. Requests are looked up by
+ * number (both lists ascend): one that is gone was retired meanwhile. Only
+ * ABANDONED changes anything: the request becomes a gap, retired later by
+ * hfs_retire's GAP_RESOLVE path. One whose own in-flight exchange delivered
+ * TERMINAL meanwhile keeps its result (the host then answered KEPT anyway).
+ * Every listed request stays abandoning.
+ */
+static void hfs_abandon_apply(struct hfs_session *session, const u64 *numbers,
+			      const bool *abandoned, u32 count)
+{
+	struct hfs_request *request;
+	u32 i = 0;
+
+	mutex_lock(&session->lock);
+	list_for_each_entry(request, &session->requests, list) {
+		while (i < count && numbers[i] < request->number)
+			i++;
+		if (i == count)
+			break;
+		if (numbers[i] == request->number && abandoned[i] && !request->terminal)
+			request->gap = true;
+	}
+	mutex_unlock(&session->lock);
+}
+
+/* hh4: one abandon pass of a blocked controlled session: ABANDON batches of
+ * its eligible requests until none is left or an exchange fails. Each
+ * request is listed at most once per session, so the pass ends. Runs from
+ * abandon_work and once more, synchronously, from kill_sb. It needs no slot
+ * of session->control: the exchange runs in the calling thread.
+ */
+static void hfs_session_abandon(struct hfs_session *session)
+{
+	u64 numbers[HFS_ABANDON_MAX];
+	bool abandoned[HFS_ABANDON_MAX];
+	struct hfs_json *reply;
+	struct hfs_buf payload;
+	u32 count;
+	int err = 0;
+
+	if (session->bridge_minor < 2 || !READ_ONCE(session->blocked) ||
+	    hfs_buf_init(&payload, HFS_ABANDON_PAYLOAD))
+		return;
+	for (;;) {
+		mutex_lock(&session->lock);
+		count = hfs_abandon_collect_locked(session, &payload, numbers);
+		mutex_unlock(&session->lock);
+		if (!count)
+			break;
+		reply = NULL;
+		err = payload.error ?: hfs_abandon_exchange(session, &payload, &reply);
+		if (!err)
+			err = hfs_abandon_check(reply, numbers, count, abandoned);
+		if (!err)
+			hfs_abandon_apply(session, numbers, abandoned, count);
+		hfs_json_free(reply);
+		if (err)
+			break;
+	}
+	if (err)
+		pr_warn("9p-hfs: session %pUb ABANDON of %u claims failed (%d); they stay retained\n",
+			&session->enrollment.session, count, err);
+	hfs_buf_free(&payload);
+}
+
+static void hfs_session_abandon_work(struct work_struct *work)
+{
+	hfs_session_abandon(container_of(work, struct hfs_session, abandon_work));
+}
+
+/* Caller owns the request lifetime while copying its immutable result. */
+static int hfs_request_result_borrow(struct hfs_request *request, struct hfs_json **out)
+{
+	int err = hfs_copy_token(request->result, 0, out);
+
+	if (!err) {
+		mutex_lock(&request->session->lock);
+		request->users++;
+		(*out)->owner = request;
+		(*out)->owner_put = hfs_request_result_put;
+		mutex_unlock(&request->session->lock);
+	}
+	return err;
+}
+
+static int hfs_request_run(struct hfs_session *session, struct hfs_request *request,
+			   const char *opcode, struct hfs_buf *payload, struct hfs_json **out)
+{
+	struct hfs_json *reply = NULL, *result = NULL, *received;
+	unsigned long deadline = jiffies + 30 * HZ;
+	/* Transport classes follow command semantics, independently of the
+   * local request admission reserve. Only DRAIN_WRITE is a control CALL.
+   */
+	bool control = session->bridge_minor >= 2 ? request->earmarked :
+						    !strcmp(opcode, "DRAIN_WRITE");
+	int err, token, status, claim;
+
+	/* A received terminal snapshot is immutable even when its mandatory
+   * verifier refused adoption. Revalidate that same envelope without a
+   * second CALL, allocation, source assertion or substituted response.
+   */
+	if (session->bridge_minor >= 2 && request->response) {
+		received = request->response;
+		token = hfs_json_field(received, 0, "payload");
+		goto result_snapshot;
+	}
+	err = hfs_request_allocate(session, request, payload);
+	if (err)
+		return err; /* allocation_pending fences all subsequent issuance */
+	err = hfs_request_payload(request, payload);
+	if (!err)
+		err = hfs_request_abandon_halt(session, request); /* hh4 */
+	if (err)
+		goto retained;
+	err = hfs_control_flagged(session, "CALL", payload, control,
+				  hfs_after_block_operation(opcode), &reply);
+	if (err)
+		goto retained;
+	token = hfs_json_field(reply, 0, "payload");
+	claim = hfs_json_field(reply, token, "claim");
+	status = hfs_json_field(reply, token, "status");
+	if (hfs_json_exact(reply, token, "claim,code,status") || claim < 0 ||
+	    reply->tokens[claim].end - reply->tokens[claim].start != request->claim.len ||
+	    memcmp(reply->data + reply->tokens[claim].start, request->claim.data,
+		   request->claim.len)) {
+		err = -EPROTO;
+		goto retained;
+	}
+	if (!hfs_json_is(reply, status, "\"ADMITTED\"")) {
+		/* Rejected/unissued numbers need protected no-effect gap evidence
+     * before a retirement floor can pass them. Keep the original bytes.
+     */
+		if (!hfs_json_is(reply, status, "\"REJECTED\"")) {
+			err = -EPROTO;
+			goto retained;
+		}
+		err = hfs_copy_token(reply, token, &result);
+		if (err)
+			goto retained;
+		err = hfs_result_code(result);
+		hfs_json_free(result);
+		request->refusal = reply;
+		request->gap = true;
+		return err ?: -EPROTO;
+	}
+	if (!hfs_json_is(reply, hfs_json_field(reply, token, "code"), "\"OK\"")) {
+		err = -EPROTO;
+		goto retained;
+	}
+	hfs_json_free(reply);
+	reply = NULL;
+	payload->len = 0;
+	hfs_buf_literal(payload, "{\"claim\":");
+	hfs_buf_add(payload, request->claim.data, request->claim.len);
+	hfs_buf_literal(payload, "}");
+	for (;;) {
+		/* hh4: no QUERY for a request listed in an ABANDON. */
+		err = hfs_request_abandon_halt(session, request);
+		if (!err)
+			err = hfs_control_flagged(session, "QUERY", payload, true,
+						  hfs_after_block_operation(opcode), &reply);
+		if (err)
+			goto retained;
+		token = hfs_json_field(reply, 0, "payload");
+		claim = hfs_json_field(reply, token, "claim");
+		status = hfs_json_field(reply, token, "status");
+		if (hfs_json_exact(reply, token, "claim,result,status") || claim < 0 ||
+		    reply->tokens[claim].end - reply->tokens[claim].start != request->claim.len ||
+		    memcmp(reply->data + reply->tokens[claim].start, request->claim.data,
+			   request->claim.len)) {
+			err = -EPROTO;
+			goto retained;
+		}
+		if (hfs_json_is(reply, status, "\"TERMINAL\""))
+			break;
+		if ((!hfs_json_is(reply, status, "\"PENDING\"") &&
+		     !hfs_json_is(reply, status, "\"INDETERMINATE\"")) ||
+		    !hfs_json_is(reply, hfs_json_field(reply, token, "result"), "null")) {
+			err = -EPROTO;
+			goto retained;
+		}
+		hfs_json_free(reply);
+		reply = NULL;
+		if (time_after_eq(jiffies, deadline)) {
+			err = -ETIMEDOUT;
+			goto retained;
+		}
+		usleep_range(10000, 12000);
+		/* oc4: no further QUERY round once the session is blocked. */
+		err = hfs_session_poll_halt(session, hfs_after_block_operation(opcode));
+		if (err)
+			goto retained;
+	}
+	received = reply;
+	if (session->bridge_minor >= 2) {
+		/* Preserve the actual full envelope, including exact host receipt and
+     * transport metadata, even when the missing verifier refuses result
+     * adoption. Never replace it with a caller-created receipt object.
+     */
+		mutex_lock(&session->lock);
+		if (!request->response) {
+			request->response = reply;
+			reply = NULL;
+		}
+		received = request->response;
+		mutex_unlock(&session->lock);
+		token = hfs_json_field(received, 0, "payload");
+	}
+result_snapshot:
+	err = hfs_copy_token(received, hfs_json_field(received, token, "result"), &result);
+	if (!err)
+		err = hfs_result_validate(session, result, opcode, &request->credentials);
+	if (err)
+		goto retained;
+	/* Existing canonical snapshots remain immutable while callers hold the
+	 * request. Revalidate the retained response above, then discard only the
+	 * identical duplicate; replacing the canonical would race its borrowers.
+	 */
+	if (request->result) {
+		if (request->result->len != result->len ||
+		    memcmp(request->result->data, result->data, result->len)) {
+			err = -EPROTO;
+			goto retained;
+		}
+		hfs_json_free(result);
+	} else {
+		request->result = result;
+	}
+	result = NULL;
+	err = hfs_request_result_borrow(request, out);
+	mutex_lock(&session->lock);
+	request->adopted = !hfs_result_needs_adoption(request->result);
+	request->terminal = true;
+	mutex_unlock(&session->lock);
+	if (!err)
+		err = hfs_result_code(*out);
+	hfs_json_free(reply);
+	return err;
+retained:
+	/* An uncertain claim outlives caller cancellation and process exit.
+	 * ETIMEDOUT is the 30 s QUERY deadline (zq3-r7 R7-2: a claim the host
+	 * left RESERVED/UNPREPARED stays INDETERMINATE); anything else is a
+	 * failed or malformed CALL/QUERY exchange.
+	 */
+	hfs_session_block(session, err == -ETIMEDOUT ? "QUERY timeout" :
+			  "uncertain claim result", opcode, err);
+	hfs_json_free(reply);
+	hfs_json_free(result);
+	return err;
+}
+
+/* The ordinary number/credentials/resources are durable obligations before a
+ * writable PTE. The future byte hash is deliberately absent until freeze.
+ */
+int hfs_request_earmark(struct hfs_session *session, const struct hfs_cred *cred,
+			struct hfs_view_ticket *ticket, struct hfs_request **out)
+{
+	struct hfs_request *request;
+	int err;
+
+	*out = NULL;
+	if (!cred || !ticket || ticket->control || ticket->session != session)
+		return -EINVAL;
+	request = kzalloc(sizeof(*request), GFP_KERNEL);
+	if (!request)
+		return -ENOMEM;
+	request->session = session;
+	/* Sixteen dirty packages, independently capped from 128 clean pages.
+   * This is the existing full request/transport credit, never 128 copies.
+   */
+	err = session->provider->reserve(
+		session, (hfs_controlled_consumed(session) ? 4ULL : 16ULL) * 1024 * 1024, true,
+		&request->reservation);
+	if (err)
+		goto allocation;
+	err = hfs_completion_new(session, true, false, HFS_CONTEXT_MAX + 4096 + 1024,
+				 &request->completion);
+	if (err)
+		goto free;
+	if (hfs_buf_init(&request->claim, 4096) || hfs_buf_init(&request->earmark_number, 4096) ||
+	    hfs_buf_init(&request->intent, 32768) || hfs_buf_init(&request->credentials, 16384) ||
+	    hfs_buf_init(&request->original_context, HFS_CONTEXT_MAX) ||
+	    hfs_buf_init(&request->drain_payload, HFS_BODY_MAX)) {
+		err = -ENOMEM;
+		goto free;
+	}
+	hfs_cred_write(&request->credentials, cred);
+	if (request->credentials.error ||
+	    request->credentials.len != ticket->family->credentials.len ||
+	    memcmp(request->credentials.data, ticket->family->credentials.data,
+		   request->credentials.len)) {
+		err = request->credentials.error ?: -EACCES;
+		goto free;
+	}
+	mutex_lock(&session->lock);
+	/* An earmark also yields to queued hfs_call waiters (x84 FIFO); the
+	 * faulting caller retries -EAGAIN itself.
+	 */
+	err = session->allocation_pending || !list_empty(&session->allocation_waiters) ?
+		      -EAGAIN :
+		      hfs_request_admit(session->blocked, true,
+					session->nr_requests - session->nr_control_requests,
+					session->nr_control_requests, session->next_claim);
+	if (err) {
+		mutex_unlock(&session->lock);
+		goto free;
+	}
+	request->control = true;
+	request->earmarked = true;
+	request->held = true;
+	request->earmark_ticket = ticket;
+	if (session->bridge_minor >= 2)
+		session->allocation_pending = request;
+	ticket->users++;
+	request->number = session->next_claim++;
+	uuid_gen(&request->operation);
+	hfs_buf_add(&request->original_context, session->enrollment.context,
+		    session->enrollment.context_len);
+	hfs_buf_printf(&request->earmark_number,
+		       "{\"anchor\":\"%pUb\",\"nonce\":\"%pUb\",\"number\":%llu,"
+		       "\"realm\":\"%pUb\",\"subject\":",
+		       &session->enrollment.anchor, &session->enrollment.nonce, request->number,
+		       &session->enrollment.realm);
+	hfs_buf_hex(&request->earmark_number, session->enrollment.subject,
+		    session->enrollment.subject_len);
+	hfs_buf_literal(&request->earmark_number, "}");
+	list_add_tail(&request->list, &session->requests);
+	session->nr_requests++;
+	session->nr_control_requests++;
+	mutex_unlock(&session->lock);
+	*out = request;
+	return 0;
+free:
+	hfs_buf_free(&request->claim);
+	hfs_buf_free(&request->intent);
+	hfs_buf_free(&request->credentials);
+	hfs_buf_free(&request->original_context);
+	hfs_buf_free(&request->earmark_number);
+	hfs_buf_free(&request->drain_payload);
+	hfs_buf_free(&request->readdir_cleanup);
+	hfs_completion_close(request->completion);
+	session->provider->unreserve(session, request->reservation);
+allocation:
+	kfree(request);
+	return err;
+}
+
+int hfs_request_cancel_earmark(struct hfs_session *session, struct hfs_request *request)
+{
+	struct hfs_view_ticket *ticket = request->earmark_ticket;
+	struct hfs_json *original = NULL, *response = NULL;
+	int number, err;
+
+	/* A bound DRAIN_WRITE is an immutable byte obligation. Only never-bound
+   * reservations may acquire this typed no-effect ordinary gap proof.
+   */
+	if (!request->earmarked || request->bound || !ticket || !ticket->bound ||
+	    strcmp(ticket->operation, "DIRTY_RESERVE"))
+		return -EINVAL;
+	err = hfs_json_parse(ticket->payload.data, ticket->payload.len, &original);
+	if (err)
+		return err;
+	number = hfs_json_field(original, 0, "claim_number");
+	if (number < 0 ||
+	    original->tokens[number].end - original->tokens[number].start !=
+		    request->earmark_number.len ||
+	    memcmp(original->data + original->tokens[number].start, request->earmark_number.data,
+		   request->earmark_number.len))
+		err = -EPROTO;
+	hfs_json_free(original);
+	if (err)
+		return err;
+	err = hfs_view_query(session, ticket, true, &response);
+	if (err)
+		return err;
+	if (!hfs_json_is(response, hfs_json_field(response, 0, "status"), "\"CANCELLED\"")) {
+		hfs_json_free(response);
+		return -EAGAIN;
+	}
+	/* query verified exact original Ticket, operation, request hash and
+   * protected response self-id. Host atomically binds this same id to
+   * this ordinary Number before returning CANCELLED. No Claim invented.
+   */
+	mutex_lock(&session->lock);
+	if (!request->terminal) {
+		request->result = response;
+		response = NULL;
+		request->gap = true;
+		request->terminal = true;
+		request->adopted = true;
+		if (session->allocation_pending == request) {
+			session->allocation_pending = NULL;
+			hfs_allocation_changed_locked(session);
+		}
+	}
+	mutex_unlock(&session->lock);
+	wake_up_all(&session->allocation_wait);
+	hfs_json_free(response);
+	return 0;
+}
+
+/* Called only after the production dirty-reservation decoder has checked the
+ * exact typed number, full credentials/scope and protected reservation bytes.
+ */
+void hfs_request_earmark_admitted(struct hfs_session *session,
+				struct hfs_request *request)
+{
+	mutex_lock(&session->lock);
+	if (request->earmarked && session->allocation_pending == request) {
+		session->allocation_pending = NULL;
+		hfs_allocation_changed_locked(session);
+	}
+	mutex_unlock(&session->lock);
+	wake_up_all(&session->allocation_wait);
+}
+
+void hfs_request_unhold(struct hfs_session *session, struct hfs_request *request)
+{
+	mutex_lock(&session->lock);
+	request->held = false;
+	mutex_unlock(&session->lock);
+}
+
+int hfs_request_bind_drain(struct hfs_session *session, struct hfs_request *request,
+			   const struct hfs_buf *args)
+{
+	u8 digest[32];
+
+	if (!request->earmarked || request->terminal || request->bound || args->error ||
+	    args->len + 64 > request->intent.cap)
+		return -EINVAL;
+	/* Freeze owns this never-published request; it cannot be a fresh CALL.
+   * The immutable intent and original full credentials survive writeback.
+   */
+	hfs_buf_literal(&request->intent, "{\"args\":");
+	hfs_buf_add(&request->intent, args->data, args->len);
+	hfs_buf_literal(&request->intent, ",\"opcode\":\"DRAIN_WRITE\"}");
+	hfs_hash(request->intent.data, request->intent.len, digest);
+	hfs_buf_printf(&request->claim,
+		       "{\"anchor\":\"%pUb\",\"nonce\":\"%pUb\",\"number\":%llu,"
+		       "\"original_hash\":",
+		       &session->enrollment.anchor, &session->enrollment.nonce, request->number);
+	hfs_buf_hex(&request->claim, digest, 32);
+	hfs_buf_printf(&request->claim,
+		       ",\"realm\":\"%pUb\",\"subject\":", &session->enrollment.realm);
+	hfs_buf_hex(&request->claim, session->enrollment.subject, session->enrollment.subject_len);
+	hfs_buf_literal(&request->claim, "}");
+	if (request->intent.error || request->claim.error)
+		return request->intent.error ?: request->claim.error;
+	request->bound = true;
+	return 0;
+}
+
+int hfs_request_drain(struct hfs_session *session, struct hfs_request *request,
+		      struct hfs_json **out)
+{
+	*out = NULL;
+	if (!request->earmarked || !request->bound || request->terminal)
+		return -EINVAL;
+	return hfs_request_run(session, request, "DRAIN_WRITE",
+			       &request->drain_payload, out);
+}
+
+/* The four cleanup opcodes. Their callers (final fput, flush, the FORGET and
+ * PROCESS_EXIT workers) cannot retry and treat any failure as uncertain.
+ */
+static bool hfs_cleanup_opcode(const char *opcode)
+{
+	return !strcmp(opcode, "DESCRIPTION_CLOSE") || !strcmp(opcode, "DESCRIPTION_RELEASE") ||
+	       !strcmp(opcode, "FORGET") || !strcmp(opcode, "PROCESS_EXIT");
+}
+
+/* Cleanup's local request slot is independent of its semantic byte class.
+ * Both admitted controlled tuples send these normal CALLs on the ordinary
+ * lane with full immutable replies. Fresh ordinary funding still requires
+ * admission before closing; reserved DRAIN requests use their own owners.
+ * Legacy and unknown tuples keep their existing resource classification.
+ */
+static bool hfs_call_control_bytes(const struct hfs_session *session, const char *opcode,
+				   bool control)
+{
+	bool controlled = session->bridge_minor == 4 &&
+		(session->enrollment.protocol_features == HFS_MAPPED_FEATURES ||
+		 session->enrollment.protocol_features == HFS_TERMINAL_FEATURES);
+
+	return control && !(controlled && hfs_cleanup_opcode(opcode));
+}
+
+/* x84 (zq3-r10 R10-1): a request may not be numbered while another request's
+ * ALLOCATE is unacknowledged (session->allocation_pending). Before x84 that
+ * was an immediate local -EAGAIN. No VFS caller retries it: userspace saw a
+ * spurious EAGAIN, and the cleanup callers blocked the session. At process
+ * exit the PROCESS_EXIT work (queued from do_exit before exit_files) holds
+ * the fence while the exiting task's final fput sends DESCRIPTION_RELEASE.
+ *
+ * A pending fence that is still clearing makes the caller sleep on
+ * session->allocation_wait, at most HFS_ALLOCATION_WAIT_MS (the guest's 30 s
+ * request window) in all; at the deadline the old -EAGAIN is returned.
+ * Waiters queue FIFO on session->allocation_waiters and only the head may
+ * number, so a stream of new callers cannot starve a cleanup waiter; new
+ * earmarks also yield to the queue. Every place the fence clears or turns
+ * non-clearing bumps allocation_epoch and wakes the queue: the end of each
+ * ALLOCATE attempt (acknowledged, failed or uncertain), the earmark
+ * admission and cancellation, retirement of the owner, a waiter leaving
+ * the queue, and kill_sb's closing. "Still clearing" means:
+ *
+ * - not allocation_uncertain: an uncertain ALLOCATE keeps its exact bytes
+ *   until reconciliation and must still fence (cleanup callers then block
+ *   the session as before);
+ * - not allocation_failed: nobody retries a failed ALLOCATE, waiting cannot
+ *   help;
+ * - not closing: kill_sb and its workqueue flush keep today's behaviour;
+ * - for an ordinary opcode, the owner is an ordinary hfs_call request (or
+ *   the fence is free and an earlier queued caller is about to number).
+ *   Its window is the ALLOCATE exchange that hfs_request_run starts at
+ *   once: one host round trip that takes no VFS, page or mmap lock, waits
+ *   on no workqueue and is not parked behind recalls on the host, so a
+ *   waiter holding i_rwsem or mmap_lock cannot stall it. An earmarked owner
+ *   (hfs_dirty_reserve) holds the fence across DIRTY_RESERVE and, after a
+ *   refusal, until the cleanup worker resumes or cancels it, which depends
+ *   on recalls and view STOP; an ordinary caller holding VFS locks keeps
+ *   the immediate -EAGAIN there (the mmap fault path retries it itself).
+ *   Cleanup callers hold no VFS lock (__fput, filp_close, the control
+ *   workqueue; READDIR's FORGET holds only the directory's shared i_rwsem,
+ *   which no earmark path takes), so they also wait for an earmark.
+ *
+ * Ordinary callers sleep killable and give up with -EAGAIN on a fatal
+ * signal; cleanup callers sleep uninterruptibly, since they cannot retry.
+ * Neither sleep is freezable and the freezer does not wake them: a
+ * suspend or freeze during such a wait can fail (the default freeze timeout
+ * of 20 s is shorter than the 30 s bound; irrelevant on the lab guests). A
+ * syscall can now take up to this wait plus its own 30 s request window.
+ *
+ * Waiting can never deadlock for good: it is bounded and then fails exactly
+ * as before. An ordinary fence owner is a running thread past its admission
+ * check, never a work item still queued behind the waiter, so a waiter on
+ * the control workqueue (max_active 2) cannot hold back its own owner. An
+ * earmark is resolved by its faulting thread or the mmap cleanup worker on
+ * its own cleanup_queue, never on session->control. hfs_call is never
+ * entered with session->lock or session->writer held, and the waiter holds
+ * neither while it sleeps. No request is issued from inside the ALLOCATE
+ * path itself (transport pressure is queued, never run inline).
+ *
+ * Waiting widens a pre-existing race: hfs_flush takes its close_sequence
+ * before hfs_call, so two concurrent closes of one description may still
+ * reach the host out of sequence order (the later one is then Stale).
+ *
+ * Host side (task 194): the daemon's ALLOCATE refused the credentials of a
+ * process whose PROCESS_EXIT already executed (allowExited only for
+ * GAP_RESOLVE), while the CALL accepts them for DESCRIPTION_RELEASE and
+ * FORGET. At exit PROCESS_EXIT normally wins: its CALL runs on the host's
+ * ordinary lane before the waiting release (or a FORGET queued later from
+ * hfs_evict_inode) allocates, so without 194 that release is refused.
+ */
+
+/* Caller holds session->lock. *wait reports a fence worth waiting for. A
+ * caller behind the queue head also waits: only the head may number.
+ */
+static int hfs_call_admit_locked(struct hfs_session *session, bool control, bool cleanup,
+				 struct hfs_allocation_waiter *waiter, bool *wait)
+{
+	const struct hfs_request *pending = session->allocation_pending;
+	bool behind = !list_empty(&session->allocation_waiters) &&
+		      session->allocation_waiters.next != &waiter->list;
+
+	*wait = false;
+	if (pending) {
+		*wait = !session->allocation_uncertain && !pending->allocation_failed &&
+			!session->closing && (cleanup || !pending->earmarked);
+		return -EAGAIN;
+	}
+	if (behind) {
+		*wait = !session->closing;
+		return -EAGAIN;
+	}
+	return hfs_request_admit(session->blocked, control,
+				 session->nr_requests - session->nr_control_requests,
+				 session->nr_control_requests, session->next_claim);
+}
+
+/* Leave the waiter queue (if queued) and let the next head re-check. */
+static void hfs_call_dequeue(struct hfs_session *session, struct hfs_allocation_waiter *waiter)
+{
+	bool queued;
+
+	mutex_lock(&session->lock);
+	queued = !list_empty(&waiter->list);
+	if (queued) {
+		list_del_init(&waiter->list);
+		hfs_allocation_changed_locked(session);
+	}
+	mutex_unlock(&session->lock);
+	if (queued)
+		wake_up_all(&session->allocation_wait);
+}
+
+static bool hfs_call_woken(struct hfs_session *session, unsigned long epoch)
+{
+	return READ_ONCE(session->allocation_epoch) != epoch || READ_ONCE(session->closing);
+}
+
+/* Sleep until the fence or queue changes, the session closes or the
+ * deadline passes. Ordinary callers also stop on a fatal signal (-EINTR).
+ */
+static int hfs_call_sleep(struct hfs_session *session, unsigned long epoch, bool cleanup,
+			  unsigned long deadline)
+{
+	long left = (long)(deadline - jiffies);
+
+	if (left <= 0)
+		return 0;
+	if (cleanup) {
+		wait_event_timeout(session->allocation_wait, hfs_call_woken(session, epoch), left);
+		return 0;
+	}
+	if (wait_event_killable_timeout(session->allocation_wait,
+					hfs_call_woken(session, epoch), left) < 0)
+		return -EINTR;
+	return 0;
+}
+
+/* Admission before any reservation: waits (x84) while a pending fence clears
+ * or an earlier queued caller numbers. On success a queued waiter stays at
+ * the head until hfs_call_once numbers or gives up.
+ */
+static int hfs_call_admit(struct hfs_session *session, bool control, bool cleanup,
+			  struct hfs_allocation_waiter *waiter, unsigned long deadline)
+{
+	unsigned long epoch;
+	bool wait;
+	int err;
+
+	for (;;) {
+		mutex_lock(&session->lock);
+		err = hfs_call_admit_locked(session, control, cleanup, waiter, &wait);
+		if (!err || !wait || !time_before(jiffies, deadline)) {
+			mutex_unlock(&session->lock);
+			if (err)
+				hfs_call_dequeue(session, waiter);
+			return err;
+		}
+		if (list_empty(&waiter->list))
+			list_add_tail(&waiter->list, &session->allocation_waiters);
+		epoch = session->allocation_epoch;
+		mutex_unlock(&session->lock);
+		if (hfs_call_sleep(session, epoch, cleanup, deadline)) {
+			hfs_call_dequeue(session, waiter);
+			return -EAGAIN; /* fatal signal: the old refusal */
+		}
+	}
+}
+
+static void hfs_call_request_free(struct hfs_session *session, struct hfs_request *request)
+{
+	hfs_buf_free(&request->claim);
+	hfs_buf_free(&request->intent);
+	hfs_buf_free(&request->credentials);
+	hfs_buf_free(&request->original_context);
+	hfs_buf_free(&request->earmark_number);
+	hfs_buf_free(&request->drain_payload);
+	hfs_buf_free(&request->readdir_cleanup);
+	hfs_completion_close(request->completion);
+	session->provider->unreserve(session, request->reservation);
+	kfree(request);
+}
+
+/* The request's full transport credit, retrying once after retirement. */
+static int hfs_call_reserve(struct hfs_session *session, struct hfs_request *request,
+			    bool resource_control)
+{
+	u64 bytes = (hfs_controlled_consumed(session) ? 4ULL : 16ULL) * 1024 * 1024;
+	int err;
+
+	request->session = session;
+	err = session->provider->reserve(session, bytes, resource_control, &request->reservation);
+	if ((err == -ENOSPC || err == -EAGAIN) && !hfs_retire(session))
+		err = session->provider->reserve(session, bytes, resource_control,
+						 &request->reservation);
+	return err;
+}
+
+/* Fill a reserved request; nothing is numbered or published yet. */
+static int hfs_call_prepare(struct hfs_session *session, const char *opcode,
+			    const struct hfs_buf *args, const struct hfs_cred *cred, bool control,
+			    struct hfs_request *request, struct hfs_buf *payload, u8 digest[32])
+{
+	bool resource_control = hfs_call_control_bytes(session, opcode, control);
+	int err;
+
+	err = hfs_completion_new(session, resource_control, false, HFS_BODY_MAX, &request->completion);
+	if (err)
+		return err;
+	if (hfs_buf_init(&request->claim, 4096) ||
+	    hfs_buf_init(&request->intent, args->len + 64) ||
+	    hfs_buf_init(&request->credentials, 16384) ||
+	    hfs_buf_init(&request->original_context, HFS_CONTEXT_MAX) ||
+	    hfs_buf_init(payload, HFS_BODY_MAX))
+		return -ENOMEM;
+	hfs_buf_literal(&request->intent, "{\"args\":");
+	hfs_buf_add(&request->intent, args->data, args->len);
+	hfs_buf_printf(&request->intent, ",\"opcode\":\"%s\"}", opcode);
+	hfs_cred_write(&request->credentials, cred);
+	if (request->intent.error || request->credentials.error)
+		return request->intent.error ?: request->credentials.error;
+	if (session->bridge_minor >= 3 && !strcmp(opcode, "READDIR")) {
+		err = hfs_buf_init(&request->readdir_cleanup, HFS_BODY_MAX);
+		if (err)
+			return err;
+	}
+	request->cache_observation = !strcmp(opcode, "GETATTR") || !strcmp(opcode, "LOOKUP") ||
+		!strcmp(opcode, "READDIR") || !strcmp(opcode, "READLINK") || !strcmp(opcode, "STATFS");
+	if (session->bridge_minor && !control) {
+		struct hfs_view *view = hfs_view_get(session);
+
+		if (view) {
+			err = hfs_view_snapshot_target(view, &request->view_stamp,
+						       request->view_target);
+			hfs_view_put(view);
+			if (err)
+				return err;
+			request->view_stamped = true;
+		}
+	}
+	hfs_hash(request->intent.data, request->intent.len, digest);
+	return 0;
+}
+
+/* Caller holds session->lock and admitted the request: number and publish it. */
+static void hfs_call_number_locked(struct hfs_session *session, struct hfs_request *request,
+				   bool control, const u8 digest[32])
+{
+	request->control = control;
+	if (session->bridge_minor >= 2)
+		session->allocation_pending = request;
+	request->number = session->next_claim++;
+	uuid_gen(&request->operation);
+	hfs_buf_add(&request->original_context, session->enrollment.context,
+		    session->enrollment.context_len);
+	hfs_buf_printf(&request->claim,
+		"{\"anchor\":\"%pUb\",\"nonce\":\"%pUb\",\"number\":%llu,"
+		"\"original_hash\":", &session->enrollment.anchor,
+		&session->enrollment.nonce, request->number);
+	hfs_buf_hex(&request->claim, digest, 32);
+	hfs_buf_printf(&request->claim, ",\"realm\":\"%pUb\",\"subject\":",
+		       &session->enrollment.realm);
+	hfs_buf_hex(&request->claim, session->enrollment.subject,
+		    session->enrollment.subject_len);
+	hfs_buf_literal(&request->claim, "}");
+	list_add_tail(&request->list, &session->requests);
+	session->nr_requests++;
+	if (control)
+		session->nr_control_requests++;
+}
+
+/* One admission attempt. *retry: a fence appeared after hfs_call_admit.
+ * That is routine: two callers that both found the fence free and the
+ * queue empty prepare concurrently and the second loses to the first's
+ * numbering. The waiter keeps (or takes) its queue place; the reservation
+ * and view stamp are dropped rather than held across the wait: a held
+ * stamp would go stale and the credit may be what the fence owner's
+ * exchange needs.
+ */
+static int hfs_call_once(struct hfs_session *session, const char *opcode,
+			 const struct hfs_buf *args, const struct hfs_cred *cred, bool control,
+			 bool cleanup, struct hfs_allocation_waiter *waiter, bool *retry,
+			 struct hfs_json **out)
+{
+	struct hfs_request *request;
+	struct hfs_buf payload = {};
+	u8 digest[32];
+	int err;
+
+	*retry = false;
+	request = kzalloc(sizeof(*request), GFP_KERNEL);
+	if (!request) {
+		err = -ENOMEM;
+		goto leave;
+	}
+	err = hfs_call_reserve(session, request, hfs_call_control_bytes(session, opcode, control));
+	if (err) {
+		kfree(request);
+		goto leave;
+	}
+	err = hfs_call_prepare(session, opcode, args, cred, control, request, &payload, digest);
+	if (err)
+		goto free;
+	mutex_lock(&session->lock);
+	err = hfs_call_admit_locked(session, control, cleanup, waiter, retry);
+	if (err) {
+		mutex_unlock(&session->lock);
+		goto free;
+	}
+	hfs_call_number_locked(session, request, control, digest);
+	mutex_unlock(&session->lock);
+	hfs_call_dequeue(session, waiter);
+	err = hfs_request_run(session, request, opcode, &payload, out);
+	hfs_buf_free(&payload);
+	return err;
+free:
+	hfs_buf_free(&payload);
+	hfs_call_request_free(session, request);
+leave:
+	if (!*retry)
+		hfs_call_dequeue(session, waiter);
+	return err;
+}
+
+int hfs_call(struct hfs_session *session, const char *opcode, const struct hfs_buf *args,
+	     const struct hfs_cred *cred, bool control, struct hfs_json **out)
+{
+	unsigned long deadline = jiffies + msecs_to_jiffies(HFS_ALLOCATION_WAIT_MS);
+	bool cleanup = hfs_cleanup_opcode(opcode);
+	struct hfs_allocation_waiter waiter;
+	bool retry;
+	int err;
+
+	*out = NULL;
+	if (!hfs_operation(opcode, true))
+		return -EOPNOTSUPP;
+	if (session->bridge_minor >= 2 && !strcmp(opcode, "DRAIN_WRITE"))
+		return -EOPNOTSUPP;
+	if (!cred || args->error)
+		return args->error ?: -EINVAL;
+	INIT_LIST_HEAD(&waiter.list);
+	for (;;) {
+		err = hfs_call_admit(session, control, cleanup, &waiter, deadline);
+		if (err)
+			return err;
+		err = hfs_call_once(session, opcode, args, cred, control, cleanup, &waiter,
+				    &retry, out);
+		if (!retry)
+			return err;
+	}
+}
+EXPORT_SYMBOL_GPL(hfs_call);
+
+int hfs_args_init(struct hfs_buf *args)
+{
+	return hfs_buf_init(args, 2 * HFS_IO_MAX + 2 * HFS_CAP_MAX + 16384);
+}
+
+void hfs_cap_write(struct hfs_buf *buf, const struct hfs_cap *cap)
+{
+	if (!cap || !cap->json) {
+		buf->error = -ESTALE;
+		return;
+	}
+	hfs_buf_add(buf, cap->json->data, cap->json->len);
+}
+
+void hfs_args_object(struct hfs_buf *args, const struct hfs_cap *cap)
+{
+	hfs_buf_literal(args, "{\"object\":");
+	hfs_cap_write(args, cap);
+	hfs_buf_literal(args, "}");
+}
+
+/* The owning request's full payload storage was funded before READDIR CALL.
+ * No per-entry claim, capability allocation, or credential recapture occurs.
+ * The caller has left physical observation but still borrows the parent.
+ */
+static int hfs_readdir_cleanup(struct hfs_session *session, const struct hfs_json *result,
+			       const struct hfs_cred *issuer)
+{
+	struct hfs_request *request = result->owner;
+	struct hfs_json *reply = NULL;
+	struct hfs_buf *payload;
+	u8 digest[32], actual[32];
+	u32 i, n = 0, len = sizeof(actual);
+	int entries, cap, id, token, claim, err;
+
+	if (!request || request->session != session || !request->users || !request->terminal ||
+	    !request->result || !issuer)
+		return -ESTALE;
+	payload = &request->readdir_cleanup;
+	if (!payload->data || payload->cap != HFS_BODY_MAX)
+		return -ENOSPC;
+	if (result->len != request->result->len ||
+	    memcmp(result->data, request->result->data, result->len))
+		return -ESTALE;
+	payload->len = 0;
+	payload->error = 0;
+	hfs_cred_write(payload, issuer);
+	if (payload->error || payload->len != request->credentials.len ||
+	    memcmp(payload->data, request->credentials.data, payload->len))
+		return -EACCES;
+
+	entries = hfs_json_field(result, 0, "entries");
+	id = hfs_json_field(result, 0, "id");
+	if (entries < 0 || result->tokens[entries].kind != HFS_ARRAY || id < 0)
+		return -EPROTO;
+	payload->len = 0;
+	payload->error = 0;
+	hfs_buf_literal(payload, "{\"capabilities\":[");
+	for (i = entries + 1; i < result->count; i++) {
+		if (result->tokens[i].parent != entries)
+			continue;
+		cap = hfs_json_field(result, i, "capability");
+		if (++n > 256 || cap < 0)
+			return -EPROTO;
+		if (n > 1)
+			hfs_buf_literal(payload, ",");
+		hfs_buf_add(payload, result->data + result->tokens[cap].start,
+			    result->tokens[cap].end - result->tokens[cap].start);
+	}
+	hfs_buf_literal(payload, "],\"claim\":");
+	hfs_buf_add(payload, request->claim.data, request->claim.len);
+	hfs_buf_literal(payload, ",\"credentials\":");
+	/* Retain the exact original bytes, regardless of exit/current
+   * credentials. */
+	hfs_buf_add(payload, request->credentials.data, request->credentials.len);
+	hfs_buf_literal(payload, ",\"result_id\":");
+	hfs_buf_add(payload, result->data + result->tokens[id].start,
+		    result->tokens[id].end - result->tokens[id].start);
+	hfs_buf_literal(payload, "}");
+	if (payload->error)
+		return payload->error;
+	hfs_hash(payload->data, payload->len, digest);
+	err = hfs_control(session, "READDIR_CLEANUP", payload, true, &reply);
+	if (err)
+		goto out;
+	token = hfs_json_field(reply, 0, "payload");
+	claim = hfs_json_field(reply, token, "claim");
+	cap = hfs_json_field(reply, token, "result_id");
+	if (hfs_json_exact(reply, token, "claim,request_hash,result_id,status") ||
+	    !hfs_json_is(reply, hfs_json_field(reply, token, "status"), "\"CLOSED\"") ||
+	    claim < 0 || cap < 0 ||
+	    reply->tokens[claim].end - reply->tokens[claim].start != request->claim.len ||
+	    memcmp(reply->data + reply->tokens[claim].start, request->claim.data,
+		   request->claim.len) ||
+	    reply->tokens[cap].end - reply->tokens[cap].start !=
+		    result->tokens[id].end - result->tokens[id].start ||
+	    memcmp(reply->data + reply->tokens[cap].start, result->data + result->tokens[id].start,
+		   result->tokens[id].end - result->tokens[id].start) ||
+	    hfs_json_hex(reply, hfs_json_field(reply, token, "request_hash"), actual, &len) ||
+	    len != 32 || memcmp(actual, digest, 32))
+		err = -EPROTO;
+	if (!err)
+		hfs_result_adopt(session, result);
+out:
+	hfs_json_free(reply);
+	return err;
+}
+
+int hfs_readdir_forget(struct hfs_session *session,
+		       const struct hfs_json *result,
+		       const struct hfs_cred *issuer)
+{
+	struct hfs_json *reply = NULL;
+	struct hfs_buf args;
+	struct hfs_cap *cap;
+	int entries = hfs_json_field(result, 0, "entries");
+	int err;
+	u32 i;
+
+	if (session->bridge_minor >= 3)
+		return hfs_readdir_cleanup(session, result, issuer);
+	if (entries < 0 || result->tokens[entries].kind != HFS_ARRAY)
+		return -EPROTO;
+	for (i = entries + 1; i < result->count; i++) {
+		if (result->tokens[i].parent != entries)
+			continue;
+		cap = NULL;
+		err = hfs_cap_parse(session, result,
+				    hfs_json_field(result, i, "capability"),
+				    "PATH", &cap);
+		if (err)
+			return err;
+		err = hfs_args_init(&args);
+		if (!err) {
+			hfs_buf_literal(&args, "{\"count\":1,\"object\":");
+			hfs_cap_write(&args, cap);
+			hfs_buf_literal(&args, "}");
+			err = hfs_call(session, "FORGET", &args, issuer, true,
+				       &reply);
+		}
+		hfs_buf_free(&args);
+		hfs_cap_free(cap);
+		hfs_json_free(reply);
+		reply = NULL;
+		if (err)
+			return err;
+	}
+	hfs_result_adopt(session, result);
+	return 0;
+}
+
+void hfs_cap_free(struct hfs_cap *cap)
+{
+	if (cap) {
+		hfs_json_free(cap->json);
+		kfree(cap);
+	}
+}
+
+int hfs_cap_parse(struct hfs_session *session, const struct hfs_json *json,
+		  int token, const char *kind, struct hfs_cap **out)
+{
+	struct hfs_cap *cap;
+	int field, scope, err;
+	u8 digest[32];
+	u32 len = 32;
+	u64 value;
+	char actual_kind[16];
+
+	*out = NULL;
+	if (hfs_json_exact(json, token,
+		"ancestors_hash,credential_hash,description,kind,object_allocation,"
+		"object_home,revision,rights,scope,token") ||
+	    json->tokens[token].end - json->tokens[token].start > HFS_CAP_MAX ||
+	    hfs_json_string(json, hfs_json_field(json, token, "kind"),
+			    actual_kind, sizeof(actual_kind)) < 0 ||
+	    strcmp(actual_kind, kind))
+		return -EPROTO;
+	scope = hfs_json_field(json, token, "scope");
+	if (scope < 0 || json->tokens[scope].end - json->tokens[scope].start !=
+	    session->enrollment.context_len ||
+	    memcmp(json->data + json->tokens[scope].start,
+		   session->enrollment.context, session->enrollment.context_len))
+		return -ESTALE;
+	cap = kzalloc(sizeof(*cap), GFP_KERNEL);
+	if (!cap)
+		return -ENOMEM;
+	err = hfs_uuid(json, hfs_json_field(json, token, "object_home"), &cap->home);
+	if (!err)
+		err = hfs_uuid(json, hfs_json_field(json, token, "object_allocation"),
+			       &cap->allocation);
+	if (!err)
+		err = hfs_field_u64(json, token, "revision", &cap->revision);
+	if (err || !cap->revision || hfs_field_u64(json, token, "rights", &value) ||
+	    value > 63) {
+		err = -EPROTO;
+		goto fail;
+	}
+	cap->rights = value;
+	field = hfs_json_field(json, token, "description");
+	if (!strcmp(kind, "DESCRIPTION"))
+		err = hfs_uuid(json, field, &cap->description);
+	else if (!hfs_json_is(json, field, "null"))
+		err = -EPROTO;
+	if (err)
+		goto fail;
+	for (field = 0; field < 3; field++) {
+		static const char * const hashes[] = {
+			"ancestors_hash", "credential_hash", "token",
+		};
+
+		len = 32;
+		err = hfs_json_hex(json, hfs_json_field(json, token, hashes[field]),
+				   digest, &len);
+		if (err || len != 32) {
+			err = -EPROTO;
+			goto fail;
+		}
+		memcpy(field == 0 ? cap->ancestors_hash :
+		       field == 1 ? cap->credential_hash : cap->token, digest, 32);
+	}
+	err = hfs_copy_token(json, token, &cap->json);
+	if (err)
+		goto fail;
+	*out = cap;
+	return 0;
+fail:
+	hfs_cap_free(cap);
+	return err;
+}
+
+int hfs_reply_cap(struct hfs_session *session, const struct hfs_json *result,
+		  const char *kind, struct hfs_cap **out)
+{
+	int array = hfs_json_field(result, 0, "capabilities"), found = -1;
+	u32 i;
+	char actual[16];
+
+	if (array < 0 || result->tokens[array].kind != HFS_ARRAY)
+		return -EPROTO;
+	for (i = array + 1; i < result->count; i++) {
+		if (result->tokens[i].parent != array)
+			continue;
+		if (hfs_json_string(result, hfs_json_field(result, i, "kind"),
+				    actual, sizeof(actual)) < 0)
+			return -EPROTO;
+		if (!strcmp(actual, kind)) {
+			if (found >= 0)
+				return -EPROTO;
+			found = i;
+		}
+	}
+	return found < 0 ? -EPROTO : hfs_cap_parse(session, result, found, kind, out);
+}
+
+int hfs_begin_cap(struct inode *inode, const struct hfs_cap *cap, bool mutation,
+		  struct hfs_cred **cred, void **cookie)
+{
+	struct hfs_session *session = HFS_S(inode);
+	void *native = NULL;
+	int err;
+
+	*cookie = NULL;
+	err = hfs_capture(session, &init_user_ns, cred);
+	if (err)
+		return err;
+	err = session->provider->enter(session, cap, mutation, &native);
+	if (!err && session->bridge_minor) {
+		err = hfs_mmap_begin(inode, mutation, *cred, native, cookie);
+		if (err)
+			session->provider->leave(session, native);
+	} else if (!err) {
+		*cookie = native;
+	}
+	if (err)
+		hfs_cred_free(*cred);
+	return err;
+}
+
+int hfs_begin(struct inode *inode, bool mutation, struct hfs_cred **cred,
+	      void **cookie)
+{
+	return hfs_begin_cap(inode, HFS_I(inode)->object, mutation, cred, cookie);
+}
+
+void hfs_leave(struct inode *inode, void *cookie)
+{
+	struct hfs_session *session = HFS_S(inode);
+
+	if (session->bridge_minor)
+		hfs_mmap_end(cookie);
+	else
+		session->provider->leave(session, cookie);
+}
+
+void hfs_end(struct inode *inode, struct hfs_cred *cred, void *cookie)
+{
+	hfs_leave(inode, cookie);
+	hfs_cred_free(cred);
+}
+
+int v9fs_hfs_register_provider(const struct hfs_provider *provider)
+{
+	int err = 0;
+
+	if (!provider ||
+	    (provider->features != HFS_FEATURES && provider->features != HFS_VIEW_FEATURES &&
+	     provider->features != HFS_CONTROLLED_FEATURES &&
+	     provider->features != HFS_CLEANUP_FEATURES &&
+	     provider->features != HFS_MAPPED_FEATURES) ||
+	    !provider->enroll || !provider->map || !provider->enter ||
+	    !provider->leave || !provider->publication ||
+	    !provider->stop || !provider->retain || !provider->reserve ||
+	    !provider->unreserve || !provider->retirement || !provider->resolve_gap ||
+	    !provider->retire_session ||
+	    (provider->features == HFS_FEATURES && !provider->mmap) ||
+	    (provider->features != HFS_FEATURES &&
+	     (!provider->target || !provider->view_event || !provider->view_retirement)))
+		return -EOPNOTSUPP;
+	mutex_lock(&hfs_provider_lock);
+	if (hfs_provider)
+		err = -EBUSY;
+	else
+		hfs_provider = provider;
+	mutex_unlock(&hfs_provider_lock);
+	return err;
+}
+EXPORT_SYMBOL_GPL(v9fs_hfs_register_provider);
+
+int v9fs_hfs_unregister_provider(const struct hfs_provider *provider)
+{
+	int err = 0;
+
+	mutex_lock(&hfs_provider_lock);
+	if (hfs_provider != provider)
+		err = -EINVAL;
+	else if (atomic_read(&hfs_active_sessions))
+		err = -EBUSY;
+	else {
+		hfs_provider = NULL;
+		if (hfs_trace_registered) {
+			tracepoint_probe_unregister(hfs_exit_tracepoint, hfs_process_exit, NULL);
+			tracepoint_synchronize_unregister();
+			hfs_trace_registered = false;
+		}
+	}
+	mutex_unlock(&hfs_provider_lock);
+	return err;
+}
+EXPORT_SYMBOL_GPL(v9fs_hfs_unregister_provider);
+
+bool v9fs_hfs_selected(const char *options)
+{
+	const char *p = options;
+	static const char selected[] = "version=9P2000.L.hfs1";
+	static const char views[] = "version=9P2000.L.hfs1.1";
+	static const char controlled[] = "version=9P2000.L.hfs1.2";
+	static const char cleanup[] = "version=9P2000.L.hfs1.3";
+	static const char mapped[] = "version=9P2000.L.hfs1.4";
+	size_t len;
+
+	while (p && *p) {
+		len = strcspn(p, ",");
+		if ((len == sizeof(selected) - 1 && !memcmp(p, selected, len)) ||
+		    (len == sizeof(views) - 1 && !memcmp(p, views, len)) ||
+		    (len == sizeof(controlled) - 1 && !memcmp(p, controlled, len)) ||
+		    (len == sizeof(cleanup) - 1 && !memcmp(p, cleanup, len)) ||
+		    (len == sizeof(mapped) - 1 && !memcmp(p, mapped, len)))
+			return true;
+		p = p[len] ? p + len + 1 : NULL;
+	}
+	return false;
+}
+
+/* s64: whether the option p[0..len) is "hfs_fdattr" or "hfs_fdattr=...". */
+static bool hfs_fdattr_token(const char *p, size_t len)
+{
+	static const char fdattr[] = "hfs_fdattr";
+	size_t n = sizeof(fdattr) - 1;
+
+	return len >= n && !memcmp(p, fdattr, n) && (len == n || p[n] == '=');
+}
+
+/* s64: whether options name an hfs-only option (hfs_fdattr in any form).
+ * v9fs_mount refuses it on a stock (non-hfs) version, where 9p would ignore
+ * it silently.
+ */
+bool v9fs_hfs_only_option(const char *options)
+{
+	const char *p = options;
+	size_t len;
+
+	while (p && *p) {
+		len = strcspn(p, ",");
+		if (hfs_fdattr_token(p, len))
+			return true;
+		p = p[len] ? p + len + 1 : NULL;
+	}
+	return false;
+}
+
+/* hfs implements exactly the stock cache=mmap contract, so a mount must ask
+ * for exactly that (zq3-r7 R7-1, g64).
+ *
+ * The hfs superblock replaces the v9fs inode, file and dentry operations:
+ * read_iter and write_iter always go over the bridge (hfs_io), dentries are
+ * never kept (hfs_d_revalidate) and attributes are refreshed for every
+ * permission check. The only guest page cache is the mapped-file cache
+ * (hfs_cache_aops), owned by the retained-view recall protocol. Before g64
+ * the options went unparsed to p9_client_create, which ignores cache=, so any
+ * mode was silently accepted while the guest tools treat cache=mmap as a
+ * guaranteed property. Now exactly one "cache=mmap" is required, and
+ * hfs_show_options reports it. A missing or repeated cache=, any other mode
+ * and the legacy selectors (loose, fscache, mmap, cachetag=) are refused with
+ * EINVAL, the errno v9fs uses for an unknown cache mode.
+ *
+ * s64: the same loop parses "hfs_fdattr" into *fd_attr (described
+ * GETATTR/SETATTR, see hfs_session.fd_attr). It is explicit configuration,
+ * not negotiation: the lab sets it only with an s64 host and forwarder. A
+ * repeated hfs_fdattr or any "hfs_fdattr=" value is EINVAL.
+ */
+static int hfs_cache_option(const char *options, bool *fd_attr)
+{
+	static const char wanted[] = "cache=mmap";
+	const char *p = options;
+	unsigned int found = 0;
+	size_t len;
+
+	*fd_attr = false;
+	while (p && *p) {
+		len = strcspn(p, ",");
+		if (len == sizeof(wanted) - 1 && !memcmp(p, wanted, len))
+			found++;
+		else if (len == sizeof("hfs_fdattr") - 1 && hfs_fdattr_token(p, len) &&
+			 !*fd_attr)
+			*fd_attr = true; /* exactly "hfs_fdattr", the first time */
+		else if (hfs_fdattr_token(p, len))
+			return -EINVAL;
+		else if ((len >= 6 && !memcmp(p, "cache=", 6)) ||
+			 (len == 5 && !memcmp(p, "loose", 5)) ||
+			 (len == 7 && !memcmp(p, "fscache", 7)) ||
+			 (len == 4 && !memcmp(p, "mmap", 4)) ||
+			 (len >= 9 && !memcmp(p, "cachetag=", 9)))
+			return -EINVAL;
+		p = p[len] ? p + len + 1 : NULL;
+	}
+	return found == 1 ? 0 : -EINVAL;
+}
+
+/* The mount's own options (hfs_cache_option), with one line on refusal. */
+static int hfs_mount_options(const char *options, bool *fd_attr)
+{
+	int err = hfs_cache_option(options, fd_attr);
+
+	if (err)
+		pr_warn_ratelimited("9p-hfs: mount refused: exactly one cache=mmap is required, hfs_fdattr at most once and without a value\n");
+	return err;
+}
+
+static int hfs_enrollment_validate(struct hfs_enrollment *enrollment)
+{
+	struct hfs_json *context = NULL;
+	uuid_t id;
+	u32 i;
+	int err;
+
+	if (!enrollment->context_len || enrollment->context_len >= HFS_CONTEXT_MAX ||
+	    uuid_is_null(&enrollment->session) || uuid_is_null(&enrollment->realm) ||
+	    uuid_is_null(&enrollment->anchor) || uuid_is_null(&enrollment->nonce) ||
+	    !enrollment->subject_len || enrollment->subject_len > 1024)
+		return -EINVAL;
+	err = hfs_json_parse(enrollment->context, enrollment->context_len, &context);
+	if (err)
+		return err;
+	err = hfs_json_exact(context, 0,
+		"authority_hash,cluster,configuration,export,exporter_incarnation,"
+		"fuse_session,generation,guest_boot,guest_mount,origin_incarnation,"
+		"origin_journal,origin_node,policy_hash,registry_hash,session,vm,volume");
+	for (i = 1; !err && i + 1 < context->count; i++) {
+		char key[32];
+		u8 hash[32];
+		u32 len = 32;
+		int value;
+
+		if (context->tokens[i].parent != 0 ||
+		    context->tokens[i].kind != HFS_STRING)
+			continue;
+		if (hfs_json_string(context, i, key, sizeof(key)) < 0)
+			continue;
+		value = hfs_json_field(context, 0, key);
+		if (value < 0)
+			continue;
+		if (strstr(key, "_hash")) {
+			err = hfs_json_hex(context, value, hash, &len);
+			if (!err && len != 32)
+				err = -EPROTO;
+		} else {
+			err = hfs_uuid(context, value, &id);
+		}
+	}
+	if (!err) {
+		err = hfs_uuid(context, hfs_json_field(context, 0, "session"), &id);
+		if (!err && !uuid_equal(&id, &enrollment->session))
+			err = -EPROTO;
+	}
+	hfs_json_free(context);
+	return err;
+}
+
+/* Closed older profiles distinguish nonces within their shared anchor. Exact
+ * 1.4 retains all signed lane anchors and distinguishes complete pairs.
+ */
+static int hfs_enrollment_lanes(const struct hfs_enrollment *enrollment, u16 minor)
+{
+	if (!minor)
+		return 0;
+	if (minor > 4 ||
+	    (enrollment->view_scope != HFS_SCOPE_NORMAL_PUBLIC &&
+	     enrollment->view_scope != HFS_SCOPE_CONTROLLED_LOCAL) ||
+	    (minor >= 2 && enrollment->view_scope != HFS_SCOPE_CONTROLLED_LOCAL))
+		return -EOPNOTSUPP;
+	if (minor < 4)
+		return uuid_is_null(&enrollment->view_control_nonce) ||
+			uuid_equal(&enrollment->view_control_nonce, &enrollment->nonce) ?
+			-EOPNOTSUPP : 0;
+	if (uuid_is_null(&enrollment->anchor) || uuid_is_null(&enrollment->nonce) ||
+	    uuid_is_null(&enrollment->acquisition_anchor) ||
+	    uuid_is_null(&enrollment->acquisition_nonce) ||
+	    uuid_is_null(&enrollment->control_anchor) ||
+	    uuid_is_null(&enrollment->view_control_nonce) ||
+	    (uuid_equal(&enrollment->anchor, &enrollment->acquisition_anchor) &&
+	     uuid_equal(&enrollment->nonce, &enrollment->acquisition_nonce)) ||
+	    (uuid_equal(&enrollment->anchor, &enrollment->control_anchor) &&
+	     uuid_equal(&enrollment->nonce, &enrollment->view_control_nonce)) ||
+	    (uuid_equal(&enrollment->acquisition_anchor, &enrollment->control_anchor) &&
+	     uuid_equal(&enrollment->acquisition_nonce, &enrollment->view_control_nonce)))
+		return -EOPNOTSUPP;
+	return 0;
+}
