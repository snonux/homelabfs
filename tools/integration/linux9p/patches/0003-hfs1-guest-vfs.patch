+static int hfs_session_free(struct hfs_session *session)
+{
+	struct hfs_process *process, *next_process;
+	struct hfs_request *request, *next_request;
+	struct hfs_description *description, *next_description;
+	struct hfs_forget *forget, *next_forget;
+	struct hfs_object_number *object, *next_object;
+	struct hfs_view *view;
+	int err;
+
+	err = hfs_controlled_release_ready(session);
+	if (err)
+		return err;
+	if (session->retirement_cut || hfs_view_tickets_busy(session))
+		return -EBUSY;
+	view = hfs_view_get(session);
+	if (view) {
+		hfs_view_fence(view);
+		err = hfs_mmap_stop(view);
+		hfs_view_put(view);
+		if (err)
+			return err;
+		err = hfs_view_free(session);
+		if (err)
+			return err;
+	}
+	if (session->control)
+		destroy_workqueue(session->control);
+	if (session->client)
+		p9_client_destroy(session->client);
+	list_for_each_entry_safe(process, next_process, &session->processes, list) {
+		hfs_cred_free(process->last);
+		put_pid(process->pid);
+		session->provider->unreserve(session, process->reservation);
+		kfree(process);
+	}
+	list_for_each_entry_safe(request, next_request, &session->requests, list) {
+		hfs_buf_free(&request->claim);
+		hfs_buf_free(&request->intent);
+		hfs_buf_free(&request->credentials);
+		hfs_buf_free(&request->original_context);
+		hfs_buf_free(&request->earmark_number);
+		hfs_buf_free(&request->drain_payload);
+		hfs_buf_free(&request->readdir_cleanup);
+		hfs_json_free(request->result);
+		hfs_json_free(request->refusal);
+		hfs_json_free(request->allocation_receipt);
+		hfs_json_free(request->response);
+		hfs_json_free(request->gap_response);
+		hfs_completion_close(request->completion);
+		session->provider->unreserve(session, request->reservation);
+		kfree(request);
+	}
+	list_for_each_entry_safe(description, next_description, &session->descriptions, list) {
+		hfs_description_discard(session, description);
+	}
+	list_for_each_entry_safe(forget, next_forget, &session->forgets, list) {
+		hfs_cap_free(forget->cap);
+		hfs_cred_free(forget->issuer);
+		kfree(forget);
+	}
+	list_for_each_entry_safe(object, next_object, &session->object_numbers, list)
+		kfree(object);
+	hfs_view_tickets_destroy(session);
+	hfs_cap_free(session->domain);
+	hfs_controlled_session_released(session);
+	module_put(session->provider->owner);
+	atomic_dec(&hfs_active_sessions);
+	kfree(session);
+	return 0;
+}
+
+static int hfs_fill_super(struct super_block *sb, void *data, int silent)
+{
+	struct hfs_session *session = data;
+	struct hfs_cred *cred = NULL;
+	struct hfs_buf args;
+	struct hfs_json *result = NULL;
+	struct inode *root;
+	int err;
+
+	sb->s_fs_info = session;
+	sb->s_magic = V9FS_MAGIC;
+	sb->s_op = &hfs_super_ops;
+	sb->s_maxbytes = MAX_LFS_FILESIZE;
+	sb->s_blocksize = PAGE_SIZE;
+	sb->s_blocksize_bits = PAGE_SHIFT;
+	sb->s_time_gran = 1;
+	err = hfs_controlled_bind_super(session, sb);
+	if (err)
+		return err;
+	/* No ACL, special inode or suid enablement is implied by protocol modes. */
+	/* VFS/LSM hooks remain active; no SB_NOSEC or security bypass. */
+	err = hfs_capture(session, &init_user_ns, &cred);
+	if (err)
+		return err;
+	err = hfs_args_init(&args);
+	if (!err) {
+		hfs_buf_literal(&args, "{}");
+		err = hfs_call(session, "ROOT", &args, cred, false, &result);
+	}
+	hfs_buf_free(&args);
+	if (err)
+		goto out;
+	err = hfs_reply_cap(session, result, "DOMAIN", &session->domain);
+	if (err)
+		goto out;
+	if (session->bridge_minor) {
+		err = hfs_mmap_bootstrap(session, cred);
+		if (err)
+			goto out;
+	}
+	root = hfs_inode_get(sb, result, "ROOT", cred);
+	if (IS_ERR(root)) {
+		err = PTR_ERR(root);
+		goto out;
+	}
+	if (!S_ISDIR(root->i_mode)) {
+		iput(root);
+		err = -EPROTO;
+		goto out;
+	}
+	sb->s_root = d_make_root(root);
+	if (!sb->s_root)
+		err = -ENOMEM;
+	else
+		hfs_result_adopt(session, result);
+out:
+	hfs_cred_free(cred);
+	hfs_json_free(result);
+	return err;
+}
+
+/* A fresh session for the registered provider. The caller holds
+ * hfs_provider_lock and a module reference; NULL means no memory.
+ */
+static struct hfs_session *hfs_session_new(const struct hfs_provider *provider)
+{
+	struct hfs_session *session = kzalloc(sizeof(*session), GFP_KERNEL);
+
+	if (!session)
+		return NULL;
+	session->provider = provider;
+	session->bridge_minor = provider->features == HFS_MAPPED_FEATURES	  ? 4 :
+				provider->features == HFS_CLEANUP_FEATURES	  ? 3 :
+				provider->features == HFS_CONTROLLED_FEATURES ? 2 :
+				provider->features == HFS_VIEW_FEATURES	  ? 1 :
+									    0;
+	atomic_inc(&hfs_active_sessions);
+	mutex_init(&session->lock);
+	mutex_init(&session->writer);
+	mutex_init(&session->retirement);
+	spin_lock_init(&session->processes_lock);
+	INIT_LIST_HEAD(&session->processes);
+	INIT_LIST_HEAD(&session->requests);
+	INIT_LIST_HEAD(&session->uncertain);
+	INIT_LIST_HEAD(&session->descriptions);
+	INIT_LIST_HEAD(&session->forgets);
+	INIT_LIST_HEAD(&session->object_numbers);
+	INIT_LIST_HEAD(&session->view_tickets);
+	INIT_LIST_HEAD(&session->view_families);
+	INIT_LIST_HEAD(&session->global);
+	INIT_LIST_HEAD(&session->allocation_waiters);
+	init_waitqueue_head(&session->allocation_wait);
+	init_waitqueue_head(&session->stop_wait);
+	INIT_WORK(&session->abandon_work, hfs_session_abandon_work); /* hh4 */
+	session->next_claim = session->next_cell = session->next_inode = 1;
+	session->next_close = session->next_release = 1;
+	return session;
+}
+
+/* Enroll, validate the enrollment and its lanes, then pick the HELLO text.
+ *
+ * HELLO carries the enrolled selection, so it exists only after enroll. The
+ * kzalloc'd features (0) would select the minor-4 default text and the
+ * controlled provider refuses that for a features 32767 enrollment. An
+ * enrolled mask without a selected text refuses before any native bytes.
+ */
+static int hfs_mount_enroll(struct hfs_session *session, const char *device,
+			    const char **hello)
+{
+	int err = session->provider->enroll(device, &session->enrollment);
+
+	if (!err)
+		err = hfs_enrollment_validate(&session->enrollment);
+	if (!err)
+		err = hfs_enrollment_lanes(&session->enrollment, session->bridge_minor);
+	if (err)
+		return err;
+	*hello = hfs_protocol_selected_text(session->bridge_minor,
+					    session->enrollment.protocol_features);
+	return *hello ? 0 : -EPROTO;
+}
+
+/* Register the process-exit tracepoint once; hfs_provider_lock is held. */
+static int hfs_trace_register(void)
+{
+	int err;
+
+	if (hfs_trace_registered)
+		return 0;
+	check_trace_callback_type_sched_process_exit(hfs_process_exit);
+	for_each_kernel_tracepoint(hfs_find_exit_tracepoint, &hfs_exit_tracepoint);
+	if (!hfs_exit_tracepoint)
+		return -EOPNOTSUPP;
+	err = tracepoint_probe_register(hfs_exit_tracepoint, hfs_process_exit, NULL);
+	if (err)
+		return err;
+	hfs_trace_registered = true;
+	return 0;
+}
+
+/* Create the p9 client and require the exact negotiated hfs version for the
+ * provider's minor before binding the controlled transport. A failed create
+ * leaves session->client NULL for hfs_mount_fail.
+ */
+static int hfs_mount_client(struct hfs_session *session, const char *device, void *options)
+{
+	int err;
+
+	session->client = p9_client_create(device, options);
+	if (IS_ERR(session->client)) {
+		err = PTR_ERR(session->client);
+		session->client = NULL;
+		return err;
+	}
+	if (session->client->proto_version != (session->bridge_minor == 4 ? p9_proto_hfs14 :
+					       session->bridge_minor == 3 ? p9_proto_hfs13 :
+					       session->bridge_minor == 2 ? p9_proto_hfs12 :
+					       session->bridge_minor	  ? p9_proto_hfs11 :
+									    p9_proto_hfs1))
+		return -EPROTO;
+	return hfs_controlled_bind_transport(session);
+}
+
+/* Send the enrolled HELLO and accept only its exact echo. The runtime echoes
+ * the sent HELLO as its selection. Match the enrolled tuple (features 16383
+ * or 32767 at minor 4), not only the minor default.
+ */
+static int hfs_mount_hello(struct hfs_session *session, const char *hello)
+{
+	struct hfs_buf payload;
+	struct hfs_json *reply = NULL;
+	int err, token, selection;
+
+	err = hfs_buf_init(&payload, strlen(hello) + 1);
+	if (err)
+		return err;
+	hfs_buf_literal(&payload, hello);
+	err = hfs_control(session, "HELLO", &payload, false, &reply);
+	hfs_buf_free(&payload);
+	if (err)
+		return err;
+	token = hfs_json_field(reply, 0, "payload");
+	selection = hfs_json_field(reply, token, "selection");
+	if (hfs_json_exact(reply, token, "selection,status") ||
+	    !hfs_json_is(reply, hfs_json_field(reply, token, "status"), "\"ACCEPTED\"") ||
+	    hfs_protocol_selected_match(reply, selection, session->bridge_minor,
+					session->enrollment.protocol_features))
+		err = -EPROTO;
+	hfs_json_free(reply);
+	return err;
+}
+
+/* Close a session whose mount failed after it was created; the provider lock
+ * is no longer held. A failed attach cannot discard admitted claims or
+ * control cells, so such a session is retained rather than freed.
+ */
+static struct dentry *hfs_mount_fail(struct hfs_session *session, int err)
+{
+	unsigned long irqflags;
+
+	WRITE_ONCE(session->closing, true);
+	smp_wmb(); /* closing before blocked: hfs_session_poll_halt (oc4) */
+	if (hfs_controlled_consumed(session))
+		WRITE_ONCE(session->blocked, true);
+	hfs_session_stop_wake(session); /* 5f4: closing (and blocked) */
+	spin_lock_irqsave(&hfs_sessions_lock, irqflags);
+	list_del_init(&session->global);
+	spin_unlock_irqrestore(&hfs_sessions_lock, irqflags);
+	if (session->nr_requests || session->blocked || session->next_cell > 1) {
+		/* A failed attach cannot discard admitted claims or control cells. */
+		__module_get(THIS_MODULE);
+		session->retained = true;
+		session->provider->retain(session);
+	} else if (hfs_session_free(session)) {
+		/* A parked ticket/view owner prevents unsafe partial destruction. */
+		__module_get(THIS_MODULE);
+		session->retained = true;
+		session->provider->retain(session);
+	}
+	return ERR_PTR(err);
+}
+
+/* Mount order: cache option, provider, session, enrollment and its HELLO
+ * text, tracepoint, client and controlled transport, HELLO, then fill_super.
+ * Every failure after the session exists goes through hfs_mount_fail.
+ */
+struct dentry *v9fs_hfs_mount(struct file_system_type *type, int flags, const char *device,
+			      void *options)
+{
+	const char *hello = NULL;
+	struct hfs_session *session;
+	struct dentry *root;
+	unsigned long irqflags;
+	bool fd_attr;
+	int err;
+
+	if (current_user_ns() != &init_user_ns || flags & SB_POSIXACL)
+		return ERR_PTR(-EOPNOTSUPP);
+	/* Before enrollment, so a refused option consumes no identity. */
+	err = hfs_mount_options(options, &fd_attr);
+	if (err)
+		return ERR_PTR(err);
+	mutex_lock(&hfs_provider_lock);
+	if (!hfs_provider || !try_module_get(hfs_provider->owner)) {
+		mutex_unlock(&hfs_provider_lock);
+		return ERR_PTR(-EOPNOTSUPP);
+	}
+	session = hfs_session_new(hfs_provider);
+	if (!session) {
+		module_put(hfs_provider->owner);
+		mutex_unlock(&hfs_provider_lock);
+		return ERR_PTR(-ENOMEM);
+	}
+	session->fd_attr = fd_attr;
+	session->control = alloc_workqueue("9p-hfs-control", WQ_MEM_RECLAIM, 2);
+	err = session->control ? hfs_mount_enroll(session, device, &hello) : -ENOMEM;
+	if (!err)
+		err = hfs_trace_register();
+	if (err) {
+		mutex_unlock(&hfs_provider_lock);
+		return hfs_mount_fail(session, err);
+	}
+	spin_lock_irqsave(&hfs_sessions_lock, irqflags);
+	list_add_tail(&session->global, &hfs_sessions);
+	spin_unlock_irqrestore(&hfs_sessions_lock, irqflags);
+	mutex_unlock(&hfs_provider_lock);
+	err = hfs_mount_client(session, device, options);
+	if (!err)
+		err = hfs_mount_hello(session, hello);
+	if (err)
+		return hfs_mount_fail(session, err);
+	root = mount_nodev(type, flags, session, hfs_fill_super);
+	/* mount_nodev already invokes kill_sb after fill_super failure. */
+	if (IS_ERR(root) && !session->closing)
+		return hfs_mount_fail(session, PTR_ERR(root));
+	return root;
+}
+
+bool v9fs_hfs_super(const struct super_block *sb)
+{
+	return sb->s_op == &hfs_super_ops;
+}
+
+void v9fs_hfs_kill_super(struct super_block *sb)
+{
+	struct hfs_session *session = sb->s_fs_info;
+	unsigned long flags;
+	int err;
+
+	/* A clean unmount fences silently; only a failed close or stop logs. */
+	WRITE_ONCE(session->unmounting, true);
+	/* oc4: unmounting before any blocked store below (hfs_session_block,
+	 * the fences): pairs with smp_rmb() in hfs_session_poll_halt.
+	 */
+	smp_wmb();
+	err = hfs_controlled_begin_close(session);
+	if (err)
+		hfs_session_block(session, "failed controlled close", "UNMOUNT", err);
+	/* closing and blocked close every admission (ordinary ingress, view
+	 * tokens, cache pages, observations) before the superblock goes away.
+	 */
+	WRITE_ONCE(session->closing, true);
+	WRITE_ONCE(session->blocked, true);
+	hfs_session_stop_wake(session); /* 5f4: view waits see the stop */
+	/* Queued hfs_call waiters see closing and leave (x84). */
+	hfs_allocation_wake(session);
+	spin_lock_irqsave(&hfs_sessions_lock, flags);
+	list_del_init(&session->global);
+	spin_unlock_irqrestore(&hfs_sessions_lock, flags);
+	tracepoint_synchronize_unregister();
+	kill_anon_super(sb);
+	flush_workqueue(session->control);
+	/* hh4: the final abandon pass, after the flush ran any queued
+	 * abandon_work. Every caller has returned now (kill_anon_super evicted
+	 * the inodes), so a request the worker skipped (users, held) qualifies,
+	 * and a session that blocked silently (a fence while unmounting, or
+	 * kill_sb's own block above) never queued the work at all.
+	 */
+	hfs_session_abandon(session);
+	hfs_mmap_settle(session);
+	/* z84 (zq3-r10 R10-2): stop only after eviction, truncation, the
+	 * queued FORGET/PROCESS_EXIT work and a bounded settle of the view's
+	 * lease releases and their recall. Checked earlier, a LIVE view still
+	 * counted the mount's inodes and clean pages, so every clean unmount
+	 * of a once-reopened mount logged a failed stop. A real remaining
+	 * owner (a dirty or still-referenced page, a cookie, a recall still
+	 * running after the settle bound) still fails it.
+	 */
+	err = session->provider->stop(session);
+	if (err)
+		hfs_session_block(session, "failed provider stop", "STOP", err);
+	/* Protected claim/result retirement is separate from close or unmount. */
+	__module_get(THIS_MODULE);
+	session->retained = true;
+	session->provider->retain(session);
+	sb->s_fs_info = NULL;
+}
+
+int hfs_retirement_cut_new(struct hfs_session *session, const char *operation,
+	const struct hfs_buf *payload, u64 first, u64 through, struct hfs_retirement_cut **out)
+{
+	struct hfs_retirement_cut *cut;
+	void *credit;
+	int err;
+
+	*out = NULL;
+	if (!first || through < first || through - first >= 1024 ||
+	    payload->error || !payload->len || payload->len >= HFS_BODY_MAX ||
+	    (strcmp(operation, "RETIRE") && strcmp(operation, "VIEW_RETIRE")))
+		return -EINVAL;
+#ifdef CONFIG_9P_FS_HOMELABFS_CONTROLLED
+	if (hfs_controlled_owns(session))
+		err = hfs_controlled_progress_reserve(session, sizeof(*cut) + payload->len + 1ULL, &credit);
+	else
+#endif
+		err = session->provider->reserve(session, sizeof(*cut) + payload->len + 1ULL, true, &credit);
+	if (err)
+		return err;
+	cut = kzalloc(sizeof(*cut), GFP_KERNEL);
+	if (!cut) {
+		err = -ENOMEM;
+		goto unreserve;
+	}
+	err = hfs_buf_init(&cut->payload, payload->len + 1);
+	if (err) {
+		kfree(cut);
+		goto unreserve;
+	}
+	hfs_buf_add(&cut->payload, payload->data, payload->len);
+	cut->first = first;
+	cut->through = through;
+	memcpy(cut->operation, operation, strlen(operation) + 1);
+	cut->reservation = credit;
+	*out = cut;
+	return 0;
+unreserve:
+	session->provider->unreserve(session, credit);
+	return err;
+}
+
+void hfs_retirement_cut_free(struct hfs_session *session, struct hfs_retirement_cut *cut)
+{
+	void *credit;
+
+	if (!cut)
+		return;
+	credit = cut->reservation;
+	hfs_json_free(cut->response);
+	hfs_buf_free(&cut->payload);
+	kfree(cut);
+	session->provider->unreserve(session, credit);
+}
+
+int hfs_retire(struct hfs_session *session)
+{
+	struct hfs_request *request, *next, *issuer = NULL;
+	struct hfs_buf payload = {};
+	struct hfs_retirement_cut *cut = NULL;
+	struct hfs_json *reply = NULL;
+	void *scratch_credit = NULL;
+	u8 hash[32], proof[32];
+	u32 count = 0, len;
+	u64 through = 0, floor;
+	int err, token;
+
+	mutex_lock(&session->retirement);
+	if (session->bridge_minor == 4 && session->retirement_cut) {
+		cut = session->retirement_cut;
+		through = cut->through;
+		goto exchange;
+	}
+#ifdef CONFIG_9P_FS_HOMELABFS_CONTROLLED
+	if (hfs_controlled_owns(session)) {
+		/* This payload exists even before selecting any parent request and
+     * remains alive while retired request reservations are disposed.
+     */
+		err = hfs_controlled_progress_reserve(session, HFS_BODY_MAX, &scratch_credit);
+		if (err)
+			goto unreserve;
+	}
+#endif
+	err = hfs_buf_init(&payload, HFS_BODY_MAX);
+	if (err)
+		goto unreserve;
+	mutex_lock(&session->lock);
+	if (session->bridge_minor >= 2) {
+		list_for_each_entry(request, &session->requests, list) {
+			issuer = request;
+			break;
+		}
+		if (!issuer) {
+			mutex_unlock(&session->lock);
+			err = -EAGAIN;
+			goto free;
+		}
+		hfs_buf_printf(&payload, "{\"anchor\":\"%pUb\",\"credentials\":",
+			       &session->enrollment.anchor);
+		hfs_buf_add(&payload, issuer->credentials.data, issuer->credentials.len);
+		hfs_buf_printf(&payload,
+			       ",\"nonce\":\"%pUb\",\"realm\":\"%pUb\","
+			       "\"result_hashes\":[",
+			       &session->enrollment.nonce, &session->enrollment.realm);
+	} else {
+		hfs_buf_printf(&payload,
+			       "{\"anchor\":\"%pUb\",\"nonce\":\"%pUb\",\"realm\":\"%pUb\","
+			       "\"result_hashes\":[",
+			       &session->enrollment.anchor, &session->enrollment.nonce,
+			       &session->enrollment.realm);
+	}
+	list_for_each_entry(request, &session->requests, list) {
+		if (issuer && (issuer->credentials.len != request->credentials.len ||
+			       memcmp(issuer->credentials.data, request->credentials.data,
+				      issuer->credentials.len)))
+			break;
+		if (request->held || request->users)
+			break;
+		if (request->terminal && !request->adopted)
+			break;
+		if (!request->terminal) {
+			if (!request->gap)
+				break;
+			mutex_unlock(&session->lock);
+			err = session->provider->resolve_gap(session, request);
+			mutex_lock(&session->lock);
+			if (err || !request->terminal)
+				break;
+		}
+		len = 32;
+		if (session->bridge_minor == 4 && !request->result && request->gap &&
+		    request->gap_response) {
+			int gap = hfs_json_field(request->gap_response, 0, "payload");
+
+			err = hfs_json_hex(request->gap_response,
+					   hfs_json_field(request->gap_response, gap, "proof_hash"),
+					   hash, &len);
+		} else {
+			err = !request->result ?
+				      -EPROTO :
+				      hfs_json_hex(request->result,
+						   hfs_json_field(request->result, 0, "id"), hash,
+						   &len);
+		}
+		if (err || len != 32) {
+			err = -EPROTO;
+			mutex_unlock(&session->lock);
+			goto free;
+		}
+		if (count++)
+			hfs_buf_literal(&payload, ",");
+		hfs_buf_hex(&payload, hash, 32);
+		through = request->number;
+		if (count == 1024)
+			break;
+	}
+	mutex_unlock(&session->lock);
+	if (!count) {
+		err = -EAGAIN;
+		goto free;
+	}
+	hfs_buf_literal(&payload, "],\"subject\":");
+	hfs_buf_hex(&payload, session->enrollment.subject, session->enrollment.subject_len);
+	hfs_buf_printf(&payload, ",\"through\":%llu}", through);
+	if (session->bridge_minor == 4) {
+		err = hfs_retirement_cut_new(session, "RETIRE", &payload, issuer->number, through,
+					     &cut);
+		if (err)
+			goto free;
+		session->retirement_cut = cut;
+	}
+exchange:
+	if (cut && cut->response)
+		reply = cut->response;
+	else {
+		err = hfs_control(session, "RETIRE", cut ? &cut->payload : &payload, true, &reply);
+		if (err)
+			goto free;
+		if (cut)
+			cut->response = reply;
+	}
+	token = hfs_json_field(reply, 0, "payload");
+	if (hfs_json_exact(reply, token, "floor,proof_hash,status") ||
+	    hfs_field_u64(reply, token, "floor", &floor)) {
+		err = -EPROTO;
+		goto free;
+	}
+	if (hfs_json_is(reply, hfs_json_field(reply, token, "status"), "\"BLOCKED\"")) {
+		if (!hfs_json_is(reply, hfs_json_field(reply, token, "proof_hash"), "null")) {
+			err = -EPROTO;
+			goto free;
+		}
+		if (cut) {
+			session->retirement_cut = NULL;
+			hfs_retirement_cut_free(session, cut);
+			cut = NULL;
+			reply = NULL;
+		}
+		err = -EAGAIN;
+		goto free;
+	}
+	len = 32;
+	if (!hfs_json_is(reply, hfs_json_field(reply, token, "status"), "\"RETIRED\"") ||
+	    floor != through ||
+	    hfs_json_hex(reply, hfs_json_field(reply, token, "proof_hash"), proof, &len) ||
+	    len != 32) {
+		err = -EPROTO;
+		goto free;
+	}
+	err = session->provider->retirement(session, through, proof, reply);
+	if (err)
+		goto free;
+	mutex_lock(&session->lock);
+	/* A late borrower cannot be destroyed after the callback parked. The
+   * retained cut permits revalidation of the same already protected floor.
+   */
+	if (session->bridge_minor == 4) {
+		list_for_each_entry(request, &session->requests, list) {
+			if (request->number > through)
+				break;
+			if (request->held || request->users || !request->terminal ||
+			    !request->adopted) {
+				err = -EBUSY;
+				mutex_unlock(&session->lock);
+				goto free;
+			}
+		}
+	}
+	list_for_each_entry_safe(request, next, &session->requests, list) {
+		void *reservation = request->reservation;
+
+		if (request->number > through)
+			break;
+		list_del(&request->list);
+		/* Defensive (x84): a retired request can no longer hold the
+		 * fence; never leave waiters on a freed owner (minor < 4 has
+		 * no adoption check above).
+		 */
+		if (session->allocation_pending == request) {
+			session->allocation_pending = NULL;
+			hfs_allocation_changed_locked(session);
+		}
+		if (request->earmark_ticket) {
+			if (!WARN_ON_ONCE(!request->earmark_ticket->users))
+				request->earmark_ticket->users--;
+		}
+		session->nr_requests--;
+		if (request->control)
+			session->nr_control_requests--;
+		hfs_buf_free(&request->claim);
+		hfs_buf_free(&request->intent);
+		hfs_buf_free(&request->credentials);
+		hfs_buf_free(&request->original_context);
+		hfs_buf_free(&request->earmark_number);
+		hfs_buf_free(&request->drain_payload);
+		hfs_buf_free(&request->readdir_cleanup);
+		hfs_json_free(request->result);
+		hfs_json_free(request->refusal);
+		hfs_json_free(request->allocation_receipt);
+		hfs_json_free(request->response);
+		hfs_json_free(request->gap_response);
+		hfs_completion_close(request->completion);
+		kfree(request);
+		session->provider->unreserve(session, reservation);
+	}
+	mutex_unlock(&session->lock);
+	wake_up_all(&session->allocation_wait);
+	if (cut) {
+		session->retirement_cut = NULL;
+		hfs_retirement_cut_free(session, cut);
+		cut = NULL;
+		reply = NULL;
+	}
+free:
+	if (!cut)
+		hfs_json_free(reply);
+	hfs_buf_free(&payload);
+unreserve:
+	if (scratch_credit)
+		session->provider->unreserve(session, scratch_credit);
+	/* 1h4: every holder releases through hfs_retirement_unlock, so a BLOCKED
+	 * observation waiting for the mutex (hfs_view_retire_wait) wakes.
+	 */
+	hfs_retirement_unlock(session);
+	return err;
+}
+EXPORT_SYMBOL_GPL(hfs_retire);
+
+/* Only a protected recovery/retirement provider can relinquish retained state.
+ * 1h4: each release of session->retirement goes through
+ * hfs_retirement_unlock (the session is alive and session->lock is not held
+ * at each one; after hfs_view_free there is no view, so nothing to wake).
+ */
+int hfs_session_destroy(struct hfs_session *session)
+{
+	struct hfs_view *view;
+	int err;
+
+	if (!session || !session->retained || !session->closing)
+		return -EBUSY;
+	mutex_lock(&session->retirement);
+	if ((!list_empty(&session->uncertain) &&
+	     (!session->terminal_pending ||
+	      !hfs_terminal_candidate(session, &session->terminal_payload))) ||
+	    !list_empty(&session->requests)) {
+		hfs_retirement_unlock(session);
+		return -EBUSY;
+	}
+	view = hfs_view_get(session);
+	if (view) {
+		err = hfs_mmap_prepare_retire(view);
+		hfs_view_put(view);
+		if (err) {
+			hfs_retirement_unlock(session);
+			return err;
+		}
+	}
+	/* Joining a poll can expose an unknown transport result. It is not
+   * covered by an earlier proof and may not be discarded after the fact.
+   */
+	if ((!list_empty(&session->uncertain) &&
+	     (!session->terminal_pending ||
+	      !hfs_terminal_candidate(session, &session->terminal_payload))) ||
+	    !list_empty(&session->requests)) {
+		hfs_retirement_unlock(session);
+		return -EBUSY;
+	}
+	if (session->enrollment.protocol_features == HFS_TERMINAL_FEATURES &&
+	    !session->terminal_verified) {
+		if (session->retirement_cut || hfs_view_tickets_busy(session)) {
+			hfs_retirement_unlock(session);
+			return -EBUSY;
+		}
+		view = hfs_view_get(session);
+		if (view) {
+			err = hfs_mmap_terminal_prepare(view);
+			hfs_view_put(view);
+			if (!err)
+				err = hfs_view_free(session);
+			if (err) {
+				hfs_retirement_unlock(session);
+				return err;
+			}
+		}
+		/* Joined, physically empty control has relinquished its DOMAIN borrower.
+     * This is the normal destruction of our own immutable capability only;
+     * external aliases remain visible to the strict Received inventory. */
+		mutex_lock(&session->lock);
+		if (session->view || !list_empty(&session->requests) ||
+		    !list_empty(&session->descriptions) || !list_empty(&session->forgets) ||
+		    !list_empty(&session->view_tickets) || session->retirement_cut) {
+			mutex_unlock(&session->lock);
+			hfs_retirement_unlock(session);
+			return -EBUSY;
+		}
+		struct hfs_cap *domain = session->domain;
+		session->domain = NULL;
+		mutex_unlock(&session->lock);
+		hfs_cap_free(domain);
+	}
+	err = session->provider->retire_session(session);
+	hfs_retirement_unlock(session);
+	if (err)
+		return err;
+	WRITE_ONCE(session->retired, true);
+	err = hfs_session_free(session);
+	if (err)
+		return err;
+	module_put(THIS_MODULE);
+	return 0;
+}
+EXPORT_SYMBOL_GPL(hfs_session_destroy);
+
+void hfs_result_adopt(struct hfs_session *session, const struct hfs_json *result)
+{
+	struct hfs_request *request;
+
+	if (!result || !result->owner)
+		return;
+	mutex_lock(&session->lock);
+	list_for_each_entry(request, &session->requests, list) {
+		if (request == result->owner) {
+			request->adopted = true;
+			break;
+		}
+	}
+	mutex_unlock(&session->lock);
+}
diff --git a/fs/9p/hfs_inode.c b/fs/9p/hfs_inode.c
new file mode 100644
--- /dev/null
+++ b/fs/9p/hfs_inode.c
@@ -0,0 +1,1691 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Authoritative retained-9p attributes and namespace VFS operations. */
+#include <linux/magic.h>
+#include <linux/iversion.h>
+#include <linux/namei.h>
+#include <linux/pagemap.h>
+#include <linux/seq_file.h>
+#include <linux/slab.h>
+#include <linux/statfs.h>
+#include <linux/user_namespace.h>
+#include "hfs.h"
+
+void hfs_dcap_write(struct hfs_buf *buf, struct dentry *dentry)
+{
+	spin_lock(&dentry->d_lock);
+	hfs_cap_write(buf, dentry->d_fsdata ?: HFS_I(d_inode(dentry))->object);
+	spin_unlock(&dentry->d_lock);
+}
+
+/* 1a4 review: the wait for a committed result's initial attributes timed
+ * out (HFS_VIEW_ENTER_WAIT_MS). For CREATE, MKDIR or SYMLINK the host has
+ * already made the object, but the guest neither installs nor adopts it:
+ * iget_failed sends no FORGET, hfs_create discards its description locally,
+ * hfs_result_adopt never runs, so the request stays terminal and unadopted
+ * and pins its retirement floor, while userspace gets ETIMEDOUT. That is not
+ * a session block (the session stays usable); one line per occurrence names
+ * the session and opcode so a lab run can account for the object. The opcode
+ * comes from the request's own intent; only an [A-Z_] word is printed.
+ */
+static void hfs_attr_timeout_warn(struct hfs_session *session,
+				  const struct hfs_request *request)
+{
+	static const char key[] = "\"opcode\":\"";
+	const char *at = NULL, *end = request->intent.data + request->intent.len;
+	char opcode[24] = "?";
+	u32 i;
+
+	if (request->intent.data)
+		at = strnstr(request->intent.data, key, request->intent.len);
+	if (at) {
+		at += sizeof(key) - 1;
+		for (i = 0; i < sizeof(opcode) - 1 && at + i < end &&
+		     ((at[i] >= 'A' && at[i] <= 'Z') || at[i] == '_'); i++)
+			opcode[i] = at[i];
+		opcode[i ? i : 1] = 0;
+	}
+	pr_warn_ratelimited("9p-hfs: session %pUb %s committed but its initial attributes timed out behind a recall (-ETIMEDOUT); result retained unadopted, retirement floor pinned\n",
+			    &session->enrollment.session, opcode);
+}
+
+/* ie4 (zq3-r15 R15-1): a cache observation's stamp no longer admits it, but
+ * the view is not refused (the caller's stamped entry returned -ESTALE for a
+ * moved revision or -EAGAIN for a recall in progress). Wait for a LIVE view
+ * (HFS_VIEW_ENTER_WAIT_MS) and keep the observation if the view's target is
+ * still the one the request was stamped at: the recall reinstalled the same
+ * cut, so the attributes are as current as before it. If the target moved,
+ * the attributes may predate a change in the new cut; they are not
+ * installed and the answer is -HFS_ETARGET_MOVED: GETATTR and LOOKUP
+ * re-issue the request (hfs_reissue), since a peer's pinning LOOKUP, FORGET
+ * or DESCRIPTION_RELEASE moves the cut without changing what the
+ * observation covers. A refused view (FENCED, closing or blocked hfs1.4
+ * session) is -ESTALE at once, without a line; every other failed stamp
+ * check logs one rate-limited line.
+ *
+ * Its view wait is its own HFS_VIEW_ENTER_WAIT_MS, not the deadline of the
+ * request's observation (hfs_mmap_begin): hfs_attr_install gets no handle
+ * on that observation. hfs_view.h counts it among a syscall's windows.
+ */
+static int hfs_attr_restamp(struct hfs_session *session, struct hfs_view *view,
+			    const struct hfs_request *request, void **cookie)
+{
+	unsigned long flags;
+	bool same;
+	int err;
+
+	if (hfs_view_refused(view))
+		return -ESTALE;
+	err = hfs_view_enter(view, NULL, true, cookie);
+	if (err) {
+		pr_warn_ratelimited("9p-hfs: session %pUb attribute re-check failed and the view did not settle (%d)\n",
+				    &session->enrollment.session, err);
+		return err;
+	}
+	spin_lock_irqsave(&view->lock, flags);
+	same = !memcmp(view->target_hash, request->view_target, 32);
+	spin_unlock_irqrestore(&view->lock, flags);
+	pr_info_ratelimited("9p-hfs: session %pUb attribute re-check failed (%s); %s\n",
+			    &session->enrollment.session,
+			    same ? "recall completed at the same target" : "target moved",
+			    same ? "re-stamped" : "not installed, re-issuing");
+	if (same)
+		return 0;
+	hfs_view_leave(*cookie);
+	*cookie = NULL;
+	return -HFS_ETARGET_MOVED;
+}
+
+/* ie4 review round 1: whether a GETATTR or LOOKUP whose attributes were not
+ * installed because the view moved to another target (-HFS_ETARGET_MOVED)
+ * is issued again. Re-issues share one HFS_VIEW_ENTER_WAIT_MS deadline from
+ * the syscall's start; they stop on a fatal signal (-EINTR), a failed
+ * transport (oc4, -ESTALE) or the deadline (-ETIMEDOUT, one rate-limited
+ * line). Any other *err is final as it is.
+ */
+static bool hfs_reissue(struct hfs_session *session, int *err, unsigned long deadline,
+			const char *opcode)
+{
+	if (*err != -HFS_ETARGET_MOVED)
+		return false;
+	if (fatal_signal_pending(current)) {
+		*err = -EINTR;
+	} else if (READ_ONCE(session->transport_failed)) {
+		*err = -ESTALE;
+	} else if (!time_before(jiffies, deadline)) {
+		*err = -ETIMEDOUT;
+		pr_warn_ratelimited("9p-hfs: session %pUb %s re-issues exhausted after the view target kept moving (-ETIMEDOUT)\n",
+				    &session->enrollment.session, opcode);
+	} else {
+		return true;
+	}
+	return false;
+}
+
+/* Enters the view for hfs_attr_install. Returns 0 with *cookie admitted, 1
+ * when a mutation's delayed result must not be installed, or an error.
+ */
+static int hfs_attr_enter(struct inode *inode, struct hfs_session *session,
+			  struct hfs_view *view, const struct hfs_request *request,
+			  void **cookie)
+{
+	int err;
+
+	if (request && request->view_stamped &&
+	    (request->cache_observation || !(inode->i_state & I_NEW))) {
+		err = hfs_view_enter(view, &request->view_stamp, false, cookie);
+		/* A mutation's immutable result remains its result; never
+		 * overwrite newer cache metadata with its delayed reply.
+		 */
+		if (err && !request->cache_observation)
+			return 1;
+		/* ie4: a recall under a cache observation is routine. */
+		if (err == -ESTALE || err == -EAGAIN)
+			err = hfs_attr_restamp(session, view, request, cookie);
+		return err;
+	}
+	/* Initial immutable identity/creation attributes come from the
+	 * actual protected result. Subsequent observations revalidate.
+	 */
+	err = hfs_view_enter(view, NULL, true, cookie);
+	if (err == -ETIMEDOUT && request)
+		hfs_attr_timeout_warn(session, request);
+	return err;
+}
+
+int hfs_attr_install(struct inode *inode, const struct hfs_json *json, int token)
+{
+	struct hfs_attr attr;
+	struct hfs_session *session = HFS_S(inode);
+	struct hfs_view *view = NULL;
+	void *cookie = NULL;
+	int err;
+
+	err = hfs_attr_decode(json, token, &HFS_I(inode)->object->home,
+			      &HFS_I(inode)->object->allocation,
+			      inode->i_mode & S_IFMT, &attr);
+	if (err)
+		return err;
+	if (session->bridge_minor) {
+		view = hfs_view_get(session);
+		if (!view)
+			return -ESTALE;
+		err = hfs_attr_enter(inode, session, view, json->owner, &cookie);
+		if (err) {
+			hfs_view_put(view);
+			return err > 0 ? 0 : err;
+		}
+	}
+	spin_lock(&inode->i_lock);
+	if (attr.revision >= inode_peek_iversion_raw(inode)) {
+		inode->i_mode = attr.type | attr.mode;
+		inode->i_uid = make_kuid(&init_user_ns, attr.uid);
+		inode->i_gid = make_kgid(&init_user_ns, attr.gid);
+		set_nlink(inode, attr.nlink);
+		i_size_write(inode, attr.size);
+		inode->i_atime = (struct timespec64) { attr.atime.seconds, attr.atime.nanos };
+		inode->i_mtime = (struct timespec64) { attr.mtime.seconds, attr.mtime.nanos };
+		inode->i_ctime = (struct timespec64) { attr.ctime.seconds, attr.ctime.nanos };
+		inode_set_iversion_raw(inode, attr.revision);
+	}
+	spin_unlock(&inode->i_lock);
+	hfs_view_leave(cookie);
+	hfs_view_put(view);
+	return 0;
+}
+
+int hfs_object_ino(struct hfs_session *session, const struct hfs_cap *cap,
+		   unsigned long *number)
+{
+	struct hfs_object_number *object, *candidate;
+	int err = 0;
+
+	candidate = kzalloc(sizeof(*candidate), GFP_KERNEL);
+	if (!candidate)
+		return -ENOMEM;
+	mutex_lock(&session->lock);
+	list_for_each_entry(object, &session->object_numbers, list) {
+		if (uuid_equal(&object->home, &cap->home) &&
+		    uuid_equal(&object->allocation, &cap->allocation)) {
+			*number = object->number;
+			goto out;
+		}
+	}
+	if (session->nr_objects == HFS_IDENTITIES_MAX ||
+	    session->next_inode == ULONG_MAX) {
+		err = -ENOSPC;
+		goto out;
+	}
+	candidate->home = cap->home;
+	candidate->allocation = cap->allocation;
+	candidate->number = session->next_inode++;
+	list_add_tail(&candidate->list, &session->object_numbers);
+	session->nr_objects++;
+	*number = candidate->number;
+	candidate = NULL;
+out:
+	mutex_unlock(&session->lock);
+	kfree(candidate);
+	return err;
+}
+
+struct hfs_inode_seed {
+	struct hfs_forget *forget;
+	struct hfs_cap *cap;
+	struct hfs_cred *issuer;
+};
+
+static int hfs_test_inode(struct inode *inode, void *data)
+{
+	const struct hfs_cap *cap = ((struct hfs_inode_seed *)data)->cap;
+
+	return uuid_equal(&HFS_I(inode)->object->home, &cap->home) &&
+	       uuid_equal(&HFS_I(inode)->object->allocation, &cap->allocation);
+}
+
+static int hfs_set_inode(struct inode *inode, void *data)
+{
+	struct hfs_inode_seed *seed = data;
+
+	HFS_I(inode)->object = seed->cap;
+	HFS_I(inode)->forget = seed->forget;
+	HFS_I(inode)->forget->cap = seed->cap;
+	HFS_I(inode)->forget->issuer = seed->issuer;
+	return 0;
+}
+
+/* The inode owns every issued path token until all its dentry aliases die. */
+static void hfs_inode_link_forget(struct inode *inode,
+				  struct hfs_forget *forget,
+				  struct hfs_session *session)
+{
+	spin_lock(&inode->i_lock);
+	if (forget != HFS_I(inode)->forget) {
+		forget->next = HFS_I(inode)->forget;
+		HFS_I(inode)->forget = forget;
+	}
+	spin_unlock(&inode->i_lock);
+	forget->session = session;
+	mutex_lock(&session->lock);
+	list_add_tail(&forget->list, &session->forgets);
+	mutex_unlock(&session->lock);
+}
+
+/* hfs_inode_get after its attributes were not installed. Normally the seed
+ * (forget record, capability, issuer) dies with the failed inode and no
+ * FORGET is sent. A LOOKUP whose view target moved (-HFS_ETARGET_MOVED,
+ * ie4) is re-issued, so its host lookup count must not leak (it would pin
+ * the retirement floor): the seed is linked like a successful lookup's
+ * (count 1), and eviction sends its FORGET, at once for a new inode that
+ * iget_failed evicts, or with the existing inode's other references.
+ */
+static void hfs_inode_get_fail(struct inode *inode, struct hfs_inode_seed *seed,
+			       struct hfs_session *session, int err)
+{
+	bool keep = err == -HFS_ETARGET_MOVED && seed->forget->count;
+
+	if (keep)
+		hfs_inode_link_forget(inode, seed->forget, session);
+	if (inode->i_state & I_NEW) {
+		iget_failed(inode);
+		return;
+	}
+	iput(inode);
+	if (!keep) {
+		hfs_cap_free(seed->cap);
+		hfs_cred_free(seed->issuer);
+		kfree(seed->forget);
+	}
+}
+
+struct inode *hfs_inode_get(struct super_block *sb, struct hfs_json *result,
+			    const char *kind, const struct hfs_cred *issuer)
+{
+	struct hfs_session *session = sb->s_fs_info;
+	struct hfs_inode_seed seed;
+	struct hfs_cap *cap = NULL;
+	struct inode *inode;
+	unsigned long hash, number;
+	int err;
+
+	err = hfs_reply_cap(session, result, kind, &cap);
+	if (err)
+		return ERR_PTR(err);
+	err = hfs_object_ino(session, cap, &number);
+	if (err) {
+		hfs_cap_free(cap);
+		return ERR_PTR(err);
+	}
+	seed.cap = cap;
+	seed.issuer = kmemdup(issuer, sizeof(*issuer), GFP_KERNEL);
+	if (!seed.issuer) {
+		hfs_cap_free(cap);
+		return ERR_PTR(-ENOMEM);
+	}
+	seed.issuer->native = get_cred(issuer->native);
+	seed.forget = kzalloc(sizeof(*seed.forget), GFP_KERNEL);
+	if (!seed.forget) {
+		hfs_cred_free(seed.issuer);
+		hfs_cap_free(cap);
+		return ERR_PTR(-ENOMEM);
+	}
+	INIT_LIST_HEAD(&seed.forget->list);
+	seed.forget->cap = cap;
+	seed.forget->issuer = seed.issuer;
+	seed.forget->count = strcmp(kind, "ROOT") ? 1 : 0;
+	hash =
+	    full_name_hash(NULL, cap->allocation.b, sizeof(cap->allocation.b));
+	inode = iget5_locked(sb, hash, hfs_test_inode, hfs_set_inode, &seed);
+	if (!inode) {
+		kfree(seed.forget);
+		hfs_cred_free(seed.issuer);
+		hfs_cap_free(cap);
+		return ERR_PTR(-ENOMEM);
+	}
+	if ((inode->i_state & I_NEW) && session->bridge_minor) {
+		inode->i_mapping->a_ops = &hfs_cache_aops;
+		err = hfs_view_register_inode(inode);
+		if (err) {
+			iget_failed(inode);
+			return ERR_PTR(err);
+		}
+	}
+	err = hfs_attr_install(inode, result,
+			       hfs_json_field(result, 0, "attributes"));
+	if (err) {
+		hfs_inode_get_fail(inode, &seed, session, err);
+		return ERR_PTR(err);
+	}
+	if (inode->i_state & I_NEW) {
+		inode->i_ino = number;
+		if (S_ISDIR(inode->i_mode)) {
+			inode->i_op = &hfs_dir_iops;
+			inode->i_fop = &hfs_dir_fops;
+		} else if (S_ISREG(inode->i_mode)) {
+			inode->i_op = &hfs_file_iops;
+			inode->i_fop = &hfs_file_fops;
+		} else {
+			inode->i_op = &hfs_symlink_iops;
+		}
+	}
+	hfs_inode_link_forget(inode, seed.forget, session);
+	if (inode->i_state & I_NEW)
+		unlock_new_inode(inode);
+	return inode;
+}
+
+static struct inode *hfs_alloc_inode(struct super_block *sb)
+{
+	struct hfs_inode *inode = kzalloc(sizeof(*inode), GFP_KERNEL);
+
+	if (!inode)
+		return NULL;
+	INIT_LIST_HEAD(&inode->view_list);
+	inode_init_once(&inode->inode);
+	return &inode->inode;
+}
+
+static void hfs_free_inode(struct inode *inode)
+{
+	if (HFS_I(inode)->forget) {
+		hfs_cred_free(HFS_I(inode)->forget->issuer);
+		hfs_cap_free(HFS_I(inode)->forget->cap);
+		kfree(HFS_I(inode)->forget);
+	}
+	kfree(HFS_I(inode));
+}
+
+
+static void hfs_forget_work(struct work_struct *work)
+{
+	struct hfs_forget *forget = container_of(work, struct hfs_forget, work);
+	struct hfs_session *session = forget->session;
+	struct hfs_buf args;
+	struct hfs_json *result = NULL;
+	int err = hfs_args_init(&args);
+
+	if (!err) {
+		hfs_buf_printf(&args, "{\"count\":%llu,\"object\":", forget->count);
+		hfs_cap_write(&args, forget->cap);
+		hfs_buf_literal(&args, "}");
+		err = hfs_call(session, "FORGET", &args, forget->issuer, true, &result);
+	}
+	hfs_json_free(result);
+	hfs_buf_free(&args);
+	if (err) {
+		hfs_session_block(session, "FORGET failure", "FORGET", err);
+		return;
+	}
+	mutex_lock(&session->lock);
+	list_del(&forget->list);
+	mutex_unlock(&session->lock);
+	hfs_cap_free(forget->cap);
+	hfs_cred_free(forget->issuer);
+	kfree(forget);
+}
+
+static void hfs_evict_inode(struct inode *inode)
+{
+	struct hfs_forget *forget = HFS_I(inode)->forget;
+
+	/* Eviction is outside i_lock; remove inventory before inode memory
+	 * dies. */
+	hfs_view_unregister_inode(inode);
+	truncate_inode_pages_final(&inode->i_data);
+	clear_inode(inode);
+	HFS_I(inode)->forget = NULL;
+	while (forget) {
+		struct hfs_forget *next = forget->next;
+
+		forget->next = NULL;
+		if (!forget->session || !forget->count) {
+			if (forget->session) {
+				mutex_lock(&forget->session->lock);
+				list_del_init(&forget->list);
+				mutex_unlock(&forget->session->lock);
+			}
+			hfs_cred_free(forget->issuer);
+			hfs_cap_free(forget->cap);
+			kfree(forget);
+		} else {
+			INIT_WORK(&forget->work, hfs_forget_work);
+			queue_work(forget->session->control, &forget->work);
+		}
+		forget = next;
+	}
+}
+
+/* No dentry outlives a walk: every name walk does a fresh LOOKUP, so the path
+ * grant a GETATTR or SETATTR sends was issued inside the same syscall.
+ * s64: the Stale fallback in hfs_getattr/hfs_setattr relies on this
+ * returning 0 (no dentry outlives a walk); caching dentries requires limiting
+ * that fallback to fd callers first. Otherwise a name walk could reuse a
+ * dentry whose name was renamed away long ago, and the fallback would act on
+ * an object the caller can no longer name instead of the VFS relooking it up
+ * (LOOKUP_REVAL).
+ */
+static int hfs_d_revalidate(struct dentry *dentry, unsigned int flags)
+{
+	return flags & LOOKUP_RCU ? -ECHILD : 0;
+}
+
+static void hfs_d_release(struct dentry *dentry)
+{
+	hfs_cap_free(dentry->d_fsdata);
+}
+
+static const struct dentry_operations hfs_dops = {
+	.d_revalidate = hfs_d_revalidate,
+	.d_release = hfs_d_release,
+};
+
+/* Attach a dentry to hfs: its operations and its path grant (cap, or NULL
+ * for a negative lookup). vf4 (G2): the operations are set only once.
+ * hfs_lookup sets them on the negative dentry that CREATE, MKDIR and SYMLINK
+ * later instantiate, and that hfs_relookup looks up again after LINK or a
+ * CREATE that lost to EEXIST; d_set_d_op WARNs (fs/dcache.c) on a dentry that
+ * already has them, which tainted every guest since tz3. Operations other
+ * than hfs_dops are never expected and WARN once. A grant this replaces is
+ * freed; it is NULL on those paths, since the dentry was negative and
+ * hfs_d_revalidate makes every walk look up a fresh dentry. Readers copy the
+ * grant under d_lock (hfs_dcap_write).
+ */
+static void hfs_dentry_attach(struct dentry *dentry, struct hfs_cap *cap)
+{
+	struct hfs_cap *previous;
+
+	if (!dentry->d_op)
+		d_set_d_op(dentry, &hfs_dops);
+	else
+		WARN_ON_ONCE(dentry->d_op != &hfs_dops);
+	spin_lock(&dentry->d_lock);
+	previous = dentry->d_fsdata;
+	dentry->d_fsdata = cap;
+	spin_unlock(&dentry->d_lock);
+	hfs_cap_free(previous);
+}
+
+static int hfs_refresh_once(struct inode *inode)
+{
+	struct hfs_cred *cred;
+	struct hfs_buf args;
+	struct hfs_json *result = NULL;
+	void *cookie;
+	int err = hfs_begin(inode, false, &cred, &cookie);
+
+	if (err)
+		return err;
+	err = hfs_args_init(&args);
+	if (!err) {
+		hfs_args_object(&args, HFS_I(inode)->object);
+		err = hfs_call(HFS_S(inode), "GETATTR", &args, cred, false, &result);
+	}
+	if (!err)
+		err = hfs_attr_install(inode, result,
+				       hfs_json_field(result, 0, "attributes"));
+	hfs_json_free(result);
+	hfs_buf_free(&args);
+	hfs_end(inode, cred, cookie);
+	return err;
+}
+
+int hfs_refresh(struct inode *inode)
+{
+	unsigned long deadline = jiffies + msecs_to_jiffies(HFS_VIEW_ENTER_WAIT_MS);
+	int err;
+
+	do {
+		err = hfs_refresh_once(inode);
+	} while (hfs_reissue(HFS_S(inode), &err, deadline, "GETATTR"));
+	return err;
+}
+
+static int hfs_permission(struct user_namespace *mnt_userns,
+			  struct inode *inode, int mask)
+{
+	int err;
+
+	if (mask & MAY_NOT_BLOCK)
+		return -ECHILD;
+	err = hfs_refresh(inode);
+	return err ?: generic_permission(mnt_userns, inode, mask);
+}
+
+/* One LOOKUP exchange: on success *capp and *inodep (both NULL for a missing
+ * name); on failure nothing is kept.
+ */
+static int hfs_lookup_once(struct inode *dir, struct dentry *dentry,
+			   struct hfs_cap **capp, struct inode **inodep)
+{
+	struct hfs_cred *cred;
+	struct hfs_buf args;
+	struct hfs_json *result = NULL;
+	struct hfs_cap *cap = NULL;
+	struct inode *inode = NULL;
+	void *cookie;
+	int err;
+
+	err = hfs_begin(dir, false, &cred, &cookie);
+	if (err)
+		return err;
+	err = hfs_args_init(&args);
+	if (!err) {
+		hfs_buf_literal(&args, "{\"name\":");
+		hfs_buf_hex(&args, dentry->d_name.name, dentry->d_name.len);
+		hfs_buf_literal(&args, ",\"parent\":");
+		hfs_dcap_write(&args, dentry->d_parent);
+		hfs_buf_literal(&args, "}");
+		err = hfs_call(HFS_S(dir), "LOOKUP", &args, cred, false, &result);
+	}
+	if (err == -ENOENT)
+		err = 0;
+	else if (!err) {
+		err = hfs_reply_cap(HFS_S(dir), result, "PATH", &cap);
+		if (!err) {
+			inode = hfs_inode_get(dir->i_sb, result, "PATH", cred);
+			if (IS_ERR(inode)) {
+				err = PTR_ERR(inode);
+				inode = NULL;
+			}
+		}
+	}
+	/* ie4: a moved LOOKUP's count is owned by its forget record
+	 * (hfs_inode_get_fail), so its result is adopted as well.
+	 */
+	if ((!err && inode) || err == -HFS_ETARGET_MOVED)
+		hfs_result_adopt(HFS_S(dir), result);
+	hfs_json_free(result);
+	hfs_buf_free(&args);
+	hfs_end(dir, cred, cookie);
+	if (err) {
+		hfs_cap_free(cap);
+		return err;
+	}
+	*capp = cap;
+	*inodep = inode;
+	return 0;
+}
+
+static struct dentry *hfs_lookup(struct inode *dir, struct dentry *dentry,
+				 unsigned int flags)
+{
+	unsigned long deadline = jiffies + msecs_to_jiffies(HFS_VIEW_ENTER_WAIT_MS);
+	struct hfs_cap *cap = NULL;
+	struct inode *inode = NULL;
+	struct dentry *alias;
+	int err;
+
+	if (!dentry->d_name.len || dentry->d_name.len > 255)
+		return ERR_PTR(-ENAMETOOLONG);
+	do {
+		err = hfs_lookup_once(dir, dentry, &cap, &inode);
+	} while (hfs_reissue(HFS_S(dir), &err, deadline, "LOOKUP"));
+	if (err)
+		return ERR_PTR(err);
+	hfs_dentry_attach(dentry, cap);
+	alias = d_splice_alias(inode, dentry);
+	/* A directory alias carries another ancestry grant; force the caller to
+	 * rewalk instead of assigning this path's capability to that alias.
+	 */
+	if (IS_ERR(alias))
+		return alias;
+	if (alias) {
+		struct hfs_cap *previous;
+
+		/* Replace the alias's path grant while readers copy under d_lock. */
+		dentry->d_fsdata = NULL;
+		spin_lock(&alias->d_lock);
+		previous = alias->d_fsdata;
+		alias->d_fsdata = cap;
+		spin_unlock(&alias->d_lock);
+		hfs_cap_free(previous);
+	}
+	return alias;
+}
+
+/* vf4 review 1: look a name up again after the host made it (LINK, or a
+ * CREATE that lost to EEXIST). The dentry is the negative one an earlier
+ * hfs_lookup already hashed: filename_create's lookup_one_qstr_excl for
+ * link(2), the in-lookup dentry of hfs_atomic_open (d_splice_alias ->
+ * __d_add hashes both). d_splice_alias BUG()s on a hashed dentry
+ * (fs/dcache.c), so it is unhashed first, as nfs_add_or_obtain does. The
+ * parent's i_rwsem is held exclusively (filename_create, and
+ * open_last_lookups for O_CREAT), so no parallel lookup can add another
+ * dentry for the name meanwhile; on success d_splice_alias hashes it again.
+ *
+ * tg4: the guest lock does not stop the host, so two outcomes besides a
+ * plain positive dentry reach the callers:
+ * - directory alias: the name is (by now) a directory that already has a
+ *   dentry elsewhere; hfs_lookup returns that alias carrying this path's
+ *   grant and leaves @dentry unused. hfs_create_exists hands it to
+ *   finish_no_open, whose O_CREAT open refuses a directory with EISDIR;
+ *   hfs_link finds a different inode, returns ESTALE and drops the alias
+ *   (vfs_link never links a directory, so only a host race gets here).
+ * - negative race: the name was removed again before LOOKUP; hfs_lookup
+ *   returns NULL with @dentry rehashed negative. atomic_open in fs/namei.c
+ *   then fails the open with ENOENT; hfs_link sees no inode and returns
+ *   ESTALE.
+ */
+static struct dentry *hfs_relookup(struct inode *dir, struct dentry *dentry)
+{
+	d_drop(dentry);
+	return hfs_lookup(dir, dentry, 0);
+}
+
+void hfs_flags_write(struct hfs_buf *args, unsigned int flags, bool create)
+{
+	const char *access = (flags & O_ACCMODE) == O_WRONLY ? "WRITE" :
+		(flags & O_ACCMODE) == O_RDWR ? "READWRITE" : "READ";
+	const char *sync = (flags & O_SYNC) == O_SYNC ? "FILE" :
+		flags & O_DSYNC ? "DATA" : "ORDINARY";
+
+	hfs_buf_printf(args, "{\"access\":\"%s\",\"append\":%s,\"create\":%s,"
+		       "\"exclusive\":%s,\"sync\":\"%s\",\"truncate\":%s}",
+		       access, flags & O_APPEND ? "true" : "false",
+		       create ? "true" : "false", flags & O_EXCL ? "true" : "false",
+		       sync, flags & O_TRUNC ? "true" : "false");
+}
+
+/* CREATE arguments: always exclusive, so a fresh negative lookup keeps
+ * native DAC/LSM ordering; an existing name is opened by hfs_create_exists.
+ */
+static int hfs_create_args(struct hfs_buf *args, struct dentry *dentry,
+			   unsigned int flags, umode_t mode)
+{
+	int err = hfs_args_init(args);
+
+	if (err)
+		return err;
+	hfs_buf_literal(args, "{\"flags\":");
+	hfs_flags_write(args, flags | O_EXCL, true);
+	hfs_buf_printf(args, ",\"mode\":%u,\"name\":", mode & 07777);
+	hfs_buf_hex(args, dentry->d_name.name, dentry->d_name.len);
+	hfs_buf_literal(args, ",\"parent\":");
+	hfs_dcap_write(args, dentry->d_parent);
+	/* VFS already applied the guest umask/capability restrictions. */
+	hfs_buf_literal(args, ",\"umask\":0}");
+	return 0;
+}
+
+/* A protected Exists result without O_EXCL: open the existing object through
+ * a fresh lookup and the normal VFS open path (finish_no_open passes a
+ * lookup error through).
+ */
+static int hfs_create_exists(struct inode *dir, struct dentry *dentry,
+			     struct file *file)
+{
+	return finish_no_open(file, hfs_relookup(dir, dentry));
+}
+
+/* The committed CREATE's grants and new inode; on failure nothing is kept
+ * but what *capp holds (freed by the caller).
+ */
+static int hfs_create_inode(struct inode *dir, struct hfs_json *result,
+			    struct hfs_description *description,
+			    struct hfs_cred *cred, struct hfs_cap **capp,
+			    struct inode **inodep)
+{
+	struct inode *inode;
+	int err = hfs_description_publish(HFS_S(dir), result, description);
+
+	if (!err)
+		err = hfs_reply_cap(HFS_S(dir), result, "PATH", capp);
+	if (err)
+		return err;
+	inode = hfs_inode_get(dir->i_sb, result, "PATH", cred);
+	if (IS_ERR(inode))
+		return PTR_ERR(inode);
+	if (!S_ISREG(inode->i_mode) ||
+	    !uuid_equal(&description->cap->home, &HFS_I(inode)->object->home) ||
+	    !uuid_equal(&description->cap->allocation, &HFS_I(inode)->object->allocation)) {
+		iput(inode);
+		hfs_session_block(HFS_S(dir), "mismatched create result", "CREATE", -EPROTO);
+		return -EPROTO;
+	}
+	*inodep = inode;
+	return 0;
+}
+
+/* Install a committed CREATE and open it. The description and the issuing
+ * credentials move to the file only once the inode is instantiated.
+ */
+static int hfs_create_install(struct inode *dir, struct dentry *dentry,
+			      struct file *file, struct hfs_json *result,
+			      struct hfs_description **description,
+			      struct hfs_cred **cred)
+{
+	struct hfs_cap *cap = NULL;
+	struct inode *inode;
+	int err = hfs_create_inode(dir, result, *description, *cred, &cap, &inode);
+
+	if (err) {
+		hfs_cap_free(cap);
+		return err;
+	}
+	/* Never call inode_init_owner: returned creator UID, parent GID and all
+	 * supported special bits are the single authoritative committed result.
+	 */
+	hfs_dentry_attach(dentry, cap);
+	d_instantiate(dentry, inode);
+	(*description)->issuer = *cred;
+	*cred = NULL;
+	file->private_data = *description;
+	*description = NULL;
+	hfs_result_adopt(HFS_S(dir), result);
+	file->f_mode |= FMODE_CREATED;
+	err = finish_open(file, dentry, generic_file_open);
+	if (err)
+		hfs_session_block(HFS_S(dir), "local open failure after CREATE", "CREATE", err);
+	return err;
+}
+
+static int hfs_create(struct inode *dir, struct dentry *dentry,
+		      struct file *file, unsigned int flags, umode_t mode)
+{
+	struct hfs_cred *cred;
+	struct hfs_buf args;
+	struct hfs_json *result = NULL;
+	struct hfs_description *description = NULL;
+	void *cookie;
+	int err = hfs_begin(dir, true, &cred, &cookie);
+
+	if (err)
+		return err;
+	err = hfs_description_prepare(HFS_S(dir), false, &description);
+	if (!err)
+		err = hfs_create_args(&args, dentry, flags, mode);
+	if (err)
+		goto out;
+	err = hfs_call(HFS_S(dir), "CREATE", &args, cred, false, &result);
+	hfs_buf_free(&args);
+	if (err == -EEXIST && !(flags & O_EXCL)) {
+		hfs_json_free(result);
+		result = NULL;
+		err = hfs_create_exists(dir, dentry, file);
+	} else if (!err) {
+		err = hfs_create_install(dir, dentry, file, result, &description, &cred);
+	}
+out:
+	hfs_description_discard(HFS_S(dir), description);
+	hfs_json_free(result);
+	hfs_leave(dir, cookie);
+	hfs_cred_free(cred);
+	return err;
+}
+
+static int hfs_atomic_open(struct inode *dir, struct dentry *dentry,
+			   struct file *file, unsigned int flags, umode_t mode)
+{
+	if (d_in_lookup(dentry)) {
+		struct dentry *alias = hfs_lookup(dir, dentry, 0);
+
+		if (IS_ERR(alias))
+			return PTR_ERR(alias);
+		if (alias)
+			return finish_no_open(file, alias);
+	}
+	if (d_really_is_positive(dentry))
+		return finish_no_open(file, NULL);
+	if (!(flags & O_CREAT))
+		return -ENOENT;
+	if ((mode & ~(S_IFMT | 07777)) || (flags & O_TMPFILE) == O_TMPFILE)
+		return -EOPNOTSUPP;
+	return hfs_create(dir, dentry, file, flags, mode);
+}
+
+/* MKDIR/SYMLINK/UNLINK/RMDIR arguments; a too-long symlink target is
+ * refused before the CALL (and the buffer freed).
+ */
+static int hfs_namespace_args(struct hfs_buf *args, struct dentry *dentry,
+			      bool mkdir, umode_t mode, const char *target)
+{
+	int err = hfs_args_init(args);
+
+	if (err)
+		return err;
+	hfs_buf_literal(args, "{");
+	if (mkdir)
+		hfs_buf_printf(args, "\"mode\":%u,", mode & 07777);
+	hfs_buf_literal(args, "\"name\":");
+	hfs_buf_hex(args, dentry->d_name.name, dentry->d_name.len);
+	hfs_buf_literal(args, ",\"parent\":");
+	hfs_dcap_write(args, dentry->d_parent);
+	if (target) {
+		if (strlen(target) > 4096) {
+			hfs_buf_free(args);
+			return -ENAMETOOLONG;
+		}
+		hfs_buf_literal(args, ",\"target\":");
+		hfs_buf_hex(args, target, strlen(target));
+	}
+	if (mkdir)
+		hfs_buf_literal(args, ",\"umask\":0");
+	hfs_buf_literal(args, "}");
+	return 0;
+}
+
+/* Install a committed MKDIR (type S_IFDIR) or SYMLINK (S_IFLNK) result. */
+static int hfs_namespace_install(struct inode *dir, struct dentry *dentry,
+				 const char *opcode, umode_t type,
+				 struct hfs_json *result, struct hfs_cred *cred)
+{
+	struct hfs_cap *cap = NULL;
+	struct inode *inode;
+	int err = hfs_reply_cap(HFS_S(dir), result, "PATH", &cap);
+
+	if (err)
+		return err;
+	inode = hfs_inode_get(dir->i_sb, result, "PATH", cred);
+	if (IS_ERR(inode)) {
+		hfs_cap_free(cap);
+		return PTR_ERR(inode);
+	}
+	if ((inode->i_mode & S_IFMT) != type) {
+		iput(inode);
+		hfs_cap_free(cap);
+		hfs_session_block(HFS_S(dir), "mismatched object type", opcode, -EPROTO);
+		return -EPROTO;
+	}
+	hfs_dentry_attach(dentry, cap);
+	d_instantiate(dentry, inode);
+	hfs_result_adopt(HFS_S(dir), result);
+	return 0;
+}
+
+static int hfs_namespace(struct inode *dir, struct dentry *dentry,
+			 const char *opcode, umode_t mode, const char *target)
+{
+	struct hfs_cred *cred;
+	struct hfs_buf args;
+	struct hfs_json *result = NULL;
+	void *cookie;
+	bool mkdir = !strcmp(opcode, "MKDIR");
+	bool symlink = !strcmp(opcode, "SYMLINK");
+	int err = hfs_begin(dir, true, &cred, &cookie);
+
+	if (err)
+		return err;
+	err = hfs_namespace_args(&args, dentry, mkdir, mode, symlink ? target : NULL);
+	if (err)
+		goto out;
+	err = hfs_call(HFS_S(dir), opcode, &args, cred, false, &result);
+	hfs_buf_free(&args);
+	if (!err && (mkdir || symlink))
+		err = hfs_namespace_install(dir, dentry, opcode,
+					    mkdir ? S_IFDIR : S_IFLNK, result, cred);
+out:
+	hfs_json_free(result);
+	hfs_end(dir, cred, cookie);
+	return err;
+}
+
+static int hfs_mkdir(struct user_namespace *ns, struct inode *dir,
+		     struct dentry *dentry, umode_t mode)
+{
+	return mode & ~(S_IFMT | 07777) ? -EINVAL :
+		hfs_namespace(dir, dentry, "MKDIR", mode, NULL);
+}
+
+static int hfs_symlink(struct user_namespace *ns, struct inode *dir,
+		       struct dentry *dentry, const char *target)
+{
+	return hfs_namespace(dir, dentry, "SYMLINK", 0, target);
+}
+
+static int hfs_unlink(struct inode *dir, struct dentry *dentry)
+{
+	return hfs_namespace(dir, dentry, "UNLINK", 0, NULL);
+}
+
+static int hfs_rmdir(struct inode *dir, struct dentry *dentry)
+{
+	return hfs_namespace(dir, dentry, "RMDIR", 0, NULL);
+}
+
+static int hfs_link(struct dentry *old, struct inode *dir, struct dentry *dentry)
+{
+	struct hfs_cred *cred;
+	struct hfs_buf args;
+	struct hfs_json *result = NULL;
+	void *cookie;
+	int err;
+
+	if (old->d_sb != dentry->d_sb)
+		return -EXDEV;
+	err = hfs_begin(dir, true, &cred, &cookie);
+	if (err)
+		return err;
+	err = hfs_args_init(&args);
+	if (!err) {
+		hfs_buf_literal(&args, "{\"name\":");
+		hfs_buf_hex(&args, dentry->d_name.name, dentry->d_name.len);
+		hfs_buf_literal(&args, ",\"object\":");
+		hfs_dcap_write(&args, old);
+		hfs_buf_literal(&args, ",\"parent\":");
+		hfs_dcap_write(&args, dentry->d_parent);
+		hfs_buf_literal(&args, "}");
+		err = hfs_call(HFS_S(dir), "LINK", &args, cred, false, &result);
+	}
+	hfs_json_free(result);
+	hfs_buf_free(&args);
+	hfs_end(dir, cred, cookie);
+	if (!err) {
+		struct dentry *alias = hfs_relookup(dir, dentry);
+
+		err = IS_ERR(alias) ? PTR_ERR(alias) : 0;
+		if (!err && d_inode(alias ?: dentry) != d_inode(old))
+			err = -ESTALE;
+		if (!IS_ERR_OR_NULL(alias))
+			dput(alias);
+	}
+	return err;
+}
+
+static int hfs_rename(struct user_namespace *ns, struct inode *old_dir,
+		      struct dentry *old, struct inode *new_dir,
+		      struct dentry *new, unsigned int flags)
+{
+	struct hfs_cred *cred;
+	struct hfs_buf args;
+	struct hfs_json *result = NULL;
+	void *cookie;
+	int err;
+
+	if (old->d_sb != new->d_sb)
+		return -EXDEV;
+	if (flags & ~RENAME_NOREPLACE)
+		return -EOPNOTSUPP;
+	err = hfs_begin(old_dir, true, &cred, &cookie);
+	if (err)
+		return err;
+	err = hfs_args_init(&args);
+	if (!err) {
+		hfs_buf_literal(&args, "{\"destination_name\":");
+		hfs_buf_hex(&args, new->d_name.name, new->d_name.len);
+		hfs_buf_literal(&args, ",\"destination_parent\":");
+		hfs_dcap_write(&args, new->d_parent);
+		hfs_buf_printf(&args, ",\"no_replace\":%s,\"source_name\":",
+			       flags & RENAME_NOREPLACE ? "true" : "false");
+		hfs_buf_hex(&args, old->d_name.name, old->d_name.len);
+		hfs_buf_literal(&args, ",\"source_parent\":");
+		hfs_dcap_write(&args, old->d_parent);
+		hfs_buf_literal(&args, "}");
+		err = hfs_call(HFS_S(old_dir), "RENAME", &args, cred, false, &result);
+	}
+	hfs_json_free(result);
+	hfs_buf_free(&args);
+	hfs_end(old_dir, cred, cookie);
+	return err;
+}
+
+/* s64: GETATTR and SETATTR through the open file description.
+ *
+ * The VFS hands ->getattr only the path, and fchmod, fchown and futimens call
+ * notify_change without ATTR_FILE, so for those the guest finds an open
+ * DESCRIPTION of the same object itself (docs/design/s64-fd-attr.md):
+ * 1. ATTR_FILE (no ATTR_SIZE) with hfs_fdattr: the file's own description;
+ * 2. an unlinked inode (i_nlink 0) with hfs_fdattr: a borrowed description
+ *    at once, since the path form would be Stale anyway;
+ * 3. otherwise the path form, and after a host Stale (not a failed
+ *    transport or a blocked session) with hfs_fdattr, borrowed descriptions.
+ * Step 3 is safe because hfs_d_revalidate keeps no dentry across walks.
+ * Without hfs_fdattr only the original path shapes are sent.
+ */
+enum hfs_attr_authority {
+	HFS_ATTR_PATH,		/* {object} / {attributes, object} */
+	HFS_ATTR_FILE,		/* ATTR_FILE's own description */
+	HFS_ATTR_BORROWED,	/* an untried listed description (hfs_borrow) */
+	HFS_ATTR_LAST,		/* the description the last borrow used again */
+};
+
+/* s64: borrowed descriptions tried per syscall; bounds the walk. */
+#define HFS_FD_ATTR_TRIES 8
+
+/* Tokens of descriptions already sent in this syscall: a refused (closing)
+ * one is never retried, so the walk reaches the caller's own live one.
+ */
+struct hfs_borrow {
+	u8 tried[HFS_FD_ATTR_TRIES][32];
+	u32 count;
+};
+
+static bool hfs_borrow_tried(const struct hfs_borrow *borrow, const u8 *token)
+{
+	u32 i;
+
+	for (i = 0; i < borrow->count; i++)
+		if (!memcmp(borrow->tried[i], token, 32))
+			return true;
+	return false;
+}
+
+/* s64: append "description":<cap>, for a listed description of inode's
+ * object: with last, the one borrow used last; otherwise one this syscall
+ * has not tried yet, whose token is remembered. Returns 0 or -HFS_ENODESC.
+ * The cap bytes are copied under session->lock: hfs_description_bind
+ * publishes description->cap there and hfs_description_discard unlinks the
+ * description there before it frees the cap, so a listed cap is live while
+ * the lock is held. args is preallocated (hfs_args_init): no allocation.
+ */
+static int hfs_args_listed_description(struct hfs_buf *args, struct inode *inode,
+				       struct hfs_borrow *borrow, bool last)
+{
+	struct hfs_session *session = HFS_S(inode);
+	const struct hfs_cap *object = HFS_I(inode)->object;
+	struct hfs_description *description;
+	int err = -HFS_ENODESC;
+
+	if (!object || (last ? !borrow->count : borrow->count == HFS_FD_ATTR_TRIES))
+		return err;
+	mutex_lock(&session->lock);
+	list_for_each_entry(description, &session->descriptions, list) {
+		const struct hfs_cap *cap = description->cap;
+
+		if (!cap || !uuid_equal(&cap->home, &object->home) ||
+		    !uuid_equal(&cap->allocation, &object->allocation))
+			continue;
+		if (last ? memcmp(borrow->tried[borrow->count - 1], cap->token, 32) :
+		    hfs_borrow_tried(borrow, cap->token))
+			continue;
+		if (!last)
+			memcpy(borrow->tried[borrow->count++], cap->token, 32);
+		hfs_buf_literal(args, "\"description\":");
+		hfs_cap_write(args, cap);
+		hfs_buf_literal(args, ",");
+		err = 0;
+		break;
+	}
+	mutex_unlock(&session->lock);
+	return err;
+}
+
+/* s64: the optional "description":<cap>, key of a GETATTR/SETATTR. Sorted
+ * keys: it follows "attributes" and precedes "object". own is ATTR_FILE's
+ * description (HFS_ATTR_FILE only), which the caller holds open.
+ */
+static int hfs_args_description(struct hfs_buf *args, struct inode *inode,
+				enum hfs_attr_authority authority,
+				struct hfs_borrow *borrow,
+				const struct hfs_description *own)
+{
+	switch (authority) {
+	case HFS_ATTR_PATH:
+		return 0;
+	case HFS_ATTR_FILE:
+		hfs_buf_literal(args, "\"description\":");
+		hfs_cap_write(args, own ? own->cap : NULL);
+		hfs_buf_literal(args, ",");
+		return 0;
+	case HFS_ATTR_BORROWED:
+		return hfs_args_listed_description(args, inode, borrow, false);
+	default:
+		return hfs_args_listed_description(args, inode, borrow, true);
+	}
+}
+
+/* s64: whether a path-form result may fall back to borrowed descriptions: a
+ * host Stale on an hfs_fdattr mount whose transport works and which is not
+ * blocked (those -ESTALE answers are the session's, not the path's).
+ */
+static bool hfs_fd_attr_fallback(struct hfs_session *session, bool fd_attr, int err)
+{
+	return err == -ESTALE && fd_attr && !READ_ONCE(session->transport_failed) &&
+	       !READ_ONCE(session->blocked);
+}
+
+/* s64: whether a described call's error only says "this description is
+ * dead" (released grant -EACCES, gone or mismatched handle -ESTALE), so the
+ * walk tries the next one; never on a failed transport or blocked session.
+ */
+static bool hfs_fd_attr_dead(struct hfs_session *session, int err)
+{
+	return (err == -EACCES || err == -ESTALE) &&
+	       !READ_ONCE(session->transport_failed) && !READ_ONCE(session->blocked);
+}
+
+/* s64: the syscall's answer at the end of a borrowed walk. 0 and real
+ * failures are returned as they are. -HFS_ENODESC (nothing open is left to
+ * try) is fallback, the path form's -ESTALE. -EPROTO/-EINVAL on a minor-0/1
+ * session means an old forwarder or host refused the shape (no ALLOCATE, so
+ * nothing was admitted): hfs_fdattr is cleared for the session and the path
+ * error returned. On a controlled session the error is returned as it is.
+ */
+static int hfs_fd_attr_result(struct hfs_session *session, int err, int fallback)
+{
+	if (err == -HFS_ENODESC)
+		return fallback;
+	if ((err == -EPROTO || err == -EINVAL) && session->bridge_minor < 2) {
+		if (xchg(&session->fd_attr, false))
+			pr_warn_ratelimited("9p-hfs: session %pUb refused a described GETATTR/SETATTR (%d); hfs_fdattr off\n",
+					    &session->enrollment.session, err);
+		return fallback;
+	}
+	return err;
+}
+
+/* s64: one GETATTR through the path (HFS_ATTR_PATH), an untried borrowed
+ * description (HFS_ATTR_BORROWED) or the last borrowed one (HFS_ATTR_LAST).
+ * Key order is canonical: "description" < "object".
+ */
+static int hfs_getattr_send(struct dentry *dentry, enum hfs_attr_authority authority,
+			    struct hfs_borrow *borrow)
+{
+	struct inode *inode = d_inode(dentry);
+	struct hfs_cred *cred;
+	struct hfs_buf args;
+	struct hfs_json *result = NULL;
+	void *cookie;
+	int err = hfs_begin(inode, false, &cred, &cookie);
+
+	if (err)
+		return err;
+	err = hfs_args_init(&args);
+	if (!err) {
+		hfs_buf_literal(&args, "{");
+		err = hfs_args_description(&args, inode, authority, borrow, NULL);
+	}
+	if (!err) {
+		hfs_buf_literal(&args, "\"object\":");
+		hfs_dcap_write(&args, dentry);
+		hfs_buf_literal(&args, "}");
+		err = hfs_call(HFS_S(inode), "GETATTR", &args, cred, false, &result);
+	}
+	if (!err)
+		err = hfs_attr_install(inode, result,
+				       hfs_json_field(result, 0, "attributes"));
+	hfs_json_free(result);
+	hfs_buf_free(&args);
+	hfs_end(inode, cred, cookie);
+	return err;
+}
+
+/* s64: try untried descriptions until one answers. A described GETATTR has
+ * no owner rule, so -EACCES and -ESTALE only mean a dead description.
+ * Bounded: every round borrows a new token or ends with -HFS_ENODESC.
+ */
+static int hfs_getattr_borrowed(struct dentry *dentry, int fallback)
+{
+	struct hfs_session *session = HFS_S(d_inode(dentry));
+	struct hfs_borrow borrow = {};
+	int err;
+
+	do {
+		err = hfs_getattr_send(dentry, HFS_ATTR_BORROWED, &borrow);
+	} while (hfs_fd_attr_dead(session, err));
+	return hfs_fd_attr_result(session, err, fallback);
+}
+
+static int hfs_getattr_once(const struct path *path)
+{
+	struct inode *inode = d_inode(path->dentry);
+	struct hfs_session *session = HFS_S(inode);
+	bool fd_attr = READ_ONCE(session->fd_attr);
+	int err;
+
+	if (fd_attr && !inode->i_nlink)
+		return hfs_getattr_borrowed(path->dentry, -ESTALE);
+	err = hfs_getattr_send(path->dentry, HFS_ATTR_PATH, NULL);
+	if (!hfs_fd_attr_fallback(session, fd_attr, err))
+		return err;
+	return hfs_getattr_borrowed(path->dentry, err);
+}
+
+static int hfs_getattr(struct user_namespace *ns, const struct path *path,
+		       struct kstat *stat, u32 request, unsigned int flags)
+{
+	struct inode *inode = d_inode(path->dentry);
+	unsigned long deadline = jiffies + msecs_to_jiffies(HFS_VIEW_ENTER_WAIT_MS);
+	int err;
+
+	do {
+		err = hfs_getattr_once(path);
+	} while (hfs_reissue(HFS_S(inode), &err, deadline, "GETATTR"));
+	if (!err)
+		generic_fillattr(ns, inode, stat);
+	return err;
+}
+
+static void hfs_time_write(struct hfs_buf *args, struct timespec64 time)
+{
+	hfs_buf_printf(args, "{\"nanos\":%lu,\"seconds\":%lld}",
+		       time.tv_nsec, time.tv_sec);
+}
+
+/* "atime":T,"atime_now":B or "mtime":T,"mtime_now":B. T is the explicit time
+ * (ATTR_*_SET) or null; B asks the host for its own current time instead.
+ */
+static void hfs_optional_time(struct hfs_buf *args, struct iattr *attr,
+			      bool atime)
+{
+	unsigned int valid = attr->ia_valid;
+	unsigned int set = atime ? ATTR_ATIME_SET : ATTR_MTIME_SET;
+	bool now = (valid & (atime ? ATTR_ATIME : ATTR_MTIME)) && !(valid & set);
+
+	hfs_buf_literal(args, atime ? "\"atime\":" : "\"mtime\":");
+	if (valid & set)
+		hfs_time_write(args, atime ? attr->ia_atime : attr->ia_mtime);
+	else
+		hfs_buf_literal(args, "null");
+	hfs_buf_printf(args, atime ? ",\"atime_now\":%s" : ",\"mtime_now\":%s",
+		       now ? "true" : "false");
+}
+
+#define HFS_ATTR_KILL (ATTR_KILL_SUID | ATTR_KILL_SGID | ATTR_KILL_PRIV)
+
+/* vf4 (zq3-r18 R18-1): the ia_valid hfs_setattr sends, without the
+ * ATTR_KILL_* bits and the MODE notify_change derived from them.
+ *
+ * notify_change (fs/attr.c) has already turned a KILL_SUID/KILL_SGID whose
+ * bit is set into ATTR_MODE, the cached mode without that bit; it BUG()s on a
+ * caller's own MODE next to KILL_S*ID, so MODE beside them is always derived.
+ * The derived MODE is never sent: the host clears 06000 itself where Linux
+ * asks for it, and the cached mode may be stale (no refresh precedes fchown),
+ * so sending it could overwrite the host's permission bits. KILL_PRIV needs
+ * no host work: without xattr handlers security_inode_need_killpriv is 0 and
+ * notify_change drops it anyway. The three callers that set them:
+ * - chown_common (fs/open.c) for every non-directory: the host clears 06000 on
+ *   any UID or GID change (internal/fsservice/mutation.go attributes).
+ *   chown(-1, -1) of a setuid/setgid file is left with only ATTR_CTIME and is
+ *   refused like any chown(-1, -1) (no ctime-only host SETATTR), where Linux
+ *   clears the bits;
+ * - do_truncate (fs/open.c) when the caller lacks CAP_FSETID: TRUNCATE clears
+ *   06000 for a non-root caller (mutation.go), and the support check no longer
+ *   sees MODE next to SIZE;
+ * - __remove_privs (fs/inode.c, file_remove_privs/file_modified) before a
+ *   write: only ATTR_FORCE is left, never ATTR_CTIME, which hfs_setattr
+ *   treats as a local no-op: WRITE clears 06000 for a non-root caller itself
+ *   (mutation.go). hfs_write_iter does not call it today. Before vf4 a lone
+ *   ATTR_FORCE sent an empty SETATTR that the host refuses as invalid.
+ * The host decides on uid 0 where Linux checks CAP_FSETID, so a root caller
+ * without CAP_FSETID keeps its 06000 bits on the host; the host result is the
+ * mode the inode installs.
+ */
+static unsigned int hfs_setattr_sent(const struct iattr *attr)
+{
+	unsigned int valid = attr->ia_valid;
+
+	if (valid & (ATTR_KILL_SUID | ATTR_KILL_SGID))
+		valid &= ~ATTR_MODE;
+	return valid & ~HFS_ATTR_KILL;
+}
+
+/* The combinations SETATTR/TRUNCATE can carry (valid as sent, see
+ * hfs_setattr_sent); anything else fails before the CALL. Mode with
+ * suid/sgid next to an ownership change stays refused, as the host refuses
+ * it (it clears 06000 on that change).
+ * tg4: ATTR_TOUCH (utimensat(NULL), futimens(fd, NULL), both UTIME_NOW) is
+ * a VFS permission hint, already enforced by may_setattr in notify_change
+ * (owner, or write permission); the request it marks is ATIME|MTIME|CTIME
+ * without *_SET, which hfs_optional_time sends as host-current times.
+ */
+static bool hfs_setattr_supported(unsigned int valid, umode_t mode)
+{
+	bool truncate = valid & ATTR_SIZE;
+
+	if (valid & ~(ATTR_MODE | ATTR_UID | ATTR_GID | ATTR_SIZE | ATTR_ATIME |
+		      ATTR_MTIME | ATTR_CTIME | ATTR_ATIME_SET | ATTR_MTIME_SET |
+		      ATTR_TIMES_SET | ATTR_TOUCH | ATTR_FILE | ATTR_OPEN |
+		      ATTR_FORCE))
+		return false;
+	if (truncate && (valid & (ATTR_MODE | ATTR_UID | ATTR_GID)))
+		return false;
+	if (!truncate && valid & ATTR_CTIME && !(valid &
+	     (ATTR_MODE | ATTR_UID | ATTR_GID | ATTR_ATIME | ATTR_MTIME)))
+		return false;
+	if ((valid & ATTR_MODE) && (mode & ~(S_IFMT | 07777)))
+		return false;
+	return !((valid & ATTR_MODE) && (valid & (ATTR_UID | ATTR_GID)) &&
+		 (mode & (S_ISUID | S_ISGID)));
+}
+
+static void hfs_truncate_args(struct hfs_buf *args, struct dentry *dentry,
+			      struct iattr *attr,
+			      struct hfs_description *description)
+{
+	hfs_buf_literal(args, "{\"description\":");
+	if (description)
+		hfs_cap_write(args, description->cap);
+	else
+		hfs_buf_literal(args, "null");
+	hfs_buf_literal(args, ",\"object\":");
+	hfs_dcap_write(args, dentry);
+	hfs_buf_printf(args, ",\"size\":%lld,\"times\":{", attr->ia_size);
+	hfs_optional_time(args, attr, true);
+	hfs_buf_literal(args, ",\"ctime\":");
+	if (attr->ia_valid & ATTR_CTIME)
+		hfs_time_write(args, attr->ia_ctime);
+	else
+		hfs_buf_literal(args, "null");
+	hfs_buf_literal(args, ",");
+	hfs_optional_time(args, attr, false);
+	hfs_buf_literal(args, "}}");
+}
+
+/* SETATTR args in canonical key order: "attributes", then (s64, described
+ * forms only) "description", then "object". Returns 0 or -HFS_ENODESC when
+ * a borrowed description was asked for and none is left.
+ */
+static int hfs_setattr_args(struct hfs_buf *args, struct dentry *dentry,
+			    struct iattr *attr, enum hfs_attr_authority authority,
+			    struct hfs_borrow *borrow)
+{
+	unsigned int valid = attr->ia_valid;
+	int err;
+
+	hfs_buf_literal(args, "{\"attributes\":{");
+	hfs_optional_time(args, attr, true);
+	hfs_buf_literal(args, ",\"gid\":");
+	if (valid & ATTR_GID)
+		hfs_buf_printf(args, "%u", from_kgid(&init_user_ns, attr->ia_gid));
+	else
+		hfs_buf_literal(args, "null");
+	hfs_buf_literal(args, ",\"mode\":");
+	if (valid & ATTR_MODE)
+		hfs_buf_printf(args, "%u", attr->ia_mode & 07777);
+	else
+		hfs_buf_literal(args, "null");
+	hfs_buf_literal(args, ",");
+	hfs_optional_time(args, attr, false);
+	hfs_buf_literal(args, ",\"uid\":");
+	if (valid & ATTR_UID)
+		hfs_buf_printf(args, "%u", from_kuid(&init_user_ns, attr->ia_uid));
+	else
+		hfs_buf_literal(args, "null");
+	hfs_buf_literal(args, "},");
+	err = hfs_args_description(args, d_inode(dentry), authority, borrow,
+				   valid & ATTR_FILE ? attr->ia_file->private_data : NULL);
+	if (err)
+		return err;
+	hfs_buf_literal(args, "\"object\":");
+	hfs_dcap_write(args, dentry);
+	hfs_buf_literal(args, "}");
+	return 0;
+}
+
+/* One TRUNCATE (ATTR_SIZE: ATTR_FILE's description, else null; authority
+ * unused) or SETATTR with the given authority (s64).
+ */
+static int hfs_setattr_send(struct dentry *dentry, struct iattr *attr,
+			    enum hfs_attr_authority authority,
+			    struct hfs_borrow *borrow)
+{
+	struct inode *inode = d_inode(dentry);
+	struct hfs_cred *cred;
+	struct hfs_buf args;
+	struct hfs_json *result = NULL;
+	struct hfs_description *description = NULL;
+	void *cookie;
+	bool truncate = attr->ia_valid & ATTR_SIZE;
+	int err;
+
+	if (attr->ia_valid & ATTR_FILE)
+		description = attr->ia_file->private_data;
+	err = hfs_begin(inode, true, &cred, &cookie);
+	if (err)
+		return err;
+	err = hfs_args_init(&args);
+	if (err)
+		goto out;
+	if (truncate)
+		hfs_truncate_args(&args, dentry, attr, description);
+	else
+		err = hfs_setattr_args(&args, dentry, attr, authority, borrow);
+	if (!err)
+		err = hfs_call(HFS_S(inode), truncate ? "TRUNCATE" : "SETATTR",
+			       &args, cred, false, &result);
+	if (!err)
+		err = hfs_attr_install(inode, result,
+				       hfs_json_field(result, 0, "attributes"));
+	hfs_buf_free(&args);
+out:
+	hfs_json_free(result);
+	hfs_end(inode, cred, cookie);
+	return err;
+}
+
+/* s64: the errno the path form would give for a described SETATTR the host
+ * refused with Permission (err) by its owner rule. With the attributes the
+ * probe just installed, setattr_prepare answers -EPERM where Linux would on
+ * a local filesystem (mode, uid, gid or explicit times by a non-owner
+ * without the capability); otherwise the host's -EACCES stands (current
+ * times without write permission). setattr_prepare runs no host call.
+ */
+static int hfs_setattr_refusal(struct user_namespace *ns, struct dentry *dentry,
+			       struct iattr *attr, int err)
+{
+	int owner = setattr_prepare(ns, dentry, attr);
+
+	return owner ? owner : err;
+}
+
+/* s64: SETATTR through untried descriptions. After -EACCES, a GETATTR
+ * through the same description (HFS_ATTR_LAST, not re-borrowed) tells a
+ * dead description (-EACCES/-ESTALE: try the next) from an owner refusal
+ * (it answers: return the refusal, never -ESTALE). A probe whose attributes
+ * were not installed because the view target moved still answered. The
+ * fd caller's own description is always listed (it holds the file), so it
+ * always gets its real refusal.
+ */
+static int hfs_setattr_borrowed(struct user_namespace *ns, struct dentry *dentry,
+				struct iattr *attr, int fallback)
+{
+	struct hfs_session *session = HFS_S(d_inode(dentry));
+	struct hfs_borrow borrow = {};
+	int err, probe;
+
+	for (;;) {
+		err = hfs_setattr_send(dentry, attr, HFS_ATTR_BORROWED, &borrow);
+		if (!hfs_fd_attr_dead(session, err))
+			break;
+		if (err == -ESTALE)
+			continue;
+		probe = hfs_getattr_send(dentry, HFS_ATTR_LAST, &borrow);
+		if (!probe || probe == -HFS_ETARGET_MOVED)
+			return hfs_setattr_refusal(ns, dentry, attr, err);
+		if (probe != -HFS_ENODESC && !hfs_fd_attr_dead(session, probe))
+			return probe;
+	}
+	return hfs_fd_attr_result(session, err, fallback);
+}
+
+/* s64: a SETATTR without ATTR_SIZE: steps 1 to 3 of the described forms
+ * (see enum hfs_attr_authority). With ATTR_FILE its own description's
+ * Permission is a real refusal: the caller holds that file.
+ */
+static int hfs_setattr_attributes(struct user_namespace *ns, struct dentry *dentry,
+				  struct iattr *attr)
+{
+	struct inode *inode = d_inode(dentry);
+	struct hfs_session *session = HFS_S(inode);
+	bool fd_attr = READ_ONCE(session->fd_attr);
+	int err;
+
+	if (fd_attr && (attr->ia_valid & ATTR_FILE))
+		return hfs_setattr_send(dentry, attr, HFS_ATTR_FILE, NULL);
+	if (fd_attr && !inode->i_nlink)
+		return hfs_setattr_borrowed(ns, dentry, attr, -ESTALE);
+	err = hfs_setattr_send(dentry, attr, HFS_ATTR_PATH, NULL);
+	if (!hfs_fd_attr_fallback(session, fd_attr, err))
+		return err;
+	return hfs_setattr_borrowed(ns, dentry, attr, err);
+}
+
+/* setattr_prepare checks the request as the VFS built it, derived MODE
+ * included (vf4 review 1), so a chown of a setuid/setgid file still needs
+ * inode_owner_or_capable (CAP_CHOWN alone gives EPERM, as in Linux); only
+ * then is the request reduced to what hfs_setattr_sent keeps. The guest's
+ * checks run first on the cached attributes; the host's are authoritative.
+ * ATTR_SIZE is TRUNCATE (ftruncate's own description, r64); everything else
+ * is SETATTR, described or not (s64, hfs_setattr_attributes).
+ */
+static int hfs_setattr(struct user_namespace *ns, struct dentry *dentry,
+		       struct iattr *attr)
+{
+	unsigned int sent = hfs_setattr_sent(attr);
+	bool truncate = sent & ATTR_SIZE;
+	int err;
+
+	if (!(sent & ~ATTR_FORCE))
+		return 0;
+	if (!hfs_setattr_supported(sent, attr->ia_mode))
+		return -EOPNOTSUPP;
+	err = setattr_prepare(ns, dentry, attr);
+	if (err)
+		return err;
+	attr->ia_valid = sent;
+	if (truncate && attr->ia_size < 0)
+		return -EINVAL;
+	if (truncate)
+		return hfs_setattr_send(dentry, attr, HFS_ATTR_PATH, NULL);
+	return hfs_setattr_attributes(ns, dentry, attr);
+}
+
+static const char *hfs_get_link(struct dentry *dentry, struct inode *inode,
+			       struct delayed_call *done)
+{
+	struct hfs_cred *cred;
+	struct hfs_buf args;
+	struct hfs_json *result = NULL;
+	void *cookie;
+	char *target = NULL;
+	u32 len = 4096;
+	int err;
+
+	if (!dentry)
+		return ERR_PTR(-ECHILD);
+	err = hfs_begin(inode, false, &cred, &cookie);
+	if (err)
+		return ERR_PTR(err);
+	err = hfs_args_init(&args);
+	if (!err) {
+		hfs_buf_literal(&args, "{\"object\":");
+		hfs_dcap_write(&args, dentry);
+		hfs_buf_literal(&args, "}");
+		err = hfs_call(HFS_S(inode), "READLINK", &args, cred, false, &result);
+	}
+	if (!err) {
+		target = kmalloc(4097, GFP_KERNEL);
+		if (!target)
+			err = -ENOMEM;
+		else
+			err = hfs_json_hex(result, hfs_json_field(result, 0, "data"),
+					   target, &len);
+		if (!err && memchr(target, 0, len))
+			err = -EPROTO;
+	}
+	hfs_json_free(result);
+	hfs_buf_free(&args);
+	hfs_end(inode, cred, cookie);
+	if (err) {
+		kfree(target);
+		return ERR_PTR(err);
+	}
+	target[len] = 0;
+	set_delayed_call(done, kfree_link, target);
+	return target;
+}
+
+static int hfs_statfs(struct dentry *dentry, struct kstatfs *stat)
+{
+	struct inode *inode = d_inode(dentry);
+	struct hfs_cred *cred;
+	struct hfs_buf args;
+	struct hfs_json *result = NULL;
+	void *cookie;
+	int err, token;
+	u64 bytes, free_bytes, objects, free_objects;
+
+	err = hfs_begin(inode, false, &cred, &cookie);
+	if (err)
+		return err;
+	err = hfs_args_init(&args);
+	if (!err) {
+		hfs_buf_literal(&args, "{\"root\":");
+		hfs_cap_write(&args, HFS_I(d_inode(dentry->d_sb->s_root))->object);
+		hfs_buf_literal(&args, "}");
+		err = hfs_call(HFS_S(inode), "STATFS", &args, cred, false, &result);
+	}
+	if (!err) {
+		token = hfs_json_field(result, 0, "capacity");
+		if (hfs_json_exact(result, token, "bytes,bytes_free,objects,objects_free") ||
+		    hfs_json_u64(result, hfs_json_field(result, token, "bytes"), &bytes) ||
+		    hfs_json_u64(result, hfs_json_field(result, token, "bytes_free"),
+				 &free_bytes) ||
+		    hfs_json_u64(result, hfs_json_field(result, token, "objects"), &objects) ||
+		    hfs_json_u64(result, hfs_json_field(result, token, "objects_free"),
+				 &free_objects) ||
+		    free_bytes > bytes || free_objects > objects) {
+			err = -EPROTO;
+		} else {
+			stat->f_type = V9FS_MAGIC;
+			stat->f_bsize = 4096;
+			stat->f_blocks = bytes / 4096;
+			stat->f_bfree = stat->f_bavail = free_bytes / 4096;
+			stat->f_files = objects;
+			stat->f_ffree = free_objects;
+			stat->f_namelen = 255;
+		}
+	}
+	hfs_json_free(result);
+	hfs_buf_free(&args);
+	hfs_end(inode, cred, cookie);
+	return err;
+}
+
+/* Super options in mountinfo, after the VFS's own "rw"/"ro" (g64).
+ *
+ * Without this callback mountinfo showed only "rw" (zq3-r7 R7-1), so the
+ * guest tools could not see the admitted tuple. cache=mmap is the only mode
+ * hfs_cache_option admits and the one hfs implements, so it is printed as an
+ * enforced fact. msize, trans and the negotiated version come from the live
+ * client: p9_show_client_options prints msize unconditionally for hfs, and the
+ * mount already refused any version other than the provider's exact minor.
+ * For the zq3 mount this gives
+ * ",cache=mmap,msize=65536,trans=virtio,version=9P2000.L.hfs1.4".
+ * s64: a mount with hfs_fdattr (still in effect) prints it after cache=mmap.
+ */
+static int hfs_show_options(struct seq_file *m, struct dentry *root)
+{
+	struct hfs_session *session = root->d_sb->s_fs_info;
+
+	seq_puts(m, ",cache=mmap");
+	if (session && READ_ONCE(session->fd_attr))
+		seq_puts(m, ",hfs_fdattr");
+	if (!session || !session->client)
+		return 0;
+	return p9_show_client_options(m, session->client);
+}
+
+const struct super_operations hfs_super_ops = {
+	.alloc_inode = hfs_alloc_inode,
+	.free_inode = hfs_free_inode,
+	.evict_inode = hfs_evict_inode,
+	.statfs = hfs_statfs,
+	.drop_inode = generic_delete_inode,
+	.show_options = hfs_show_options,
+};
+
+const struct inode_operations hfs_dir_iops = {
+	.lookup = hfs_lookup,
+	.atomic_open = hfs_atomic_open,
+	.mkdir = hfs_mkdir,
+	.symlink = hfs_symlink,
+	.unlink = hfs_unlink,
+	.rmdir = hfs_rmdir,
+	.link = hfs_link,
+	.rename = hfs_rename,
+	.getattr = hfs_getattr,
+	.setattr = hfs_setattr,
+	.permission = hfs_permission,
+};
+
+const struct inode_operations hfs_file_iops = {
+	.getattr = hfs_getattr,
+	.setattr = hfs_setattr,
+	.permission = hfs_permission,
+};
+
+const struct inode_operations hfs_symlink_iops = {
+	.get_link = hfs_get_link,
+	.getattr = hfs_getattr,
+	.setattr = hfs_setattr,
+};
diff --git a/fs/9p/hfs_file.c b/fs/9p/hfs_file.c
new file mode 100644
--- /dev/null
+++ b/fs/9p/hfs_file.c
@@ -0,0 +1,665 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Description-bound retained-9p I/O. Advisory locks stay in this kernel mount. */
+#include <linux/file.h>
+#include <linux/namei.h>
+#include <linux/sched/signal.h>
+#include <linux/slab.h>
+#include <linux/uio.h>
+#include <linux/user_namespace.h>
+#include <linux/vmalloc.h>
+#include <linux/resource.h>
+#include <linux/sched/signal.h>
+#include "hfs.h"
+
+int hfs_description_prepare(struct hfs_session *session, bool directory,
+			    struct hfs_description **out)
+{
+	struct hfs_description *description;
+	u64 bytes = sizeof(*description) + sizeof(struct hfs_cred);
+	int err;
+
+	*out = NULL;
+	if (directory)
+		bytes += sizeof(struct hfs_dir_cursor);
+	description = kzalloc(sizeof(*description), GFP_KERNEL);
+	if (!description)
+		return -ENOMEM;
+	INIT_LIST_HEAD(&description->list);
+	mutex_init(&description->lock);
+	err = session->provider->reserve(session, bytes, false,
+					 &description->reservation);
+	if (err)
+		goto free;
+	if (directory) {
+		description->cursor = kvzalloc(sizeof(*description->cursor), GFP_KERNEL);
+		if (!description->cursor) {
+			err = -ENOMEM;
+			goto unreserve;
+		}
+		hfs_cursor_init(description->cursor);
+	}
+	mutex_lock(&session->lock);
+	if (session->nr_descriptions == HFS_IDENTITIES_MAX) {
+		err = -ENOSPC;
+	} else {
+		session->nr_descriptions++;
+		list_add_tail(&description->list, &session->descriptions);
+	}
+	mutex_unlock(&session->lock);
+	if (err)
+		goto unreserve;
+	*out = description;
+	return 0;
+unreserve:
+	kvfree(description->cursor);
+	session->provider->unreserve(session, description->reservation);
+free:
+	kfree(description);
+	return err;
+}
+
+void hfs_description_discard(struct hfs_session *session,
+			     struct hfs_description *description)
+{
+	if (!description)
+		return;
+	mutex_lock(&session->lock);
+	if (!list_empty(&description->list)) {
+		list_del(&description->list);
+		session->nr_descriptions--;
+	}
+	mutex_unlock(&session->lock);
+	hfs_cap_free(description->cap);
+	hfs_cred_free(description->issuer);
+	kvfree(description->cursor);
+	session->provider->unreserve(session, description->reservation);
+	kfree(description);
+}
+
+/* Parse an OPEN or CREATE reply's DESCRIPTION grant into the listed
+ * description. s64: published under session->lock, where hfs_inode.c's
+ * borrowed GETATTR/SETATTR walk reads listed caps; hfs_description_discard
+ * unlinks before it frees, so a cap seen under the lock stays live.
+ */
+int hfs_description_publish(struct hfs_session *session,
+			    const struct hfs_json *result,
+			    struct hfs_description *description)
+{
+	struct hfs_cap *cap;
+	int err = hfs_reply_cap(session, result, "DESCRIPTION", &cap);
+
+	if (err)
+		return err;
+	mutex_lock(&session->lock);
+	description->cap = cap;
+	mutex_unlock(&session->lock);
+	return 0;
+}
+
+static int hfs_description_bind(struct inode *inode, struct file *file,
+				struct hfs_json *result, struct hfs_cred *issuer,
+				struct hfs_description *description)
+{
+	int err;
+
+	err = hfs_description_publish(HFS_S(inode), result, description);
+	if (err)
+		return err;
+	if (!uuid_equal(&description->cap->home, &HFS_I(inode)->object->home) ||
+	    !uuid_equal(&description->cap->allocation, &HFS_I(inode)->object->allocation) ||
+	    ((file->f_mode & FMODE_READ) && !(description->cap->rights & 1)) ||
+	    ((file->f_mode & FMODE_WRITE) && !(description->cap->rights & 2)))
+		return -EPROTO;
+	description->issuer = issuer;
+	file->private_data = description;
+	return 0;
+}
+
+int hfs_open(struct inode *inode, struct file *file)
+{
+	struct hfs_cred *cred;
+	struct hfs_buf args;
+	struct hfs_json *result = NULL;
+	struct hfs_description *description = NULL;
+	void *cookie;
+	int err;
+
+	if (file->private_data)
+		return 0;
+	if (file->f_flags & (O_DIRECT | O_PATH) ||
+	    (file->f_flags & O_TMPFILE) == O_TMPFILE)
+		return -EOPNOTSUPP;
+	err = hfs_begin(inode, !!(file->f_mode & FMODE_WRITE), &cred, &cookie);
+	if (err)
+		return err;
+	err = hfs_description_prepare(HFS_S(inode), S_ISDIR(inode->i_mode),
+				       &description);
+	if (err)
+		goto out;
+	err = hfs_args_init(&args);
+	if (!err) {
+		hfs_buf_literal(&args, "{\"flags\":");
+		hfs_flags_write(&args, file->f_flags & ~(O_CREAT | O_TRUNC), false);
+		hfs_buf_literal(&args, ",\"object\":");
+		hfs_dcap_write(&args, file->f_path.dentry);
+		hfs_buf_literal(&args, "}");
+		err = hfs_call(HFS_S(inode), "OPEN", &args, cred, false, &result);
+	}
+	if (!err)
+		err = hfs_description_bind(inode, file, result, cred, description);
+	if (!err)
+		hfs_result_adopt(HFS_S(inode), result);
+	if (err)
+		hfs_description_discard(HFS_S(inode), description);
+	hfs_json_free(result);
+	hfs_buf_free(&args);
+out:
+	if (err)
+		hfs_cred_free(cred);
+	hfs_leave(inode, cookie);
+	return err;
+}
+
+static ssize_t hfs_io(struct kiocb *iocb, struct iov_iter *iter, bool write,
+		      u64 max_end)
+{
+	struct file *file = iocb->ki_filp;
+	struct inode *inode = file_inode(file);
+	struct hfs_description *description = file->private_data;
+	struct hfs_cred *cred;
+	struct hfs_buf args;
+	struct hfs_json *result = NULL;
+	struct hfs_attr selected;
+	void *cookie;
+	u8 *bytes;
+	u32 len = min_t(size_t, iov_iter_count(iter), HFS_IO_MAX);
+	u64 count = 0;
+	bool copied = false, append = iocb->ki_flags & IOCB_APPEND;
+	int err, attributes;
+
+	if (!description || !description->cap ||
+	    !(description->cap->rights & (write ? 2 : 1)))
+		return -EBADF;
+	if (!len)
+		return 0;
+	if (iocb->ki_pos < 0 || iocb->ki_pos > MAX_LFS_FILESIZE - len)
+		return -EFBIG;
+	if (iocb->ki_flags & (IOCB_NOWAIT | IOCB_HIPRI | IOCB_DIRECT))
+		return -EOPNOTSUPP;
+	/* Per-call RWF_APPEND needs its own negotiated representation. */
+	if (write && append != !!(file->f_flags & O_APPEND))
+		return -EOPNOTSUPP;
+	bytes = kmalloc(len, GFP_KERNEL);
+	if (!bytes)
+		return -ENOMEM;
+	err = hfs_begin_cap(inode, description->cap, write, &cred, &cookie);
+	if (err)
+		goto free;
+	if (write) {
+		if (!copy_from_iter_full(bytes, len, iter)) {
+			err = -EFAULT;
+			goto end;
+		}
+		copied = true;
+	}
+	err = hfs_args_init(&args);
+	if (err)
+		goto end;
+	if (write) {
+		hfs_buf_literal(&args, "{\"data\":");
+		hfs_buf_hex(&args, bytes, len);
+		hfs_buf_literal(&args, ",\"description\":");
+	} else {
+		hfs_buf_printf(&args, "{\"count\":%u,\"description\":", len);
+	}
+	hfs_cap_write(&args, description->cap);
+	if (write)
+		hfs_buf_printf(&args, ",\"max_end\":%llu", max_end);
+	hfs_buf_printf(&args, ",\"offset\":%lld}", iocb->ki_pos);
+	err = hfs_call(HFS_S(inode), write ? "WRITE" : "READ", &args,
+		       cred, false, &result);
+	if (!err && (hfs_json_u64(result, hfs_json_field(result, 0, "count"), &count) ||
+		     count > len))
+		err = -EPROTO;
+	if (!err && !write) {
+		u32 actual = len;
+
+		err = hfs_json_hex(result, hfs_json_field(result, 0, "data"), bytes, &actual);
+		if (!err && actual != count)
+			err = -EPROTO;
+		if (!err) {
+			count = copy_to_iter(bytes, actual, iter);
+			if (!count && actual)
+				err = -EFAULT;
+		}
+	}
+	if (!err && write) {
+		attributes = hfs_json_field(result, 0, "attributes");
+		err = hfs_attr_decode(result, attributes, &description->cap->home,
+				      &description->cap->allocation, S_IFREG, &selected);
+		if (!err && append && (selected.size < count || selected.size > max_end))
+			err = -EPROTO;
+		if (!err)
+			err = hfs_attr_install(inode, result, attributes);
+	}
+	if (!err) {
+		if (write && append)
+			iocb->ki_pos = selected.size;
+		else
+			iocb->ki_pos += count;
+		err = count;
+	}
+	hfs_json_free(result);
+	hfs_buf_free(&args);
+end:
+	if (copied)
+		iov_iter_revert(iter, len - (err > 0 ? err : 0));
+	hfs_end(inode, cred, cookie);
+free:
+	kfree(bytes);
+	return err;
+}
+
+static ssize_t hfs_read_iter(struct kiocb *iocb, struct iov_iter *iter)
+{
+	return hfs_io(iocb, iter, false, S64_MAX);
+}
+
+static ssize_t hfs_write_iter(struct kiocb *iocb, struct iov_iter *iter)
+{
+	struct file *file = iocb->ki_filp;
+	u64 limit = rlimit(RLIMIT_FSIZE);
+	u64 max_end = hfs_write_max_end(limit,
+				       file->f_flags & O_LARGEFILE,
+				       file_inode(file)->i_sb->s_maxbytes);
+	ssize_t ret = generic_write_checks(iocb, iter);
+
+	if (ret <= 0)
+		return ret;
+	ret = hfs_io(iocb, iter, true, max_end);
+	if (ret == -EFBIG && limit != RLIM_INFINITY && max_end == limit)
+		send_sig(SIGXFSZ, current, 0);
+	return ret > 0 ? generic_write_sync(iocb, ret) : ret;
+}
+
+static int hfs_fsync(struct file *file, loff_t start, loff_t end, int datasync)
+{
+	struct inode *inode = file_inode(file);
+	struct hfs_description *description = file->private_data;
+	struct hfs_cred *cred;
+	struct hfs_buf args;
+	struct hfs_json *result = NULL;
+	void *cookie;
+	const char *scope = S_ISDIR(inode->i_mode) ? "DIRECTORY" :
+		datasync ? "DATA" : "FILE";
+	int err;
+
+	if (HFS_S(inode)->bridge_minor) {
+		err = hfs_mmap_sync(file);
+		if (err)
+			return err;
+	}
+	err = hfs_begin_cap(inode, description ? description->cap : HFS_I(inode)->object,
+			    false, &cred, &cookie);
+	if (err)
+		return err;
+	err = hfs_args_init(&args);
+	if (!err) {
+		hfs_buf_literal(&args, "{\"description\":");
+		if (description)
+			hfs_cap_write(&args, description->cap);
+		else
+			hfs_buf_literal(&args, "null");
+		hfs_buf_literal(&args, ",\"object\":");
+		hfs_cap_write(&args, HFS_I(inode)->object);
+		hfs_buf_printf(&args, ",\"scope\":\"%s\"}", scope);
+		err = hfs_call(HFS_S(inode), "SYNC", &args, cred, false, &result);
+	}
+	hfs_json_free(result);
+	hfs_buf_free(&args);
+	hfs_end(inode, cred, cookie);
+	return err;
+}
+
+static int hfs_flush(struct file *file, fl_owner_t owner)
+{
+	struct inode *inode = file_inode(file);
+	struct hfs_session *session = HFS_S(inode);
+	struct hfs_description *description = file->private_data;
+	struct hfs_cred *cred;
+	struct hfs_buf args;
+	struct hfs_json *result = NULL;
+	u64 sequence;
+	int err;
+
+	if (!description)
+		return -ESTALE;
+	/* Last-thread exit is the independently sequenced process event. Its
+	 * PROCESS_EXIT already released the process's locks, and the host
+	 * refuses DESCRIPTION_CLOSE from an exited process (task 194). Once
+	 * hfs_process_exit has marked the process exited, hfs_capture refuses
+	 * it (-ESTALE) and nothing is sent. Residual: a non-last thread with
+	 * its own file table that captured before that mark can still send
+	 * its close after PROCESS_EXIT; the host refuses its ALLOCATE.
+	 */
+	if ((current->flags & PF_EXITING) && !atomic_read(&current->signal->live))
+		return 0;
+	err = hfs_capture(session, &init_user_ns, &cred);
+	if (err)
+		return err;
+	mutex_lock(&session->lock);
+	sequence = session->next_close++;
+	if (!sequence || !session->next_close)
+		hfs_session_mark_blocked(session);
+	mutex_unlock(&session->lock);
+	err = hfs_args_init(&args);
+	if (!err) {
+		hfs_buf_printf(&args, "{\"close_sequence\":%llu,\"description\":", sequence);
+		hfs_cap_write(&args, description->cap);
+		hfs_buf_printf(&args, ",\"process\":\"%pUb\"}", &cred->process);
+		err = hfs_call(session, "DESCRIPTION_CLOSE", &args, cred, true, &result);
+	}
+	hfs_json_free(result);
+	hfs_buf_free(&args);
+	hfs_cred_free(cred);
+	return err;
+}
+
+static int hfs_release(struct inode *inode, struct file *file)
+{
+	struct hfs_session *session = HFS_S(inode);
+	struct hfs_description *description = file->private_data;
+	struct hfs_buf args;
+	struct hfs_json *result = NULL;
+	u64 sequence;
+	int err;
+
+	if (!description)
+		return 0;
+	mutex_lock(&session->lock);
+	sequence = session->next_release++;
+	if (!sequence || !session->next_release)
+		hfs_session_mark_blocked(session);
+	mutex_unlock(&session->lock);
+	err = hfs_args_init(&args);
+	if (!err) {
+		hfs_buf_literal(&args, "{\"description\":");
+		hfs_cap_write(&args, description->cap);
+		hfs_buf_printf(&args, ",\"release_sequence\":%llu}", sequence);
+		/* Final fput may run on a worker. Only its issued snapshot is valid. */
+		err = hfs_call(session, "DESCRIPTION_RELEASE", &args,
+			       description->issuer, true, &result);
+	}
+	hfs_json_free(result);
+	hfs_buf_free(&args);
+	if (err) {
+		/* Retain the exact description/grant after uncertain release. */
+		hfs_session_block(session, "DESCRIPTION_RELEASE failure",
+				  "DESCRIPTION_RELEASE", err);
+		return err;
+	}
+	hfs_description_discard(session, description);
+	file->private_data = NULL;
+	return 0;
+}
+
+static int hfs_mmap(struct file *file, struct vm_area_struct *vma)
+{
+	struct hfs_session *session = HFS_S(file_inode(file));
+
+	if (READ_ONCE(session->blocked) || !file->private_data)
+		return -EHOSTDOWN;
+	/* No generic_file_mmap/writeback-fid fallback. The mandatory provider
+	 * owns PTE/TLB, page provenance, token reservations and recall proof.
+	 */
+	return session->bridge_minor ? hfs_mmap_file(file, vma) :
+		session->provider->mmap(file, vma);
+}
+
+struct hfs_page_entry {
+	u8 name[255];
+	u32 len;
+	unsigned int type;
+	unsigned long ino;
+	u64 cookie;
+};
+
+static loff_t hfs_dir_llseek(struct file *file, loff_t offset, int whence)
+{
+	struct hfs_description *description = file->private_data;
+	u8 after[255];
+	u32 len = sizeof(after);
+	u64 revision;
+	loff_t result;
+	int err;
+
+	if (!description || !description->cursor)
+		return -ESTALE;
+	mutex_lock(&description->lock);
+	if (whence == SEEK_CUR && !offset) {
+		result = file->f_pos;
+		goto out;
+	}
+	if (whence != SEEK_SET || offset < 0) {
+		result = -EINVAL;
+		goto out;
+	}
+	err = hfs_cursor_seek(description->cursor, offset, after, &len, &revision);
+	if (err) {
+		result = err;
+		goto out;
+	}
+	result = vfs_setpos(file, offset, MAX_LFS_FILESIZE);
+	if (result >= 0) {
+		memcpy(description->after, after, len);
+		description->after_len = len;
+		description->revision = revision;
+	}
+out:
+	mutex_unlock(&description->lock);
+	return result;
+}
+
+static int hfs_iterate(struct file *file, struct dir_context *context)
+{
+	struct inode *inode = file_inode(file);
+	struct hfs_description *description = file->private_data;
+	struct hfs_page_entry *page;
+	struct hfs_cred *cred;
+	struct hfs_buf args;
+	struct hfs_json *result = NULL;
+	struct hfs_attr directory_attr;
+	void *cookie;
+	int err, entries, attributes;
+	u32 i, count = 0;
+
+	if (!description || !description->cursor)
+		return -ESTALE;
+	page = kvmalloc_array(256, sizeof(*page), GFP_KERNEL);
+	if (!page)
+		return -ENOMEM;
+	mutex_lock(&description->lock);
+	if (!context->pos) {
+		description->after_len = 0;
+		description->revision = 0;
+	}
+	err = hfs_begin(inode, false, &cred, &cookie);
+	if (err)
+		goto unlock;
+	err = hfs_args_init(&args);
+	if (err)
+		goto end;
+	hfs_buf_literal(&args, "{\"after\":");
+	hfs_buf_hex(&args, description->after, description->after_len);
+	hfs_buf_literal(&args, ",\"limit\":256,\"object\":");
+	hfs_cap_write(&args, HFS_I(inode)->object);
+	hfs_buf_printf(&args, ",\"revision\":%llu}", description->revision);
+	err = hfs_call(HFS_S(inode), "READDIR", &args, cred, false, &result);
+	if (err)
+		goto free_args;
+	attributes = hfs_json_field(result, 0, "attributes");
+	err = hfs_attr_decode(result, attributes, &HFS_I(inode)->object->home,
+			      &HFS_I(inode)->object->allocation, S_IFDIR,
+			      &directory_attr);
+	if (err)
+		goto malformed;
+	if (description->revision &&
+	    description->revision != directory_attr.revision) {
+		err = -ESTALE;
+		goto free_args;
+	}
+	entries = hfs_json_field(result, 0, "entries");
+	if (entries < 0 || result->tokens[entries].kind != HFS_ARRAY) {
+		err = -EPROTO;
+		goto malformed;
+	}
+	/* Validate the entire page before publishing even its first entry. */
+	for (i = entries + 1; i < result->count; i++) {
+		struct hfs_cap *cap = NULL;
+		struct hfs_attr attr;
+		struct hfs_page_entry *entry;
+		const u8 *previous;
+		u32 previous_len;
+
+		if (result->tokens[i].parent != entries)
+			continue;
+		if (count == 256 ||
+		    hfs_json_exact(result, i, "attributes,capability,name")) {
+			err = -EPROTO;
+			goto malformed;
+		}
+		entry = &page[count];
+		entry->len = sizeof(entry->name);
+		err = hfs_json_hex(result, hfs_json_field(result, i, "name"),
+				   entry->name, &entry->len);
+		if (err || !entry->len || memchr(entry->name, 0, entry->len) ||
+		    memchr(entry->name, '/', entry->len) ||
+		    (entry->len == 1 && entry->name[0] == '.') ||
+		    (entry->len == 2 && !memcmp(entry->name, "..", 2))) {
+			err = -EPROTO;
+			goto malformed;
+		}
+		previous = count ? page[count - 1].name : description->after;
+		previous_len =
+		    count ? page[count - 1].len : description->after_len;
+		if (previous_len &&
+		    (memcmp(entry->name, previous,
+			    min(entry->len, previous_len)) < 0 ||
+		     (!memcmp(entry->name, previous,
+			      min(entry->len, previous_len)) &&
+		      entry->len <= previous_len))) {
+			err = -EPROTO;
+			goto malformed;
+		}
+		err = hfs_cap_parse(HFS_S(inode), result,
+				    hfs_json_field(result, i, "capability"),
+				    "PATH", &cap);
+		if (!err)
+			err = hfs_attr_decode(
+			    result, hfs_json_field(result, i, "attributes"),
+			    &cap->home, &cap->allocation, 0, &attr);
+		if (!err)
+			err = hfs_object_ino(HFS_S(inode), cap, &entry->ino);
+		hfs_cap_free(cap);
+		if (err)
+			goto malformed;
+		entry->type = attr.type >> 12;
+		count++;
+	}
+	/* Cookie storage was preallocated/charged before OPEN; never evict old
+	 * positions or replace them with a later page's cursor/revision.
+	 */
+	for (i = 0; i < count; i++) {
+		err = hfs_cursor_record(description->cursor, page[i].name,
+					page[i].len, directory_attr.revision,
+					&page[i].cookie);
+		if (err)
+			goto free_args;
+	}
+	err = hfs_attr_install(inode, result, attributes);
+	/* ie4: READDIR's cursor positions are already recorded; it is not
+	 * re-issued (only GETATTR and LOOKUP are, hfs_reissue).
+	 */
+	if (err == -HFS_ETARGET_MOVED)
+		err = -ESTALE;
+	if (err)
+		goto malformed;
+	description->revision = directory_attr.revision;
+	if (!dir_emit_dots(file, context))
+		goto free_args;
+	for (i = 0; i < count; i++) {
+		if (!dir_emit(context, page[i].name, page[i].len, page[i].ino,
+			      page[i].type))
+			break;
+		memcpy(description->after, page[i].name, page[i].len);
+		description->after_len = page[i].len;
+		context->pos = page[i].cookie;
+	}
+	goto free_args;
+malformed:
+	if (err == -EPROTO || err == -EINVAL)
+		hfs_session_block(HFS_S(inode), "malformed READDIR page", "READDIR", err);
+free_args:
+	hfs_buf_free(&args);
+	/* Forget is a protected lifetime command and may need recall progress.
+	 * Drop physical observation before making it, retaining the original
+	 * result and its exact issuing credentials until all entry tokens are
+	 * closed.
+	 */
+	hfs_leave(inode, cookie);
+	if (result && !READ_ONCE(HFS_S(inode)->blocked) &&
+	    !hfs_result_code(result)) {
+		int forgotten = hfs_readdir_forget(HFS_S(inode), result, cred);
+
+		if (forgotten) {
+			hfs_session_block(HFS_S(inode), "READDIR forget failure",
+					  "FORGET", forgotten);
+			err = forgotten;
+		}
+	}
+	hfs_json_free(result);
+	hfs_cred_free(cred);
+	goto unlock;
+end:
+	hfs_end(inode, cred, cookie);
+unlock:
+	mutex_unlock(&description->lock);
+	kvfree(page);
+	return err;
+}
+
+static loff_t hfs_file_llseek(struct file *file, loff_t offset, int whence)
+{
+	int err;
+
+	if (whence == SEEK_END || whence == SEEK_DATA || whence == SEEK_HOLE) {
+		err = hfs_refresh(file_inode(file));
+		if (err)
+			return err;
+	}
+	return generic_file_llseek(file, offset, whence);
+}
+
+const struct file_operations hfs_file_fops = {
+	.owner = THIS_MODULE,
+	.open = hfs_open,
+	.read_iter = hfs_read_iter,
+	.write_iter = hfs_write_iter,
+	.llseek = hfs_file_llseek,
+	.fsync = hfs_fsync,
+	.flush = hfs_flush,
+	.release = hfs_release,
+	.mmap = hfs_mmap,
+	/* No .lock/.flock RPC: the VFS supplies same-mount advisory locking. */
+};
+
+const struct file_operations hfs_dir_fops = {
+	.owner = THIS_MODULE,
+	.open = hfs_open,
+	.read = generic_read_dir,
+	.iterate_shared = hfs_iterate,
+	.llseek = hfs_dir_llseek,
+	.fsync = hfs_fsync,
+	.flush = hfs_flush,
+	.release = hfs_release,
+};
