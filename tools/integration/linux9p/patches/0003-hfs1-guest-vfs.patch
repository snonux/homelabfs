+#define HFS_IDENTITIES_MAX 4096U
+#define HFS_CONTEXT_MAX 4096U
+#define HFS_CAP_MAX 8192U
+
+struct hfs_session;
+struct hfs_cap;
+struct hfs_request;
+
+/* Installed by a separately reviewed enrollment/view-token integration. */
+enum hfs_view_scope {
+	HFS_SCOPE_NORMAL_PUBLIC = 1,
+	HFS_SCOPE_CONTROLLED_LOCAL = 2,
+};
+
+struct hfs_enrollment {
+	enum hfs_view_scope view_scope;
+	char context[HFS_CONTEXT_MAX];
+	u32 context_len;
+	uuid_t session;
+	uuid_t realm;
+	uuid_t anchor;
+	uuid_t nonce;
+	uuid_t view_control_nonce;
+	u8 subject[1024];
+	u32 subject_len;
+};
+
+struct hfs_provider {
+	struct module *owner;
+	u32 features;
+	int (*enroll)(const char *device, struct hfs_enrollment *enrollment);
+	int (*map)(struct hfs_session *session, const struct cred *cred,
+		   struct user_namespace *mnt_userns, uuid_t *user_namespace,
+		   u8 idmap_hash[32]);
+	/* Native context/domain admissibility facts. The cap identifies the exact
+	 * PATH/ROOT or retained DESCRIPTION supplied by the operation; descriptor
+	 * I/O must not be converted to current-path permission. Bridge1.1 owns
+	 * its lease/MM gates; this verifier holds no physical token/lock over RPC.
+	 * Bridge1.0 retains the original separately supplied gate contract.
+	 */
+	int (*enter)(struct hfs_session *session, const struct hfs_cap *cap,
+		     bool mutation, void **cookie);
+	void (*leave)(struct hfs_session *session, void *cookie);
+	int (*publication)(struct hfs_session *session,
+			   const struct hfs_json *json, int token);
+	/* Verify the full actual tagged local/normal source, not caller hashes. */
+	int (*target)(struct hfs_session *session,
+		      const struct hfs_json *json, int token);
+	/* Exact enrolled authority/closure/inventory/session/event provenance.
+	 * The complete canonical response (including channel/session) is retained
+	 * in json; token selects its event. No phase/hash-only success default.
+	 */
+	int (*view_event)(struct hfs_session *session,
+			  const struct hfs_json *json, int token);
+	int (*mmap)(struct file *file, struct vm_area_struct *vma);
+	int (*stop)(struct hfs_session *session);
+	/* Aggregate admission spans all mounts and includes retained claims. */
+	int (*reserve)(struct hfs_session *session, u64 bytes, bool control,
+		       void **reservation);
+	void (*unreserve)(struct hfs_session *session, void *reservation);
+	/* Verify protected normal claim/floor evidence, never a local assertion. */
+	int (*retirement)(struct hfs_session *session, u64 through,
+			  const u8 proof_hash[32]);
+	int (*view_retirement)(struct hfs_session *session,
+			       const struct hfs_buf *credentials, u64 through,
+			       const u8 proof_hash[32]);
+	int (*resolve_gap)(struct hfs_session *session, struct hfs_request *request);
+	int (*retire_session)(struct hfs_session *session);
+	/* Receives ownership on uncertain shutdown; must never discard evidence. */
+	void (*retain)(struct hfs_session *session);
+};
+
+struct hfs_cap {
+	struct hfs_json *json;
+	uuid_t home;
+	uuid_t allocation;
+	uuid_t description;
+	u32 rights;
+	u64 revision;
+	u8 token[32];
+	u8 credential_hash[32];
+	u8 ancestors_hash[32];
+};
+
+struct hfs_cred {
+	const struct cred *native;
+	uuid_t process;
+	u64 revision;
+	uuid_t user_namespace;
+	u8 idmap_hash[32];
+	u32 uid;
+	u32 gid;
+	u32 ngroups;
+	u32 groups[HFS_GROUPS_MAX];
+};
+
+struct hfs_process {
+	struct list_head list;
+	struct pid *pid;
+	uuid_t id;
+	u64 revision;
+	atomic_t exited;
+	struct work_struct exit_work;
+	struct hfs_session *session;
+	struct hfs_cred *last;
+	void *reservation;
+};
+
+struct hfs_cell {
+	u64 number;
+	u8 hash[32];
+	bool active;
+	bool ack_ready;
+	bool reserved;
+};
+
+struct hfs_candidate {
+	struct list_head list;
+	struct hfs_buf command;
+	u64 cell;
+	u64 donor;
+};
+
+struct hfs_request {
+	struct hfs_session *session;
+	u32 users;
+	struct list_head list;
+	struct hfs_buf claim;
+	struct hfs_buf intent;
+	struct hfs_buf credentials;
+	struct hfs_buf original_context;
+	uuid_t operation;
+	struct hfs_json *result;
+	struct hfs_json *refusal;
+	bool gap;
+	bool earmarked;
+	bool view_stamped;
+	bool cache_observation;
+	struct hfs_view_stamp view_stamp;
+	struct hfs_view_ticket *earmark_ticket;
+	struct hfs_buf earmark_number;
+	struct hfs_buf drain_payload;
+	bool bound;
+	bool held;
+	u64 number;
+	bool terminal;
+	bool adopted;
+	bool control;
+	bool retired;
+	void *reservation;
+};
+
+struct hfs_session {
+	struct hfs_view *view;
+	u16 bridge_minor;
+	struct hfs_cap *domain;
+	struct p9_client *client;
+	const struct hfs_provider *provider;
+	struct hfs_enrollment enrollment;
+	struct mutex lock;
+	struct mutex writer;
+	struct mutex retirement;
+	spinlock_t processes_lock;
+	struct list_head processes;
+	struct list_head requests;
+	struct list_head uncertain;
+	struct list_head descriptions;
+	struct list_head forgets;
+	struct list_head object_numbers;
+	struct list_head view_tickets;
+	struct list_head view_families;
+	u32 nr_view_tickets;
+	u32 nr_view_control_tickets;
+	u32 nr_view_families;
+	struct list_head global;
+	struct workqueue_struct *control;
+	u64 next_claim;
+	u64 next_cell;
+	u64 next_inode;
+	u64 next_close;
+	u64 next_release;
+	u32 nr_processes;
+	u32 nr_requests;
+	u32 nr_control_requests;
+	u32 nr_descriptions;
+	u32 nr_objects;
+	struct hfs_cell cells[80];
+	bool blocked;
+	bool closing;
+	bool retained;
+	bool retired; /* actual protected whole-session provider proof */
+};
+
+struct hfs_forget {
+	struct hfs_forget *next;
+	struct list_head list;
+	struct work_struct work;
+	struct hfs_session *session;
+	struct hfs_cap *cap;
+	struct hfs_cred *issuer;
+	u64 count;
+};
+
+struct hfs_object_number {
+	struct list_head list;
+	uuid_t home;
+	uuid_t allocation;
+	unsigned long number;
+};
+
+struct hfs_inode {
+	struct list_head view_list;
+	struct inode inode;
+	struct hfs_cap *object;
+	struct hfs_forget *forget;
+};
+
+struct hfs_description {
+	struct list_head list;
+	struct hfs_cap *cap;
+	struct hfs_cred *issuer;
+	struct mutex lock;
+	struct hfs_dir_cursor *cursor;
+	void *reservation;
+	u64 revision;
+	u8 after[255];
+	u32 after_len;
+};
+
+static inline struct hfs_session *HFS_S(const struct inode *inode)
+{
+	return inode->i_sb->s_fs_info;
+}
+
+static inline struct hfs_inode *HFS_I(const struct inode *inode)
+{
+	return container_of(inode, struct hfs_inode, inode);
+}
+
+#ifdef CONFIG_9P_FS_HOMELABFS
+int v9fs_hfs_register_provider(const struct hfs_provider *provider);
+int v9fs_hfs_unregister_provider(const struct hfs_provider *provider);
+bool v9fs_hfs_selected(const char *options);
+struct dentry *v9fs_hfs_mount(struct file_system_type *type, int flags,
+			    const char *device, void *options);
+bool v9fs_hfs_super(const struct super_block *sb);
+void v9fs_hfs_kill_super(struct super_block *sb);
+#else
+static inline bool v9fs_hfs_selected(const char *options) { return false; }
+static inline struct dentry *v9fs_hfs_mount(struct file_system_type *type,
+		int flags, const char *device, void *options)
+{
+	return ERR_PTR(-EOPNOTSUPP);
+}
+static inline bool v9fs_hfs_super(const struct super_block *sb) { return false; }
+static inline void v9fs_hfs_kill_super(struct super_block *sb) {}
+#endif
+void hfs_cred_write(struct hfs_buf *buf, const struct hfs_cred *cred);
+int hfs_capture(struct hfs_session *session, struct user_namespace *mnt_userns,
+		struct hfs_cred **out);
+void hfs_cred_free(struct hfs_cred *cred);
+int hfs_call(struct hfs_session *session, const char *opcode,
+	     const struct hfs_buf *args, const struct hfs_cred *cred,
+	     bool control, struct hfs_json **out);
