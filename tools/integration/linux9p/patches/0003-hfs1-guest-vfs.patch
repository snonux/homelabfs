+int hfs_request_earmark(struct hfs_session *session, const struct hfs_cred *cred,
+			struct hfs_view_ticket *ticket, struct hfs_request **out);
+int hfs_request_cancel_earmark(struct hfs_session *session, struct hfs_request *request);
+void hfs_request_unhold(struct hfs_session *session, struct hfs_request *request);
