+CFLAGS_hfs_crypto_core.o += -fwhole-program \
+	-I$(srctree)/fs/9p/hfs_crypto/kernel_include \
+	-I$(srctree)/fs/9p/hfs_crypto/vendor/src
+CFLAGS_hfs_crypto_ed25519.o += -fwhole-program \
+	-I$(srctree)/fs/9p/hfs_crypto/kernel_include \
+	-I$(srctree)/fs/9p/hfs_crypto/vendor/src
