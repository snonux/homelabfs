diff --git a/fs/9p/hfs.h b/fs/9p/hfs.h
new file mode 100644
--- /dev/null
+++ b/fs/9p/hfs.h
@@ -0,0 +1,563 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef FS_9P_HFS_H
+#define FS_9P_HFS_H
+
+#include <linux/cred.h>
+#include <linux/fs.h>
+#include <linux/list.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/pid.h>
+#include <linux/workqueue.h>
+#include <net/9p/9p.h>
+#include <net/9p/client.h>
+#include "hfs_protocol.h"
+#include "hfs_policy.h"
+#include "hfs_cursor.h"
+#include "hfs_view.h"
+#include "hfs_lease.h"
+
+#define HFS_IDENTITIES_MAX 4096U
+#define HFS_CONTEXT_MAX 4096U
+#define HFS_CAP_MAX 8192U
+/* hfs_call's bounded wait for another request's pending ALLOCATE (x84):
+ * at most the guest's 30 s request window.
+ */
+#define HFS_ALLOCATION_WAIT_MS 30000U
+
+/* ie4: hfs_attr_install's answer for a cache observation whose view moved to
+ * another target during its request. Kernel-internal and never returned to
+ * userspace: GETATTR and LOOKUP re-issue the request (hfs_reissue), every
+ * other caller turns it into -ESTALE. Above the kernel's internal 512-530.
+ */
+#define HFS_ETARGET_MOVED 600
+/* s64: kernel-internal "no open description of this object is left to try"
+ * for a described GETATTR/SETATTR (hfs_inode.c). Never returned to
+ * userspace; distinct from a host NotFound (-ENOENT).
+ */
+#define HFS_ENODESC 601
+/* kill_sb's bounded wait for a view to settle before the stop (z84). */
+#define HFS_UNMOUNT_SETTLE_MS 2000U
+/* session->block_reported bit of hfs_mmap_fail's once-per-session line (1a4). */
+#define HFS_REPORTED_VIEW_STOP 1
+/* session->block_reported bit: hfs_session_block already queued the
+ * session's abandon_work (hh4). Set once; never cleared within a session.
+ */
+#define HFS_ABANDON_QUEUED 2
+/* At most this many claims per ABANDON command (guestbridge
+ * MaxAbandonClaims); hfs_session_abandon sends longer lists in batches.
+ */
+#define HFS_ABANDON_MAX 64U
+/* The ABANDON payload buffer: three UUID fields, 64 claims of at most 115
+ * bytes ({"number":<20 digits>,"original_hash":"<64 hex>"} and a comma) and
+ * a subject of at most 1024 bytes (2048 hex digits) stay under 10 KiB.
+ */
+#define HFS_ABANDON_PAYLOAD 16384U
+
+struct hfs_controlled_mount;
+struct hfs_session;
+struct hfs_cap;
+struct hfs_request;
+struct hfs_completion;
+
+/* Installed by a separately reviewed enrollment/view-token integration. */
+enum hfs_view_scope {
+	HFS_SCOPE_NORMAL_PUBLIC = 1,
+	HFS_SCOPE_CONTROLLED_LOCAL = 2,
+};
+
+struct hfs_enrollment {
+	enum hfs_view_scope view_scope;
+	u32 protocol_features;
+	char context[HFS_CONTEXT_MAX];
+	u32 context_len;
+	uuid_t session;
+	uuid_t realm;
+	uuid_t anchor;
+	uuid_t nonce;
+	uuid_t view_control_nonce;
+	/* Exact signed1.4 lanes, separate from the ordinary principal family. */
+	uuid_t acquisition_anchor;
+	uuid_t acquisition_nonce;
+	uuid_t control_anchor;
+	u8 subject[1024];
+	u32 subject_len;
+};
+
+struct hfs_provider {
+	struct module *owner;
+	u32 features;
+	int (*enroll)(const char *device, struct hfs_enrollment *enrollment);
+	int (*map)(struct hfs_session *session, const struct cred *cred,
+		   struct user_namespace *mnt_userns, uuid_t *user_namespace,
+		   u8 idmap_hash[32]);
+	/* Native context/domain admissibility facts. The cap identifies the exact
+	 * PATH/ROOT or retained DESCRIPTION supplied by the operation; descriptor
+	 * I/O must not be converted to current-path permission. Bridge1.1 owns
+	 * its lease/MM gates; this verifier holds no physical token/lock over RPC.
+	 * Bridge1.0 retains the original separately supplied gate contract.
+	 */
+	int (*enter)(struct hfs_session *session, const struct hfs_cap *cap,
+		     bool mutation, void **cookie);
+	void (*leave)(struct hfs_session *session, void *cookie);
+	int (*publication)(struct hfs_session *session,
+			   const struct hfs_json *json, int token);
+	/* Verify the full actual tagged local/normal source, not caller hashes. */
+	int (*target)(struct hfs_session *session,
+		      const struct hfs_json *json, int token);
+	/* xf4: verify the actual source of a GRANTED lease target that differs
+	 * from the request's expected target (a guest-requested view advance):
+	 * the receipt binding of target, except that it is not current yet; it
+	 * must be at the mount's fence and captured at the view's revision,
+	 * with the LIVE view installed at exactly expected. NULL: the provider
+	 * cannot verify an advance, so the guest never requests one.
+	 */
+	int (*advance_target)(struct hfs_session *session, const struct hfs_json *json,
+			      int token, const struct hfs_buf *expected);
+	/* Exact enrolled authority/closure/inventory/session/event provenance.
+	 * The complete canonical response (including channel/session) is retained
+	 * in json; token selects its event. No phase/hash-only success default.
+	 */
+	int (*view_event)(struct hfs_session *session,
+			  const struct hfs_json *json, int token);
+	int (*mmap)(struct file *file, struct vm_area_struct *vma);
+	int (*stop)(struct hfs_session *session);
+	/* Aggregate admission spans all mounts and includes retained claims. */
+	int (*reserve)(struct hfs_session *session, u64 bytes, bool control,
+		       void **reservation);
+	void (*unreserve)(struct hfs_session *session, void *reservation);
+	/* Verify protected normal claim/floor evidence, never a local assertion.
+	 * response is the borrowed complete transported union, including receipt.
+	 */
+	int (*retirement)(struct hfs_session *session, u64 through,
+			  const u8 proof_hash[32],
+			  const struct hfs_json *response);
+	int (*view_retirement)(struct hfs_session *session,
+			       const struct hfs_buf *credentials, u64 through,
+			       const u8 proof_hash[32],
+			       const struct hfs_json *response);
+	int (*resolve_gap)(struct hfs_session *session, struct hfs_request *request);
+	int (*retire_session)(struct hfs_session *session);
+	/* Receives ownership on uncertain shutdown; must never discard evidence. */
+	void (*retain)(struct hfs_session *session);
+};
+
+struct hfs_cap {
+	struct hfs_json *json;
+	uuid_t home;
+	uuid_t allocation;
+	uuid_t description;
+	u32 rights;
+	u64 revision;
+	u8 token[32];
+	u8 credential_hash[32];
+	u8 ancestors_hash[32];
+};
+
+struct hfs_cred {
+	const struct cred *native;
+	uuid_t process;
+	u64 revision;
+	uuid_t user_namespace;
+	u8 idmap_hash[32];
+	u32 uid;
+	u32 gid;
+	u32 ngroups;
+	u32 groups[HFS_GROUPS_MAX];
+};
+
+struct hfs_process {
+	struct list_head list;
+	struct pid *pid;
+	uuid_t id;
+	u64 revision;
+	atomic_t exited;
+	struct work_struct exit_work;
+	struct hfs_session *session;
+	struct hfs_cred *last;
+	void *reservation;
+};
+
+struct hfs_cell {
+	u64 number;
+	u8 hash[32];
+	bool active;
+	bool ack_ready;
+	bool reserved;
+};
+
+struct hfs_candidate {
+	struct hfs_response_profile response;
+	struct hfs_completion *completion;
+	struct hfs_session *session;
+	struct list_head list;
+	struct hfs_buf command;
+	struct hfs_cell *slot;
+	u64 cell;
+	u64 donor;
+	void *reservation; /* actual transient/uncertain carrier ownership */
+};
+
+struct hfs_request {
+	struct hfs_completion *completion;
+	struct hfs_session *session;
+	u32 users;
+	struct list_head list;
+	struct hfs_buf claim;
+	struct hfs_buf intent;
+	struct hfs_buf credentials;
+	struct hfs_buf original_context;
+	uuid_t operation;
+	struct hfs_json *result;
+	struct hfs_json *refusal;
+	struct hfs_json *allocation_receipt;
+	/* Complete received terminal envelope; receipt bytes are not authority. */
+	struct hfs_json *response;
+	struct hfs_json *gap_response;
+	bool allocated;
+	bool allocating;
+	/* The last ALLOCATE attempt returned without the exact acknowledgement
+	 * (set under session->lock when it returns). Nothing in the guest
+	 * retries it, so its allocation_pending fence stays, and hfs_call stops
+	 * waiting for it (x84). An exact retry that succeeds clears the fence,
+	 * which makes this flag irrelevant; a retry still in progress leaves it
+	 * set until that attempt returns.
+	 */
+	bool allocation_failed;
+	bool gap;
+	/* hh4: listed in an ABANDON (set under session->lock by
+	 * hfs_session_abandon, never cleared). The guest promised the host
+	 * never to send another CALL or QUERY for it, nor a GAP_RESOLVE unless
+	 * the host answered ABANDONED (then gap is set too). A reply already in
+	 * flight is still accepted.
+	 */
+	bool abandoning;
+	bool earmarked;
+	bool view_stamped;
+	bool cache_observation;
+	struct hfs_view_stamp view_stamp;
+	/* The view's target hash taken with view_stamp (ie4, hfs_attr_restamp). */
+	u8 view_target[32];
+	struct hfs_view_ticket *earmark_ticket;
+	struct hfs_buf earmark_number;
+	struct hfs_buf drain_payload;
+	/* Parent-funded exact successor cleanup, allocated before CALL. */
+	struct hfs_buf readdir_cleanup;
+	bool bound;
+	bool held;
+	u64 number;
+	bool terminal;
+	bool adopted;
+	bool control;
+	bool retired;
+	void *reservation;
+};
+
+/* Exact in-memory attempt, retained across uncertain transport/callbacks.
+ * No new cut may replace it until consumed or definitively BLOCKED.
+ */
+struct hfs_retirement_cut {
+	struct hfs_buf payload;
+	struct hfs_json *response;
+	u64 first;
+	u64 through;
+	char operation[16];
+	void *reservation;
+};
+
+struct hfs_terminal_ack {
+ u64 cell;
+ u8 hash[32];
+ u32 slot;
+ bool control;
+};
+
+struct hfs_session {
+	struct hfs_controlled_mount *terminal_mount;
+	struct hfs_completion *terminal_completion;
+	struct hfs_buf terminal_credentials;
+	struct hfs_buf terminal_payload;
+	struct hfs_buf terminal_settled;
+	struct hfs_terminal_ack terminal_cells[80];
+	u32 nr_terminal_cells;
+	u32 terminal_slot;
+	u64 terminal_cell;
+	void *terminal_storage;
+	struct hfs_json *terminal_response;
+	u64 terminal_donor;
+	u8 terminal_donor_hash[32];
+	bool terminal_pending;
+	bool terminal_verified;
+	struct hfs_completion *control_completion;
+	struct hfs_completion *retirement_completion;
+	struct hfs_view *view;
+	struct hfs_retirement_cut *retirement_cut;
+	u16 bridge_minor;
+	struct hfs_cap *domain;
+	struct p9_client *client;
+	const struct hfs_provider *provider;
+	struct hfs_enrollment enrollment;
+	struct mutex lock;
+	struct mutex writer;
+	struct mutex retirement;
+	spinlock_t processes_lock;
+	struct list_head processes;
+	struct list_head requests;
+	struct list_head uncertain;
+	struct list_head descriptions;
+	struct list_head forgets;
+	struct list_head object_numbers;
+	struct list_head view_tickets;
+	struct list_head view_families;
+	u32 nr_view_tickets;
+	u32 nr_view_control_tickets;
+	u32 nr_view_families;
+	struct list_head global;
+	struct workqueue_struct *control;
+	/* hh4: hfs_session_abandon_work, queued on control at most once per
+	 * session by hfs_session_block (HFS_ABANDON_QUEUED). kill_sb flushes
+	 * control and then runs one final hfs_session_abandon pass itself.
+	 */
+	struct work_struct abandon_work;
+	/* Non-NULL until the exact protected ALLOCATE acknowledgement. */
+	struct hfs_request *allocation_pending;
+	/* x84: hfs_call callers waiting for the fence, FIFO (struct
+	 * hfs_allocation_waiter, under lock). allocation_epoch changes under
+	 * lock whenever an ALLOCATE attempt ends (acknowledged, failed or
+	 * uncertain), an earmark is admitted or cancelled, a retired owner is
+	 * cleared, any queued waiter leaves, or kill_sb closes the session;
+	 * allocation_wait is woken after each change.
+	 */
+	struct list_head allocation_waiters;
+	unsigned long allocation_epoch;
+	wait_queue_head_t allocation_wait;
+	u64 next_claim;
+	u64 next_cell;
+	u64 next_inode;
+	u64 next_close;
+	u64 next_release;
+	u32 nr_processes;
+	u32 nr_requests;
+	u32 nr_control_requests;
+	u32 nr_descriptions;
+	u32 nr_objects;
+	struct hfs_cell cells[80];
+	bool blocked;
+	bool allocation_uncertain;
+	bool closing;
+	/* Set by kill_sb before stop/retain: their fence is then the expected
+	 * clean-unmount close, not a fault, and hfs_session_fence stays silent.
+	 */
+	bool unmounting;
+	bool retained;
+	bool retired; /* actual protected whole-session provider proof */
+	/* Bit 0: hfs_session_block already logged why this session blocked.
+	 * Bit HFS_REPORTED_VIEW_STOP: hfs_mmap_fail logged the view control
+	 * worker stop (1a4). The bits are independent: a later block still
+	 * logs its own line. Bit HFS_ABANDON_QUEUED: hfs_session_block queued
+	 * abandon_work (hh4).
+	 */
+	unsigned long block_reported;
+	/* The raw reason of the last ERROR reply an exchange of this session
+	 * failed on (hfs_transport_note; 0 none, else HFS_ERROR_*). The
+	 * hfs_session_block and hfs_mmap_fail lines print it (oc4).
+	 */
+	u16 exporter_error;
+	/* An exchange of this session hit its 30 s deadline, got no reply
+	 * within the bounded 9p wait, or got ERROR UNAVAILABLE: the host is not
+	 * answering. From then on every retry or
+	 * poll loop stops at its first retry, exempt and teardown traffic too
+	 * (hfs_session_poll_halt), so an unmount after the host is gone takes
+	 * at most one more deadline, not one per FORGET (oc4, zq3-r13: m0's
+	 * umount hung > 270 s in hfs_control). ALLOCATE's deadline does not
+	 * set it (only allocation_uncertain). Never cleared within a session,
+	 * by design: a session that lost its host is blocked and retained, not
+	 * resumed; a new mount gets a new session.
+	 */
+	bool transport_failed;
+	/* s64: the hfs_fdattr mount option. When set, GETATTR and SETATTR
+	 * that the path form cannot serve (an unlinked inode, or a host Stale
+	 * after rename or unlink) are sent with an open DESCRIPTION of the same
+	 * object (hfs_inode.c). Off (the default) sends only the original path
+	 * shapes, exactly the pre-s64 bytes. Read with READ_ONCE; cleared once
+	 * on a minor-0/1 session whose forwarder or host refuses the shape.
+	 */
+	bool fd_attr;
+	/* 5f4: woken (hfs_session_stop_wake) whenever a stop that
+	 * hfs_view_refused or hfs_session_poll_halt sees is set: blocked
+	 * (hfs_session_mark_blocked), closing or transport_failed. The paths
+	 * that set them have no view (hfs_session_block may even run under
+	 * session->lock, where hfs_view_get would deadlock), so the view waits
+	 * whose condition includes those stops (hfs_view_reopen_wait,
+	 * hfs_view_retire_wait, hfs_view_enter_until) also wait here
+	 * (hfs_view_watch_stops) instead of sleeping to their deadline.
+	 */
+	wait_queue_head_t stop_wait;
+};
+
+/* An hfs_call caller queued for the allocation fence (x84), on its stack. */
+struct hfs_allocation_waiter {
+	struct list_head list;
+};
+
+struct hfs_forget {
+	struct hfs_forget *next;
+	struct list_head list;
+	struct work_struct work;
+	struct hfs_session *session;
+	struct hfs_cap *cap;
+	struct hfs_cred *issuer;
+	u64 count;
+};
+
+struct hfs_object_number {
+	struct list_head list;
+	uuid_t home;
+	uuid_t allocation;
+	unsigned long number;
+};
+
+struct hfs_inode {
+	/* On view->mappings while registered (every hfs_inode_get inode; the
+	 * STOP/recall inventory). tj4: view_mmapped, under view->lock, once
+	 * hfs_mmap_file accepted a mapping of this inode, until it leaves the
+	 * view (eviction): only such an inode can hold target-bound state, so
+	 * only it counts in view->nr_mmapped and keeps the view non-cacheless.
+	 */
+	struct list_head view_list;
+	bool view_mmapped;
+	struct inode inode;
+	struct hfs_cap *object;
+	struct hfs_forget *forget;
+};
+
+struct hfs_description {
+	struct list_head list;
+	struct hfs_cap *cap;
+	struct hfs_cred *issuer;
+	struct mutex lock;
+	struct hfs_dir_cursor *cursor;
+	void *reservation;
+	u64 revision;
+	u8 after[255];
+	u32 after_len;
+};
+
+static inline struct hfs_session *HFS_S(const struct inode *inode)
+{
+	return inode->i_sb->s_fs_info;
+}
+
+static inline struct hfs_inode *HFS_I(const struct inode *inode)
+{
+	return container_of(inode, struct hfs_inode, inode);
+}
+
+#ifdef CONFIG_9P_FS_HOMELABFS
+int v9fs_hfs_register_provider(const struct hfs_provider *provider);
+int v9fs_hfs_unregister_provider(const struct hfs_provider *provider);
+bool v9fs_hfs_selected(const char *options);
+bool v9fs_hfs_only_option(const char *options);
+struct dentry *v9fs_hfs_mount(struct file_system_type *type, int flags,
+			    const char *device, void *options);
+bool v9fs_hfs_super(const struct super_block *sb);
+void v9fs_hfs_kill_super(struct super_block *sb);
+#else
+static inline bool v9fs_hfs_selected(const char *options) { return false; }
+static inline bool v9fs_hfs_only_option(const char *options) { return false; }
+static inline struct dentry *v9fs_hfs_mount(struct file_system_type *type,
+		int flags, const char *device, void *options)
+{
+	return ERR_PTR(-EOPNOTSUPP);
+}
+static inline bool v9fs_hfs_super(const struct super_block *sb) { return false; }
+static inline void v9fs_hfs_kill_super(struct super_block *sb) {}
+#endif
+void hfs_cred_write(struct hfs_buf *buf, const struct hfs_cred *cred);
+int hfs_capture_terminal(struct hfs_session *session, struct hfs_cred **out);
+int hfs_capture(struct hfs_session *session, struct user_namespace *mnt_userns,
+		struct hfs_cred **out);
+void hfs_cred_free(struct hfs_cred *cred);
