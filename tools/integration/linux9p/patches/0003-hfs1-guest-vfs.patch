+		const struct hfs_buf *payload, bool reserved,
+		struct hfs_json **out);
+int hfs_result_code(const struct hfs_json *json);
+int hfs_readdir_forget(struct hfs_session *, const struct hfs_json *,
+			const struct hfs_cred *);
