+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef FS_9P_HFS_PROTOCOL_H
+#define FS_9P_HFS_PROTOCOL_H
+
+#ifndef HFS_CODEC_USERSPACE
+#include <linux/types.h>
+#include <linux/uuid.h>
+#endif
+
+#define HFS_RECEIPT_UNSIGNED_MAX 16384U
+#define HFS_BODY_MAX 1048576U
+#define HFS_VIEW_BODY_MAX 131072U
+#define HFS_CHUNK_MAX 32768U
+#define HFS_HEADER_SIZE 88U
+#define HFS_GROUPS_MAX 1024U
+#define HFS_CAPS_MAX 256U
+#define HFS_IO_MAX 65536U
+#define HFS_CELL_MAX 2147483647U
+#define HFS_FEATURES 255U
+#define HFS_VIEW_FEATURES 2047U
+#define HFS_CONTROLLED_FEATURES 4095U
+#define HFS_CLEANUP_FEATURES 8191U
+#define HFS_MAPPED_FEATURES 16383U
+#define HFS_TERMINAL_FEATURES 32767U
+#define HFS_TERMINAL_OBJECT_MAX 32768U
+
+enum hfs_response_channel {
+	HFS_CHANNEL_RESULT = 2,
+	HFS_CHANNEL_RECALL = 3,
+};
+
+enum hfs_response_kind {
+	HFS_FRAME_RESULT = 2,
+	HFS_FRAME_RECALL = 3,
+};
+
+struct hfs_response_profile {
+	enum hfs_response_channel channel;
+	enum hfs_response_kind kind;
+	u32 max_body;
+};
+
+/* Select from the immutable command operation, never the returned frame. */
+bool hfs_view_command(const char *operation);
+bool hfs_view_command_control(const char *operation);
+bool hfs_view_command_control_family(const char *operation);
+struct hfs_response_profile hfs_response_profile(const char *operation);
+
+/*
+ * Tokens are preorder spans [start,end), including JSON delimiters. Object key
+ * and value tokens have the same object parent; container descendants follow
+ * their container. Tokens refer to owned immutable bytes, never RPC memory.
+ * Parsing bounds nesting to 64 and tokens to 131072, in addition to body size.
+ * Successful parses retain only count tokens; temporary arenas are released.
+ */
+enum hfs_json_kind {
+	HFS_OBJECT, HFS_ARRAY, HFS_STRING, HFS_NUMBER, HFS_BOOL, HFS_NULL,
+};
+
+struct hfs_token {
+	u32 start;
+	u32 end;
+	u32 parent;
+	enum hfs_json_kind kind;
+};
+
+struct hfs_json {
+	/* Optional caller association; parser initializes both NULL. */
+	void *owner;
+	void (*owner_put)(void *owner);
+	/* Set only after transport frame + canonical envelope scope validation. */
+	bool transported;
+	u16 channel;
+	u16 frame_kind;
+	u16 frame_minor;
+	uuid_t native_session;
+	/* Guest translated cell today; NOT the endpoint-global native cell. */
+	u64 native_cell;
+	char *data;
+	u32 len;
+	struct hfs_token *tokens;
+	u32 count;
+};
+
+struct hfs_buf {
+	char *data;
+	u32 len;
+	u32 cap;
+	int error;
+};
+
+int hfs_json_parse(const void *data, u32 len, struct hfs_json **out);
+/* Private local signed-enrollment decoding; never use for network bodies. */
+int hfs_json_parse_go_enrollment(const void *data, u32 len,
+				struct hfs_json **out);
+/* Borrowed immutable body + caller-owned token arena; never hfs_json_free(). */
+int hfs_json_parse_into(const void *data, u32 len, struct hfs_json *json,
+			struct hfs_token *tokens, u32 capacity);
+void hfs_json_free(struct hfs_json *json);
+int hfs_json_field(const struct hfs_json *json, int object, const char *name);
+/* Comma-separated sorted exact key list; no optional/missing fields. */
+int hfs_json_exact(const struct hfs_json *json, int object, const char *keys);
+int hfs_json_u64(const struct hfs_json *json, int token, u64 *value);
+int hfs_json_i64(const struct hfs_json *json, int token, s64 *value);
+int hfs_json_bool(const struct hfs_json *json, int token, bool *value);
+int hfs_json_string(const struct hfs_json *json, int token, char *out, u32 cap);
+int hfs_json_hex(const struct hfs_json *json, int token, void *out, u32 *len);
+bool hfs_json_is(const struct hfs_json *json, int token, const char *literal);
+int hfs_buf_init(struct hfs_buf *buf, u32 cap);
+void hfs_buf_free(struct hfs_buf *buf);
+void hfs_buf_add(struct hfs_buf *buf, const void *bytes, u32 len);
+void hfs_buf_literal(struct hfs_buf *buf, const char *literal);
+__printf(2, 3) void hfs_buf_printf(struct hfs_buf *buf, const char *fmt, ...);
+void hfs_buf_hex(struct hfs_buf *buf, const void *bytes, u32 len);
+void hfs_buf_token(struct hfs_buf *buf, const struct hfs_json *json, int token);
+void hfs_hash(const void *bytes, u32 len, u8 digest[32]);
+const char *hfs_protocol_text(u16 minor);
+const char *hfs_protocol_selected_text(u16 minor, u32 features);
+int hfs_protocol_selected_match(const struct hfs_json *json, int token, u16 minor, u32 features);
+int hfs_protocol_match(const struct hfs_json *json, int token, u16 minor);
+int hfs_frame_encode_version(u16 minor, u16 kind, const uuid_t *session,
+			     u64 cell, const void *body, u32 len, u32 chunk,
+			     void *out, u32 *out_len);
+int hfs_frame_decode_version(u16 minor, const void *frame, u32 len, u16 kind,
+			     const uuid_t *session, u64 cell, u32 chunk,
+			     u32 *total, u8 hash[32], const void **body,
+			     u32 *body_len);
+int hfs_frame_encode(u16 kind, const uuid_t *session, u64 cell,
+		     const void *body, u32 len, u32 chunk, void *out,
+		     u32 *out_len);
+int hfs_frame_decode(const void *frame, u32 len, u16 kind,
+		     const uuid_t *session, u64 cell, u32 chunk, u32 *total,
+		     u8 hash[32], const void **body, u32 *body_len);
+/* Inert host attestation: this API cannot create kernel/source authority.
+ * C6 must obtain context/key/receipt provenance from private admitted state.
+ * No kernel Ed25519 adapter is installed here; missing crypto refuses. */
+struct hfs_mapped_binding {
+	/* Zero preserves the original16383 pure primitive. Enrolled consumers pin it. */
+	u32 features;
+	const struct hfs_json *context;
+	u8 public_key[32];
+	int (*verify_ed25519)(const u8 key[32], const void *message, u32 len,
+			      const u8 signature[64]);
+};
+enum hfs_attestation_kind {
+	HFS_ATTESTATION_SOURCE = 1,
+	HFS_ATTESTATION_EVENT,
+	HFS_ATTESTATION_FLOOR,
+	HFS_ATTESTATION_VIEW_FLOOR,
+	HFS_ATTESTATION_SESSION_RETIRED,
+};
+struct hfs_mapped_attestation {
+	enum hfs_attestation_kind kind;
+	u64 guest_cell;
+	u64 poll_count;
+};
+int hfs_mapped_receipt_verify(const struct hfs_mapped_binding *binding,
+			      const struct hfs_json *original,
+			      const struct hfs_json *response,
+			      struct hfs_mapped_attestation *result);
+/* Inert original response policy; original may be retained {op,payload}. */
+int hfs_mapped_source_policy(const struct hfs_json *scope_json, int scope,
+		const struct hfs_json *original, const struct hfs_json *response,
+		int payload);
+
+#endif
diff --git a/fs/9p/hfs_protocol.c b/fs/9p/hfs_protocol.c
new file mode 100644
--- /dev/null
+++ b/fs/9p/hfs_protocol.c
@@ -0,0 +1,1772 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Bounded canonical retained-9p wire codec. Schema validation is the caller's.
+ */
+#include "hfs_protocol.h"
+#include "hfs_received.h"
+
+#ifndef HFS_CODEC_USERSPACE
+#include <asm/unaligned.h>
+#include <crypto/sha2.h>
+#include <linux/errno.h>
+#include <linux/kernel.h>
+#include <linux/slab.h>
+#include <linux/string.h>
+#include <linux/vmalloc.h>
+#endif
+
+#define HFS_JSON_DEPTH 64U
+#define HFS_JSON_TOKENS 131072U
+#define HFS_NO_PARENT U32_MAX
+
+struct hfs_parser {
+	struct hfs_json *json;
+	u32 pos;
+	u32 capacity;
+	bool go_enrollment;
+};
+
+static int hfs_token_new(struct hfs_parser *p, u32 parent,
+			 enum hfs_json_kind kind)
+{
+	struct hfs_token *t;
+	int index;
+
+	if (p->json->count == p->capacity)
+		return -E2BIG;
+	index = p->json->count++;
+	t = &p->json->tokens[index];
+	t->start = p->pos;
+	t->parent = parent;
+	t->kind = kind;
+	return index;
+}
+
+static int hfs_parse_string(struct hfs_parser *p, u32 parent)
+{
+	int index = hfs_token_new(p, parent, HFS_STRING);
+	char c;
+
+	if (index < 0)
+		return index;
+	p->pos++;
+	while (p->pos < p->json->len) {
+		c = p->json->data[p->pos++];
+		if (c == '"') {
+			p->json->tokens[index].end = p->pos;
+			return index;
+		}
+		if (c < 0x20 || c > 0x7e)
+			return -EINVAL;
+		if (c == '\\') {
+			if (p->pos == p->json->len)
+				return -EINVAL;
+			c = p->json->data[p->pos++];
+			if (c != '\\' && c != '"')
+				return -EINVAL;
+		}
+	}
+	return -EINVAL;
+}
+
+/* Canonical strings have one spelling; compare their decoded ASCII keys. */
+static int hfs_key_compare(const struct hfs_json *j, int a, int b)
+{
+	u32 x = j->tokens[a].start + 1;
+	u32 y = j->tokens[b].start + 1;
+	u32 xe = j->tokens[a].end - 1;
+	u32 ye = j->tokens[b].end - 1;
+	unsigned char xc, yc;
+
+	while (x < xe && y < ye) {
+		xc = j->data[x++];
+		yc = j->data[y++];
+		if (xc == '\\')
+			xc = j->data[x++];
+		if (yc == '\\')
+			yc = j->data[y++];
+		if (xc != yc)
+			return xc < yc ? -1 : 1;
+	}
+	return x == xe ? (y == ye ? 0 : -1) : 1;
+}
+
+static int hfs_parse_value(struct hfs_parser *p, u32 parent, u32 depth)
+{
+	struct hfs_json *j = p->json;
+	u64 value = 0, limit;
+	bool negative;
+	const char *literal;
+	int index, key, previous = -1, child;
+	char c, close;
+	u32 start, length;
+
+	if (depth > HFS_JSON_DEPTH || p->pos == j->len)
+		return -EINVAL;
+	c = j->data[p->pos];
+	if (c == '"')
+		return hfs_parse_string(p, parent);
+	if (c == '{' || c == '[') {
+		if (depth == HFS_JSON_DEPTH)
+			return -E2BIG;
+		index = hfs_token_new(p, parent,
+				      c == '{' ? HFS_OBJECT : HFS_ARRAY);
+		if (index < 0)
+			return index;
+		close = c == '{' ? '}' : ']';
+		p->pos++;
+		if (p->pos < j->len && j->data[p->pos] == close)
+			goto container_end;
+		for (;;) {
+			if (c == '{') {
+				if (p->pos == j->len || j->data[p->pos] != '"')
+					return -EINVAL;
+				key = hfs_parse_string(p, index);
+				if (key < 0)
+					return key;
+				if (!p->go_enrollment && previous >= 0 &&
+				    hfs_key_compare(j, previous, key) >= 0)
+					return -EINVAL;
+				previous = key;
+				if (p->pos == j->len || j->data[p->pos++] != ':')
+					return -EINVAL;
+			}
+			child = hfs_parse_value(p, index, depth + 1);
+			if (child < 0)
+				return child;
+			if (p->pos == j->len)
+				return -EINVAL;
+			if (j->data[p->pos] == close)
+				break;
+			if (j->data[p->pos++] != ',')
+				return -EINVAL;
+		}
+container_end:
+		p->pos++;
+		j->tokens[index].end = p->pos;
+		return index;
+	}
+	if (c == 't' || c == 'f' || c == 'n') {
+		literal = c == 't' ? "true" : c == 'f' ? "false" : "null";
+		length = strlen(literal);
+		if (length > j->len - p->pos ||
+		    memcmp(j->data + p->pos, literal, length))
+			return -EINVAL;
+		index = hfs_token_new(p, parent,
+				      c == 'n' ? HFS_NULL : HFS_BOOL);
+		if (index < 0)
+			return index;
+		p->pos += length;
+		j->tokens[index].end = p->pos;
+		return index;
+	}
+	index = hfs_token_new(p, parent, HFS_NUMBER);
+	if (index < 0)
+		return index;
+	negative = c == '-';
+	if (negative)
+		p->pos++;
+	start = p->pos;
+	limit = negative ? (1ULL << 63) : U64_MAX;
+	while (p->pos < j->len) {
+		c = j->data[p->pos];
+		if (c < '0' || c > '9')
+			break;
+		if (value > (limit - (c - '0')) / 10)
+			return -ERANGE;
+		value = value * 10 + c - '0';
+		p->pos++;
+	}
+	if (p->pos == start || (negative && !value) ||
+	    (p->pos > start + 1 && j->data[start] == '0'))
+		return -EINVAL;
+	j->tokens[index].end = p->pos;
+	return index;
+}
+
+int hfs_json_parse_into(const void *data, u32 len, struct hfs_json *json,
+			struct hfs_token *tokens, u32 capacity)
+{
+	struct hfs_parser parser;
+	int err;
+
+	if (!data || !len || len > HFS_BODY_MAX || !json || !tokens ||
+	    !capacity || capacity > HFS_JSON_TOKENS)
+		return -EINVAL;
+	memset(json, 0, sizeof(*json));
+	json->data = (char *)data;
+	json->len = len;
+	json->tokens = tokens;
+	parser.json = json;
+	parser.capacity = capacity;
+	parser.pos = 0;
+	parser.go_enrollment = false;
+	err = hfs_parse_value(&parser, HFS_NO_PARENT, 0);
+	if (err < 0)
+		return err;
+	return parser.pos == len ? 0 : -EINVAL;
+}
+
+static int hfs_json_parse_owned(const void *data, u32 len,
+			       struct hfs_json **out, bool go_enrollment)
+{
+	struct hfs_json *j;
+	struct hfs_token *tokens;
+	struct hfs_parser p;
+	int err;
+
+	if (!out)
+		return -EINVAL;
+	*out = NULL;
+	if (!data || !len || len > HFS_BODY_MAX)
+		return -EINVAL;
+	j = kzalloc(sizeof(*j), GFP_KERNEL);
+	if (!j)
+		return -ENOMEM;
+	p.capacity = min_t(u32, len / 2 + 1, HFS_JSON_TOKENS);
+	j->tokens = kvcalloc(p.capacity, sizeof(*j->tokens), GFP_KERNEL);
+	j->data = kvmalloc(len + 1, GFP_KERNEL);
+	if (!j->tokens || !j->data) {
+		err = -ENOMEM;
+		goto fail;
+	}
+	memcpy(j->data, data, len);
+	j->data[len] = 0;
+	j->len = len;
+	p.json = j;
+	p.pos = 0;
+	p.go_enrollment = go_enrollment;
+	err = hfs_parse_value(&p, HFS_NO_PARENT, 0);
+	if (err < 0 || p.pos != len) {
+		if (err >= 0)
+			err = -EINVAL;
+		goto fail;
+	}
+	/* Retained large hex payloads must not retain a body-sized token arena. */
+	if (j->count != p.capacity) {
+		tokens = kvcalloc(j->count, sizeof(*tokens), GFP_KERNEL);
+		if (!tokens) {
+			err = -ENOMEM;
+			goto fail;
+		}
+		memcpy(tokens, j->tokens, j->count * sizeof(*tokens));
+		kvfree(j->tokens);
+		j->tokens = tokens;
+	}
+	*out = j;
+	return 0;
+fail:
+	hfs_json_free(j);
+	return err;
+}
+
+int hfs_json_parse(const void *data, u32 len, struct hfs_json **out)
+{
+	return hfs_json_parse_owned(data, len, out, false);
+}
+
+/* Local signed Enrollment only. The private schema validator must check exact
+ * original Go key order/shape at EVERY object before consuming any value.
+ * This parser cannot create admission and is never selected for network JSON.
+ */
+int hfs_json_parse_go_enrollment(const void *data, u32 len,
+				struct hfs_json **out)
+{
+	return hfs_json_parse_owned(data, len, out, true);
+}
+
+void hfs_json_free(struct hfs_json *json)
+{
+	void *owner;
+	void (*owner_put)(void *owner);
+
+	if (!json)
+		return;
+	owner = json->owner;
+	owner_put = json->owner_put;
+	kvfree(json->tokens);
+	kvfree(json->data);
+	/* Remove identity associations before reusing the json address. The
+   * caller owner remains held until the entire allocated parse is gone.
+   */
+	hfs_received_forget(json);
+	kfree(json);
+	if (owner_put)
+		owner_put(owner);
+}
+
+static bool hfs_token_valid(const struct hfs_json *j, int token)
+{
+	return j && token >= 0 && token < j->count;
+}
+
+static u32 hfs_token_next(const struct hfs_json *j, u32 token)
+{
+	u32 end = j->tokens[token++].end;
+
+	while (token < j->count && j->tokens[token].start < end)
+		token++;
+	return token;
+}
+
+static bool hfs_key_equal(const struct hfs_json *j, int token,
+			  const char *key, u32 len)
+{
+	u32 pos = j->tokens[token].start + 1;
+	u32 end = j->tokens[token].end - 1;
+	u32 i = 0;
+	char c;
+
+	while (pos < end && i < len) {
+		c = j->data[pos++];
+		if (c == '\\')
+			c = j->data[pos++];
+		if (c != key[i++])
+			return false;
+	}
+	return pos == end && i == len;
+}
+
+int hfs_json_field(const struct hfs_json *j, int object, const char *name)
+{
+	u32 key;
+
+	if (!hfs_token_valid(j, object) || !name ||
+	    j->tokens[object].kind != HFS_OBJECT)
+		return -EINVAL;
+	for (key = object + 1; key < j->count &&
+	     j->tokens[key].start < j->tokens[object].end;
+	     key = hfs_token_next(j, key + 1)) {
+		if (hfs_key_equal(j, key, name, strlen(name)))
+			return key + 1;
+	}
+	return -ENOENT;
+}
+
+int hfs_json_exact(const struct hfs_json *j, int object, const char *keys)
+{
+	const char *end;
+	u32 key, length;
+
+	if (!hfs_token_valid(j, object) || !keys ||
+	    j->tokens[object].kind != HFS_OBJECT)
+		return -EINVAL;
+	key = object + 1;
+	while (*keys) {
+		end = strchr(keys, ',');
+		length = end ? end - keys : strlen(keys);
+		if (!length || key >= j->count ||
+		    j->tokens[key].start >= j->tokens[object].end ||
+		    !hfs_key_equal(j, key, keys, length))
+			return -EINVAL;
+		key = hfs_token_next(j, key + 1);
+		keys += length;
+		if (*keys && !*++keys)
+			return -EINVAL;
+	}
+	return key == j->count ||
+	       j->tokens[key].start >= j->tokens[object].end ? 0 : -EINVAL;
+}
+
+int hfs_json_u64(const struct hfs_json *j, int token, u64 *value)
+{
+	u64 number = 0;
+	u32 p;
+
+	if (!value || !hfs_token_valid(j, token) ||
+	    j->tokens[token].kind != HFS_NUMBER ||
+	    j->data[j->tokens[token].start] == '-')
+		return -EINVAL;
+	for (p = j->tokens[token].start; p < j->tokens[token].end; p++)
+		number = number * 10 + j->data[p] - '0';
+	*value = number;
+	return 0;
+}
+
+int hfs_json_i64(const struct hfs_json *j, int token, s64 *value)
+{
+	u64 number = 0;
+	u32 p;
+	bool negative;
+
+	if (!value || !hfs_token_valid(j, token) ||
+	    j->tokens[token].kind != HFS_NUMBER)
+		return -EINVAL;
+	p = j->tokens[token].start;
+	negative = j->data[p] == '-';
+	if (negative)
+		p++;
+	for (; p < j->tokens[token].end; p++)
+		number = number * 10 + j->data[p] - '0';
+	if (!negative && number > S64_MAX)
+		return -ERANGE;
+	*value = negative ? -(s64)(number - 1) - 1 : (s64)number;
+	return 0;
+}
+
+bool hfs_json_is(const struct hfs_json *j, int token, const char *literal)
+{
+	return literal && hfs_token_valid(j, token) &&
+	       strlen(literal) == j->tokens[token].end - j->tokens[token].start &&
+	       !memcmp(j->data + j->tokens[token].start, literal, strlen(literal));
+}
+
+int hfs_json_bool(const struct hfs_json *j, int token, bool *value)
+{
+	if (!value || !hfs_token_valid(j, token) ||
+	    j->tokens[token].kind != HFS_BOOL)
+		return -EINVAL;
+	*value = j->data[j->tokens[token].start] == 't';
+	return 0;
+}
+
+int hfs_json_string(const struct hfs_json *j, int token, char *out, u32 cap)
+{
+	u32 p, end, size = 0;
+	char c;
+
+	if (!out || !cap || !hfs_token_valid(j, token) ||
+	    j->tokens[token].kind != HFS_STRING)
+		return -EINVAL;
+	p = j->tokens[token].start + 1;
+	end = j->tokens[token].end - 1;
+	while (p < end) {
+		c = j->data[p++];
+		if (c == '\\')
+			c = j->data[p++];
+		if (size == cap - 1)
+			return -ENOSPC;
+		out[size++] = c;
+	}
+	out[size] = 0;
+	return size;
+}
+
+static int hfs_hex_digit(char c)
+{
+	if (c >= '0' && c <= '9')
+		return c - '0';
+	if (c >= 'a' && c <= 'f')
+		return c - 'a' + 10;
+	return -EINVAL;
+}
+
+int hfs_json_hex(const struct hfs_json *j, int token, void *out, u32 *len)
+{
+	u32 p, size, i;
+	int a, b;
+	u8 *bytes = out;
+
+	if (!len || !hfs_token_valid(j, token) ||
+	    j->tokens[token].kind != HFS_STRING)
+		return -EINVAL;
+	p = j->tokens[token].start + 1;
+	size = j->tokens[token].end - p - 1;
+	if (size % 2)
+		return -EINVAL;
+	size /= 2;
+	if (size > *len || (size && !out))
+		return -ENOSPC;
+	for (i = 0; i < size; i++) {
+		a = hfs_hex_digit(j->data[p++]);
+		b = hfs_hex_digit(j->data[p++]);
+		if (a < 0 || b < 0)
+			return -EINVAL;
+		bytes[i] = a * 16 + b;
+	}
+	*len = size;
+	return 0;
+}
+
+int hfs_buf_init(struct hfs_buf *buf, u32 cap)
+{
+	if (!buf)
+		return -EINVAL;
+	memset(buf, 0, sizeof(*buf));
+	if (!cap || cap > HFS_BODY_MAX)
+		return buf->error = -EINVAL;
+	buf->data = kvmalloc(cap, GFP_KERNEL);
+	if (!buf->data)
+		return buf->error = -ENOMEM;
+	buf->cap = cap;
+	return 0;
+}
+
+void hfs_buf_free(struct hfs_buf *buf)
+{
+	if (!buf)
+		return;
+	kvfree(buf->data);
+	memset(buf, 0, sizeof(*buf));
+}
+
+void hfs_buf_add(struct hfs_buf *buf, const void *bytes, u32 len)
+{
+	if (buf->error)
+		return;
+	if ((len && !bytes) || len > buf->cap - buf->len) {
+		buf->error = -ENOSPC;
+		return;
+	}
+	if (len)
+		memcpy(buf->data + buf->len, bytes, len);
+	buf->len += len;
+}
+
+void hfs_buf_literal(struct hfs_buf *buf, const char *literal)
+{
+	hfs_buf_add(buf, literal, strlen(literal));
+}
+
+void hfs_buf_printf(struct hfs_buf *buf, const char *fmt, ...)
+{
+	va_list args;
+	int size;
+
+	if (buf->error)
+		return;
+	va_start(args, fmt);
+	size = vsnprintf(buf->data + buf->len, buf->cap - buf->len, fmt, args);
+	va_end(args);
+	if (size < 0 || size >= buf->cap - buf->len) {
+		buf->error = -ENOSPC;
+		return;
+	}
+	buf->len += size;
+}
+
+void hfs_buf_hex(struct hfs_buf *buf, const void *bytes, u32 len)
+{
+	static const char digits[] = "0123456789abcdef";
+	const u8 *input = bytes;
+	u32 i;
+	char pair[2];
+
+	if ((len && !bytes) || len > (HFS_BODY_MAX - 2) / 2) {
+		buf->error = -EINVAL;
+		return;
+	}
+	hfs_buf_literal(buf, "\"");
+	for (i = 0; i < len && !buf->error; i++) {
+		pair[0] = digits[input[i] >> 4];
+		pair[1] = digits[input[i] & 15];
+		hfs_buf_add(buf, pair, sizeof(pair));
+	}
+	hfs_buf_literal(buf, "\"");
+}
+
+void hfs_buf_token(struct hfs_buf *buf, const struct hfs_json *j, int token)
+{
+	if (!hfs_token_valid(j, token)) {
+		buf->error = -EINVAL;
+		return;
+	}
+	hfs_buf_add(buf, j->data + j->tokens[token].start,
+		    j->tokens[token].end - j->tokens[token].start);
+}
+
+void hfs_hash(const void *bytes, u32 len, u8 digest[32])
+{
+	sha256(bytes, len, digest);
+}
+
+struct hfs_response_profile hfs_response_profile(const char *operation)
+{
+	if (!strcmp(operation, "VIEW_WAIT"))
+		return (struct hfs_response_profile) {
+			.channel = HFS_CHANNEL_RECALL,
+			.kind = HFS_FRAME_RECALL,
+			.max_body = HFS_BODY_MAX,
+		};
+	return (struct hfs_response_profile) {
+		.channel = HFS_CHANNEL_RESULT,
+		.kind = HFS_FRAME_RESULT,
+		.max_body = hfs_view_command(operation) ? HFS_VIEW_BODY_MAX : HFS_BODY_MAX,
+	};
+}
+
+static bool hfs_session_nonzero(const uuid_t *session)
+{
+	static const u8 zero[16];
+
+	return session && memcmp(session->b, zero, sizeof(zero));
+}
+
+int hfs_frame_encode_version(u16 minor, u16 kind, const uuid_t *session, u64 cell,
+		     const void *body, u32 len, u32 chunk, void *out,
+		     u32 *out_len)
+{
+	u8 *frame = out;
+	u32 offset, size;
+
+	if (minor > 4 || !out || !out_len || !body || !len || len > HFS_BODY_MAX ||
+	    kind < 1 || kind > 3 || !hfs_session_nonzero(session) ||
+	    !cell || cell > HFS_CELL_MAX || chunk > (len - 1) / HFS_CHUNK_MAX)
+		return -EINVAL;
+	offset = chunk * HFS_CHUNK_MAX;
+	size = min_t(u32, len - offset, HFS_CHUNK_MAX);
+	if (*out_len < HFS_HEADER_SIZE + size)
+		return -ENOSPC;
+	memset(frame, 0, HFS_HEADER_SIZE);
+	memcpy(frame, "HFS9BR1", 7);
+	put_unaligned_le16(1, frame + 8);
+	put_unaligned_le16(minor, frame + 10);
+	put_unaligned_le16(kind, frame + 12);
+	put_unaligned_le32(len, frame + 16);
+	put_unaligned_le32(offset, frame + 20);
+	put_unaligned_le32(size, frame + 24);
+	memcpy(frame + 32, session->b, 16);
+	put_unaligned_le64(cell, frame + 48);
+	hfs_hash(body, len, frame + 56);
+	memcpy(frame + HFS_HEADER_SIZE, (const u8 *)body + offset, size);
+	*out_len = HFS_HEADER_SIZE + size;
+	return 0;
+}
+
+int hfs_frame_decode_version(u16 minor, const void *input, u32 len, u16 kind,
+		     const uuid_t *session, u64 cell, u32 chunk,
+		     u32 *total, u8 hash[32], const void **body, u32 *body_len)
+{
+	const u8 *frame = input;
+	u32 size, length, offset;
+
+	if (minor > 4 || !input || !total || !hash || !body || !body_len ||
+	    len < HFS_HEADER_SIZE || kind < 1 || kind > 3 ||
+	    !hfs_session_nonzero(session) || !cell || cell > HFS_CELL_MAX ||
+	    memcmp(frame, "HFS9BR1\0", 8) ||
+	    get_unaligned_le16(frame + 8) != 1 ||
+	    get_unaligned_le16(frame + 10) != minor ||
+	    get_unaligned_le16(frame + 12) != kind ||
+	    get_unaligned_le16(frame + 14) ||
+	    get_unaligned_le32(frame + 28) ||
+	    memcmp(frame + 32, session->b, 16) ||
+	    get_unaligned_le64(frame + 48) != cell)
+		return -EINVAL;
+	length = get_unaligned_le32(frame + 16);
+	offset = get_unaligned_le32(frame + 20);
+	size = get_unaligned_le32(frame + 24);
+	if (!length || length > HFS_BODY_MAX ||
+	    chunk > (length - 1) / HFS_CHUNK_MAX ||
+	    offset != chunk * HFS_CHUNK_MAX ||
+	    size != min_t(u32, length - offset, HFS_CHUNK_MAX) ||
+	    len != HFS_HEADER_SIZE + size)
+		return -EINVAL;
+	*total = length;
+	memcpy(hash, frame + 56, 32);
+	*body = frame + HFS_HEADER_SIZE;
+	*body_len = size;
+	return 0;
+}
+
+int hfs_frame_encode(u16 kind, const uuid_t *session, u64 cell,
+		     const void *body, u32 len, u32 chunk, void *out,
+		     u32 *out_len)
+{
+	return hfs_frame_encode_version(0, kind, session, cell, body, len, chunk,
+					out, out_len);
+}
+
+int hfs_frame_decode(const void *input, u32 len, u16 kind,
+		     const uuid_t *session, u64 cell, u32 chunk,
+		     u32 *total, u8 hash[32], const void **body, u32 *body_len)
+{
+	return hfs_frame_decode_version(0, input, len, kind, session, cell, chunk,
+					total, hash, body, body_len);
+}
+
+const char *hfs_protocol_text(u16 minor)
+{
+	static const char legacy[] = "{\"body_schema\":1,\"bridge_major\":1,"
+		"\"bridge_minor\":0,\"features\":255,\"msize\":65536,"
+		"\"normal_major\":3,\"normal_minor\":0}";
+	static const char views[] = "{\"body_schema\":2,\"bridge_major\":1,"
+		"\"bridge_minor\":1,\"features\":2047,\"msize\":65536,"
+		"\"normal_major\":3,\"normal_minor\":0}";
+
+	static const char controlled[] = "{\"body_schema\":3,\"bridge_major\":1,"
+		"\"bridge_minor\":2,\"features\":4095,\"msize\":65536,"
+		"\"normal_major\":3,\"normal_minor\":0}";
+	static const char cleanup[] = "{\"body_schema\":4,\"bridge_major\":1,"
+		"\"bridge_minor\":3,\"features\":8191,\"msize\":65536,"
+		"\"normal_major\":3,\"normal_minor\":0}";
+
+	static const char mapped[] = "{\"body_schema\":5,\"bridge_major\":1,"
+		"\"bridge_minor\":4,\"features\":16383,\"msize\":65536,"
+		"\"normal_major\":3,\"normal_minor\":0}";
+
+	return minor == 0 ? legacy : minor == 1 ? views :
+		minor == 2 ? controlled : minor == 3 ? cleanup : minor == 4 ? mapped : NULL;
+}
+
+const char *hfs_protocol_selected_text(u16 minor, u32 features)
+{
+	static const char terminal[] = "{\"body_schema\":5,\"bridge_major\":1,"
+				       "\"bridge_minor\":4,\"features\":32767,\"msize\":65536,"
+				       "\"normal_major\":3,\"normal_minor\":0}";
+
+	if (minor == 4 && features == HFS_TERMINAL_FEATURES)
+		return terminal;
+	if (minor == 4 && features && features != HFS_MAPPED_FEATURES)
+		return NULL;
+	return hfs_protocol_text(minor);
+}
+
+int hfs_protocol_selected_match(const struct hfs_json *json, int token, u16 minor, u32 features)
+{
+	const char *expected = hfs_protocol_selected_text(minor, features);
+
+	if (!expected || token < 0 || token >= json->count ||
+	    json->tokens[token].end - json->tokens[token].start != strlen(expected) ||
+	    memcmp(json->data + json->tokens[token].start, expected, strlen(expected)))
+		return -EPROTO;
+	return 0;
+}
+
+int hfs_protocol_match(const struct hfs_json *json, int token, u16 minor)
+{
+	const char *expected = hfs_protocol_text(minor);
+
+	if (!expected || token < 0 || token >= json->count ||
+	    json->tokens[token].end - json->tokens[token].start != strlen(expected) ||
+	    memcmp(json->data + json->tokens[token].start, expected, strlen(expected)))
+		return -EPROTO;
+	return 0;
+}
+
+bool hfs_view_command(const char *operation)
+{
+	static const char * const names[] = {
+		"VIEW_ACQUIRE", "VIEW_RELEASE", "VIEW_RENEW", "VIEW_QUERY",
+		"VIEW_CANCEL", "VIEW_RETIRE", "DIRTY_RESERVE", "DIRTY_FREEZE",
+	};
+	u32 i;
+
+	for (i = 0; i < ARRAY_SIZE(names); i++)
+		if (!strcmp(operation, names[i]))
+			return true;
+	return false;
+}
+
+bool hfs_view_command_control(const char *operation)
+{
+	return hfs_view_command(operation) &&
+	       strcmp(operation, "VIEW_ACQUIRE") &&
+	       strcmp(operation, "DIRTY_RESERVE");
+}
+
+bool hfs_view_command_control_family(const char *operation)
+{
+	return !strcmp(operation, "DIRTY_FREEZE") ||
+	       !strcmp(operation, "VIEW_RELEASE");
+}
+
+/* Pure host attestation only. The caller must supply an already enrolled key;
+ * this primitive neither enrolls it nor creates received/source authority. */
+static bool hfs_mapped_equal(const struct hfs_json *a, int at,
+			     const struct hfs_json *b, int bt)
+{
+	return at >= 0 && bt >= 0 && (u32)at < a->count && (u32)bt < b->count &&
+	       a->tokens[at].end - a->tokens[at].start ==
+		       b->tokens[bt].end - b->tokens[bt].start &&
+	       !memcmp(a->data + a->tokens[at].start,
+		       b->data + b->tokens[bt].start,
+		       a->tokens[at].end - a->tokens[at].start);
+}
+
+static int hfs_mapped_fields(const struct hfs_json *j, int object,
+			     const char *fields, struct hfs_buf *out)
+{
+	char name[64];
+	u32 count = 0, len;
+	int token;
+
+	hfs_buf_literal(out, "{");
+	while (*fields) {
+		len = strcspn(fields, ",");
+		if (!len || len >= sizeof(name))
+			return -EINVAL;
+		memcpy(name, fields, len);
+		name[len] = 0;
+		token = hfs_json_field(j, object, name);
+		if (token < 0)
+			return -EPROTO;
+		hfs_buf_printf(out, "%s\"%s\":", count++ ? "," : "", name);
+		hfs_buf_token(out, j, token);
+		fields += len + (fields[len] == ',');
+	}
+	hfs_buf_literal(out, "}");
+	return out->error;
+}
+
+static int hfs_mapped_hash(const struct hfs_json *j, int object,
+			   const char *name, const u8 digest[32])
+{
+	u8 expected[32];
+	u32 len = sizeof(expected);
+
+	if (hfs_json_hex(j, hfs_json_field(j, object, name), expected, &len) ||
+	    len != sizeof(expected) ||
+	    memcmp(expected, digest, sizeof(expected)))
+		return -ESTALE;
+	return 0;
+}
+
+static bool hfs_mapped_uuid(const struct hfs_json *j, int token)
+{
+	char value[37];
+	u32 i;
+	bool nonzero = false;
+
+	if (hfs_json_string(j, token, value, sizeof(value)) != 36)
+		return false;
+	for (i = 0; i < 36; i++) {
+		if (i == 8 || i == 13 || i == 18 || i == 23) {
+			if (value[i] != '-')
+				return false;
+		} else {
+			if (hfs_hex_digit(value[i]) < 0)
+				return false;
+			nonzero |= value[i] != '0';
+		}
+	}
+	return nonzero;
+}
+
+static bool hfs_mapped_hex32(const struct hfs_json *j, int object,
+			     const char *field)
+{
+	u8 digest[32];
+	u32 len = sizeof(digest);
+
+	return !hfs_json_hex(j, hfs_json_field(j, object, field), digest,
+			     &len) &&
+	       len == sizeof(digest);
+}
+
+static bool hfs_mapped_number(const struct hfs_json *j, int object,
+			      const char *field, u64 minimum)
+{
+	u64 n;
+
+	return !hfs_json_u64(j, hfs_json_field(j, object, field), &n) &&
+	       n >= minimum;
+}
+
+static int hfs_mapped_target(const struct hfs_json *j, int target,
+			     const struct hfs_json *scope_json, int scope)
+{
+	static const char *const hashes[] = { "context_hash", "enrollment_hash", "journal_hash",
+					      "profile_hash", "state_hash" };
+	int cut = hfs_json_field(j, target, "cut");
+	int token = hfs_json_field(scope_json, scope, "origin_journal");
+	u8 digest[32];
+	u32 i;
+
+	if (hfs_json_exact(j, target, "cut,kind") ||
+	    !hfs_json_is(j, hfs_json_field(j, target, "kind"), "\"CONTROLLED_LOCAL\"") ||
+	    hfs_json_exact(j, cut,
+			   "context_hash,enrollment_hash,journal_epoch,journal_hash,"
+			   "journal_incarnation,journal_position,profile_hash,state_"
+			   "hash,visibility_generation") ||
+	    !hfs_mapped_uuid(j, hfs_json_field(j, cut, "journal_incarnation")) ||
+	    !hfs_mapped_uuid(j, hfs_json_field(j, cut, "visibility_generation")) ||
+	    !hfs_mapped_number(j, cut, "journal_epoch", 1) ||
+	    !hfs_mapped_number(j, cut, "journal_position", 0) ||
+	    !hfs_mapped_equal(j, hfs_json_field(j, cut, "journal_incarnation"), scope_json, token))
+		return -EPROTO;
+	for (i = 0; i < ARRAY_SIZE(hashes); i++)
+		if (!hfs_mapped_hex32(j, cut, hashes[i]))
+			return -EPROTO;
+	if (scope < 0 || (u32)scope >= scope_json->count)
+		return -EPROTO;
+	hfs_hash(scope_json->data + scope_json->tokens[scope].start,
+		 scope_json->tokens[scope].end - scope_json->tokens[scope].start, digest);
+	return hfs_mapped_hash(j, cut, "context_hash", digest);
+}
+
+static int hfs_mapped_context(const struct hfs_json *j)
+{
+	static const char *const uuids[] = { "cluster",
+					     "configuration",
+					     "export",
+					     "exporter_incarnation",
+					     "fuse_session",
+					     "generation",
+					     "guest_boot",
+					     "guest_mount",
+					     "origin_incarnation",
+					     "origin_journal",
+					     "origin_node",
+					     "session",
+					     "vm",
+					     "volume" };
+	static const char *const hashes[] = { "authority_hash", "policy_hash", "registry_hash" };
+	static const char *const nodes[] = { "command_node", "result_node", "recall_node" };
+	int scope = hfs_json_field(j, 0, "scope"), endpoint = hfs_json_field(j, 0, "endpoint");
+	u64 ids[3];
+	u32 i;
+
+	if (hfs_json_exact(j, 0, "controller,endpoint,scope,serving_generation") ||
+	    hfs_json_exact(j, scope,
+			   "authority_hash,cluster,configuration,export,exporter_incarnation,"
+			   "fuse_session,generation,guest_boot,guest_mount,origin_incarnation,"
+			   "origin_journal,"
+			   "origin_node,policy_hash,registry_hash,session,vm,volume") ||
+	    hfs_json_exact(j, endpoint, "command_node,fuse_session,recall_node,result_node") ||
+	    !hfs_mapped_uuid(j, hfs_json_field(j, 0, "controller")) ||
+	    !hfs_mapped_uuid(j, hfs_json_field(j, 0, "serving_generation")) ||
+	    !hfs_mapped_equal(j, hfs_json_field(j, scope, "fuse_session"), j,
+			      hfs_json_field(j, endpoint, "fuse_session")))
+		return -EPROTO;
+	for (i = 0; i < ARRAY_SIZE(uuids); i++)
+		if (!hfs_mapped_uuid(j, hfs_json_field(j, scope, uuids[i])))
+			return -EPROTO;
+	for (i = 0; i < ARRAY_SIZE(hashes); i++)
+		if (!hfs_mapped_hex32(j, scope, hashes[i]))
+			return -EPROTO;
+	for (i = 0; i < ARRAY_SIZE(nodes); i++)
+		if (hfs_json_u64(j, hfs_json_field(j, endpoint, nodes[i]), &ids[i]) || ids[i] < 2)
+			return -EPROTO;
+	return ids[0] != ids[1] && ids[0] != ids[2] && ids[1] != ids[2] ? 0 : -EPROTO;
+}
+
+static int hfs_mapped_event(const struct hfs_json *original,
+			    const struct hfs_json *response, int event,
+			    int evidence)
+{
+	int phase = hfs_json_field(response, event, "phase");
+	int scope = hfs_json_field(original, 0, "context");
+	int request = hfs_json_field(original, 0, "payload");
+	int target = hfs_json_field(response, event, "target");
+	bool recall = hfs_json_is(response, phase, "\"RECALL\"");
+
+	if (hfs_json_exact(
+		    response, event,
+		    "authority_hash,closure_hash,domain,inventory_hash,"
+		    "manifest_hash,old_visibility,phase,recall,sequence,target") ||
+	    !hfs_mapped_uuid(response,
+			     hfs_json_field(response, event, "recall")) ||
+	    !hfs_mapped_uuid(response, hfs_json_field(response, event,
+						      "old_visibility")) ||
+	    !hfs_mapped_uuid(response, hfs_json_field(response, evidence,
+						      "retained_owner")) ||
+	    !hfs_mapped_hex32(response, evidence, "domain_token") ||
+	    !hfs_mapped_number(response, event, "sequence", 1) ||
+	    !hfs_mapped_hex32(response, event, "authority_hash") ||
+	    !hfs_mapped_hex32(response, event, "closure_hash") ||
+	    !hfs_mapped_hex32(response, event, "inventory_hash") ||
+	    !hfs_mapped_equal(
+		    response, hfs_json_field(response, event, "authority_hash"),
+		    original,
+		    hfs_json_field(original, scope, "authority_hash")) ||
+	    !hfs_mapped_equal(
+		    response, hfs_json_field(response, event, "domain"),
+		    original, hfs_json_field(original, request, "domain")) ||
+	    (!recall && !hfs_json_is(response, phase, "\"INSTALL_DRAIN\"") &&
+	     !hfs_json_is(response, phase, "\"INSTALL_FINAL\"") &&
+	     !hfs_json_is(response, phase, "\"REOPEN\"")))
+		return -EPROTO;
+	if (recall)
+		return hfs_json_is(response, target, "null") &&
+				       hfs_json_is(
+					       response,
+					       hfs_json_field(response, event,
+							      "manifest_hash"),
+					       "null") ?
+			       0 :
+			       -EPROTO;
+	if (!hfs_mapped_hex32(response, event, "manifest_hash"))
+		return -EPROTO;
+	return hfs_mapped_target(response, target, original, scope);
+}
+
+/* Fixed SHA256 state and borrowed canonical spans. No response-body clone. */
+#ifdef HFS_CODEC_USERSPACE
+#include <openssl/evp.h>
+struct hfs_mapped_sha256 {
+	EVP_MD_CTX *context;
+};
+static int hfs_mapped_sha_begin(struct hfs_mapped_sha256 *s)
+{
+	s->context = EVP_MD_CTX_new();
+	if (!s->context)
+		return -ENOMEM;
+	if (EVP_DigestInit_ex(s->context, EVP_sha256(), NULL) != 1) {
+		EVP_MD_CTX_free(s->context);
+		return -EIO;
+	}
+	return 0;
+}
+static int hfs_mapped_sha_add(struct hfs_mapped_sha256 *s, const void *p,
+			      u32 len)
+{
+	return EVP_DigestUpdate(s->context, p, len) == 1 ? 0 : -EIO;
+}
+static int hfs_mapped_sha_end(struct hfs_mapped_sha256 *s, u8 digest[32],
+			      int err)
+{
+	unsigned int len = 32;
+	if (!err &&
+	    (EVP_DigestFinal_ex(s->context, digest, &len) != 1 || len != 32))
+		err = -EIO;
+	EVP_MD_CTX_free(s->context);
+	return err;
+}
+#else
+struct hfs_mapped_sha256 {
+	struct sha256_state state;
+};
+static int hfs_mapped_sha_begin(struct hfs_mapped_sha256 *s)
+{
+	sha256_init(&s->state);
+	return 0;
+}
+static int hfs_mapped_sha_add(struct hfs_mapped_sha256 *s, const void *p, u32 len)
+{
+	sha256_update(&s->state, p, len);
+	return 0;
+}
+static int hfs_mapped_sha_end(struct hfs_mapped_sha256 *s, u8 digest[32], int err)
+{
+	if (!err)
+		sha256_final(&s->state, digest);
+	return err;
+}
+#endif
+
+static int hfs_mapped_hash_fields(const struct hfs_json *j, int object,
+				  const char *fields, u8 digest[32])
+{
+	struct hfs_mapped_sha256 state;
+	char name[64], prefix[68];
+	u32 count = 0, len;
+	int token, err;
+
+	err = hfs_mapped_sha_begin(&state);
+	if (err)
+		return err;
+	err = hfs_mapped_sha_add(&state, "{", 1);
+	while (*fields && !err) {
+		len = strcspn(fields, ",");
+		if (!len || len >= sizeof(name)) {
+			err = -EINVAL;
+			break;
+		}
+		memcpy(name, fields, len);
+		name[len] = 0;
+		token = hfs_json_field(j, object, name);
+		if (token < 0 || (u32)token >= j->count) {
+			err = -EPROTO;
+			break;
+		}
+		/* All field names are fixed ASCII protocol keys. */
+		len = snprintf(prefix, sizeof(prefix),
+			       "%s\"%s\":", count++ ? "," : "", name);
+		err = hfs_mapped_sha_add(&state, prefix, len);
+		if (!err)
+			err = hfs_mapped_sha_add(
+				&state, j->data + j->tokens[token].start,
+				j->tokens[token].end - j->tokens[token].start);
+		fields += strlen(name) + (fields[strlen(name)] == ',');
+	}
+	if (!err)
+		err = hfs_mapped_sha_add(&state, "}", 1);
+	return hfs_mapped_sha_end(&state, digest, err);
+}
+
+static int hfs_mapped_object_hash(const struct hfs_json *j, int object,
+				  const char *fields, const char *hash_field)
+{
+	u8 digest[32];
+	int err = hfs_mapped_hash_fields(j, object, fields, digest);
+	return err ? err : hfs_mapped_hash(j, object, hash_field, digest);
+}
+
+static int hfs_mapped_bytes(const struct hfs_json *json, int token,
+			    u32 minimum, u32 maximum)
+{
+	u32 start, end, length, i;
+
+	if (!hfs_token_valid(json, token) || json->tokens[token].kind != HFS_STRING)
+		return -EPROTO;
+	start = json->tokens[token].start + 1;
+	end = json->tokens[token].end - 1;
+	length = end - start;
+	if (length % 2 || length / 2 < minimum || length / 2 > maximum)
+		return -EPROTO;
+	for (i = start; i < end; i++)
+		if (hfs_hex_digit(json->data[i]) < 0)
+			return -EPROTO;
+	return 0;
+}
+
+static int hfs_mapped_description(const struct hfs_json *json, int cap,
+				  const struct hfs_json *scope_json, int scope)
+{
+	u64 rights;
+
+	if (hfs_json_exact(json, cap,
+			   "ancestors_hash,credential_hash,description,kind,object_"
+			   "allocation,object_home,revision,rights,scope,token") ||
+	    !hfs_json_is(json, hfs_json_field(json, cap, "kind"), "\"DESCRIPTION\"") ||
+	    !hfs_mapped_uuid(json, hfs_json_field(json, cap, "description")) ||
+	    !hfs_mapped_uuid(json, hfs_json_field(json, cap, "object_home")) ||
+	    !hfs_mapped_uuid(json, hfs_json_field(json, cap, "object_allocation")) ||
+	    !hfs_mapped_number(json, cap, "revision", 1) ||
+	    hfs_json_u64(json, hfs_json_field(json, cap, "rights"), &rights) || rights > 63 ||
+	    !hfs_mapped_hex32(json, cap, "ancestors_hash") ||
+	    !hfs_mapped_hex32(json, cap, "credential_hash") ||
+	    !hfs_mapped_hex32(json, cap, "token") ||
+	    !hfs_mapped_equal(json, hfs_json_field(json, cap, "scope"), scope_json, scope))
+		return -EPROTO;
+	return 0;
+}
+
+static int hfs_mapped_claim(const struct hfs_json *json, int claim)
+{
+	if (hfs_json_exact(json, claim, "anchor,nonce,number,original_hash,realm,subject") ||
+	    !hfs_mapped_uuid(json, hfs_json_field(json, claim, "anchor")) ||
+	    !hfs_mapped_uuid(json, hfs_json_field(json, claim, "nonce")) ||
+	    !hfs_mapped_uuid(json, hfs_json_field(json, claim, "realm")) ||
+	    !hfs_mapped_number(json, claim, "number", 1) ||
+	    !hfs_mapped_hex32(json, claim, "original_hash") ||
+	    hfs_mapped_bytes(json, hfs_json_field(json, claim, "subject"), 1, 1024))
+		return -EPROTO;
+	return 0;
+}
+
+static int hfs_mapped_frozen_schema(const struct hfs_json *json, int entry,
+				   const struct hfs_json *scope_json, int scope)
+{
+	u64 offset, length;
+
+	if (hfs_json_exact(json, entry,
+			    "claim,description,id,length,offset,payload_hash,reservation") ||
+	    hfs_mapped_description(json, hfs_json_field(json, entry, "description"), scope_json, scope) ||
+	    hfs_mapped_claim(json, hfs_json_field(json, entry, "claim")) ||
+	    !hfs_mapped_hex32(json, entry, "payload_hash") ||
+	    !hfs_mapped_hex32(json, entry, "reservation") ||
+	    hfs_json_u64(json, hfs_json_field(json, entry, "offset"), &offset) || offset > S64_MAX ||
+	    hfs_json_u64(json, hfs_json_field(json, entry, "length"), &length) || !length || length > 65536)
+		return -EPROTO;
+	return hfs_mapped_object_hash(json, entry,
+		"description,length,offset,payload_hash,reservation", "id");
+}
+
+static int hfs_mapped_freeze_intent(const struct hfs_json *original, int request,
+				   const struct hfs_json *response, int entry,
+				   u8 digest[32])
+{
+	int reservation = hfs_json_field(original, request, "reservation");
+	struct hfs_mapped_sha256 state;
+	const struct {
+		const char *prefix;
+		const struct hfs_json *json;
+		int token;
+	} fields[] = {
+		{ "{\"args\":{\"data\":", original, hfs_json_field(original, request, "data") },
+		{ ",\"description\":", original, hfs_json_field(original, reservation, "description") },
+		{ ",\"dirty_entry\":", response, hfs_json_field(response, entry, "id") },
+		{ ",\"offset\":", original, hfs_json_field(original, reservation, "offset") },
+		{ ",\"recall\":", original, hfs_json_field(original, request, "recall") },
+		{ ",\"reservation\":", original, hfs_json_field(original, reservation, "id") },
+	};
+	u32 i;
+	int err = hfs_mapped_sha_begin(&state);
+
+	if (err)
+		return err;
+	for (i = 0; !err && i < ARRAY_SIZE(fields); i++) {
+		int token = fields[i].token;
+		const struct hfs_json *json = fields[i].json;
+
+		if (!hfs_token_valid(json, token)) {
+			err = -EPROTO;
+			break;
+		}
+		err = hfs_mapped_sha_add(&state, fields[i].prefix, strlen(fields[i].prefix));
+		if (!err)
+			err = hfs_mapped_sha_add(&state, json->data + json->tokens[token].start,
+				json->tokens[token].end - json->tokens[token].start);
+	}
+	if (!err)
+		err = hfs_mapped_sha_add(&state, "},\"opcode\":\"DRAIN_WRITE\"}",
+				 sizeof("},\"opcode\":\"DRAIN_WRITE\"}") - 1);
+	return hfs_mapped_sha_end(&state, digest, err);
+}
+
+static int hfs_mapped_frozen_original(const struct hfs_json *original, int request,
+				     const struct hfs_json *response, int entry)
+{
+	static const char *const fields[] = { "anchor", "nonce", "number", "realm", "subject" };
+	int reservation = hfs_json_field(original, request, "reservation");
+	int claim = hfs_json_field(response, entry, "claim");
+	int number = hfs_json_field(original, reservation, "claim_number");
+	u64 length;
+	u32 decoded = 4096, i;
+	u8 digest[32], *data;
+	int err;
+
+	if (!hfs_mapped_equal(response, hfs_json_field(response, entry, "claim"),
+		original, hfs_json_field(original, request, "claim")) ||
+	    !hfs_mapped_equal(response, hfs_json_field(response, entry, "description"),
+		original, hfs_json_field(original, reservation, "description")) ||
+	    !hfs_mapped_equal(response, hfs_json_field(response, entry, "offset"),
+		original, hfs_json_field(original, reservation, "offset")) ||
+	    !hfs_mapped_equal(response, hfs_json_field(response, entry, "reservation"),
+		original, hfs_json_field(original, reservation, "id")) ||
+	    !hfs_mapped_uuid(original, hfs_json_field(original, request, "recall")))
+		return -ESTALE;
+	for (i = 0; i < ARRAY_SIZE(fields); i++)
+		if (!hfs_mapped_equal(response, hfs_json_field(response, claim, fields[i]),
+			original, hfs_json_field(original, number, fields[i])))
+			return -ESTALE;
+	data = kvmalloc(decoded, GFP_KERNEL);
+	if (!data)
+		return -ENOMEM;
+	err = hfs_json_hex(original, hfs_json_field(original, request, "data"), data, &decoded);
+	if (!err && (!decoded || hfs_json_u64(response,
+		hfs_json_field(response, entry, "length"), &length) || length != decoded))
+		err = -EPROTO;
+	if (!err) {
+		hfs_hash(data, decoded, digest);
+		err = hfs_mapped_hash(response, entry, "payload_hash", digest);
+	}
+	kvfree(data);
+	if (!err)
+		err = hfs_mapped_freeze_intent(original, request, response, entry, digest);
+	if (!err)
+		err = hfs_mapped_hash(response, claim, "original_hash", digest);
+	return err;
+}
+
+static int hfs_mapped_source(const struct hfs_json *original, const struct hfs_json *response,
+			     int payload, const struct hfs_json *scope_json, int scope)
+{
+	int request = hfs_json_field(original, 0, "payload");
+	int op = hfs_json_field(original, 0, "op");
+	int operation = hfs_json_field(response, payload, "operation");
+	int ticket = hfs_json_field(response, payload, "request");
+	int cred = hfs_json_field(response, ticket, "credentials");
+	int lease = hfs_json_field(response, payload, "lease");
+	int reservation = hfs_json_field(response, payload, "reservation");
+	int entry = hfs_json_field(response, payload, "entry");
+	bool query = hfs_json_is(original, op, "\"VIEW_QUERY\"");
+	u8 digest[32];
+	int err;
+
+	if (hfs_json_exact(response, payload,
+			   "entry,id,lease,operation,request,request_hash,reservation,status") ||
+	    !hfs_mapped_equal(response, ticket, original,
+			      hfs_json_field(original, request, "request")) ||
+	    !hfs_mapped_hex32(response, payload, "request_hash") ||
+	    (!query && !hfs_mapped_equal(response, operation, original, op)))
+		return -EPROTO;
+	err = hfs_mapped_object_hash(
+		response, payload, "entry,lease,operation,request,request_hash,reservation,status",
+		"id");
+	if (err)
+		return err;
+	if (!query) {
+		err = hfs_mapped_hash_fields(original, 0, "op,payload", digest);
+		if (err || hfs_mapped_hash(response, payload, "request_hash", digest))
+			return err ? err : -ESTALE;
+	}
+	if (!hfs_json_is(response, entry, "null")) {
+		if (!(hfs_json_is(response, hfs_json_field(response, payload, "status"),
+				  "\"FROZEN\"") &&
+		      hfs_json_is(response, operation, "\"DIRTY_FREEZE\"") &&
+		      hfs_json_is(response, lease, "null") &&
+		      hfs_json_is(response, reservation, "null")))
+			return -EPROTO;
+		err = hfs_mapped_frozen_schema(response, entry, scope_json, scope);
+		if (!err && !query)
+			err = hfs_mapped_frozen_original(original, request, response, entry);
+		return err;
+	}
+	if (!hfs_json_is(response, hfs_json_field(response, payload, "status"), "\"GRANTED\""))
+		return -EPROTO;
+	if (!hfs_json_is(response, lease, "null")) {
+		int mode = hfs_json_field(response, lease, "mode");
+
+		if (!hfs_json_is(response, reservation, "null") ||
+		    !(hfs_json_is(response, operation, "\"VIEW_ACQUIRE\"") ||
+		      hfs_json_is(response, operation, "\"VIEW_RENEW\"")) ||
+		    hfs_json_exact(response, lease,
+				   "access,credential_hash,domain,fence,id,mode,revision,"
+				   "scope,target") ||
+		    !hfs_mapped_equal(response, hfs_json_field(response, lease, "scope"),
+				      scope_json, scope) ||
+		    !hfs_mapped_number(response, lease, "fence", 1) ||
+		    !hfs_mapped_number(response, lease, "revision", 1) ||
+		    !(hfs_json_is(response, mode, "\"READ\"") ||
+		      hfs_json_is(response, mode, "\"EXCLUSIVE_DIRTY\"")) ||
+		    hfs_mapped_target(response, hfs_json_field(response, lease, "target"),
+				      scope_json, scope))
+			return -EPROTO;
+		if (cred < 0 || (u32)cred >= response->count)
+			return -EPROTO;
+		hfs_hash(response->data + response->tokens[cred].start,
+			 response->tokens[cred].end - response->tokens[cred].start, digest);
+		if (hfs_mapped_hash(response, lease, "credential_hash", digest))
+			return -ESTALE;
+		if (hfs_json_is(original, op, "\"VIEW_ACQUIRE\"")) {
+			static const char *const fields[] = { "domain", "access", "mode" };
+			u32 i;
+
+			for (i = 0; i < ARRAY_SIZE(fields); i++)
+				if (!hfs_mapped_equal(
+					    response, hfs_json_field(response, lease, fields[i]),
+					    original, hfs_json_field(original, request, fields[i])))
+					return -ESTALE;
+			if (!hfs_json_is(original, hfs_json_field(original, request, "target"),
+					 "null") &&
+			    !hfs_mapped_equal(response, hfs_json_field(response, lease, "target"),
+					      original,
+					      hfs_json_field(original, request, "target")))
+				return -ESTALE;
+		}
+		if (hfs_json_is(original, op, "\"VIEW_RENEW\"")) {
+			static const char *const fields[] = {
+				"scope", "domain", "access", "credential_hash",
+				"mode",	 "target", "fence",
+			};
+			int old = hfs_json_field(original, request, "lease");
+			u64 revision, renewed;
+			u32 i;
+
+			if (hfs_json_u64(original, hfs_json_field(original, old, "revision"),
+					 &revision) ||
+			    revision == U64_MAX ||
+			    hfs_json_u64(response, hfs_json_field(response, lease, "revision"),
+					 &renewed) ||
+			    renewed != revision + 1)
+				return -ESTALE;
+			for (i = 0; i < ARRAY_SIZE(fields); i++)
+				if (!hfs_mapped_equal(
+					    response, hfs_json_field(response, lease, fields[i]),
+					    original, hfs_json_field(original, old, fields[i])))
+					return -ESTALE;
+		}
+		return hfs_mapped_object_hash(
+			response, lease,
+			"access,credential_hash,domain,fence,mode,revision,scope,target", "id");
+	}
+	if (!hfs_json_is(response, operation, "\"DIRTY_RESERVE\"") ||
+	    hfs_json_exact(response, reservation,
+			   "claim_number,credentials,description,drain_credit,id,"
+			   "lease_id,length,offset,provenance,scope") ||
+	    !hfs_mapped_equal(response, hfs_json_field(response, reservation, "scope"), scope_json,
+			      scope) ||
+	    !hfs_mapped_equal(response, hfs_json_field(response, reservation, "credentials"),
+			      response, cred) ||
+	    !hfs_mapped_uuid(response, hfs_json_field(response, reservation, "provenance")) ||
+	    !hfs_mapped_hex32(response, reservation, "drain_credit") ||
+	    !hfs_mapped_hex32(response, reservation, "lease_id"))
+		return -EPROTO;
+	if (hfs_json_is(original, op, "\"DIRTY_RESERVE\"")) {
+		static const char *const fields[] = { "description", "offset", "length",
+						      "claim_number" };
+		int old = hfs_json_field(original, request, "lease");
+		u32 i;
+
+		if (!hfs_mapped_equal(response, hfs_json_field(response, reservation, "lease_id"),
+				      original, hfs_json_field(original, old, "id")))
+			return -ESTALE;
+		for (i = 0; i < ARRAY_SIZE(fields); i++)
+			if (!hfs_mapped_equal(
+				    response, hfs_json_field(response, reservation, fields[i]),
+				    original, hfs_json_field(original, request, fields[i])))
+				return -ESTALE;
+	}
+	return hfs_mapped_object_hash(
+		response, reservation,
+		"claim_number,credentials,description,drain_credit,lease_id,length,"
+		"offset,provenance,scope",
+		"id");
+}
+
+/* Inert complete original-ticket policy, also used for QUERY against the
+ * privately retained actual original op/payload. No receipt/authority is
+ * minted.
+ */
+int hfs_mapped_source_policy(const struct hfs_json *scope_json, int scope,
+		const struct hfs_json *original, const struct hfs_json *response,
+		int payload)
+{
+	return hfs_mapped_source(original, response, payload, scope_json, scope);
+}
+
+static int hfs_mapped_credentials(const struct hfs_json *json, int cred)
+{
+	u64 value, previous = 0;
+	int groups, i;
+	u32 count = 0;
+
+	if (hfs_json_exact(json, cred,
+			   "credential_revision,fsgid,fsuid,groups,idmap_hash,"
+			   "process,user_namespace") ||
+	    !hfs_mapped_uuid(json, hfs_json_field(json, cred, "process")) ||
+	    !hfs_mapped_uuid(json, hfs_json_field(json, cred, "user_namespace")) ||
+	    !hfs_mapped_hex32(json, cred, "idmap_hash") ||
+	    hfs_json_u64(json, hfs_json_field(json, cred, "credential_revision"), &value) ||
+	    !value || hfs_json_u64(json, hfs_json_field(json, cred, "fsuid"), &value) ||
+	    value > U32_MAX || hfs_json_u64(json, hfs_json_field(json, cred, "fsgid"), &value) ||
+	    value > U32_MAX)
+		return -EPROTO;
+	groups = hfs_json_field(json, cred, "groups");
+	if (groups < 0 || json->tokens[groups].kind != HFS_ARRAY)
+		return -EPROTO;
+	for (i = groups + 1; i < json->count && json->tokens[i].start < json->tokens[groups].end;
+	     i++) {
+		if (json->tokens[i].parent != groups || ++count > HFS_GROUPS_MAX ||
+		    hfs_json_u64(json, i, &value) || value > U32_MAX ||
+		    (count > 1 && value <= previous))
+			return -EPROTO;
+		previous = value;
+	}
+	return 0;
+}
+
+/* Inert closed manifest checking. Authority remains the private Received owner.
+ */
+static int hfs_mapped_settled(const struct hfs_json *original, int request,
+			      const struct hfs_json *response, int payload, int evidence)
+{
+	int array = hfs_json_field(original, request, "settled_cells");
+	int donor = hfs_json_field(original, 0, "reclaim");
+	u64 previous = 0, primary = 0, cell, through, candidate;
+	u32 count = 0, length;
+	u8 digest[32], expected[32];
+	int i, hash;
+
+	if (array < 0 || original->tokens[array].kind != HFS_ARRAY || donor < 0 ||
+	    hfs_json_u64(original, hfs_json_field(original, request, "guest_through"), &through) ||
+	    hfs_json_u64(original, hfs_json_field(original, 0, "cell"), &candidate) ||
+	    candidate != through + 1)
+		return -EPROTO;
+	if (!hfs_json_is(original, donor, "null")) {
+		if (hfs_json_exact(original, donor, "cell,response_hash") ||
+		    hfs_json_u64(original, hfs_json_field(original, donor, "cell"), &primary) ||
+		    !primary || primary > through ||
+		    !hfs_mapped_hex32(original, donor, "response_hash"))
+			return -EPROTO;
+	}
+	for (i = array + 1;
+	     i < original->count && original->tokens[i].start < original->tokens[array].end;
+	     i = hfs_token_next(original, i)) {
+		if (original->tokens[i].parent != array || ++count > 79 ||
+		    hfs_json_exact(original, i, "cell,response_hash") ||
+		    hfs_json_u64(original, hfs_json_field(original, i, "cell"), &cell) || !cell ||
+		    cell <= previous || cell > through || cell == primary ||
+		    !hfs_mapped_hex32(original, i, "response_hash"))
+			return -EPROTO;
+		previous = cell;
+	}
+	if (!primary && count)
+		return -EPROTO;
+	hfs_hash(original->data + original->tokens[array].start,
+		 original->tokens[array].end - original->tokens[array].start, digest);
+	hash = hfs_json_field(response, payload, "settled_hash");
+	length = sizeof(expected);
+	if (hfs_json_hex(response, hash, expected, &length) || length != sizeof(expected) ||
+	    memcmp(expected, digest, sizeof(expected)) ||
+	    !hfs_mapped_equal(response, hash, response,
+			      hfs_json_field(response, evidence, "settled_hash")))
+		return -ESTALE;
+	return 0;
+}
+
+static int hfs_mapped_kind(const struct hfs_json *original, const struct hfs_json *response,
+			   int receipt, struct hfs_mapped_attestation *out)
+{
+	int kind = hfs_json_field(response, receipt, "kind");
+	int op = hfs_json_field(original, 0, "op");
+	int payload = hfs_json_field(response, 0, "payload");
+	int evidence = hfs_json_field(response, receipt, "evidence");
+	int request = hfs_json_field(original, 0, "payload");
+	int event, domain;
+	const char *fields;
+	char name[32];
+	u32 len;
+
+	if (hfs_json_is(response, kind, "\"SOURCE\"")) {
+		if (!(hfs_json_is(original, op, "\"VIEW_ACQUIRE\"") ||
+		      hfs_json_is(original, op, "\"VIEW_RENEW\"") ||
+		      hfs_json_is(original, op, "\"VIEW_QUERY\"") ||
+		      hfs_json_is(original, op, "\"DIRTY_RESERVE\"") ||
+		      hfs_json_is(original, op, "\"DIRTY_FREEZE\"")) ||
+		    hfs_json_exact(response, evidence, "retained_owner,target") ||
+		    !hfs_mapped_uuid(response,
+				     hfs_json_field(response, evidence, "retained_owner")) ||
+		    hfs_mapped_target(response, hfs_json_field(response, evidence, "target"),
+				      original, hfs_json_field(original, 0, "context")) ||
+		    !hfs_json_is(response,
+				 hfs_json_field(response,
+						hfs_json_field(response, evidence, "target"),
+						"kind"),
+				 "\"CONTROLLED_LOCAL\""))
+			return -EPROTO;
+		if (hfs_mapped_source(original, response, payload, original,
+				      hfs_json_field(original, 0, "context")))
+			return -EPROTO;
+		fields = "lease,reservation,entry";
+		while (*fields) {
+			len = strcspn(fields, ",");
+			memcpy(name, fields, len);
+			name[len] = 0;
+			event = hfs_json_field(response, payload, name);
+			if (event >= 0 && !hfs_json_is(response, event, "null")) {
+				out->kind = HFS_ATTESTATION_SOURCE;
+				return 0;
+			}
+			fields += len + (fields[len] == ',');
+		}
+		return -EPROTO;
+	}
+	if (hfs_json_is(response, kind, "\"EVENT\"")) {
+		if (!(hfs_json_is(original, op, "\"VIEW_WAIT\"") ||
+		      hfs_json_is(original, op, "\"VIEW_POLL\"")) ||
+		    hfs_json_exact(response, payload, "event,status") ||
+		    !hfs_json_is(response, hfs_json_field(response, payload, "status"),
+				 "\"EVENT\"") ||
+		    hfs_json_exact(response, evidence,
+				   "domain_token,manifest_hash,phase,recall,retained_owner,"
+				   "sequence,target"))
+			return -EPROTO;
+		event = hfs_json_field(response, payload, "event");
+		domain = hfs_json_field(response, event, "domain");
+		if (hfs_mapped_event(original, response, event, evidence))
+			return -EPROTO;
+		if (!hfs_mapped_equal(response, hfs_json_field(response, domain, "token"), response,
+				      hfs_json_field(response, evidence, "domain_token")))
+			return -ESTALE;
+		fields = "sequence,recall,phase,manifest_hash,target";
+		out->kind = HFS_ATTESTATION_EVENT;
+		request = event;
+		original = response;
+	} else if (hfs_json_is(response, kind, "\"SESSION_RETIRED\"")) {
+		const char *names = "closure_hash,guest_through,observer_revision,retirement_id";
+		char field[32];
+		u32 n;
+		u64 through, revision;
+
+		if (!hfs_json_is(original, op, "\"SESSION_RETIRE\"") ||
+		    hfs_protocol_selected_match(original, hfs_json_field(original, 0, "protocol"),
+						4, HFS_TERMINAL_FEATURES) ||
+		    hfs_json_exact(original, request,
+				   "closure_hash,credentials,guest_through,observer_"
+				   "revision,retirement_id,settled_cells") ||
+		    hfs_json_exact(response, evidence,
+				   "closure_hash,credentials,guest_through,observer_revision,"
+				   "ownership_hash,retained_owner,retirement_id,settled_hash") ||
+		    hfs_json_exact(response, payload,
+				   "closure_hash,guest_through,observer_revision,ownership_hash,"
+				   "retirement_id,settled_hash,status") ||
+		    !hfs_json_is(response, hfs_json_field(response, payload, "status"),
+				 "\"RETIRED\"") ||
+		    !hfs_json_is(response, hfs_json_field(response, evidence, "retained_owner"),
+				 "\"C8_TERMINAL_CELL\"") ||
+		    !hfs_mapped_hex32(response, evidence, "ownership_hash") ||
+		    !hfs_mapped_hex32(original, request, "closure_hash") ||
+		    !hfs_mapped_uuid(original,
+				     hfs_json_field(original, request, "retirement_id")) ||
+		    hfs_mapped_settled(original, request, response, payload, evidence) ||
+		    hfs_mapped_credentials(original,
+					   hfs_json_field(original, request, "credentials")) ||
+		    hfs_json_u64(original, hfs_json_field(original, request, "guest_through"),
+				 &through) ||
+		    through >= HFS_CELL_MAX ||
+		    hfs_json_u64(original, hfs_json_field(original, request, "observer_revision"),
+				 &revision) ||
+		    !revision ||
+		    !hfs_mapped_equal(response, hfs_json_field(response, payload, "ownership_hash"),
+				      response,
+				      hfs_json_field(response, evidence, "ownership_hash")))
+			return -ESTALE;
+		while (*names) {
+			n = strcspn(names, ",");
+			memcpy(field, names, n);
+			field[n] = 0;
+			if (!hfs_mapped_equal(original, hfs_json_field(original, request, field),
+					      response, hfs_json_field(response, payload, field)))
+				return -ESTALE;
+			names += n + (names[n] == ',');
+		}
+		fields = "retirement_id,credentials,guest_through,observer_revision,"
+			 "closure_hash";
+		out->kind = HFS_ATTESTATION_SESSION_RETIRED;
+	} else if (hfs_json_is(response, kind, "\"VIEW_FLOOR\"")) {
+		u64 through, floor;
+
+		if (!hfs_json_is(original, op, "\"VIEW_RETIRE\"") ||
+		    hfs_json_exact(response, evidence,
+				   "anchor,credentials,nonce,proof_hash,through") ||
+		    hfs_json_exact(response, payload, "floor,proof_hash,status") ||
+		    !hfs_mapped_hex32(response, evidence, "proof_hash") ||
+		    !hfs_json_is(response, hfs_json_field(response, payload, "status"),
+				 "\"RETIRED\"") ||
+		    hfs_json_u64(original, hfs_json_field(original, request, "through"),
+				 &through) ||
+		    hfs_json_u64(response, hfs_json_field(response, payload, "floor"), &floor) ||
+		    !through || floor != through ||
+		    !hfs_mapped_equal(response, hfs_json_field(response, payload, "proof_hash"),
+				      response, hfs_json_field(response, evidence, "proof_hash")))
+			return -ESTALE;
+		fields = "anchor,nonce,through,credentials";
+		out->kind = HFS_ATTESTATION_VIEW_FLOOR;
+	} else if (hfs_json_is(response, kind, "\"FLOOR\"")) {
+		u64 through, floor;
+
+		if (!hfs_json_is(original, op, "\"RETIRE\"") ||
+		    hfs_json_exact(response, evidence,
+				   "anchor,credentials,nonce,proof_hash,realm,subject,through") ||
+		    hfs_json_exact(response, payload, "floor,proof_hash,status") ||
+		    !hfs_mapped_hex32(response, evidence, "proof_hash") ||
+		    !hfs_json_is(response, hfs_json_field(response, payload, "status"),
+				 "\"RETIRED\"") ||
+		    hfs_json_u64(original, hfs_json_field(original, request, "through"),
+				 &through) ||
+		    hfs_json_u64(response, hfs_json_field(response, payload, "floor"), &floor) ||
+		    !through || floor != through ||
+		    !hfs_mapped_equal(response, hfs_json_field(response, payload, "proof_hash"),
+				      response, hfs_json_field(response, evidence, "proof_hash")))
+			return -ESTALE;
+		fields = "realm,subject,anchor,nonce,through,credentials";
+		out->kind = HFS_ATTESTATION_FLOOR;
+	} else {
+		return -EOPNOTSUPP;
+	}
+	while (*fields) {
+		len = strcspn(fields, ",");
+		memcpy(name, fields, len);
+		name[len] = 0;
+		if (!hfs_mapped_equal(original, hfs_json_field(original, request, name), response,
+				      hfs_json_field(response, evidence, name)))
+			return -ESTALE;
+		fields += len + (fields[len] == ',');
+	}
+	return 0;
+}
+
+int hfs_mapped_receipt_verify(const struct hfs_mapped_binding *binding,
+			      const struct hfs_json *original, const struct hfs_json *response,
+			      struct hfs_mapped_attestation *result)
+{
+	static const char unsigned_fields[] =
+		"cell,command_hash,controller,endpoint,evidence,guest_cell,"
+		"guest_command_hash,guest_response_hash,kind,mapping_hash,poll_count,"
+		"response_hash,scope,serving_generation,version";
+	struct hfs_mapped_attestation checked = { 0 };
+	struct hfs_buf message = { 0 };
+	const struct hfs_json *context;
+	u8 digest[32], signature[64];
+	u32 len = sizeof(signature);
+	u64 native;
+	int receipt, token, err;
+	const char *fields;
+	char name[32];
+
+	if (!binding || !binding->verify_ed25519)
+		return -EOPNOTSUPP;
+	if (!original || !response || !result || !binding->context ||
+	    original->len > HFS_BODY_MAX || response->len > HFS_BODY_MAX ||
+	    hfs_json_exact(original, 0, "cell,context,delegation,op,payload,protocol,reclaim") ||
+	    !hfs_json_is(original, hfs_json_field(original, 0, "delegation"), "null") ||
+	    hfs_protocol_selected_match(original, hfs_json_field(original, 0, "protocol"), 4,
+					binding->features) ||
+	    hfs_json_exact(response, 0, "cell,context,op,payload,protocol,verification") ||
+	    hfs_protocol_selected_match(response, hfs_json_field(response, 0, "protocol"), 4,
+					binding->features))
+		return -EPROTO;
+	context = binding->context;
+	if (hfs_mapped_context(context))
+		return -EPROTO;
+	receipt = hfs_json_field(response, 0, "verification");
+	if (hfs_json_exact(response, receipt,
+			   "cell,command_hash,controller,endpoint,evidence,guest_"
+			   "cell,guest_command_hash,"
+			   "guest_response_hash,kind,mapping_hash,poll_count,"
+			   "response_hash,scope,"
+			   "serving_generation,signature,version") ||
+	    !hfs_json_is(response, hfs_json_field(response, receipt, "version"),
+			 "\"homelabfs-controlled-verification/2\"") ||
+	    hfs_json_u64(original, hfs_json_field(original, 0, "cell"), &checked.guest_cell) ||
+	    !checked.guest_cell || checked.guest_cell > HFS_CELL_MAX ||
+	    hfs_json_u64(response, hfs_json_field(response, receipt, "cell"), &native) || !native ||
+	    native > HFS_CELL_MAX ||
+	    hfs_json_u64(response, hfs_json_field(response, receipt, "poll_count"),
+			 &checked.poll_count) ||
+	    !checked.poll_count || checked.poll_count > 16 ||
+	    (checked.poll_count > 1 &&
+	     !hfs_json_is(original, hfs_json_field(original, 0, "op"), "\"VIEW_WAIT\"")))
+		return -EPROTO;
+	fields = "controller,endpoint,scope,serving_generation";
+	while (*fields) {
+		len = strcspn(fields, ",");
+		memcpy(name, fields, len);
+		name[len] = 0;
+		if (!hfs_mapped_equal(context, hfs_json_field(context, 0, name), response,
+				      hfs_json_field(response, receipt, name)))
+			return -ESTALE;
+		fields += len + (fields[len] == ',');
+	}
+	if (!hfs_mapped_equal(original, hfs_json_field(original, 0, "context"), context,
+			      hfs_json_field(context, 0, "scope")))
+		return -ESTALE;
+	fields = "cell,context,op";
+	while (*fields) {
+		len = strcspn(fields, ",");
+		memcpy(name, fields, len);
+		name[len] = 0;
+		if (!hfs_mapped_equal(original, hfs_json_field(original, 0, name), response,
+				      hfs_json_field(response, 0, name)))
+			return -ESTALE;
+		fields += len + (fields[len] == ',');
+	}
+	if (!hfs_mapped_equal(original, hfs_json_field(original, 0, "cell"), response,
+			      hfs_json_field(response, receipt, "guest_cell")))
+		return -ESTALE;
+	hfs_hash(original->data, original->len, digest);
+	err = hfs_mapped_hash(response, receipt, "guest_command_hash", digest);
+	if (err)
+		return err;
+	err = hfs_mapped_hash_fields(response, 0, "cell,context,op,payload,protocol", digest);
+	if (err)
+		return err;
+	err = hfs_mapped_hash(response, receipt, "guest_response_hash", digest);
+	if (err)
+		return err;
+	/* Validate all fixed hash encodings, including fields the guest cannot
+   * independently reconstruct. Host signature attests those native legs. */
+	fields = "command_hash,response_hash,mapping_hash";
+	while (*fields) {
+		len = strcspn(fields, ",");
+		memcpy(name, fields, len);
+		name[len] = 0;
+		len = 32;
+		token = hfs_json_field(response, receipt, name);
+		if (hfs_json_hex(response, token, digest, &len) || len != 32)
+			return -EPROTO;
+		len = strcspn(fields, ",");
+		fields += len + (fields[len] == ',');
+	}
+	err = hfs_mapped_kind(original, response, receipt, &checked);
+	if (err)
+		return err;
+	len = sizeof(signature);
+	if (hfs_json_hex(response, hfs_json_field(response, receipt, "signature"), signature,
+			 &len) ||
+	    len != sizeof(signature))
+		return -EPROTO;
+	err = hfs_buf_init(&message, HFS_RECEIPT_UNSIGNED_MAX);
+	if (err)
+		return err;
+	err = hfs_mapped_fields(response, receipt, unsigned_fields, &message);
+	if (!err)
+		err = binding->verify_ed25519(binding->public_key, message.data, message.len,
+					      signature);
+	hfs_buf_free(&message);
+	if (!err)
+		*result = checked;
+	return err;
+}
diff --git a/fs/9p/hfs_policy.h b/fs/9p/hfs_policy.h
new file mode 100644
--- /dev/null
+++ b/fs/9p/hfs_policy.h
@@ -0,0 +1,53 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef FS_9P_HFS_POLICY_H
+#define FS_9P_HFS_POLICY_H
+
+#include "hfs_protocol.h"
+
+/* Retained claims, independent of the 64+16 transport snapshot credits. */
+#define HFS_ORDINARY_REQUESTS_MAX 4096U
+#define HFS_CONTROL_REQUESTS_MAX 13312U
+
+struct hfs_timestamp {
+	s64 seconds;
+	u32 nanos;
+};
+
+/* Exact committed service metadata; caller credentials never rewrite it. */
+struct hfs_attr {
+	uuid_t home;
+	uuid_t allocation;
+	u32 uid;
+	u32 gid;
+	u32 mode;
+	u64 size;
+	u64 nlink;
+	u64 revision;
+	u16 type;
+	struct hfs_timestamp atime;
+	struct hfs_timestamp mtime;
+	struct hfs_timestamp ctime;
+};
+
+int hfs_policy_uuid(const struct hfs_json *json, int token, uuid_t *out);
+/* Check the complete input ceiling before producing its sorted unique set. */
+int hfs_groups_snapshot(const u32 *input, u32 count, u32 *out, u32 *out_count);
+/* Preserve an enrollment mapper's error; never repair missing identity. */
+int hfs_identity_validate(u32 uid, u32 gid, const uuid_t *ns, int map_error);
+int hfs_attr_decode(const struct hfs_json *json, int token,
+		    const uuid_t *expected_home,
+		    const uuid_t *expected_allocation, u16 existing_type,
+		    struct hfs_attr *out);
+
+/* Largest permitted exclusive byte end, captured before dispatch. */
+u64 hfs_write_max_end(u64 rlimit, bool largefile, u64 fsmax);
+
+/* Reserved cleanup/drain claims continue while ordinary admission is blocked. */
+int hfs_request_admit(bool blocked, bool control, u32 ordinary_count,
+		      u32 control_count, u64 next_claim);
+
+/* Only definitive capacity refusal permits the identical SEND to be retried. */
+int hfs_send_reply(const void *packet, u32 len, bool expired);
+
+
+#endif
diff --git a/fs/9p/hfs_policy.c b/fs/9p/hfs_policy.c
new file mode 100644
--- /dev/null
+++ b/fs/9p/hfs_policy.c
@@ -0,0 +1,199 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Pure request identity and authoritative metadata validation. */
+#include "hfs_policy.h"
+
+#ifndef HFS_CODEC_USERSPACE
+#include <linux/errno.h>
+#include <linux/fs.h>
+#include <linux/kernel.h>
+#include <linux/sort.h>
+#include <linux/stat.h>
+#include <linux/string.h>
+#endif
+
+static int hfs_policy_hex(char c)
+{
+	if (c >= '0' && c <= '9')
+		return c - '0';
+	if (c >= 'a' && c <= 'f')
+		return c - 'a' + 10;
+	return -EPROTO;
+}
+
+int hfs_policy_uuid(const struct hfs_json *json, int token, uuid_t *out)
+{
+	uuid_t id;
+	char text[37];
+	u32 pos = 0, i;
+	int a, b;
+	u8 nonzero = 0;
+
+	if (!out || hfs_json_string(json, token, text, sizeof(text)) != 36)
+		return -EPROTO;
+	for (i = 0; i < sizeof(id.b); i++) {
+		if (pos == 8 || pos == 13 || pos == 18 || pos == 23) {
+			if (text[pos++] != '-')
+				return -EPROTO;
+		}
+		a = hfs_policy_hex(text[pos++]);
+		b = hfs_policy_hex(text[pos++]);
+		if (a < 0 || b < 0)
+			return -EPROTO;
+		id.b[i] = a * 16 + b;
+		nonzero |= id.b[i];
+	}
+	if (!nonzero)
+		return -EPROTO;
+	*out = id;
+	return 0;
+}
+
+static int hfs_policy_group_compare(const void *a, const void *b)
+{
+	u32 x = *(const u32 *)a;
+	u32 y = *(const u32 *)b;
+
+	return (x > y) - (x < y);
+}
+
+int hfs_groups_snapshot(const u32 *input, u32 count, u32 *out, u32 *out_count)
+{
+	u32 i, size = 0;
+
+	if (!out_count)
+		return -EINVAL;
+	*out_count = 0;
+	if (count > HFS_GROUPS_MAX)
+		return -E2BIG;
+	if (count && (!input || !out))
+		return -EINVAL;
+	for (i = 0; i < count; i++)
+		if (input[i] == U32_MAX)
+			return -EOVERFLOW;
+	if (count) {
+		memmove(out, input, count * sizeof(*out));
+		sort(out, count, sizeof(*out), hfs_policy_group_compare, NULL);
+	}
+	for (i = 0; i < count; i++)
+		if (!size || out[i] != out[size - 1])
+			out[size++] = out[i];
+	*out_count = size;
+	return 0;
+}
+
+int hfs_identity_validate(u32 uid, u32 gid, const uuid_t *ns, int map_error)
+{
+	static const u8 zero[16];
+
+	if (map_error)
+		return map_error;
+	if (uid == U32_MAX || gid == U32_MAX)
+		return -EOVERFLOW;
+	if (!ns || !memcmp(ns->b, zero, sizeof(zero)))
+		return -EACCES;
+	return 0;
+}
+
+static int hfs_timestamp_decode(const struct hfs_json *json, int token,
+				struct hfs_timestamp *time)
+{
+	u64 nanos;
+
+	if (hfs_json_exact(json, token, "nanos,seconds") ||
+	    hfs_json_i64(json, hfs_json_field(json, token, "seconds"),
+			 &time->seconds) ||
+	    hfs_json_u64(json, hfs_json_field(json, token, "nanos"), &nanos) ||
+	    nanos >= 1000000000U)
+		return -EPROTO;
+	time->nanos = nanos;
+	return 0;
+}
+
+int hfs_attr_decode(const struct hfs_json *json, int token,
+		    const uuid_t *expected_home,
+		    const uuid_t *expected_allocation, u16 existing_type,
+		    struct hfs_attr *out)
+{
+	struct hfs_attr attr;
+	u64 uid, gid, mode;
+	int kind;
+
+	if (!out || !expected_home || !expected_allocation)
+		return -EINVAL;
+	memset(&attr, 0, sizeof(attr));
+	if (hfs_json_exact(json, token,
+		"atime,ctime,gid,kind,mode,mtime,nlink,object_allocation,object_home,revision,size,uid") ||
+	    hfs_policy_uuid(json, hfs_json_field(json, token, "object_home"),
+			    &attr.home) ||
+	    hfs_policy_uuid(json, hfs_json_field(json, token, "object_allocation"),
+			    &attr.allocation) ||
+	    memcmp(attr.home.b, expected_home->b, sizeof(attr.home.b)) ||
+	    memcmp(attr.allocation.b, expected_allocation->b,
+		   sizeof(attr.allocation.b)) ||
+	    hfs_json_u64(json, hfs_json_field(json, token, "uid"), &uid) ||
+	    hfs_json_u64(json, hfs_json_field(json, token, "gid"), &gid) ||
+	    hfs_json_u64(json, hfs_json_field(json, token, "mode"), &mode) ||
+	    hfs_json_u64(json, hfs_json_field(json, token, "size"), &attr.size) ||
+	    hfs_json_u64(json, hfs_json_field(json, token, "nlink"), &attr.nlink) ||
+	    hfs_json_u64(json, hfs_json_field(json, token, "revision"),
+			 &attr.revision))
+		return -EPROTO;
+	kind = hfs_json_field(json, token, "kind");
+	if (hfs_json_is(json, kind, "\"REGULAR\""))
+		attr.type = S_IFREG;
+	else if (hfs_json_is(json, kind, "\"DIRECTORY\""))
+		attr.type = S_IFDIR;
+	else if (hfs_json_is(json, kind, "\"SYMLINK\""))
+		attr.type = S_IFLNK;
+	else
+		return -EPROTO;
+	if (uid >= U32_MAX || gid >= U32_MAX || mode > 07777 ||
+	    attr.size > S64_MAX || attr.nlink > UINT_MAX || !attr.revision ||
+	    (attr.type == S_IFLNK && mode != 0777) ||
+	    (existing_type && existing_type != attr.type) ||
+	    hfs_timestamp_decode(json, hfs_json_field(json, token, "atime"),
+				 &attr.atime) ||
+	    hfs_timestamp_decode(json, hfs_json_field(json, token, "mtime"),
+				 &attr.mtime) ||
+	    hfs_timestamp_decode(json, hfs_json_field(json, token, "ctime"),
+				 &attr.ctime))
+		return -EPROTO;
+	attr.uid = uid;
+	attr.gid = gid;
+	attr.mode = mode;
+	*out = attr;
+	return 0;
+}
+
+u64 hfs_write_max_end(u64 rlimit, bool largefile, u64 fsmax)
+{
+	u64 limit = largefile ? S64_MAX : MAX_NON_LFS;
+
+	return min_t(u64, rlimit, min_t(u64, fsmax, limit));
+}
+
+int hfs_request_admit(bool blocked, bool control, u32 ordinary_count,
+		      u32 control_count, u64 next_claim)
+{
+	if (blocked && !control)
+		return -EHOSTDOWN;
+	if (!next_claim || next_claim == U64_MAX ||
+	    (control ? control_count >= HFS_CONTROL_REQUESTS_MAX :
+		       ordinary_count >= HFS_ORDINARY_REQUESTS_MAX))
+		return -ENOSPC;
+	return 0;
+}
+
+/* COPIED acknowledges this packet only; AGAIN is never SEND acceptance. */
+int hfs_send_reply(const void *packet, u32 len, bool expired)
+{
+	const u8 *bytes = packet;
+
+	if (!packet)
+		return -EPROTO;
+	if (len == 1 && bytes[0] == 1)
+		return 0;
+	if (len == 3 && bytes[0] == 4 && bytes[1] == 3 && bytes[2] == 0)
+		return expired ? -ETIMEDOUT : -EAGAIN;
+	return -EPROTO;
+}
diff --git a/fs/9p/hfs_cursor.h b/fs/9p/hfs_cursor.h
new file mode 100644
--- /dev/null
+++ b/fs/9p/hfs_cursor.h
@@ -0,0 +1,31 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef FS_9P_HFS_CURSOR_H
+#define FS_9P_HFS_CURSOR_H
+
+#include "hfs_protocol.h"
+
+#define HFS_DIR_COOKIES_MAX 4096U
+#define HFS_DIR_NAME_MAX 255U
+
+struct hfs_dir_cookie {
+	u64 position;
+	u64 revision;
+	u32 after_len;
+	u8 after[HFS_DIR_NAME_MAX];
+};
+
+/* Preallocated and charged by the caller; serialize all access externally. */
+struct hfs_dir_cursor {
+	u64 next;
+	u32 count;
+	struct hfs_dir_cookie cookies[HFS_DIR_COOKIES_MAX];
+};
+
+void hfs_cursor_init(struct hfs_dir_cursor *cursor);
+int hfs_cursor_record(struct hfs_dir_cursor *cursor, const void *after,
+		      u32 len, u64 revision, u64 *position);
+/* len is the output capacity on entry and the exact copied size on success. */
+int hfs_cursor_seek(const struct hfs_dir_cursor *cursor, u64 position,
+		    void *after, u32 *len, u64 *revision);
+
+#endif
diff --git a/fs/9p/hfs_cursor.c b/fs/9p/hfs_cursor.c
new file mode 100644
--- /dev/null
+++ b/fs/9p/hfs_cursor.c
@@ -0,0 +1,88 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Bounded immutable directory resume cookies, owned by one open description. */
+#include "hfs_cursor.h"
+
+#ifndef HFS_CODEC_USERSPACE
+#include <linux/errno.h>
+#include <linux/kernel.h>
+#include <linux/string.h>
+#endif
+
+void hfs_cursor_init(struct hfs_dir_cursor *cursor)
+{
+	cursor->next = 3;
+	cursor->count = 0;
+}
+
+static bool hfs_cursor_component(const u8 *name, u32 len)
+{
+	u32 i;
+
+	if (!name || !len || len > HFS_DIR_NAME_MAX ||
+	    (len == 1 && name[0] == '.') ||
+	    (len == 2 && name[0] == '.' && name[1] == '.'))
+		return false;
+	for (i = 0; i < len; i++)
+		if (!name[i] || name[i] == '/')
+			return false;
+	return true;
+}
+
+int hfs_cursor_record(struct hfs_dir_cursor *cursor, const void *after,
+		      u32 len, u64 revision, u64 *position)
+{
+	struct hfs_dir_cookie *cookie;
+	u32 i;
+
+	if (!cursor || !position || !revision ||
+	    !hfs_cursor_component(after, len) ||
+	    cursor->count > HFS_DIR_COOKIES_MAX || cursor->next < 3)
+		return -EINVAL;
+	for (i = 0; i < cursor->count; i++) {
+		cookie = &cursor->cookies[i];
+		if (cookie->revision == revision && cookie->after_len == len &&
+		    !memcmp(cookie->after, after, len)) {
+			*position = cookie->position;
+			return 0;
+		}
+	}
+	if (cursor->count == HFS_DIR_COOKIES_MAX || cursor->next > S64_MAX)
+		return -ENOSPC;
+	cookie = &cursor->cookies[cursor->count++];
+	cookie->position = cursor->next++;
+	cookie->revision = revision;
+	cookie->after_len = len;
+	memcpy(cookie->after, after, len);
+	*position = cookie->position;
+	return 0;
+}
+
+int hfs_cursor_seek(const struct hfs_dir_cursor *cursor, u64 position,
+		    void *after, u32 *len, u64 *revision)
+{
+	const struct hfs_dir_cookie *cookie;
+	u32 i;
+
+	if (!cursor || !len || !revision ||
+	    cursor->count > HFS_DIR_COOKIES_MAX)
+		return -EINVAL;
+	if (position < 3) {
+		*len = 0;
+		*revision = 0;
+		return 0;
+	}
+	for (i = 0; i < cursor->count; i++) {
+		cookie = &cursor->cookies[i];
+		if (cookie->position != position)
+			continue;
+		if (*len < cookie->after_len)
+			return -ENOSPC;
+		if (!after)
+			return -EINVAL;
+		memcpy(after, cookie->after, cookie->after_len);
+		*len = cookie->after_len;
+		*revision = cookie->revision;
+		return 0;
+	}
+	return -EINVAL;
+}
