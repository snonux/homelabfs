/usr/local/lib/vm-bhyve/vm-core-89-
/usr/local/lib/vm-bhyve/vm-core-90-                # if stopped, see if it's locked by another host
/usr/local/lib/vm-bhyve/vm-core-91-                if [ "${_run}" = "Stopped" -a -e "${VM_DS_PATH}/${_name}/run.lock" ]; then
/usr/local/lib/vm-bhyve/vm-core-92-                    _run=$(head -n1 "${VM_DS_PATH}/${_name}/run.lock")
/usr/local/lib/vm-bhyve/vm-core:93:                    _run="Locked (${_run})"
/usr/local/lib/vm-bhyve/vm-core-94-                fi
/usr/local/lib/vm-bhyve/vm-core-95-
/usr/local/lib/vm-bhyve/vm-core-96-                if [ -n "${_running_only}" ]; then
/usr/local/lib/vm-bhyve/vm-core-97-                    if [ "${_run}" = "Stopped" -o "${_run}" = "Suspended" ]; then
