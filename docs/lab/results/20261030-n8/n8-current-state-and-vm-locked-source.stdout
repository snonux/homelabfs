/usr/local/lib/vm-bhyve/vm-core-84-                # find out if we auto-start this vm, and get sequence number
/usr/local/lib/vm-bhyve/vm-core-85-                for _vm in ${vm_list}; do
/usr/local/lib/vm-bhyve/vm-core-86-                    [ "${_vm}" = "${_name}" ] && _auto="Yes [${_num}]"
/usr/local/lib/vm-bhyve/vm-core-87-                    _num=$((_num + 1))
