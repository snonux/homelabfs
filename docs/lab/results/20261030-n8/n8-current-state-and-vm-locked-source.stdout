/usr/local/lib/vm-bhyve/vm-core-104-                else
/usr/local/lib/vm-bhyve/vm-core-105-                    printf "${_format}" "${_name}" "${_ds}" "${_loader}" "${_cpu}" "${_memory}" "${_vnc}" "${_auto}" "${_run}"
/usr/local/lib/vm-bhyve/vm-core-106-                fi
/usr/local/lib/vm-bhyve/vm-core-107-            done
