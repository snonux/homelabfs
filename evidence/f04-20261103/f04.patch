+++ b/internal/controlledvalidation/claims.go
@@ -0,0 +1,327 @@
+package controlledvalidation
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+
+	"github.com/snonux/homelabfs/internal/fsapi"
+	"github.com/snonux/homelabfs/internal/guestbridge"
+	bolt "go.etcd.io/bbolt"
+)
+
+// Allocate protects the next exact public number before it can be sent. This
+// trusted local allocator is separate from guest CALL admission. Unsent numbers
+// remain explicit unresolved entries until ResolveGap protects their no-effect.
+func (p *Provider) Allocate(ctx context.Context, scope guestbridge.Context, claim guestbridge.Claim) error {
+	if err := p.Check(ctx, scope); err != nil {
+		return err
+	}
+	if !validClaim(claim) {
+		return fsapi.Invalid
+	}
+	return p.db.Update(func(tx *bolt.Tx) error {
+		b := p.bucket(tx, "claims")
+		k := claimKey(claim)
+		if old := b.Get(k); old != nil {
+			var e entry
+			if err := json.Unmarshal(old, &e); err != nil {
+				return err
+			}
+			if e.Claim != claim {
+				return fsapi.Stale
+			}
+			return nil
+		}
+		if b.Stats().KeyN >= p.config.MaxClaims {
+			return fsapi.NoSpace
+		}
+		ps, err := p.principal(tx, claim)
+		if err != nil {
+			return err
+		}
+		if ps.High == ^uint64(0) || claim.Number != ps.High+1 {
+			return fsapi.Stale
+		}
+		ps.High = claim.Number
+		if err = p.putPrincipal(tx, claim, ps); err != nil {
+			return err
+		}
+		return put(b, k, entry{Version: ledgerVersion, Claim: claim, Status: "ALLOCATED"})
+	})
+}
+
+// Resolve authenticates scope and immutable anchor before exposing old bytes.
+func (p *Provider) Resolve(ctx context.Context, scope guestbridge.Context, claim guestbridge.Claim) (guestbridge.ClaimState, error) {
+	if err := p.Check(ctx, scope); err != nil {
+		return guestbridge.ClaimState{}, err
+	}
+	var out guestbridge.ClaimState
+	err := p.db.View(func(tx *bolt.Tx) error {
+		ps, err := p.principal(tx, claim)
+		if err != nil {
+			return err
+		}
+		if claim.Number <= ps.Floor {
+			out.Status = "RETIRED_ID"
+			return nil
+		}
+		e, ok, err := p.load(tx, claim)
+		if err != nil {
+			return err
+		}
+		if !ok || e.Status == "ALLOCATED" {
+			out.Status = "UNKNOWN"
+			return nil
+		}
+		if e.Claim != claim {
+			return fsapi.Stale
+		}
+		out = state(e)
+		return nil
+	})
+	return out, err
+}
+
+// Reserve persists immutable canonical credentials, intent, context, UUID and
+// allocation before planning. It cannot authorize an unallocated guest number.
+func (p *Provider) Reserve(ctx context.Context, b guestbridge.Binding) (guestbridge.ClaimState, error) {
+	if err := p.Check(ctx, b.Context); err != nil {
+		return guestbridge.ClaimState{}, err
+	}
+	intent, err := canonicalJSON(b.Call.Intent)
+	if err != nil || hash(intent) != b.Call.Claim.OriginalHash {
+		return guestbridge.ClaimState{}, fsapi.Invalid
+	}
+	canonical, err := canonicalCall(b.Call)
+	if err != nil || !bytes.Equal(canonical, b.Canonical) {
+		return guestbridge.ClaimState{}, fsapi.Invalid
+	}
+	var out guestbridge.ClaimState
+	err = p.db.Update(func(tx *bolt.Tx) error {
+		ps, err := p.principal(tx, b.Call.Claim)
+		if err != nil {
+			return err
+		}
+		if b.Call.Claim.Number <= ps.Floor {
+			return fsapi.Stale
+		}
+		e, ok, err := p.load(tx, b.Call.Claim)
+		if err != nil {
+			return err
+		}
+		if !ok || e.Gap || e.Claim != b.Call.Claim {
+			return fsapi.Permission
+		}
+		if e.Status != "ALLOCATED" {
+			if !sameBinding(e.Binding, b) {
+				return fsapi.Stale
+			}
+			out = state(e)
+			return nil
+		}
+		b.Operation, err = p.reserveUUID(tx, "operations")
+		if err != nil {
+			return err
+		}
+		switch b.Call.Intent.Opcode {
+		case "CREATE", "MKDIR", "SYMLINK":
+			id, e := p.reserveUUID(tx, "allocations")
+			if e != nil {
+				return e
+			}
+			home, e := fsapi.ParseUUID(b.Context.Volume)
+			if e != nil {
+				return e
+			}
+			b.Allocation = fsapi.ObjectID{Home: home, Allocation: id}
+		}
+		if err = p.reserveCredit(tx, "retained-credit", p.config.ClaimCreditBytes, p.config.MaxRetainedBytes); err != nil {
+			return err
+		}
+		if err = p.reserveCredit(tx, "source-credit", p.config.SourceCreditBytes, p.config.MaxSourceBytes); err != nil {
+			return err
+		}
+		e.RetainedCredit = p.config.ClaimCreditBytes
+		e.SourceCredit = p.config.SourceCreditBytes
+		e.Binding = b
+		e.Status = "RESERVED"
+		if err = put(p.bucket(tx, "claims"), claimKey(e.Claim), e); err != nil {
+			return err
+		}
+		out = state(e)
+		return nil
+	})
+	return out, err
+}
+
+// ProtectResult persists exact completed wire bytes before TERMINAL is visible.
+func (p *Provider) ProtectResult(ctx context.Context, b guestbridge.Binding, result json.RawMessage) error {
+	if err := p.Check(ctx, b.Context); err != nil {
+		return err
+	}
+	if !controlledResult(result) {
+		return fsapi.Invalid
+	}
+	return p.update(b, func(e *entry) error {
+		if e.Outcome == nil {
+			return fsapi.Unavailable
+		}
+		if len(e.Result) != 0 && !bytes.Equal(e.Result, result) {
+			return fsapi.Stale
+		}
+		e.Result = bytes.Clone(result)
+		e.Status = "TERMINAL"
+		return nil
+	})
+}
+
+// Cancel only resolves protected allocated/reserved no-effect claims. Pending
+// execution is never converted into absence by timeout or cancellation.
+func (p *Provider) Cancel(ctx context.Context, scope guestbridge.Context, claim guestbridge.Claim) (guestbridge.ClaimState, error) {
+	if err := p.Check(ctx, scope); err != nil {
+		return guestbridge.ClaimState{}, err
+	}
+	p.execution.Lock()
+	defer p.execution.Unlock()
+	err := p.db.Update(func(tx *bolt.Tx) error {
+		e, ok, err := p.load(tx, claim)
+		if err != nil {
+			return err
+		}
+		if !ok || e.Claim != claim {
+			return fsapi.Permission
+		}
+		if e.Status == "ALLOCATED" || e.Status == "RESERVED" {
+			e.Gap = true
+			e.Status = "DECLINED"
+			return put(p.bucket(tx, "claims"), claimKey(claim), e)
+		}
+		return nil
+	})
+	if err != nil {
+		return guestbridge.ClaimState{}, err
+	}
+	return p.Resolve(ctx, scope, claim)
+}
+
+// ResolveGap protects authenticated no-effect for an allocated, never admitted
+// number. It refuses every pending or terminal operation.
+func (p *Provider) ResolveGap(ctx context.Context, scope guestbridge.Context, claim guestbridge.Claim) (string, error) {
+	if err := p.Check(ctx, scope); err != nil {
+		return "", err
+	}
+	p.execution.Lock()
+	defer p.execution.Unlock()
+	var proof string
+	err := p.db.Update(func(tx *bolt.Tx) error {
+		e, ok, err := p.load(tx, claim)
+		if err != nil {
+			return err
+		}
+		if !ok || e.Claim != claim || e.Plan != nil || e.Outcome != nil || len(e.Result) != 0 {
+			return fsapi.Permission
+		}
+		if e.Status != "ALLOCATED" && e.Status != "RESERVED" && e.Status != "DECLINED" {
+			return fsapi.Unavailable
+		}
+		e.Gap = true
+		e.Status = "DECLINED"
+		raw, err := json.Marshal(e)
+		if err != nil {
+			return err
+		}
+		proof = hash(raw)
+		return put(p.bucket(tx, "claims"), claimKey(claim), e)
+	})
+	return proof, err
+}
+
+// Retire advances a durable permanent floor only across complete exact terminal
+// result or protected gap coverage. No allocation, timeout or absence is skipped.
+func (p *Provider) Retire(ctx context.Context, scope guestbridge.Context, raw json.RawMessage) (json.RawMessage, error) {
+	if err := p.Check(ctx, scope); err != nil {
+		return nil, err
+	}
+	var req struct {
+		Realm, Subject, Anchor, Nonce string
+		Through                       uint64
+		Hashes                        []string `json:"result_hashes"`
+	}
+	if err := json.Unmarshal(raw, &req); err != nil {
+		return nil, err
+	}
+	claim := guestbridge.Claim{Realm: req.Realm, Subject: req.Subject, Anchor: req.Anchor, Nonce: req.Nonce}
+	status := "BLOCKED"
+	var floor uint64
+	var proof any
+	var receipt []byte
+	receiptKey := []byte(hash(raw))
+	err := p.db.Update(func(tx *bolt.Tx) error {
+		if old := p.bucket(tx, "retirements").Get(receiptKey); old != nil {
+			receipt = bytes.Clone(old)
+			return nil
+		}
+		ps, err := p.principal(tx, claim)
+		if err != nil {
+			return err
+		}
+		floor = ps.Floor
+		if req.Through <= floor || req.Through > ps.High || req.Through-floor > 1024 || uint64(len(req.Hashes)) != req.Through-floor {
+			return nil
+		}
+		for n := floor + 1; ; n++ {
+			claim.Number = n
+			e, ok, err := p.load(tx, claim)
+			if err != nil {
+				return err
+			}
+			if !ok {
+				return nil
+			}
+			var expected string
+			if e.Status == "TERMINAL" {
+				var r struct {
+					ID string `json:"id"`
+				}
+				if err = json.Unmarshal(e.Result, &r); err != nil {
+					return err
+				}
+				expected = r.ID
+			} else if e.Gap && e.Status == "DECLINED" {
+				b, err := json.Marshal(e)
+				if err != nil {
+					return err
+				}
+				expected = hash(b)
+			} else {
+				return nil
+			}
+			if req.Hashes[n-floor-1] != expected {
+				return nil
+			}
+			if n == req.Through {
+				break
+			}
+		}
+		ps.Floor = req.Through
+		if err = p.putPrincipal(tx, claim, ps); err != nil {
+			return err
+		}
+		floor = ps.Floor
+		status = "RETIRED"
+		proof = hash(append(bytes.Clone(raw), []byte(ledgerVersion)...))
+		receipt, err = json.Marshal(map[string]any{"status": status, "floor": floor, "proof_hash": proof})
+		if err != nil {
+			return err
+		}
+		return p.bucket(tx, "retirements").Put(receiptKey, receipt)
+	})
+	if err != nil {
+		return nil, err
+	}
+	if len(receipt) > 0 {
+		return receipt, nil
+	}
+	return json.Marshal(map[string]any{"status": status, "floor": floor, "proof_hash": proof})
+}
diff --git a/internal/controlledvalidation/execution.go b/internal/controlledvalidation/execution.go
new file mode 100644
index 0000000..df46dad
--- /dev/null
+++ b/internal/controlledvalidation/execution.go
@@ -0,0 +1,295 @@
+package controlledvalidation
+
+import (
+	"bytes"
+	"context"
+	"encoding/binary"
+	"encoding/json"
+	"errors"
+
+	"github.com/snonux/homelabfs/internal/fsapi"
+	"github.com/snonux/homelabfs/internal/fsservice"
+	"github.com/snonux/homelabfs/internal/guestbridge"
+	"github.com/snonux/homelabfs/internal/storage"
+	bolt "go.etcd.io/bbolt"
+)
+
+// Execute invokes real serialized filesystem planning and protects exact plan
+// and outcome in the private ledger. Recovery reuses original UUID evidence.
+func (p *Provider) Execute(ctx context.Context, b guestbridge.Binding, prepare func(guestbridge.Captured) (guestbridge.Prepared, error)) (guestbridge.Outcome, error) {
+	return p.execute(ctx, b, prepare, nil)
+}
+
+func (p *Provider) ExecuteValidation(ctx context.Context, b guestbridge.Binding, prepare func(guestbridge.Captured) (guestbridge.Prepared, error), protect func(guestbridge.Outcome) (json.RawMessage, json.RawMessage, error)) (guestbridge.Outcome, error) {
+	return p.execute(ctx, b, prepare, protect)
+}
+
+func (p *Provider) execute(ctx context.Context, b guestbridge.Binding, prepare func(guestbridge.Captured) (guestbridge.Prepared, error), protect func(guestbridge.Outcome) (json.RawMessage, json.RawMessage, error)) (guestbridge.Outcome, error) {
+	if err := p.Check(ctx, b.Context); err != nil {
+		return guestbridge.Outcome{}, err
+	}
+	p.execution.Lock()
+	defer p.execution.Unlock()
+	var saved entry
+	if err := p.db.View(func(tx *bolt.Tx) error {
+		e, ok, err := p.load(tx, b.Call.Claim)
+		if err != nil {
+			return err
+		}
+		if !ok || !sameExact(e.Binding, b) {
+			return fsapi.Stale
+		}
+		if e.Gap || (e.Status != "RESERVED" && e.Status != "PENDING" && e.Status != "TERMINAL") {
+			return fsapi.Stale
+		}
+		saved = e
+		return nil
+	}); err != nil {
+		return guestbridge.Outcome{}, err
+	}
+	if saved.Outcome != nil {
+		return *saved.Outcome, nil
+	}
+	var out guestbridge.Outcome
+	err := p.config.Service.Controlled(ctx, p.config.Authorization.Enrollment.Profile, func(owned context.Context, cut *fsservice.ControlledCut) error {
+		plan := saved.Plan
+		if plan == nil {
+			cap := &captured{cut: cut, provider: p, owned: owned, binding: b}
+			prepared, err := prepare(cap)
+			if err != nil {
+				var code fsapi.Errno
+				if !errors.As(err, &code) {
+					code = fsapi.IO
+				}
+				cp := fsservice.ControlledPlan{Operation: b.Operation, Result: fsapi.Result{Code: code}}
+				plan = &cp
+			} else {
+				if cap.plan == nil || prepared.Command.Operation != cap.plan.Command.Operation {
+					return fsapi.Stale
+				}
+				plan = cap.plan
+			}
+			predicted, err := plannedOutcome(owned, cut, *plan)
+			if err != nil {
+				return err
+			}
+			var proposed, bridge json.RawMessage
+			if protect != nil {
+				proposed, bridge, err = protect(predicted)
+				if err != nil {
+					return err
+				}
+				if !controlledResult(proposed) || !json.Valid(bridge) {
+					return fsapi.Invalid
+				}
+			}
+			var snapshotVersion uint64
+			if len(proposed) > 0 {
+				if err = p.db.Update(func(tx *bolt.Tx) error {
+					var e error
+					snapshotVersion, e = p.bucket(tx, "bridge").NextSequence()
+					return e
+				}); err != nil {
+					return err
+				}
+			}
+			if err = p.update(b, func(e *entry) error {
+				e.SnapshotVersion = snapshotVersion
+				e.Plan = plan
+				e.ProposedResult = proposed
+				e.BridgeState = bridge
+				e.PlannedOutcome = &predicted
+				e.Status = "PENDING"
+				raw, err := json.Marshal(e)
+				if err != nil {
+					return err
+				}
+				outcome, err := json.Marshal(predicted)
+				if err != nil {
+					return err
+				}
+				if uint64(len(raw)+len(proposed)+len(bridge)+len(outcome)+4096) > e.RetainedCredit || uint64(len(plan.MutationEncoding)+4096) > e.SourceCredit {
+					return fsapi.NoSpace
+				}
+				return nil
+			}); err != nil {
+				return err
+			}
+			if err = p.fail("plan-protected"); err != nil {
+				return err
+			}
+		}
+		result, err := cut.ApplyControlled(owned, *plan, saved.Plan != nil)
+		if err != nil {
+			return err
+		}
+		if err = p.fail("effect-before-outcome"); err != nil {
+			return err
+		}
+		if saved.Plan != nil && saved.PlannedOutcome != nil {
+			out = *saved.PlannedOutcome
+		} else {
+			var current entry
+			if err = p.db.View(func(tx *bolt.Tx) error { e, _, err := p.load(tx, b.Call.Claim); current = e; return err }); err != nil {
+				return err
+			}
+			if current.PlannedOutcome == nil {
+				return fsapi.Unavailable
+			}
+			out = *current.PlannedOutcome
+		}
+		out.Result = result
+		return p.db.Update(func(tx *bolt.Tx) error {
+			e, ok, err := p.load(tx, b.Call.Claim)
+			if err != nil {
+				return err
+			}
+			if !ok || !sameExact(e.Binding, b) {
+				return fsapi.Stale
+			}
+			e.Outcome = &out
+			if len(e.ProposedResult) > 0 {
+				e.Result = bytes.Clone(e.ProposedResult)
+				e.Status = "TERMINAL"
+				if err = p.protectSnapshot(tx, e); err != nil {
+					return err
+				}
+			}
+			return put(p.bucket(tx, "claims"), claimKey(e.Claim), e)
+		})
+	})
+	return out, err
+}
+
+func (c *captured) Image(ctx context.Context, id fsapi.UUID) (storage.Image, error) {
+	return c.cut.Image(c.owned, id)
+}
+
+func (c *captured) Stat(ctx context.Context, id fsapi.ObjectID) (storage.Object, error) {
+	return c.cut.Stat(c.owned, id)
+}
+
+func (c *captured) Lookup(ctx context.Context, id fsapi.ObjectID, name string) (storage.Entry, error) {
+	return c.cut.Lookup(c.owned, id, name)
+}
+
+func (c *captured) Prepare(_ context.Context, b guestbridge.Binding, command fsapi.Command) (guestbridge.Prepared, error) {
+	if !sameExact(c.binding, b) {
+		return guestbridge.Prepared{}, fsapi.Permission
+	}
+	if c.plan != nil {
+		return guestbridge.Prepared{}, fsapi.Stale
+	}
+	ctx := c.owned
+	var maxEnd *int64
+	if b.Call.Intent.Opcode == "WRITE" {
+		var a struct {
+			MaxEnd int64 `json:"max_end"`
+		}
+		if err := json.Unmarshal(b.Call.Intent.Args, &a); err != nil {
+			return guestbridge.Prepared{}, err
+		}
+		maxEnd = &a.MaxEnd
+	}
+	cred := b.Call.Credentials
+	if command.Operation == fsapi.DescriptorClose || command.Operation == fsapi.ProcessExit {
+		var token uint64
+		err := c.provider.db.Update(func(tx *bolt.Tx) error {
+			bucket := c.provider.bucket(tx, "processes")
+			key := []byte(cred.Process)
+			if raw := bucket.Get(key); raw != nil {
+				if len(raw) != 8 {
+					return fsapi.Stale
+				}
+				token = binary.BigEndian.Uint64(raw)
+				return nil
+			}
+			if bucket.Stats().KeyN >= c.provider.config.MaxClaims {
+				return fsapi.NoSpace
+			}
+			token = uint64(bucket.Stats().KeyN) + 1
+			var raw [8]byte
+			binary.BigEndian.PutUint64(raw[:], token)
+			return bucket.Put(key, raw[:])
+		})
+		if err != nil {
+			return guestbridge.Prepared{}, err
+		}
+		session, err := fsapi.ParseUUID(b.Context.Session)
+		if err != nil {
+			return guestbridge.Prepared{}, err
+		}
+		command.Lock.Owner = fsapi.LockOwner{Session: session, Generation: command.Generation, Token: token}
+	}
+	plan, err := c.cut.PlanControlled(ctx, fsapi.Cred{UID: cred.FSUID, GID: cred.FSGID, Groups: cred.Groups}, command, b.Operation, b.Allocation, maxEnd)
+	if err != nil {
+		return guestbridge.Prepared{}, err
+	}
+	c.plan = &plan
+	return guestbridge.Prepared{Command: plan.Command, Result: plan.Result}, nil
+}
+
+// RecoverOutcome resolves the original local operation and exact protected
+// result. Missing original journal evidence remains uncertain; no callback runs.
+func (p *Provider) RecoverOutcome(ctx context.Context, b guestbridge.Binding) (guestbridge.Outcome, bool, error) {
+	if err := p.Check(ctx, b.Context); err != nil {
+		return guestbridge.Outcome{}, false, err
+	}
+	var saved entry
+	if err := p.db.View(func(tx *bolt.Tx) error {
+		e, ok, err := p.load(tx, b.Call.Claim)
+		if err != nil {
+			return err
+		}
+		if !ok || !sameExact(e.Binding, b) {
+			return fsapi.Stale
+		}
+		saved = e
+		return nil
+	}); err != nil {
+		return guestbridge.Outcome{}, false, err
+	}
+	if saved.Outcome != nil {
+		return *saved.Outcome, true, nil
+	}
+	if saved.Plan == nil {
+		return guestbridge.Outcome{}, false, nil
+	}
+	out, err := p.Execute(ctx, b, func(guestbridge.Captured) (guestbridge.Prepared, error) {
+		return guestbridge.Prepared{}, fsapi.Unavailable
+	})
+	if err != nil {
+		return guestbridge.Outcome{}, false, err
+	}
+	return out, true, nil
+}
+
+func plannedOutcome(ctx context.Context, cut *fsservice.ControlledCut, p fsservice.ControlledPlan) (guestbridge.Outcome, error) {
+	out := guestbridge.Outcome{Result: p.Result, Publication: json.RawMessage("null")}
+	if p.TooLarge {
+		out.DelegatedError = fsservice.ErrDelegatedFileTooLarge
+		return out, nil
+	}
+	if p.Command.Parent.Valid() && p.Command.Name != "" {
+		entry, err := cut.Lookup(ctx, p.Command.Parent, p.Command.Name)
+		if err != nil {
+			return out, err
+		}
+		out.EntryRevision = entry.Revision
+	}
+	if p.Mutation != nil {
+		for _, entry := range p.Mutation.Redo.Entries {
+			if entry.Parent == p.Command.Parent && entry.Name == p.Command.Name {
+				out.EntryRevision = entry.After.Revision
+			}
+		}
+	}
+	for _, entry := range p.Result.Entries {
+		object, err := cut.Stat(ctx, entry.Object)
+		if err != nil {
+			return out, err
+		}
+		out.EntryAttributes = append(out.EntryAttributes, object.Attr)
+	}
+	return out, nil
+}
diff --git a/internal/controlledvalidation/ledger.go b/internal/controlledvalidation/ledger.go
new file mode 100644
index 0000000..cfeb232
--- /dev/null
+++ b/internal/controlledvalidation/ledger.go
@@ -0,0 +1,271 @@
+package controlledvalidation
+
+import (
+	"bytes"
+	"crypto/rand"
+	"crypto/sha256"
+	"encoding/binary"
+	"encoding/hex"
+	"encoding/json"
+	"reflect"
+
+	"github.com/snonux/homelabfs/internal/fsapi"
+	"github.com/snonux/homelabfs/internal/fsservice"
+	"github.com/snonux/homelabfs/internal/guestbridge"
+	"github.com/snonux/homelabfs/internal/journal/record"
+	bolt "go.etcd.io/bbolt"
+)
+
+func (p *Provider) bucket(tx *bolt.Tx, name string) *bolt.Bucket {
+	return tx.Bucket([]byte(ledgerVersion)).Bucket([]byte(name))
+}
+
+func (p *Provider) principal(tx *bolt.Tx, c guestbridge.Claim) (principal, error) {
+	var ps principal
+	raw := p.bucket(tx, "principals").Get(principalKey(c))
+	if raw == nil {
+		return ps, nil
+	}
+	err := json.Unmarshal(raw, &ps)
+	return ps, err
+}
+
+func (p *Provider) putPrincipal(tx *bolt.Tx, c guestbridge.Claim, ps principal) error {
+	return put(p.bucket(tx, "principals"), principalKey(c), ps)
+}
+
+func (p *Provider) load(tx *bolt.Tx, c guestbridge.Claim) (entry, bool, error) {
+	var e entry
+	raw := p.bucket(tx, "claims").Get(claimKey(c))
+	if raw == nil {
+		return e, false, nil
+	}
+	err := json.Unmarshal(raw, &e)
+	if err == nil && e.Plan != nil && len(e.Plan.MutationEncoding) > 0 {
+		var decoded record.Record
+		decoded, err = record.Decode(e.Plan.MutationEncoding)
+		if err == nil {
+			mutation, ok := decoded.Payload.(record.Mutation)
+			if !ok {
+				err = fsapi.Stale
+			} else {
+				e.Plan.Mutation = &mutation
+			}
+		}
+	}
+	if err == nil && e.Version != ledgerVersion {
+		err = fsapi.Stale
+	}
+	if err == nil && e.PlannedOutcome != nil && e.Plan != nil && e.Plan.TooLarge {
+		e.PlannedOutcome.DelegatedError = fsservice.ErrDelegatedFileTooLarge
+	}
+	if err == nil && e.Outcome != nil && e.Plan != nil && e.Plan.TooLarge {
+		e.Outcome.DelegatedError = fsservice.ErrDelegatedFileTooLarge
+	}
+	return e, true, err
+}
+
+func (p *Provider) update(b guestbridge.Binding, change func(*entry) error) error {
+	return p.db.Update(func(tx *bolt.Tx) error {
+		e, ok, err := p.load(tx, b.Call.Claim)
+		if err != nil {
+			return err
+		}
+		if !ok || !sameExact(e.Binding, b) {
+			return fsapi.Stale
+		}
+		if err = change(&e); err != nil {
+			return err
+		}
+		return put(p.bucket(tx, "claims"), claimKey(e.Claim), e)
+	})
+}
+
+func (p *Provider) fail(name string) error {
+	if p.config.Failpoint != nil {
+		return p.config.Failpoint(name)
+	}
+	return nil
+}
+
+func put(b *bolt.Bucket, k []byte, value any) error {
+	raw, err := json.Marshal(value)
+	if err != nil {
+		return err
+	}
+	return b.Put(k, raw)
+}
+
+func state(e entry) guestbridge.ClaimState {
+	status := e.Status
+	if status == "DECLINED" {
+		status = "INDETERMINATE"
+	}
+	return guestbridge.ClaimState{Status: status, Binding: e.Binding, Result: bytes.Clone(e.Result)}
+}
+
+func principalKey(c guestbridge.Claim) []byte {
+	raw, _ := json.Marshal([]string{c.Realm, c.Subject, c.Anchor, c.Nonce})
+	return raw
+}
+
+func claimKey(c guestbridge.Claim) []byte {
+	key := principalKey(c)
+	var n [8]byte
+	binary.BigEndian.PutUint64(n[:], c.Number)
+	return append(key, n[:]...)
+}
+
+func sameBinding(a, b guestbridge.Binding) bool {
+	return a.Context == b.Context && bytes.Equal(a.Canonical, b.Canonical)
+}
+
+func sameExact(a, b guestbridge.Binding) bool {
+	if !sameBinding(a, b) || a.Operation != b.Operation || a.Allocation != b.Allocation {
+		return false
+	}
+	raw, err := canonicalCall(b.Call)
+	return err == nil && bytes.Equal(raw, a.Canonical)
+}
+
+func hash(raw []byte) string { sum := sha256.Sum256(raw); return hex.EncodeToString(sum[:]) }
+
+func canonicalCall(call guestbridge.Call) ([]byte, error) { return canonicalJSON(call) }
+func canonicalJSON(value any) ([]byte, error) {
+	raw, err := json.Marshal(value)
+	if err != nil {
+		return nil, err
+	}
+	var v any
+	decoder := json.NewDecoder(bytes.NewReader(raw))
+	decoder.UseNumber()
+	if err = decoder.Decode(&v); err != nil {
+		return nil, err
+	}
+	var canonical bytes.Buffer
+	encoder := json.NewEncoder(&canonical)
+	encoder.SetEscapeHTML(false)
+	err = encoder.Encode(v)
+	raw = bytes.TrimSuffix(canonical.Bytes(), []byte{'\n'})
+	if err != nil {
+		return nil, err
+	}
+	if _, err = guestbridge.Canonical(raw); err != nil {
+		return nil, err
+	}
+	return raw, nil
+}
+
+func validClaim(c guestbridge.Claim) bool {
+	_, a := fsapi.ParseUUID(c.Realm)
+	_, b := fsapi.ParseUUID(c.Anchor)
+	_, d := fsapi.ParseUUID(c.Nonce)
+	subject, e := hex.DecodeString(c.Subject)
+	digest, f := hex.DecodeString(c.OriginalHash)
+	return a == nil && b == nil && d == nil && e == nil && f == nil && len(subject) > 0 && len(subject) <= 1024 && len(digest) == 32 && c.Number > 0
+}
+
+func newUUID() (fsapi.UUID, error) {
+	var id fsapi.UUID
+	if _, err := rand.Read(id[:]); err != nil {
+		return id, err
+	}
+	id[6] = (id[6] & 15) | 64
+	id[8] = (id[8] & 63) | 128
+	return id, nil
+}
+
+func nilValue(v any) bool {
+	if v == nil {
+		return true
+	}
+	r := reflect.ValueOf(v)
+	switch r.Kind() {
+	case reflect.Pointer, reflect.Map, reflect.Slice, reflect.Chan, reflect.Func, reflect.Interface:
+		return r.IsNil()
+	}
+	return false
+}
+
+func controlledResult(raw json.RawMessage) bool {
+	if !json.Valid(raw) {
+		return false
+	}
+	var result struct{ Publication json.RawMessage }
+	return json.Unmarshal(raw, &result) == nil && string(result.Publication) == "null"
+}
+
+func (p *Provider) protectSnapshot(tx *bolt.Tx, e entry) error {
+	bucket := p.bucket(tx, "bridge")
+	key := []byte(e.Binding.Context.Session)
+	versionKey := []byte(e.Binding.Context.Session + "/version")
+	if raw := bucket.Get(versionKey); raw != nil {
+		if len(raw) != 8 {
+			return fsapi.Stale
+		}
+		if binary.BigEndian.Uint64(raw) > e.SnapshotVersion {
+			return nil
+		}
+	}
+	if err := bucket.Put(key, e.BridgeState); err != nil {
+		return err
+	}
+	var version [8]byte
+	binary.BigEndian.PutUint64(version[:], e.SnapshotVersion)
+	return bucket.Put(versionKey, version[:])
+}
+
+func (p *Provider) reserveCredit(tx *bolt.Tx, name string, amount, maximum uint64) error {
+	root := tx.Bucket([]byte(ledgerVersion))
+	var used uint64
+	if raw := root.Get([]byte(name)); raw != nil {
+		if len(raw) != 8 {
+			return fsapi.Stale
+		}
+		used = binary.BigEndian.Uint64(raw)
+	}
+	if used > maximum || amount > maximum-used {
+		return fsapi.NoSpace
+	}
+	var next [8]byte
+	binary.BigEndian.PutUint64(next[:], used+amount)
+	return root.Put([]byte(name), next[:])
+}
+
+func validateEnrollment(e Enrollment) error {
+	scope := e.Scope
+	for _, value := range []string{scope.Cluster, scope.Configuration, scope.Export, scope.ExporterIncarnation, scope.FuseSession, scope.Generation, scope.GuestBoot, scope.GuestMount, scope.OriginIncarnation, scope.OriginJournal, scope.OriginNode, scope.Session, scope.VM, scope.Volume} {
+		if _, err := fsapi.ParseUUID(value); err != nil {
+			return fsapi.Invalid
+		}
+	}
+	for _, value := range []string{scope.AuthorityHash, scope.PolicyHash, scope.RegistryHash} {
+		raw, err := hex.DecodeString(value)
+		if err != nil || len(raw) != 32 || hex.EncodeToString(raw) != value {
+			return fsapi.Invalid
+		}
+	}
+	endpoint := e.Endpoint
+	if !e.ServingGeneration.Valid() || endpoint.FuseSession != scope.FuseSession || endpoint.CommandNode <= 1 || endpoint.ResultNode <= 1 || endpoint.RecallNode <= 1 || endpoint.CommandNode == endpoint.ResultNode || endpoint.CommandNode == endpoint.RecallNode || endpoint.ResultNode == endpoint.RecallNode {
+		return fsapi.Invalid
+	}
+	return nil
+}
+
+func (p *Provider) reserveUUID(tx *bolt.Tx, namespace string) (fsapi.UUID, error) {
+	bucket := p.bucket(tx, namespace)
+	for range 128 {
+		id, err := newUUID()
+		if err != nil {
+			return fsapi.UUID{}, err
+		}
+		if bucket.Get(id[:]) != nil {
+			continue
+		}
+		if err = bucket.Put(id[:], []byte{1}); err != nil {
+			return fsapi.UUID{}, err
+		}
+		return id, nil
+	}
+	return fsapi.UUID{}, fsapi.NoSpace
+}
diff --git a/internal/controlledvalidation/provider.go b/internal/controlledvalidation/provider.go
new file mode 100644
index 0000000..f634498
--- /dev/null
+++ b/internal/controlledvalidation/provider.go
@@ -0,0 +1,298 @@
+// Package controlledvalidation supplies a durable, explicitly enrolled disposable
+// single-node provider. Its private ledger is not normal distributed authority.
+package controlledvalidation
+
+import (
+	"bytes"
+	"context"
+	"crypto/ed25519"
+	"encoding/json"
+	"errors"
+	"os"
+	"path/filepath"
+	"sync"
+	"sync/atomic"
+	"syscall"
+	"time"
+
+	"github.com/snonux/homelabfs/internal/fsapi"
+	"github.com/snonux/homelabfs/internal/fsservice"
+	"github.com/snonux/homelabfs/internal/guestbridge"
+	bolt "go.etcd.io/bbolt"
+)
+
+const ledgerVersion = "homelabfs-private-controlled-validation/1"
+
+// Enrollment is the operator-approved complete synthetic scope. Both endpoint
+// keys additionally sign these exact bytes, proving acceptance of this profile.
+type Enrollment struct {
+	Profile           fsservice.ValidationProfile
+	Scope             guestbridge.Context
+	Endpoint          guestbridge.Endpoint
+	ServingGeneration fsapi.UUID
+	Ledger            fsapi.UUID
+	Journal           fsservice.ControlledJournal
+	HostKey, GuestKey []byte
+}
+
+// Authorization contains three detached Ed25519 signatures over json.Marshal
+// of Enrollment. Operator is pinned out of band, never read from the ledger.
+type Authorization struct {
+	Enrollment                                       Enrollment
+	OperatorSignature, HostSignature, GuestSignature []byte
+}
+
+// Facts rechecks actual installed component enrollment and guest provenance.
+// No implementation/default is supplied: kernel/cache/installation facts belong
+// to their real platform components, never a signature or a boolean substitute.
+type Facts interface {
+	Check(context.Context, Enrollment) error
+}
+
+// Config requires an existing private ledger directory, actual local service,
+// signed endpoint enrollment and an independent live component fact verifier.
+type Config struct {
+	Directory                                                             string
+	Initialize                                                            bool
+	Service                                                               *fsservice.Service
+	Operator                                                              ed25519.PublicKey
+	Authorization                                                         Authorization
+	Facts                                                                 Facts
+	MaxClaims                                                             int
+	MaxRetainedBytes, MaxSourceBytes, ClaimCreditBytes, SourceCreditBytes uint64
+	// Failpoint is component-test instrumentation. Any error preserves evidence.
+	Failpoint func(string) error
+}
+
+// Provider owns a single locked durable ledger and its exact enrolled scope.
+type Provider struct {
+	config    Config
+	db        *bolt.DB
+	execution sync.Mutex
+	closed    atomic.Bool
+}
+
+// entry retains original bytes and exact recovery plan before any service effect.
+type entry struct {
+	Version                      string
+	Claim                        guestbridge.Claim
+	Binding                      guestbridge.Binding
+	Status                       string
+	Plan                         *fsservice.ControlledPlan
+	Outcome                      *guestbridge.Outcome
+	Result                       json.RawMessage `json:",omitempty"`
+	Gap                          bool
+	ProposedResult               json.RawMessage `json:",omitempty"`
+	BridgeState                  json.RawMessage `json:",omitempty"`
+	PlannedOutcome               *guestbridge.Outcome
+	SnapshotVersion              uint64
+	RetainedCredit, SourceCredit uint64
+}
+type principal struct{ High, Floor uint64 }
+type captured struct {
+	cut      *fsservice.ControlledCut
+	plan     *fsservice.ControlledPlan
+	provider *Provider
+	owned    context.Context
+	binding  guestbridge.Binding
+}
+
+var _ guestbridge.Claims = (*Provider)(nil)
+var _ guestbridge.Execution = (*Provider)(nil)
+var _ guestbridge.Captured = (*captured)(nil)
+var _ guestbridge.ValidationState = (*Provider)(nil)
+var _ guestbridge.ValidationExecution = (*Provider)(nil)
+
+// New authenticates both endpoints before opening the private versioned ledger.
+// bbolt's exclusive OS lock prevents concurrent/restarted writers from sharing it.
+func New(ctx context.Context, c Config) (*Provider, error) {
+	if c.Service == nil || nilValue(c.Facts) || len(c.Operator) != ed25519.PublicKeySize {
+		return nil, fsapi.Invalid
+	}
+	if c.Service.State() != fsservice.Serving {
+		return nil, fsapi.Unavailable
+	}
+	a := c.Authorization
+	e := a.Enrollment
+	raw, err := json.Marshal(e)
+	if err != nil {
+		return nil, err
+	}
+	if validateEnrollment(e) != nil || bytes.Equal(e.HostKey, e.GuestKey) || !e.Ledger.Valid() || !e.Profile.Disposable || e.Profile.Name == "" || len(e.HostKey) != ed25519.PublicKeySize || len(e.GuestKey) != ed25519.PublicKeySize || !ed25519.Verify(c.Operator, raw, a.OperatorSignature) || !ed25519.Verify(e.HostKey, raw, a.HostSignature) || !ed25519.Verify(e.GuestKey, raw, a.GuestSignature) {
+		return nil, fsapi.Permission
+	}
+	journal, err := c.Service.ControlledJournalInfo(ctx, e.Profile)
+	if err != nil {
+		return nil, err
+	}
+	if e.Journal != journal || e.Scope.Generation != journal.Stream.Generation.String() || e.Scope.Configuration != journal.Stream.Configuration.String() {
+		return nil, fsapi.Permission
+	}
+	info := c.Service.FrontendInfo()
+	if info.Validation != e.Profile || !info.UnixPermissions || info.Generation != e.ServingGeneration || info.Volume.String() != e.Scope.Volume || e.Endpoint.FuseSession != e.Scope.FuseSession {
+		return nil, fsapi.Permission
+	}
+	if err = c.Facts.Check(ctx, e); err != nil {
+		return nil, err
+	}
+	if c.MaxRetainedBytes == 0 {
+		c.MaxRetainedBytes = 256 << 20
+	}
+	if c.MaxSourceBytes == 0 {
+		c.MaxSourceBytes = 128 << 20
+	}
+	if c.ClaimCreditBytes == 0 {
+		c.ClaimCreditBytes = 4 << 20
+	}
+	if c.SourceCreditBytes == 0 {
+		c.SourceCreditBytes = 2 << 20
+	}
+	if c.MaxRetainedBytes > 1<<30 || c.MaxSourceBytes > 1<<30 || c.ClaimCreditBytes > c.MaxRetainedBytes || c.SourceCreditBytes > c.MaxSourceBytes || c.ClaimCreditBytes < 4096 || c.SourceCreditBytes < 4096 {
+		return nil, fsapi.Invalid
+	}
+	if c.MaxClaims == 0 {
+		c.MaxClaims = 4096
+	}
+	if c.MaxClaims < 1 || c.MaxClaims > 65536 {
+		return nil, fsapi.Invalid
+	}
+	if !filepath.IsAbs(c.Directory) {
+		return nil, fsapi.Invalid
+	}
+	st, err := os.Lstat(c.Directory)
+	if err != nil {
+		return nil, err
+	}
+	if !st.IsDir() || st.Mode().Perm() != 0700 || st.Sys().(*syscall.Stat_t).Uid != uint32(os.Getuid()) {
+		return nil, fsapi.Permission
+	}
+	// Roots and policy keys are retained by value, not caller-owned slices.
+	c.Operator = bytes.Clone(c.Operator)
+	c.Authorization.Enrollment.HostKey = bytes.Clone(e.HostKey)
+	c.Authorization.Enrollment.GuestKey = bytes.Clone(e.GuestKey)
+	filename := filepath.Join(c.Directory, "controlled-validation-v1.db")
+	fileInfo, statErr := os.Lstat(filename)
+	if statErr != nil && !errors.Is(statErr, os.ErrNotExist) {
+		return nil, statErr
+	}
+	if statErr == nil {
+		if c.Initialize || !fileInfo.Mode().IsRegular() || fileInfo.Mode().Perm() != 0600 || fileInfo.Sys().(*syscall.Stat_t).Uid != uint32(os.Getuid()) || fileInfo.Sys().(*syscall.Stat_t).Nlink != 1 {
+			return nil, fsapi.Permission
+		}
+	} else {
+		if !c.Initialize {
+			return nil, fsapi.Unavailable
+		}
+		entries, err := os.ReadDir(c.Directory)
+		if err != nil {
+			return nil, err
+		}
+		if len(entries) != 0 {
+			return nil, fsapi.Permission
+		}
+		file, err := os.OpenFile(filename, os.O_CREATE|os.O_EXCL|os.O_RDWR, 0600)
+		if err != nil {
+			return nil, err
+		}
+		if err = file.Close(); err != nil {
+			return nil, err
+		}
+	}
+	db, err := bolt.Open(filename, 0600, &bolt.Options{Timeout: time.Millisecond * 100})
+	if err != nil {
+		return nil, err
+	}
+	p := &Provider{config: c, db: db}
+	err = db.Update(func(tx *bolt.Tx) error {
+		b, err := tx.CreateBucketIfNotExists([]byte(ledgerVersion))
+		if err != nil {
+			return err
+		}
+		scope, err := json.Marshal(struct {
+			Scope    guestbridge.Context
+			Profile  fsservice.ValidationProfile
+			Ledger   fsapi.UUID
+			Operator []byte
+		}{e.Scope, e.Profile, e.Ledger, c.Operator})
+		if err != nil {
+			return err
+		}
+		if old := b.Get([]byte("scope")); (old == nil && !c.Initialize) || (old != nil && !bytes.Equal(old, scope)) {
+			return fsapi.Permission
+		}
+		if err = b.Put([]byte("scope"), scope); err != nil {
+			return err
+		}
+		for _, name := range []string{"claims", "principals", "bridge", "processes", "retirements", "operations", "allocations"} {
+			if _, err = b.CreateBucketIfNotExists([]byte(name)); err != nil {
+				return err
+			}
+		}
+		return nil
+	})
+	if err != nil {
+		_ = db.Close()
+		return nil, err
+	}
+	if c.Initialize {
+		directory, err := os.Open(c.Directory)
+		if err != nil {
+			_ = db.Close()
+			return nil, err
+		}
+		syncErr := directory.Sync()
+		closeErr := directory.Close()
+		if syncErr != nil {
+			_ = db.Close()
+			return nil, syncErr
+		}
+		if closeErr != nil {
+			_ = db.Close()
+			return nil, closeErr
+		}
+	}
+	return p, nil
+}
+
+// Close releases the ledger lock. It neither retires claims nor deletes state.
+func (p *Provider) Close() error {
+	if p.closed.Swap(true) {
+		return nil
+	}
+	p.execution.Lock()
+	defer p.execution.Unlock()
+	return p.db.Close()
+}
+
+// Check checks immutable exact scope and live component facts without taking
+// the execution mutex, waiting for an operation, or manufacturing authority.
+func (p *Provider) Check(ctx context.Context, scope guestbridge.Context) error {
+	if p.closed.Load() {
+		return fsapi.Unavailable
+	}
+	if scope != p.config.Authorization.Enrollment.Scope {
+		return fsapi.Permission
+	}
+	if p.config.Service.State() != fsservice.Serving {
+		return fsapi.Unavailable
+	}
+	return p.config.Facts.Check(ctx, p.config.Authorization.Enrollment)
+}
+
+// ServingGeneration returns the actual selected local service generation.
+func (p *Provider) ServingGeneration(ctx context.Context, scope guestbridge.Context) (fsapi.UUID, error) {
+	if err := p.Check(ctx, scope); err != nil {
+		return fsapi.UUID{}, err
+	}
+	return p.config.Service.FrontendInfo().Generation, nil
+}
+
+// CheckValidation verifies the exact operator-enrolled profile and endpoint at
+// each bridge construction; changing only a disposable label grants no access.
+func (p *Provider) CheckValidation(ctx context.Context, scope guestbridge.Context, profile fsservice.ValidationProfile, endpoint guestbridge.Endpoint) error {
+	e := p.config.Authorization.Enrollment
+	if e.Profile != profile || e.Endpoint != endpoint {
+		return fsapi.Permission
+	}
+	return p.Check(ctx, scope)
+}
